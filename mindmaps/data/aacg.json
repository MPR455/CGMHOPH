     "label": "Medical",
     "children": [
      {
       "label": "topical",
       "children": [
        {
         "label": "timolol (beta-blocker) — caution: asthma / COPD (chronic obstructive pulmonary disease), heart failure"
        },
        {
         "label": "brimonidine (alpha-2 agonist)"
        },
        {
         "label": "avoid",
         "children": [
          {
           "label": "nonselective adrenergic agonists (epinephrine) — cause pupillary dilation & iris ischemia"
          },
          {
           "label": "significant α1 (alpha-1) adrenergic activity (apraclonidine)"
          }
         ]
        },
        {
         "label": "latanoprost (prostaglandin analog, PG)"
        },
        {
         "label": "dorzolamide (carbonic anhydrase inhibitor, CAI)"
        },
        {
         "label": "pilocarpine 1-2% (every 15 min ×2)",
         "children": [
          {
           "label": "fallen out of favor for phakic primary AACG (acute angle closure glaucoma)"
          },
          {
           "label": "do not use for aphakic / pseudophakic AACG (acute angle closure glaucoma) — increases iris congestion or rotates lens–iris interface anteriorly"
          },
          {
           "label": "do not use for secondary ACG (angle closure glaucoma)"
          },
          {
           "label": "stronger miotics should be avoided"
          },
          {
           "label": "don't use for topiramate / sulfonamide-induced ACG (angle closure glaucoma)"
          }
         ]
        }
       ]
      },
