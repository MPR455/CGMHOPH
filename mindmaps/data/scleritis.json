    { "label": "Treatment", "children": [
      { "label": "Medical", "children": [
        { "label": "artificial tears" },
        { "label": "difluprednate eyedrop" },
        { "label": "oral NSAIDs (nonsteroidal anti-inflammatory drugs) — only one NSAID should be prescribed at a time", "children": [
          { "label": "gastroprotective medication" }
        ]},
        { "label": "oral steroid", "children": [
          { "label": "indications", "children": [
            { "label": "not responsive to NSAID (decreased pain is first sign of response to treatment)" },
