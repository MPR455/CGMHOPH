          { "label": "start at 1 mg/kg daily and then taper within the first 2 weeks of treatment" },
          { "label": "taper slowly" },
          { "label": "calcium (600 mg) with vitamin D (400 IU, international units)" },
          { "label": "gastroprotective medication" },
          { "label": "NSAIDs and steroids should not be used simultaneously" }
