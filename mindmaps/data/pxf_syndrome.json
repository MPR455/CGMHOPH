            { "label": "vitreous loss" },
            { "label": "retained lens material" }
          ]}
        ]}
      ]},
      { "label": "Follow-up", "children": [
        { "label": "glaucoma monitoring", "children": [
          { "label": "no glaucoma → q 6-12 mo (months)" },
