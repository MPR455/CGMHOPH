{
  "label": "9.7.4. Infectious Ocular Inflammatory Diseases (IV): Cytomegalovirus (CMV)",
  "root": true,
  "children": [
    {
      "label": "in contrast to CMV retinitis"
    },
    {
      "label": "Introduction",
      "children": [
        {
          "label": "Herpesviridae family",
          "children": [
            {
              "label": "double-stranded DNA virus"
            }
          ]
        },
        {
          "label": "most common cause of congenital viral infection"
        },
        {
          "label": "CMV retinitis",
          "children": [
            {
              "label": "the most common ophthalmic manifestation of both congenital CMV infection and of CMV as an opportunistic infection"
            }
          ]
        },
        {
          "label": "causes illness in immunocompromised patients",
          "children": [
            {
              "label": "leukemia"
            },
            {
              "label": "lymphoma"
            },
            {
              "label": "HIV/AIDS",
              "children": [
                {
                  "label": "before introduction of combination antiretroviral therapy",
                  "children": [
                    {
                      "label": "30% of patients with HIV/AIDS developed CMV retinitis",
                      "children": [
                        {
                          "label": "rhegmatogenous retinal detachments with multiple breaks developed in 33% per eye per year"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "combination antiretroviral regimens",
                  "children": [
                    {
                      "label": "80% decline in new cases/year of CMV retinitis"
                    },
                    {
                      "label": "new cases of CMV retinitis continue to occur among patients who",
                      "children": [
                        {
                          "label": "fail combination antiretroviral treatment"
                        },
                        {
                          "label": "abandon treatment"
                        },
                        {
                          "label": "experience immune reconstitution but do not develop CMV-specific immunity"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "CMV retinitis confers a twofold increased risk in mortality among patients with a CD4+ T-cell count <100 cells/μL"
                }
              ]
            },
            {
              "label": "transplant recipients",
              "children": [
                {
                  "label": "resistant CMV infection in patients with CMV retinitis is further associated with increased mortality"
                }
              ]
            },
            {
              "label": "systemic immunomodulation"
            }
          ]
        }
      ]
    },
    {
      "label": "CMV anterior uveitis",
      "children": [
        {
          "label": "immunocompetent adults"
        },
        {
          "label": "chronic or recurrent unilateral anterior uveitis"
        },
        {
          "label": "associated with",
          "children": [
            {
              "label": "ocular hypertension"
            },
            {
              "label": "corneal edema",
              "children": [
                {
                  "label": "similar to VZV"
                }
              ]
            },
            {
              "label": "demonstration of CMV DNA by PCR analysis",
              "children": [
                {
                  "label": "variable degrees of sectoral iris atrophy"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "intraocular antibodies directed against CMV by enzyme-linked immunosorbent assay (ELISA)"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "specific, prolonged, systemic anti-CMV treatment",
              "children": [
                {
                  "label": "negative study results for HSV and VZV"
                },
                {
                  "label": "valganciclovir"
                }
              ]
            },
            {
              "label": "relapses are common after discontinuation of therapy"
            }
          ]
        }
      ]
    },
    {
      "label": "Pathogenesis",
      "children": [
        {
          "label": "virus reaches the eye hematogenously",
          "children": [
            {
              "label": "infects retinal vascular endothelial cells",
              "children": [
                {
                  "label": "crosses the blood–ocular barrier",
                  "children": [
                    {
                      "label": "cell-to-cell transmission within the retina"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Congenital CMV retinitis",
      "children": [
        {
          "label": "associated with other systemic manifestations of disseminated disease",
          "children": [
            {
              "label": "fever"
            },
            {
              "label": "thrombocytopenia"
            },
            {
              "label": "anemia"
            },
            {
              "label": "pneumonitis"
            },
            {
              "label": "hepatosplenomegaly"
            }
          ]
        },
        {
          "label": "prevalence",
          "children": [
            {
              "label": "11%-22%"
            }
          ]
        },
        {
          "label": "diagnosis of congenital disease",
          "children": [
            {
              "label": "associated systemic disease findings"
            },
            {
              "label": "clinical fundus appearance"
            },
            {
              "label": "evidence of viral inclusion bodies or positive PCR in urine, saliva, and subretinal fluid"
            },
            {
              "label": "complement-fixation test",
              "children": [
                {
                  "label": "of value 5–24 months after the loss of the maternal antibodies"
                }
              ]
            }
          ]
        },
        {
          "label": "resolution of the retinitis leaves both pigmented and atrophic lesions"
        },
        {
          "label": "CMV retinitis can occur later in life"
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "retinal detachment",
              "children": [
                {
                  "label": "≤1/3",
                  "children": [
                    {
                      "label": "children with congenital CMV infection should be monitored at regular intervals for potential ocular involvement later into childhood"
                    }
                  ]
                }
              ]
            },
            {
              "label": "optic atrophy"
            },
            {
              "label": "cataract",
              "children": [
                {
                  "label": "Intravenous acyclovir for HSV & VZV"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "3 distinct variants",
          "children": [
            {
              "label": "classic or fulminant retinitis",
              "children": [
                {
                  "label": "early retinitis",
                  "children": [
                    {
                      "label": "small, white retinal infiltrate masquerading as a cotton-wool spot",
                      "children": [
                        {
                          "label": "inevitable progression without treatment"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "large areas of retinal hemorrhage against a background of whitened, edematous, or necrotic retina",
                  "children": [
                    {
                      "label": "associated with blood vessels",
                      "children": [
                        {
                          "label": "posterior pole, from the disc to the vascular arcades, in the distribution of the nerve fiber layer"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "granular or indolent form",
              "children": [
                {
                  "label": "retinal periphery"
                },
                {
                  "label": "little or no retinal edema, hemorrhage, or vascular sheathing"
                },
                {
                  "label": "active retinitis progressing from the borders of the lesion"
                }
              ]
            },
            {
              "label": "perivascular form",
              "children": [
                {
                  "label": "variant of “frosted-branch” angiitis, an idiopathic retinal perivasculitis initially described in immunocompetent children"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Management",
      "children": [
        {
          "label": "antiretroviral therapy"
        },
        {
          "label": "anti-CMV therapy",
          "children": [
            {
              "label": "high-dose intravenous induction",
              "children": [
                {
                  "label": "ganciclovir (5 mg/kg twice daily)"
                },
                {
                  "label": "x2 weeks",
                  "children": [
                    {
                      "label": "foscarnet (90 mg/kg twice daily)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "low-dose oral maintenance therapy",
              "children": [
                {
                  "label": "antiretroviral therapy–naive patients"
                },
                {
                  "label": "antiretroviral therapy–experienced patients",
                  "children": [
                    {
                      "label": "may require only 6 months of anti-CMV therapy",
                      "children": [
                        {
                          "label": "effective against CMV and also HSV-1 & HSV-2"
                        }
                      ]
                    },
                    {
                      "label": "may require long-term maintenance therapy"
                    }
                  ]
                },
                {
                  "label": "patients on antiretroviral therapy with sustained immune recovery",
                  "children": [
                    {
                      "label": "(CD4+ T lymphocytes ≥100 cells/μL x 3–6 months)"
                    },
                    {
                      "label": "systemic anti-CMV maintenance therapy may be safely discontinued",
                      "children": [
                        {
                          "label": "remain at risk for recurrence",
                          "children": [
                            {
                              "label": "monitor at 3-month intervals"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "effective against CMV"
                }
              ]
            },
            {
              "label": "oral valganciclovir (900 mg twice daily)",
              "children": [
                {
                  "label": "x3 weeks",
                  "children": [
                    {
                      "label": "followed by maintenance therapy (900 mg/ day)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "intravitreal injection of ganciclovir or foscarnet",
              "children": [
                {
                  "label": "highly effective in treating intraocular disease",
                  "children": [
                    {
                      "label": "particularly effective for patients with vision- threatening posteriorly located retinitis"
                    }
                  ]
                },
                {
                  "label": "useful alternative in patients who cannot tolerate intravenous systemic therapy (myelotoxicity)"
                },
                {
                  "label": "leaves extraocular systemic CMV and the fellow eye untreated",
                  "children": [
                    {
                      "label": "intravitreal injection + oral valganciclovir may obviate this limitation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "aggressive anti-CMV therapy initiated at the same time as antiretroviral treatment may decrease the incidence of immune recovery uveitis"
            }
          ]
        }
      ]
    },
    {
      "label": "Diagnostic tests",
      "children": [
        {
          "label": "diagnosis of CMV retinitis in patients with HIV/ AIDS or undergoing IMT is essentially clinical"
        },
        {
          "label": "immunocompromised patients with atypical lesions or whose disease is not responding to anti-CMV therapy",
          "children": [
            {
              "label": "PCR (aqueous or vitreous)",
              "children": [
                {
                  "label": "high sensitivity and specificity"
                },
                {
                  "label": "to differentiate CMV from other herpetic causes of necrotizing retinitis and from toxoplasmic retinochoroiditis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Pathology",
      "children": [
        {
          "label": "full-thickness, coagulative necrotizing retinitis"
        },
        {
          "label": "secondary diffuse choroiditis"
        },
        {
          "label": "infected retinal cells show pathognomonic cytomegalic changes",
          "children": [
            {
              "label": "large eosinophilic intranuclear inclusions"
            },
            {
              "label": "small, multiple, basophilic cytoplasmic inclusions"
            },
            {
              "label": "viral inclusions may be present in RPE and vascular endothelium"
            }
          ]
        },
        {
          "label": "electron microscopy",
          "children": [
            {
              "label": "viral particles with the typical morphology of the herpes family"
            }
          ]
        }
      ]
    }
  ],
