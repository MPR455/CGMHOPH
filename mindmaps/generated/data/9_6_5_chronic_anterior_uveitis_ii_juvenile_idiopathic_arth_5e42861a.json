{
  "label": "9.6.5. Chronic Anterior Uveitis (II): Juvenile Idiopathic Arthritis",
  "root": true,
  "children": [
    {
      "label": "patients suspected of JIA should undergo",
      "children": [
        {
          "label": "ANA testing"
        },
        {
          "label": "evaluation by a pediatric rheumatologist",
          "children": [
            {
              "label": "joint disease may be minimal or absent at the time the uveitis is diagnosed!"
            }
          ]
        }
      ]
    },
    {
      "label": "epidemiology"
    },
    {
      "label": "definition",
      "children": [
        {
          "label": "arthritis < age 16 years",
          "children": [
            {
              "label": "most common systemic disorder associated with anterior uveitis in the pediatric age group"
            }
          ]
        },
        {
          "label": "lasting ≥ 6 weeks"
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "TINU"
        },
        {
          "label": "Fuchs heterochromic uveitis"
        },
        {
          "label": "sarcoidosis"
        },
        {
          "label": "Behçet disease"
        },
        {
          "label": "seronegative spondyloarthropathies"
        },
        {
          "label": "herpetic uveitis"
        },
        {
          "label": "Lyme disease"
        }
      ]
    },
    {
      "label": "pauciarticular onset"
    },
    {
      "label": "prognosis",
      "children": [
        {
          "label": "long-term prognosis depends on the extent of structural complications at first diagnosis",
          "children": [
            {
              "label": "profound silent ocular damage can occur"
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "band keratopathy"
            },
            {
              "label": "cataract"
            },
            {
              "label": "glaucoma"
            },
            {
              "label": "macular edema"
            },
            {
              "label": "chronic hypotony",
              "children": [
                {
                  "label": "phthisis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "3 types",
      "children": [
        {
          "label": "oligoarticular onset",
          "children": [
            {
              "label": "40%–50% of JIA",
              "children": [
                {
                  "label": "80%–90% of JIA-associated uveitis"
                }
              ]
            },
            {
              "label": "≤ 4 joints during the first 6 months of disease",
              "children": [
                {
                  "label": "patients may have no joint symptoms"
                }
              ]
            },
            {
              "label": "type 1",
              "children": [
                {
                  "label": "girls < 5 years"
                },
                {
                  "label": "(+) antinuclear antibody (ANA)"
                },
                {
                  "label": "chronic anterior uveitis occurs in ≤ 25%"
                }
              ]
            },
            {
              "label": "type 2",
              "children": [
                {
                  "label": "older boys"
                },
                {
                  "label": "(+) HLA-B27",
                  "children": [
                    {
                      "label": "75%"
                    },
                    {
                      "label": "many develop evidence of seronegative spondyloarthropathy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "systemic onset (Still disease)",
          "children": [
            {
              "label": "< 5 years",
              "children": [
                {
                  "label": "acute and recurrent uveitis (rather than chronic uveitis)"
                },
                {
                  "label": "10%–15% of JIA"
                }
              ]
            },
            {
              "label": "fever, rash, lymphadenopathy, and hepatosplenomegaly"
            },
            {
              "label": "joint involvement may be minimal or absent initially"
            },
            {
              "label": "ocular involvement is rare",
              "children": [
                {
                  "label": "fewer than 6% of patients"
                }
              ]
            }
          ]
        },
        {
          "label": "polyarticular onset",
          "children": [
            {
              "label": ".> 4 joints in the first 6 months of the disease"
            },
            {
              "label": "40% of JIA"
            },
            {
              "label": "≈10% of JIA-associated anterior uveitis",
              "children": [
                {
                  "label": "rheumatoid factor (-) patients",
                  "children": [
                    {
                      "label": "rheumatoid factor (+) patients may not develop uveitis"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "goal of treatment is to eliminate active inflammation (anterior chamber cells)",
          "children": [
            {
              "label": "See Table 6-1",
              "children": [
                {
                  "label": "regular slit-lamp examinations specially necessary if",
                  "children": [
                    {
                      "label": "oligoarticular disease"
                    },
                    {
                      "label": "ANA (+)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "topical corticosteroids",
          "children": [
            {
              "label": "initial treatment",
              "children": [
                {
                  "label": "even low-grade inflammation, if present for a prolonged period, can result in ocular morbidity"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic corticosteroids/IMT",
          "children": [
            {
              "label": "more severe cases"
            }
          ]
        },
        {
          "label": "corticosteroid-induced complications are common",
          "children": [
            {
              "label": "growth retardation",
              "children": [
                {
                  "label": "long-term use of topical corticosteroids at doses ≥3 times daily can increase the risk of cataract formation",
                  "children": [
                    {
                      "label": "systemic IMT should be considered for such cases"
                    }
                  ]
                }
              ]
            },
            {
              "label": "cataracts"
            },
            {
              "label": "glaucoma"
            }
          ]
        },
        {
          "label": "short-acting mydriatic drugs",
          "children": [
            {
              "label": "in patients with chronic flare to prevent posterior synechiae formation"
            }
          ]
        },
        {
          "label": "systemic NSAIDs",
          "children": [
            {
              "label": "permit a lower dose of corticosteroids"
            }
          ]
        },
        {
          "label": "low-dose methotrexate (weekly)",
          "children": [
            {
              "label": "can effectively control the uveitis"
            },
            {
              "label": "well tolerated"
            },
            {
              "label": "can spare patients the complications of long- term corticosteroid use"
            }
          ]
        },
        {
          "label": "TNF inhibitors and other biologic agents"
        },
        {
          "label": "cataract surgery in patients with JIA",
          "children": [
            {
              "label": "high complication rate due to difficulty in controlling the more aggressive inflammatory response"
            },
            {
              "label": "use of IOLs remains controversial",
              "children": [
                {
                  "label": "aphakic children may develop amblyopia"
                }
              ]
            },
            {
              "label": "lensectomy/vitrectomy via the pars plana"
            },
            {
              "label": "band keratopathy should be treated before cataract surgery",
              "children": [
                {
                  "label": "chelation EDTA"
                }
              ]
            }
          ]
        },
        {
          "label": "guidelines for cataract surgery with IOL implants in patients with JIA",
          "children": [
            {
              "label": "intraocular inflammation must be well controlled with corticosteroids/systemic IMT for ≥3 months before surgery",
              "children": [
                {
                  "label": "IMT must be used preoperatively and postoperatively, not just perioperatively"
                },
                {
                  "label": "must not require frequent instillation of topical corticosteroids"
                }
              ]
            },
            {
              "label": "only acrylic IOL should be implanted"
            },
            {
              "label": "any inflammation after cataract surgery must be aggressively treated"
            },
            {
              "label": "patients must be strongly advised about the need for careful, regular, lifelong follow-up"
            },
            {
              "label": "low threshold for IOL explantation in patients who have persistent postoperative inflammation and recurrent cyclitic membranes."
            }
          ]
        },
        {
          "label": "glaucoma",
          "children": [
            {
              "label": "should be treated with medical therapy initially"
            },
            {
              "label": "surgical intervention is often necessary in severe cases"
            },
            {
              "label": "standard filtering procedures are usually unsuccessful",
              "children": [
                {
                  "label": "antifibrotic drugs"
                },
                {
                  "label": "aqueous drainage"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "uveitis",
      "children": [
        {
          "label": "average age of onset is 6 years"
        },
        {
          "label": "within 5–7 years of onset of joint disease",
          "children": [
            {
              "label": "may occur as long as 28 years after development of arthritis"
            },
            {
              "label": "little or no correlation between ocular and joint inflammation"
            }
          ]
        },
        {
          "label": "risk factors for the development of chronic uveitis",
          "children": [
            {
              "label": "oligoarticular onset"
            },
            {
              "label": "female"
            },
            {
              "label": "(+) ANA"
            },
            {
              "label": "most patients test negative for rheumatoid factor"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "mild to moderate pain",
              "children": [
                {
                  "label": "eye is frequently white"
                }
              ]
            },
            {
              "label": "photophobia"
            },
            {
              "label": "blurring"
            },
            {
              "label": "some patients are asymptomatic",
              "children": [
                {
                  "label": "found incidentally during routine school physical examination"
                }
              ]
            }
          ]
        },
        {
          "label": "signs of inflammation include",
          "children": [
            {
              "label": "fine KPs"
            },
            {
              "label": "band keratopathy"
            },
            {
              "label": "flare and cells"
            },
            {
              "label": "posterior synechiae"
            },
            {
              "label": "cataract"
            }
          ]
        }
      ]
    }
  ],
