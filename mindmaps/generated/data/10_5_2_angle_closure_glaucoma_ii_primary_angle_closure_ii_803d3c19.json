{
  "label": "10.5.2. Angle-Closure Glaucoma (II): Primary Angle Closure (II)",
  "root": true,
  "children": [
    {
      "label": "Subacute or Intermittent Angle Closure",
      "children": [
        {
          "label": "episodes of blurred vision, halos, and mild pain caused by elevated IOP",
          "children": [
            {
              "label": "periodically over days, months, or years"
            },
            {
              "label": "symptoms resolve spontaneously",
              "children": [
                {
                  "label": "during sleep-induced miosis"
                }
              ]
            },
            {
              "label": "may occur in the absence of symptoms"
            },
            {
              "label": "often confused with headaches or migraines"
            }
          ]
        },
        {
          "label": "IOP is usually normal between the episodes"
        },
        {
          "label": "gonioscopy",
          "children": [
            {
              "label": "narrow chamber angle ± PAS"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "laser iridotomy",
              "children": [
                {
                  "label": "treatment of choice"
                }
              ]
            },
            {
              "label": "lensectomy",
              "children": [
                {
                  "label": "if significant lens opacity is present"
                },
                {
                  "label": "± goniosynechialysis",
                  "children": [
                    {
                      "label": "in cases of significant synechial closure"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical course",
          "children": [
            {
              "label": "can progress to",
              "children": [
                {
                  "label": "chronic angle closure"
                },
                {
                  "label": "acute attack that does not resolve spontaneously"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Chronic Angle Closure",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "acute angle closure in which synechial closure persists",
              "children": [
                {
                  "label": "most common"
                }
              ]
            },
            {
              "label": "gradual asymptomatic angle closure",
              "children": [
                {
                  "label": "chamber angle closes gradually and IOP rises slowly",
                  "children": [
                    {
                      "label": "\"creeping angle closure\""
                    }
                  ]
                },
                {
                  "label": "tends to be diagnosed in its later stages"
                },
                {
                  "label": "a major cause of blindness in Asia"
                },
                {
                  "label": "mechanisms",
                  "children": [
                    {
                      "label": "pupillary block"
                    },
                    {
                      "label": "abnormalities in iris thickness and position"
                    },
                    {
                      "label": "plateau iris configuration"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "resembles and is confused with chronic OAG",
              "children": [
                {
                  "label": "gonioscopic examination of all glaucoma patients is important"
                }
              ]
            },
            {
              "label": "IOP can rise precipitously and become more difficult to control"
            },
            {
              "label": "dynamic gonioscopy",
              "children": [
                {
                  "label": "permanent PAS"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "iridectomy is necessary",
              "children": [
                {
                  "label": "without iridectomy, closure of the angle usually progresses"
                },
                {
                  "label": "even with a patent peripheral iridectomy, progressive angle closure can occur",
                  "children": [
                    {
                      "label": "periodic gonioscopy is imperative"
                    }
                  ]
                },
                {
                  "label": "iridectomy with or without long-term use of ocular hypotensive medication will control the disease in most patients"
                }
              ]
            },
            {
              "label": "iridoplasty"
            },
            {
              "label": "lensectomy with or without goniosynechialysis"
            },
            {
              "label": "filtering surgery"
            }
          ]
        }
      ]
    },
    {
      "label": "The Occludable/Narrow Anterior Chamber Angle",
      "children": [
        {
          "label": "only a small % of patients with shallow anterior chambers develop ACG",
          "children": [
            {
              "label": "gonioscopy has relatively poor predictive value"
            },
            {
              "label": "provocative tests",
              "children": [
                {
                  "label": "designed to precipitate a limited form of angle closure"
                },
                {
                  "label": "types",
                  "children": [
                    {
                      "label": "pharmacologic pupillary dilation"
                    },
                    {
                      "label": "darkroom prone-position"
                    }
                  ]
                },
                {
                  "label": "positive test result",
                  "children": [
                    {
                      "label": "IOP increase of ≥8 mm Hg"
                    },
                    {
                      "label": "asymmetric pressure rise between the 2 eyes with a corresponding degree of angle closure",
                      "children": [
                        {
                          "label": "gonioscopic evidence of appositional angle closure in at least a portion of the angle"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "provocative testing has not been validated in a prospective study"
                }
              ]
            },
            {
              "label": "iridotomy is not necessary in all patients with a suspicious or borderline narrow angle"
            },
            {
              "label": "any patient with narrow angles, regardless of the results of provocative testing, should be advised of",
              "children": [
                {
                  "label": "symptoms of angle closure"
                }
              ]
            },
            {
              "label": "decision to treat an asymptomatic patient with narrow angles rests on clinical judgment",
              "children": [
                {
                  "label": "value of long-term periodic follow-up"
                }
              ]
            }
          ]
        },
        {
          "label": "relative indications for iridotomy in patients with narrow angle",
          "children": [
            {
              "label": "appositional or near-appositional closure"
            },
            {
              "label": "PAS"
            },
            {
              "label": "increased segmental trabecular meshwork pigmentation"
            },
            {
              "label": "history of previous angle closure"
            },
            {
              "label": "positive provocative test result"
            },
            {
              "label": "ACD of less than 2.0 mm",
              "children": [
                {
                  "label": "strong family history of angle closure"
                }
              ]
            },
            {
              "label": "status of the lens and the benefit of cataract surgery should also be considered"
            }
          ]
        },
        {
          "label": "factors that cause pupillary dilation may induce angle closure",
          "children": [
            {
              "label": "drugs",
              "children": [
                {
                  "label": "mydriatic agents",
                  "children": [
                    {
                      "label": "dilating drops"
                    },
                    {
                      "label": "systemic medications",
                      "children": [
                        {
                          "label": "adrenergic (sympathomimetic)"
                        },
                        {
                          "label": "anticholinergic (parasympatholytic)"
                        },
                        {
                          "label": "examples",
                          "children": [
                            {
                              "label": "allergy and cold medications"
                            },
                            {
                              "label": "antidepressants"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "miotic agents",
                  "children": [
                    {
                      "label": "strong miotics",
                      "children": [
                        {
                          "label": "cholinesterase inhibitors",
                          "children": [
                            {
                              "label": "some urological drugs"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "mechanism",
                      "children": [
                        {
                          "label": "relax zonular fibers of the lens, allowing the lens–iris interface to move forward"
                        },
                        {
                          "label": "increase in the amount of iris–lens contact"
                        }
                      ]
                    },
                    {
                      "label": "gonioscopy should be repeated soon after miotic drugs are administered to patients with narrow angles"
                    }
                  ]
                },
                {
                  "label": "when such drugs are administered to patients with potentially occludable angles",
                  "children": [
                    {
                      "label": "inform the patient of the risk and symptms of angle closure"
                    },
                    {
                      "label": "consider iridotomy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "emotional upset"
            },
            {
              "label": "fright"
            },
            {
              "label": "pain"
            }
          ]
        },
        {
          "label": "reversing pharmacologic dilation",
          "children": [
            {
              "label": "α-receptor blockers",
              "children": [
                {
                  "label": "dapiprazole"
                },
                {
                  "label": "thymoxamine"
                },
                {
                  "label": "reduce the overall time that the pupil is dilated/ mid-dilated",
                  "children": [
                    {
                      "label": "do not eliminate the possibility of precipitating angle closure"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Plateau Iris",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "atypical configuration of the anterior chamber angle",
              "children": [
                {
                  "label": "anteriorly positioned ciliary processes that critically narrow the anterior chamber recess"
                }
              ]
            },
            {
              "label": "component of pupillary block is often present",
              "children": [
                {
                  "label": "more anterior junction of the iris dilator muscle and the ciliary epithelium"
                },
                {
                  "label": "angle may be further compromised following dilation of the pupil"
                }
              ]
            }
          ]
        },
        {
          "label": "may result in acute or chronic ACG",
          "children": [
            {
              "label": "PAS formation",
              "children": [
                {
                  "label": "plateau iris",
                  "children": [
                    {
                      "label": "anterior to posterior direction",
                      "children": [
                        {
                          "label": "begin at the Schwalbe line and extend in a posterior direction"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "pupillary block–induced angle closure",
                  "children": [
                    {
                      "label": "posterior to anterior direction"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "plateau iris should be suspected in an eye with angle closure if",
              "children": [
                {
                  "label": "central anterior chamber appears to be of normal depth"
                },
                {
                  "label": "iris plane appears to be rather flat"
                }
              ]
            },
            {
              "label": "should be confirmed with",
              "children": [
                {
                  "label": "gonioscopy"
                },
                {
                  "label": "ultrasound biomicroscopy",
                  "children": [
                    {
                      "label": "“double hump” sign"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "laser iridotomy",
              "children": [
                {
                  "label": "remove any component of pupillary block",
                  "children": [
                    {
                      "label": "diagnosis will be missed if the examiner relies solely on the slit-lamp examination"
                    }
                  ]
                }
              ]
            },
            {
              "label": "lensectomy",
              "children": [
                {
                  "label": "if cataract is present",
                  "children": [
                    {
                      "label": "remain predisposed to angle closure despite a patent iridotomy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "long-term miotic therapy"
            },
            {
              "label": "argon laser peripheral iridoplasty",
              "children": [
                {
                  "label": "to flatten and thin the peripheral iris"
                },
                {
                  "label": "may be more useful"
                }
              ]
            },
            {
              "label": "repeated gonioscopy at regular intervals is necessary because the threat of angle closure may remain"
            }
          ]
        }
      ]
    }
  ],
