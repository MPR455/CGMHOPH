                }
              ]
            },
            {
              "label": "complications",
              "children": [
                {
                  "label": "cataract formation",
                  "children": [
                    {
                      "label": "not curative of chronic uveitis"
                    }
                  ]
                },
                {
                  "label": "IOP elevation",
                  "children": [
                    {
                      "label": "50%"
                    },
                    {
                      "label": "≤25% of patients may require topical medications to control IOP"
                    },
                    {
                      "label": "1%–2% may require filtering surgery"
                    }
                  ]
                },
                {
                  "label": "“sterile endophthalmitis”",
                  "children": [
                    {
                      "label": "1%–6%"
                    },
                    {
                      "label": "lower incidence with preservative-free intravitreal triamcinolone"
                    }
                  ]
                },
                {
                  "label": "infectious endophthalmitis"
                },
                {
                  "label": "rhegmatogenous retinal detachment"
                }
              ]
            }
          ]
        },
        {
          "label": "sustained-release fluocinolone implant",
