{
  "label": "9.5.7. Clinical approach to uveitis (IV): Medical Management (II): Corticosteroids",
  "root": true,
  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "treatment of active inflammation",
              "children": [
                {
                  "label": "reduction of inflammatory infiltration of the retina, choroid, or optic nerve"
                }
              ]
            },
            {
              "label": "prevention/treatment of complications such as CME"
            }
          ]
        },
        {
          "label": "not indicated in patients with",
          "children": [
            {
              "label": "chronic flare"
            },
            {
              "label": "fuchs heterochromic uveitis"
            },
            {
              "label": "pars planitis not accompanied by macular edema"
            }
          ]
        },
        {
          "label": "begin therapy with a high dose of corticosteroids"
        },
        {
          "label": "taper the dose as the inflammation subsides",
          "children": [
            {
              "label": "taper gradually (over days to weeks) if utilized for >2–3 weeks"
            }
          ]
        },
        {
          "label": "maintain on the minimum dosage needed to control the inflammation",
          "children": [
            {
              "label": "increase the dose if surgical intervention is required"
            }
          ]
        }
      ]
    },
    {
      "label": "topical administration",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "anterior uveitis"
            },
            {
              "label": "vitritis +-"
            }
          ]
        },
        {
          "label": "ointment form",
          "children": [
            {
              "label": "for nighttime use",
              "children": [
                {
                  "label": "macular edema +-"
                }
              ]
            },
            {
              "label": "when preservatives in the eyedrops are not well tolerated"
            }
          ]
        },
        {
          "label": "difluprednate 0.05%"
        },
        {
          "label": "rimexolone"
        },
        {
          "label": "loteprednol",
          "children": [
            {
              "label": "less ocular hypertensive effect",
              "children": [
                {
                  "label": "not as effective as prednisolone in controlling uveitis that is more intense than mild to moderate"
                }
              ]
            }
          ]
        },
        {
          "label": "fluorometholone"
        },
        {
          "label": "generic forms of prednisolone may have less of an anti-inflammatory effect",
          "children": [
            {
              "label": "may be a result of differences in particle size",
              "children": [
                {
                  "label": "vigorously agitate drug before instillation!"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "intravitreal administration",
      "children": [
        {
          "label": "triamcinolone acetonide",
          "children": [
            {
              "label": "trans–pars plana intravitreal injection (4 mg; 0.1 mL)"
            },
            {
              "label": "indications",
              "children": [
                {
                  "label": "recalcitrant uveitic CME",
