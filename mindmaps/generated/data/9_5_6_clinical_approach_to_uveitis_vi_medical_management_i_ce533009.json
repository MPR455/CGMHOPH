                  "label": "endophthalmitis"
                },
                {
                  "label": "wound leaks"
                },
                {
                  "label": "hypotony"
                },
                {
                  "label": "vitreous hemorrhage"
                },
                {
                  "label": "retinal detachments"
                }
              ]
            },
            {
              "label": "Reimplantation may be performed"
            },
            {
              "label": "Multicenter Uveitis Steroid Treatment (MUST) trial",
              "children": [
                {
                  "label": "fluocinolone implant was compared with standard systemic therapy"
                },
                {
                  "label": "corrected distance visual acuity was not significantly different between the 2 treatment groups at 2 years"
                }
              ]
            }
          ]
        },
