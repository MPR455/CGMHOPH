              "label": "the periocular steroid should be removed surgically!"
            }
          ]
        },
        {
          "label": "sub-Tenon route",
          "children": [
            {
              "label": "superotemporal approach (Nozik technique)",
              "children": [
                {
                  "label": "the preferred location"
                },
                {
                  "label": "technique",
                  "children": [
                    {
                      "label": "5⁄8 25-gauge -inch needle"
                    },
                    {
                      "label": "upper eyelid is retracted"
                    },
                    {
                      "label": "patient is instructed to look down and nasally"
                    },
                    {
                      "label": "anesthesia is applied with a cotton swab soaked in proparacaine or tetracaine"
                    },
                    {
                      "label": "needle is placed bevel-down against the sclera"
                    },
                    {
                      "label": "advanced through the conjunctiva and Tenon capsule using a side-to-side movement"
                    },
                    {
                      "label": "advance needle to the hub"
                    }
                  ]
                },
                {
                  "label": "complications",
                  "children": [
                    {
                      "label": "upper eyelid ptosis"
                    },
                    {
                      "label": "periorbital hemorrhage"
                    },
                    {
                      "label": "globe perforation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "inferotemporal approach",
              "children": [
                {
                  "label": "inferior approach using the Nozik technique can be awkward to perform"
                }
              ]
            }
          ]
        },
        {
          "label": "transseptal route",
          "children": [
            {
              "label": "preferred for the inferior approach"
            },
            {
              "label": "technique",
              "children": [
                {
                  "label": "short 27-gauge needle",
                  "children": [
                    {
