          "label": "biodegradable intraocular implant",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "posterior uveitis"
                },
                {
                  "label": "retinal vein occlusion"
                }
              ]
            },
            {
              "label": "injected through the pars plana into the vitreous cavity",
