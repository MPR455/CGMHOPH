    {
      "label": "Pupil-involving third nerve palsy",
      "children": [
        {
          "label": "loss of parasympathetic input",
          "children": [
            {
              "label": "mid-dilated pupil that responds poorly to light"
            }
          ]
        },
        {
          "label": "variable dysfunction of the levator palpebrae or extraocular muscles"
        },
        {
          "label": "uncommon < 20 years",
          "children": [
            {
              "label": "as early as the first decade of life!"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "aneurysm at the junction of PCoA & ICA",
              "children": [
                {
                  "label": "nontraumatic third nerve palsy with pupillary involvement must be assumed to be secondary to an aneurysm until proved otherwise",
                  "children": [
                    {
                      "label": "emergent cerebrovascular imaging",
                      "children": [
                        {
                          "label": "magnetic resonance angiography",
                          "children": [
                            {
                              "label": "routine MRI acquired with the MRA is more likely to show nonaneurysmal lesions"
                            }
                          ]
                        },
                        {
                          "label": "computed tomography angiography",
                          "children": [
                            {
                              "label": "faster"
                            },
                            {
                              "label": "greater resolution"
                            },
                            {
                              "label": "may show evidence of a subarachnoid hemorrhage"
                            }
                          ]
                        },
                        {
                          "label": "catheter angiography",
                          "children": [
                            {
                              "label": "for diagnostic confirmation and definitive treatment"
                            }
                          ]
                        },
                        {
                          "label": "modern CTA and MRA can reliably detect aneurysms as small as 3 mm"
                        }
                      ]
                    },
                    {
                      "label": "lumbar puncture",
                      "children": [
                        {
                          "label": "evidence of a hemorrhage (xanthochromia of the spinal fluid)"
                        },
                        {
                          "label": "to detect an inflammatory or neoplastic cause"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "pupillomotor fibers of the oculomotor nerve reside superficially in the medial aspect of the nerve",
                  "children": [
                    {
                      "label": "adjacent to the PCoA"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "isolated pupillary involvement",
