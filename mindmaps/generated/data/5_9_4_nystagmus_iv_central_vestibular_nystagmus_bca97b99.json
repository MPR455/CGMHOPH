{
  "label": "5.9.4. Nystagmus (IV): Central Vestibular Nystagmus",
  "root": true,
  "children": [
    {
      "label": "See Table 9-2"
    },
    {
      "label": "ocular bobbing",
      "children": [
        {
          "label": "rapid downward movement of both eyes, followed by slow return to midline"
        },
        {
          "label": "pons",
          "children": [
            {
              "label": "infarction"
            },
            {
              "label": "hemorrhage"
            }
          ]
        },
        {
          "label": "extremely poor prognosis for neurologic recovery"
        },
        {
          "label": "valuable localization and prognostic information"
        },
        {
          "label": "bilateral pontine lesions lead to loss of horizontal eye movements"
        }
      ]
    },
    {
      "label": "extensive interconnections between the central vestibular structures of the brainstem and the phylogenetically older regions of the cerebellum (ie, flocculus, nodulus, and vermis)",
      "children": [
        {
          "label": "difficult to determine by clinical examination alone the precise location of some lesions that produce central nystagmus"
        }
      ]
    },
    {
      "label": "Upbeat nystagmus",
      "children": [
        {
          "label": "downward drifting of the eyes, followed by corrective, upward saccades"
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "lesions in",
              "children": [
                {
                  "label": "anterior cerebellar vermis",
                  "children": [
                    {
                      "label": "brainstem (often medulla)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "demyelination"
            },
            {
              "label": "stroke"
            },
            {
              "label": "cerebellar degeneration"
            },
            {
              "label": "tobacco smoking"
            }
          ]
        }
      ]
    },
    {
      "label": "Torsional nystagmus",
      "children": [
        {
          "label": "peripheral vestibular nystagmus may have a torsional component"
        },
        {
          "label": "purely torsional nystagmus indicates a central lesion"
        },
        {
          "label": "medullary lesion",
          "children": [
            {
              "label": "syringobulbia"
            },
            {
              "label": "lateral medullary infarction"
            }
          ]
        },
        {
          "label": "may be part of an ocular tilt reaction"
        }
      ]
    },
    {
      "label": "Downbeat nystagmus",
      "children": [
        {
          "label": "most common form of central vestibular nystagmus"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "oscillopsia"
            },
            {
              "label": "upward drift corrected with a downward saccade",
              "children": [
                {
                  "label": "may be present in primary position"
                },
                {
                  "label": "Alexander’s law",
                  "children": [
                    {
                      "label": "downbeating movements are usually accentuated in downgaze"
                    }
                  ]
                }
              ]
            },
            {
              "label": "asymmetric vertical VOR; symmetric horizontal VOR"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "lesions of vestibulocerebellum (ie, nodulus, uvula, flocculus, and paraflocculus)",
              "children": [
                {
                  "label": "diminish the tonic output from the anterior semicircular canals to the ocular motoneurons"
                }
              ]
            },
            {
              "label": "lesion is often located at the cervical- medullary junction"
            },
            {
              "label": "differential diagnosis of downbeat nystagmus",
              "children": [
                {
                  "label": "Arnold-Chiari type I malformation",
                  "children": [
                    {
                      "label": "most common structural lesion"
                    },
                    {
                      "label": "posterior fossa crowding and cerebellar tonsillar protrusion into the foramen magnum"
                    }
                  ]
                },
                {
                  "label": "tumors (eg, meningioma, cerebellar hemangioma) at the foramen magnum"
                },
                {
                  "label": "demyelination"
                },
                {
                  "label": "stroke"
                },
                {
                  "label": "cranial trauma"
                },
                {
                  "label": "drug toxicity (eg, lithium, anticonvulsants)"
                },
                {
                  "label": "platybasia"
                },
                {
                  "label": "basilar artery impression"
                },
                {
                  "label": "spinocerebellar degenerations"
                },
                {
                  "label": "syrinx of the brainstem or upper cervical spinal cord"
                },
                {
                  "label": "brainstem encephalitis"
                },
                {
                  "label": "paraneoplastic syndrome"
                },
                {
                  "label": "impaired nutrition (eg, Wernicke encephalopathy, parenteral feeding, magnesium deficiency)"
                },
                {
                  "label": "idiopathic",
                  "children": [
                    {
                      "label": "antibodies to glutamic acid decarboxylase",
                      "children": [
                        {
                          "label": "interfere with the GABAergic neurons of the vestibular complex that normally inhibit the cells of the flocculus"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "baclofen",
              "children": [
                {
                  "label": "clonazepam"
                }
              ]
            },
            {
              "label": "gabapentin"
            },
            {
              "label": "base-out prisms (to induce convergence)"
            },
            {
              "label": "memantine"
            },
            {
              "label": "4-aminopyridine"
            },
            {
              "label": "3,4-diaminopyridine",
              "children": [
                {
                  "label": "little to no success"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Periodic alternating nystagmus (PAN)",
      "children": [
        {
          "label": "congenital or acquired",
          "children": [
            {
              "label": "associated with oculocutaneous albinism"
            }
          ]
        },
        {
          "label": "strictly horizontal"
        },
        {
          "label": "oscillation cycle of 2–4 minutes",
          "children": [
            {
              "label": "any purely horizontal nystagmus that occurs in primary position should be observed for at least 2 minutes"
            },
            {
              "label": "crescendo–decrescendo nystagmus",
              "children": [
                {
                  "label": "change in amplitude and frequency"
                }
              ]
            },
            {
              "label": "short period of downbeat or no nystagmus",
              "children": [
                {
                  "label": "10-20 seconds"
                }
              ]
            }
          ]
        },
        {
          "label": "periodic alternating head turn",
          "children": [
            {
              "label": "to minimize the nystagmus, in accordance with Alexander’s law",
              "children": [
                {
                  "label": "crescendo–decrescendo nystagmus in the opposite direction"
                }
              ]
            }
          ]
        },
        {
          "label": "dysfunction of the cerebellar nodulus and uvula",
          "children": [
            {
              "label": "multiple sclerosis"
            },
            {
              "label": "cerebellar degeneration"
            },
            {
              "label": "Arnold-Chiari type I malformation"
            },
            {
              "label": "stroke"
            },
            {
              "label": "use of anticonvulsant medication"
            },
            {
              "label": "bilateral loss of vision",
              "children": [
                {
                  "label": "reversible"
                }
              ]
            }
          ]
        },
        {
          "label": "baclofen",
          "children": [
            {
              "label": "can be effective for the acquired form"
            }
          ]
        }
      ]
    }
