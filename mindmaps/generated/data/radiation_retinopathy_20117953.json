    {
      "label": "Terson Syndrome",
      "children": [
        {
          "label": "abrupt intracranial hemorrhage",
          "children": [
            {
              "label": "acute rise in the intraocular venous pressure",
              "children": [
                {
                  "label": "rupture of peripapillary and retinal vessels"
                }
              ]
            },
            {
              "label": "1/3 of patients with subarachnoid or subdural hemorrhage have associated intraocular hemorrhage"
            }
          ]
        },
        {
          "label": "any age",
          "children": [
            {
              "label": "most common between 30-50 years"
            }
          ]
        },
        {
          "label": "hemorrhage",
          "children": [
            {
              "label": "subretinal"
            },
            {
              "label": "intraretinal"
            },
            {
              "label": "sub-ILM"
            },
            {
              "label": "vitreous"
            }
          ]
        },
        {
          "label": "spontaneous improvement",
          "children": [
            {
              "label": "visual function is unaffected once the hemorrhage clears"
            }
          ]
        },
        {
          "label": "vitrectomy for vitreous hemorrhage"
        }
      ]
    },
    {
      "label": "Valsalva Retinopathy",
      "children": [
        {
          "label": "treatment is similar to diabetic retinopathy"
        },
        {
          "label": "sudden rise in intrathoracic or intra-abdominal pressure",
          "children": [
            {
              "label": "coughing"
            },
            {
              "label": "vomiting"
            },
            {
              "label": "lifting"
            },
            {
              "label": "straining for a bowel movement"
            }
          ]
        },
        {
          "label": "rupture small superficial capillaries in the macula"
        },
        {
          "label": "Clinical",
          "children": [
            {
              "label": "hemorrhage",
              "children": [
                {
                  "label": "under the ILM",
                  "children": [
                    {
                      "label": "hemorrhagic detachment of the ILM"
                    }
                  ]
                },
                {
                  "label": "subretinal hemorrhage"
                },
                {
                  "label": "Vitreous hemorrhage"
                }
              ]
            },
            {
              "label": "vision is usually only mildly reduced"
            },
            {
              "label": "spontaneous resolution",
              "children": [
                {
                  "label": "within months"
                },
                {
                  "label": "prognosis is excellent"
                }
              ]
            }
          ]
        },
