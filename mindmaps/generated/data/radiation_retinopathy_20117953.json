  "children": [
    {
      "label": "Radiation Retinopathy",
      "children": [
        {
          "label": "Pathogenesis & Course",
          "children": [
            {
              "label": "ionizing radiation causes retinal microangiopathy",
              "children": [
                {
                  "label": "resembles diabetic retinopathy"
                }
              ]
            },
            {
              "label": "delayed onset",
              "children": [
                {
                  "label": "within months to years after radiation treatment",
                  "children": [
                    {
                      "label": "external-beam radiation",
                      "children": [
                        {
                          "label": "≈ 18 months"
                        }
                      ]
                    },
                    {
                      "label": "earlier with brachytherapy"
                    }
                  ]
                },
                {
                  "label": "slowly progressive"
                }
              ]
            },
            {
              "label": "determining factors",
              "children": [
                {
                  "label": "total dose",
                  "children": [
                    {
                      "label": "usually >30–35 grays (Gy)",
                      "children": [
                        {
                          "label": "even 15 Gy of external-beam radiation can cause retinopathy"
                        }
                      ]
                    },
                    {
                      "label": "60 Gy",
                      "children": [
                        {
                          "label": "50%"
                        }
                      ]
                    },
                    {
                      "label": "70–80 Gy",
                      "children": [
                        {
                          "label": "85%–95%"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "volume of retina irradiated"
                },
                {
                  "label": "fractionation scheme"
                }
              ]
            }
          ]
        },
        {
          "label": "Symptoms",
          "children": [
            {
              "label": "asymptomatic"
            },
            {
              "label": "decreased visual acuity"
            }
          ]
        },
        {
          "label": "Clinical Findings",
          "children": [
            {
              "label": "capillary telangiectasis"
            },
            {
              "label": "microaneurysms"
            },
            {
              "label": "retinal hemorrhages"
            },
            {
              "label": "cotton-wool spots"
            },
            {
              "label": "perivascular sheathing"
            },
            {
              "label": "central retinal vein occlusion"
            },
