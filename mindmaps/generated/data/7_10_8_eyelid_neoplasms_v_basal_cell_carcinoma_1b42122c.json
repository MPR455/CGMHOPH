                      ]
                    },
                    {
                      "label": "techniques",
                      "children": [
                        {
                          "label": "frozen section technique",
                          "children": [
                            {
                              "label": "surgeon excises the clinically apparent tumor along with 1–2 mm margins"
                            },
                            {
                              "label": "sends the entire specimen, oriented on a drawing, to the pathologist for frozen section evaluation"
                            }
                          ]
                        },
                        {
                          "label": "Mohs micrographic technique",
                          "children": [
                            {
