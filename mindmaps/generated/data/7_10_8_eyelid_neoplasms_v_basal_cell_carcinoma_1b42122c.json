      "label": "Management",
      "children": [
        {
          "label": "biopsy",
          "children": [
            {
              "label": "Figure 10-28"
            },
            {
              "label": "necessary to confirm clinical suspicion of basal cell carcinoma"
            },
            {
              "label": "incisional biopsy",
              "children": [
                {
                  "label": "confirmatory office procedure"
                },
                {
                  "label": "site of incisional biopsy should be photographed"
                },
                {
                  "label": "characteristics of good incisional biopsy",
                  "children": [
                    {
                      "label": "is representative of the clinically evident lesion"
                    },
                    {
                      "label": "is of adequate size for histologic processing"
                    },
                    {
                      "label": "is not excessively traumatized or crushed"
                    },
                    {
                      "label": "contains normal tissue at the margin to show the transitional area"
                    }
                  ]
                }
              ]
            },
            {
              "label": "excisional biopsy",
              "children": [
                {
                  "label": "when eyelid lesions are small and do not involve the eyelid margin"
