{
  "label": "5.14.3. Systemic Conditions (III): Immunologic Disorders (III): Multiple Sclerosis (II)",
  "root": true,
  "children": [
    {
      "label": "Chiasmal and retrochiasmal abnormalities",
      "children": [
        {
          "label": "white matter within the optic chiasm, optic tracts, and optic radiations is frequently involved",
          "children": [
            {
              "label": "13.2% after 1 year of follow-up"
            },
            {
              "label": "recovery pattern similar to that of optic neuritis"
            }
          ]
        }
      ]
    },
    {
      "label": "Ocular motility disturbances",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "diplopia"
            },
            {
              "label": "blurred vision"
            },
            {
              "label": "oscillopsia"
            }
          ]
        },
        {
          "label": "localized to supranuclear, nuclear, and fascicular portions of ocular motor system"
        },
        {
          "label": "bilateral internuclear ophthalmoplegia",
          "children": [
            {
              "label": "exotropia in primary position"
            },
            {
              "label": "bilaterally impaired adduction"
            },
            {
              "label": "wall-eyed, bilateral internuclear ophthalmoplegia, WEBINO",
              "children": [
                {
                  "label": "highly suggestive of MS < 50 years"
                }
              ]
            }
          ]
        },
        {
          "label": "horizontal or vertical gaze paralysis",
          "children": [
            {
              "label": "complete or partial"
            }
          ]
        },
        {
          "label": "skew deviation",
          "children": [
            {
              "label": "vertical misalignment not attributable to single nerve or muscle dysfunction"
            }
          ]
        },
        {
          "label": "isolated ocular motor cranial nerve palsy",
          "children": [
            {
              "label": "most likely reflect fascicular involvement and are frequently accompanied by other brainstem findings",
              "children": [
                {
                  "label": "MS must be considered in a young adult with an isolated ocular motor cranial nerve palsy and no history of trauma"
                }
              ]
            }
          ]
        },
        {
          "label": "nystagmus",
          "children": [
            {
              "label": "horizontal, rotary, or vertical",
              "children": [
                {
                  "label": "sixth nerve involvement is most common"
                }
              ]
            },
            {
              "label": "both pendular and jerk types may occur"
            },
            {
              "label": "concomitant vertical and horizontal nystagmus (out of phase)",
              "children": [
                {
                  "label": "circular or elliptical eye movements",
                  "children": [
                    {
                      "label": "highly suggestive of MS"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "common cerebellar eye findings",
          "children": [
            {
              "label": "rebound nystagmus"
            },
            {
              "label": "fixation instability (macrosaccadic oscillations)"
            },
            {
              "label": "saccadic dysmetria"
            },
            {
              "label": "abnormal pursuit movements"
            }
          ]
        },
        {
          "label": "dorsal midbrain (Parinaud) syndrome"
        }
      ]
    },
    {
      "label": "Treatment",
      "children": [
        {
          "label": "there is no cure for MS"
        },
        {
          "label": "several therapies slow the disease and assist specific symptoms"
        },
        {
          "label": "intravenous high-dose corticosteroids",
          "children": [
            {
              "label": "for acute exacerbations"
            }
          ]
        },
        {
          "label": "disease-modifying drugs",
          "children": [
            {
              "label": "for long-term treatment"
            },
            {
              "label": "drugs",
              "children": [
                {
                  "label": "Interferon beta-1b"
                },
                {
                  "label": "subcutaneous interferon beta-1a"
                },
                {
                  "label": "intramuscular interferon beta-1a"
                },
                {
                  "label": "glatiramer acetate"
                }
              ]
            },
            {
              "label": "reduce MS exacerbations by ≈1/3"
            },
            {
              "label": "show positive effect on MRI changes in patients with relapsing-remitting disease"
            },
            {
              "label": "early diagnosis and therapy are advantageous",
              "children": [
                {
                  "label": "disease-modifying injectable drugs",
                  "children": [
                    {
                      "label": "delay the development of clinically definite MS"
                    },
                    {
                      "label": "± reduce risk of disability progression compared with placebo"
                    }
                  ]
                }
              ]
            },
            {
              "label": "adverse effects",
              "children": [
                {
                  "label": "interferon",
                  "children": [
                    {
                      "label": "injection site reactions"
                    },
                    {
                      "label": "flulike symptoms"
                    },
                    {
                      "label": "abnormal results for blood count or liver function tests"
                    }
                  ]
                },
                {
                  "label": "glatiramer acetate",
                  "children": [
                    {
                      "label": "injection site reactions"
                    },
                    {
                      "label": "lipoatrophy"
                    },
                    {
                      "label": "immediate postinjection reactions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "should be managed by specialists"
            }
          ]
        },
        {
          "label": "mitoxantrone",
          "children": [
            {
              "label": "for worsening forms of relapsing-remitting and secondary progressive MS"
            }
          ]
        },
        {
          "label": "fingolimod",
          "children": [
            {
              "label": "once-daily oral medication"
            },
            {
              "label": "for relapsing MS"
            },
            {
              "label": "associated with risks including",
              "children": [
                {
                  "label": "cardiac symptoms",
                  "children": [
                    {
                      "label": "cystoid macular edema",
                      "children": [
                        {
                          "label": "0.4%"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "hepatic toxicity"
                }
              ]
            }
          ]
        },
        {
          "label": "natalizumab",
          "children": [
            {
              "label": "recombinant monoclonal antibody",
              "children": [
                {
                  "label": "increased susceptibility to serious viral infections"
                }
              ]
            },
            {
              "label": "prevents transmigration of leukocytes from the vasculature across the endothelium into the CNS"
            },
            {
              "label": "liver damage",
              "children": [
                {
                  "label": "associated with progressive multifocal leukoencephalopathy (viral infection)",
                  "children": [
                    {
                      "label": "≤ 1.8 cases per 1000 patients"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "additional drugs",
          "children": [
            {
              "label": "low-dose oral methotrexate"
            },
            {
              "label": "pulsed corticosteroids"
            },
            {
              "label": "cyclophosphamide"
            }
          ]
        },
        {
          "label": "these drugs should be used with caution by physicians experienced in MS therapy."
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Laboratory evaluation",
      "children": [
        {
          "label": "MS is a clinical diagnosis"
        },
        {
          "label": "CSF in patients with definite MS is abnormal in >90%",
          "children": [
            {
              "label": "elevation of the IgG/albumin index",
              "children": [
                {
                  "label": "elevation of immunoglobulin G (IgG)"
                }
              ]
            },
            {
              "label": "oligoclonal IgG bands",
              "children": [
                {
                  "label": "in CSF but not in serum"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Neuroimaging",
      "children": [
        {
          "label": "MRI with fluid-attenuated inversion recovery (FLAIR) sequencing + gadolinium",
          "children": [
            {
              "label": "neuroimaging study of choice",
              "children": [
                {
                  "label": "none of these findings is specific for demyelinating disease"
                }
              ]
            }
          ]
        },
        {
          "label": "sensitive for the identification of white matter plaques"
        },
        {
          "label": "far superior to CT scan for visualizing the posterior fossa and spinal cord"
        },
        {
          "label": "shows multiple lesions in",
          "children": [
            {
              "label": "66%–76% of patients with suspected MS",
              "children": [
                {
                  "label": "85%–95% of patients with clinically definite MS"
                }
              ]
            }
          ]
        },
        {
          "label": "MRI findings are not specific for MS"
        },
        {
          "label": "lesions fluctuate over time"
        },
        {
          "label": "lesions most consistent with MS",
          "children": [
            {
              "label": "multifocal"
            },
            {
              "label": "periventricular"
            },
            {
              "label": "ovoid"
            }
          ]
        },
        {
          "label": "active lesions will enhance with gadolinium- DTPA"
        },
        {
          "label": "hypointense regions on postcontrast T1- weighted scans (black holes)",
          "children": [
            {
              "label": "marker of progressive disease"
            }
          ]
        },
        {
          "label": "symptomatic optic neuritis",
          "children": [
            {
              "label": "best visualized on MRI with fat-suppression and gadolinium"
            }
          ]
        }
      ]
    },
    {
      "label": "Diagnosis of multiple sclerosis",
      "children": [
        {
          "label": "modified McDonald criteria",
          "children": [
            {
              "label": "based on the combination of clinical history and presentation along with neuroradiologic imaging, with or without CSF abnormality or an abnormal visual evoked response"
            }
          ]
        },
        {
          "label": "recurrent optic neuritis, in the absence of other clinical or laboratory manifestations, is not sufficient for diagnosis of MS"
        }
      ]
    }
  ],
