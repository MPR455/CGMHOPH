                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Hypoperfusion",
      "children": [
        {
          "label": "central retinal vein occlusion",
          "children": [
            {
              "label": "recovery to normal vision",
              "children": [
                {
                  "label": "TMVL lasting seconds to minutes"
                }
              ]
            },
            {
              "label": "symptoms may cease when collateral vessels develop",
              "children": [
                {
                  "label": "may predate more lasting visual loss by days or weeks"
                }
              ]
            }
          ]
        },
        {
          "label": "change in posture from a sitting to a standing position",
          "children": [
            {
              "label": "TMVL lasting seconds to 1–2 minutes"
            },
            {
              "label": "progressive restriction of vision from the periphery (“iris diaphragm pattern”)",
              "children": [
                {
                  "label": "cardiac arrhythmia"
                }
              ]
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "severe stenosis of the great vessels"
                },
                {
                  "label": "GCA"
                }
              ]
            }
          ]
        },
        {
          "label": "ocular ischemic syndrome",
          "children": [
            {
              "label": "etiology",
              "children": [
                {
                  "label": "vascular occlusion anywhere between the heart and the eye"
                }
              ]
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "recurrent orbital or facial pain that improves when the patient lies down",
                  "children": [
                    {
                      "label": "highly suggestive of carotid occlusive disease"
                    }
                  ]
                },
                {
                  "label": "transient visual loss on exposure to bright light"
                },
                {
                  "label": "transient or persistent blurred vision"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "early stages",
                  "children": [
                    {
                      "label": "midperipheral dot-and-blot hemorrhages",
                      "children": [
                        {
                          "label": "may resemble those associated with diabetes mellitus"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "late stages",
                  "children": [
                    {
                      "label": "anterior segment changes",
                      "children": [
                        {
                          "label": "red, painful eye",
                          "children": [
                            {
                              "label": "episcleral vascular injection"
                            }
                          ]
                        },
                        {
                          "label": "aqueous flare (ischemic uveitis)",
                          "children": [
                            {
                              "label": "may be confused with intraocular inflammation"
                            }
                          ]
                        },
                        {
                          "label": "neovascularization of the chamber angle and iris"
                        },
                        {
                          "label": "dilated retinal veins",
                          "children": [
                            {
                              "label": "intraocular pressure (IOP) may be low, normal, or high",
                              "children": [
                                {
                                  "label": "impaired ciliary body perfusion!"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "CEA",
                  "children": [
                    {
                      "label": "If preoperative IOP is low, CEA may precipitate dangerously high IOP",
                      "children": [
                        {
                          "label": "fundus changes",
                          "children": [
                            {
                              "label": "narrowed retinal arteries with microaneurysm formation"
                            },
                            {
                              "label": "midperipheral dot-and-blot hemorrhages"
                            },
                            {
                              "label": "macular edema"
                            }
                          ]
                        },
                        {
                          "label": "venous stasis retinopathy (VSR)"
                        }
                      ]
                    },
                    {
                      "label": "in some patients, carotid occlusion may be too advanced for surgical correction"
                    },
                    {
                      "label": "with signs of chronic hypoperfusion, improvement is unlikely",
                      "children": [
                        {
                          "label": "early detection is crucial!"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "IOP-lowering drugs"
                },
                {
                  "label": "corticosteroids for pain"
                },
                {
                  "label": "panretinal photocoagulation"
                }
              ]
            }
          ]
        }
