{
  "label": "5.5.3. Patient With Transient Visual Loss (III): Transient Monocular Visual Loss (TMVL) (III)",
  "root": true,
  "children": [
    {
      "label": "Vasospasm, Hyperviscosity, and Hypercoagulability",
      "children": [
        {
          "label": "vasospasm of the retinal artery",
          "children": [
            {
              "label": "rare",
              "children": [
                {
                  "label": "<50 years"
                }
              ]
            },
            {
              "label": "stereotypic episodes of painless TMVL",
              "children": [
                {
                  "label": "strong personal or family history of migraine"
                },
                {
                  "label": "often severe",
                  "children": [
                    {
                      "label": "± complete visual loss"
                    }
                  ]
                }
              ]
            },
            {
              "label": "ocular examination findings are usually normal",
              "children": [
                {
                  "label": "± constriction of retinal arteries"
                }
              ]
            },
            {
              "label": "workup",
              "children": [
                {
                  "label": "complete blood count",
                  "children": [
                    {
                      "label": "diagnosis of vasospastic TMVL is one of exclusion!",
                      "children": [
                        {
                          "label": "whether vasospasm can truly cause transient visual loss is debated"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "cardiac evaluation"
                },
                {
                  "label": "carotid imaging"
                },
                {
                  "label": "erythrocyte sedimentation rate and C-reactive protein concentration",
                  "children": [
                    {
                      "label": "50 years"
                    }
                  ]
                }
              ]
            },
            {
              "label": "calcium channel blockers",
              "children": [
                {
                  "label": "prevent vasospasm",
                  "children": [
                    {
                      "label": "seem to provide relief from amaurosis fugax in some patients"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "hyperviscosity syndrome & hypercoagulable states",
          "children": [
            {
              "label": "in younger patients"
            },
            {
              "label": "10% of patients with polycythemia vera complain of TMVL"
            },
            {
              "label": "serologic testing",
              "children": [
                {
                  "label": "anticardiolipin antibody"
                },
                {
                  "label": "antiphosphatidyl choline and serine"
                },
                {
                  "label": "antinuclear antibody"
                },
                {
                  "label": "serum protein electrophoresis"
                },
