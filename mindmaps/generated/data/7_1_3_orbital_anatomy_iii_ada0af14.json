                      "label": "joins the lacrimal nerve to enter the lacrimal gland"
                    }
                  ]
                },
                {
                  "label": "only the parasympathetic fibers synapse in the ciliary ganglion"
                }
              ]
            }
          ]
        },
        {
          "label": "sympathetic innervation",
          "children": [
            {
              "label": "sympathetic fibers originate in the hypothalamus",
              "children": [
                {
                  "label": "descend through the brainstem to the spinal cord",
                  "children": [
                    {
                      "label": "synapse in the ciliospinal center of Budge- Waller",
                      "children": [
                        {
                          "label": "travel with branches of the carotid artery to the orbit",
                          "children": [
                            {
                              "label": "pass through ciliary ganglion without synapse",
                              "children": [
                                {
                                  "label": "short ciliary nerves"
                                }
