                              "label": "nasociliary nerve",
                              "children": [
                                {
                                  "label": "long ciliary nerves"
                                }
                              ]
                            },
                            {
                              "label": "follow arterial supply to pupil, eyelids, and orbit"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
