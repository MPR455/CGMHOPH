            },
            {
              "label": "trap irritants"
            },
            {
              "label": "warm and humidify the air"
            }
          ]
        },
        {
          "label": "nasal cavity",
          "children": [
            {
              "label": "nasal septum"
            },
            {
              "label": "lateral wall",
              "children": [
                {
                  "label": "has 3 bony projections",
                  "children": [
                    {
                      "label": "superior, middle, and inferior conchae (turbinates)"
                    }
                  ]
                },
                {
                  "label": "meatuses",
                  "children": [
                    {
                      "label": "superior",
                      "children": [
                        {
                          "label": "posterior ethmoid air cells"
                        }
                      ]
                    },
                    {
                      "label": "middle",
                      "children": [
                        {
                          "label": "openings for",
                          "children": [
                            {
                              "label": "frontal sinus"
                            },
                            {
                              "label": "maxillary sinus"
                            },
                            {
                              "label": "anterior and middle ethmoid air cells"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "inferior",
                      "children": [
                        {
                          "label": "nasolacrimal duct opening"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "sphenoethmoidal recess",
                  "children": [
                    {
                      "label": "cephalad to the superior concha"
                    },
                    {
                      "label": "sphenoid sinus opening"
                    }
                  ]
                }
              ]
            },
            {
              "label": "lined by a pseudostratified, ciliated columnar epithelium",
              "children": [
                {
                  "label": "copious goblet cells"
                },
                {
                  "label": "mucous membrane overlying the lateral alar cartilage is hair bearing",
                  "children": [
                    {
                      "label": "less suitable for use as a composite graft in eyelid reconstruction",
                      "children": [
                        {
                          "label": "can use the mucoperichondrium over the nasal septum"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "frontal sinuses",
          "children": [
            {
              "label": "not seen radiographically until the sixth year of life",
              "children": [
                {
                  "label": "pneumatization continues through childhood",
                  "children": [
                    {
                      "label": "complete by early adulthood"
                    }
                  ]
                },
                {
                  "label": "sinuses can develop asymmetrically"
                }
              ]
            },
            {
              "label": "each frontal sinus drains through a separate frontonasal duct",
              "children": [
                {
                  "label": "anterior portion of the middle meatus"
                }
              ]
            }
          ]
        },
        {
          "label": "ethmoid air cells",
          "children": [
            {
              "label": "thin-walled cavities",
              "children": [
                {
                  "label": "between the medial orbital wall and the lateral wall of the nose"
                }
              ]
            },
            {
              "label": "present at birth",
              "children": [
                {
                  "label": "expand as the child grows"
                },
                {
                  "label": "can extend into frontal, lacrimal, and maxillary bones",
                  "children": [
                    {
                      "label": "may extend into the orbital roof",
                      "children": [
                        {
                          "label": "supraorbital ethmoids"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "divided into anterior, middle, and posterior air cells",
              "children": [
                {
                  "label": "drainage",
                  "children": [
                    {
                      "label": "anterior and middle air cells into middle meatus"
                    },
                    {
                      "label": "posterior air cells into superior meatus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "sinusitis in the ethmoids is a common cause of",
              "children": [
                {
                  "label": "orbital cellulitis"
                },
                {
                  "label": "medial orbital subperiosteal effusions or abscesses"
                },
                {
                  "label": "inflammation or infection spreads through the thin bone or the vascular foramina of the medial orbital wall"
                }
              ]
            }
          ]
        },
        {
          "label": "maxillary sinuses",
          "children": [
            {
              "label": "largest of the paranasal sinuses",
              "children": [
                {
                  "label": "extend posteriorly to the inferior orbital fissure"
                }
              ]
            },
            {
              "label": "roof of each maxillary sinus forms the floor of each orbit",
              "children": [
                {
                  "label": "infraorbital nerve and artery travel along the roof of the sinus"
                },
                {
                  "label": "orbital blowout fractures",
                  "children": [
                    {
                      "label": "disrupt the floor of the orbit medial to the infraorbital canal",
                      "children": [
                        {
                          "label": "infraorbital nerve is often compromised",
                          "children": [
                            {
                              "label": "hypoesthesia of the cheek, upper lip, and maxillary teeth"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "drains into the middle meatus",
              "children": [
                {
                  "label": "maxillary ostium"
                }
              ]
            },
            {
              "label": "bony nasolacrimal canal lies within the medial wall"
            }
          ]
        }
      ]
    },
    {
      "label": "Lacrimal Gland",
      "children": [
        {
          "label": "2 lobes",
          "children": [
            {
              "label": "orbital lobe",
              "children": [
                {
                  "label": "located within a fossa of frontal bone (lacrimal fossa)"
                },
                {
                  "label": "may prolapse inferiorly out of the fossa and present as a mass in lateral upper eyelid"
                }
              ]
            },
            {
              "label": "smaller palpebral lobe",
              "children": [
                {
                  "label": "ducts from both lobes pass through the palpebral lobe",
                  "children": [
                    {
                      "label": "empty into the upper conjunctival fornix"
                    },
                    {
                      "label": "biopsy is generally not performed on the palpebral lobe or temporal conjunctival fornix because it can interfere with lacrimal drainage"
                    }
                  ]
                }
              ]
            }
          ]
        }
