{
  "label": "8.3.3. Eyelid Diseases Associated With Ocular Surface Disorders (I)",
  "root": true,
  "children": [
    {
      "label": "internal hordeola",
      "children": [
        {
          "label": "on the posterior eyelid",
          "children": [
            {
              "label": "meibomian glands"
            }
          ]
        }
      ]
    },
    {
      "label": "Hordeola and Chalazia",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "hordeola",
              "children": [
                {
                  "label": "painful, tender, red nodular masses near the eyelid margin"
                },
                {
                  "label": "external hordeola",
                  "children": [
                    {
                      "label": "styes"
                    },
                    {
                      "label": "on the anterior eyelid",
                      "children": [
                        {
                          "label": "glands of Zeis or lash follicles"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "localized purulent abscess",
                  "children": [
                    {
                      "label": "S aureus"
                    }
                  ]
                },
                {
                  "label": "generally self-limited",
                  "children": [
                    {
                      "label": "improve spontaneously over the course of 1–2 weeks"
                    }
                  ]
                }
              ]
            },
            {
              "label": "chalazia",
              "children": [
                {
                  "label": "internal hordeola occasionally evolve into chalazia",
                  "children": [
                    {
                      "label": "from meibomian glands (or glands of Zeis)"
                    }
                  ]
                },
                {
                  "label": "blurred vision secondary to astigmatism induced by its pressure on globe",
                  "children": [
                    {
                      "label": "chronic lipogranulomatous nodules"
                    }
                  ]
                },
                {
                  "label": "disappears in weeks to months",
                  "children": [
                    {
                      "label": "drain either externally through the eyelid skin or internally through the tarsus"
                    },
                    {
                      "label": "extruded lipid is phagocytosed and the granuloma dissipates"
                    },
                    {
                      "label": "a small amount of scar tissue may remain"
                    }
                  ]
                },
                {
                  "label": "basal cell, squamous cell, and sebaceous cell carcinoma can masquerade as chalazia (or chronic blepharitis)",
                  "children": [
                    {
                      "label": "histologic examination of persistent, recurrent, or atypical chalazia is therefore important"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "cultures",
              "children": [
                {
                  "label": "not indicated for isolated, uncomplicated hordeolum or chalazion"
                }
              ]
            },
            {
              "label": "warm compresses",
              "children": [
                {
                  "label": "with light massage over the lesion"
                }
              ]
            },
            {
              "label": "topical antibiotics",
              "children": [
                {
                  "label": "generally not effective and, therefore, are not indicated"
                },
                {
                  "label": "unless accompanying infectious blepharoconjunctivitis is present"
                }
              ]
            },
            {
              "label": "systemic antibiotics",
              "children": [
                {
                  "label": "indications",
                  "children": [
                    {
                      "label": "secondary eyelid cellulitis",
                      "children": [
                        {
                          "label": "rare"
                        }
                      ]
                    },
                    {
                      "label": "oral doxycycline",
                      "children": [
                        {
                          "label": "prominent and chronic accompanying meibomitis"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "intralesional injection of corticosteroid",
              "children": [
                {
                  "label": "for chalazia resistant to warm compresses and eyelid hygiene"
                },
                {
                  "label": "works best with",
                  "children": [
                    {
                      "label": "small chalazia"
                    },
                    {
                      "label": "chalazia on the eyelid margin"
                    },
                    {
                      "label": "multiple chalazia"
                    }
                  ]
                },
                {
                  "label": "0.1–0.2 mL of triamcinolone 40 mg/mL",
                  "children": [
                    {
                      "label": "may lead to depigmentation of the overlying eyelid skin in patients with dark skin"
                    }
                  ]
                }
              ]
            },
            {
              "label": "incision and drainage",
              "children": [
                {
                  "label": "for large chalazia"
                },
                {
                  "label": "internal chalazia require vertical incisions through the tarsal conjunctiva along the meibomian gland",
                  "children": [
                    {
                      "label": "avoid horizontal scarring of tarsal plates"
                    }
                  ]
                },
                {
                  "label": "perilesional anesthesia"
                }
              ]
            },
            {
              "label": "recurrent chalazia should be biopsied to rule out meibomian gland carcinoma"
            }
          ]
        }
      ]
    },
    {
      "label": "eyelid margin telangiectasia"
    },
    {
      "label": "Rosacea",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "aged 30–60 years",
              "children": [
                {
                  "label": "can be encountered in younger patients and is often underdiagnosed"
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "no proven cause",
              "children": [
                {
                  "label": "slight F preponderance"
                }
              ]
            },
            {
              "label": "± overexpression of cathelicidin antimicrobial peptides",
              "children": [
                {
                  "label": "neutrophil recruitment",
                  "children": [
                    {
                      "label": "angiogenesis"
                    },
                    {
                      "label": "cytokine release"
                    }
                  ]
                }
              ]
            },
            {
              "label": "alcohol can contribute to a worsening of this disorder"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "cutaneous sebaceous gland dysfunction",
              "children": [
                {
                  "label": "face"
                },
                {
                  "label": "neck"
                },
                {
                  "label": "shoulders"
                }
              ]
            },
            {
              "label": "facial lesions",
              "children": [
                {
                  "label": "telangiectasias"
                },
                {
                  "label": "recurrent papules and pustules"
                },
                {
                  "label": "midfacial erythema",
                  "children": [
                    {
                      "label": "malar rash",
                      "children": [
                        {
                          "label": "unpredictable flushing episodes",
                          "children": [
                            {
                              "label": "alcohol"
                            },
                            {
                              "label": "coffee"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "rhinophyma",
                  "children": [
                    {
                      "label": "thickening of the skin and connective tissue of the nose"
                    },
                    {
                      "label": "occur relatively late"
                    }
                  ]
                },
                {
                  "label": "external examination under bright room light"
                }
              ]
            },
            {
              "label": "ocular findings",
              "children": [
                {
                  "label": "recalcitrant chronic blepharitis"
                },
                {
                  "label": "meibomian gland distortion, disruption, and dysfunction",
                  "children": [
                    {
                      "label": "excessive sebum secretion"
                    }
                  ]
                },
                {
                  "label": "recurrent chalazia"
                },
                {
                  "label": "chronic conjunctivitis"
                },
                {
                  "label": "marginal corneal infiltrates"
                },
                {
                  "label": "sterile ulceration"
                },
                {
                  "label": "episcleritis"
                },
                {
                  "label": "iridocyclitis"
                },
                {
                  "label": "corneal neovascularization and scarring",
                  "children": [
                    {
                      "label": "secondary to repeated bouts of ocular surface inflammation"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "ocular and systemic diseases are managed simultaneously"
            },
            {
              "label": "systemic tetracyclines as the mainstay of therapy",
              "children": [
                {
                  "label": "anti-inflammatory properties",
                  "children": [
                    {
                      "label": "suppression of leukocyte migration"
                    },
                    {
                      "label": "reduced production of nitric oxide and reactive oxygen species"
                    },
                    {
                      "label": "inhibition of matrix metalloproteinases (MMPs)"
                    },
                    {
                      "label": "inhibition of phospholipase A2"
                    },
                    {
                      "label": "reduce irritative free fatty acids and diglycerides by suppressing bacterial lipases"
                    }
                  ]
                },
                {
                  "label": "oral therapy",
                  "children": [
                    {
                      "label": "doxycycline"
                    },
                    {
                      "label": "minocycline"
                    }
                  ]
                }
              ]
            },
            {
              "label": "facial erythema",
              "children": [
                {
                  "label": "topical metronidazole 1% cream",
                  "children": [
                    {
                      "label": "topical metronidazole 0.75% gel"
                    }
                  ]
                },
                {
                  "label": "azelaic acid gel 15%",
                  "children": [
                    {
                      "label": "the only gel approved by FDA for treatment of papulopustular rosacea"
                    }
                  ]
                }
              ]
            },
            {
              "label": "ulcerative keratitis",
              "children": [
                {
                  "label": "infectious etiology"
                },
                {
                  "label": "sterile inflammatory etiology",
                  "children": [
                    {
                      "label": "topical corticosteroids",
                      "children": [
                        {
                          "label": "used judiciously"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "advanced cases with scarring and neovascularization",
              "children": [
                {
                  "label": "conservative therapy is generally recommended"
                }
              ]
            },
            {
              "label": "PK",
              "children": [
                {
                  "label": "high-risk procedure in rosacea patients"
                }
              ]
            },
            {
              "label": "light-pulse treatment",
              "children": [
                {
                  "label": "to reduce eyelid erythema"
                }
              ]
            }
          ]
        }
