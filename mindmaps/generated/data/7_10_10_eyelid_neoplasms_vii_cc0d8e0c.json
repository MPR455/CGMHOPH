{
  "label": "7.10.10. Eyelid Neoplasms (VII)",
  "root": true,
  "children": [
    {
      "label": "Melanoma",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "incidence of melanoma in United States has been steadily increasing over the past 30 years"
            },
            {
              "label": "5% of cutaneous cancers",
              "children": [
                {
                  "label": "<0.1% of eyelid cancers"
                }
              ]
            },
            {
              "label": "75% of cutaneous cancer deaths"
            },
            {
              "label": "predisposing factors",
              "children": [
                {
                  "label": "sunlight exposure"
                },
                {
                  "label": "genetic predisposition"
                },
                {
                  "label": "environmental mutagens"
                }
              ]
            },
            {
              "label": "predisposing lesions",
              "children": [
                {
                  "label": "de novo"
                },
                {
                  "label": "preexisting melanocytic nevi"
                },
                {
                  "label": "lentigo maligna"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "variable pigmentation"
            },
            {
              "label": "irregular borders"
            },
            {
              "label": "± ulcerate and bleed"
            },
            {
              "label": "should be suspected in any patient with an acquired pigmented lesion beyond the first 2 decades of life",
              "children": [
                {
                  "label": "30-50%"
                }
              ]
            }
          ]
        },
        {
          "label": "4 clinicopathologic forms",
          "children": [
            {
              "label": "lentigo maligna melanoma",
              "children": [
                {
                  "label": "invasive vertical malignant growth occurring in 10%–20% of lentigo malignas",
                  "children": [
                    {
                      "label": "invasive areas are marked by nodule formation within the broader, flat, tan to brown irregular macule"
                    }
                  ]
                },
                {
                  "label": "90% of head and neck melanomas"
                },
                {
                  "label": "eyelid is usually involved by secondary extension from the malar region"
                },
                {
                  "label": "pigmentation may progress over the eyelid margin and onto the conjunctival surface"
                },
                {
                  "label": "surgical excision",
                  "children": [
                    {
                      "label": "recommended for a premalignant lentigo maligna"
                    },
                    {
                      "label": "mandatory for lentigo maligna melanoma"
                    }
                  ]
                }
              ]
            },
            {
              "label": "nodular melanoma",
              "children": [
                {
                  "label": "10% of cutaneous melanomas",
                  "children": [
                    {
                      "label": "extremely rare on the eyelids"
                    }
                  ]
                },
                {
                  "label": "may be amelanotic"
                }
              ]
            },
            {
              "label": "superficial spreading melanoma"
            },
            {
              "label": "acrolentiginous melanoma"
            },
            {
              "label": "eyelid is most often involved by either lentigo maligna melanoma or nodular melanoma"
            }
          ]
        },
        {
          "label": "prognosis",
          "children": [
            {
              "label": "tumor thickness has strong prognostic implications",
              "children": [
                {
                  "label": "thin lesions (<0.75 mm)",
                  "children": [
                    {
                      "label": "5-year survival rate of 98%"
                    }
                  ]
                },
                {
                  "label": "thicker lesions (>4 mm) with ulceration",
                  "children": [
                    {
                      "label": "survival rate of <50%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "biopsy of these lesions does not increase the risk of metastatic spread"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "wide surgical excision",
              "children": [
                {
                  "label": "histologic assurance (by means of permanent sections) of complete tumor removal"
                },
                {
                  "label": "periocular regions",
                  "children": [
                    {
                      "label": "margins <1 cm are often used"
                    }
                  ]
                }
              ]
            },
            {
              "label": "regional sentinel lymph node biopsy",
              "children": [
                {
                  "label": "indications",
                  "children": [
                    {
                      "label": "microscopic evidence of vascular or lymphatic involvement"
                    },
                    {
                      "label": "Breslow thickness >1 mm"
                    }
                  ]
                }
              ]
            },
            {
              "label": "complete preoperative metastatic workup",
              "children": [
                {
                  "label": "tumor thickness >1.5 mm"
                }
              ]
            },
            {
              "label": "cryotherapy",
              "children": [
                {
                  "label": "should not be considered for treatment of cutaneous melanoma"
                },
                {
                  "label": "may have a role in the treatment of acquired melanomas in the conjunctiva"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Sebaceous adenocarcinoma",
      "children": [
        {
          "label": "arises from",
          "children": [
            {
              "label": "meibomian glands of the tarsal plate"
            },
            {
              "label": "glands of Zeis",
              "children": [
                {
                  "label": "associated with the eyelashes"
                }
              ]
            },
            {
              "label": "sebaceous glands of caruncle, eyebrow, or facial skin"
            },
            {
              "label": "multicentric origin is common",
              "children": [
                {
                  "label": "separate upper and lower eyelid tumors in 6%–8%"
                }
              ]
            }
          ]
        },
        {
          "label": ".>50 years"
        },
        {
          "label": "F>M"
        },
        {
          "label": "upper lid: lower eyelid = 2:1",
          "children": [
            {
              "label": "greater numbers of meibomian and Zeis glands in the upper eyelid"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "course",
              "children": [
                {
                  "label": "tumor within the tarsal plate",
                  "children": [
                    {
                      "label": "intraepidermal/intraepithelial growth",
                      "children": [
                        {
                          "label": "extends over the palpebral and bulbar conjunctiva"
                        },
                        {
                          "label": "may replace corneal epithelium"
                        },
                        {
                          "label": "fine papillary elevation of the tarsal conjunctiva may indicate pagetoid spread of tumor cells"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "appears yellow as a result of lipid material within the neoplastic cells"
            },
            {
              "label": "effacement of the meibomian gland orifices"
            },
            {
              "label": "destruction of follicles of the cilia",
              "children": [
                {
                  "label": "loss of eyelashes"
                }
              ]
            },
            {
              "label": "conjunctival inflammation/hyperemia"
            },
            {
              "label": "nodule",
              "children": [
                {
                  "label": "initially simulates a chalazion"
                },
                {
                  "label": "later causes loss of eyelashes and destruction of the meibomian gland orifices"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "chalazia",
              "children": [
                {
                  "label": "material from a chalazion that has been surgically excised more than once should be submitted for histologic examination"
                }
              ]
            },
            {
              "label": "chronic blepharitis",
              "children": [
                {
                  "label": "any chronic unilateral blepharitis could raise the possibility of sebaceous gland carcinoma"
                }
              ]
            },
            {
              "label": "basal cell or squamous cell carcinoma"
            },
            {
              "label": "mucous membrane (ocular cicatricial) pemphigoid"
            },
            {
              "label": "superior limbic keratoconjunctivitis"
            },
            {
              "label": "pannus associated with adult inclusion conjunctivitis"
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "rate of histologic misdiagnosis is high among general pathologists"
            },
            {
              "label": "clinician should maintain suspicion based on clinical findings",
              "children": [
                {
                  "label": "request special stains (lipid) or outside consultation"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "superficial shave biopsies may reveal chronic inflammation but miss the underlying tumor"
            },
            {
              "label": "full-thickness eyelid biopsy"
            },
            {
              "label": "full-thickness punch biopsy of the tarsal plate"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "surgical excision"
            },
            {
              "label": "Mohs micrographic surgery",
              "children": [
                {
                  "label": "considerable caution is required because of the skip areas, pagetoid spread, and polycentricity"
                }
              ]
            },
            {
              "label": "map biopsies of the conjunctiva",
              "children": [
                {
                  "label": "to eliminate the potential of pagetoid spread"
                }
              ]
            },
            {
              "label": "adjunctive cryotherapy",
              "children": [
                {
                  "label": "for pagetoid spread"
                }
              ]
            },
            {
              "label": "orbital exenteration",
              "children": [
                {
                  "label": "for recurrent or large tumors invading through the orbital septum"
                }
              ]
            },
            {
              "label": "radiation therapy",
              "children": [
                {
                  "label": "usually not appropriate"
                },
                {
                  "label": "relatively radioresistant"
                }
              ]
            },
            {
              "label": "metastasis",
              "children": [
                {
                  "label": "regional lymph nodes",
                  "children": [
                    {
                      "label": "most common",
                      "children": [
                        {
                          "label": "commonly occurs before metastasis to distant sites"
                        }
                      ]
                    },
                    {
                      "label": "identification of microscopic regional nodal metastases may",
                      "children": [
                        {
                          "label": "indicate that more extensive therapy is warranted"
                        },
                        {
                          "label": "provide prognostic information to the physician and the patient"
                        }
                      ]
                    },
                    {
                      "label": "with the exception of basal cell carcinoma, cancers of eyelid and conjunctiva typically metastasize to regional lymph nodes"
                    }
                  ]
                },
                {
                  "label": "hematogenous",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                },
                {
                  "label": "direct extension",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                }
              ]
            },
            {
              "label": "sentinel lymph node biopsy",
              "children": [
                {
                  "label": "eyelid sebaceous cell carcinoma with high-risk features",
                  "children": [
                    {
                      "label": "recurrent lesions"
                    },
                    {
                      "label": "extensive involvement of the eyelid or orbit"
                    }
                  ]
                },
                {
                  "label": "conjunctival or cutaneous melanoma with a Breslow thickness greater than 1 mm"
                },
                {
                  "label": "Merkel cell carcinoma of the eyelid"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
