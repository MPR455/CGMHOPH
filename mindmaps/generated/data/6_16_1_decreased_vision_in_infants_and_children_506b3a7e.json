    {
      "label": "Normal Visual Development",
      "children": [
        {
          "label": "normal vision develops as a result of both genetic coding and experience in a normal visual environment"
        },
        {
          "label": "time table of visual development",
          "children": [
            {
              "label": "after 31 weeks’ gestation",
              "children": [
                {
                  "label": "pupillary light reflex",
                  "children": [
                    {
                      "label": "difficult to evaluate in early neonatal period because pupils are miotic"
                    }
                  ]
                }
              ]
            },
            {
              "label": "within a few days of birth",
              "children": [
                {
                  "label": "blink reflex to bright light"
                }
              ]
            },
            {
              "label": "6–8 weeks of age",
              "children": [
                {
                  "label": "make and maintain eye contact with other humans (and react with facial expressions)"
                }
              ]
            },
            {
              "label": "2–3 months of age",
              "children": [
                {
                  "label": "interested in bright objects"
                }
              ]
            },
            {
              "label": "3–4 months of age",
              "children": [
                {
                  "label": "smooth pursuit asymmetry should have resolved"
                },
                {
                  "label": "eyes should be orthotropic"
                },
                {
                  "label": "fix-and-follow visual responses to a small (2–4 inches in diameter) toy should be present"
                }
              ]
            }
          ]
        },
        {
          "label": "Premature infants can be expected to reach these landmarks later"
        },
        {
          "label": "eye movements that may be noted in healthy newborns but should not persist beyond 4 months of age",
          "children": [
            {
              "label": "disconjugate eye movements"
            },
            {
              "label": "skew deviation"
            },
            {
              "label": "sunsetting",
              "children": [
                {
                  "label": "tonic downward deviation of both eyes"
                }
              ]
            }
          ]
        },
        {
          "label": "Signs of poor visual development",
          "children": [
            {
              "label": "searching eye movements"
            },
            {
              "label": "lack of response to familiar faces and objects"
            },
            {
              "label": "nystagmus"
            },
            {
              "label": "staring at bright lights",
              "children": [
