                  "label": "suggest an ocular cause for the deficiency"
                }
              ]
            },
            {
              "label": "forceful rubbing or poking of the eyes (oculodigital reflex)",
              "children": [
                {
                  "label": "suggest an ocular cause for the deficiency"
                }
              ]
            }
          ]
        }
      ]
