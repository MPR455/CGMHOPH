{
  "label": "5.14.5. Systemic Conditions (V): Immunologic Disorders (V): Sarcoidosis",
  "root": true,
  "children": [
    {
      "label": "Diagnosis and treatment",
      "children": [
        {
          "label": "most patients with neurosarcoidosis exhibit abnormalities on MRI",
          "children": [
            {
              "label": "82%",
              "children": [
                {
                  "label": "meningeal and leptomeningeal enhancing lesion",
                  "children": [
                    {
                      "label": "most common"
                    }
                  ]
                }
              ]
            },
            {
              "label": "nonspecific"
            }
          ]
        },
        {
          "label": "angiotensin-converting enzyme (ACE)",
          "children": [
            {
              "label": "elevated in 52–90%",
              "children": [
                {
                  "label": "if sarcoidosis is active!"
                }
              ]
            }
          ]
        },
        {
          "label": "gallium scan",
          "children": [
            {
              "label": "not specific"
            }
          ]
        },
        {
          "label": "high ACE + positive gallium scan",
          "children": [
            {
              "label": "100% specific and 73% sensitive"
            }
          ]
        },
        {
          "label": "FDG-PET/CT",
          "children": [
            {
              "label": "abnormal findings can also be present in malignancies",
              "children": [
                {
                  "label": "in particular lymphoma"
                }
              ]
            }
          ]
        },
        {
          "label": "histologic studies",
          "children": [
            {
              "label": "conjunctiva, lymph nodes, or lung"
            },
            {
              "label": "noncaseating granulomas"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "corticosteroids"
            },
            {
              "label": "other immune modulatory therapy"
            }
          ]
        }
      ]
    },
