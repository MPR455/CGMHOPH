    },
    {
      "label": "Occipital Ischemia",
      "children": [
        {
          "label": "vertebrobasilar insufficiency",
          "children": [
            {
              "label": "vertebrobasilar system supplies",
              "children": [
                {
                  "label": "occipital cortex"
                },
                {
                  "label": "brainstem"
                },
                {
                  "label": "cerebellum"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "transient recurrent bilateral visual blurring"
            },
            {
              "label": "ocular motor symptoms"
            },
            {
              "label": "nonophthalmic symptoms of vertebrobasilar insufficiency"
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "migraine",
              "children": [
                {
                  "label": "intensity of migraine headaches diminish with age",
                  "children": [
                    {
                      "label": "headaches may not occur at all after visual symptoms"
                    }
                  ]
                },
                {
                  "label": "elderly patient who experiences a migraine- like aura for the first time but no headache",
                  "children": [
                    {
                      "label": "order diagnostic workup"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "complete blood count",
              "children": [
                {
                  "label": "treatable causes of cerebrovascular disease or a source of emboli should be excluded"
                }
              ]
            },
            {
              "label": "erythrocyte sedimentation rate"
            },
            {
              "label": "C-reactive protein"
            },
            {
              "label": "MRI"
            },
            {
              "label": "MRA"
            },
            {
              "label": "if the results of these studies are negative, the prognosis is usually good",
              "children": [
                {
                  "label": "treatment of a presumed migrainous syndrome may be warranted"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Migraine",
      "children": [
        {
          "label": "most common cause of transient binocular visual loss"
        },
        {
          "label": "homonymous hemianopic defect"
        },
        {
          "label": "may progress to a fixed visual field defect",
          "children": [
            {
              "label": "“complicated” migraine"
            },
            {
              "label": "MRI is mandatory in such instances"
            }
          ]
        }
      ]
    },
    {
      "label": "Occipital Mass Lesions",
      "children": [
        {
          "label": "attacks always occur on the same side"
        },
        {
          "label": "visual symptoms follow rather than precede the onset of headache"
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "arteriovenous malformation"
            },
            {
              "label": "tumor"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "contrast-enhanced cranial MRI"
            },
            {
              "label": "cerebral angiography"
            }
          ]
        }
      ]
    },
    {
      "label": "Occipital Seizures",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "unformed positive visual phenomena",
              "children": [
                {
                  "label": "colored or swirling lights"
                }
              ]
            },
            {
              "label": "purely negative visual symptoms",
              "children": [
                {
                  "label": "blacking out of vision",
                  "children": [
                    {
                      "label": "whiting out of vision",
                      "children": [
                        {
                          "label": "“like a flashbulb going off”"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "last 1–2 minutes",
              "children": [
                {
                  "label": "may persist for many hours",
                  "children": [
                    {
                      "label": "status epilepticus amauroticus"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "adults",
              "children": [
                {
                  "label": "most adults with occipital seizures have a structural lesion",
                  "children": [
                    {
                      "label": "tumor"
                    },
                    {
                      "label": "arteriovenous malformation"
                    },
                    {
                      "label": "trauma"
                    }
                  ]
                }
              ]
            },
            {
              "label": "children",
              "children": [
                {
                  "label": "occipital seizures are more often benign"
                }
              ]
            }
          ]
        },
        {
          "label": "normal EEG does not rule out an underlying seizure disorder",
          "children": [
            {
              "label": "prolonged EEG monitoring may be required!"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "anticonvulsant therapy"
            }
          ]
        }
      ]
    }
