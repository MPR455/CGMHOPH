{
  "label": "9.5.8. Clinical approach to uveitis (VIII): Medical Management (III): Immunomodulatory Medications (I)",
  "root": true,
  "children": [
    {
      "label": "Introduction to Immunomodulatory Medications",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "inadequate/failed response to corticosteroid treatment"
            },
            {
              "label": "corticosteroids contraindicated because of systemic problems"
            },
            {
              "label": "early use of IMT is indicated in certain uveitic entities",
              "children": [
                {
                  "label": "initial treatment of these entities with IMT has been shown to improve long-term prognosis"
                },
                {
                  "label": "necrotizing scleritis associated with systemic vasculitis"
                },
                {
                  "label": "ocular cicatricial pemphigoid"
                },
                {
                  "label": "serpiginous choroiditis"
                },
                {
                  "label": "Behçet disease"
                },
                {
                  "label": "sympathetic ophthalmia"
                },
                {
                  "label": "VKH syndrome"
                }
              ]
            },
            {
              "label": "severe vision-threatening uveitis"
            },
            {
              "label": "disease process that is likely reversible"
            },
            {
              "label": "serious corticosteroid-induced adverse effects",
              "children": [
                {
                  "label": ".>3 months at doses greater than 5–10 mg/ day"
                }
              ]
            },
            {
              "label": "long-term corticosteroid dependence",
              "children": [
                {
                  "label": "patients requiring repeat corticosteroid injections"
                }
              ]
            }
          ]
        },
        {
          "label": "general",
          "children": [
            {
              "label": "before initiating IMT, the physician should ensure",
              "children": [
                {
                  "label": "an absence of hepatic and hematologic contraindications"
                },
                {
                  "label": "meticulous follow-up by a practitioner experienced with IMT"
                },
                {
                  "label": "objective longitudinal evaluation of the disease process"
                },
                {
                  "label": "an absence of infection"
                },
                {
                  "label": "delay in therapeutic response for weeks - months after initiation of IMT",
                  "children": [
                    {
                      "label": "informed consent"
                    },
                    {
                      "label": "most patients need to be on corticosteroids until the immunomodulatory effect begins"
                    }
                  ]
                }
              ]
            },
            {
              "label": "classes of immunomodulatory medications",
              "children": [
                {
                  "label": "antimetabolites"
                },
                {
                  "label": "inhibitors of T-cell signaling"
                },
                {
                  "label": "alkylating agents"
                },
                {
                  "label": "biologic response modifiers"
                }
              ]
            },
            {
              "label": "serious complications",
              "children": [
                {
                  "label": "renal and hepatic toxicity",
                  "children": [
                    {
                      "label": "liver and renal function tests"
                    }
                  ]
                },
                {
                  "label": "bone marrow suppression",
                  "children": [
                    {
                      "label": "complete blood count"
                    }
                  ]
                },
                {
                  "label": "increased susceptibility to infection",
                  "children": [
                    {
                      "label": "trimethoprim-sulfamethoxazole prophylaxis against Pneumocystis jirovecii (Pneumocystis carinii) in patients on alkylating agents"
                    }
                  ]
                },
                {
                  "label": "potentially teratogenic",
                  "children": [
                    {
                      "label": "avoid becoming pregnant"
                    }
                  ]
                },
                {
                  "label": "alkylating agents",
                  "children": [
                    {
                      "label": "increased risk of future malignancies (leukemia or lymphoma)",
                      "children": [
                        {
                          "label": "study of 7957 patients with noninfectious uveitis treated with IMT",
                          "children": [
                            {
                              "label": "no overall cancer mortality rates",
                              "children": [
                                {
                                  "label": "tumor necrosis factor inhibitors were associated with increased overall (x2) and cancer (x3.8) risk of mortality"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "sterility"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
