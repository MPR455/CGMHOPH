{
  "label": "5.3.4. The Patient With Decreased Vision: Evaluation (IV): Adjunctive testing",
  "root": true,
  "children": [
    {
      "label": "second positive (P2) peaks"
    },
    {
      "label": "Contrast sensitivity",
      "children": [
        {
          "label": "can detect and quantify vision loss in the presence of normal visual acuity"
        },
        {
          "label": "not specific for optic nerve dysfunction",
          "children": [
            {
              "label": "media irregularities"
            },
            {
              "label": "macular lesions"
            }
          ]
        },
        {
          "label": "interpreting contrast sensitivity test data is more complicated"
        },
        {
          "label": "2 types",
          "children": [
            {
              "label": "grating tests",
              "children": [
                {
                  "label": "rows of sine wave grating patches",
                  "children": [
                    {
                      "label": "each row reflects a different spatial frequency"
                    }
                  ]
                },
                {
                  "label": "contrast threshold",
                  "children": [
                    {
                      "label": "minimum contrast the patient can detect at each spatial frequency level"
                    }
                  ]
                },
                {
                  "label": "contrast sensitivity function (CSF)",
                  "children": [
                    {
                      "label": "graph of threshold versus frequency"
                    },
                    {
                      "label": "represents the sensitivity of the central retinal region over a range of contrast levels"
                    }
                  ]
                },
                {
                  "label": "difficult to administer and to reproduce reliably"
                }
              ]
            },
            {
              "label": "letter tests",
              "children": [
                {
                  "label": "single-size optotype with a gradually diminishing contrast level"
                },
                {
                  "label": "low-contrast letters of decreasing size"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "arguably superior to letter tests"
    },
    {
      "label": "Photostress recovery test",
      "children": [
        {
          "label": "to differentiate vision loss caused by macular lesion or ocular ischemia from optic neuropathy",
          "children": [
            {
              "label": "maculopathy",
              "children": [
                {
                  "label": "prolonged recovery times",
                  "children": [
                    {
                      "label": "≥ 90–180 seconds"
                    }
                  ]
                }
              ]
            },
            {
              "label": "severe carotid artery stenosis"
            }
          ]
        },
        {
          "label": "technique",
          "children": [
            {
              "label": "best-corrected visual acuity is measured",
              "children": [
                {
                  "label": "optic neuropathy",
                  "children": [
                    {
                      "label": "normal recovery times",
                      "children": [
                        {
                          "label": "<30 seconds"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "visual acuity must be ≥20/80"
                }
              ]
            },
            {
              "label": "test monocularly"
            },
            {
              "label": "patient gazes directly x 10 seconds into a strong light held 2–3 cm from the eye"
            },
            {
              "label": "patient attempts to read the next larger Snellen visual acuity line above his BCVA"
            }
          ]
        }
      ]
    },
    {
      "label": "Potential acuity meter",
      "children": [
        {
          "label": "to determine if media irregularities or opacities are the cause of decreased vision",
          "children": [
            {
              "label": "provides an estimate of best potential visual acuity"
            }
          ]
        },
        {
          "label": "optotypes are projected onto the retina through a dilated pupil"
        },
        {
          "label": "20/100 visual acuity that improves to 20/20 on PAM testing",
          "children": [
            {
              "label": "probably does not require further testing"
            }
          ]
        }
      ]
    },
    {
      "label": "Electrophysiologic testing",
      "children": [
        {
          "label": "to evaluate central or peripheral vision loss in absence of obvious fundus abnormality"
        },
        {
          "label": "Visual evoked potential (VEP)",
          "children": [
            {
              "label": "measures electrical signals at the scalp overlying the occipital cortex in response to a visual stimulus"
            },
            {
              "label": "light stimulus",
              "children": [
                {
                  "label": "checkerboard target",
                  "children": [
                    {
                      "label": "pattern reverses every half second"
                    },
                    {
                      "label": "pattern size may also be varied",
                      "children": [
                        {
                          "label": "more quantifiable and reliable",
                          "children": [
                            {
                              "label": "smaller pattern sizes allow detection of smaller changes in function"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "for patients with poor vision who cannot easily see a pattern stimulus"
                    }
                  ]
                },
                {
                  "label": "flash stimulus"
                }
              ]
            },
            {
              "label": "VEP waveform",
              "children": [
                {
                  "label": "initial negative peak (N1)"
                },
                {
                  "label": "positive peak (P1, also known as P100)"
                },
                {
                  "label": "second negative (N2) peak"
                }
              ]
            },
            {
              "label": "clinical findings",
              "children": [
                {
                  "label": "damage anywhere along the afferent visual pathway can cause waveform abnormalities"
                },
                {
                  "label": "P100 latency and, to a lesser degree, the amplitude are the most useful features",
                  "children": [
                    {
                      "label": "peak latencies are relatively consistent"
                    }
                  ]
                },
                {
                  "label": "demyelination of the optic nerve",
                  "children": [
                    {
                      "label": "increased latency of the P100 waveform",
                      "children": [
                        {
                          "label": "amplitude data are less consistent"
                        }
                      ]
                    },
                    {
                      "label": "no significant effect on amplitude"
                    }
                  ]
                },
                {
                  "label": "decreased amplitude, with less effect on latency",
                  "children": [
                    {
                      "label": "ischemic damage"
                    },
                    {
                      "label": "compressive damage"
                    }
                  ]
                },
                {
                  "label": "unilateral abnormalities may reflect optic neuropathy",
                  "children": [
                    {
                      "label": "clinically useful in 2 situations",
                      "children": [
                        {
                          "label": "inarticulate patient",
                          "children": [
                            {
                              "label": "toxic damage"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "patient with suspected nonorganic disease"
                    }
                  ]
                },
                {
                  "label": "a normal response confirms intact visual pathways",
                  "children": [
                    {
                      "label": "isolated peripheral vision loss may yield normal VEP!",
                      "children": [
                        {
                          "label": "central visual field predominates in the occipital cortex!"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "an abnormal pattern response may indicate",
                  "children": [
                    {
                      "label": "damage to afferent visual pathway"
                    },
                    {
                      "label": "a false-negative result",
                      "children": [
                        {
                          "label": "abnormal waveforms despite normal visual pathways",
                          "children": [
                            {
                              "label": "uncorrected refractive error"
                            },
                            {
                              "label": "media opacities"
                            },
                            {
                              "label": "amblyopia"
                            },
                            {
                              "label": "fatigue"
                            },
                            {
                              "label": "inattention (intentional or unintentional)"
                            },
                            {
                              "label": "VEP has limited clinical usefulness"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "a consistently abnormal flash response reflects gross impairment"
                }
              ]
            },
            {
              "label": "multifocal VEP (mfVEP)",
              "children": [
                {
                  "label": "to detect small abnormalities in optic nerve transmission"
                },
                {
                  "label": "to provide topographic correlation along the visual pathway"
                }
              ]
            }
          ]
        },
        {
          "label": "Electroretinogram (ERG)",
          "children": [
            {
              "label": "measures electrical activity of the retina in response to various light stimuli by electrodes embedded in a corneal contact lens",
              "children": [
                {
                  "label": "under different states of light adaptation"
                },
                {
                  "label": "positive wave"
                }
              ]
            },
            {
              "label": "full-field ERG",
              "children": [
                {
                  "label": "stimulating the entire retina with a light source",
                  "children": [
                    {
                      "label": "negative wave"
                    }
                  ]
                },
                {
                  "label": "electrical waveform",
                  "children": [
                    {
                      "label": "a-wave",
                      "children": [
                        {
                          "label": "photoreceptor layer",
                          "children": [
                            {
                              "label": "rod and cone responses can be separated by varying the stimuli and the state of retinal adaptation"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "b-wave",
                      "children": [
                        {
                          "label": "inner retina (probably Müller and ON-bipolar cells)"
                        }
                      ]
                    },
                    {
                      "label": "c-wave",
                      "children": [
                        {
                          "label": "RPE and photoreceptors"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "useful in detecting diffuse retinal disease in cases of generalized or peripheral vision loss",
                  "children": [
                    {
                      "label": "retinitis pigmentosa"
                    },
                    {
                      "label": "cone–rod dystrophy"
                    },
                    {
                      "label": "toxic retinopathies"
                    },
                    {
                      "label": "retinal paraneoplastic syndromes"
                    },
                    {
                      "label": "ERG is severely depressed by the time substantial vision loss has occurred"
                    }
                  ]
                },
                {
                  "label": "measures only a mass response of the entire retina",
                  "children": [
                    {
                      "label": "minor/localized retinal disease, particularly maculopathy, may not produce an abnormal response",
                      "children": [
                        {
                          "label": "even with severe visual acuity loss!"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "pattern ERG (PERG)",
              "children": [
                {
                  "label": "N95 component of the waveform",
                  "children": [
                    {
                      "label": "Ganglion cell activity"
                    },
                    {
                      "label": "may detect subtle optic neuropathies",
                      "children": [
                        {
                          "label": "relatively normal in demyelination",
                          "children": [
                            {
                              "label": "if not atrophic!"
                            }
                          ]
                        },
                        {
                          "label": "abnormal in ischemia"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "multifocal ERG",
              "children": [
                {
                  "label": "ERG signals from up to 250 focal retinal locations within the central 30°"
                },
                {
                  "label": "can detect occult focal retinal abnormalities in the macula (or more peripherally)",
                  "children": [
                    {
                      "label": "distinguishes between optic nerve and macular disease",
                      "children": [
                        {
                          "label": "signal generally remains normal in optic nerve disease"
                        }
                      ]
                    },
                    {
                      "label": "may detect focal retinal dysfunction too small to be measured by full-field technique"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Fluorescein angiography",
      "children": [
        {
          "label": "to differentiate macular from optic nerve– related vision loss",
          "children": [
            {
              "label": "macular disorders with subtle clinical signs",
              "children": [
                {
                  "label": "retinal capillary dropout"
                },
                {
                  "label": "mild cystoid macular edema"
                },
                {
                  "label": "minor collections of submacular fluid (eg, central serous retinopathy)"
                },
                {
                  "label": "toxic maculopathies (eg, chloroquine)"
                },
                {
                  "label": "early cone dystrophies"
                },
                {
                  "label": "may become more evident on angiography"
                }
              ]
            }
          ]
        },
        {
          "label": "angiographic leakage can differentiate truly swollen optic nerve from pseudoedema of the disc",
          "children": [
            {
              "label": "pseudoedema is characteristic of Leber hereditary optic neuropathy"
            }
          ]
        },
        {
          "label": "may demonstrate delayed or absent choroidal filling",
          "children": [
            {
              "label": "choroidal ischemia may strongly suggest giant cell arteritis"
            }
          ]
        },
        {
          "label": "indocyanine green (ICG) angiography",
          "children": [
            {
              "label": "may better assess choroidal blood flow and deep inflammatory lesions"
            }
          ]
        }
      ]
    },
    {
      "label": "Optical coherence tomography",
      "children": [
        {
          "label": "near-infrared light"
        },
        {
          "label": "2- and 3-dimensional tomographic images"
        },
        {
          "label": "peripapillary RNFL thickness can be measured",
          "children": [
            {
              "label": "compared with measurements in an age- matched, normative database"
            },
            {
              "label": "RNFL thickness can be monitored over time to quantify axonal loss"
            }
          ]
        },
        {
          "label": "abnormally thick RNFL",
          "children": [
            {
              "label": "true optic disc edema",
              "children": [
                {
                  "label": "repeat OCT measurements may reveal an increase in RNFL thickening over time"
                }
              ]
            },
            {
              "label": "pseudoedema of the disc"
            }
          ]
        }
      ]
    }
  ],
