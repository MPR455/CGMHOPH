{
  "label": "7.4.5. Non-infectious Orbital Inflammations (II)",
  "root": true,
  "children": [
    {
      "label": "Polyarteritis nodosa",
      "children": [
        {
          "label": "necrotizing vasculitis",
          "children": [
            {
              "label": "small- & medium-sized arteries",
              "children": [
                {
                  "label": "necrosis of the muscularis layer"
                },
                {
                  "label": "neutrophils"
                },
                {
                  "label": "eosinophils"
                }
              ]
            }
          ]
        },
        {
          "label": "may affect orbital vessels but does not usually cause orbital disease"
        },
        {
          "label": "ophthalmic manifestations",
          "children": [
            {
              "label": "retinal and choroidal infarction"
            }
          ]
        }
      ]
    },
    {
      "label": "Giant cell arteritis (GCA)",
      "children": [
        {
          "label": "affects the aorta and branches of the external and internal carotid arteries and vertebral arteries",
          "children": [
            {
              "label": "orbital vessels are inflamed in GCA",
              "children": [
                {
                  "label": "generalized orbital ischemia is rare"
                }
              ]
            },
            {
              "label": "usually spares the intracranial carotid branches",
              "children": [
                {
                  "label": "lack an elastic lamina"
                }
              ]
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "vision loss",
              "children": [
                {
                  "label": "central retinal artery occlusion"
                },
                {
                  "label": "ischemic optic neuropathy"
                }
              ]
            },
            {
              "label": "diplopia",
              "children": [
                {
                  "label": "ischemic dysfunction of cranial motor nerves"
                }
              ]
            },
            {
              "label": "headache"
            },
            {
              "label": "scalp tenderness"
            },
            {
              "label": "jaw claudication"
            },
            {
              "label": "malaise"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "elevated ESR",
              "children": [
                {
                  "label": "90%"
                }
              ]
            },
            {
              "label": "elevated CRP"
            },
            {
              "label": "elevated platelet count"
            },
            {
              "label": "temporal artery biopsy",
              "children": [
                {
                  "label": "provides a definitive diagnosis"
                },
                {
                  "label": "bilateral biopsies are sometimes necessary"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "ophthalmic emergency",
              "children": [
                {
                  "label": "timely treatment with corticosteroids usually prevents an attack in the second eye"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "IgG4 DISEASE",
      "children": [
        {
          "label": "multiorgan disease with mass-forming lesions"
        },
        {
          "label": "infiltration of IgG4-expressing plasma cells with inflammatory T lymphocytes in various organs",
          "children": [
            {
              "label": "dacryoadenitis"
            },
            {
              "label": "xanthogranuloma"
            },
            {
              "label": "orbital amyloidosis"
            },
            {
              "label": "nonspecific orbital inflammation"
            }
          ]
        },
        {
          "label": "elevation in the levels of serum IgG4 and an acute-phase response"
        },
        {
          "label": "responds well to treatment with steroids"
        }
      ]
    },
    {
      "label": "Sarcoidosis",
      "children": [
        {
          "label": "African or Scandinavian descent"
        },
        {
          "label": "multisystem disease",
          "children": [
            {
              "label": "lungs are most commonly involved"
            }
          ]
        },
        {
          "label": "orbit",
          "children": [
            {
              "label": "lacrimal gland is most frequently affected",
              "children": [
                {
                  "label": "bilateral"
                }
              ]
            },
            {
              "label": "extraocular muscles and optic nerve",
              "children": [
                {
                  "label": "very rare"
                }
              ]
            },
            {
              "label": "sinus involvement with associated lytic bone lesions can invade the adjacent orbit"
            },
            {
              "label": "orbital sarcoidosis",
              "children": [
                {
                  "label": "Isolated orbital involvement",
                  "children": [
                    {
                      "label": "without associated systemic disease!"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "noncaseating collections of epithelioid histiocytes in a granulomatous pattern"
            },
            {
              "label": "mononuclear inflammation at the periphery of the granuloma"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "Gallium scanning of the lacrimal glands",
              "children": [
                {
                  "label": "nonspecific"
                },
                {
                  "label": "positive in 80% of patients with systemic sarcoidosis",
                  "children": [
                    {
                      "label": "7% have clinically detectable enlargement of the lacrimal glands"
                    }
                  ]
                }
              ]
            },
            {
              "label": "biopsy",
              "children": [
                {
                  "label": "lacrimal gland"
                },
                {
                  "label": "suspicious conjunctival lesion",
                  "children": [
                    {
                      "label": "random conjunctival biopsies have a low yield"
                    }
                  ]
                }
              ]
            },
            {
              "label": "chest radiography or CT",
              "children": [
                {
                  "label": "hilar adenopathy"
                },
                {
                  "label": "pulmonary infiltrates"
                }
              ]
            },
            {
              "label": "angiotensin-converting enzyme"
            },
            {
              "label": "serum lysozyme"
            },
            {
              "label": "serum calcium"
            },
            {
              "label": "bronchoscopy with washings and biopsy"
            }
          ]
        },
        {
          "label": "acute sarcoidosis",
          "children": [
            {
              "label": "<2 years duration"
            },
            {
              "label": "frequently with associated anterior uveitis in young patients"
            },
            {
              "label": "Löfgren syndrome",
              "children": [
                {
                  "label": "acute iritis"
                },
                {
                  "label": "bilateral hilar adenopathy"
                },
                {
                  "label": "febrile arthropathy"
                },
                {
                  "label": "erythema nodosum"
                },
                {
                  "label": "responsive to systemic corticosteroids"
                },
                {
                  "label": "good long-term prognosis"
                }
              ]
            },
            {
              "label": "Heerfordt syndrome (uveoparotid fever)",
              "children": [
                {
                  "label": "uveitis"
                },
                {
                  "label": "parotitis",
                  "children": [
                    {
                      "label": "facial nerve palsy"
                    }
                  ]
                },
                {
                  "label": "fever"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Granulomatosis with polyangiitis (GPA)",
      "children": [
        {
          "label": "Wegener granulomatosis"
        },
        {
          "label": "necrotizing granulomatous small-vessel vasculitis",
          "children": [
            {
              "label": "± giant cells"
            }
          ]
        },
        {
          "label": "features",
          "children": [
            {
              "label": "lesions of the upper respiratory tract",
              "children": [
                {
                  "label": "sinus mucosal involvement with bone erosion"
                }
              ]
            },
            {
              "label": "lesions of the lower respiratory tract",
              "children": [
                {
                  "label": "tracheobronchial necrotic lesions"
                },
                {
                  "label": "cavitary lung lesions"
                }
              ]
            },
            {
              "label": "necrotizing glomerulonephritis"
            }
          ]
        },
        {
          "label": "ocular disease",
          "children": [
            {
              "label": "orbit and nasolacrimal drainage system involvement by extension from the surrounding sinuses"
            },
            {
              "label": "isolated orbital involvement",
              "children": [
                {
                  "label": "unilateral or bilateral"
                },
                {
                  "label": "may lack frank necrotizing vasculitis",
                  "children": [
                    {
                      "label": "in the absence of respiratory tract and renal findings, may be difficult to diagnose"
                    }
                  ]
                }
              ]
            },
            {
              "label": "scleritis"
            }
          ]
        },
        {
          "label": "limited forms of the disease",
          "children": [
            {
              "label": "absent renal component"
            },
            {
              "label": "isolated orbital involvement"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "serum immunofluorescence",
              "children": [
                {
                  "label": "antineutrophil cytoplasmic antibody (ANCA)",
                  "children": [
                    {
                      "label": "C-ANCA",
                      "children": [
                        {
                          "label": "autoantibodies directed against proteinase-3"
                        },
                        {
                          "label": "diffuse granular fluorescence within the cytoplasm"
                        },
                        {
                          "label": "highly specific for GPA"
                        },
                        {
                          "label": "may be negative early in the course of the disease",
                          "children": [
                            {
                              "label": "especially in the absence of multisystem involvement"
                            }
                          ]
                        },
                        {
                          "label": "can also be detected by ELISA"
                        }
                      ]
                    },
                    {
                      "label": "P-ANCA",
                      "children": [
                        {
                          "label": "fluorescence surrounding the nucleus"
                        },
                        {
                          "label": "an artifact of ethanol fixation",
                          "children": [
                            {
                              "label": "can be caused by autoantibodies against many different target antigens",
                              "children": [
                                {
                                  "label": "nonspecific"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "needs to be confirmed by ELISA for ANCA reacting with myeloperoxidase (MPO-ANCA)",
                          "children": [
                            {
                              "label": "MPO-ANCA testing has a high specificity for small-vessel vasculitis"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "absolute levels of ANCA do not define disease severity or activity",
                      "children": [
                        {
                          "label": "changing titers can give a general idea of disease activity"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "immunosuppression",
              "children": [
                {
                  "label": "cyclophosphamide"
                },
                {
                  "label": "treatment with corticosteroids alone is associated with a significantly higher rate of mortality"
                }
              ]
            },
            {
              "label": "long-term treatment with TMP-SMX appears to suppress disease activity in some patients"
            },
            {
              "label": "may have a fulminant, life-threatening course"
            }
          ]
        }
      ]
    }
