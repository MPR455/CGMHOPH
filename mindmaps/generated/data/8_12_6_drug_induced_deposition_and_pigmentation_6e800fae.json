{
  "label": "8.12.6. Drug-Induced Deposition and Pigmentation",
  "root": true,
  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "most drug-induced deposition is not symptomatic",
          "children": [
            {
              "label": "does not require cessation of the medication"
            }
          ]
        },
        {
          "label": "+- decreased vision, photosensitivity, or ocular irritation"
        },
        {
          "label": "See Table 12-4"
        }
      ]
    },
    {
      "label": "Stromal and Descemet Membrane Pigmentation",
      "children": [
        {
          "label": "also causes corneal verticillata"
        },
        {
          "label": "chlorpromazine",
          "children": [
            {
              "label": "phenothiazine family"
            },
            {
              "label": "1/3 of patients on long-term therapy"
            },
            {
              "label": "through the aqueous"
            },
            {
              "label": "brown opacities",
              "children": [
                {
                  "label": "first in the posterior stroma, descemet membrane, and endothelium",
                  "children": [
                    {
                      "label": "spreads to the anterior stroma and epithelium"
                    }
                  ]
                },
                {
                  "label": "can also deposit on the anterior lens capsule"
                }
              ]
            }
          ]
        },
        {
          "label": "clofazimine",
          "children": [
            {
              "label": "anterior stromal opacities or crystalline deposition"
            }
          ]
        },
        {
          "label": "isotretinoin",
          "children": [
            {
              "label": "fine, diffuse gray deposits in the central and peripheral cornea"
            }
          ]
        },
        {
          "label": "silver compounds (argyriasis)",
          "children": [
            {
              "label": "after inadvertent excessive application of silver nitrate for the treatment of superior limbic keratoconjunctivitis"
            },
            {
              "label": "slate-gray or silver discoloration of the bulbar and palpebral conjunctiva"
            }
          ]
        },
        {
          "label": "gold salts",
          "children": [
            {
              "label": "dosages >1 g",
              "children": [
                {
                  "label": "high % of patients",
                  "children": [
                    {
                      "label": "can be permanent"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "See Table 12-3",
          "children": [
            {
              "label": "posterior stromal deposits that spare descemet membrane and endothelium"
            }
          ]
        }
      ]
    },
    {
      "label": "Corneal Epithelial Deposits",
      "children": [
        {
          "label": "cornea verticillata",
          "children": [
            {
              "label": "whorl-like pattern of golden brown or gray deposits"
            },
            {
              "label": "inferior interpalpebral portion of the cornea"
            },
            {
              "label": "medications bind with the cellular lipids of the basal epithelial layer"
            },
            {
              "label": "rarerly result in reduction of vision or ocular symptoms",
              "children": [
                {
                  "label": "reduced vision with",
                  "children": [
                    {
                      "label": "amiodarone or tamoxifen",
                      "children": [
                        {
                          "label": "r/o optic neuropathy"
                        }
                      ]
                    },
                    {
                      "label": "chloroquine family or tilorone hydrochloride",
                      "children": [
                        {
                          "label": "r/o retinal toxicity"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "resolve with discontinuation of the responsible agents"
            },
            {
              "label": "medications",
              "children": [
                {
                  "label": "amiodarone",
                  "children": [
                    {
                      "label": "most common cause of cornea verticillata"
                    }
                  ]
                },
                {
                  "label": "chloroquine, hydroxychloroquine"
                },
                {
                  "label": "indomethacin"
                },
                {
                  "label": "PICA"
                }
              ]
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "phenothiazines"
                },
                {
                  "label": "Fabry disease"
                }
              ]
            }
          ]
        },
        {
          "label": "epithelial cysts",
          "children": [
            {
              "label": "drugs that inhibit DNA synthesis",
              "children": [
                {
                  "label": "cytarabine",
                  "children": [
                    {
                      "label": "punctate keratopathy"
                    },
                    {
                      "label": "refractile epithelial microcysts"
                    },
                    {
                      "label": "pain, photophobia, foreign-body sensation, and reduced vision"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "ciprofloxacin deposits",
