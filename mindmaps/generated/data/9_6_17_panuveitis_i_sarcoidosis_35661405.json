    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "sarcoidosis should be considered in the differential diagnosis of any intraocular inflammation"
        },
        {
          "label": "early-onset sarcoidosis (≤5 years) must be differentiated from",
          "children": [
            {
              "label": "JIA-associated anterior uveitis"
            },
            {
              "label": "familial juvenile systemic granulomatosis (Blau syndrome)",
              "children": [
                {
                  "label": "autosomal dominant"
                },
                {
                  "label": "NOD2 gene (also known as CARD15)"
                },
                {
                  "label": "ocular disease is virtually identical to sarcoidosis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "vision-threatening posterior segment lesions",
          "children": [
            {
              "label": "topical, periocular, and systemic corticosteroids are the mainstays of therapy"
            },
            {
              "label": "systemic corticosteroids (prednisone, 40–80 mg/day)"
            }
          ]
        },
        {
          "label": "cycloplegia"
        },
        {
          "label": "intravitreal corticosteroids",
          "children": [
            {
              "label": "for patients intolerant of systemic therapy"
            }
          ]
        },
        {
          "label": "fluocinolone acetonide implant"
        },
        {
          "label": "systemic IMT",
          "children": [
            {
              "label": "can provide good control of the disease",
              "children": [
                {
                  "label": "chronic vision-threatening sarcoidosis responds better to IMT",
                  "children": [
                    {
                      "label": "likelihood of significant visual improvement is substantially increased with systemic therapy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "TNF-α inhibitors",
