{
  "label": "5.10.5. Pupillary Abnormalities (V): Light–Near Dissociation",
  "root": true,
  "children": [
    {
      "label": "Definition",
      "children": [
        {
          "label": "near response exceeds the best pupillary constriction that bright light can produce"
        }
      ]
    },
    {
      "label": "See Table 10-1",
      "children": [
        {
          "label": "Anterior visual pathway damage (retina, optic nerve, chiasm)"
        },
        {
          "label": "Short posterior ciliary nerve damage",
          "children": [
            {
              "label": "panretinal photocoagulation"
            },
            {
              "label": "retinal cryotherapy"
            },
            {
              "label": "orbital surgery"
            },
            {
              "label": "peripheral neuropathy"
            }
          ]
        },
        {
          "label": "Aberrant reinnervation",
          "children": [
            {
              "label": "Adie syndrome"
            },
            {
              "label": "3rd cranial nerve reinnervation"
            }
          ]
        }
      ]
    },
    {
      "label": "Afferent Visual Pathway",
      "children": [
        {
          "label": "bilateral"
        },
        {
          "label": "optic neuropathy is the most common cause of light–near dissociation"
        },
        {
          "label": "damage to only the afferent limb of the pupillary light reflex (optic nerve)"
        }
      ]
    },
    {
      "label": "dorsal midbrain damage"
    },
    {
      "label": "Aberrant Regeneration",
      "children": [
        {
          "label": "light–near dissociation can result from aberrant regeneration of damaged nerves that restores the near reflex but not the light reflex"
        },
        {
          "label": "tonic pupil syndrome",
          "children": [
            {
              "label": "injured short ciliary nerves resprout and accommodative fibers mistakenly reinnervate the iris sphincter",
              "children": [
                {
                  "label": "resembles light–near dissociation!"
                }
              ]
            }
          ]
        },
        {
          "label": "misdirected growth after traumatic injury or chronic compression of the oculomotor nerve",
          "children": [
            {
              "label": "aberrant regeneration of the medial rectus fibers",
              "children": [
                {
                  "label": "pupillary contraction occurs during attempted adduction"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Midbrain",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "the lesion spares the more ventrally located fibers of the near reflex pathway"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "midsize pupils",
              "children": [
                {
                  "label": "poor light response"
                },
                {
                  "label": "preserved near response"
                }
              ]
            },
            {
              "label": "associated findings",
              "children": [
                {
                  "label": "bilateral eyelid retraction (Collier sign)"
                },
                {
                  "label": "vertical gaze palsy"
                },
                {
                  "label": "accommodative paresis"
                },
                {
                  "label": "convergence-retraction nystagmus (Parinaud syndrome)"
                }
              ]
            }
          ]
        },
        {
          "label": "Argyll Robertson pupil",
          "children": [
            {
              "label": "tertiary syphilis involving the central nervous system"
            },
            {
              "label": "small pupils (<2 mm)",
              "children": [
                {
                  "label": "often irregular"
                },
                {
                  "label": "do not react to light",
                  "children": [
                    {
                      "label": "this feature distinguishes Argyll Robertson pupils from bilateral chronic tonic pupils"
                    }
                  ]
                },
                {
                  "label": "near response and subsequent redilation are normal and brisk"
                },
                {
                  "label": "dilation is poor after instillation of mydriatic eyedrops"
                }
              ]
            },
            {
              "label": "iris atrophy",
              "children": [
                {
                  "label": "portions of the iris transilluminate"
                }
              ]
            },
