{
  "label": "7.5.4. Orbital Neoplasms and Malformations (IV): Neural Tumors (II): Optic Nerve Glioma",
  "root": true,
  "children": [
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "uncommon"
        },
        {
          "label": "children in the first decade of life"
        },
        {
          "label": "≤ 1/2 of optic nerve gliomas are associated with neurofibromatosis"
        }
      ]
    },
    {
      "label": "clinical feature",
      "children": [
        {
          "label": "vision loss"
        },
        {
          "label": "afferent pupillary defect"
        },
        {
          "label": "gradual, painless, unilateral axial proptosis"
        },
        {
          "label": "optic atrophy"
        },
        {
          "label": "optic disc swelling"
        },
        {
          "label": "nystagmus"
        },
        {
          "label": "strabismus"
        },
        {
          "label": "chiasm is involved in ≈ 1/2"
        },
        {
          "label": "intracranial involvement may be associated with",
          "children": [
            {
              "label": "intracranial hypertension"
            },
            {
              "label": "decreased function of the hypothalamus and pituitary gland"
            }
          ]
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "controversial",
          "children": [
            {
              "label": "any treatment plan must be carefully individualized",
              "children": [
                {
                  "label": "tumor’s growth characteristics"
                },
                {
                  "label": "extent of optic nerve and chiasmal involvement"
                },
                {
                  "label": "vision of the involved and uninvolved eye"
                },
                {
                  "label": "presence or absence of concomitant neurologic or systemic disease"
                },
                {
                  "label": "history of previous treatment"
                }
              ]
            }
          ]
        },
        {
          "label": "observation",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "characteristic radiographic features"
                },
                {
                  "label": "good vision"
                },
                {
                  "label": "tumor confined to the orbit"
                }
              ]
            },
            {
              "label": "examinations and appropriate radiographic studies must be performed at regular intervals",
              "children": [
                {
                  "label": "preferably MRI"
                }
              ]
            },
            {
              "label": "many patients maintain good vision and never require surgery"
            }
          ]
        },
        {
          "label": "surgical excision",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "tumor involves the prechiasmal intracranial portion of the optic nerve",
                  "children": [
                    {
                      "label": "to isolate the tumor from the optic chiasm"
                    }
                  ]
                },
                {
                  "label": "rapid intraorbital tumor growth"
                },
                {
                  "label": "proptosis with corneal exposure"
                },
                {
                  "label": "unacceptable cosmetic appearance"
                }
              ]
            },
            {
              "label": "transcranial approach to obtain tumor-free surgical margins",
              "children": [
                {
                  "label": "complete excision is possible if the tumor ends 2–3 mm anterior to the chiasm"
                }
              ]
            }
          ]
        },
        {
          "label": "chemotherapy",
          "children": [
            {
              "label": "combination chemotherapy",
              "children": [
                {
                  "label": "actinomycin D"
                },
                {
                  "label": "vincristine"
                },
                {
                  "label": "etoposide"
                }
              ]
            },
            {
              "label": "indication",
              "children": [
                {
                  "label": "progressive chiasmal-hypothalamic gliomas",
                  "children": [
                    {
                      "label": "may delay the need for radiation therapy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "long-term risks of blood-borne cancers"
            }
          ]
        },
        {
          "label": "radiation therapy",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "if the tumor cannot be resected (usually chiasmal or optic tract lesions)"
                },
                {
                  "label": "if symptoms (particularly neurologic) progress after chemotherapy"
                },
                {
                  "label": "postoperative radiation of the chiasm and optic tract",
                  "children": [
                    {
                      "label": "if subsequent growth of the tumor within the chiasm"
                    },
                    {
                      "label": "if chiasmal and optic tract involvement is extensive"
                    }
                  ]
                }
              ]
            },
            {
              "label": "adverse effects",
              "children": [
                {
                  "label": "intellectual disability"
                },
                {
                  "label": "growth retardation"
                },
                {
                  "label": "secondary tumors within the radiation field"
                }
              ]
            },
            {
              "label": "generally held as a last resort for children who have not completed growth and development"
            }
          ]
        }
      ]
    },
    {
      "label": "pathology",
      "children": [
        {
          "label": "smooth, fusiform intradural lesion",
          "children": [
            {
              "label": "optic gliomas arising in patients with neurofibromatosis often proliferate in the subarachnoid space"
            },
            {
              "label": "optic gliomas in patients without neurofibromatosis usually expand within the optic nerve substance without invading the dura mater"
            }
          ]
        },
        {
          "label": "juvenile pilocytic (hairlike) astrocytomas",
          "children": [
            {
              "label": "benign"
            }
          ]
        },
        {
          "label": "arachnoid hyperplasia"
        },
        {
          "label": "mucosubstance"
        },
        {
          "label": "Rosenthal fibers"
        }
      ]
    },
    {
      "label": "orbital imaging",
      "children": [
        {
          "label": "fusiform enlargement of the optic nerve"
        },
        {
          "label": "stereotypical kinking of the nerve"
        },
        {
          "label": "MRI",
          "children": [
            {
              "label": "cystic degeneration"
            },
            {
              "label": "more accurate in defining the extent of an optic canal lesion and intracranial disease"
            }
          ]
        },
        {
          "label": "neuroimaging is frequently diagnostic",
          "children": [
            {
              "label": "usually unnecessary to perform a biopsy",
              "children": [
                {
                  "label": "biopsy tissue from too peripheral a portion of the optic nerve may capture reactive meningeal hyperplasia",
                  "children": [
                    {
                      "label": "misdiagnosis of fibrous meningioma"
                    }
                  ]
                },
                {
                  "label": "biopsy of the optic nerve may produce additional loss of visual field or vision"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "malignant optic nerve gliomas (glioblastomas)",
      "children": [
        {
          "label": "very rare"
        },
        {
          "label": "adult males"
        },
        {
          "label": "severe retro-orbital pain"
        },
        {
          "label": "unilateral or bilateral vision loss"
        },
        {
          "label": "massive swelling and hemorrhage of the optic nerve head"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "high-dose radiotherapy and chemotherapy"
            }
          ]
        },
        {
          "label": "usually result in death within 6–12 months"
        }
      ]
    },
    {
      "label": "natural course",
      "children": [
        {
          "label": "most cases remain stable or progress very slowly"
        },
        {
          "label": "occasional case behaves aggressively"
        },
        {
          "label": "rare reports of spontaneous regression of optic nerve/visual pathway gliomas"
        },
        {
          "label": "cystic enlargement associated with sudden vision loss can occur without true cellular growth"
        }
      ]
    }
