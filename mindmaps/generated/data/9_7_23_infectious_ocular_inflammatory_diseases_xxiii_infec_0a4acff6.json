          "label": "culture",
          "children": [
            {
              "label": "base and edges"
            }
          ]
        },
        {
          "label": "lamellar scleral biopsy",
          "children": [
            {
              "label": "if the condition worsens on anti-inflammatory therapy alone"
            }
          ]
        },
        {
          "label": "diagnostic evaluation for noninfectious necrotizing scleritis"
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "debridement of infected tissues"
        },
        {
          "label": "antibiotics",
          "children": [
            {
              "label": "topically (including by drop or continuous lavage)"
            },
            {
              "label": "subconjunctivally"
            },
            {
              "label": "systemically"
            }
          ]
        },
        {
          "label": "corticosteroids"
        },
        {
          "label": "scleral patch grafting",
          "children": [
            {
              "label": "avoided initially"
            },
            {
              "label": "if there is severe thinning"
            }
          ]
        }
      ]
    },
    {
      "label": "predisposing conditions",
      "children": [
        {
          "label": "previous ocular surgery",
          "children": [
            {
              "label": "pterygium surgery",
              "children": [
                {
                  "label": "especially when beta irradiation or mitomycin C is utilized"
                }
              ]
            },
            {
              "label": "scleral buckling"
            },
            {
              "label": "cataract surgery"
            },
            {
              "label": "pars plana vitrectomy"
            },
            {
              "label": "precipitating surgery may be recent or remote"
            }
          ]
        },
        {
          "label": "penetrating injury contaminated by soil or vegetable matter"
        }
      ]
    },
    {
      "label": "prognosis",
      "children": [
        {
          "label": "difficult to treat",
          "children": [
            {
              "label": "inadequate excision of infected tissues can result in disease recurrence"
            },
            {
              "label": "long-term treatment may be necessary"
            }
          ]
        },
        {
          "label": "complications are common",
          "children": [
            {
              "label": "+- globe perforation with surgery"
            },
            {
              "label": "extension of the infection to the cornea"
            },
            {
              "label": "endophthalmitis",
              "children": [
                {
                  "label": "marginal corneal infiltrates"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "symptoms",
          "children": [
