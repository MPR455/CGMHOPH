{
  "label": "8.10.3. Corneal Dystrophies (III): TGFBI Stromal Corneal Dystrophies",
  "root": true,
  "children": [
    {
      "label": "Stromal Corneal Dystrophies (TGFBI Dystrophies)",
      "children": [
        {
          "label": "See Table 10-4"
        }
      ]
    },
    {
      "label": "similar to Reis-Buckler & Thiel-Behnke"
    },
    {
      "label": "also subepithelial",
      "children": [
        {
          "label": "poor epithelial–stromal adhesion"
        }
      ]
    },
    {
      "label": "Granular corneal dystrophy type 2 (granular-lattice) (GCD2)",
      "children": [
        {
          "label": "\"Avellino corneal dystrophy\""
        },
        {
          "label": "autosomal dominant",
          "children": [
            {
              "label": "5q31",
              "children": [
                {
                  "label": "TGFBI gene"
                }
              ]
            }
          ]
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "hyaline deposits",
              "children": [
                {
                  "label": "Masson trichrome stain"
                }
              ]
            },
            {
              "label": "amyloid deposits",
              "children": [
                {
                  "label": "Congo red stain"
                }
              ]
            },
            {
              "label": "deposits extend from basal epithelium to deep stroma"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "lattice lesions in addition to granular lesions"
            },
            {
              "label": "clinical findings differ from those of GCD1",
              "children": [
                {
                  "label": "stellate-shaped, snowflake-like, and icicle-like opacities appear between the superficial stroma and midstroma"
                }
              ]
            },
            {
              "label": "lattice lines are also seen deeper than the snowflake opacities"
            },
            {
              "label": "mild corneal erosions",
              "children": [
                {
                  "label": "older patients have anterior stromal haze between deposits, which reduces vision"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "LK or PK"
            },
            {
              "label": "PTK",
              "children": [
                {
                  "label": "may result in increased opacification and is not recommended"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Lattice corneal dystrophy (LCD)",
      "children": [
        {
          "label": "classic lattice corneal dystrophy (LCD1)",
          "children": [
            {
              "label": "genetics",
              "children": [
                {
                  "label": "autosomal dominant",
                  "children": [
                    {
                      "label": "5q31",
                      "children": [
                        {
                          "label": "gene TGFBI"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "pathology",
              "children": [
                {
                  "label": "amyloid deposits",
                  "children": [
                    {
                      "label": "light microscopy",
                      "children": [
                        {
                          "label": "staining",
                          "children": [
                            {
                              "label": "Congo red dye",
                              "children": [
                                {
                                  "label": "rose to orange-red",
                                  "children": [
                                    {
                                      "label": "polarized light microscopy",
                                      "children": [
                                        {
                                          "label": "birefringence",
                                          "children": [
                                            {
                                              "label": "apple green"
                                            }
                                          ]
                                        },
                                        {
                                          "label": "dichroism",
                                          "children": [
                                            {
                                              "label": "green to orange"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "label": "crystal violet dye",
                              "children": [
                                {
                                  "label": "metachromasia"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "most heavily in anterior stroma"
                        },
                        {
                          "label": "epithelial atrophy and disruption"
                        },
                        {
                          "label": "focal thinning or absence of the Bowman layer"
                        },
                        {
                          "label": "eosinophilic layer between epithelial basement membrane and Bowman layer"
                        }
                      ]
                    },
                    {
                      "label": "electron microscopy",
                      "children": [
                        {
                          "label": "extracellular masses",
                          "children": [
                            {
                              "label": "fine 8–10-μm fibrils"
                            },
                            {
                              "label": "should be differentiated from those seen in infection with fungal hyphae"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "confocal microscopy",
                  "children": [
                    {
                      "label": "characteristic linear images"
                    }
                  ]
                },
                {
                  "label": "increase progressively with age"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "relatively common",
                  "children": [
                    {
                      "label": "corneal deposits caused by monoclonal gammopathy may resemble lattice lines"
                    }
                  ]
                },
                {
                  "label": "glasslike branching lines in the stroma",
                  "children": [
                    {
                      "label": "best seen against a red reflex or with retroillumination"
                    },
                    {
                      "label": "start centrally and superficially and spread centrifugally and deeper"
                    }
                  ]
                },
                {
                  "label": "central subepithelial ovoid white dots",
                  "children": [
                    {
                      "label": "stroma can take on a ground-glass appearance",
                      "children": [
                        {
                          "label": "peripheral cornea remains clear"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "decreased vision",
                  "children": [
                    {
                      "label": "recurrent epithelial erosions"
                    },
                    {
                      "label": "stromal haze and epithelial surface irregularity"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "recurrent erosions",
                  "children": [
                    {
                      "label": "therapeutic contact lenses"
                    },
                    {
                      "label": "superficial keratectomy"
                    },
                    {
                      "label": "PTK"
                    }
                  ]
                },
                {
                  "label": "severe cases with vision loss",
                  "children": [
                    {
                      "label": "deep anterior lamellar keratoplasty (DALK)"
                    },
                    {
                      "label": "PK"
                    },
                    {
                      "label": "high recurrence rate after corneal graft",
                      "children": [
                        {
                          "label": "recurs more frequently than granular or macular dystrophy"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "gelsolin type (LCD2)",
          "children": [
            {
              "label": "\"Meretoja syndrome\""
            },
            {
              "label": "not a true corneal dystrophy"
            },
            {
              "label": "genetics",
              "children": [
                {
                  "label": "autosomal dominant",
                  "children": [
                    {
                      "label": "9q34",
                      "children": [
                        {
                          "label": "gelsolin (GSN) gene"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "pathology",
              "children": [
                {
                  "label": "light microscopy",
                  "children": [
                    {
                      "label": "amyloid in lattice lines as a discontinuous band under the Bowman layer and within the sclera"
                    },
                    {
                      "label": "mutated gelsolin",
                      "children": [
                        {
                          "label": "does not stain for type AA or AP!"
                        },
                        {
                          "label": "deposited in",
                          "children": [
                            {
                              "label": "conjunctiva"
                            },
                            {
                              "label": "ciliary body"
                            },
                            {
                              "label": "sclera"
                            },
                            {
                              "label": "along the choriocapillaris"
                            },
                            {
                              "label": "ciliary nerves and vessels"
                            },
                            {
                              "label": "optic nerve"
                            },
                            {
                              "label": "extraocularly",
                              "children": [
                                {
                                  "label": "amyloid is detected in arterial walls, peripheral nerves, and glomeruli"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "confocal microscopy"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "combines lattice corneal changes with coexisting systemic amyloidosis"
                },
                {
                  "label": "third to fourth decade of life"
                },
                {
                  "label": "ocular features",
                  "children": [
                    {
                      "label": "corneal sensation is reduced",
                      "children": [
                        {
                          "label": "lattice lines are less numerous and more peripheral than LCD1",
                          "children": [
                            {
                              "label": "spread centripetally from the limbus",
                              "children": [
                                {
                                  "label": "central cornea is relatively spared"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "± increased risk of open-angle glaucoma"
                    },
                    {
                      "label": "dermatochalasis"
                    },
                    {
                      "label": "lagophthalmos"
                    },
                    {
                      "label": "late in life",
                      "children": [
                        {
                          "label": "dry eye"
                        },
                        {
                          "label": "recurrent erosions",
                          "children": [
                            {
                              "label": "characteristic facial mask"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "extraocular features",
                  "children": [
                    {
                      "label": "pendulous ears"
                    },
                    {
                      "label": "cranial and peripheral nerve palsies"
                    },
                    {
                      "label": "dry, lax skin with amyloid deposition"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "intervening clear areas"
    },
    {
      "label": "Granular corneal dystrophy type 1 (GCD1)",
      "children": [
        {
          "label": "autosomal dominant",
          "children": [
            {
              "label": "5q31",
              "children": [
                {
                  "label": "TGFBI"
                }
              ]
            }
          ]
        },
        {
          "label": "most common stromal dystrophy"
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "hyaline deposits",
              "children": [
                {
                  "label": "Masson trichrome stain",
                  "children": [
                    {
                      "label": "bright red"
                    }
                  ]
                },
                {
                  "label": "noncollagenous protein",
                  "children": [
                    {
                      "label": "may derive from corneal epithelium and/ or keratocytes"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "onset occurs early in life",
              "children": [
                {
                  "label": "slowly progressive"
                }
              ]
            },
            {
              "label": "granular crumblike opacities in superficial cornea",
              "children": [
                {
                  "label": "white on direct illumination"
                },
                {
                  "label": "do not extend to the limbus"
                },
                {
                  "label": "can extend anteriorly through focal breaks in Bowman layer"
                }
              ]
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "glare"
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "recurrent erosions"
                },
                {
                  "label": "decreased vision",
                  "children": [
                    {
                      "label": "as opacities become more confluent",
                      "children": [
                        {
                          "label": "visual acuity rarely drops to 20/200 after age 50"
                        }
                      ]
                    },
                    {
                      "label": "most patients maintain good vision"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "no treatment",
              "children": [
                {
                  "label": "early disease"
                }
              ]
            },
            {
              "label": "recurrent erosions",
              "children": [
                {
                  "label": "therapeutic contact lenses"
                },
                {
                  "label": "superficial keratectomy"
                },
                {
                  "label": "PTK",
                  "children": [
                    {
                      "label": "may work transiently"
                    }
                  ]
                }
              ]
            },
            {
              "label": "when vision is affected",
              "children": [
                {
                  "label": "DALK"
                },
                {
                  "label": "PK"
                },
                {
                  "label": "recurrence in graft (anteriorly and peripherally) may occur after many years"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
