    {
      "label": "ETIOLOGY",
      "children": [
        {
          "label": "first-order (preganglionic) lesion",
          "children": [
            {
              "label": "medullary lesion",
              "children": [
                {
                  "label": "ataxia, nystagmus, and hemisensory deficit"
                },
                {
                  "label": "MRI of the brain and upper cervical cord"
                }
              ]
            }
          ]
        },
        {
          "label": "second-order (preganglionic) lesion",
          "children": [
            {
              "label": "superior sulcus (Pancoast syndrome) or mediastinal lesion",
              "children": [
                {
                  "label": "arm pain, cough, hemoptysis, and swelling in the neck"
                },
                {
                  "label": "cervicothoracic MRI"
                }
              ]
            },
            {
              "label": "thyroid mass"
            },
            {
              "label": "chest surgery"
            },
            {
              "label": "thoracic aortic aneurysms"
            },
            {
              "label": "trauma to the brachial plexus"
            }
          ]
        },
        {
          "label": "third-order (postganglionic) lesion",
          "children": [
            {
              "label": "numbness over the first as well as the second or third divisions of CN V"
            },
            {
              "label": "double vision from sixth nerve palsy"
            },
            {
              "label": "isolated postganglionic Horner syndrome is often benign",
              "children": [
                {
                  "label": "if examination of old photographs verifies that the Horner syndrome has been present for several years, further investigation will probably be unrewarding"
                },
                {
                  "label": "no pain"
                }
              ]
            },
            {
              "label": "painful postganglionic Horner syndrome",
              "children": [
                {
                  "label": "carotid artery dissection",
