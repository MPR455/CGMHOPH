          "label": "congenital Horner syndrome",
          "children": [
            {
              "label": "birth trauma to the brachial plexus"
            }
          ]
        },
        {
          "label": "nontraumatic Horner syndrome in infants and children",
          "children": [
            {
              "label": "neuroblastoma",
