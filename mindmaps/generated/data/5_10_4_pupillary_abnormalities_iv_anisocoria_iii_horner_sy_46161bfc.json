    {
      "label": "pharmacological confirmation",
      "children": [
        {
          "label": "cocaine (4-10%)",
          "children": [
            {
              "label": "blocks re-uptake of norepinephrine at sympathetic nerve terminals",
              "children": [
                {
                  "label": "affected eye",
                  "children": [
                    {
                      "label": "no effect",
                      "children": [
                        {
                          "label": "little or no norepinephrine is released into the synaptic cleft"
