                        }
                      ]
                    },
                    {
                      "label": "amaurosis fugax"
                    },
                    {
                      "label": "altered taste (dysgeusia)"
                    },
                    {
                      "label": "stroke is a possible complication",
                      "children": [
                        {
                          "label": "in the acute stage"
                        }
                      ]
                    },
                    {
                      "label": "MRI shows an intramural hemorrhage",
                      "children": [
                        {
                          "label": "in rare cases MRA or cerebral arteriography is needed"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "cluster headache",
                  "children": [
                    {
                      "label": "Horner syndrome often resolves",
                      "children": [
                        {
                          "label": "may become permanent after repeated attacks"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Raeder paratrigeminal syndrome",
                  "children": [
                    {
                      "label": "Horner syndrome + daily unilateral headache (neuralgia)"
                    },
                    {
                      "label": "no underlying pathology",
                      "children": [
                        {
                          "label": "middle-aged men"
                        },
                        {
                          "label": "diagnosis of exclusion!"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
