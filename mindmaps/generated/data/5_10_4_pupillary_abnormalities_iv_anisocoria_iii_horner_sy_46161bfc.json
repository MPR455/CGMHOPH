                      ]
                    }
                  ]
                },
                {
                  "label": "unaffected eye",
                  "children": [
                    {
                      "label": "eyelid retraction",
                      "children": [
                        {
                          "label": "pupillary dilation"
                        }
                      ]
                    },
                    {
                      "label": "conjunctival blanching"
                    }
                  ]
                }
              ]
            },
            {
              "label": "technique",
              "children": [
                {
                  "label": "instill 2 drops of cocaine (4% or 10%) in each eye",
                  "children": [
                    {
                      "label": "measure amount of anisocoria after 45 minutes",
                      "children": [
                        {
                          "label": "anisocoria of ≥1 mm is diagnostic of Horner syndrome on the side of the smaller pupil"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "mechanical anisocoria can cause false- positive cocaine test result",
              "children": [
                {
                  "label": "topical phenylephrine (10%)",
                  "children": [
                    {
                      "label": "mechanically restricted pupil will remain small"
                    },
                    {
                      "label": "Horner pupil will readily dilate"
                    }
                  ]
                }
              ]
            }
          ]
        },
