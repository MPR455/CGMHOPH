{
  "label": "Central Retinal Vein Occlusion",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "thrombosis of CRV at or posterior to lamina cribrosa"
            },
            {
              "label": "central retinal artery thickening --> turbulence, endothelial damage, and thrombus formation in CRV"
            }
          ]
        },
        {
          "label": "Risk factors & causes",
          "children": [
            {
              "label": ">50 years old",
              "children": [
                {
                  "label": "90%",
                  "children": [
                    {
                      "label": "patients with mild CRVO are generally younger"
                    }
                  ]
                }
              ]
            },
            {
              "label": "systemic associations (Eye Disease Case-Control Study)",
              "children": [
                {
                  "label": "systemic arterial hypertension"
                },
                {
                  "label": "open angle glaucoma"
                },
                {
                  "label": "not a risk factor for BRVO diabetes mellitus"
                },
                {
                  "label": "hyperlipidemia"
                },
                {
                  "label": "hypercoagulability",
                  "children": [
                    {
                      "label": "hyperhomocysteinemia"
                    },
                    {
                      "label": "protein S deficiency"
                    },
                    {
                      "label": "protein C deficiency"
                    }
                  ]
                }
              ]
            },
            {
              "label": "medications",
              "children": [
                {
                  "label": "oral contraceptives"
                },
                {
                  "label": "diuretics"
                }
              ]
            },
            {
              "label": "vasculitis",
              "children": [
                {
                  "label": "sarcoidosis"
                },
                {
                  "label": "SLE"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Complications",
      "children": [
        {
          "label": "iris neovascularization",
          "children": [
            {
              "label": "in ≤ 60% of eyes with ischemic CRVO"
            },
            {
              "label": "3-5 months after onset of symptoms"
            },
            {
              "label": "risk factors (CVOS)",
              "children": [
                {
                  "label": "poor visual acuity"
                },
                {
                  "label": "large areas of retinal capillary nonperfusion"
                },
                {
                  "label": "large areas of intraretinal blood"
                },
                {
                  "label": "ERG did not add to risk factors!"
                }
              ]
            },
            {
              "label": "treatment (CVOS)",
              "children": [
                {
                  "label": "scatter PRP",
                  "children": [
                    {
                      "label": "if ≥2 clock-hours of NVI on undilated gonioscopy (CVOS)"
                    },
                    {
                      "label": "in clinical practice is performed at the first sign of NVI"
                    }
                  ]
                }
              ]
            },
            {
              "label": "intravitreal anti-VEGF agents",
              "children": [
                {
                  "label": "reduce NVI in short term"
                }
              ]
            }
          ]
        },
        {
          "label": "vitreous hemorrhage",
          "children": [
            {
              "label": "can happen in absence of neovascularization"
            }
          ]
        }
      ]
    },
    {
      "label": "Differential diagnosis",
      "children": [
        {
          "label": "hypercoagulable conditions",
          "children": [
            {
              "label": "hyperhomocysteinemia"
            },
            {
              "label": "protein S deficiency"
            },
            {
              "label": "protein C deficiency"
            }
          ]
        },
        {
          "label": "hyperviscolsity retinopathy",
          "children": [
            {
              "label": "bilateral"
            },
            {
              "label": "dysproteinemia",
              "children": [
                {
                  "label": "Waldenstrom macroglobulinemia"
                },
                {
                  "label": "multiple myeloma"
                }
              ]
            },
            {
              "label": "blood dyscrasias",
              "children": [
                {
                  "label": "polycythemia vera"
                }
              ]
            },
            {
              "label": "diagnostic testing",
              "children": [
                {
                  "label": "CBC"
                },
                {
                  "label": "serum protein electrophoresis"
                },
                {
                  "label": "measurement of whole blood viscosity"
                }
              ]
            }
          ]
        },
        {
          "label": "ocular ischemic syndrome",
          "children": [
            {
              "label": "hemorrhages limited to deeper retinal layers"
            },
            {
              "label": "no vascular tortuosity"
            }
          ]
        },
        {
          "label": "vasculitis",
          "children": [
            {
              "label": "sarcoidosis"
            },
            {
              "label": "systemic lupus erythematosus"
            }
          ]
        }
      ]
    },
    {
      "label": "evaluation & management",
      "children": [
        {
          "label": "examination",
          "children": [
            {
              "label": "visual acuity"
            },
            {
              "label": "APD"
            },
            {
              "label": "IOP measurement",
              "children": [
                {
                  "label": "treat any elevation of IOP in affected or fellow eye"
                }
              ]
            },
            {
              "label": "gonioscopy",
              "children": [
                {
                  "label": "CRVO can lead to transient shallowing of AC"
                },
                {
                  "label": "check regularly for NVI"
                }
              ]
            },
            {
              "label": "monitor every month x 6 months"
            }
          ]
        },
        {
          "label": "ancillary testing",
          "children": [
            {
              "label": "visual field"
            },
            {
              "label": "fluorescein angiography"
            },
            {
              "label": "ERG"
            }
          ]
        },
        {
          "label": "lab tests",
          "children": [
            {
              "label": "> 50 years",
              "children": [
                {
                  "label": "check for common risk factors",
                  "children": [
                    {
                      "label": "CRVO after age 50 years does not require elaborate systemic workup"
                    }
                  ]
                }
              ]
            },
            {
              "label": "< 50 years",
              "children": [
                {
                  "label": "check for hypercoagulable conditions/thrombophilia",
                  "children": [
                    {
                      "label": "hyperhomocysteinemia"
                    },
                    {
                      "label": "protein S deficiency"
                    },
                    {
                      "label": "protein C deficiency"
                    }
                  ]
                },
                {
                  "label": "especially if",
                  "children": [
                    {
                      "label": "bilateral CRVO"
                    },
                    {
                      "label": "history of previous thrombosis"
                    },
                    {
                      "label": "family history of thrombosis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment of associated medical conditions",
          "children": [
            {
              "label": "hypertension"
            },
            {
              "label": "hypercholesterolemia"
            },
            {
              "label": "diabetes"
            },
            {
              "label": "hyperhomocyteinemia"
            },
            {
              "label": "smoking"
            }
          ]
        },
        {
          "label": "patient should report worsening vision",
          "children": [
            {
              "label": "non-ischemic CRVO can progress to ischemic CRVO",
              "children": [
                {
                  "label": "CVOS",
                  "children": [
                    {
                      "label": "16% in 4 months"
                    },
                    {
                      "label": "34% in 36 months"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
