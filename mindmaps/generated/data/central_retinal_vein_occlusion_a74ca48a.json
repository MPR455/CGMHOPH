            },
            {
              "label": "mild visual field changes"
            },
            {
              "label": "mild dilation & tortuosity of retinal veins"
            },
            {
              "label": "dot & flame hemorrhages in all quadrants"
            },
            {
              "label": "± macular edema"
            },
            {
              "label": "± mild optic disc swelling"
            },
            {
              "label": "fluorescein angiography",
              "children": [
                {
                  "label": "prolonged retinal circulation time"
                },
                {
                  "label": "breakdown of capillary permeability"
                },
                {
                  "label": "minimal nonperfusion"
                }
              ]
            },
