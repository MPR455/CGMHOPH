{
  "label": "6.17.3. Eyelid Disorders (III)",
  "root": true,
  "children": [
    {
      "label": "Infectious and Inflammatory Eyelid Disorders",
      "children": [
        {
          "label": "much more common than neoplasms"
        },
        {
          "label": "chalazia/hordeola",
          "children": [
            {
              "label": "chalazia",
              "children": [
                {
                  "label": "blocked meibomian glands"
                }
              ]
            },
            {
              "label": "hordeola",
              "children": [
                {
                  "label": "blocked eccrine or apocrine glands"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "warm compresses"
                },
                {
                  "label": "management of associated blepharitis"
                },
                {
                  "label": "surgical treatment for large, painful, or chronic lesions"
                }
              ]
            }
          ]
        },
        {
          "label": "pyogenic granuloma",
          "children": [
            {
              "label": "pedunculated"
            },
            {
              "label": "fleshy pink"
            },
            {
              "label": "granulation tissue"
            },
            {
              "label": "overlying a chalazion or site of trauma"
            },
            {
              "label": "can develop rapidly"
            }
          ]
        },
        {
          "label": "juvenile xanthogranuloma",
          "children": [
            {
              "label": "eyelid and epibulbar lesions"
            }
          ]
        },
        {
          "label": "molluscum contagiosum",
          "children": [
            {
              "label": "eyelids lesions"
            },
            {
              "label": "secondary follicular conjunctivitis"
            }
          ]
        }
      ]
    },
    {
      "label": "Neoplasms and Other Noninfectious Eyelid Lesions",
      "children": [
        {
          "label": "malignant tumors arising from eyelid skin or conjunctiva",
          "children": [
            {
              "label": "extremely rare in children"
            },
            {
              "label": "likely to be associated with underlying systemic disorders",
              "children": [
                {
                  "label": "basal cell nevus syndrome"
                },
                {
                  "label": "xeroderma pigmentosum"
                }
              ]
            }
          ]
        },
        {
          "label": "rhabdomyosarcoma",
          "children": [
            {
              "label": "rarely may present as an eyelid or conjunctival mass"
            }
          ]
        },
        {
          "label": "capillary malformations",
          "children": [
            {
              "label": "nevus flammeus",
              "children": [
                {
                  "label": "port-wine stain"
                }
              ]
            },
            {
              "label": "congenital vascular malformation"
            },
            {
              "label": "flat red or pink cutaneous lesion",
              "children": [
                {
                  "label": "may lighten during the first year of life"
                },
                {
                  "label": "tends to become darker, thicker, and more nodular over time"
                }
              ]
            },
            {
              "label": "associated with",
              "children": [
                {
                  "label": "Sturge-Weber syndrome"
                },
                {
                  "label": "Klippel-Trénaunay-Weber syndrome",
                  "children": [
                    {
                      "label": "variant of cerebrofacial angiomatosis"
                    },
                    {
                      "label": "nonocular findings",
                      "children": [
                        {
                          "label": "intracranial angiomas"
                        },
                        {
                          "label": "cutaneous nevus flammeus and hemangiomas",
                          "children": [
                            {
                              "label": "amenable to laser treatment"
                            }
                          ]
                        },
                        {
                          "label": "varicosities"
                        },
                        {
                          "label": "hemihypertrophy of the limbs"
                        }
                      ]
                    },
                    {
                      "label": "ocular findings",
                      "children": [
                        {
                          "label": "conjunctival telangiectasia"
                        },
                        {
                          "label": "congenital glaucoma"
                        },
                        {
                          "label": "uncommon"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "phakomatosis pigmentovascularis",
                  "children": [
                    {
                      "label": "in combination with ocular melanosis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "± glaucoma",
              "children": [
                {
                  "label": "difficult to treat"
                }
              ]
            },
            {
              "label": "lasers can be used to decrease the skin pigmentation"
            }
          ]
        },
        {
          "label": "Congenital Nevocellular Nevi of the Skin",
          "children": [
            {
              "label": "± visual deprivation amblyopia"
            },
            {
              "label": "± malignant transformation",
              "children": [
                {
                  "label": "risk of malignant transformation increases with lesion size",
                  "children": [
                    {
                      "label": "large lesions (>20 cm)",
                      "children": [
                        {
                          "label": "5%–20% risk of malignant transformation"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "observation is often recommended for small (<1.5 cm) and medium-sized (1.5–20.0 cm) lesions"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Excessive Blinking",
      "children": [
        {
          "label": "common in children"
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "psychogenic"
            },
            {
              "label": "stress-related factors"
            },
            {
              "label": "habit and motor tics"
            },
            {
              "label": "uncorrected refractive errors"
            },
            {
              "label": "strabismus"
            }
          ]
        },
        {
          "label": "Isolated excessive blinking tends not to be associated with vision-threatening or life- threatening disorders"
        }
      ]
    },
    {
