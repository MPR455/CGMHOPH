{
  "label": "5.9.6. Nystagmus (VI)",
  "root": true,
  "children": [
    {
      "label": "Eye Movements in Comatose Patients",
      "children": [
        {
          "label": "coma is caused by",
          "children": [
            {
              "label": "bilateral lesions of",
              "children": [
                {
                  "label": "brainstem (typically structural)"
                },
                {
                  "label": "cerebral hemispheres (structural or metabolic)"
                }
              ]
            },
            {
              "label": "unilateral, large hemispheric stroke",
              "children": [
                {
                  "label": "midline shift/tentorial herniation with brainstem compression"
                }
              ]
            }
          ]
        },
        {
          "label": "gaze preference",
          "children": [
            {
              "label": "hemispheric lesion",
              "children": [
                {
                  "label": "eyes deviate toward the side of a cerebral hemispheric lesion",
                  "children": [
                    {
                      "label": "away from the side of the hemiparesis"
                    },
                    {
                      "label": "intact contralateral frontal eye field drives the eyes to the opposite side"
                    }
                  ]
                },
                {
                  "label": "intact horizontal eye movements are demonstrable with supranuclear activation",
                  "children": [
                    {
                      "label": "doll’s head maneuver"
                    }
                  ]
                },
                {
                  "label": "persists for only a few days"
                }
              ]
            },
            {
              "label": "pontine brainstem stroke",
              "children": [
                {
                  "label": "eyes deviate away from the side of a pontine brainstem lesion",
                  "children": [
                    {
                      "label": "“brainstem lesions are too terrible to look at”"
                    },
                    {
                      "label": "intact, contralateral horizontal gaze center drives the eyes to that side"
                    }
                  ]
                },
                {
                  "label": "ocular deviation from brainstem strokes usually persists for long periods of time"
                }
              ]
            }
          ]
        },
        {
          "label": "spontaneous eye movements",
          "children": [
            {
              "label": "slow, roving, horizontal",
              "children": [
                {
                  "label": "conjugate",
                  "children": [
                    {
                      "label": "indicates intact brainstem ocular motor pathways",
                      "children": [
                        {
                          "label": "metabolic coma"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "bilateral hemispheric lesions",
              "children": [
                {
                  "label": "“ping-pong” gaze",
                  "children": [
                    {
                      "label": "rapidly alternate in gaze from side to side",
                      "children": [
                        {
                          "label": "every few seconds"
                        }
                      ]
                    },
                    {
                      "label": "confined to the horizontal plane"
                    }
                  ]
                },
                {
                  "label": "periodic alternating gaze deviation",
                  "children": [
                    {
                      "label": "longer period of alternating deviation",
                      "children": [
                        {
                          "label": "every few minutes"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "metabolic coma"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Additional Eye Movement Disorders",
      "children": [
        {
          "label": "Convergence-Retraction Nystagmus",
          "children": [
            {
              "label": "not true nystagmus",
              "children": [
                {
                  "label": "lacks slow phases"
                }
              ]
            },
            {
              "label": "best demonstrated by having the patient make an upward saccade or follow a downward- rotating OKN drum",
              "children": [
                {
                  "label": "co-contraction of the extraocular muscles on attempted upgaze",
                  "children": [
                    {
                      "label": "convergent movements",
                      "children": [
                        {
                          "label": "medial rectus muscles are the most powerful of the extraocular muscles"
                        }
                      ]
                    },
                    {
                      "label": "retraction of the globe into the orbit"
                    }
                  ]
                }
              ]
            },
            {
              "label": "localizes the disease process to the dorsal midbrain",
              "children": [
                {
                  "label": "paresis of upgaze"
                },
                {
                  "label": "pupillary light–near dissociation"
                },
                {
                  "label": "skew deviation"
                },
                {
                  "label": "bilateral eyelid retraction (Collier sign)"
                }
              ]
            }
          ]
        },
        {
          "label": "compare with neuromyotonia"
        },
        {
          "label": "Superior Oblique Myokymia",
          "children": [
            {
              "label": "etiology is unknown",
              "children": [
                {
                  "label": "neurovascular compression"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "paroxysmal, monocular, high-frequency bursts of contraction of the superior oblique muscle",
                  "children": [
                    {
                      "label": "spontaneously or after a downward eye movement"
                    },
                    {
                      "label": "x seconds"
                    },
                    {
                      "label": "numerous times per day"
                    },
                    {
                      "label": "movements are of very small amplitude",
                      "children": [
                        {
                          "label": "usually require magnification to observe them"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "symptoms",
                  "children": [
                    {
                      "label": "vertical or torsional oscillopsia"
                    },
                    {
                      "label": "± transient vertical diplopia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "electromyography",
              "children": [
                {
                  "label": "abnormal discharge from some muscle fibers, either spontaneously or after contraction of the muscle"
                }
              ]
            },
            {
              "label": "clinical course is highly variable",
              "children": [
                {
                  "label": "chronic",
                  "children": [
                    {
                      "label": "most common"
                    }
                  ]
                },
                {
                  "label": "spontaneous recovery",
                  "children": [
                    {
                      "label": "only brief spells"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "medical",
                  "children": [
                    {
                      "label": "phenytoin",
                      "children": [
                        {
                          "label": "carbamazepine",
                          "children": [
                            {
                              "label": "almost always benign"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "baclofen"
                    },
                    {
                      "label": "gabapentin"
                    },
                    {
                      "label": "topical betaxolol"
                    }
                  ]
                },
                {
                  "label": "combined superior oblique muscle tenotomy and recession of the ipsilateral inferior oblique muscle"
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "Oculomasticatory Myorhythmia",
          "children": [
            {
              "label": "Whipple disease"
            },
            {
              "label": "ocular motor findings",
              "children": [
                {
                  "label": "vertical saccadic palsy"
                }
              ]
            },
            {
              "label": "systemic findings",
              "children": [
                {
                  "label": "unexplained fever",
                  "children": [
                    {
                      "label": "pendular vergence oscillations",
                      "children": [
                        {
                          "label": "occur with contractions of the masticatory muscles"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "diarrhea"
                },
                {
                  "label": "cognitive dysfunction"
                },
                {
                  "label": "weight loss"
                },
                {
                  "label": "lymphadenopathy"
                }
              ]
            },
            {
              "label": "diagnostic workup",
              "children": [
                {
                  "label": "duodenal biopsy",
                  "children": [
                    {
                      "label": "PAS staining",
                      "children": [
                        {
                          "label": "Tropheryma whipplei"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "serologic (PCR) testing"
                }
              ]
            },
            {
              "label": "progressive and potentially life-threatening"
            },
            {
              "label": "curable with antibiotic therapy"
            }
          ]
        }
      ]
    },
    {
      "label": "Treatment of Nystagmus and Other Eye Movement Disorders",
      "children": [
        {
          "label": "pharmacologic",
          "children": [
            {
              "label": "baclofen (GABA-B receptor agonist)",
              "children": [
                {
                  "label": "frequently effective",
                  "children": [
                    {
                      "label": "acquired form of PAN"
                    }
                  ]
                }
              ]
            },
            {
              "label": "carbamazepine derivatives",
              "children": [
                {
                  "label": "frequently effective",
                  "children": [
                    {
                      "label": "superior oblique myokymia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "clonazepam (GABA-A receptor agonist)",
              "children": [
                {
                  "label": "Downbeat nystagmus"
                },
                {
                  "label": "other central vestibular forms of nystagmus"
                }
              ]
            },
            {
              "label": "memantine",
              "children": [
                {
                  "label": "may reduce nystagmus severity and improve vision",
                  "children": [
                    {
                      "label": "acquired and congenital forms of nystagmus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "gabapentin",
              "children": [
                {
                  "label": "GABAergic medication"
                },
                {
                  "label": "may reduce nystagmus severity and improve vision",
                  "children": [
                    {
                      "label": "acquired and congenital forms of nystagmus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "dalfampridine",
              "children": [
                {
                  "label": "downbeat nystagmus"
                },
                {
                  "label": "more efficacious than the similar drug amifampridine"
                }
              ]
            }
          ]
        },
        {
          "label": "nonpharmacologic treatment",
          "children": [
            {
              "label": "traditional amblyopia therapy"
            },
            {
              "label": "base-out prisms",
              "children": [
                {
                  "label": "to induce convergence in patients whose nystagmus diminishes with convergence",
                  "children": [
                    {
                      "label": "Infantile Nystagmus Syndrome (INS)/ Congenital Nystagmus (CN)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "contact lenses",
              "children": [
                {
                  "label": "may improve visual acuity in patients with congenital nystagmus"
                }
              ]
            },
            {
              "label": "unilateral retrobulbar injection of botulinum toxin type A",
              "children": [
                {
                  "label": "reduces amplitude of nystagmus",
                  "children": [
                    {
                      "label": "± visual benefit for patients who are willing to view monocularly"
                    }
                  ]
                },
                {
                  "label": "some patients report blurred vision when walking",
                  "children": [
                    {
                      "label": "because of the loss of the normal VOR that adjusts eye position as the head moves"
                    }
                  ]
                }
              ]
            },
            {
              "label": "extraocular muscle surgery",
              "children": [
                {
                  "label": "to mechanically shift the null point to primary position",
                  "children": [
                    {
                      "label": "for congenital nystagmus"
                    }
                  ]
                },
                {
                  "label": "on vertical recti",
                  "children": [
                    {
                      "label": "for upbeat or downbeat nystagmus"
                    },
                    {
                      "label": "diplopia may result postoperatively"
                    }
                  ]
                },
                {
                  "label": "horizontal rectus muscle tenotomy, with reattachment of the muscles to their original insertion site",
                  "children": [
                    {
                      "label": "for adult patients with congenital nystagmus"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Ocular Bobbing",
      "children": [
        {
          "label": "ocular bobbing",
          "children": [
            {
              "label": "rapid downward movement of both eyes, followed by slow return to midline"
            },
            {
              "label": "pons",
              "children": [
                {
                  "label": "similar to downbeat nystagmus",
                  "children": [
                    {
                      "label": "both cause pendular nystagmus",
                      "children": [
                        {
                          "label": "compare with oculopalatal myoclonus"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "infarction"
                },
                {
                  "label": "hemorrhage"
                }
              ]
            },
            {
              "label": "extremely poor prognosis for neurologic recovery"
            },
            {
              "label": "bilateral pontine lesions lead to loss of horizontal eye movements",
              "children": [
                {
                  "label": "valuable localization and prognostic information"
                }
              ]
            }
          ]
        },
        {
          "label": "inverse bobbing",
          "children": [
            {
              "label": "slow downward movement followed by fast return to primary position"
            }
          ]
        },
        {
          "label": "reverse ocular bobbing",
          "children": [
            {
              "label": "rapid upward deviation followed by a slow return to primary position"
            }
          ]
        },
        {
          "label": "converse bobbing",
          "children": [
            {
              "label": "slow upward drift followed by a rapid return to primary position",
