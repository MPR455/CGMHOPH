{
  "label": "8.13.6. Toxic & Traumatic Injuries (VI): Traumatic Hyphema",
  "root": true,
  "children": [
    {
      "label": "young males"
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "posterior displacement of the lens–iris interface"
        },
        {
          "label": "scleral expansion in the equatorial zone"
        },
        {
          "label": "disruption of the major iris arterial circle, arterial branches of the ciliary body, or recurrent choroidal arteries"
        }
      ]
    },
    {
      "label": "medical management",
      "children": [
        {
          "label": "protective shield"
        },
        {
          "label": "restriction of physical activity"
        },
        {
          "label": "elevation of the head of the bed"
        },
        {
          "label": "daily observation",
          "children": [
            {
              "label": "outpatient basis"
            },
            {
              "label": "if satisfactory home care and outpatient observation cannot be ensured, hospitalization may be required"
            }
          ]
        },
        {
          "label": "nonaspirin analgesics",
          "children": [
            {
              "label": "nonsteroidal anti-inflammatory medications can increase the risk of rebleeding"
            }
          ]
        },
        {
          "label": "long-acting topical cycloplegic agents"
        },
        {
          "label": "topical corticosteroids",
          "children": [
            {
              "label": "control anterior chamber inflammation"
            },
            {
              "label": "prevent synechiae formation"
            },
            {
              "label": "may play a role in preventing rebleeding"
            }
          ]
        },
        {
          "label": "oral corticosteroids",
          "children": [
            {
              "label": "facilitate the resolution of severe inflammation"
            },
            {
              "label": "prevent rebleeding"
            }
          ]
        },
        {
          "label": "elevated IOP may require treatment",
          "children": [
            {
              "label": "to reduce the risk of corneal blood staining and optic atrophy"
            },
            {
              "label": "topical antihypertensives (β-blockers and α- agonists)"
            },
            {
              "label": "intravenous or oral hyperosmotic agents"
            }
          ]
        },
        {
          "label": "antifibrinolytic agents (aminocaproic acid [Amicar], tranexamic acid, prednisone)",
          "children": [
            {
              "label": "reduced the incidence of rebleeding",
              "children": [
                {
                  "label": "failed to show a statistical improvement in visual outcome"
                }
              ]
            },
            {
              "label": "may produce significant adverse effects",
              "children": [
                {
                  "label": "nausea, vomiting, postural hypotension, muscle cramps, conjunctival suffusion, nasal stuffiness, headache, rash, pruritus, dyspnea, toxic confusional states, and arrhythmias,"
                },
                {
                  "label": "risk of increased IOP on discontinuation"
                }
              ]
            },
            {
              "label": "rarely used today"
            }
          ]
        }
      ]
    },
    {
      "label": "gross hyphema",
      "children": [
        {
          "label": "can be seen on penlight examination"
        }
      ]
    },
    {
      "label": "microscopic hyphema",
      "children": [
        {
          "label": "few circulating RBC on slit-lamp examination"
        }
      ]
    },
    {
      "label": "hyphema is frequently associated with",
      "children": [
        {
          "label": "corneal abrasion"
        },
        {
          "label": "iritis"
        },
        {
          "label": "mydriasis"
        },
        {
          "label": "significant injuries to the angle structures, lens, posterior segment, and orbit"
        }
      ]
    },
    {
      "label": "Spontaneous hyphema",
      "children": [
        {
          "label": "rubeosis iridis"
        },
        {
          "label": "clotting abnormalities"
        },
        {
          "label": "herpetic disease"
        },
        {
          "label": "intraocular lens problems"
        },
        {
          "label": "Juvenile xanthogranuloma"
        },
        {
          "label": "retinoblastoma"
        },
        {
          "label": "leukemia"
        }
      ]
    },
    {
      "label": "Surgery",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "at the earliest definitive detection of blood staining",
              "children": [
                {
                  "label": "irreversible corneal blood staining"
                }
              ]
            },
            {
              "label": "IOP>35 mmHg x 7 days",
              "children": [
                {
                  "label": "if the IOP averages >25 mm Hg for 5 days with a total hyphema"
                },
                {
                  "label": "optic atrophy from persistently elevated IOP"
                },
                {
                  "label": "IOP>60 mm Hg x 2 days"
                }
              ]
            },
            {
              "label": "See Table 13-4"
            }
          ]
        },
        {
          "label": "require earlier intervention",
          "children": [
            {
              "label": "preexisting optic nerve damage"
            },
            {
              "label": "sickle hemoglobinopathies",
              "children": [
                {
                  "label": "sickle cell complications",
                  "children": [
                    {
                      "label": "sickle cell patients and carriers of sickle cell trait"
                    },
                    {
                      "label": "African American patient",
                      "children": [
                        {
                          "label": "sickle cell workup"
                        }
                      ]
                    },
                    {
                      "label": "pathogenesis",
                      "children": [
                        {
                          "label": "sickling of RBCs in the anterior chamber",
                          "children": [
                            {
                              "label": "restricted outflow through the trabecular meshwork",
                              "children": [
                                {
                                  "label": "increased IOP"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "optic nerve appears to be at greater risk of damage in sickle cell patients"
                        }
                      ]
                    },
                    {
                      "label": "all efforts must be made to normalize IOP in these patients",
                      "children": [
                        {
                          "label": "carbonic anhydrase inhibitors"
                        }
                      ]
                    },
                    {
                      "label": "indications of surgical intervention",
                      "children": [
                        {
                          "label": "average IOP remains 25 mm Hg or higher after the first 24 hours",
                          "children": [
                            {
                              "label": "osmotic agents",
                              "children": [
                                {
                                  "label": "must be used with caution",
                                  "children": [
                                    {
                                      "label": "reduce pH and lead to hemoconcentration",
                                      "children": [
                                        {
                                          "label": "may exacerbate sickling"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "repeated, transient elevations, with IOP higher than 30 mm Hg for 2–4 days"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "techniques",
          "children": [
            {
              "label": "anterior chamber irrigation with BSS through a paracentesis",
