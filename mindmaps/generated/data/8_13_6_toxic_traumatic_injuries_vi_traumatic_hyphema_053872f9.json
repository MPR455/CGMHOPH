                {
                  "label": "remove circulating red blood cells"
                },
                {
                  "label": "can be repeated",
                  "children": [
                    {
                      "label": "removal of the entire clot is neither necessary nor wise"
                    }
                  ]
                }
              ]
            },
            {
              "label": "I/A handpiece"
            },
            {
              "label": "cutting instrument"
            },
            {
              "label": "intraocular diathermy"
            }
          ]
        },
