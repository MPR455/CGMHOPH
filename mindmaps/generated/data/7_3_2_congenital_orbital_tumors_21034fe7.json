{
  "label": "7.3.2: Congenital Orbital Tumors",
  "root": true,
  "children": [
    {
      "label": "Hamartomas and Choristomas",
      "children": [
        {
          "label": "hamartomas",
          "children": [
            {
              "label": "anomalous growths of tissue consisting only of mature cells normally found at the involved site",
              "children": [
                {
                  "label": "infantile (capillary) hemangiomas"
                },
                {
                  "label": "characteristic lesions of neurofibromatosis"
                }
              ]
            }
          ]
        },
        {
          "label": "Choristomas",
          "children": [
            {
              "label": "tissue anomalies characterized by types of cells not normally found at the involved site",
              "children": [
                {
                  "label": "dermoid cysts"
                },
                {
                  "label": "epidermoid cysts"
                },
                {
                  "label": "dermolipomas"
                },
                {
                  "label": "teratomas"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Dermolipoma",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "benign"
            },
            {
              "label": "solid"
            },
            {
              "label": "located in and beneath the conjunctiva over the globe’s lateral surface",
              "children": [
                {
                  "label": "may have deep extensions to the levator aponeurosis and extraocular muscles"
                }
              ]
            },
            {
              "label": "fine hairs",
              "children": [
                {
                  "label": "can be irritating"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "prolapsed orbital fat"
            },
            {
              "label": "prolapsed palpebral lobe of the lacrimal gland"
            },
            {
              "label": "lymphomas"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "require no treatment unless the lesion is ...",
              "children": [
                {
                  "label": "large"
                },
                {
                  "label": "cosmetically objectionable"
                }
              ]
            },
            {
              "label": "when possible, the overlying conjunctiva should be preserved"
            },
            {
              "label": "only the anterior, visible portion should be excised"
            },
            {
              "label": "avoid damage to",
              "children": [
                {
                  "label": "lacrimal gland ducts"
                },
                {
                  "label": "extraocular muscles"
                },
                {
                  "label": "levator aponeurosis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Dermoid cyst",
      "children": [
        {
          "label": "dermoid/epidermoid cysts are among the most common orbital tumors of childhood"
        },
        {
          "label": "congenital",
          "children": [
            {
              "label": "enlarge progressively"
            }
          ]
        },
        {
          "label": "superficial cysts usually become symptomatic in childhood"
        },
        {
          "label": "deep orbital dermoids may not become clinically evident until adulthood"
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "dermoid cyst",
              "children": [
                {
                  "label": "keratinizing epithelium"
                },
                {
                  "label": "dermal appendages",
                  "children": [
                    {
                      "label": "hair follicles"
                    },
                    {
                      "label": "sebaceous glands"
                    }
                  ]
                },
                {
                  "label": "contains oil and keratin"
                }
              ]
            },
            {
              "label": "epidermoid cysts",
              "children": [
                {
                  "label": "epidermis only",
                  "children": [
                    {
                      "label": "no dermal appendages"
                    }
                  ]
                },
                {
                  "label": "usually filled with keratin"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "palpable smooth, painless, oval mass",
              "children": [
                {
                  "label": "slow enlargement"
                },
                {
                  "label": "freely mobile or fixed to periosteum"
                },
                {
                  "label": "dermoids presenting in childhood are often superficial"
                }
              ]
            },
            {
              "label": "location",
              "children": [
                {
                  "label": "lateral brow",
                  "children": [
                    {
                      "label": "adjacent to frontozygomatic suture"
                    },
                    {
                      "label": "most common"
                    }
                  ]
                },
                {
                  "label": "medial upper eyelid",
                  "children": [
                    {
                      "label": "adjacent to frontoethmoidal suture"
                    },
                    {
                      "label": "differential diagnosis",
                      "children": [
                        {
                          "label": "congenital encephaloceles"
                        },
                        {
                          "label": "dacryoceles"
                        },
                        {
                          "label": "vascular lesions"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "temporal fossa",
                  "children": [
                    {
                      "label": "rule out dumbbell dermoid cyst",
                      "children": [
                        {
                          "label": "pulsating proptosis with mastication",
                          "children": [
                            {
                              "label": "highly specific feature"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "deep dermoid cysts",
              "children": [
                {
                  "label": "situated posteriorly in the orbit"
                },
                {
                  "label": "often are not palpable"
                },
                {
                  "label": "do not present until adulthood"
                },
                {
                  "label": "usually superior and temporal adjacent to bony sutures"
                },
                {
                  "label": "globe and adnexa may be displaced",
                  "children": [
                    {
                      "label": "progressive proptosis"
                    }
                  ]
                },
                {
                  "label": "bone erosion or remodeling",
                  "children": [
                    {
                      "label": "long-standing dermoids"
                    }
                  ]
                }
              ]
            },
            {
              "label": "orbital inflammation",
              "children": [
                {
                  "label": "incited by leakage of oil and keratin from the cyst"
                },
                {
                  "label": "may result in an orbitocutaneous fistula"
                },
                {
                  "label": "may also occur following incomplete surgical removal"
                }
              ]
            }
          ]
        },
        {
          "label": "imaging",
          "children": [
            {
              "label": "CT",
              "children": [
                {
                  "label": "margin",
                  "children": [
                    {
                      "label": "well defined"
                    },
                    {
                      "label": "enhancing"
                    },
                    {
                      "label": "partially calcified in most cases"
                    }
                  ]
                },
                {
                  "label": "nonenhancing lumen"
                }
              ]
            },
            {
              "label": "magnetic resonance imaging",
              "children": [
                {
                  "label": "best appreciated on fat-suppression sequences",
                  "children": [
                    {
                      "label": "well-defined"
                    },
                    {
                      "label": "variable size"
                    },
                    {
                      "label": "round to ovoid"
                    }
                  ]
                },
                {
                  "label": "hypointense on T1-weighted images"
                },
                {
                  "label": "relatively hyperintense on T2-weighted images"
                },
                {
                  "label": "minimal enhancement"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "surgical excision",
              "children": [
                {
                  "label": "incision in the upper eyelid crease or directly over the lesion"
                },
                {
                  "label": "cyst wall should be maintained during surgery",
                  "children": [
                    {
                      "label": "rupture of the cyst can lead to an acute inflammatory process if part of the cyst wall or any of the contents remain within the eyelid or orbit",
                      "children": [
                        {
                          "label": "if cyst wall is ruptured, the surgeon should remove the cyst contents"
                        },
                        {
                          "label": "complete surgical removal may be difficult if cyst has leaked preoperatively and adhesions have developed"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Teratoma",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "severe unilateral proptosis at birth",
              "children": [
                {
                  "label": "may increase over the first few days or weeks"
                },
                {
                  "label": "corneal exposure and vision loss"
                }
              ]
            },
            {
              "label": "usually cystic"
            },
            {
              "label": "globe and optic nerve may be maldeveloped",
              "children": [
                {
                  "label": "when the lesion is smaller, the globe is often normal"
                }
              ]
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "arise from all 3 germinal layers (ectoderm, mesoderm, and endoderm)"
            },
            {
              "label": "complex arrangement of various tissues"
            },
            {
              "label": "clear cysts lined by either epidermis or gastrointestinal or respiratory epithelium"
            },
            {
              "label": "Islands of",
              "children": [
                {
                  "label": "hyaline cartilage"
                },
                {
                  "label": "cerebral tissue"
                },
                {
                  "label": "epidermal cysts"
                },
                {
                  "label": "choroid plexus"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "surgical excision",
              "children": [
                {
                  "label": "teratomas confined to the orbit are generally benign",
                  "children": [
                    {
                      "label": "teratomas in other parts of the body have been known to undergo malignant transformation"
                    }
                  ]
                },
                {
                  "label": "some cystic teratomas can be removed and ocular function preserved"
                }
              ]
            },
            {
              "label": "exenteration",
              "children": [
                {
                  "label": "for malignant teratomas"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
