{
  "label": "9.7.10. Infectious Ocular Inflammatory Diseases (X): Fungal Uveitis: Ocular histoplasmosis syndrome (OHS)",
  "root": true,
  "children": [
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "endemic areas of the United States",
          "children": [
            {
              "label": "Ohio and Mississippi River valleys",
              "children": [
                {
                  "label": "60% of individuals react positively to histoplasmin skin testing"
                }
              ]
            }
          ]
        },
        {
          "label": "nonendemic areas in the United States",
          "children": [
            {
              "label": "Maryland"
            }
          ]
        },
        {
          "label": "sporadically throughout Europe (the United Kingdom and Netherlands)"
        },
        {
          "label": "M=F",
          "children": [
            {
              "label": "vast majority of patients are of northern European descent"
            }
          ]
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "Histoplasma capsulatum",
          "children": [
            {
              "label": "dimorphic fungus with yeast and filamentous forms",
              "children": [
                {
                  "label": "yeast form is the cause of both systemic and ocular disease"
                }
              ]
            },
            {
              "label": "H capsulatum DNA has been detected in chronic choroidal lesions of a patient with OHS"
            },
            {
              "label": "individuals with disciform scars are more likely than control subjects to react positively to histoplasmin skin testing"
            }
          ]
        },
        {
          "label": "inhalation of the fungal spores into the lungs",
          "children": [
            {
              "label": "hematogenous dissemination of the organism",
              "children": [
                {
                  "label": "primary infection, typically during childhood",
                  "children": [
                    {
                      "label": "focal infection of the choroid at the time of initial systemic infection"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "immune mechanisms in patients with an underlying genetic predisposition",
          "children": [
            {
              "label": "HLA-DRw2",
              "children": [
                {
                  "label": "2x as common among patients with histo spots alone"
                }
              ]
            },
            {
              "label": "HLA-B7 and HLA-DRw2",
              "children": [
                {
                  "label": "2–4x more common among patients with disciform scars"
                }
              ]
            },
            {
              "label": "HLA-DR2",
              "children": [
                {
                  "label": "present among those with CNV due to OHS"
                },
                {
                  "label": "absent in a group of patients with MCP"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "idiopathic CNV"
        },
        {
          "label": "MCP"
        },
        {
          "label": "punctate inner choroidopathy"
        },
        {
          "label": "syphilis"
        },
        {
          "label": "tuberculosis"
        },
        {
          "label": "sarcoidosis"
        },
        {
          "label": "coccidioidomycosis"
        },
        {
          "label": "toxocariasis"
        },
        {
          "label": "myopic degeneration"
        },
        {
          "label": "AMD"
        }
      ]
    },
    {
      "label": "diagnostic tests",
      "children": [
        {
          "label": "FA of active choroiditis",
          "children": [
            {
              "label": "early hypofluorescence (window block), late hyperfluorescence (staining)"
            }
          ]
        }
      ]
    },
    {
      "label": "treatment of vision-threatening juxtafoveal or subfoveal CNV",
      "children": [
        {
          "label": "thermal laser photocoagulation",
          "children": [
            {
              "label": "rarely used in the treatment of subfoveal CNV associated with OHS",
              "children": [
                {
                  "label": "in contrast to CNV that shows early hyperfluorescence"
                }
              ]
            }
          ]
        },
        {
          "label": "photodynamic therapy (PDT)",
          "children": [
            {
              "label": "advocated for the treatment of subfoveal OHS- associated CNV"
            }
          ]
        },
        {
          "label": "intravitreal injection of anti–vascular endothelial growth factor (anti-VEGF) drugs"
        },
        {
          "label": "combination approaches using PDT and intravitreal corticosteroids or anti-VEGF drugs"
        },
        {
          "label": "submacular surgery",
          "children": [
            {
              "label": "≈ 50% recurrence rate"
            },
            {
              "label": "in selected cases of extensive peripapillary CNV, surgical removal may provide a more definitive vision benefit"
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "clinical triad",
          "children": [
            {
              "label": "multiple white, atrophic choroidal (histo spots)",
              "children": [
                {
                  "label": "macula or periphery"
                },
                {
                  "label": "discrete and punched out"
                },
                {
                  "label": "asymptomatic"
                },
                {
                  "label": "seen in 1.5% of patients from endemic areas",
                  "children": [
                    {
                      "label": "appearing during adolescence"
                    }
                  ]
                },
                {
                  "label": "new choroidal scars develop in >20%"
                },
                {
                  "label": "only 3.8% of these cases progress to CNV"
                },
                {
                  "label": "early, acute granulomatous lesions of OHS are rarely observed",
                  "children": [
                    {
                      "label": "may be treated with oral or regional (periocular) corticosteroids"
                    }
                  ]
                }
              ]
            },
            {
              "label": "peripapillary pigment changes"
            },
            {
              "label": "maculopathy caused by CNV",
              "children": [
                {
                  "label": "metamorphopsia and a profound reduction in central vision"
                },
                {
                  "label": "mean age of 41 years"
                },
                {
                  "label": "histo spots in the macular area",
                  "children": [
                    {
                      "label": "15% chance of developing CNV within 5 years"
                    }
                  ]
                },
                {
                  "label": "no spots in the macular area",
                  "children": [
                    {
                      "label": "5% chance of developing CNV within 5 years"
                    }
                  ]
                },
                {
                  "label": "yellow-green subretinal membrane",
                  "children": [
                    {
                      "label": "surrounded by a pigment ring"
                    },
                    {
                      "label": "arising at the border of a histo scar in the disc–macula area"
                    }
                  ]
                },
                {
                  "label": "subretinal fibrosis and disciform scarring"
                },
                {
                  "label": "+- massive subretinal exudation and hemorrhagic retinal detachments"
                },
                {
                  "label": "+- spontaneous resolution with a return to normal vision"
                },
                {
                  "label": "visual prognosis of untreated OHS-associated CNV is poor",
                  "children": [
                    {
                      "label": "75% of eyes reaching a final visual acuity of 20/100 or worse over a 3-year period"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "linear equatorial streaks",
          "children": [
            {
              "label": "5%"
            }
          ]
        },
        {
          "label": "absence of vitreous cells"
        }
      ]
    },
