{
  "label": "9.7.13. Infectious Ocular Inflammatory Diseases (XIII): Helminthic Uveitis (I): Ocular Toxocariasis",
  "root": true,
  "children": [
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "M=F",
          "children": [
            {
              "label": "children and young adults",
              "children": [
                {
                  "label": "median age = 11.5 years (range, 1–66)"
                }
              ]
            },
            {
              "label": "non-Hispanic whites are affected most commonly"
            }
          ]
        },
        {
          "label": "1% of uveitic population"
        },
        {
          "label": "14% of the US population is seropositive"
        },
        {
          "label": "US rate is 1 in 1000 persons"
        },
        {
          "label": "ocular involvement has been reported to occur in <1% of all seropositive children in Spain"
        }
      ]
    },
    {
      "label": "visceral larvae migrans (VLM)",
      "children": [
        {
          "label": "increased rate of pica",
          "children": [
            {
              "label": "children <3 years"
            }
          ]
        },
        {
          "label": "direct relationship between peripheral eosinophilia and parasitic burden in systemic disease (but not in OT)"
        },
        {
          "label": "ocular toxocariasis (OT) and VLM rarely present contemporaneously"
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "Toxocara canis or T cati",
          "children": [
            {
              "label": "roundworm parasites"
            }
          ]
        },
        {
          "label": "complete their life cycles in small intestines of dogs and cats",
          "children": [
            {
              "label": "eggs are passed in feces"
            }
          ]
        },
        {
          "label": "fecal–oral human transmission",
          "children": [
            {
              "label": "ingestion of soil or contaminated food",
              "children": [
                {
                  "label": "eating disorder pica"
                },
                {
                  "label": "contact with puppies or kittens"
                }
              ]
            }
          ]
        },
        {
          "label": "organisms grow in the small intestine",
          "children": [
            {
              "label": "enter the portal circulation",
              "children": [
                {
                  "label": "hematogenous and lymphatic dissemination",
                  "children": [
                    {
                      "label": "tissue invasion by the second-stage larvae",
                      "children": [
                        {
                          "label": "visceral larvae migrans"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "maturation of adult worm does not occur in humans",
          "children": [
            {
              "label": "ova are not shed in the alimentary tract!"
            }
          ]
        }
      ]
    },
    {
      "label": "playgrounds/sandboxes"
    },
    {
      "label": "diagnostic tests",
      "children": [
        {
          "label": "diagnosis is essentially clinical"
        },
        {
          "label": "serology",
          "children": [
            {
              "label": "serum ELISA titer of 1:8 is 91% sensitive and 90% specific for prior exposure",
              "children": [
                {
                  "label": "absence of serum antibodies rules out the diagnosis of toxoplasmosis!"
                }
              ]
            },
            {
              "label": "≤1/3 of patients have negative ELISA results",
              "children": [
                {
                  "label": "absence of serum antibodies does not rule out the diagnosis!"
                },
                {
                  "label": "intraocular fluid ELISA may reveal specific Toxocara antibodies (positive GW coefficient)"
                }
              ]
            },
            {
              "label": "any positive titer should be considered significant in the appropriate clinical context"
            }
          ]
        },
        {
          "label": "toxocara larvae have been recovered from the vitreous during pars plana vitrectomy"
        },
        {
          "label": "PCR of vitreous not successful"
        },
        {
          "label": "B-scan ultrasonography and CT",
          "children": [
            {
              "label": "useful in the presence of media opacity",
              "children": [
                {
                  "label": "vitreous membranes"
                },
                {
                  "label": "tractional retinal detachment"
                },
                {
                  "label": "absence of calcium"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "sporadic unilateral retinoblastoma",
          "children": [
            {
              "label": "younger age at presentation"
            },
            {
              "label": "paucity of inflammatory stigmata"
            },
            {
              "label": "demonstration of lesion growth in children"
            }
          ]
        },
        {
          "label": "infectious endophthalmitis"
        },
        {
          "label": "toxoplasmosis"
        },
        {
          "label": "pars planitis"
        },
        {
          "label": "retinopathy of prematurity"
        },
        {
          "label": "persistent fetal vasculature"
        },
        {
          "label": "Coats disease"
        },
        {
          "label": "familial exudative vitreoretinopathy"
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "unilateral decreased vision"
            },
            {
              "label": "pain"
            },
            {
              "label": "photophobia"
            },
            {
              "label": "floaters"
            },
            {
              "label": "strabismus"
            },
            {
              "label": "leukocoria"
            }
          ]
        },
        {
          "label": "bilateral disease is exceedingly rare"
        },
        {
          "label": "anterior segment is typically white and quiet",
          "children": [
            {
              "label": "+- nongranulomatous anterior inflammation"
            },
            {
              "label": "+- posterior synechiae"
            }
          ]
        },
        {
          "label": "posterior segment findings",
          "children": [
            {
              "label": "3 ocular syndromes",
              "children": [
                {
                  "label": "severe vitreous inflammation and chronic endophthalmitis",
                  "children": [
                    {
                      "label": "25%"
                    }
                  ]
                },
                {
                  "label": "localized macular granuloma",
                  "children": [
                    {
                      "label": "25%"
                    },
                    {
                      "label": "50%"
                    }
                  ]
                },
                {
                  "label": "peripheral granuloma"
                },
                {
                  "label": "See Table 7-2"
                }
              ]
            },
            {
              "label": "uncommon variants",
              "children": [
                {
                  "label": "unilateral pars planitis"
                },
                {
                  "label": "diffuse peripheral inflammatory exudates"
                },
                {
                  "label": "granulomas involving the optic nerve"
                }
              ]
            }
          ]
        },
        {
          "label": "determinants of visual prognosis",
          "children": [
            {
              "label": "degree of intraocular inflammation",
              "children": [
                {
                  "label": "eyes with endophthalmitis have the worst vision at presentation"
                }
              ]
            },
            {
              "label": "location of the inflammatory foci with respect to the fovea",
              "children": [
                {
                  "label": "in the absence of foveal involvement, vision is usually best with posterior pole granulomas"
                }
              ]
            },
            {
              "label": "presence or absence of CME"
            },
            {
              "label": "development of tractional membranes involving the optic nerve, macula, and ciliary body"
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
