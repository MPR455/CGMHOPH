{
  "label": "8.8.4. Neoplastic Disorders of the Conjunctiva and Cornea IV: Preinvasive/Malignant Pigmented Lesions",
  "root": true,
  "children": [
    {
      "label": "Melanoma",
      "children": [
        {
          "label": "Epidemiology",
          "children": [
            {
              "label": "prevalence",
              "children": [
                {
                  "label": "1 per 2 million"
                }
              ]
            },
            {
              "label": "<1% of ocular malignancies",
              "children": [
                {
                  "label": "PAM (70%)"
                }
              ]
            }
          ]
        },
        {
          "label": "Pathogenesis",
          "children": [
            {
              "label": "arise from",
              "children": [
                {
                  "label": "nevi (20%)"
                },
                {
                  "label": "de novo (10%)"
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical presentation",
          "children": [
            {
              "label": "most commonly in bulbar conjunctiva or at limbus",
              "children": [
                {
                  "label": "can arise in palpebral conjunctiva"
                }
              ]
            },
            {
              "label": "variable pigmentation",
              "children": [
                {
                  "label": "25% are amelanotic"
                }
              ]
            },
            {
              "label": "heavy vascularization",
              "children": [
                {
                  "label": "may bleed easily",
                  "children": [
                    {
                      "label": "recurrent melanomas are often amelanotic"
                    }
                  ]
                }
              ]
            },
            {
              "label": "grow in a nodular fashion"
            },
            {
              "label": "can invade the globe or orbit"
            }
          ]
        },
        {
          "label": "Differential diagnosis",
          "children": [
            {
              "label": "underlying ciliary body melanoma extending through sclera"
            }
          ]
        },
        {
          "label": "Prognosis",
          "children": [
            {
              "label": "overall mortality rate",
              "children": [
                {
                  "label": "better prognosis than cutaneous melanoma"
                },
                {
                  "label": "25%"
                }
              ]
            },
            {
              "label": "at 10 years",
              "children": [
                {
                  "label": "metastasis",
                  "children": [
                    {
                      "label": "26%"
                    }
                  ]
                },
                {
                  "label": "death",
                  "children": [
                    {
                      "label": "13%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "poor prognostic indicators",
              "children": [
                {
                  "label": "not involving the limbus",
                  "children": [
                    {
                      "label": "location in the palpebral conjunctiva, caruncle, or fornix"
                    }
                  ]
                },
                {
                  "label": "involvement of the eyelid margin"
                },
                {
                  "label": "melanomas arising de novo"
                },
                {
                  "label": "thickness >1.8 mm"
                },
                {
                  "label": "invasion into deeper tissues"
                },
                {
                  "label": "residual involvement at the surgical margins"
                },
                {
                  "label": "pagetoid or full-thickness intraepithelial spread"
                },
                {
                  "label": "lymphatic invasion"
                },
                {
                  "label": "mixed cell type"
                }
              ]
            },
            {
              "label": "metastasize to",
              "children": [
                {
                  "label": "regional lymph nodes"
                },
                {
                  "label": "brain"
                },
                {
                  "label": "lungs"
                },
                {
                  "label": "liver"
                }
              ]
            },
            {
              "label": "gene expression profiling",
              "children": [
                {
                  "label": "bone"
                }
              ]
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "surgical resection"
            },
            {
              "label": "sentinel lymph node biopsy"
            },
            {
              "label": "orbital exenteration",
              "children": [
                {
                  "label": "when local excision or enucleation cannot completely excise the tumor"
                },
                {
                  "label": "palliative treatment for aggressive tumors that cannot be controlled locally",
                  "children": [
                    {
                      "label": "• adjunctive radiotherapy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "lifelong, close ophthalmic follow-up"
            },
            {
              "label": "gene expression profiling",
              "children": [
                {
                  "label": "may be helpful in determining the response to targeted chemotherapies"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Primary acquired melanosis",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "proliferation of abnormal melanocytes in the basal conjunctival epithelium"
            },
            {
              "label": "unilateral"
            },
            {
              "label": "light skin color",
              "children": [
                {
                  "label": "analogous to lentigo maligna of the skin"
                }
              ]
            },
            {
              "label": "middle-aged"
            },
            {
              "label": "secondary acquired melanosis",
              "children": [
                {
                  "label": "addison disease"
                },
                {
                  "label": "radiation"
                },
                {
                  "label": "pregnancy"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical findings",
          "children": [
            {
              "label": "multiple flat, brown patches of noncystic pigmentation",
              "children": [
                {
                  "label": "superficial conjunctiva"
                }
              ]
            },
            {
              "label": "malignant transformation",
              "children": [
                {
                  "label": "most cases are benign"
                },
                {
                  "label": "main risk factor for progression to melanoma is cellular atypia",
                  "children": [
                    {
                      "label": "PAM with atypia progresses to conjunctival melanoma in 36%–75%"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "suspicious pigmented lesions of the ocular surface should be removed",
              "children": [
                {
                  "label": "nodularity"
                },
                {
                  "label": "enlargement",
                  "children": [
                    {
                      "label": "changes in size may be the result of inflammation or hormonal influences"
                    }
                  ]
                },
                {
                  "label": "increased vascularity"
                },
                {
                  "label": "location",
                  "children": [
                    {
                      "label": "palpebral/tarsal conjunctiva"
                    },
                    {
                      "label": "fornix"
                    },
                    {
                      "label": "plica"
                    },
                    {
                      "label": "caruncle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "complete excision should be done when possible"
            },
            {
              "label": "if the pigment is diffuse, perform multiple biopsies",
              "children": [
                {
                  "label": "PAM without atypia",
                  "children": [
                    {
                      "label": "lesion(s) may be followed every 6–12 months"
                    }
                  ]
                },
                {
                  "label": "PAM with atypia",
                  "children": [
                    {
                      "label": "if not amenable to complete excision",
                      "children": [
                        {
                          "label": "eliminate all conjunctival pigment"
                        },
                        {
                          "label": "adjuvant topical chemotherapy"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "care should be exercised in performing intraocular surgery on patients with untreated ocular surface neoplasia",
              "children": [
                {
                  "label": "tumor seeding within corneal stroma and internal eye structures"
                }
              ]
            }
          ]
        }
      ]
    }
