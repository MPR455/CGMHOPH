{
  "label": "5.4.12. Patient With Decreased Vision: Classification & Management (XII): Chiasmal Lesions",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "optic disc appearance",
          "children": [
            {
              "label": "optic discs appear normal initially",
              "children": [
                {
                  "label": "even with significant visual field loss!"
                }
              ]
            },
            {
              "label": "± increased disc cupping",
              "children": [
                {
                  "label": "with progressive damage, optic discs show typical atrophy",
                  "children": [
                    {
                      "label": "often temporal"
                    }
                  ]
                }
              ]
            },
            {
              "label": "chiasmal compression almost never produces optic disc edema"
            }
          ]
        },
        {
          "label": "perimetry",
          "children": [
            {
              "label": "gradually progressive, bilateral vision loss",
              "children": [
                {
                  "label": "often asymmetric!"
                },
                {
                  "label": "peripheral (temporal) visual fields usually are involved first"
                }
              ]
            }
          ]
        },
        {
          "label": "RAPD",
          "children": [
            {
              "label": "only with markedly asymmetric visual field loss",
              "children": [
                {
                  "label": "in any case of bilateral visual field loss, evaluate perimetry results for respect of the vertical midline"
                }
              ]
            }
          ]
        },
        {
          "label": "optic nerve disorders produce more central loss, with impaired visual acuity, dyschromatopsia, and an RAPD"
        }
      ]
    },
    {
      "label": "Visual Field Loss Patterns",
      "children": [
        {
          "label": "junctional scotoma",
          "children": [
            {
              "label": "lesions that injure an optic nerve at its junction with the optic chiasm"
            },
            {
              "label": "ipsilateral eye",
              "children": [
                {
                  "label": "central visual field loss",
                  "children": [
                    {
                      "label": "diminished visual acuity"
                    }
                  ]
                }
              ]
            },
            {
              "label": "opposite eye",
              "children": [
                {
                  "label": "temporal hemianopia"
                }
              ]
            }
          ]
        },
        {
          "label": "unilateral temporal hemianopia",
          "children": [
            {
              "label": "the mass compresses only the crossing nasal fibers from 1 eye"
            },
            {
              "label": "no involvement of the visual field in the opposite eye"
            },
            {
              "label": "most common visual field defect of chiasmal compression",
              "children": [
                {
                  "label": "respects the vertical midline!"
                }
              ]
            }
          ]
        },
        {
          "label": "bitemporal hemianopia",
          "children": [
            {
              "label": "relative or complete"
            },
            {
              "label": "may involve the paracentral temporal field alone"
            },
            {
              "label": "visual acuity is often unaffected until late"
            }
          ]
        }
      ]
    },
    {
      "label": "Extrinsic lesions affecting the chiasm",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "pituitary adenoma",
              "children": [
                {
                  "label": "any adult age",
                  "children": [
                    {
                      "label": "most common cause of chiasmal compression"
                    },
                    {
                      "label": "rare in childhood"
                    }
                  ]
                },
                {
                  "label": "may enlarge during pregnancy"
                },
                {
                  "label": "types",
                  "children": [
                    {
                      "label": "nonsecreting tumors",
                      "children": [
                        {
                          "label": "present with vision loss"
                        }
                      ]
                    },
                    {
                      "label": "hormonally active tumors",
                      "children": [
                        {
                          "label": "present with systemic symptoms"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "pituitary apoplexy",
                  "children": [
                    {
                      "label": "acute hemorrhage or infarction of the pituitary tumor"
                    },
                    {
                      "label": "clinical presentation",
                      "children": [
                        {
                          "label": "severe headache"
                        },
                        {
                          "label": "nausea"
                        },
                        {
                          "label": "extravasation of blood into the subarachnoid space",
                          "children": [
                            {
                              "label": "decreased level of consciousness"
                            },
                            {
                              "label": "vasospasm with secondary stroke"
                            }
                          ]
                        },
                        {
                          "label": "acute endocrine abnormalities",
                          "children": [
                            {
                              "label": "adrenal crisis"
                            }
                          ]
                        },
                        {
                          "label": "neuro-ophthalmic findings",
                          "children": [
                            {
                              "label": "diplopia",
                              "children": [
                                {
                                  "label": "dysfunction of CNs III, IV, V, and VI",
                                  "children": [
                                    {
                                      "label": "CN III the most commonly affected"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "label": "central visual loss to no light perception vision"
                            },
                            {
                              "label": "visual field loss"
                            }
                          ]
                        },
                        {
                          "label": "sudden expansion of the tumor into the adjacent cavernous sinuses"
                        }
                      ]
                    },
                    {
                      "label": "treatment",
                      "children": [
                        {
                          "label": "recognition of pituitary apoplexy is crucial",
                          "children": [
                            {
                              "label": "potentially life-threatening!"
                            }
                          ]
                        },
                        {
                          "label": "immediate administration of corticosteroids"
                        },
                        {
                          "label": "appropriate supportive measures",
                          "children": [
                            {
                              "label": "surgical decompression of the sella",
                              "children": [
                                {
                                  "label": "conservative management when neuro- ophthalmic signs are absent or mild"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "parasellar meningioma",
              "children": [
                {
                  "label": "middle-aged women"
                },
                {
                  "label": "arise most frequently from the tuberculum sella, planum sphenoidale, or anterior clinoid"
                },
                {
                  "label": "asymmetric bitemporal vision loss"
                },
                {
                  "label": "may enlarge and produce chiasmal compression during pregnancy"
                }
              ]
            },
            {
              "label": "craniopharyngioma",
              "children": [
                {
                  "label": "may present at any age",
                  "children": [
                    {
                      "label": "second incidence peak in adulthood"
                    }
                  ]
                },
                {
                  "label": "arise superiorly",
                  "children": [
                    {
                      "label": "produce inferior bitemporal visual field loss",
                      "children": [
                        {
                          "label": "unlike pituitary tumors"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "parasellar internal carotid artery aneurysm",
              "children": [
                {
                  "label": "markedly asymmetric chiasmal syndrome"
                },
                {
                  "label": "optic nerve compression on the side of the aneurysm"
                }
              ]
            },
            {
              "label": "other CNS mass lesions",
              "children": [
                {
                  "label": "third-ventricle dilation",
                  "children": [
                    {
                      "label": "secondary posterior chiasmal compression"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "visual field and visual acuity testing",
              "children": [
                {
                  "label": "2–3 months after treatment (baseline)"
                },
                {
                  "label": "repeat at intervals of 6–12 months"
                }
              ]
            },
            {
              "label": "periodic neuroimaging"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "methods",
              "children": [
                {
                  "label": "observation only",
                  "children": [
                    {
                      "label": "if visual fields are normal"
                    }
                  ]
                },
                {
                  "label": "surgery (transfrontal or transsphenoidal)",
                  "children": [
                    {
                      "label": "vision recovery is usually rapid",
                      "children": [
                        {
                          "label": "within 24 hours"
                        }
                      ]
                    },
                    {
                      "label": "vision recovery may be dramatic, even with severe vision loss",
                      "children": [
                        {
                          "label": "mean retinal nerve fiber layer thickness <75 μm is associated with poor visual prognosis"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "medical therapy",
                  "children": [
                    {
                      "label": "has a slower effect",
                      "children": [
                        {
                          "label": "bromocriptine or cabergoline for prolactin- secreting pituitary tumors"
                        },
                        {
                          "label": "days to weeks"
                        }
                      ]
                    },
                    {
                      "label": "produces tumor shrinkage and improved visual function in responsive cases"
                    }
                  ]
                },
                {
                  "label": "radiation therapy",
                  "children": [
                    {
                      "label": "primary or as adjunctive therapy for incompletely resectable tumors",
                      "children": [
                        {
                          "label": "tumor recurrence",
                          "children": [
                            {
                              "label": "the first sign of recurrence may be vision loss"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "delayed vision loss after therapy for parasellar lesions",
              "children": [
                {
                  "label": "delayed radionecrosis of the chiasm or optic nerves"
                },
                {
                  "label": "chiasmal distortion due to adhesions or secondary empty sella syndrome, with descent and traction on the chiasm"
                },
                {
                  "label": "chiasmal compression from expansion of intraoperative overpacking of the sella with fat"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "common in children"
    },
    {
      "label": "Intrinsic lesions affecting the chiasm",
      "children": [
        {
          "label": "infectious (eg, tuberculosis, Lyme disease)"
        },
        {
          "label": "inflammatory (eg, sarcoidosis, multiple sclerosis)"
        },
        {
          "label": "neoplasms can be either primary (eg, glioma) or secondary (eg, metastasis)"
        },
        {
          "label": "significant closed-head trauma"
        },
        {
          "label": "parasellar radiation therapy"
        }
      ]
    }
