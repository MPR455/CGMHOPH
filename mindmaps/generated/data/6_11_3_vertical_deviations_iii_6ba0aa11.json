{
  "label": "6.11.3. Vertical Deviations (III)",
  "root": true,
  "children": [
    {
      "label": "Dissociated Vertical Deviation (DVD)",
      "children": [
        {
          "label": "innervational disorder",
          "children": [
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "50% of patients with infantile strabismus (esotropia or exotropia)"
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "<2 years"
            },
            {
              "label": "usually bilateral",
              "children": [
                {
                  "label": "frequently asymmetric"
                }
              ]
            },
            {
              "label": "occurs whether or not the horizontal deviation has been surgically corrected",
              "children": [
                {
                  "label": "in contrast to see-saw nystagmus in which the elevating eye intorts",
                  "children": [
                    {
                      "label": "in contrast to skew deviation in which the hypertropic eye intorts"
                    }
                  ]
                }
              ]
            },
            {
              "label": "either eye slowly drifts upward and outward, with simultaneous extorsion",
              "children": [
                {
                  "label": "when occluded or during periods of visual inattention"
                },
                {
                  "label": "some patients attempt to compensate by tilting the head"
                },
                {
                  "label": "vertical movement usually predominates"
                },
                {
                  "label": "sometimes abduction predominates",
                  "children": [
                    {
                      "label": "dissociated horizontal deviation (DHD)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "types",
              "children": [
                {
                  "label": "may occur spontaneously (manifest DVD)"
                },
                {
                  "label": "only when 1 eye is occluded (latent DVD)"
                }
              ]
            },
            {
              "label": "associated findings",
              "children": [
                {
                  "label": "latent nystagmus"
                },
                {
                  "label": "horizontal strabismus"
                }
              ]
            },
            {
              "label": "measurement",
              "children": [
                {
                  "label": "occluder technique",
                  "children": [
                    {
                      "label": "place base-down prism in front of upwardly deviating eye while it is behind an occluder"
                    },
                    {
                      "label": "occluder is then switched to fixating lower eye"
                    },
                    {
                      "label": "prism power is adjusted until the deviating eye shows no downward movement to refixate"
                    }
                  ]
                },
                {
                  "label": "red Maddox rod technique",
                  "children": [
                    {
                      "label": "placed in front of dissociated (higher) eye",
                      "children": [
                        {
                          "label": "generates a horizontal line"
                        }
                      ]
                    },
                    {
                      "label": "other eye fixates on a small light"
                    },
                    {
                      "label": "vertical prism power is adjusted to eliminate the separation of the light and the line"
                    }
                  ]
                },
                {
                  "label": "each eye is tested separately in cases of bilateral DVD"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "inferior oblique muscle overaction"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "indications for treatment",
              "children": [
                {
                  "label": "deviation is noticeable",
                  "children": [
                    {
                      "label": ".>6Δ–8Δ"
                    }
                  ]
                },
                {
                  "label": "occurs frequently during the day"
                }
              ]
            },
            {
              "label": "optical penalization",
              "children": [
                {
                  "label": "to change fixation preference"
                },
                {
                  "label": "effective mostly in unilateral or highly asymmetric bilateral DVD"
                }
              ]
            },
            {
              "label": "superior rectus muscle recession",
              "children": [
                {
                  "label": "from 6 to 10 mm"
                },
                {
                  "label": "bilateral surgery whenever both eyes can fixate",
                  "children": [
                    {
                      "label": "asymmetric recessions are an option if DVD is asymmetric"
                    }
                  ]
                },
                {
                  "label": "surgery on vertical muscles often improves the condition but rarely eliminates it"
                }
              ]
            },
            {
              "label": "inferior rectus muscle resection or plication",
              "children": [
                {
                  "label": "for residual DVD after superior rectus muscle recession"
                }
              ]
            },
            {
              "label": "inferior oblique muscle anterior transposition",
              "children": [
                {
                  "label": "especially if it is accompanied by inferior oblique muscle overaction"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Comitant Vertical Tropias",
      "children": [
        {
          "label": "tropia does not change significantly when gaze is shifted from one side to the other"
        },
        {
          "label": "Monocular Elevation Deficiency",
          "children": [
            {
              "label": "limitation of upward gaze with a hypotropia that is similar in adduction and abduction",
              "children": [
                {
                  "label": "\"double-elevator palsy\""
                }
              ]
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "restriction of the inferior rectus muscle"
                },
                {
                  "label": "innervational deficit",
                  "children": [
                    {
                      "label": "weakness of 1 or both elevator muscles"
                    },
                    {
                      "label": "monocular supranuclear gaze disorder"
                    }
                  ]
                },
                {
                  "label": "combination"
                }
              ]
            },
            {
              "label": "clinical features",
              "children": [
                {
                  "label": "hypotropia",
                  "children": [
                    {
                      "label": "increases in upgaze"
                    }
                  ]
                },
                {
                  "label": "chin-up position with fusion in downgaze"
                },
                {
                  "label": "ptosis or pseudoptosis",
                  "children": [
                    {
                      "label": "true ptosis in 50%"
                    },
                    {
                      "label": "If any other feature of third nerve palsy is present, that condition should be suspected"
                    }
                  ]
                },
                {
                  "label": "3 forms",
                  "children": [
                    {
                      "label": "restriction",
                      "children": [
                        {
                          "label": "positive forced duction on elevation"
                        },
                        {
                          "label": "normal elevation force generation and elevation saccadic velocity (no muscle paralysis)"
                        },
                        {
                          "label": "often an extra or deeper lower eyelid fold on attempted upgaze"
                        },
                        {
                          "label": "poor or absent Bell phenomenon"
                        }
                      ]
                    },
                    {
                      "label": "elevator muscle innervational deficit",
                      "children": [
                        {
                          "label": "free forced duction on elevation"
                        },
                        {
                          "label": "reduced elevation force generation and saccadic velocity"
                        },
                        {
                          "label": "preservation of Bell phenomenon (indicating a supranuclear cause) in many cases"
                        }
                      ]
                    },
                    {
                      "label": "combination",
                      "children": [
                        {
                          "label": "positive forced duction on elevation"
                        },
                        {
                          "label": "reduced elevation force generation and saccadic velocity"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "indications for treatment",
                  "children": [
                    {
                      "label": "large vertical deviation in primary position",
                      "children": [
                        {
                          "label": "±ptosis"
                        }
                      ]
                    },
                    {
                      "label": "abnormal chin-up head position"
                    }
                  ]
                },
                {
                  "label": "with restriction",
                  "children": [
                    {
                      "label": "inferior rectus muscle recession",
                      "children": [
                        {
                          "label": "± adjustable suture"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "no restriction",
                  "children": [
                    {
                      "label": "transposition of medial and lateral rectus muscles",
                      "children": [
                        {
                          "label": "Knapp procedure"
                        }
                      ]
                    },
                    {
                      "label": "recess the ipsilateral inferior rectus + either recess the contralateral superior rectus or resect the ipsilateral superior rectus"
                    }
                  ]
                },
                {
                  "label": "ptosis surgery should be deferred until the vertical deviation has been corrected"
                }
              ]
            }
          ]
        },
        {
          "label": "Orbital Floor Fractures",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "muscle entrapment and restriction"
                },
                {
                  "label": "muscle paralysis due to nerve damage"
                }
              ]
            },
            {
              "label": "clinical features",
              "children": [
                {
                  "label": "diplopia in the immediate postinjury stage",
                  "children": [
                    {
                      "label": "not necessarily an indication for urgent intervention",
                      "children": [
                        {
                          "label": "muscle palsy may resolve over several months"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "outcome after fracture repair",
                  "children": [
                    {
                      "label": "range of eye movements may improve"
                    },
                    {
                      "label": "fibrosis may cause restriction to persist even after successful repair of the fracture",
                      "children": [
                        {
                          "label": "partial restriction persists in many cases even though imaging studies may show no residual entrapment"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "indications for surgery",
                  "children": [
                    {
                      "label": "diplopia in primary position or downgaze"
                    },
                    {
                      "label": "compensatory head position"
                    }
                  ]
                },
                {
                  "label": "mild limitation of eye movements",
                  "children": [
                    {
                      "label": "prisms"
                    }
                  ]
                },
                {
                  "label": "nonresolving hypotropia in primary position",
                  "children": [
                    {
                      "label": "especially if the muscle is tight on forced- duction testing",
                      "children": [
                        {
                          "label": "recession of the ipsilateral inferior rectus muscle"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "nonresolving esotropia in primary position",
                  "children": [
                    {
                      "label": "especially if the muscle is tight on forced- duction testing",
                      "children": [
                        {
                          "label": "recession of the ipsilateral medial rectus muscle"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "hypertropia due to weakness of inferior rectus muscle without entrapment",
                  "children": [
                    {
                      "label": "observation",
                      "children": [
                        {
                          "label": "weakness may improve with time"
                        }
                      ]
                    },
                    {
                      "label": "indications for surgery",
                      "children": [
                        {
                          "label": "recovery is not complete within 6–12 months"
                        },
                        {
                          "label": "there is at least a moderate degree of active force"
                        }
                      ]
                    },
                    {
                      "label": "resection of inferior rectus muscle"
                    },
                    {
                      "label": "if hypertropia is large",
                      "children": [
                        {
                          "label": "inferior rectus muscle resection + recession of ipsilateral superior rectus muscle"
                        }
                      ]
                    },
                    {
                      "label": "procedures to limit fellow eye’s downgaze movement and match the duction deficiency of the injured eye",
                      "children": [
                        {
                          "label": "recession of the contralateral inferior rectus muscle",
                          "children": [
                            {
                              "label": "with or without the addition of a posterior fixation suture",
                              "children": [
                                {
                                  "label": "fadenoperation"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "combined recession and resection of the contralateral inferior rectus muscle"
                        }
                      ]
                    },
                    {
                      "label": "complete chronic inferior rectus muscle palsy",
                      "children": [
                        {
                          "label": "transposition of ipsilateral medial and lateral rectus muscles to inferior rectus muscle",
                          "children": [
                            {
                              "label": "inverse Knapp procedure"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Other Comitant Vertical Tropias (Hypertropias)",
          "children": [
            {
              "label": "innervational problems",
              "children": [
                {
                  "label": "superior division (partial) palsy of the third cranial nerve"
                }
              ]
            },
            {
              "label": "mechanical disorders",
              "children": [
                {
                  "label": "thyroid eye disease"
                },
                {
                  "label": "congenital fibrosis of extraocular muscles"
                }
              ]
            },
            {
              "label": "orbital tumors"
            },
            {
              "label": "long-standing superior oblique palsy",
              "children": [
                {
                  "label": "may develop spread of comitance"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
