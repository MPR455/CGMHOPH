{
  "label": "10.6.4. Childhood Glaucoma (IV): Surgical Management",
  "root": true,
  "children": [
    {
      "label": "glaucoma surgery in children poses unique difficulties",
      "children": [
        {
          "label": "surgery is the preferred definitive therapy for PCG"
        },
        {
          "label": "anatomical landmarks are distorted in buphthalmic eye"
        },
        {
          "label": "thin sclera"
        }
      ]
    },
    {
      "label": "decision to proceed with angle surgery is often made during an EUA",
      "children": [
        {
          "label": "if glaucoma is diagnosed, angle surgery should be performed during the same anesthesia session"
        },
        {
          "label": "if angle surgery is anticipated, it is best not to dilate the eye during the EUA to protect the lens"
        }
      ]
    },
    {
      "label": "trabeculectomy",
      "children": [
        {
          "label": "low success rate <2 years and in aphakic eyes",
          "children": [
            {
              "label": "bleb scarring/failure common without antifibrotics"
            },
            {
              "label": "serious risks of bleb leak/infection with antifibrotics",
              "children": [
                {
                  "label": "mitomycin C should be used with caution in the pediatric patient",
                  "children": [
                    {
                      "label": "until the child is old enough to understand good hygiene"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "trabeculectomy & glaucoma drainage device should be considered when",
          "children": [
            {
              "label": "2 or more angle surgeries are not successful",
              "children": [
                {
                  "label": "adjunctive medical therapy is inadequate"
                }
              ]
            },
            {
              "label": "forms of glaucoma other than PCG",
              "children": [
                {
                  "label": "angle surgery is often successful in aphakic glaucoma and in new onset of glaucoma in aniridia"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "glaucoma drainage device",
      "children": [
        {
          "label": "avoid the risk of bleb-related infections"
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "anterior migration of the drainage device with resultant corneal damage"
            },
            {
              "label": "tube blockage"
            },
            {
              "label": "cataract"
            },
            {
              "label": "motility disturbances"
            },
            {
              "label": "bleb encapsulation with elevated IOP"
            },
            {
              "label": "pupil distortion"
            }
          ]
        },
        {
          "label": "IOPs are usually higher than after trabeculectomy",
          "children": [
            {
              "label": "most children will need to continue topical glaucoma medications"
            }
          ]
        }
      ]
    },
    {
      "label": "angle surgery",
      "children": [
        {
          "label": "goniotomy",
          "children": [
            {
              "label": "clear cornea"
            },
            {
              "label": "angle is visualized with a surgical gonioscopic contact lens"
            },
            {
              "label": "needle knife"
            },
            {
              "label": "superficial incision is made in the uveal trabecular meshwork"
            },
            {
              "label": "advantages",
              "children": [
                {
                  "label": "no postoperative conjunctival scarring"
                },
                {
                  "label": "faster"
                },
                {
                  "label": "less trauma to the anterior segment tissues"
                }
              ]
            }
          ]
        },
        {
          "label": "trabeculotomy ab externo",
          "children": [
            {
              "label": "clear or cloudy cornea"
            },
            {
              "label": "conjunctival flap"
            },
            {
              "label": "partial-thickness scleral flap",
              "children": [
                {
                  "label": "OR",
                  "children": [
                    {
                      "label": "radial incision into the sclera"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Schlemm canal is cannulated from an ab externo approach",
              "children": [
                {
                  "label": "fine wirelike instrument (trabeculotome)"
                },
                {
                  "label": "6-0 nonabsorbable polypropylene suture (Prolene)",
                  "children": [
                    {
                      "label": "for 360°"
                    }
                  ]
                }
              ]
            },
            {
              "label": "trabecular meshwork is opened by breaking through the Schlemn canal into the anterior chamber"
            },
            {
              "label": "avoid creating a false passage or entering the subretinal or suprachoroidal spaces"
            },
            {
              "label": "fill the anterior chamber with viscoelastic at the start of goniotomy and trabeculotomy",
              "children": [
                {
                  "label": "thorough removal of the viscoelastic at the end of the procedure is necessary"
                }
              ]
            },
            {
              "label": "advantages",
              "children": [
                {
                  "label": "more familiar to surgeons experienced in adult glaucoma procedures"
                },
                {
                  "label": "can be performed in an opacified cornea"
                },
                {
                  "label": "can be converted to a trabeculectomy if the Schlemm canal cannot be cannulated"
                }
              ]
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "hyphema"
            },
            {
              "label": "infection"
            },
            {
              "label": "lens damage"
            },
            {
              "label": "uveitis"
            },
            {
              "label": "Descemet membrane may be stripped during trabeculotomy"
            },
            {
              "label": "general anesthesia may cause serious complications in children",
              "children": [
                {
                  "label": "bilateral procedures are performed in some children"
                }
              ]
            }
          ]
        },
        {
          "label": "may also be used to treat other forms of childhood glaucoma",
          "children": [
            {
              "label": "aniridia"
            },
            {
              "label": "Axenfeld-Rieger syndrome"
            },
            {
              "label": "Sturge-Weber syndrome"
            }
          ]
        },
        {
          "label": "successful in 70%–80% of infants with PCG who present between 3 months and 1 year of age",
          "children": [
            {
              "label": "a second procedure may be required"
            }
          ]
        }
      ]
    },
    {
      "label": "cyclophotocoagulation",
      "children": [
        {
          "label": "cases refractory to other surgical and medical treatments",
          "children": [
            {
              "label": "useful for providing additional IOP lowering after glaucoma drainage device surgery"
            }
          ]
        },
        {
          "label": "general anesthesia"
        },
        {
          "label": "techniques",
          "children": [
            {
              "label": "cyclocryotherapy"
            },
            {
              "label": "transscleral cyclophotocoagulation (CPC) with (Nd:YAG) or diode laser"
            },
            {
              "label": "endoscopic cyclophotocoagulation (ECP)",
              "children": [
                {
                  "label": "particularly useful in eyes with",
                  "children": [
                    {
                      "label": "distorted anterior segment anatomy"
                    },
                    {
                      "label": "prior unsuccessful CPC or cryotherapy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "disadvantages",
          "children": [
            {
              "label": "difficult to titrate the results"
            },
            {
              "label": "serious potential complications",
              "children": [
                {
                  "label": "hypotony",
                  "children": [
                    {
                      "label": "phthisis"
                    }
                  ]
                },
                {
                  "label": "uveitis"
                },
                {
                  "label": "blindness"
                },
                {
                  "label": "rate of complications is lower with laser procedures than with cryotherapy"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
