    },
    {
      "label": "Neuroretinitis",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "acute loss of vision associated with disc edema and a star pattern of exudates in the macula"
            },
            {
              "label": "diffuse disc edema",
              "children": [
                {
                  "label": "spreads through the outer plexiform layer along the papillomacular bundle and around the fovea"
                },
                {
                  "label": "as the fluid resorbs, lipid precipitates in a characteristic radial pattern in Henle layer",
                  "children": [
                    {
                      "label": "macular star",
                      "children": [
                        {
                          "label": "can appear at initial presentation or several days later"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "± mild vitritis"
            },
            {
              "label": "± choroidal lesions"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "patients with neuroretinitis do not have an increased risk of multiple sclerosis"
            },
            {
              "label": "cat scratch disease",
              "children": [
                {
                  "label": "most common cause of neuroretinitis"
                },
                {
                  "label": "elevated IgM titers for Bartonella quintana or B henselae"
                },
                {
                  "label": "no definitive evidence exists that corticosteroids and antibiotics reduce the impact of ocular bartonellosis causing neuroretinitis"
                }
              ]
            },
            {
              "label": "toxoplasmosis"
            },
            {
              "label": "tuberculosis"
            },
            {
              "label": "syphilis"
            },
            {
              "label": "sarcoidosis"
            },
            {
              "label": "Lyme disease"
            },
            {
              "label": "viruses"
            }
          ]
        },
        {
          "label": "serologic testing for specific infections should be considered"
        }
      ]
    },
    {
