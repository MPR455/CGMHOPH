{
  "label": "5.9.2. Nystagmus (II): Early-Onset",
  "root": true,
  "children": [
    {
      "label": "Monocular Nystagmus of Childhood",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "early in life"
            },
            {
              "label": "eye movements are usually in the same eye at all times"
            },
            {
              "label": "vertical/elliptical"
            },
            {
              "label": "small amplitude"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "monocular vertical nystagmus in an infant is suggestive of an optic nerve or chiasmal tumor (glioma)",
              "children": [
                {
                  "label": "often in concert with an afferent pupillary defect and optic atrophy",
                  "children": [
                    {
                      "label": "rule out!"
                    }
                  ]
                },
                {
                  "label": "neuroimaging is warranted in an infant with monocular vertical nystagmus"
                },
                {
                  "label": "± monocular"
                }
              ]
            },
            {
              "label": "Heimann-Bielschowsky phenomenon",
              "children": [
                {
                  "label": "monocular nystagmus in an eye with longstanding poor vision",
                  "children": [
                    {
                      "label": "optic neuropathy"
                    },
                    {
                      "label": "amblyopia"
                    }
                  ]
                },
                {
                  "label": "may become manifest in adults with highly asymmetric vision loss",
                  "children": [
                    {
                      "label": "may not remit even if the visual problem (eg, dense cataract) is corrected"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Infantile Nystagmus Syndrome (INS)/ Congenital Nystagmus (CN)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "± family history",
              "children": [
                {
                  "label": "onset in first few months of life",
                  "children": [
                    {
                      "label": "may not become evident until several years of age"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "no oscillopsia"
            },
            {
              "label": "conjugate"
            },
            {
              "label": "horizontal",
              "children": [
                {
                  "label": "remains horizontal in upgaze and downgaze"
                },
                {
                  "label": "jerk or pendular",
                  "children": [
                    {
                      "label": "depending on position of gaze"
                    }
                  ]
                }
              ]
            },
            {
              "label": "continuous or intermittent"
            },
            {
              "label": "accentuation by visual attention & distant fixation"
            },
            {
              "label": "diminishment by convergence"
            },
            {
              "label": "abolished in sleep"
            },
            {
              "label": "slow phase in the direction opposite that of a rotating optokinetic drum",
              "children": [
                {
                  "label": "reversal of normal pattern!",
                  "children": [
                    {
                      "label": "unlike peripheral vestibular nystagmus"
                    },
                    {
                      "label": "in contrast to constant velocity slow phase of latent nystagmus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "exponential increasing velocity of slow phase with distance from fixation",
              "children": [
                {
                  "label": "requires eye movement recordings"
                }
              ]
            },
            {
              "label": "there is frequently a null point",
              "children": [
                {
                  "label": "field of gaze in which nystagmus intensity is minimal"
                },
                {
                  "label": "head turn or posture",
                  "children": [
                    {
                      "label": "if the null point is not in primary position"
                    }
                  ]
                }
              ]
            },
            {
              "label": "strabismus",
              "children": [
                {
                  "label": "15%"
                }
              ]
            },
            {
              "label": "not associated with afferent pathway disease",
              "children": [
                {
                  "label": "visual acuity is proportional to the foveation period"
                }
              ]
            }
          ]
        },
        {
          "label": "sensory nystagmus",
          "children": [
            {
              "label": "central visual acuity is too poor to develop a stable fixational mechanism"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "ocular albinism"
                },
                {
                  "label": "achromatopsia"
                },
                {
                  "label": "leber congenital amaurosis"
                },
                {
                  "label": "aniridia"
                }
              ]
            },
            {
              "label": "in any patient with early-onset nystagmus look for evidence of damage to the visual pathways",
              "children": [
                {
                  "label": "impairment of visual tracking"
                },
                {
                  "label": "optic atrophy"
                },
                {
                  "label": "presence of such abnormalities should prompt neuroimaging"
                },
                {
                  "label": "electrophysiologic testing (ERG, VEP) is warranted"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "INS is jerk or pendular",
      "children": [
        {
          "label": "depending on position of gaze"
        }
      ]
    },
    {
      "label": "Spasmus Nutans",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "African American ethnicity"
            },
            {
              "label": "Hispanic ethnicity"
            },
            {
              "label": "low socioeconomic status"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "develops in the first year of life",
              "children": [
                {
                  "label": "spontaneous resolution of abnormal eye and head movements after several years"
                }
              ]
            },
            {
              "label": "nystagmus",
              "children": [
                {
                  "label": "intermittent"
                },
                {
                  "label": "binocular",
                  "children": [
                    {
                      "label": "± dissociated",
                      "children": [
                        {
                          "label": "amplitude and phase relationships may frequently vary between the eyes"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "very small amplitude",
                  "children": [
                    {
                      "label": "different amplitudes"
                    }
                  ]
                },
                {
                  "label": "high-frequency"
                },
                {
                  "label": "horizontal",
                  "children": [
                    {
                      "label": "± vertical"
                    }
                  ]
                },
                {
                  "label": "head nodding",
                  "children": [
                    {
                      "label": "pendular"
                    },
                    {
                      "label": "often subtle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "± strabismus",
              "children": [
                {
                  "label": "abnormal head posture/torticollis"
                }
              ]
            },
            {
              "label": "± amblyopia"
            },
            {
              "label": "benign disorder",
              "children": [
                {
                  "label": "patients generally have no other neurologic abnormalities"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "distinguished from INS by",
              "children": [
                {
                  "label": "relatively high frequency of eye movements"
                },
                {
                  "label": "abnormal head movements"
                },
                {
                  "label": "head posture",
                  "children": [
                    {
                      "label": "patient's with INS can have null point and head turn/posture",
                      "children": [
                        {
                          "label": "INS can be continuous or intermittent"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "intermittent and variable nature of the nystagmus"
                }
              ]
            },
            {
              "label": "nystagmus of spasmus nutans is sometimes monocular"
            },
            {
              "label": "spasmus nutans–like syndrome with retinal dystrophies",
              "children": [
                {
                  "label": "e.g. congenital stationary night blindness"
                },
                {
                  "label": "electroretinographic studies"
                }
              ]
            }
          ]
        },
        {
          "label": "indications for neuroimaging",
          "children": [
            {
              "label": "impossible to distinguish from the more ominous conditions of monocular nystagmus of childhood",
              "children": [
                {
                  "label": "patients with presumed (monocular) spasmus nutans should undergo neuroimaging"
                }
              ]
            },
            {
              "label": "lack of the expected resolution of spasmus nutans"
            },
            {
              "label": "development of any other neurologic problems"
            }
          ]
        }
      ]
    },
    {
      "label": "Fusional Maldevelopment Nystagmus Syndrome (Latent Nystagmus)",
      "children": [
        {
          "label": "clinical characteristics",
          "children": [
            {
              "label": "begins (or accentuates) when binocular viewing is disrupted",
              "children": [
                {
                  "label": "use of a standard occluder degrades visual acuity",
                  "children": [
                    {
                      "label": "partial optical blurring of 1 eye permits better visual acuity measurements",
                      "children": [
                        {
                          "label": "high-plus lens or filter"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "early-onset"
            },
            {
              "label": "conjugate horizontal jerk nystagmus",
              "children": [
                {
                  "label": "constant-velocity slow phase",
                  "children": [
                    {
                      "label": "in contrast to the increasing exponential slow phase of INS/CN"
                    }
                  ]
                }
              ]
            },
            {
              "label": "direction changing with monocular occlusion",
              "children": [
                {
                  "label": "fast phase toward the viewing eye; slow phase toward the nose/occluded eye",
                  "children": [
                    {
                      "label": "both slow phase and eye are toward nose (occluded eye)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "subnormal stereopsis"
            },
            {
              "label": "may coexist with INS"
            },
            {
              "label": "frequently, with dissociated vertical deviation",
              "children": [
                {
                  "label": "almost always associated with esotropia",
                  "children": [
                    {
                      "label": "nystagmus spontaneously and intermittently develops whenever the esotropic eye is physiologically suppressed"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "manifest latent nystagmus (MLN)",
          "children": [
            {
              "label": "nystagmus with characteristics of LN that is present when both eyes are open"
            }
          ]
        },
        {
          "label": "LN and MLN are benign entities"
        }
      ]
    }
  ],
