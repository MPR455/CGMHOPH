                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "endemic to Europe, Australia, Asia, and Africa"
            },
            {
              "label": "peak onset in late summer",
              "children": [
                {
                  "label": "anytime between July and December"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic manifestations",
          "children": [
            {
              "label": "incubation period 3-14 days",
