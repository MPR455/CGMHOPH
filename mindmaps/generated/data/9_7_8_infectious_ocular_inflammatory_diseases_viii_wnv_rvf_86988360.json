{
  "label": "9.7.8. Infectious Ocular Inflammatory Diseases (VIII): WNV & RVF",
  "root": true,
  "children": [
    {
      "label": "Similar to measles, rubella, and LCMV"
    },
    {
      "label": "Rift Valley fever (RVF)",
      "children": [
        {
          "label": "arthropod-borne Bunyaviridae of the Phlebovirus genus"
        },
        {
          "label": "epizootic",
          "children": [
            {
              "label": "primarily affecting domestic animals (sheep, goats, camels, and cattle)"
            },
            {
              "label": "transmitted to humans",
              "children": [
                {
                  "label": "direct contact with the blood or organs of infected animals"
                },
                {
                  "label": "inhalation of aerosols released during their slaughter"
                },
                {
                  "label": "ingesting the unpasteurized milk of infected animals"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "incubation period",
              "children": [
                {
                  "label": "3-7 days",
                  "children": [
                    {
                      "label": "bites from infected mosquitoes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "3 clinical syndromes",
              "children": [
                {
                  "label": "uncomplicated, febrile, influenza-like illness"
                },
                {
                  "label": "hemorrhagic fever"
                },
                {
                  "label": "neurologic involvement with encephalitis",
                  "children": [
                    {
                      "label": "mortality rate of 1%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "ocular manifestations",
              "children": [
                {
                  "label": "20%"
                },
                {
                  "label": "bilateral"
                },
                {
                  "label": "profoundly reduced visual acuity at presentation",
                  "children": [
                    {
                      "label": "<20/200 in 80%"
                    }
                  ]
                },
                {
                  "label": "macular or paramacular retinitis",
                  "children": [
                    {
                      "label": "similar to SSPE"
                    },
                    {
                      "label": "in all affected eyes at the time of initial presentation"
                    }
                  ]
                },
                {
                  "label": "additional manifestations",
                  "children": [
                    {
                      "label": "intraretinal hemorrhages (40%)"
                    },
                    {
                      "label": "vitritis (26%)"
                    },
                    {
                      "label": "optic nerve edema (15%)"
                    },
                    {
                      "label": "retinal vasculitis (7%)"
                    },
                    {
                      "label": "anterior uveitis (31%)"
                    }
                  ]
                },
                {
                  "label": "spontaneous resolution",
                  "children": [
                    {
                      "label": "within 10–12 weeks"
                    },
                    {
                      "label": "optic atrophy"
                    },
                    {
                      "label": "ischemic retina"
                    },
                    {
                      "label": "macular (60%) or paramacular (9%) scarring"
                    },
                    {
                      "label": "retinal vascular occlusion (23%)"
                    },
                    {
                      "label": "optic atrophy (20%)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "FA",
          "children": [
            {
              "label": "delayed filling of the retinal and choroidal circulation"
            },
            {
              "label": "early hypofluorescence and late staining of the inflammatory retinal lesions"
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "serology",
              "children": [
                {
                  "label": "IgM in a single serum sample"
                },
                {
                  "label": "rising IgG titer in samples from acutely ill and convalescent patients"
                }
              ]
            },
            {
              "label": "virus isolation from the blood in the acute phase"
            },
            {
              "label": "virus detection in either serum or tissue by reverse transcription PCR testing"
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "other viral entities",
              "children": [
                {
                  "label": "measles, rubella, influenza, dengue fever, and WNV"
                }
              ]
            },
            {
              "label": "bacterial illnesses",
              "children": [
                {
                  "label": "brucellosis"
                },
                {
                  "label": "Lyme disease"
                },
                {
                  "label": "toxoplasmosis"
                },
                {
                  "label": "cat-scratch disease"
                },
                {
                  "label": "rickettsial diseases"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "anterior uveitis",
              "children": [
                {
                  "label": "topical steroids"
                }
              ]
            },
            {
              "label": "inactivated vaccine",
              "children": [
                {
                  "label": "role of systemic antiviral and anti-inflammatory therapy for retinal manifestations of RVF is unknown"
