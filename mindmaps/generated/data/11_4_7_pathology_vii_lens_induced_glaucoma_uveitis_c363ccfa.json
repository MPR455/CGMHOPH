          "label": "intumescent cataractous lens"
        },
        {
          "label": "secondary angle-closure glaucoma",
          "children": [
            {
              "label": "pupillary block"
            },
            {
              "label": "direct shallowing of the anterior chamber"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "red, painful eye"
            },
            {
              "label": "closed anterior chamber angle"
            },
            {
              "label": "+- corneal edema"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "antiglaucoma medications"
            },
            {
              "label": "laser iridotomy"
            },
            {
              "label": "cataract extraction"
            }
          ]
        }
      ]
