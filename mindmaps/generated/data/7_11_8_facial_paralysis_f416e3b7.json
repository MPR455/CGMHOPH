{
  "label": "7.11.8. Facial Paralysis",
  "root": true,
  "children": [
    {
      "label": "Upper Eyelid Paralysis",
      "children": [
        {
          "label": "placement of a weight in upper eyelid",
          "children": [
            {
              "label": "most commonly performed procedure for treatment of paralytic lagophthalmos"
            },
            {
              "label": "preoperative taping of gold weights of different sizes to the upper eyelid skin",
              "children": [
                {
                  "label": "aim for adequate relaxed eyelid closure with minimal eyelid ptosis in primary gaze"
                }
              ]
            },
            {
              "label": "technique",
              "children": [
                {
                  "label": "upper eyelid crease incision through skin and orbicularis muscle"
                },
                {
                  "label": "gold weight is sutured to anterior surface of tarsal plate"
                },
                {
                  "label": "average weight, 0.8–1.6 g"
                },
                {
                  "label": "weight can be easily removed"
                },
                {
                  "label": "1.2–2.2-g gold weight can also be placed behind the orbital septum, superior to the tarsus",
                  "children": [
                    {
                      "label": "to avoid thickening of the pretarsal area if cosmesis is a concern"
                    }
                  ]
                },
                {
                  "label": "platinum weight"
                },
                {
                  "label": "implanted eyelid springs",
                  "children": [
                    {
                      "label": "long-term extrusion"
                    },
                    {
                      "label": "provide dynamic eyelid closure"
                    }
                  ]
                },
                {
                  "label": "reduces but does not usually eliminate lagophthalmos and corneal exposure"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Paralytic Ectropion",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "CN VII paralysis or palsy"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "lower eyelid ectropion"
            },
            {
              "label": "upper eyelid lagophthalmos",
              "children": [
                {
                  "label": "corneal exposure"
                }
              ]
            },
            {
              "label": "poor blinking",
              "children": [
                {
                  "label": "poor tear film replenishment and distribution"
                },
                {
                  "label": "lacrimal pump failure"
                }
              ]
            },
            {
              "label": "chronic ocular surface irritation",
              "children": [
                {
                  "label": "reflex tearing"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "neurologic evaluation may be indicated"
            },
            {
              "label": "evaluate corneal sensation",
              "children": [
                {
                  "label": "neurotrophic keratitis combined with paralytic lagophthalmos results in increased risk of corneal decompensation",
                  "children": [
                    {
                      "label": "stroke"
                    },
                    {
                      "label": "intracranial surgery"
                    }
                  ]
                }
              ]
            },
            {
              "label": "temporary paralysis",
              "children": [
                {
                  "label": "lubricating drops"
                },
                {
                  "label": "viscous tear supplementation/ointments"
                },
                {
                  "label": "taping of the temporal half of the lower eyelid"
                },
                {
                  "label": "moisture chambers"
                },
                {
                  "label": "temporary tarsorrhaphy",
                  "children": [
                    {
                      "label": "1–3 weeks"
                    },
                    {
                      "label": "nonabsorbable sutures between the upper and lower eyelid margins"
                    }
                  ]
                },
                {
                  "label": "injection of botulinum toxin to the levator muscle"
                }
              ]
            },
            {
              "label": "long-term or permanent paralysis",
              "children": [
                {
                  "label": "permanent tarsorrhaphy",
                  "children": [
                    {
                      "label": "medially or laterally"
                    },
                    {
                      "label": "de-epithelialization of the upper and lower eyelid margins, with the lash follicles avoided"
                    },
                    {
                      "label": "absorbable or nonabsorbable sutures are then placed to unite the raw surfaces of the upper and lower eyelids"
                    },
                    {
                      "label": "patients dislike the permanent tarsorrhaphy from a functional and cosmetic perspective",
                      "children": [
                        {
                          "label": "should be avoided, except in patients with recalcitrant corneal disease from exposure"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "medial or lateral canthoplasties"
                },
                {
                  "label": "placement of a gold weight in the upper eyelid"
                },
                {
                  "label": "vertical elevation of the lower eyelid",
                  "children": [
                    {
                      "label": "recession of the lower lid retractors",
                      "children": [
                        {
                          "label": "combined with use of a spacer graft",
                          "children": [
                            {
                              "label": "full-thickness hard-palate mucosal"
                            },
                            {
                              "label": "ear cartilage graft"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "fascia lata or silicone suspension sling of the lower eyelid"
                    }
                  ]
                },
                {
                  "label": "repair of horizontal eyelid laxity (horizontal tightening procedures) or ectropion of the lower lid"
                },
                {
                  "label": "surgical midface elevation"
                }
              ]
            }
          ]
        }
      ]
    }
