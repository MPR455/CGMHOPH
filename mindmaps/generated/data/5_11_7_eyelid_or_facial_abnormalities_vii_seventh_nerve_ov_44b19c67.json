{
  "label": "5.11.7. Eyelid or Facial Abnormalities (VII): Seventh Nerve Overactivity",
  "root": true,
  "children": [
    {
      "label": "Hemifacial spasm",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "episodic spasm that involves the facial musculature"
            },
            {
              "label": "unilateral"
            },
            {
              "label": "few seconds to minutes"
            },
            {
              "label": "begins as intermittent twitching of the orbicularis oculi muscle",
              "children": [
                {
                  "label": "episodes may increase in frequency for weeks-months",
                  "children": [
                    {
                      "label": "then abate for months at a time"
                    }
                  ]
                }
              ]
            },
            {
              "label": "seventh nerve function is usually intact",
              "children": [
                {
                  "label": "over time subtle ipsilateral facial weakness may develop"
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "compression of the seventh nerve root by an aberrant vessel"
            },
            {
              "label": "less commonly (perhaps 1%)",
              "children": [
                {
                  "label": "cerebellopontine angle tumors",
                  "children": [
                    {
                      "label": "MRI of the brain, including the course of the facial nerve, to exclude a compressive lesion"
                    }
                  ]
                },
                {
                  "label": "treatment of choice",
                  "children": [
                    {
                      "label": "previous injury to CN VII"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "botulinum toxin type A",
              "children": [
                {
                  "label": "very effective"
                },
                {
                  "label": "into the periocular and facial muscles"
                },
                {
                  "label": "reinjection every 3–4 months"
                },
                {
                  "label": "responds to lower doses of botulinum toxin than does blepharospasm"
                }
              ]
            },
            {
              "label": "medical treatment",
              "children": [
                {
                  "label": "carbamazepine"
                },
                {
                  "label": "clonazepam"
                },
                {
                  "label": "baclofen"
                },
                {
                  "label": "may provide improvement in some patients"
                }
              ]
            },
            {
              "label": "microvascular decompression",
              "children": [
                {
                  "label": "for advanced cases or younger patients",
                  "children": [
                    {
                      "label": "suboccipital craniectomy with placement of a sponge between the seventh nerve and the offending blood vessel"
                    }
                  ]
                },
                {
                  "label": "may offer a cure"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Essential blepharospasm",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "exact cause unknown"
            },
            {
              "label": "basal ganglia dysfunction"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "onset between 40-60 years"
            },
            {
              "label": "bilateral"
            },
            {
              "label": "episodic contraction of the orbicularis oculi",
              "children": [
                {
                  "label": "initially, mild and infrequent"
                }
              ]
            },
            {
              "label": "stress may exacerbate the condition"
            },
            {
              "label": "psychological distress",
              "children": [
                {
                  "label": "patients withdraw socially as the symptoms worsen",
                  "children": [
                    {
                      "label": "may progress to the point that patient’s daily activities are severely disrupted",
                      "children": [
                        {
                          "label": "patient’s eyelids cannot be pried open during an episode of spasm"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "associated findings",
              "children": [
                {
                  "label": "facial grimacing",
                  "children": [
                    {
                      "label": "Meige syndrome"
                    }
                  ]
                },
                {
                  "label": "cogwheeling in the neck and extremities"
                },
                {
                  "label": "other extrapyramidal signs"
                }
              ]
            },
            {
              "label": "neuroradiologic studies are generally unrevealing and rarely indicated"
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "tardive dyskinesia",
              "children": [
                {
                  "label": "secondary to neuroleptic and antipsychotic drugs",
                  "children": [
                    {
                      "label": "can produce spasms that involve the mouth"
                    }
                  ]
                }
              ]
            },
            {
              "label": "extrapyramidal disorders",
              "children": [
                {
                  "label": "may be accompanied by some degree of blepharospasm"
                }
              ]
            },
            {
              "label": "reflex blepharospasm",
              "children": [
                {
                  "label": "severely dry eyes"
                },
                {
                  "label": "intraocular inflammation"
                },
                {
                  "label": "meningeal irritation (usually associated with photophobia)"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "neuroleptics and benzodiazepines",
              "children": [
                {
                  "label": "limited efficacy"
                }
              ]
            },
            {
              "label": "tinted lenses such as FL-41 tint",
              "children": [
                {
                  "label": "improve blink frequency and light sensitivity"
                }
              ]
            },
            {
              "label": "injection of botulinum toxin type A",
              "children": [
                {
                  "label": "treatment of choice"
                },
                {
                  "label": "into the orbicularis oculi muscle",
                  "children": [
                    {
                      "label": "4–8 injection sites per eye"
                    },
                    {
                      "label": "avoid central portion of the pretarsal orbicularis oculi muscle to minimize ptosis"
                    }
                  ]
                },
                {
                  "label": "lasts only a few months",
                  "children": [
                    {
                      "label": "repeat injections are necessary"
                    }
                  ]
                },
                {
                  "label": "if botulinum toxin type A fails, botulinum toxin type B may be an alternative"
                },
                {
                  "label": "complications",
                  "children": [
                    {
                      "label": "ptosis"
                    },
                    {
                      "label": "local ecchymosis"
                    },
                    {
                      "label": "ectropion"
                    },
                    {
                      "label": "diplopia"
                    },
                    {
                      "label": "lagophthalmos",
                      "children": [
                        {
                          "label": "exposure keratopathy"
                        }
                      ]
                    },
                    {
                      "label": "usually mild and transient"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "surgical therapy",
          "children": [
            {
              "label": "when medical treatment fails"
            },
            {
              "label": "meticulous extirpation of the eyelid protractors"
            },
            {
              "label": "selective ablation of the seventh nerve",
              "children": [
                {
                  "label": "lower success rate"
                },
                {
                  "label": "risk of greater complications"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Spastic paretic facial contracture",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "unilateral facial contracture with associated facial weakness"
        },
        {
          "label": "begins with myokymia of orbicularis oculi muscle",
          "children": [
            {
              "label": "gradually spreads to most of ipsilateral facial muscles"
            }
          ]
        },
        {
          "label": "tonic contracture of the affected muscles becomes evident"
        },
        {
          "label": "over weeks to months, ipsilateral facial weakness develops",
          "children": [
            {
              "label": "voluntary facial movements diminish"
            }
          ]
        },
        {
          "label": "sign of pontine dysfunction in the region of the seventh nerve nucleus",
          "children": [
            {
              "label": "pontine neoplasm"
            },
            {
              "label": "involvement of supranuclear connections leads to facial spasticity"
            },
            {
              "label": "damage to nucleus causes facial weakness"
            }
          ]
        }
      ]
    },
    {
      "label": "Other conditions",
      "children": [
        {
          "label": "focal cortical seizure",
          "children": [
            {
              "label": "gross clonic movements involving 1 side of the face"
            },
            {
              "label": "± ipsilateral clonic hand movements"
            },
            {
              "label": "eyes deviate away from the side of the seizure focus"
            },
            {
              "label": "Todd paralysis",
              "children": [
                {
                  "label": "transient supranuclear facial paresis, follows the seizure"
                }
              ]
            },
            {
              "label": "electroencephalogram",
              "children": [
                {
                  "label": "eyes may deviate toward the side of the prior seizure focus"
                }
              ]
            }
          ]
        },
        {
          "label": "oral facial dyskinesias",
          "children": [
            {
              "label": "tardive dyskinesia"
            },
            {
              "label": "after long-term use of major tranquilizers"
            },
            {
              "label": "may persist even after the drugs are stopped"
            }
          ]
        },
        {
          "label": "habit spasm",
          "children": [
            {
              "label": "stereotyped, repetitive, reproducible facial movements",
              "children": [
                {
                  "label": "facial tic"
                },
                {
                  "label": "nervous twitch"
                }
              ]
            },
            {
              "label": "relatively common, particularly in childhood",
              "children": [
                {
                  "label": "can be promptly inhibited on command"
                }
              ]
            },
            {
              "label": "tend to disappear in time without treatment"
            }
          ]
        },
        {
          "label": "Tourette syndrome",
          "children": [
            {
              "label": "rarely may present with facial twitching alone"
            }
          ]
        }
      ]
    },
    {
      "label": "Facial myokymia",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "continuous unilateral fibrillary or undulating contraction of facial muscle bundles"
            },
            {
              "label": "occasionally, begins within a portion of the orbicularis oculi and spreads to facial muscles"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "intramedullary disease of the pons involving the seventh nerve nucleus or fascicle",
              "children": [
                {
                  "label": "pontine glioma in children"
                },
                {
                  "label": "multiple sclerosis in adults"
                },
                {
                  "label": "Guillain-Barré syndrome",
                  "children": [
                    {
                      "label": "rarely"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "carbamazepine"
            },
            {
              "label": "phenytoin sodium"
            },
            {
              "label": "injection of botulinum toxin"
            }
          ]
        },
        {
          "label": "benign eyelid fasciculations",
          "children": [
            {
              "label": "Intermittent fluttering of the orbicularis oculi"
            },
            {
              "label": "relatively common"
            },
            {
              "label": "usually lasts for days or weeks"
            }
          ]
        }
      ]
    },
    {
      "label": "repetitive, stereotyped, involuntary movements and vocalizations called tics"
    }
  ],
