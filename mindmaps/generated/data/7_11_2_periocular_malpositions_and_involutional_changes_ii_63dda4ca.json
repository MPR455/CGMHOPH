{
  "label": "7.11.2. Periocular Malpositions and Involutional Changes (II)",
  "root": true,
  "children": [
    {
      "label": "Symblepharon",
      "children": [
        {
          "label": "adhesion between conjunctival surfaces"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "localized linear adhesions",
              "children": [
                {
                  "label": "conjunctival Z-plasties",
                  "children": [
                    {
                      "label": "when vertical lengthening of the involved tissue is the primary objective"
                    }
                  ]
                }
              ]
            },
            {
              "label": "extensive adhesions",
              "children": [
                {
                  "label": "full-thickness conjunctival graft or flap"
                },
                {
                  "label": "partial-thickness buccal mucous membrane graft"
                },
                {
                  "label": "amniotic membrane graft"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Eyelid Retraction",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "upper eyelid is displaced superiorly or the lower eyelid inferiorly",
              "children": [
                {
                  "label": "exposes sclera between the limbus and the eyelid margin"
                }
              ]
            },
            {
              "label": "lagophthalmos"
            },
            {
              "label": "exposure keratitis"
            },
            {
              "label": "ocular irritation and discomfort"
            },
            {
              "label": "vision-threatening corneal decompensation"
            }
          ]
        },
        {
          "label": "lower eyelid retraction",
          "children": [
            {
              "label": "may be a normal anatomical variant in patients with shallow orbits"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "thyroid eye disease (TED)",
              "children": [
                {
                  "label": "most common cause of both upper and lower eyelid retraction"
                },
                {
                  "label": "most common cause of unilateral or bilateral proptosis",
                  "children": [
                    {
                      "label": "proptosis commonly coexists with and may mimic eyelid retraction"
                    }
                  ]
                },
                {
                  "label": "temporal flare",
                  "children": [
                    {
                      "label": "eyelid retraction is more severe laterally than medially"
                    }
                  ]
                },
                {
                  "label": "histology",
                  "children": [
                    {
                      "label": "inflammatory infiltration and fibrous contraction of the eyelid retractors",
                      "children": [
                        {
                          "label": "sympathetically innervated eyelid retractor muscles are preferentially affected",
                          "children": [
                            {
                              "label": "abnormal upper eyelid contour that appears to flare upward along the lateral half of the eyelid margin"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "recession of the vertical rectus muscles",
              "children": [
                {
                  "label": "anatomical connections between the superior (inferior) rectus and levator muscles in upper eyelid (capsulopalpebral fascia in lower eyelid)"
                }
              ]
            },
            {
              "label": "cosmetic lower blepharoplasty",
              "children": [
                {
                  "label": "pathogenesis",
                  "children": [
                    {
                      "label": "excessive skin resection in blepharoplasty"
                    },
                    {
                      "label": "middle lamellar scarring"
                    },
                    {
                      "label": "untreated lower eyelid laxity"
                    }
                  ]
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "midface-lifting"
                    },
                    {
                      "label": "full-thickness skin grafting"
                    },
                    {
                      "label": "spacer grafting"
                    }
                  ]
                }
              ]
            },
            {
              "label": "overcompensation for a contralateral ptosis",
              "children": [
                {
                  "label": "observe the position of the supposedly retracted eyelid while the contralateral eyelid is manually elevated or occluded"
                }
              ]
            },
            {
              "label": "Parinaud syndrome",
              "children": [
                {
                  "label": "eyelid retraction caused by a central nervous system lesion"
                }
              ]
            },
            {
              "label": "congenital eyelid retraction",
              "children": [
                {
                  "label": "rare, isolated entity"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "corneal lubrication",
              "children": [
                {
                  "label": "for mild eyelid retraction"
                },
                {
                  "label": "mild eyelid retraction following lower blepharoplasty or in TED often resolves spontaneously with time"
                }
              ]
            },
            {
              "label": "surgical intervention",
              "children": [
                {
                  "label": "indications",
                  "children": [
                    {
                      "label": "persistent eyelid retraction"
                    },
                    {
                      "label": "immediate threat to vision or cornea"
                    }
                  ]
                },
                {
                  "label": "indicated only after serial measurements have established stability of the disease over at least 6 months"
                },
                {
                  "label": "upper eyelid retraction",
                  "children": [
                    {
                      "label": "excision or recession of the Müller muscle"
                    },
                    {
                      "label": "recession of the levator aponeurosis",
                      "children": [
                        {
                          "label": "± hang-back sutures"
                        },
                        {
                          "label": "± spacer graft",
                          "children": [
                            {
                              "label": "fascia lata"
                            },
                            {
                              "label": "donor sclera"
                            },
                            {
                              "label": "ear cartilage"
                            },
                            {
                              "label": "alloplastic materials"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "measured myotomy of the levator muscle"
                    },
                    {
                      "label": "full-thickness transverse blepharotomy"
                    },
                    {
                      "label": "lateral flare (common in TED)",
                      "children": [
                        {
                          "label": "small eyelid-splitting lateral tarsorrhaphy + recession of the upper and lower eyelid retractors",
                          "children": [
                            {
                              "label": "may limit the patient’s lateral visual field"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "lower eyelid retraction",
                  "children": [
                    {
                      "label": "anterior lamellar deficiency",
                      "children": [
                        {
                          "label": "eg, excess skin resection from blepharoplasty"
                        },
                        {
                          "label": "midface-lift"
                        },
                        {
                          "label": "full-thickness skin graft",
                          "children": [
                            {
                              "label": "eg, posttraumatic septal scarring"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "middle lamellar deficiency",
                      "children": [
                        {
                          "label": "scar release"
                        },
                        {
                          "label": "possible placement of a spacer graft"
                        }
                      ]
                    },
                    {
                      "label": "posterior lamellar deficiency",
                      "children": [
                        {
                          "label": "e.g. conjunctival scarring"
                        },
                        {
                          "label": "full-thickness mucous membrane graft"
                        }
                      ]
                    },
                    {
                      "label": "severe retraction of lower eyelids (common in TED)",
                      "children": [
                        {
                          "label": "spacer graft between lower eyelid retractors and inferior tarsal border",
                          "children": [
                            {
                              "label": "auricular cartilage"
                            },
                            {
                              "label": "hard-palate mucosa"
                            },
                            {
                              "label": "dermis fat"
                            },
                            {
                              "label": "preserved sclera and fascia lata"
                            },
                            {
                              "label": "processed collagens"
                            }
                          ]
                        },
                        {
                          "label": "horizontal eyelid or lateral canthal tightening/ elevation is also often necessary",
                          "children": [
                            {
                              "label": "horizontal tightening of lower eyelid in patients with proptosis may exacerbate eyelid retraction!"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Trichiasis",
      "children": [
        {
          "label": "acquired misdirection of the eyelashes"
        },
        {
          "label": "usually seen in cases of posterior lamellar scarring (marginal cicatricial entropion)"
        },
        {
          "label": "If the eyelid margin is misdirected, treatment should be directed at correcting the entropion"
        },
        {
          "label": "mechanical epilation",
          "children": [
            {
              "label": "± recurrence 3–8 weeks later"
            },
            {
              "label": "broken cilia are often more irritating to the cornea than mature longer lashes"
            }
          ]
        },
        {
          "label": "standard electrolysis",
          "children": [
            {
              "label": "definitive treatment"
            },
            {
              "label": "delivered with an insulated needle to destroy the hair follicle"
            },
            {
              "label": "when the needle tip is removed, the lash is easily extracted"
            },
            {
              "label": "disadvantages",
              "children": [
                {
                  "label": "recurrence rate is high"
                },
                {
                  "label": "adjacent normal lashes may be damaged"
                },
                {
                  "label": "scarring of the adjacent eyelid margin tissue can worsen the problem"
                }
              ]
            }
          ]
        },
        {
          "label": "cryotherapy",
          "children": [
            {
              "label": "for segmental trichiasis"
            },
            {
              "label": "requires only local infiltrative anesthesia"
            },
            {
              "label": "double freeze–thaw technique",
              "children": [
                {
                  "label": "frozen x25 seconds",
                  "children": [
                    {
                      "label": "allowed to thaw",
                      "children": [
                        {
                          "label": "refrozen x20 seconds"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "lashes are mechanically removed with forceps after treatment"
            },
            {
              "label": "disadvantages",
              "children": [
                {
                  "label": "edema lasting several days"
                },
                {
                  "label": "loss of skin pigmentation"
                },
                {
                  "label": "notching of the eyelid margin"
                },
                {
                  "label": "interference with goblet cell function"
                }
              ]
            },
            {
              "label": "may be combined with various surgical techniques and repeated if offending lashes persist or recur"
            }
          ]
        },
        {
          "label": "argon laser",
          "children": [
            {
              "label": "when only a few scattered eyelashes require ablation"
            },
            {
              "label": "some pigment is required in the base of the lash to absorb the laser energy"
            }
          ]
        },
        {
          "label": "full-thickness pentagonal resection",
          "children": [
            {
              "label": "when trichiasis is confined to a segment of the eyelid"
            },
            {
              "label": "with primary closure"
            }
          ]
        }
      ]
    }
  ],
