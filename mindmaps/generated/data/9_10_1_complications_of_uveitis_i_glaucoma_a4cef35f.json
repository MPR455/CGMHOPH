{
  "label": "9.10.1. Complications of Uveitis (I): Glaucoma",
  "root": true,
  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "IOP >24 mm Hg",
          "children": [
            {
              "label": "increases the risk of glaucoma"
            }
          ]
        },
        {
          "label": "IOP >30 mm Hg",
          "children": [
            {
              "label": "most practitioners tend to treat even without evidence of glaucomatous optic nerve damage"
            }
          ]
        },
        {
          "label": "early IOP elevation with active inflammation is almost always caused by inflammation",
          "children": [
            {
              "label": "requires aggressive anti-inflammatory treatment"
            },
            {
              "label": "corticosteroid-induced ocular hypertension rarely occurs before 3 weeks",
              "children": [
                {
                  "label": "clinicians should resist the urge to prematurely taper corticosteroids because of a fear of corticosteroid-induced ocular hypertension"
                }
              ]
            },
            {
              "label": "unilateral uveitis of sudden onset with open angles and increased IOP may be of infectious origin"
            }
          ]
        }
      ]
    },
    {
      "label": "greater risk of failure"
    },
    {
      "label": "Acute secondary angle-closure glaucoma",
      "children": [
        {
          "label": "choroidal inflammation",
          "children": [
            {
              "label": "forward rotation of the ciliary body and lens– iris diaphragm"
            },
            {
              "label": "± presenting sign of VKH syndrome or sympathetic ophthalmia"
            }
          ]
        },
        {
          "label": "pain, elevated IOP, and no posterior synechiae"
        },
        {
          "label": "UBM or ultrasound evaluation",
          "children": [
            {
              "label": "choroidal thickening and anterior rotation of the ciliary body"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "aggressive corticosteroid therapy"
            },
            {
              "label": "aqueous suppressants"
            },
            {
              "label": "cycloplegia"
            },
            {
              "label": "peripheral iridotomy or iridectomy is not useful !"
            }
          ]
        }
      ]
    },
    {
      "label": "Subacute secondary angle-closure glaucoma",
      "children": [
        {
          "label": "acute recurrent or chronic anterior segment inflammation",
          "children": [
            {
              "label": "circumferential posterior synechiae",
              "children": [
                {
                  "label": "pupillary block (seclusion of the pupil)"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "peripheral laser iridotomy",
              "children": [
                {
                  "label": "multiple"
                },
                {
                  "label": "large"
                },
                {
                  "label": "exacerbation of inflammation after laser iridotomy",
                  "children": [
                    {
                      "label": "iridotomies prone to close"
                    },
                    {
                      "label": "Intensive topical corticosteroid and cycloplegic therapy"
                    }
                  ]
                },
                {
                  "label": "in patients with brown irides, pretreat the iris with argon laser before using the Nd:YAG laser",
                  "children": [
                    {
                      "label": "may lessen the chance of bleeding and facilitate a wider opening"
                    }
                  ]
                }
              ]
            },
            {
              "label": "surgical iridectomy",
              "children": [
                {
                  "label": "If laser iridotomy is not successful"
                },
                {
                  "label": "± supplemented with goniosynechialysis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Management",
      "children": [
        {
          "label": "aqueous suppressants",
          "children": [
            {
              "label": "first-line agents"
            }
          ]
        },
        {
          "label": "prostaglandin analogues",
          "children": [
            {
              "label": "do not exacerbate intraocular inflammation",
              "children": [
                {
                  "label": "especially when used with IMT and corticosteroids"
                }
              ]
            },
            {
              "label": "use with caution in eyes with herpetic uveitis"
            }
          ]
        },
        {
          "label": "pilocarpine should be avoided in uveitis",
          "children": [
            {
              "label": "the smaller fixed pupil may be at risk for worsening of posterior synechiae"
            },
            {
              "label": "causes breakdown of the blood–aqueous barrier"
            }
          ]
        },
        {
          "label": "standard trabeculectomy",
          "children": [
            {
              "label": "results may be improved by using mitomycin C with intensive topical corticosteroids"
            },
            {
              "label": "intense and recurrent inflammation can lead to failure of filtering surgery in uveitic eyes"
            },
            {
              "label": "≤90% of patients 1 year after surgery and 62% 5 years after surgery achieve IOP control with 1 or 0 medications"
            },
            {
              "label": "surgical complications",
              "children": [
                {
                  "label": "cataract formation"
                },
                {
                  "label": "bleb leakage (early and late)/ could lead to endophthalmitis"
                },
                {
                  "label": "choroidal effusions"
                }
              ]
            },
            {
              "label": "excised trabecular block and iris should be submitted for pathologic evaluation"
            }
          ]
        },
        {
          "label": "nonpenetrating deep sclerectomy ± drainage implant",
          "children": [
            {
              "label": "effective in controlling IOP in ≤90% of uveitic eyes x 1 year"
            }
          ]
        },
        {
          "label": "goniotomy",
          "children": [
            {
              "label": "pediatric uveitis patients"
            },
            {
              "label": "≤75% chance of reducing IOP to 21 mm Hg or less after 2 surgeries"
            }
          ]
        },
        {
          "label": "trabeculodialysis",
          "children": [
            {
              "label": "may be complicated by transient hyphema and worsening of the preexisting cataract"
            }
          ]
        },
        {
          "label": "laser sclerostomy",
          "children": [
            {
              "label": "high rates of failure because of recurrent postoperative inflammation"
            }
          ]
        },
        {
          "label": "viscocanalostomy",
          "children": [
            {
              "label": "higher success rates in a limited number of studies"
            }
          ]
        },
        {
          "label": "aqueous drainage devices",
          "children": [
            {
              "label": "most cases of uveitic glaucoma, especially in pseudophakic or aphakic eyes"
            },
            {
              "label": "tunneled into the",
              "children": [
                {
                  "label": "anterior chamber"
                },
                {
                  "label": "vitreous cavity (pars plana)"
                }
              ]
            },
            {
              "label": "unidirectional valve design (valve implant)",
              "children": [
                {
                  "label": "can prevent postoperative hypotony"
                }
              ]
            },
            {
              "label": "more likely than trabeculectomy to successfully control IOP in the long term in eyes with uveitic glaucoma",
              "children": [
                {
                  "label": "≤75% reduction of IOP from preoperative levels"
                }
              ]
            },
            {
              "label": "complications of glaucoma-drainage-device surgery",
              "children": [
                {
                  "label": "10%/patient-year",
                  "children": [
                    {
                      "label": "75% of patients achieve target IOP levels with use of 0 or 1 topical antiglaucoma medication after 4 years"
                    }
                  ]
                },
                {
                  "label": "early",
                  "children": [
                    {
                      "label": "shallow anterior chamber"
                    },
                    {
                      "label": "hypotony"
                    },
                    {
                      "label": "suprachoroidal hemorrhage"
                    },
                    {
                      "label": "blockage of the drainage device by blood, fibrin, or iris"
                    },
                    {
                      "label": "CME"
                    }
                  ]
                },
                {
                  "label": "long-term",
                  "children": [
                    {
                      "label": "device erosion through the conjunctiva"
                    },
                    {
                      "label": "valve migration"
                    },
                    {
                      "label": "drainage device–cornea touch"
                    },
                    {
                      "label": "corneal decompensation"
                    },
                    {
                      "label": "retinal detachment"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "cyclodestructive procedures",
          "children": [
            {
              "label": "may worsen ocular inflammation"
            },
            {
              "label": "hypotony"
            },
            {
              "label": "phthisis",
              "children": [
                {
                  "label": "generally considered ineffective in eyes with uveitis"
                }
              ]
            }
          ]
        },
        {
          "label": "laser trabeculoplasty"
        }
      ]
    },
    {
      "label": "Chronic secondary angle-closure glaucoma",
      "children": [
        {
          "label": "chronic intraocular inflammation",
          "children": [
            {
              "label": "peripheral anterior synechiae"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "topical aqueous suppressants may be inadequate"
            },
            {
              "label": "trabeculectomy with mitomycin C"
            },
            {
              "label": "glaucoma drainage device"
            }
          ]
        }
      ]
    },
    {
      "label": "goniosynechialysis"
    },
    {
      "label": "Acute secondary open-angle glaucoma",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "trabecular meshwork is inflamed (trabeculitis)"
            },
            {
              "label": "inflammatory debris clogs the angle"
            }
          ]
        },
        {
          "label": "infectious causes of uveitis",
          "children": [
            {
              "label": "toxoplasma retinochoroiditis"
            },
            {
              "label": "necrotizing herpetic retinitis"
            },
            {
              "label": "herpes simplex and varicella-zoster anterior uveitis"
            },
            {
              "label": "cytomegalovirus anterior uveitis (including the Posner-Schlossman type)"
            },
            {
              "label": "Fuchs heterochromic uveitis (rubella- associated)"
            }
          ]
        },
        {
          "label": "sarcoid uveitis"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "specific treatment of the infectious agent"
            },
            {
              "label": "topical cycloplegics and corticosteroids"
            }
          ]
        }
      ]
    },
    {
      "label": "Chronic secondary open-angle glaucoma",
      "children": [
        {
          "label": "direct damage to the trabecular meshwork"
        },
        {
          "label": "management",
          "children": [
            {
              "label": "similar to that of primary open-angle glaucoma"
            },
            {
              "label": "strict control of intraocular inflammation through the use of IMT"
            }
          ]
        }
      ]
    },
    {
      "label": "Combined-mechanism uveitic glaucoma",
      "children": [
        {
          "label": "multiple mechanisms may be responsible for elevated pressure in uveitic eyes"
        }
      ]
    },
    {
      "label": "Corticosteroid-Induced Ocular Hypertension and Glaucoma",
      "children": [
        {
          "label": "corticosteroids in any formulation—topical, periocular, intraocular, or oral—may induce an elevation of IOP"
        },
        {
          "label": "fluocinolone intraocular implant",
          "children": [
            {
              "label": "need for glaucoma surgery in ≈ 40%"
            }
          ]
        },
        {
          "label": "topical difluprednate associated with severe and sometimes rapid increases in IOP"
        },
        {
          "label": "prevention",
          "children": [
            {
              "label": "use of a less-potent topical corticosteroid preparation",
              "children": [
                {
                  "label": "fluorometholone"
                },
                {
                  "label": "loteprednol"
                },
                {
                  "label": "rimexolone"
                },
                {
                  "label": "less likely to induce an IOP elevation",
                  "children": [
                    {
                      "label": "less effective in controlling intraocular inflammation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "less-frequent administration schedule"
            }
          ]
        }
      ]
    }
  ],
