            {
              "label": "combination of",
              "children": [
                {
                  "label": "peripheral vestibular nystagmus",
                  "children": [
                    {
                      "label": "initially, the vestibular nerve is affected",
                      "children": [
                        {
                          "label": "eyes drift toward the side of the lesion"
                        },
                        {
                          "label": "corrective fast phase in the opposite direction"
                        }
                      ]
                    },
                    {
                      "label": "small-amplitude, high-frequency vestibular nystagmus develops as the patient looks to the opposite side (direction of fast phase)",
                      "children": [
                        {
                          "label": "Alexander's law",
                          "children": [
                            {
                              "label": "fast phase to the opposite side"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "gaze-evoked nystagmus",
                  "children": [
                    {
                      "label": "as the tumor enlarges, the ipsilateral brainstem is compressed",
                      "children": [
                        {
                          "label": "problems in maintaining ipsilateral eccentric gaze"
                        }
                      ]
                    },
                    {
                      "label": "large-amplitude, lower-frequency gaze-evoked nystagmus develops as the patient looks to the side of the lesion"
                    }
