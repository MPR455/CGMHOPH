              "label": "(presumed viral) vestibular neuronitis"
            }
          ]
        },
        {
          "label": "recurrent",
          "children": [
            {
              "label": "usually progressive",
              "children": [
                {
                  "label": "auditory symptoms (tinnitus and hearing loss)"
                },
                {
                  "label": "long symptom-free intervals"
                }
              ]
            },
            {
              "label": "Ménière disease"
            }
          ]
        },
        {
          "label": "paroxysmal",
          "children": [
            {
              "label": "benign paroxysmal positional vertigo (BPPV)"
            },
            {
              "label": "vertigo in response to certain postures of the head"
            },
            {
              "label": "free movement of otoconia particles, which act as foreign debris within a semicircular canal"
            },
            {
              "label": "Dix-Hallpike maneuver",
              "children": [
                {
                  "label": "patient’s head is turned 45° to the right or left and lowered below the horizontal plane of an examining table"
                }
              ]
            },
            {
              "label": "repositioning treatments",
              "children": [
                {
                  "label": "Epley maneuver"
                },
                {
                  "label": "recurrence is not unusual"
                }
              ]
            }
          ]
        },
        {
          "label": "toxic",
          "children": [
            {
              "label": "agents",
              "children": [
                {
                  "label": "aminoglycosides"
                },
                {
                  "label": "chemotherapeutics"
                }
              ]
            },
            {
              "label": "head movement–related oscillopsia"
            },
            {
              "label": "decreased vestibular ocular reflex (VOR) gain bilaterally with little or no nystagmus",
              "children": [
                {
                  "label": "fast phase to opposite side",
                  "children": [
