                  "label": "prechiasmal problem"
                }
              ]
            },
            {
              "label": "binocular loss",
              "children": [
                {
                  "label": "chiasmal or retrochiasmal problem"
                }
              ]
            }
          ]
        },
        {
          "label": "Age",
          "children": [
