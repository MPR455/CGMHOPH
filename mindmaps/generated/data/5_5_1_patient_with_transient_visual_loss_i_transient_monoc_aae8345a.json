    {
      "label": "Examination for transient visual loss",
      "children": [
        {
          "label": "thorough examination is crucial",
          "children": [
            {
              "label": "to rule out ocular and orbital causes of transient visual loss"
            },
            {
              "label": "to assess the afferent visual function"
            }
          ]
        },
        {
          "label": "Examination should include",
          "children": [
            {
              "label": "testing for best-corrected visual acuity",
              "children": [
                {
                  "label": "to look for retinovascular clues such as emboli, cotton-wool spots, vascular attenuation, or hemorrhage"
                }
              ]
            },
            {
              "label": "visual fields"
            },
            {
              "label": "color vision"
            },
            {
              "label": "relative afferent pupillary defect"
            },
            {
              "label": "dilated ophthalmoscopy"
            },
            {
              "label": "photostress recovery test",
              "children": [
                {
                  "label": "positive photostress recovery test may indicate macular ischemia"
                },
                {
                  "label": "to differentiate vision loss caused by macular lesion or ocular ischemia from optic neuropathy",
                  "children": [
