      "label": "Introduction to transient visual loss",
      "children": [
        {
          "label": "definition",
          "children": [
            {
              "label": "sudden loss of visual function (partial or complete) in 1 or both eyes that lasts <24 hours"
            }
          ]
        },
        {
          "label": "most common cause",
          "children": [
            {
              "label": "transient monocular visual loss (TMVL)",
              "children": [
                {
                  "label": "retinal ischemia due to carotid artery disease"
                }
              ]
            },
            {
              "label": "transient binocular visual disturbance",
              "children": [
                {
                  "label": "migraine"
                }
              ]
            }
          ]
        },
        {
          "label": "Monocular versus binocular visual loss",
