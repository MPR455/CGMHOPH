    },
    {
      "label": "Metastatic Tumors",
      "children": [
        {
          "label": "children",
          "children": [
            {
              "label": "in children, distant tumors metastasize to the orbit more frequently than to the globe",
              "children": [
                {
                  "label": "adults more frequently have metastases to the choroid"
                }
              ]
            },
            {
              "label": "Neuroblastoma",
              "children": [
                {
                  "label": "abrupt ecchymotic proptosis",
                  "children": [
                    {
                      "label": "eyelid ecchymosis may lead to the mistaken impression of injury"
                    }
                  ]
                },
                {
                  "label": "± bilateral"
                },
                {
                  "label": "± Horner syndrome"
                },
                {
                  "label": "CT",
                  "children": [
                    {
                      "label": "bone destruction",
                      "children": [
                        {
                          "label": "particularly lateral orbital wall or sphenoid marrow"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "orbital metastases typically occur late in the course of the disease",
                  "children": [
                    {
                      "label": "primary tumor can be detected readily in abdomen, mediastinum, or neck"
                    }
                  ]
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "chemotherapy"
                    },
                    {
                      "label": "radiotherapy",
                      "children": [
                        {
                          "label": "for cases of impending vision loss due to compressive optic neuropathy"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "survival rate",
                  "children": [
                    {
                      "label": "related to the patient’s age at diagnosis",
                      "children": [
                        {
                          "label": "<1 year",
                          "children": [
                            {
                              "label": "90% survival"
                            }
                          ]
                        },
                        {
                          "label": ".>1 year",
                          "children": [
                            {
                              "label": "10%"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "congenital neuroblastoma of the cervical ganglia",
                  "children": [
                    {
                      "label": "ipsilateral Horner syndrome"
                    },
                    {
                      "label": "heterochromia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Leukemia",
              "children": [
                {
                  "label": "acute lymphoblastic leukemia",
                  "children": [
                    {
                      "label": "most common leukemia to metastasize to the orbit"
                    },
                    {
                      "label": "unilateral or bilateral proptosis"
                    }
                  ]
                },
                {
                  "label": "primary leukemic orbital mass",
                  "children": [
                    {
                      "label": "granulocytic sarcoma or chloroma"
                    },
                    {
                      "label": "rare variant of myelogenous leukemia"
                    },
                    {
                      "label": "metastasis to the subarachnoid space of the optic nerve",
                      "children": [
                        {
                          "label": "rare"
                        },
                        {
                          "label": "sudden vision loss"
                        },
                        {
                          "label": "swelling of the optic nerve"
                        },
                        {
                          "label": "emergency",
                          "children": [
                            {
                              "label": "treated with orbital radiotherapy"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "special stains for cytoplasmic esterase",
                      "children": [
                        {
                          "label": "Leder stain"
                        },
                        {
                          "label": "granulocytic precursor cells"
                        }
                      ]
                    },
                    {
                      "label": "typically, orbital lesions present before blood or bone marrow signs of leukemia",
                      "children": [
                        {
                          "label": "almost invariably follow within several months"
                        },
                        {
                          "label": "chances for survival are improved if chemotherapy is instituted before the discovery of leukemia in bone marrow or peripheral blood"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "references"
                }
              ]
            }
          ]
        },
        {
          "label": "adults",
          "children": [
            {
              "label": "any carcinoma of the internal organs and cutaneous melanoma can metastasize to the orbit"
            },
            {
              "label": "breast and lung tumors are most common"
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "pain"
                },
                {
                  "label": "proptosis"
                },
                {
                  "label": "inflammation"
                },
                {
                  "label": "bone destruction"
                },
                {
                  "label": "early ophthalmoplegia",
                  "children": [
                    {
                      "label": "extraocular muscles are frequently involved",
                      "children": [
                        {
                          "label": "have abundant blood supply !"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "bone marrow space of the sphenoid bone",
                  "children": [
                    {
                      "label": "second most common site"
                    },
                    {
                      "label": "relatively high volume of low-flow blood"
                    },
                    {
                      "label": "lytic destruction of this part of the lateral orbital wall is highly suggestive of metastatic disease"
                    }
                  ]
                }
              ]
            },
            {
              "label": "known primary tumor",
              "children": [
                {
                  "label": "75%"
                }
              ]
            },
            {
              "label": "unknown primary tumor",
              "children": [
                {
                  "label": "25%"
                }
              ]
            },
            {
              "label": "diagnostic workup",
              "children": [
                {
                  "label": "elevation of serum carcinoembryonic antigen"
                },
                {
                  "label": "fine-needle aspiration biopsy",
                  "children": [
                    {
                      "label": "can be performed in the office"
                    }
                  ]
                },
                {
                  "label": "orbitotomy and open biopsy"
                }
              ]
            },
            {
              "label": "breast carcinoma",
              "children": [
                {
                  "label": "most common primary source of orbital metastases in women"
                },
                {
                  "label": "may occur many years after the breast has been removed"
                },
                {
                  "label": "may elicit a fibrous response",
                  "children": [
                    {
                      "label": "enophthalmos"
                    },
                    {
                      "label": "restriction of ocular motility"
                    }
                  ]
                },
                {
                  "label": "fresh tissue should be submitted for estrogen receptor assay",
                  "children": [
                    {
                      "label": "even if this test was previously performed because estrogen receptor content may differ between the primary and the metastatic lesions"
                    }
                  ]
                },
                {
                  "label": "hormonal therapy",
                  "children": [
                    {
                      "label": "most likely to help patients whose tumors are receptor-positive"
                    }
                  ]
                }
              ]
            },
            {
              "label": "bronchogenic carcinoma",
              "children": [
                {
                  "label": "most frequent origin of orbital metastasis in men"
                },
                {
                  "label": "primary lesion may be quite small"
                },
                {
                  "label": "CT of suspicious lung lesions"
                }
              ]
            },
            {
              "label": "prostate carcinoma",
              "children": [
                {
                  "label": "can produce a clinical picture resembling that of acute nonspecific orbital inflammation"
                },
                {
                  "label": "lytic bone lesion"
                }
              ]
            },
            {
              "label": "management of orbital metastases",
              "children": [
                {
                  "label": "palliative"
                },
                {
                  "label": "local radiation therapy"
                },
                {
                  "label": "wide excision",
                  "children": [
                    {
                      "label": "carcinoid"
                    },
                    {
                      "label": "renal cell carcinoma"
                    },
                    {
                      "label": "some patients may survive for many years following resection of isolated metastases from these primary tumors"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
