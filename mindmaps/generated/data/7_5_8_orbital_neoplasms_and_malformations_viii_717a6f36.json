{
  "label": "7.5.8. Orbital Neoplasms and Malformations (VIII)",
  "root": true,
  "children": [
    {
      "label": "opposite of histiocytoma tumors",
      "children": [
        {
          "label": "survival rate",
          "children": [
            {
              "label": "<2 years",
