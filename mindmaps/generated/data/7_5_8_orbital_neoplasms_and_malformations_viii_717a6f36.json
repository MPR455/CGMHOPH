        {
          "label": "sinus origin",
          "children": [
            {
              "label": "proptosis and globe displacement"
            },
            {
              "label": "mucoceles and mucopyoceles",
              "children": [
                {
                  "label": "cystic structures with pseudostratified ciliated columnar (respiratory) epithelium resulting from obstruction of the sinus excretory ducts"
                },
                {
                  "label": "invade the orbit by expansion and erosion of the bones of the orbital walls"
                },
                {
                  "label": "mucoceles",
                  "children": [
                    {
                      "label": "most mucoceles arise from the frontal or ethmoid sinuses"
                    },
                    {
                      "label": "filled with thick mucoid secretions"
                    }
                  ]
                },
                {
                  "label": "pyoceles",
                  "children": [
                    {
                      "label": "filled with pus"
                    }
                  ]
                },
                {
                  "label": "surgical treatment",
                  "children": [
                    {
                      "label": "evacuation of the mucocele"
                    },
                    {
                      "label": "reestablishment of drainage of the affected sinus",
                      "children": [
                        {
                          "label": "OR",
                          "children": [
                            {
                              "label": "obliteration of the sinus by mucosal stripping and packing with bone or fat"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "silent sinus syndrome",
              "children": [
                {
                  "label": "chronic subclinical sinusitis",
                  "children": [
                    {
                      "label": "causes thinning of the bone of the involved sinus",
                      "children": [
                        {
                          "label": "collapse of the orbital floor",
                          "children": [
                            {
                              "label": "may occur in association with a recent significant change in atmospheric pressure",
                              "children": [
                                {
                                  "label": "during airplane travel"
                                },
                                {
                                  "label": "scuba diving"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "enophthalmos"
                },
                {
                  "label": "upper eyelid may appear relatively retracted"
                },
                {
                  "label": "± transient diplopia"
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "restoration of normal sinus drainage"
                    },
                    {
                      "label": "reconstruction of the orbital floor"
                    }
                  ]
                }
              ]
