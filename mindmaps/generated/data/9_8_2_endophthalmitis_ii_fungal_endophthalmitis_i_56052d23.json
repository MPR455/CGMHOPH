{
  "label": "9.8.2. Endophthalmitis (II): Fungal Endophthalmitis (I)",
  "root": true,
  "children": [
    {
      "label": "General",
      "children": [
        {
          "label": "focal or multifocal areas of chorioretinitis",
          "children": [
            {
              "label": "begins in the choroid",
              "children": [
                {
                  "label": "yellow-white lesions with indistinct borders"
                },
                {
                  "label": "from small cotton-wool spots to several disc diameters"
                }
              ]
            },
            {
              "label": "can subsequently break through into the vitreous",
              "children": [
                {
                  "label": "localized cellular and fungal aggregates overlying the original site(s)"
                }
              ]
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "Aspergillus",
              "children": [
                {
                  "label": "Candida (the most common cause)"
                }
              ]
            },
            {
              "label": "Coccidioides"
            },
            {
              "label": "Histoplasma capsulatum"
            },
            {
              "label": "Cryptococcus neoformans"
            },
            {
              "label": "Sporothrix schenkii"
            },
            {
              "label": "Blastomyces dermatitidis",
              "children": [
                {
                  "label": "less common"
                }
              ]
            }
          ]
        },
        {
          "label": "granulomatous or nongranulomatous inflammation",
          "children": [
            {
              "label": "keratic precipitates"
            },
            {
              "label": "hypopyon"
            },
            {
              "label": "vitritis with cellular aggregates"
            }
          ]
        },
        {
          "label": "± iris nodules"
        },
        {
          "label": "± rubeosis"
        },
        {
          "label": "nonneoplastic masquerade syndrome",
          "children": [
            {
              "label": "mistaken for noninfectious uveitis",
              "children": [
                {
                  "label": "Aspergillus",
                  "children": [
                    {
                      "label": "Candida (the most common cause)"
                    }
                  ]
                },
                {
                  "label": "Coccidioides"
                }
              ]
            },
            {
              "label": "corticosteroids alone usually worsen the disease"
            }
          ]
        },
        {
          "label": "requires aggressive systemic and local antifungal therapy as well as surgical intervention"
        }
      ]
    },
    {
      "label": "dense vitritis"
    },
    {
      "label": "Aspergillus endophthalmitis",
      "children": [
        {
          "label": "Aspergillus fumigatus/Aspergillus flavus",
          "children": [
            {
              "label": "human exposure is very common",
              "children": [
                {
                  "label": "found in soil and decaying vegetation"
                },
                {
                  "label": "infection is rare",
                  "children": [
                    {
                      "label": "depends on the virulence of the fungal pathogen and immunocompetence of the host"
                    }
                  ]
                }
              ]
            },
            {
              "label": "spores",
              "children": [
                {
                  "label": "become airborne",
                  "children": [
                    {
                      "label": "seed the lungs and paranasal sinuses of humans",
                      "children": [
                        {
                          "label": "hematogenous dissemination to the choroid"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "predisposing conditions",
          "children": [
            {
              "label": "severe chronic pulmonary diseases"
            },
            {
              "label": "cancer"
            },
            {
              "label": "endocarditis"
            },
            {
              "label": "severe immunocompromise"
            },
            {
              "label": "intravenous drug abuse"
            },
            {
              "label": "orthotopic liver transplantation"
            },
            {
              "label": "may occur in immunocompetent patients",
              "children": [
                {
                  "label": "rare"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "associated with disseminated aspergillosis",
              "children": [
                {
                  "label": "lung"
                },
                {
                  "label": "eye",
                  "children": [
                    {
                      "label": "second most common site of infection"
                    }
                  ]
                }
              ]
            },
            {
              "label": "rapid onset of pain and loss of vision"
            },
            {
              "label": "confluent yellowish infiltrate is often present in the macula",
              "children": [
                {
                  "label": "commonly invades the retinal and choroidal vessels",
                  "children": [
                    {
                      "label": "retinal hemorrhages"
                    },
                    {
                      "label": "retinal vascular occlusions",
                      "children": [
                        {
                          "label": "broad areas of ischemic infarction",
                          "children": [
                            {
                              "label": "full-thickness retinal necrosis",
                              "children": [
                                {
                                  "label": "forms central atrophic scar when healed"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "choroid and subretinal space",
                  "children": [
                    {
                      "label": "± hypopyon in the subretinal or subhyaloidal space"
                    }
                  ]
                },
                {
                  "label": "in contrast to Candida chorioretinitis, Aspergillus lesions are larger and more likely to be hemorrhagic"
                }
              ]
            },
            {
              "label": "variable degrees of cells, flare, and hypopyon in the anterior chamber"
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "pars plana vitreous biopsy",
              "children": [
                {
                  "label": "culture"
                },
                {
                  "label": "Gram and Giemsa stains",
                  "children": [
                    {
                      "label": "septate, dichotomously branching hyphae"
                    }
                  ]
                }
              ]
            },
            {
              "label": "difficult to culture from the blood"
            },
            {
              "label": "coexisting systemic aspergillosis can be a strong clue, especially among high-risk patients"
            }
          ]
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "angiocentric",
              "children": [
                {
                  "label": "hemorrhage in all retinal layers"
                }
              ]
            },
            {
              "label": "mixed acute (polymorphonuclear leukocytes) and chronic (lymphocytes and plasma cells) inflammation",
              "children": [
                {
                  "label": "granulomas contain rare giant cells"
                },
                {
                  "label": "polymorphonuclear leukocytes in the vitreous"
                }
              ]
            },
            {
              "label": "branching fungal hyphae spreading on the surface of the Bruch membrane without penetrating it",
              "children": [
                {
                  "label": "surrounded by macrophages and lymphocytes",
                  "children": [
                    {
                      "label": "form small vitreous abscesses"
                    }
                  ]
                }
              ]
            },
            {
              "label": "primary focus of infection",
              "children": [
                {
                  "label": "Candida endophthalmitis",
                  "children": [
                    {
                      "label": "vitreous"
                    }
                  ]
                },
                {
                  "label": "Aspergillus endophthalmitis",
                  "children": [
                    {
                      "label": "retinal and choroidal vessels"
                    },
                    {
                      "label": "subretinal/subretinal pigment epithelial space"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "Candida endophthalmitis"
            },
            {
              "label": "cytomegalovirus retinitis"
            },
            {
              "label": "Toxoplasma retinochoroiditis"
            },
            {
              "label": "coccidioidomycotic choroiditis"
            },
            {
              "label": "bacterial endophthalmitis"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "pars plana vitrectomy"
            },
            {
              "label": "intravitreal amphotericin B or voriconazole",
              "children": [
                {
                  "label": "± intravitreal corticosteroids"
                }
              ]
            },
            {
              "label": "systemic treatment",
              "children": [
                {
                  "label": "infectious diseases specialist"
                },
                {
                  "label": "oral voriconazole"
                },
                {
                  "label": "intravenous amphotericin B"
                },
                {
                  "label": "caspofungin",
                  "children": [
                    {
                      "label": "activity against Candida and Aspergillus"
                    }
                  ]
                },
                {
                  "label": "other systemic antifungal drugs, such as itraconazole, miconazole, fluconazole, and ketoconazole"
                }
              ]
            },
            {
              "label": "visual prognosis is poor because of frequent macular involvement",
              "children": [
                {
                  "label": "VA<20/200"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Candida endophthalmitis",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "Candida species are the most common cause of endogenous fungal endophthalmitis",
              "children": [
                {
                  "label": "in both pediatric and adult populations"
                }
              ]
            },
            {
              "label": "organisms",
              "children": [
                {
                  "label": "Candida albicans",
                  "children": [
                    {
                      "label": "the most common pathogen"
                    }
                  ]
                },
                {
                  "label": "non-albicans species (eg, C glabrata)"
                }
              ]
            },
            {
              "label": "budding yeast",
              "children": [
                {
                  "label": "characteristic pseudohyphate appearance"
                }
              ]
            },
            {
              "label": "reach the choroid hematogenously",
              "children": [
                {
                  "label": "break through the Bruch membrane",
                  "children": [
                    {
                      "label": "form subretinal abscesses",
                      "children": [
                        {
                          "label": "involve the retina and vitreous"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "prevalence of intraocular candidiasis in patients with candidemia",
              "children": [
                {
                  "label": "9%-78%"
                },
                {
                  "label": "≤37% if not receiving antifungal therapy"
                },
                {
                  "label": "3% if receiving antifungal therapy"
                }
              ]
            },
            {
              "label": "patients with ocular lesions are more likely to have infection involving a greater number of organ systems"
            },
            {
              "label": "predisposing conditions",
              "children": [
                {
                  "label": "recent major gastrointestinal surgery"
                },
                {
                  "label": "bacterial sepsis"
                },
                {
                  "label": "systemic antibiotic use"
                },
                {
                  "label": "use of indwelling catheters"
                },
                {
                  "label": "hyperalimentation"
                },
                {
                  "label": "debilitating diseases",
                  "children": [
                    {
                      "label": "diabetes mellitus"
                    }
                  ]
                },
                {
                  "label": "immunomodulatory therapy"
                },
                {
                  "label": "prolonged neutropenia"
                },
                {
                  "label": "organ transplantation"
                },
                {
                  "label": "hospitalized neonates"
                },
                {
                  "label": "intravenous drug users"
                },
                {
                  "label": "immunodeficiency per se does not appear to be a prominent predisposing factor",
                  "children": [
                    {
                      "label": "paucity of Candida chorioretinitis/ endophthalmitis among patients with HIV/ AIDS"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "blurred or decreased vision"
                },
                {
                  "label": "pain"
                }
              ]
            },
            {
              "label": "multiple, bilateral, white, well-circumscribed lesions",
              "children": [
                {
                  "label": "<1 mm"
                },
                {
                  "label": "postequatorial fundus",
                  "children": [
                    {
                      "label": "string-of-pearls appearance"
                    }
                  ]
                }
              ]
            },
            {
              "label": "overlying vitreous cellular inflammation"
            },
            {
              "label": "vascular sheathing"
            },
            {
              "label": "intraretinal hemorrhages"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "all patients with candidemia should undergo baseline dilated funduscopic examination",
              "children": [
                {
                  "label": "monitoring for ≥2 weeks after an initial eye examination"
                },
                {
                  "label": "earlier treatment of candidal endophthalmitis has been associated with better visual outcomes"
                }
              ]
            },
            {
              "label": "blood culture"
            },
            {
              "label": "diagnostic and therapeutic vitrectomy",
              "children": [
                {
                  "label": "in presence of vitreous snowballs and endophthalmitis"
                },
                {
                  "label": "vitreous culture",
                  "children": [
                    {
                      "label": "undiluted vitreous sample"
                    }
                  ]
                },
                {
                  "label": "Giemsa stain"
                },
                {
                  "label": "PCR for Candida species"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "toxoplasmic retinochoroiditis"
            },
            {
              "label": "pars planitis"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "consultation with a specialist in infectious diseases is essential"
            },
            {
              "label": "chorioretinal lesions not yet involving the vitreous",
              "children": [
                {
                  "label": "oral antifungal drugs (triazoles)",
                  "children": [
                    {
                      "label": "voriconazole (200 mg, twice daily)",
                      "children": [
                        {
                          "label": "good oral bioavailability"
                        },
                        {
                          "label": "broad spectrum of antifungal activity"
                        },
                        {
                          "label": "good vitreous penetration"
                        }
                      ]
                    },
                    {
                      "label": "x 2–4 weeks",
                      "children": [
                        {
                          "label": "fluconazole"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "vitreous body is involved",
              "children": [
                {
                  "label": "intravenous + intravitreal antifungal drugs"
                },
                {
                  "label": "intravitreal injection of antifungal drugs",
                  "children": [
                    {
                      "label": "usually in conjunction with pars plana vitrectomy",
                      "children": [
                        {
                          "label": "debulking the pathogen load"
                        }
                      ]
                    },
                    {
                      "label": "± dexamethasone, 0.4 mg/0.1 mL",
                      "children": [
                        {
                          "label": "amphotericin B, 5–10 μg/0.1 mL",
                          "children": [
                            {
                              "label": "OR",
                              "children": [
                                {
                                  "label": "voriconazole, 100 μg/0.1 mL"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "intravenous amphotericin B ± flucytosine",
                  "children": [
                    {
                      "label": "more severe infections"
                    },
                    {
                      "label": "dose-limiting toxicities",
                      "children": [
                        {
                          "label": "renal, cardiac, and neurologic"
                        }
                      ]
                    },
                    {
                      "label": "liposomal lipid complex formulations",
                      "children": [
                        {
                          "label": "less toxicity"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "intravenous caspofungin",
                  "children": [
                    {
                      "label": "echinocandin class",
                      "children": [
                        {
                          "label": "activity against Candida and Aspergillus"
                        },
                        {
                          "label": "inhibit synthesis of glucan in the cell wall"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "intravenous micafungin",
                  "children": [
                    {
                      "label": "echinocandin class"
                    }
                  ]
                },
                {
                  "label": "oral voriconazole, flucytosine, fluconazole, or rifampin",
                  "children": [
                    {
                      "label": "may be administered in addition to intravenous treatment"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment of both peripherally located lesions/ lesions not involving the macular center may salvage useful vision"
            }
          ]
        }
