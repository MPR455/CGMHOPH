    {
      "label": "Medical management of aqueous tear deficiency (ATD)",
      "children": [
        {
          "label": "Recommended treatment for aqueous teat deficiency",
          "children": [
            {
              "label": "See Table 3-5"
            }
          ]
        },
        {
          "label": "stop smoking"
        },
        {
          "label": "discontinue topical or systemic medications that may contribute to the condition",
          "children": [
            {
              "label": "topical β-blockers",
              "children": [
                {
                  "label": "increase incidence of dry eye",
                  "children": [
                    {
                      "label": "due to reduced corneal sensitivity"
                    }
                  ]
                }
              ]
            },
            {
              "label": "systemic medications",
              "children": [
                {
                  "label": "diuretics"
                },
                {
                  "label": "antihistamines"
                },
                {
                  "label": "anticholinergics"
                },
                {
                  "label": "psychotropics"
                }
              ]
            },
            {
              "label": "See Table 3-6"
            }
          ]
        },
        {
          "label": "topical tear substitutes",
          "children": [
            {
              "label": "preservative-free tear substitutes are recommended to avoid toxicity in patients who use these agents frequently"
            },
            {
              "label": "demulcents",
              "children": [
                {
                  "label": "polymers added to artificial tear solutions to improve their lubricant properties",
                  "children": [
                    {
                      "label": "mucomimetic"
                    }
                  ]
                },
                {
                  "label": "can briefly substitute for glycoproteins lost late in the disease process"
                },
                {
                  "label": "cannot restore lost glycoproteins or conjunctival goblet cells, reduce corneal cell desquamation, or decrease osmolarity"
                },
                {
                  "label": "preservative-free demulcent solutions",
                  "children": [
                    {
                      "label": "improve corneal barrier function"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "topical cyclosporine A 0.05%",
          "children": [
            {
              "label": "treats the inflammatory component of ATD"
            },
            {
              "label": "used earlier in disease course"
            },
            {
              "label": "often initiated in combination with a short course of topical steroids"
            },
            {
              "label": "≈ 50% of patients with moderate to severe ATD seem to benefit from topical cyclosporine",
              "children": [
                {
                  "label": "it may take several months for the anti- inflammatory benefits of cyclosporine to take effect"
                }
              ]
            },
            {
              "label": "minimal side effects"
            }
          ]
        },
        {
          "label": "dilute solutions of hyaluronic acid"
        },
        {
          "label": "diluted autologous serum",
          "children": [
            {
              "label": "composition is somewhat similar to normal tears",
              "children": [
                {
                  "label": "particularly in regard to growth factors",
                  "children": [
                    {
                      "label": "beneficial trophic function"
