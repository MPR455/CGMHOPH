    {
      "label": "Medical management of evaporative dry eye",
      "children": [
        {
          "label": "based on stage of MGD",
          "children": [
            {
              "label": "See Tables 3-7 and 3-8"
            }
          ]
        },
        {
          "label": "eyelid hygiene is the mainstay of treatment",
          "children": [
            {
              "label": "warm compresses to the eyelids",
              "children": [
                {
                  "label": "≥ 4 minutes once or twice a day"
                },
                {
                  "label": "liquefies thickened meibomian gland secretions"
                },
                {
                  "label": "application of heat should be followed by moderate to firm massage of eyelids to express retained meibomian secretions"
                },
                {
                  "label": "followed by cleansing of the closed eyelid margin with a clean washcloth, a cotton ball, or a commercially available pad",
                  "children": [
                    {
                      "label": "diluted solution of a nonirritant shampoo"
                    },
                    {
                      "label": "dilute sodium chloride solution",
                      "children": [
                        {
                          "label": "1 teaspoon of salt to 1 pint of boiled water"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "topical antibiotics",
          "children": [
            {
              "label": "short-term use"
            },
            {
              "label": "reduce the bacterial load on the eyelid margin"
            },
            {
              "label": "topical ophthalmic azithromycin",
              "children": [
                {
                  "label": "lipophilic antibiotic",
                  "children": [
                    {
                      "label": "reduces the production of bacterial lipases"
                    }
                  ]
                },
                {
                  "label": "high viscosity of the drop prolongs the contact time and aids its penetration into the glands"
                }
              ]
            }
          ]
        },
        {
          "label": "topical corticosteroids",
          "children": [
            {
              "label": "short-term use"
            },
            {
              "label": "moderate to severe inflammation",
              "children": [
                {
                  "label": "corneal infiltrates"
                },
                {
                  "label": "corneal vascularization"
                }
              ]
            },
            {
              "label": "should be warned about the potential complications associated with long-term use"
            }
          ]
        },
        {
          "label": "changes in diet and omega-3 supplementation",
          "children": [
            {
              "label": "in one study",
              "children": [
                {
                  "label": "1000-mg omega-3 nutritional supplements 3 times a day for 1 year",
                  "children": [
                    {
                      "label": "improved symptoms, tear-film stability, and meibomian secretions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "in another study",
              "children": [
                {
                  "label": "supplementation with fish oil showed no significant effect on meibum lipid composition or aqueous tear evaporation rate"
                },
                {
                  "label": "average tear production and tear volume increased"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic tetracyclines",
          "children": [
            {
              "label": "drugs",
              "children": [
                {
                  "label": "tetracycline",
                  "children": [
                    {
                      "label": "must be taken on an empty stomach"
                    },
                    {
                      "label": "requires more frequent dosing"
                    }
                  ]
                },
                {
                  "label": "doxycycline",
                  "children": [
                    {
                      "label": "100 mg every 12 hours for 3–4 weeks",
                      "children": [
                        {
                          "label": "tapering to 40–100 mg per day, based on clinical response"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "minocycline",
                  "children": [
                    {
                      "label": "50 mg every 12 hours for 3–4 weeks"
                    }
                  ]
                }
              ]
            },
            {
              "label": "lower doses may be equally effective"
            },
            {
              "label": "therapy must often be continued long-term",
              "children": [
                {
                  "label": "often takes 3–4 weeks to achieve a clinical response",
                  "children": [
                    {
                      "label": "it may take several months for the anti- inflammatory benefits of cyclosporine to take effect"
                    }
                  ]
                }
              ]
            },
            {
              "label": "erythromycin",
              "children": [
                {
                  "label": "alternative therapy in patients with known hypersensitivity to tetracycline or in children"
                }
              ]
            },
            {
              "label": "adverse effects",
              "children": [
                {
                  "label": "photosensitization"
                },
                {
                  "label": "gastrointestinal upset"
                },
                {
                  "label": "azotemia",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                },
                {
                  "label": "oral or vaginal candidiasis in susceptible patients"
                },
                {
                  "label": "may reduce the efficacy of oral contraceptives"
                }
              ]
            },
            {
              "label": "contraindications",
              "children": [
                {
                  "label": "pregnancy"
