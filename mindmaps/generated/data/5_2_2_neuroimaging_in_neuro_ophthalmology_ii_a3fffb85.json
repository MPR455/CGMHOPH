                {
                  "label": "local differences in blood oxygenation (blood oxygenation level–dependent [BOLD] responses)"
                }
              ]
            },
            {
              "label": "areas of higher metabolic activity can be identified during specific tasks",
              "children": [
                {
                  "label": "accurate visualization of the cortical areas involved in ocular motility"
                },
                {
                  "label": "cortical retinotopy within the visual cortex"
                }
              ]
            },
            {
              "label": "advantages (compared to PET)",
              "children": [
                {
                  "label": "less expensive"
                },
                {
                  "label": "faster imaging speed"
                },
                {
                  "label": "higher spatial resolution"
                },
                {
                  "label": "practical repeatability"
                },
                {
                  "label": "less invasive"
                }
              ]
            },
            {
              "label": "applications",
              "children": [
                {
                  "label": "research"
                },
                {
                  "label": "planning neurosurgical procedures"
                }
              ]
            }
          ]
        },
        {
          "label": "Positron emission tomography (PET)",
          "children": [
            {
              "label": "uptake of short-lived radioactive isotopes is related to metabolic activity"
            },
            {
              "label": "radioisotope with a short half-life",
              "children": [
                {
                  "label": "fluorine (18F)"
                },
                {
                  "label": "carbon (11C)"
                },
                {
                  "label": "nitrogen (13N)"
                },
                {
                  "label": "isotope uptake is related to metabolic activity"
                }
              ]
            },
            {
              "label": "imaging of the positrons produced during isotope decay"
            },
            {
              "label": "usually combined with CT to enhance resolution"
            },
            {
              "label": "PET with [18F]-fluoro-2-deoxyglucose",
              "children": [
                {
