    {
      "label": "Magnetic Resonance Imaging (MRI)",
      "children": [
        {
          "label": "technique",
          "children": [
            {
              "label": "atoms with odd number of nucleons (protons and neutrons)",
              "children": [
                {
                  "label": "hydrogen is the most common",
                  "children": [
                    {
                      "label": "MRI is sensitive to changes in water content of soft tissue",
                      "children": [
                        {
                          "label": "how the water is bound"
                        },
                        {
                          "label": "how it moves within tissue"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "small magnetic moment (spinning magnetic field)"
                }
              ]
            },
            {
              "label": "powerful magnetic field of an MRI scanner",
              "children": [
                {
                  "label": "magnetic moments of the hydrogen nuclei align in the field"
                }
              ]
            },
            {
              "label": "radiofrequency (RF) pulses",
              "children": [
                {
                  "label": "transiently perturb the hydrogen nuclei, knocking their magnetic moments out of alignment"
                }
              ]
            },
            {
              "label": "rate of relaxation (return to alignment with the scanner’s magnetic field) generates a tissue- specific signal"
            },
            {
              "label": "varying the RF pulses and the timing of signal recording",
              "children": [
                {
                  "label": "produces different types of images"
                }
              ]
            },
            {
              "label": "3-dimensional data set",
              "children": [
                {
                  "label": "can construct views in axial, coronal, sagittal, or even oblique planes"
                }
              ]
            }
          ]
        },
        {
          "label": "gadolinium",
          "children": [
