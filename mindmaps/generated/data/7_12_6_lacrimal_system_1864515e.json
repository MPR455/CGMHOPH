{
  "label": "7.12.6. Lacrimal System",
  "root": true,
  "children": [
    {
      "label": "Trauma",
      "children": [
        {
          "label": "Canaliculus",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "direct laceration"
                },
                {
                  "label": "traction",
                  "children": [
                    {
                      "label": "sudden lateral displacement of the eyelid",
                      "children": [
                        {
                          "label": "tears the medial canthal tendon and associated canaliculus"
                        }
                      ]
                    },
                    {
                      "label": "canaliculus lies within the weakest part of the eyelid",
                      "children": [
                        {
                          "label": "lacks tarsal support!"
                        }
                      ]
                    },
                    {
                      "label": "avulsion injury often appears trivial on superficial inspection",
                      "children": [
                        {
                          "label": "when possible, diagnostic canalicular probing and irrigation should be performed"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "surgical repair",
              "children": [
                {
                  "label": "most surgeons recommend repair of all canalicular lacerations",
                  "children": [
                    {
                      "label": "some patients with only one functioning canaliculus may experience symptomatic epiphora",
                      "children": [
                        {
                          "label": "especially with ocular irritation"
                        }
                      ]
                    },
                    {
                      "label": "success rate of primary repair is much higher than that of secondary reconstruction"
                    }
                  ]
                },
                {
                  "label": "preferably within 48 hours"
                },
                {
                  "label": "locate severed ends of canalicular system",
                  "children": [
                    {
                      "label": "general anesthesia"
                    },
                    {
                      "label": "magnification with optimal illumination"
                    },
                    {
                      "label": "laterally, canaliculus is located near eyelid margin"
                    },
                    {
                      "label": "for lacerations close to lacrimal sac, canaliculus is deep to anterior limb of medial canthal tendon"
                    },
                    {
                      "label": "irrigation using air, fluorescein, or yellow viscoelastic material through an intact adjacent canaliculus may be helpful",
                      "children": [
                        {
                          "label": "methylene blue should be avoided, as it tends to stain the entire operative field"
                        }
                      ]
                    },
                    {
                      "label": "careful use of a smooth-tipped pigtail probe may help identify medial cut end",
                      "children": [
                        {
                          "label": "introduced through opposite, uninvolved punctum; passed through common canaliculus; and finally passed through medial cut end"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "stenting of injured canaliculus",
                  "children": [
                    {
                      "label": "put the stent on traction",
                      "children": [
                        {
                          "label": "draws together severed canalicular ends and other soft-tissue structures"
                        },
                        {
                          "label": "lacrimal intubation also facilitates the soft- tissue reconstruction of the medial canthal tendon and eyelid margin"
                        }
                      ]
                    },
                    {
                      "label": "bicanalicular stents",
                      "children": [
                        {
                          "label": "cut at the medial canthus and retrieved from the nose"
                        }
                      ]
                    },
                    {
                      "label": "monocanalicular stents",
                      "children": [
                        {
                          "label": "with metal guiding probe",
                          "children": [
                            {
                              "label": "retrieved intranasally"
                            }
                          ]
                        },
                        {
                          "label": "without metallic probe",
                          "children": [
                            {
                              "label": "inserted into the punctum and into the lacerated canaliculus but does not extend into the nose"
                            },
                            {
                              "label": "can be performed under local anesthesia"
                            }
                          ]
                        },
                        {
                          "label": "simply pulled through the punctum"
                        }
                      ]
                    },
                    {
                      "label": "stents are usually left in place for ≥2 months"
                    },
                    {
                      "label": "complications",
                      "children": [
                        {
                          "label": "cheese-wiring"
                        },
                        {
                          "label": "ocular irritation"
                        },
                        {
                          "label": "infection"
                        },
                        {
                          "label": "local inflammation"
                        },
                        {
                          "label": "pyogenic granuloma"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "direct anastomosis of cut canaliculus over silicone tube can be accomplished with closure of pericanalicular tissues",
                  "children": [
                    {
                      "label": "direct suturing of canaliculi is probably not necessary"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Lacrimal Sac and Nasolacrimal Duct",
          "children": [
            {
              "label": "etiology",
              "children": [
                {
                  "label": "direct laceration"
                },
                {
                  "label": "fracture of surrounding bones"
                },
                {
                  "label": "during rhinoplasty"
                },
                {
                  "label": "endoscopic sinus surgery when the physiologic maxillary sinus ostium is being enlarged anteriorly"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "early treatment",
                  "children": [
                    {
                      "label": "fracture reduction"
                    },
                    {
                      "label": "soft-tissue repair"
                    },
                    {
                      "label": "silicone intubation of the entire lacrimal drainage system"
                    }
                  ]
                },
                {
                  "label": "late treatment",
                  "children": [
                    {
                      "label": "DCR"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Therapeutic Closure of the Lacrimal Drainage System",
      "children": [
        {
          "label": "indication",
          "children": [
            {
              "label": "severe dry eye"
            }
          ]
        },
        {
          "label": "dissolvable collagen plugs",
          "children": [
            {
              "label": "used on a trial basis"
            }
          ]
        },
        {
          "label": "permanent plugs",
          "children": [
            {
              "label": "silicone"
            },
            {
              "label": "advantages",
              "children": [
                {
                  "label": "placement is fairly straightforward"
                },
                {
                  "label": "can be removed, if necessary"
                },
                {
                  "label": "usually well tolerated"
                }
              ]
            },
            {
              "label": "complications",
              "children": [
                {
                  "label": "minor",
                  "children": [
                    {
                      "label": "ocular surface irritation"
                    },
                    {
                      "label": "foreign-body reaction"
                    },
                    {
                      "label": "pyogenic granuloma",
                      "children": [
                        {
                          "label": "requiring removal of the plug",
                          "children": [
                            {
                              "label": "usually regress once plug is removed"
                            }
                          ]
                        },
                        {
                          "label": "surgical excision needed on occasion"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "serious",
                  "children": [
                    {
                      "label": "plug extrusion or migration",
                      "children": [
                        {
                          "label": "a plug that is too small will usually be extruded"
                        },
                        {
                          "label": "if plug migrates within lacrimal drainage system, obstruction of either canaliculus or NLD may result"
                        },
                        {
                          "label": "most instances of canalicular obstruction are caused by plugs designed to be placed within canaliculus",
                          "children": [
                            {
                              "label": "use of these plugs is not recommended!"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "canaliculitis",
                      "children": [
                        {
                          "label": "may also result from canalicular plugs or from punctal plugs that have migrated to the canaliculus"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "surgical occlusion",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "occlusion with plugs is not successful"
                },
                {
                  "label": "reserved for severe cases"
                }
              ]
            },
            {
              "label": "almost always permanent",
              "children": [
                {
                  "label": "if patient suffers from subsequent epiphora, no simple solution is available",
                  "children": [
                    {
                      "label": "most cases require a CDCR"
                    }
                  ]
                },
                {
                  "label": "all patients should undergo a trial of temporary closure before permanent closure"
                }
              ]
            },
            {
              "label": "puncta should be closed in a stepwise fashion",
              "children": [
                {
                  "label": "one punctum at a time!",
                  "children": [
                    {
                      "label": "upper and lower puncta of the same eye should never be closed simultaneously",
                      "children": [
                        {
                          "label": "complete loss of lacrimal outflow can result in epiphora even in patients with fairly severe dry eye disease"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "techniques",
              "children": [
                {
                  "label": "thermal obliteration",
                  "children": [
                    {
                      "label": "puncta and adjacent canaliculi"
                    },
                    {
                      "label": "often, despite fairly aggressive attempts, the puncta persist or reform"
                    },
                    {
                      "label": "handheld cautery unit"
                    },
                    {
                      "label": "needle-tip unipolar cautery unit"
                    },
                    {
                      "label": "argon laser"
                    }
                  ]
                },
                {
                  "label": "ampullectomy",
                  "children": [
                    {
                      "label": "with either direct closure or placement of an overlying conjunctival graft"
                    }
                  ]
                },
                {
                  "label": "excision of punctal and adjacent canalicular epithelium",
                  "children": [
                    {
                      "label": "for recalcitrant cases"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
