  "children": [
    {
      "label": "Case Description",
      "children": [
        {
          "label": "70-year-old woman complains of burning, light sensitivity, and dry sensation of both eyes"
        }
      ]
    },
    {
      "label": "Image Description",
      "children": [
        {
          "label": "of filamentary keratopathy"
        }
      ]
    },
    {
      "label": "Additional Testing",
      "children": [
        {
          "label": "stare test",
          "children": [
            {
              "label": "after a few blinks, patient is asked to look at a visual acuity chart",
              "children": [
                {
                  "label": "normally the time until the image blurs should be > 8 seconds"
                }
              ]
            }
          ]
        },
        {
          "label": "tear break-up time",
          "children": [
            {
              "label": "appearance of dry spots in <10 seconds is considered abnormal"
            }
          ]
        },
        {
          "label": "basal tear secretion",
          "children": [
            {
              "label": "topical anesthetic"
            },
            {
              "label": "inferior cul-de-sac is dried"
            },
            {
              "label": "strip is left in place for 5 minutes",
              "children": [
                {
                  "label": "Schirmer strip is bent at the notch and placed with the short end resting on the conjunctiva and the fold crease on the eyelid margin",
                  "children": [
                    {
                      "label": "at the lateral one-third of the lower eyelid"
                    }
                  ]
                }
              ]
            },
            {
              "label": "normal",
              "children": [
                {
                  "label": "≈10–15 mm"
                }
              ]
            }
          ]
        },
        {
          "label": "Schirmer I and Schirmer II tests",
          "children": [
            {
              "label": "Schirmer I test",
              "children": [
                {
                  "label": "to evaluate both basic and reflex tearing"
                }
              ]
            },
            {
              "label": "Schirmer II test",
              "children": [
                {
                  "label": "no anesthetic"
                },
                {
                  "label": "tear strip in place",
                  "children": [
                    {
                      "label": "cotton-tipped applicator is placed in the nostril and moved back and forth for 2 minutes"
                    }
                  ]
                },
                {
                  "label": "to distinguish between fatigue block (when reflex secretion is suppressed because of chronic irritation) and a lack of function of the reflex secretors"
                }
              ]
            }
          ]
        }
      ]
    },
    {
