{
  "label": "9.10.5. Ocular Involvement in AIDS (II)",
  "root": true,
  "children": [
    {
      "label": "Syphilitic Chorioretinitis",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "uveitis"
            },
            {
              "label": "optic neuritis"
            },
            {
              "label": "nonnecrotizing retinitis",
              "children": [
                {
                  "label": "unilateral or bilateral"
                },
                {
                  "label": "pale-yellow, placoid retinal lesions",
                  "children": [
                    {
                      "label": "preferentially involve the macula",
                      "children": [
                        {
                          "label": "syphilitic posterior placoid chorioretinitis"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "exudative retinal detachment",
              "children": [
                {
                  "label": "dense vitritis without clinical evidence of chorioretinitis"
                }
              ]
            },
            {
              "label": "dermatologic and CNS symptoms"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "18–24 million units of intravenous penicillin G/ day x 10–14 days",
              "children": [
                {
                  "label": "followed by",
                  "children": [
                    {
                      "label": "2.4 million units of intramuscular benzathine penicillin G weekly x3 weeks"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "monitor for recurrence with rapid plasma reagin (RPR) test"
        }
      ]
    },
    {
      "label": "Multifocal Choroiditis and Systemic Dissemination",
      "children": [
        {
          "label": "multifocal choroidal lesions from a variety of infectious agents are found in up to 10% of patients with AIDS"
        },
        {
          "label": "most common organisms",
          "children": [
            {
              "label": "C neoformans"
            },
            {
              "label": "P jirovecii"
            },
            {
              "label": "M tuberculosis"
            },
            {
              "label": "multiple infectious agents may cause simultaneous infectious multifocal choroiditis"
            }
          ]
        },
        {
          "label": "choroid is a site of opportunistic disseminated infections and thus needs to be carefully examined"
        },
        {
          "label": "multifocal choroiditis is frequently a sign of disseminated infection"
        }
      ]
    },
    {
      "label": "atypical mycobacteria"
    },
    {
      "label": "human herpesvirus 8"
    },
    {
      "label": "Pneumocystis jirovecii Choroiditis",
      "children": [
        {
          "label": "patients with AIDS are at much greater risk for Pneumocystis jirovecii pneumonia",
          "children": [
            {
              "label": "rarely can result in choroiditis"
            }
          ]
        },
        {
          "label": "contain the microorganisms"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "choroidal infiltrates",
              "children": [
                {
                  "label": "slightly elevated, plaquelike, yellow-white lesions"
                }
              ]
            },
            {
              "label": "minimal vitritis"
            }
          ]
        },
        {
          "label": "fluorescein angiography",
          "children": [
            {
              "label": "hypofluorescent in the early phase"
            },
            {
              "label": "hyperfluorescent in the later phase"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "infectious diseases specialist"
            },
            {
              "label": "intravenous trimethoprim (20 mg/kg/day) and sulfamethoxazole (100 mg/kg/day) x 3-week"
            },
            {
              "label": "or"
            },
            {
              "label": "pentamidine (4 mg/kg/day) x 3-week"
            },
            {
              "label": "within 3–12 weeks, most of the yellow-white lesions disappear leaving mild overlying pigmentary changes"
            },
            {
              "label": "vision is usually not affected"
            }
          ]
        }
      ]
    },
    {
      "label": "Ocular Adnexal Kaposi Sarcoma",
      "children": [
        {
          "label": "ocular adnexal involvement occurs in ≈20% of AIDS-associated systemic Kaposi sarcoma",
          "children": [
            {
              "label": "before availability of potent antiretroviral therapy"
            }
          ]
        },
        {
          "label": "2 aggressive variants",
          "children": [
            {
              "label": "endemic",
              "children": [
                {
                  "label": "prevalent in Kenya and Nigeria"
                }
              ]
            },
            {
              "label": "epidemic",
              "children": [
                {
                  "label": "in renal transplant recipients"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "skin lesions",
              "children": [
                {
                  "label": "in patients with AIDS"
                }
              ]
            },
            {
              "label": "visceral organs (the gastrointestinal tract, lung, and liver)",
              "children": [
                {
                  "label": "≤50% of patients"
                }
              ]
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "spindle cells mixed with vascular structures"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "excision"
            },
            {
              "label": "cryotherapy"
            },
            {
              "label": "radiation"
            }
          ]
        }
      ]
    },
    {
      "label": "Cryptococcus neoformans Choroiditis",
      "children": [
        {
          "label": "Cryptococcus neoformans"
        },
        {
          "label": "multifocal choroiditis",
          "children": [
            {
              "label": "solitary or multiple discrete yellow-white chorioretinal lesions",
              "children": [
                {
                  "label": "varying markedly in size"
                },
                {
                  "label": "postequatorial"
                }
              ]
            }
          ]
        },
        {
          "label": "some patients show choroidal lesions before clinical evidence of dissemination"
        },
        {
          "label": "CSF infection",
          "children": [
            {
              "label": "secondary optic nerve edema as a result of increased intracranial pressure",
              "children": [
                {
                  "label": "optic atrophy"
                }
              ]
            },
            {
              "label": "direct invasion of the optic nerve is also possible",
              "children": [
                {
                  "label": "more rapid vision loss"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "amphotericin and flucytosine"
            }
          ]
        }
      ]
    }
  ],
