{
  "label": "8.13.8. Toxic & Traumatic Injuries (VIII): Perforating Injuries",
  "root": true,
  "children": [
    {
      "label": "History",
      "children": [
        {
          "label": "factors known to predispose to ocular penetration",
          "children": [
            {
              "label": "metal-on-metal strike"
            },
            {
              "label": "high-velocity projectile"
            },
            {
              "label": "high-energy impact on globe"
            },
            {
              "label": "sharp injuring object"
            },
            {
              "label": "lack of eye protection"
            }
          ]
        }
      ]
    },
    {
      "label": "Examination",
      "children": [
        {
          "label": "complete general and ophthalmic examination"
        },
        {
          "label": "visual acuity"
        },
        {
          "label": "pupillary examination",
          "children": [
            {
              "label": "the most reliable predictor of final visual outcome"
            },
            {
              "label": "reverse Marcus Gunn response"
            }
          ]
        },
        {
          "label": "signs that are suggestive or diagnostic of penetrating/perforating ocular injury",
          "children": [
            {
              "label": "See Table 13-5"
            }
          ]
        },
        {
          "label": "if a significant perforating injury is suspected avoid"
        },
        {
          "label": "ancillary tests that may be useful",
          "children": [
            {
              "label": "See Table 13-6",
              "children": [
                {
                  "label": "forced duction testing, gonioscopy, tonometry, and scleral depression"
                }
              ]
            }
          ]
        },
        {
          "label": "all cases should be managed with safeguards appropriate for patients with bloodborne infections"
        }
      ]
    },
    {
      "label": "Surgical repair",
      "children": [
        {
          "label": "primary enucleation",
          "children": [
            {
              "label": "only when restoration of anatomy is impossible"
            }
          ]
        },
        {
          "label": "anesthesia",
          "children": [
            {
              "label": "general anesthesia is almost always required",
              "children": [
                {
                  "label": "advantages of delaying enucleation far outweigh any advantages of primary enucleation",
                  "children": [
                    {
                      "label": "delay should not exceed 12–14 days!"
                    }
                  ]
                }
              ]
            },
            {
              "label": "local or topical anesthesia only when",
              "children": [
                {
                  "label": "patient is at medical risk from general anesthesia"
                },
                {
                  "label": "laceration is small & self-sealing"
                }
              ]
            },
            {
              "label": "periocular anesthetic injection to control postoperative pain",
              "children": [
                {
                  "label": "after surgical repair is complete"
                }
              ]
            }
          ]
        },
        {
          "label": "repair of corneal component",
          "children": [
            {
              "label": "corneal component should be repaired first"
            },
            {
              "label": "tissue prolapse",
              "children": [
                {
                  "label": "vitreous or lens fragment prolapse",
                  "children": [
                    {
                      "label": "cut flush with the cornea",
                      "children": [
                        {
                          "label": "do not exert traction on the vitreous or zonular fibers"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "uvea or retina prolapse",
                  "children": [
                    {
                      "label": "use viscoelastic material to reform anterior chamber"
                    },
                    {
                      "label": "reposit using gentle sweeping technique",
                      "children": [
                        {
                          "label": "through a separate limbal incision"
                        }
                      ]
                    },
                    {
                      "label": "may be necessary to reposit iris tissue repeatedly"
                    },
                    {
                      "label": "only frankly necrotic uvea should be excised"
                    }
                  ]
                }
              ]
            },
            {
              "label": "try to peel off epithelium that has migrated onto a uveal surface or into the wound"
            },
            {
              "label": "close points at which the laceration crosses landmarks (limbus)",
              "children": [
                {
                  "label": "9-0 or 10-0 nylon suture"
                }
              ]
            },
            {
              "label": "close remaining corneal component"
            },
            {
              "label": "suture knots should be buried in the corneal stroma, not in the wound"
            },
            {
              "label": "if watertight closure of the wound is not achieved",
              "children": [
                {
                  "label": "x-shaped or “purse-string” sutures"
                },
                {
                  "label": "cyanoacrylate glue"
                },
                {
                  "label": "primary lamellar keratoplasty"
                },
                {
                  "label": "conjunctival flap should not be used!"
                }
              ]
            },
            {
              "label": "specific suturing techniques",
              "children": [
                {
                  "label": "peripheral cornea",
                  "children": [
                    {
                      "label": "wider-spaced, longer sutures"
                    }
                  ]
                },
                {
                  "label": "central cornea",
                  "children": [
                    {
                      "label": "closer, shorter sutures",
                      "children": [
                        {
                          "label": "long enough to minimize their “cheese wiring”"
                        }
                      ]
                    },
                    {
                      "label": "avoid the visual axis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "repair of scleral component",
          "children": [
            {
              "label": "gentle peritomy",
              "children": [
                {
                  "label": "only as necessary to expose the wound"
                }
              ]
            },
            {
              "label": "prolapsed vitreous is excised"
            },
            {
              "label": "prolapsed nonnecrotic uvea and retina are reposited"
            },
            {
              "label": "do not fixate an open globe with rectus muscle sutures"
            },
            {
              "label": "9-0 nylon or 8-0 silk sutures"
            },
            {
              "label": "laceration extends under an extraocular muscle",
              "children": [
                {
                  "label": "muscle may be carefully removed at its insertion"
                }
              ]
            },
            {
              "label": "posterior lacerations",
              "children": [
                {
                  "label": "open globe should not be rotated too far"
                },
                {
                  "label": "more easily approached with loupes and a headlight"
                },
                {
                  "label": "repair posteriorly only to the point at which it becomes technically difficult or requires undue pressure on the globe",
                  "children": [
                    {
                      "label": "very posterior lacerations benefit from physiologic tamponade by orbital tissue and are best left alone"
                    }
                  ]
                }
              ]
            },
            {
              "label": "dissection of tenon capsule and management of prolapsed tissue must be repeated incrementally after each suture"
            }
          ]
        },
        {
          "label": "additional interventions",
          "children": [
            {
              "label": "if there are any concerns, complete the closure of the laceration and postpone other interventions until a later date"
            },
            {
              "label": "repair of adnexal injury should follow repair of the globe itself"
            },
            {
              "label": "remove foreign body that is visible in the anterior segment and can be grasped"
            },
            {
              "label": "removal of opacified lens material",
              "children": [
                {
                  "label": "primarily or secondarily"
                }
              ]
            },
            {
              "label": "iris repair",
              "children": [
                {
                  "label": "primarily or secondarily"
                },
                {
                  "label": "to decrease formation of anterior or posterior synechiae"
                },
                {
                  "label": "McCannel technique",
                  "children": [
                    {
                      "label": "10-0 polypropylene suture"
                    },
                    {
                      "label": "long needles"
                    }
                  ]
                }
              ]
            },
            {
              "label": "iridodialysis",
              "children": [
                {
                  "label": "McCannel technique"
                }
              ]
            }
          ]
        },
        {
          "label": "subconjunctival antibiotics",
          "children": [
            {
              "label": "to cover both gram-positive and gram-negative organisms"
            }
          ]
        },
        {
          "label": "intravitreal antibiotics",
          "children": [
            {
              "label": "vancomycin 1 mg",
              "children": [
                {
                  "label": "for contaminated wounds involving the vitreous"
                }
              ]
            },
            {
              "label": "ceftazidime 2.25 mg"
            }
          ]
        }
      ]
    },
    {
      "label": "Preoperative management",
      "children": [
        {
          "label": "studies have not documented any disadvantage in delaying the repair of an open globe for up to 36 hours"
        },
        {
          "label": "prompt repair can help minimize numerous complications",
          "children": [
            {
              "label": "pain"
            },
            {
              "label": "prolapse of intraocular structures"
            },
            {
              "label": "suprachoroidal hemorrhage"
            },
            {
              "label": "microbial contamination of the wound"
            },
            {
              "label": "proliferation of the microbes projected into the eye"
            },
            {
              "label": "migration of epithelium into the wound"
            },
            {
              "label": "intraocular inflammation"
            },
            {
              "label": "lens opacity"
            }
          ]
        },
        {
          "label": "temporizing measures",
          "children": [
            {
              "label": "apply a protective shield"
            },
            {
              "label": "keep the patient on NPO status",
              "children": [
                {
                  "label": "avoid administering topical medications or other interventions that require prying open the eyelids"
                }
              ]
            },
            {
              "label": "provide appropriate medications for sedation and pain control, as well as antiemetics"
            },
            {
              "label": "initiate intravenous antibiotics"
            },
            {
              "label": "seek anesthesia consultation",
              "children": [
                {
                  "label": "provide tetanus prophylaxis"
                }
              ]
            }
          ]
        },
        {
          "label": "risk of bacillus endophthalmitis",
          "children": [
            {
              "label": "soil contamination"
            },
            {
              "label": "retained intraocular foreign bodies"
            },
            {
              "label": "intravenous and/or intravitreal therapy with an antibiotic effective against bacillus",
              "children": [
                {
                  "label": "fluoroquinolones"
                },
                {
                  "label": "clindamycin"
                },
                {
                  "label": "vancomycin"
                }
              ]
            },
            {
              "label": "surgical repair should be undertaken with minimal delay"
            },
            {
              "label": "can destroy the eye within 24 hours"
            }
          ]
        }
      ]
    },
    {
      "label": "Nonsurgical options",
      "children": [
        {
          "label": "minimal eye penetrating injuries",
          "children": [
            {
              "label": "definition",
              "children": [
                {
                  "label": "spontaneously seal before ophthalmic examination"
                },
                {
                  "label": "no intraocular damage, prolapse, or adherence"
                }
              ]
            },
            {
              "label": "may require only systemic and/or topical antibiotic therapy"
            },
            {
              "label": "close observation"
            }
          ]
        },
        {
          "label": "leaking corneal wound with formed anterior chamber",
          "children": [
            {
              "label": "pharmacologic suppression of aqueous production"
            },
            {
              "label": "patching"
            },
            {
              "label": "therapeutic contact lens"
            },
            {
              "label": "tissue adhesive"
            },
            {
              "label": "if these measures fail to seal the wound in 2 days --> surgical repair"
            }
          ]
        }
      ]
    },
    {
      "label": "Postoperative management",
      "children": [
        {
          "label": "intravenous antibiotics",
          "children": [
            {
              "label": "for 48 hours",
              "children": [
                {
                  "label": "cephalosporin and aminoglycoside"
                }
              ]
            }
          ]
        },
        {
          "label": "oral antibiotic",
          "children": [
            {
              "label": "for 3–5 days",
              "children": [
                {
                  "label": "moxifloxacin (400 mg po daily)"
                }
              ]
            }
          ]
        },
        {
          "label": "topical antibiotics",
          "children": [
            {
              "label": "4 times a day for 7 days or until epithelial closure"
            }
          ]
        },
        {
          "label": "topical corticosteroids and cycloplegics",
          "children": [
            {
              "label": "taper slowly"
            }
          ]
        },
        {
          "label": "systemic prednisone",
          "children": [
            {
              "label": "for fibrinous response in the anterior chamber"
            }
          ]
        },
        {
          "label": "corneal sutures that do not loosen spontaneously",
          "children": [
            {
              "label": "left in place for ≥3 months",
              "children": [
                {
                  "label": "removed incrementally over the next few months"
                }
              ]
            },
            {
              "label": "indicators of adequate healing",
              "children": [
                {
                  "label": "fibrosis"
                },
                {
                  "label": "vascularization"
                }
              ]
            }
          ]
        },
        {
          "label": "apply fluorescein at each postoperative visit",
          "children": [
            {
              "label": "to exclude suture erosion through the epithelium"
            }
          ]
        },
        {
          "label": "frequent examination of the posterior segment",
          "children": [
            {
              "label": "to exclude retinal detachment"
            },
            {
              "label": "if no fundus view",
              "children": [
                {
                  "label": "afferent pupillary defect"
                },
                {
                  "label": "b-scan ultrasonography"
                }
              ]
            }
          ]
        },
        {
          "label": "refraction and correction with contact lenses or spectacles"
        }
      ]
    }
  ],
