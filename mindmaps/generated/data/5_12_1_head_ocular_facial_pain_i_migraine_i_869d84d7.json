{
  "label": "5.12.1. Head, Ocular, & Facial Pain (I): Migraine (I)",
  "root": true,
  "children": [
    {
      "label": "Migraine and Tension-type Headache",
      "children": [
        {
          "label": "General",
          "children": [
            {
              "label": "common primary headache",
              "children": [
                {
                  "label": "6%–8% of men"
                },
                {
                  "label": "15%–18% of women"
                }
              ]
            },
            {
              "label": "history",
              "children": [
                {
                  "label": "strong family history of migraine"
                },
                {
                  "label": "motion sickness as a child"
                }
              ]
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "repetitive bouts of headache",
                  "children": [
                    {
                      "label": "unilateral"
                    },
                    {
                      "label": "pulsating"
                    }
                  ]
                },
                {
                  "label": "nausea or vomiting"
                },
                {
                  "label": "photophobia"
                }
              ]
            },
            {
              "label": "clinical course",
              "children": [
                {
                  "label": "episodes may decrease after menopause",
                  "children": [
                    {
                      "label": "onset of migraine during puberty or young adulthood"
                    }
                  ]
                }
              ]
            },
            {
              "label": "migraine may be exacerbated by",
              "children": [
                {
                  "label": "routine physical activity"
                },
                {
                  "label": "menstruation"
                },
                {
                  "label": "pregnancy"
                },
                {
                  "label": "hunger"
                },
                {
                  "label": "stress"
                },
                {
                  "label": "certain foods (eg, chocolate or wine)"
                },
                {
                  "label": "sleep deprivation"
                }
              ]
            }
          ]
        },
        {
          "label": "Migraine with aura (classic migraine)",
          "children": [
            {
              "label": "30% of migraine cases"
            },
            {
              "label": "pathophysiology",
              "children": [
                {
                  "label": "activation of trigeminal nucleus caudalis",
                  "children": [
                    {
                      "label": "release of vasoactive chemokines at the vascular endings",
                      "children": [
                        {
                          "label": "dilation of the pial arteries"
                        },
                        {
                          "label": "increased vascular permeability"
                        },
                        {
                          "label": "inflammatory response"
                        },
                        {
                          "label": "activates trigeminal afferent fibers within the walls of blood vessels"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "aura",
              "children": [
                {
                  "label": "neurologic symptoms",
                  "children": [
                    {
                      "label": "usually visual"
                    }
                  ]
                },
                {
                  "label": "positive phenomena",
                  "children": [
                    {
                      "label": "typically have movement"
                    }
                  ]
                },
                {
                  "label": "fortification spectrum",
                  "children": [
                    {
                      "label": "a small scotoma that gradually expands into the peripheral vision",
                      "children": [
                        {
                          "label": "over minutes"
                        }
                      ]
                    },
                    {
                      "label": "bounded by a zigzag, shimmering, colorful or silvery image"
                    }
                  ]
                },
                {
                  "label": "hemianopic distribution",
                  "children": [
                    {
                      "label": "perceived by the patient as monocular",
                      "children": [
                        {
                          "label": "in the eye ipsilateral to the temporal defect"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "loss of vision may occur"
                },
                {
                  "label": "nausea",
                  "children": [
                    {
                      "label": "lasts <60 minutes"
                    }
                  ]
                },
                {
                  "label": "photophobia"
                }
              ]
            },
            {
              "label": "throbbing headache",
              "children": [
                {
                  "label": "follows the aura"
                },
                {
                  "label": "untreated, lasts 4-72 hours"
                }
              ]
            },
            {
              "label": "basilar-type migraine (previously complicated migraine)",
              "children": [
                {
                  "label": "transient ischemia within the distribution of the basilar artery"
                },
                {
                  "label": "bilateral vision loss"
                },
                {
                  "label": "diplopia"
                },
                {
                  "label": "vertigo"
                },
                {
                  "label": "dysarthria"
                },
                {
                  "label": "ataxia"
                },
                {
                  "label": "loss of consciousness"
                },
                {
                  "label": "focal neurologic deficit",
                  "children": [
                    {
                      "label": "may be part of the aura"
                    },
                    {
                      "label": "may occur with the headache"
                    },
                    {
                      "label": "usually transient",
                      "children": [
                        {
                          "label": "permanent deficits consequent to intracranial infarction may occur"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Migraine without aura (common migraine)",
          "children": [
            {
              "label": "65% of migraine cases"
            },
            {
              "label": "headache",
              "children": [
                {
                  "label": "global"
                },
                {
                  "label": "can last hours to days",
                  "children": [
                    {
                      "label": "not strictly unilateral"
                    }
                  ]
                }
              ]
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "tension-type headache"
                }
              ]
            }
          ]
        },
        {
          "label": "Migraine aura without headache",
          "children": [
            {
              "label": "acephalgic migraine",
              "children": [
                {
                  "label": "visual symptoms of migraine aura without an associated headache"
                }
              ]
            },
            {
              "label": "5% of migraine cases"
            },
            {
              "label": "occurs mainly in adults with a prior history (family history) of migraine with aura"
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "scintillating scotoma"
                },
                {
                  "label": "transient homonymous hemianopia without positive visual phenomena"
                },
                {
                  "label": "peripheral visual field constriction progressing to tunnel vision or complete vision loss"
                },
                {
                  "label": "episodic diplopia",
                  "children": [
                    {
                      "label": "usually vertical and accompanied by other neurologic symptoms"
                    }
                  ]
                }
              ]
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "transient ischemic attacks (TIAs)",
                  "children": [
                    {
                      "label": "symptoms typically last less than 60 minutes"
                    },
                    {
                      "label": "cerebrovascular disease"
                    }
                  ]
                },
                {
                  "label": "vascular malformation"
                },
                {
                  "label": "residual visual field defects may indicate another underlying process"
                }
              ]
            }
          ]
        }
      ]
