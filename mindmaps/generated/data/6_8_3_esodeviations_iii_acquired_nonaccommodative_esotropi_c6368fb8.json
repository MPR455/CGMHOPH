{
  "label": "6.8.3. Esodeviations (III): Acquired Nonaccommodative Esotropias",
  "root": true,
  "children": [
    {
      "label": "Basic Acquired Nonaccommodative Esotropia",
      "children": [
        {
          "label": ".> age 6 months"
        },
        {
          "label": "± acute onset",
          "children": [
            {
              "label": "precipitating factor",
              "children": [
                {
                  "label": "temporary but prolonged disruption of binocular vision",
                  "children": [
                    {
                      "label": "hyphema"
                    },
                    {
                      "label": "preseptal cellulitis"
                    },
                    {
                      "label": "mechanical ptosis"
                    },
                    {
                      "label": "prolonged patching"
                    },
                    {
                      "label": "tenuous fusion!"
                    }
                  ]
                }
              ]
            },
            {
              "label": "patient immediately becomes aware of deviation"
            },
            {
              "label": "± diplopia"
            }
          ]
        },
        {
          "label": "comitant"
        },
        {
          "label": "no accommodative component",
          "children": [
            {
              "label": "hyperopia is not significant"
            },
            {
              "label": "deviation is similar at distance and near"
            },
            {
              "label": "careful motility evaluation is important to rule out an accommodative or paretic component"
            }
          ]
        },
        {
          "label": "onset of nonaccommodative esotropia in an older child may be a sign of an underlying neurologic disorder",
          "children": [
            {
              "label": "neuroimaging and neurologic evaluation may be indicated when other symptoms or signs of neurologic abnormality are present",
              "children": [
                {
                  "label": "lateral incomitance"
                },
                {
                  "label": "deviation greater at distance than near"
                },
                {
                  "label": "abnormal head position"
                },
                {
                  "label": "diplopia"
                },
                {
                  "label": "concomitant headache"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "amblyopia treatment"
            },
            {
              "label": "surgical correction",
              "children": [
                {
                  "label": "as soon as possible after the onset of the deviation"
                }
              ]
            },
            {
              "label": "botulinum toxin injection"
            },
            {
              "label": "smaller undercorrection rate (≤10%) with surgery based on the prism-adapted angle"
            }
          ]
        },
        {
          "label": "many patients with acquired nonaccommodative esotropia have a history of normal binocular vision",
          "children": [
            {
              "label": "good prognosis for restoration of single binocular vision with prisms and/or surgery"
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Consecutive Esotropia",
      "children": [
        {
          "label": "esotropia following a history of exotropia"
        },
        {
          "label": "types",
          "children": [
            {
              "label": "spontaneous",
              "children": [
                {
                  "label": "rare"
                },
                {
                  "label": "neurologic disorders",
                  "children": [
                    {
                      "label": "cerebral palsy"
                    }
                  ]
                },
                {
                  "label": "very poor vision in 1 eye"
                }
              ]
            },
            {
              "label": "after surgery for exotropia",
              "children": [
                {
                  "label": "not uncommon"
                },
                {
                  "label": "often resolves over time",
                  "children": [
                    {
                      "label": "an initial small overcorrection is desirable after surgery for exotropia, as it is associated with an improved long-term success rate"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Treatment",
          "children": [
            {
              "label": "hyperopic correction"
            },
            {
              "label": "base-out prisms"
            },
            {
              "label": "alternating occlusion"
            },
            {
              "label": "botulinum injection"
            },
            {
              "label": "strabismus surgery",
              "children": [
                {
                  "label": "in postsurgical consecutive esotropia surgery or botulinum toxin injection should be postponed for several months",
                  "children": [
                    {
                      "label": "unless the deviation is very large or a slipped or lost muscle is suspected"
                    }
                  ]
                }
              ]
            },
            {
              "label": "slipped or lost lateral rectus muscle",
              "children": [
                {
                  "label": "varying amounts of esotropia"
                },
                {
                  "label": "should be suspected following lateral rectus recession surgery if a significant abduction deficit is present",
                  "children": [
                    {
                      "label": "if the ipsilateral medial rectus muscle was resected at the time of the lateral rectus recession, the consecutive esotropia could be due to a tight medial rectus muscle",
                      "children": [
                        {
                          "label": "forced-duction testing helps differentiate between these two causes"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "surgical exploration is required",
                  "children": [
                    {
                      "label": "for slipped muscles, the true muscle should be identified and secured back to the sclera"
                    },
                    {
                      "label": "transposition procedures may be necessary when lost muscles cannot be found"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Cyclic Esotropia",
      "children": [
        {
          "label": "rare",
          "children": [
            {
              "label": "1:3000–1:5000 strabismus cases"
            }
          ]
        },
        {
          "label": "Onset typically during preschool years"
        },
        {
          "label": "occurs intermittently, usually every other day (48-hour cycle)",
          "children": [
            {
              "label": "Variable intervals"
            },
            {
              "label": "24-hour cycles"
            }
          ]
        },
        {
          "label": "comitant"
        },
        {
          "label": "Fusion and binocular vision are usually absent/defective on strabismic day",
          "children": [
            {
              "label": "± diplopia",
              "children": [
                {
                  "label": "more prominent in older patients"
                }
              ]
            }
          ]
        },
        {
          "label": "marked improvement or normalization on orthotropic day"
        },
        {
          "label": "occlusion therapy may convert the cyclic deviation into a constant one"
        },
        {
          "label": "surgical treatment of cyclic esotropia is usually effective",
          "children": [
            {
              "label": "based on the maximum angle of deviation present when the eyes are esotropic"
            }
          ]
        }
      ]
    },
    {
      "label": "Sensory Esotropia",
      "children": [
        {
          "label": "deprivation esotropia"
        },
        {
          "label": "monocular vision loss"
        },
        {
          "label": "restoration of the best-possible visual input must be accomplished at an early age if irreversible amblyopia is to be avoided"
        },
        {
          "label": "if surgery or botulinum toxin injection is indicated for strabismus, it is generally performed only on the eye with a significant deficit"
        }
      ]
    },
