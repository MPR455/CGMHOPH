{
  "label": "Cystoid Macular Edema",
  "root": true,
  "children": [
    {
      "label": "definition",
      "children": [
        {
          "label": "intraretinal edema contained in honeycomb-like cystoid spaces"
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "abnormal perifoveal retinal capillary permeability"
        }
      ]
    },
    {
      "label": "Rare causes of cystic macular change",
      "children": [
        {
          "label": "nicotinic acid maculopathy"
        },
        {
          "label": "X-linked hereditary retinoschisis"
        },
        {
          "label": "Goldmann-Favre disease"
        },
        {
          "label": "retinitis pigmentosa"
        }
      ]
    },
    {
      "label": "imaging",
      "children": [
        {
          "label": "fluorescein angiography",
          "children": [
            {
              "label": "multiple small focal fluorescein leaks and late pooling of the dye in extracellular cystoid spaces"
            },
            {
              "label": "“flower-petal” (petaloid) pattern"
            }
          ]
        },
        {
          "label": "OCT",
          "children": [
            {
              "label": "diffuse retinal thickening with cystic areas of low reflectivity",
              "children": [
                {
                  "label": "more prominently in the inner nuclear and outer plexiform layers"
                }
              ]
            },
            {
              "label": "subretinal fluid accumulation"
            }
          ]
        }
      ]
    },
    {
      "label": "Incidence",
      "children": [
        {
          "label": "cataract surgery",
          "children": [
            {
              "label": "intracapsular lens extraction",
              "children": [
                {
                  "label": "60%"
                }
              ]
            },
            {
              "label": "Intraocular lens implantation at the time of extracapsular surgery does not appear to increase the incidence of CME"
            },
            {
              "label": "peak incidence 6–10 weeks postoperatively"
            },
            {
              "label": "spontaneous resolution in ≈ 95%",
              "children": [
                {
                  "label": "usually within 6 months"
                }
              ]
            },
            {
              "label": "2 types",
              "children": [
                {
                  "label": "clinical CME",
                  "children": [
                    {
                      "label": "severe cases",
                      "children": [
                        {
                          "label": "vitreous cells"
                        },
                        {
                          "label": "optic nerve head swelling"
                        },
                        {
                          "label": "permanent vision loss"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "angiographic CME",
                  "children": [
                    {
                      "label": "apparent only on fluorescein angiography"
                    },
                    {
                      "label": "mild and asymptomatic"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "predisposing factors after cataract surgery",
          "children": [
