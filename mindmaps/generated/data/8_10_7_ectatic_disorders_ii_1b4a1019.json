{
  "label": "8.10.7. Ectatic Disorders (II)",
  "root": true,
  "children": [
    {
      "label": "Pellucid Marginal Degeneration",
      "children": [
        {
          "label": "uncommon"
        },
        {
          "label": "nonhereditary",
          "children": [
            {
              "label": "similar to keratoconus & keratoglobus"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "bilateral"
            },
            {
              "label": "diagnosis between 20-40 years of age"
            },
            {
              "label": "inferior, peripheral corneal thinning",
              "children": [
                {
                  "label": "inferior corneal steepening",
                  "children": [
                    {
                      "label": "Similar to KCS"
                    },
                    {
                      "label": "“lobster claw” pattern"
                    }
                  ]
                }
              ]
            },
            {
              "label": "decreased vision",
              "children": [
                {
                  "label": "high irregular astigmatism"
                }
              ]
            },
            {
              "label": "± posterior stromal scarring within thinned area"
            },
            {
              "label": "absence of inflammation"
            },
            {
              "label": "no vascularization or lipid deposition"
            },
            {
              "label": "acute hydrops",
              "children": [
                {
                  "label": "has been reported"
                }
              ]
            },
            {
              "label": "spontaneous corneal perforation",
              "children": [
                {
                  "label": "rare"
                }
              ]
            },
            {
              "label": "at times, a clear distinction between pellucid marginal degeneration and keratoconus is not possible",
              "children": [
                {
                  "label": "keratoconus",
                  "children": [
                    {
                      "label": "protrusion is at the point of maximal thinning"
                    }
                  ]
                },
                {
                  "label": "pellucid marginal degeneration",
                  "children": [
                    {
                      "label": "protrusion is above area of maximum thinning"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "contact lenses",
              "children": [
                {
                  "label": "hybrid (gas-permeable contact lenses with a soft lens “skirt”)",
                  "children": [
                    {
                      "label": "lens fitting is more difficult in pellucid marginal degeneration than in keratoconus"
                    }
                  ]
                },
                {
                  "label": "scleral lenses"
                }
              ]
            },
            {
              "label": "PK",
              "children": [
                {
                  "label": "grafts tend to be large and close to the limbus",
                  "children": [
                    {
                      "label": "technically more difficult"
                    },
                    {
                      "label": "graft more prone to rejection"
                    }
                  ]
                }
              ]
            },
            {
              "label": "wedge resection"
            },
            {
              "label": "lamellar tectonic grafts"
            },
            {
              "label": "collagen crosslinking"
            }
          ]
        }
      ]
    },
    {
      "label": "Keratoglobus",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "very rare",
              "children": [
                {
                  "label": "similar to keratoconus & PMD"
                }
              ]
            },
            {
              "label": "not hereditary"
            },
            {
              "label": "associations",
              "children": [
                {
                  "label": "blue sclerae",
                  "children": [
                    {
                      "label": "Ehlers-Danlos syndrome type VI"
                    }
                  ]
                },
                {
                  "label": "may represent a defect in collagen synthesis"
                },
                {
                  "label": "unlike keratoconus, keratoglobus is not associated with atopy and hard contact lens wear"
                }
              ]
            }
          ]
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "absent/fragmented Bowman layer"
            },
            {
              "label": "thinned stroma with normal lamellar organization",
              "children": [
                {
                  "label": "in contrast to keratoconus and pellucid marginal degeneration",
                  "children": [
                    {
                      "label": "in contrast to keratoconus, which has maximal thinning at or near the apex of the protrusion"
                    }
                  ]
                }
              ]
            },
            {
              "label": "thin Descemet membrane"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "present at birth"
            },
            {
              "label": "bilateral"
            },
            {
              "label": "globular corneal deformation",
              "children": [
                {
                  "label": "generalized thinning",
                  "children": [
                    {
                      "label": "especially in midperiphery"
                    }
                  ]
                },
                {
                  "label": "steep cornea",
                  "children": [
                    {
                      "label": "corneal curvature may be as steep as 50–60 D"
                    }
                  ]
                }
              ]
            },
            {
              "label": "very deep anterior chamber"
            },
            {
              "label": "corneal diameter may be slightly increased",
              "children": [
                {
                  "label": "iron lines/Fleischer rings, stress lines, and anterior scarring are not seen"
                }
              ]
            },
            {
              "label": "corneal hydrops",
              "children": [
                {
                  "label": "can occur"
                },
                {
                  "label": "spontaneous rupture of the Descemet membrane"
                }
              ]
            },
            {
              "label": "spontaneous corneal rupture",
              "children": [
                {
                  "label": "has been reported"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "spectacles",
              "children": [
                {
                  "label": "for high myopia",
                  "children": [
                    {
                      "label": "to prevent amblyopia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "contact lenses",
              "children": [
                {
                  "label": "scleral lenses"
                }
              ]
            },
            {
              "label": "PK",
              "children": [
                {
                  "label": "prognosis for PK is much poorer in keratoglobus than in other ectasias"
                }
              ]
            },
            {
              "label": "lamellar tectonic graft followed by PK"
            },
            {
              "label": "protective eyewear"
            }
          ]
        }
      ]
    }
  ],
