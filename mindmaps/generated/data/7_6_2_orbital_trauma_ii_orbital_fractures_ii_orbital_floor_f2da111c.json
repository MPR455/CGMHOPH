{
  "label": "7.6.2. Orbital Trauma (II): Orbital Fractures (II): Orbital Floor Fractures",
  "root": true,
  "children": [
    {
      "label": "types",
      "children": [
        {
          "label": "direct fractures",
          "children": [
            {
              "label": "extend from fractures of the inferior orbital rim"
            }
          ]
        },
        {
          "label": "Indirect fractures",
          "children": [
            {
              "label": "not associated with fracture of the inferior orbital rim"
            }
          ]
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "CT with coronal or sagittal views",
          "children": [
            {
              "label": "helps guide treatment",
              "children": [
                {
                  "label": "fracture size"
                },
                {
                  "label": "extraocular muscle relationships"
                },
                {
                  "label": "information to predict enophthalmos and muscle entrapment"
                },
                {
                  "label": "restrictive strabismus related to blowout fracture remains a clinical diagnosis"
                }
              ]
            }
          ]
        },
        {
          "label": "observation",
          "children": [
            {
              "label": "most blowout or other orbital floor fractures do not require surgical intervention"
            },
            {
              "label": "when orbital swelling/hemorrhage are present observe x 5–10 days"
            },
            {
              "label": "oral steroids (1 mg/kg per day x 7 days)",
              "children": [
                {
                  "label": "may help hasten the decision of whether surgery for diplopia is necessary"
                }
              ]
            }
          ]
        },
        {
          "label": "urgent surgical repair",
          "children": [
            {
              "label": "exception to initial observation occurs in pediatric patients",
              "children": [
                {
                  "label": "inferior rectus muscle may become tightly trapped beneath a trapdoor fracture",
                  "children": [
                    {
                      "label": "vertical globe excursion is significantly limited"
                    },
                    {
                      "label": "CT reveals inferior rectus muscle within the maxillary sinus"
                    },
                    {
                      "label": "eye movement may stimulate the oculocardiac reflex",
                      "children": [
                        {
                          "label": "pain"
                        },
                        {
                          "label": "nausea"
                        },
                        {
                          "label": "bradycardia"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "general indications for surgery",
          "children": [
            {
              "label": "diplopia with the following",
              "children": [
                {
                  "label": "limitation of upgaze and/or downgaze within 30° of the primary position"
                },
                {
                  "label": "positive forced duction test after resolution of the edema"
                },
                {
                  "label": "radiologic confirmation of an orbital floor fracture"
                },
                {
                  "label": "indicate functional entrapment of tissues affecting the inferior rectus muscle",
                  "children": [
                    {
                      "label": "diplopia may improve significantly over the course of the first 2 weeks"
                    },
                    {
                      "label": "if findings are still present >2 weeks and if entrapped tissues are not freed, vertical diplopia is likely to persist"
                    }
                  ]
                }
              ]
            },
            {
              "label": "enophthalmos >2 mm and cosmetically unacceptable to the patient",
              "children": [
                {
                  "label": "if significant enophthalmos is present within the first 2 weeks in association with a large orbital floor fracture, greater enophthalmos can be anticipated in the future"
                }
              ]
            },
            {
              "label": "large fractures involving at least half of the orbital floor, particularly when associated with large medial wall fractures (determined by CT)",
              "children": [
                {
                  "label": "high incidence of subsequent significant enophthalmos"
                },
                {
                  "label": "usually repaired as part of initial management"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "increased intraorbital pressure when the impact of a blunt object rapidly occludes the orbital aperture",
          "children": [
            {
              "label": "the orbital bones break at their weakest point"
            }
          ]
        },
        {
          "label": "impacting object compresses the inferior rim, directly buckling the orbital floor",
          "children": [
            {
              "label": "degree of increased orbital pressure determines whether orbital tissues are pushed down through the fracture"
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "eyelid signs",
          "children": [
            {
              "label": "ecchymosis"
            },
            {
              "label": "edema"
            },
            {
              "label": "signs of injury can be absent",
              "children": [
                {
                  "label": "white-eyed blowout"
                }
              ]
            }
          ]
        },
        {
          "label": "entrapment of the inferior rectus muscle or its adjacent septa in the fracture",
          "children": [
            {
              "label": "vertical diplopia"
            },
            {
              "label": "limitation of upgaze, downgaze, or both"
            },
            {
              "label": "pain in the inferior orbit on attempted vertical movement of the globe"
            },
            {
              "label": "tests for muscle entrapment",
              "children": [
                {
                  "label": "forced duction test (traction test)",
                  "children": [
                    {
                      "label": "restriction of passive movement of the eye"
                    }
                  ]
                },
                {
                  "label": "increase in intraocular pressure (IOP) in upgaze"
                }
              ]
            }
          ]
        },
        {
          "label": "significant limitation of both horizontal and vertical eye movements",
          "children": [
            {
              "label": "nerve damage"
            },
            {
              "label": "damage to the extraocular muscles"
            },
            {
              "label": "generalized soft tissue injury",
              "children": [
                {
                  "label": "orbital edema and hemorrhage",
                  "children": [
                    {
                      "label": "generally improves during the first 1–2 weeks after injury"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "enophthalmos and ptosis of the globe",
          "children": [
            {
              "label": "occur with large orbitral floor fractures"
            },
            {
              "label": "associated medial wall fracture may significantly contribute to enophthalmos"
            },
            {
              "label": "may be masked by orbital edema immediately following the injury"
            }
          ]
        },
        {
          "label": "hypoesthesia in the distribution of the infraorbital nerve"
        },
        {
          "label": "emphysema of the orbit and eyelids",
          "children": [
            {
              "label": "fractures that extends into a sinus",
              "children": [
                {
                  "label": "most commonly with medial wall fractures"
                },
                {
                  "label": "patients with fractures are advised to avoid nose blowing"
                }
              ]
            }
          ]
        },
        {
          "label": "vision loss",
          "children": [
            {
              "label": "globe trauma"
            },
            {
              "label": "injury to the optic nerve"
            },
            {
              "label": "increased orbital pressure causing a compartment syndrome",
              "children": [
                {
                  "label": "orbital hemorrhage should be suspected if loss of vision is associated with proptosis and increased IOP"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Surgical management of orbital fractures",
      "children": [
        {
          "label": "preferable to proceed with the repair within 2 weeks of the initial trauma",
          "children": [
            {
              "label": "contracture of prolapsed tissue makes later correction of diplopia difficult"
            },
            {
              "label": "larger fractures in which eventual enophthalmos is anticipated are also more easily repaired within the first 2 weeks of trauma",
              "children": [
                {
                  "label": "satisfactory correction of enophthalmos is often obtainable even if surgery is delayed"
                }
              ]
            }
          ]
        },
        {
          "label": "surgical steps for correction of blowout fractures of orbital floor",
          "children": [
            {
              "label": "surgical approach",
              "children": [
                {
                  "label": "infraciliary incision"
                },
                {
                  "label": "conjunctival (inferior fornix) incision"
                },
                {
                  "label": "± lateral canthotomy and inferior cantholysis"
                }
              ]
            },
            {
              "label": "elevation of the periorbita"
            },
            {
              "label": "release of the prolapsed tissues"
            },
            {
              "label": "placement of an implant over the fracture",
              "children": [
                {
                  "label": "alloplastic",
                  "children": [
                    {
                      "label": "porous polyethylene"
                    },
                    {
                      "label": "nylon foil"
                    },
                    {
                      "label": "polytetrafluoroethylene"
                    },
                    {
                      "label": "silicone sheet"
                    },
                    {
                      "label": "titanium mesh"
                    }
                  ]
                },
                {
                  "label": "autogenous",
                  "children": [
                    {
                      "label": "split cranial bone"
                    },
                    {
                      "label": "iliac crest bone"
                    },
                    {
                      "label": "fascia"
                    },
                    {
                      "label": "bone grafts are rarely indicated"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "delayed treatment of blowout fractures",
          "children": [
            {
              "label": "orbital floor exploration to free scarred tissues entrapped/prolapsed through the fracture",
              "children": [
                {
                  "label": "debilitating strabismus and diplopia",
                  "children": [
                    {
                      "label": "strabismus surgery"
                    }
                  ]
                },
                {
                  "label": "cosmetically unacceptable enophthalmos",
                  "children": [
                    {
                      "label": "± placement of an implant to reposition the globe anteriorly or superiorly"
                    },
                    {
                      "label": "procedures to camouflage the narrowed palpebral fissure and deep superior sulcus"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "complications of blowout fracture surgery",
          "children": [
            {
              "label": "decreased vision or blindness"
            },
            {
              "label": "persistent or new diplopia"
            },
            {
              "label": "undercorrection or overcorrection of enophthalmos"
            },
            {
              "label": "retraction of the lower eyelid"
            },
            {
              "label": "hypoesthesia of the infraorbital nerve"
            },
            {
              "label": "infection"
            },
            {
              "label": "early or late extrusion of the implant"
            },
            {
              "label": "lymphedema"
            }
          ]
        }
      ]
    },
    {
      "label": "history",
      "children": [
        {
          "label": "orbital entrance being struck by an object larger than the diameter of the orbital opening"
        },
        {
          "label": "an orbital blowout fracture should be suspected in any patient who has received a periorbital blow forceful enough to cause ecchymosis"
        }
      ]
    }
  ],
