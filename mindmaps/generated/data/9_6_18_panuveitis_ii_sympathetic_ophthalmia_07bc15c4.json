{
  "label": "9.6.18. Panuveitis (II): Sympathetic Ophthalmia",
  "root": true,
  "children": [
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "earlier estimates of the incidence of SO",
          "children": [
            {
              "label": "≤0.5% in eyes with nonsurgical trauma and 10/100,000 after intraocular surgery"
            }
          ]
        },
        {
          "label": "M=F",
          "children": [
            {
              "label": "most recent minimum incidence estimate is low (0.03/100,000)"
            },
            {
              "label": "lower risk in children"
            }
          ]
        },
        {
          "label": "increased risk in older patients"
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "until recently, penetrating ocular injury was the most common precipitating event"
        },
        {
          "label": "ocular surgery—particularly vitreoretinal surgery—is now the main precipitating event",
          "children": [
            {
              "label": "in the early 1980s",
              "children": [
                {
                  "label": "0.01% after pars plana vitrectomy"
                }
              ]
            },
            {
              "label": "recent studies",
              "children": [
                {
                  "label": "risk of developing SO following pars plana vitrectomy is >2x this figure",
                  "children": [
                    {
                      "label": "0.06% after vitrectomy in the context of penetrating ocular injuriy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "surgery or penetrating ocular injury complicated by incarceration of uveal tissue",
          "children": [
            {
              "label": "exposure of uveoretinal antigens to conjunctival lymphatic channels",
              "children": [
                {
                  "label": "altered T-lymphocyte response to previously sequestered ocular self-antigens (derived from the RPE or choroid)"
                }
              ]
            }
          ]
        },
        {
          "label": "genetic predisposition",
          "children": [
            {
              "label": "HLA-DR4, -DRw53, and -DQw3"
            },
            {
              "label": "immunogenetics of SO and VKH syndrome are virtually identical"
            }
          ]
        },
        {
          "label": "latent period after surgery/injury",
          "children": [
            {
              "label": "80% within 3 months of injury"
            },
            {
              "label": "90% within 1 year"
            },
            {
              "label": "in a recent series",
              "children": [
                {
                  "label": "only 1/3 within 3 months"
                },
                {
                  "label": "<1/2 within 1 year"
                }
              ]
            }
          ]
        },
        {
          "label": "enucleation within 2 weeks of injury to prevent SO should be considered in patients with grossly disorganized globes with no discernible visual function"
        },
        {
          "label": "enucleation preferred to evisceration for the removal of ocular contents in severely injured eyes"
        }
      ]
    },
    {
      "label": "diagnostic tests",
      "children": [
        {
          "label": "FA",
          "children": [
            {
              "label": "acute stage",
              "children": [
                {
                  "label": "multiple hyperfluorescent sites of leakage at the level of the RPE during the venous phase"
                }
              ]
            },
            {
              "label": "pooling of dye beneath areas of exudative retinal detachment"
            },
            {
              "label": "Dalen-Fuchs lesions may appear hypofluorescent early in the study or hyperfluorescent with late staining"
            }
          ]
        },
        {
          "label": "ICG angiography",
          "children": [
            {
              "label": "numerous hypofluorescent foci",
              "children": [
                {
                  "label": "intermediate phase of the angiogram"
                },
                {
                  "label": "may become isofluorescent in the late stage"
                }
              ]
            }
          ]
        },
        {
          "label": "OCT imaging",
          "children": [
            {
              "label": "shallow, serous retinal detachment"
            },
            {
              "label": "intraretinal edema"
            }
          ]
        },
        {
          "label": "B-scan ultrasonography",
          "children": [
            {
              "label": "choroidal thickening"
            }
          ]
        }
      ]
    },
    {
      "label": "pathology",
      "children": [
        {
          "label": "similar for both the exciting and sympathizing eyes"
        },
        {
          "label": "diffuse, granulomatous, nonnecrotizing inflammation",
          "children": [
            {
              "label": "spares the choriocapillaris in the early stage"
            }
          ]
        },
        {
          "label": "Dalen-Fuchs nodules",
          "children": [
            {
              "label": "1//3",
              "children": [
                {
                  "label": "clusters of epithelioid cells located between RPE and Bruch membrane"
                },
                {
                  "label": "not specific to SO",
                  "children": [
                    {
                      "label": "also in VKH syndrome and sarcoidosis"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "TB, sarcoidosis, syphilis, fungal infections, traumatic or postoperative endophthalmitis"
        },
        {
          "label": "lens-associated uveitis",
          "children": [
            {
              "label": "reported with SO in ≤25% of cases"
            }
          ]
        },
        {
          "label": "VKH syndrome",
          "children": [
            {
              "label": "clinical presentations of SO and VKH syndrome may be strikingly similar"
            },
            {
              "label": "history of prior ocular injury is by definition absent in patients with VKH syndrome",
              "children": [
                {
                  "label": "clinical course"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "once SO has become established, enucleation of the exciting eye will not alter the disease course",
          "children": [
            {
              "label": "exciting eye may eventually become the better-seeing eye!"
            }
          ]
        },
        {
          "label": "systemic corticosteroids"
        },
        {
          "label": "IMT",
          "children": [
            {
              "label": "corticosteroid-sparing drugs"
            }
          ]
        },
        {
          "label": "topical corticosteroids"
        },
        {
          "label": "cycloplegic and mydriatic agents"
        },
        {
          "label": "periocular corticosteroids",
          "children": [
            {
              "label": "to manage inflammatory recurrences and CME",
              "children": [
                {
                  "label": "treatment of the acute anterior uveitis"
                }
              ]
            }
          ]
        },
        {
          "label": "intravitreal corticosteroids",
          "children": [
            {
              "label": "patients intolerant of systemic corticosteroid therapy"
            }
          ]
        },
        {
          "label": "intravitreal fluocinolone acetonide implant"
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "asymmetric bilateral",
          "children": [
            {
              "label": "exciting eye"
            },
            {
              "label": "latent period"
            },
            {
              "label": "sympathizing eye"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "minimal problems in near vision, mild photophobia, and slight redness to severe granulomatous anterior uveitis"
            }
          ]
        },
        {
          "label": "diffuse, granulomatous, nonnecrotizing panuveitis"
        },
        {
          "label": "anterior segment findings",
          "children": [
            {
              "label": "mutton-fat KPs",
              "children": [
                {
                  "label": "exciting eye exhibits more severe inflammation than the sympathizing eye, at least initially"
                }
              ]
            },
            {
              "label": "thickening of the iris"
            },
            {
              "label": "posterior synechiae"
            },
            {
              "label": "elevated IOP due to trabeculitis"
            },
            {
              "label": "hypotony as a result of ciliary body shutdown"
            }
          ]
        },
        {
          "label": "posterior segment findings",
          "children": [
            {
              "label": "moderate to severe vitritis"
            },
            {
              "label": "yellowish white, midequatorial choroidal lesions (Dalen-Fuchs nodules)",
              "children": [
                {
                  "label": "may become confluent"
                }
              ]
            },
            {
              "label": "peripapillary choroidal lesions"
            },
            {
              "label": "exudative retinal detachment"
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "cataract"
            },
            {
              "label": "chronic CME"
            },
            {
              "label": "peripapillary and macular CNV"
            },
            {
              "label": "optic atrophy"
            },
            {
              "label": "new complications in the sympathizing eye develop at a rate of 40% per person-year",
              "children": [
                {
                  "label": "traumatic etiology"
                }
              ]
            }
          ]
        },
        {
          "label": "risk factors for poor vision in the sympathizing eye",
          "children": [
            {
              "label": "active intraocular inflammation"
            }
          ]
        },
        {
          "label": "extraocular findings similar to VKH syndrome",
          "children": [
            {
              "label": "cerebral spinal fluid pleocytosis",
              "children": [
                {
                  "label": "exudative retinal detachment"
                }
              ]
            },
            {
              "label": "sensory neural hearing disturbance"
            },
            {
              "label": "alopecia"
            },
            {
              "label": "poliosis"
            },
            {
              "label": "vitiligo",
              "children": [
                {
                  "label": "uncommon"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "clinical course & prognosis",
      "children": [
        {
          "label": "chronic with frequent exacerbations"
        },
        {
          "label": "untreated leads to loss of vision and phthisis bulbi"
        },
        {
          "label": "with prompt and aggressive systemic therapy, the visual prognosis is good in the sympathizing eye",
          "children": [
            {
              "label": "60% of patients achieve a final visual acuity of 20/40"
            },
            {
