    {
      "label": "Defense Mechanisms of the External Eye",
      "children": [
        {
          "label": "blinking",
          "children": [
            {
              "label": "10–15 blinks per minute"
            },
            {
              "label": "prevents desiccation of the ocular surface"
            },
            {
              "label": "promotes tear turnover"
            }
          ]
        },
        {
          "label": "ocular surface epithelium forms a tight mechanical barrier against microbial invasion"
        },
        {
          "label": "rapid cycling of epithelial cells aids in the expulsion of microbes"
        },
        {
          "label": "tear-soluble macromolecules with antimicrobial properties",
          "children": [
            {
              "label": "tear lysozyme",
              "children": [
                {
                  "label": "degrades bacterial cell walls"
                }
              ]
            },
            {
              "label": "β-lysin",
              "children": [
                {
                  "label": "disrupts bacterial plasma membranes"
                }
              ]
            },
            {
              "label": "lactoferrin",
              "children": [
                {
                  "label": "inhibits bacterial metabolism"
                }
              ]
            },
            {
              "label": "immunoglobulins",
              "children": [
                {
                  "label": "secretory IgA",
                  "children": [
                    {
                      "label": "antigen-specific immunity"
                    }
                  ]
                },
                {
                  "label": "classic and alternative complement pathways"
                }
              ]
            },
            {
              "label": "Meibomian gland–derived lipids",
              "children": [
                {
                  "label": "reduce evaporation of the tear"
                }
              ]
            },
            {
              "label": "Mucins",
              "children": [
                {
                  "label": "inhibit attachment of microbes"
                }
              ]
            },
            {
              "label": "Cytokines",
              "children": [
                {
                  "label": "epidermal growth factor (EGF)"
                },
                {
                  "label": "transforming growth factor βs (TGF-βs)"
                },
                {
                  "label": "hepatocyte growth factor (HGF)"
                }
              ]
            }
          ]
        },
