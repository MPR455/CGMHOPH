{
  "label": "10.6.5. Childhood Glaucoma (V): Medical Management",
  "root": true,
  "children": [
    {
      "label": "medications can be used",
      "children": [
        {
          "label": "surgical management is the mainstay of PCG care"
        },
        {
          "label": "to lower IOP before surgery",
          "children": [
            {
              "label": "to reduce corneal edema and improve visualization"
            }
          ]
        },
        {
          "label": "to provide additional IOP lowering after surgical procedures"
        },
        {
          "label": "for forms of childhood glaucoma other than PCG",
          "children": [
            {
              "label": "JOAG"
            },
            {
              "label": "inflammatory glaucoma"
            },
            {
              "label": "aphakic glaucoma"
            },
            {
              "label": "other secondary glaucomas"
            }
          ]
        }
      ]
    },
    {
      "label": "crosses the blood–brain barrier and therefore has significant effects on the central nervous system",
      "children": [
        {
          "label": "apnea"
        },
        {
          "label": "CNS side effects",
          "children": [
            {
              "label": "hypotension"
            },
            {
              "label": "bradycardia"
            },
            {
              "label": "hypotonia"
            },
            {
              "label": "hypothermia"
            },
            {
              "label": "somnolence"
            }
          ]
        }
      ]
    },
    {
      "label": "α-Adrenergic agonists",
      "children": [
        {
          "label": "mechanism of action",
          "children": [
            {
              "label": "reduce aqueous production"
            },
            {
              "label": "α2-adrenergic agonist",
              "children": [
                {
                  "label": "increase uveoscleral outflow"
                }
              ]
            }
          ]
        },
        {
          "label": "brimonidine",
          "children": [
            {
              "label": "crosses the blood–brain barrier"
            },
            {
              "label": "caution in children 3-10 years",
              "children": [
                {
                  "label": "contraindicated in children <3 years"
                },
                {
                  "label": "use lowest dose"
                },
                {
                  "label": "use punctal occlusion"
                }
              ]
            }
          ]
        },
        {
          "label": "greater affinity for α1-receptors than brimonidine"
        },
        {
          "label": "apraclonidine",
          "children": [
            {
              "label": "better tolerated systemically in children"
            },
            {
              "label": "risk of follicular conjunctivitis",
              "children": [
                {
                  "label": "increases with long-term use"
                }
              ]
            },
            {
              "label": "vasoconstrictor",
              "children": [
                {
                  "label": "can be used to minimize bleeding during surgery"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "β-Adrenergic antagonists (blockers)",
      "children": [
        {
          "label": "decrease aqueous production"
        },
        {
          "label": "first-line therapy for glaucoma in children"
        },
        {
          "label": "systemic complications",
          "children": [
            {
              "label": "bronchospasm"
            },
            {
              "label": "bradycardia"
            },
            {
              "label": "hypotension"
            },
            {
              "label": "avoid in children with asthma or significant cardiac disease"
            },
            {
              "label": "risk of adverse effects can be diminished by",
              "children": [
                {
                  "label": "occluding the nasolacrimal drainage system for 3 minutes after administration of the medication"
                },
                {
                  "label": "prescribing timolol 0.25% or levobunolol 0.25%",
                  "children": [
                    {
                      "label": "patients with lighter irides respond as well to 0.25% solutions"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "less selective α2-adrenergic action than brimonidine"
    },
    {
      "label": "Cholinergic agonists",
      "children": [
        {
          "label": "increase aqueous outflow through the trabecular meshwork"
        },
        {
          "label": "rarely used on a long-term basis"
        },
        {
          "label": "induce miosis",
          "children": [
            {
              "label": "facilitate angle surgery"
            }
          ]
        }
      ]
    },
    {
      "label": "brinzolamide"
    },
    {
      "label": "Carbonic anhydrase inhibitors",
      "children": [
        {
          "label": "reduce aqueous production"
        },
        {
          "label": "topical",
          "children": [
            {
              "label": "dorzolamide",
              "children": [
                {
                  "label": "no BAK-free"
                }
              ]
            },
            {
              "label": "minimal systemic side effects"
            },
            {
              "label": "second-line therapy after topical β-adrenergic antagonists"
            },
            {
              "label": "some concern in eyes with compromised corneas or after corneal transplantation",
              "children": [
                {
                  "label": "not absolute contraindications"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic",
          "children": [
            {
              "label": "acetazolamide"
