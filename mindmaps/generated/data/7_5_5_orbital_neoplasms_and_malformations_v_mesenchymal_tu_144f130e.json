                  "label": "osteosarcoma",
                  "children": [
                    {
                      "label": "destroy normal bone and have characteristic calcifications visible in radiographs and CT scans"
                    }
                  ]
                }
              ]
            },
            {
              "label": "rarely involve orbit"
            },
            {
              "label": "children with bilateral retinoblastoma are at higher risk for osteosarcoma, chondrosarcoma, or fibrosarcoma",
              "children": [
                {
                  "label": "even if they have not been treated with therapeutic radiation"
                }
              ]
            }
          ]
        }
