            },
            {
              "label": "may metastasize if incompletely excised"
            }
          ]
        },
        {
          "label": "fibrous dysplasia",
          "children": [
            {
              "label": "benign developmental disorder of bone"
            },
            {
              "label": "may involve a single region or be polyostotic"
            },
            {
              "label": "CT",
              "children": [
                {
                  "label": "hyperostotic bone"
                }
              ]
            },
            {
              "label": "MRI",
              "children": [
                {
                  "label": "lack of dural enhancement distinguishes this condition from meningioma"
                }
              ]
            },
            {
              "label": "Albright syndrome",
              "children": [
                {
                  "label": "cutaneous pigmentation"
                },
                {
                  "label": "endocrine disorders"
                },
                {
                  "label": "fibrous dysplasia"
                }
              ]
            },
