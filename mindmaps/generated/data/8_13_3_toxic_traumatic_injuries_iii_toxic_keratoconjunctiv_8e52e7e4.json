{
  "label": "8.13.3. Toxic & Traumatic Injuries (III): Toxic Keratoconjunctivitis",
  "root": true,
  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "one of the most toxic ingredients is the preservative",
          "children": [
            {
              "label": "benzalkonium chloride"
            },
            {
              "label": "loss of microvillae",
              "children": [
                {
                  "label": "residual amounts of preservatives are detectable in the epithelium days after a single topical application"
                }
              ]
            }
          ]
        },
        {
          "label": "toxic effects on the epithelium include",
          "children": [
            {
              "label": "plasma membrane disruption"
            },
            {
              "label": "subsequent cell death"
            }
          ]
        },
        {
          "label": "topical anesthetics can be toxic if used for prolonged periods",
          "children": [
            {
              "label": "frank epithelial loss"
            },
            {
              "label": "stromal edema"
            },
            {
              "label": "ring infiltrate"
            },
            {
              "label": "focal infiltrate"
            },
            {
              "label": "corneal opacities"
            },
            {
              "label": "even a single application of a topical anesthetic may cause transient epithelial irregularity"
            }
          ]
        }
      ]
    },
    {
      "label": "chronic follicular conjunctivitis",
      "children": [
        {
          "label": "both the upper and lower palpebral conjunctivae",
          "children": [
            {
              "label": "most prominent on the inferior tarsus and fornix"
            }
          ]
        },
        {
          "label": "bulbar follicles are uncommon but highly suggestive of a toxic etiology"
        },
        {
          "label": "+- inferior punctate epithelial erosions"
        },
        {
          "label": "medications",
          "children": [
            {
              "label": "cycloplegics",
              "children": [
                {
                  "label": "atropine, homatropine"
                }
              ]
            },
            {
              "label": "miotics",
              "children": [
                {
                  "label": "pilocarpine"
                }
              ]
            },
            {
              "label": "α-agonists",
              "children": [
                {
                  "label": "epinephrine (including dipivefrin)"
                },
                {
                  "label": "apraclonidine"
                },
                {
                  "label": "α2-adrenergic agonists (brimonidine)"
                }
              ]
            },
            {
              "label": "vasoconstrictors"
            },
            {
              "label": "sulfonamides"
            },
            {
              "label": "antiviral agents"
            }
          ]
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "See Table 13-2"
        },
        {
          "label": "punctate staining or erosive changes of conjunctival and corneal epithelium"
        },
        {
          "label": "conjunctival reaction",
          "children": [
            {
              "label": "follicular response"
            },
            {
              "label": "papillary reaction"
            }
          ]
        },
        {
          "label": "immune response",
          "children": [
            {
              "label": "subepithelial corneal infiltrates"
            }
          ]
        }
      ]
    },
    {
      "label": "general clinical features",
      "children": [
        {
          "label": "generally after long-term use (weeks to months)",
          "children": [
            {
              "label": "sooner in individuals with delayed tear clearance",
              "children": [
                {
                  "label": "aqueous tear deficiency"
                },
                {
                  "label": "tear drainage obstruction"
                }
              ]
            }
          ]
        },
        {
          "label": "infrequently, the reaction occurs in only 1 eye even though the medication has been applied to both"
        },
        {
          "label": "generalized injection of the tarsal and bulbar conjunctiva"
        },
        {
          "label": "papillary reaction of the tarsal conjunctiva"
        },
        {
          "label": "mucopurulent discharge",
          "children": [
            {
              "label": "may be severe and mimic bacterial conjunctivitis"
            }
          ]
        }
      ]
    },
    {
      "label": "drug-induced cicatricial pemphigoid",
      "children": [
        {
          "label": "increased number of chronic inflammatory cells and fibroblasts in conjunctiva",
          "children": [
            {
              "label": "asymptomatic subconjunctival fibrosis is not uncommon"
            }
          ]
        },
        {
          "label": "small minority will develop progressive severe subconjunctival scarring",
          "children": [
            {
              "label": "contraction of the conjunctival fornix"
            },
            {
              "label": "symblepharon formation"
            },
            {
              "label": "corneal pannus formation"
            }
          ]
        },
        {
          "label": "most common with the long-term use of miotics",
          "children": [
            {
              "label": "toxic reactions can lead to irreversible changes"
            }
          ]
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "discontinuation of topical medications",
          "children": [
            {
              "label": "may take months to resolve completely",
              "children": [
                {
                  "label": "failure of symptoms and signs to resolve within days to a few weeks is not inconsistent with a toxic etiology"
                }
              ]
            }
          ]
        },
        {
          "label": "nonpreserved topical lubricant drops or ointment"
        },
        {
          "label": "drug-induced pemphigoid",
          "children": [
            {
              "label": "conjunctival biopsy",
              "children": [
                {
                  "label": "diffuse, nonlinear immunofluorescent staining"
                }
              ]
            },
            {
              "label": "discontinue offending medication",
              "children": [
                {
                  "label": "lag of weeks-months before progressive scarring can be stabilized",
                  "children": [
                    {
                      "label": "if progression despite discontinuation of the medication, chemotherapy may be necessary"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "toxic keratitis",
      "children": [
        {
          "label": "mild form",
          "children": [
            {
              "label": "punctate epithelial erosions of the inferior cornea"
            }
          ]
        },
        {
          "label": "more severe form",
          "children": [
            {
              "label": "diffuse punctate epitheliopathy",
              "children": [
                {
                  "label": "occasionally in a whorl pattern (vortex or hurricane keratopathy)"
                }
              ]
            }
          ]
        },
        {
          "label": "most severe form",
          "children": [
            {
              "label": "corneal epithelial defect of the inferior or central cornea"
            },
            {
              "label": "stromal opacification"
            },
            {
              "label": "neovascularization"
            },
            {
              "label": "limbal stem cell deficiency",
              "children": [
                {
                  "label": "effacement of the palisades of vogt"
                }
              ]
            }
          ]
        },
        {
          "label": "different type of toxic keratitis",
          "children": [
            {
              "label": "peripheral corneal infiltrates (epithelium and anterior stroma)",
              "children": [
                {
                  "label": "clear zone between infiltrates and limbus"
                }
              ]
            }
          ]
        },
        {
          "label": "medications",
          "children": [
            {
              "label": "prolonged use of preservative-containing medications",
              "children": [
                {
                  "label": "benzalkonium chloride"
                },
                {
                  "label": "thimerosal"
                }
              ]
            },
            {
              "label": "aminoglycoside antibiotics"
            },
            {
              "label": "antiviral agents"
            },
            {
              "label": "antifibrotic agents (eg, topical mitomycin c drops)",
              "children": [
                {
                  "label": "have radiomimetic effect on surrounding cells"
                },
                {
                  "label": "even when used in correct dosages for brief periods"
                },
                {
                  "label": "localized application of mitomycin (cellulose surgical sponge)",
                  "children": [
                    {
                      "label": "lower risk than more widespread topical administration!"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
