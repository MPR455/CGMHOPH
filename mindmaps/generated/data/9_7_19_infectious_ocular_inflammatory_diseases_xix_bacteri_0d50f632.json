{
  "label": "9.7.19. Infectious Ocular Inflammatory Diseases (XIX): Bacterial Uveitis (IV): Leptospirosis Nocardiosis",
  "root": true,
  "children": [
    {
      "label": "Ocular Nocardiosis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "Nocardia asteroides",
              "children": [
                {
                  "label": "gram-positive rod",
                  "children": [
                    {
                      "label": "partially acid-fast"
                    }
                  ]
                },
                {
                  "label": "beaded branching filaments"
                },
                {
                  "label": "found in soil"
                }
              ]
            },
            {
              "label": "infection occurs by ingestion or inhalation"
            },
            {
              "label": "rare",
              "children": [
                {
                  "label": "Immunocompromised individuals are at more risk"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic disease",
          "children": [
            {
              "label": "pneumonia"
            },
            {
              "label": "disseminated abscesses"
            }
          ]
        },
        {
          "label": "ocular involvement",
          "children": [
            {
              "label": "occurs by hematogenous spread"
            },
            {
              "label": "symptoms may vary",
              "children": [
                {
                  "label": "mild pain and redness of anterior uveitis"
                },
                {
                  "label": "severe pain and decreased vision of panophthalmitis"
                }
              ]
            },
            {
              "label": "can affect essentially any ocular structure"
            },
            {
              "label": "periorbital tissue and the adnexae"
            },
            {
              "label": "keratitis"
            },
            {
              "label": "necrotizing scleritis"
            },
            {
              "label": "isolated, unilateral choroidal or subretinal mass (abscess)",
              "children": [
                {
                  "label": "minimal vitritis"
                }
              ]
            },
            {
              "label": "panuveitis",
              "children": [
                {
                  "label": "anterior chamber cell and flare"
                },
                {
                  "label": "vitritis"
                },
                {
                  "label": "multiple choroidal abscesses"
                },
                {
                  "label": "overlying retinal detachment"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "vitreous aspiration for Gram stain and culture"
            },
            {
              "label": "enucleation",
              "children": [
                {
                  "label": "microscopic identification of organisms"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "systemic sulfonamide (trimethoprim- sulfamethoxazole)",
              "children": [
                {
                  "label": "for protracted periods of time"
                }
              ]
            },
            {
              "label": "+- combination therapy with additional antibiotics"
            }
          ]
        }
      ]
    },
    {
      "label": "Leptospirosis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "Leptospira interrogans",
              "children": [
                {
                  "label": "gram-negative spirochete"
                }
              ]
            },
            {
              "label": "zoonotic infection",
              "children": [
                {
                  "label": "natural reservoirs",
                  "children": [
                    {
                      "label": "livestock"
                    },
                    {
                      "label": "horses"
                    },
                    {
                      "label": "dogs"
                    },
                    {
                      "label": "rodents"
                    },
                    {
                      "label": "excrete the organism in their urine"
                    }
                  ]
                }
              ]
            },
            {
              "label": "worldwide distribution",
              "children": [
                {
                  "label": "rare in the United States",
                  "children": [
                    {
                      "label": "tropical and subtropical regions"
                    },
                    {
                      "label": "majority of US cases occur in Hawaii"
                    }
                  ]
                }
              ]
            },
            {
              "label": "transmission",
              "children": [
                {
                  "label": "humans contract the disease upon exposure to contaminated soil or water",
                  "children": [
                    {
                      "label": "agricultural workers"
                    },
                    {
                      "label": "sewer workers"
                    },
                    {
                      "label": "veterinarian"
                    },
                    {
                      "label": "fish workers"
                    },
                    {
                      "label": "slaughterhouse workers"
                    },
                    {
                      "label": "military personnel"
                    },
                    {
                      "label": "swimmers"
                    },
                    {
                      "label": "triathletes"
                    },
                    {
                      "label": "whitewater rafters"
                    }
                  ]
                },
                {
                  "label": "not known to spread from person to person"
                },
                {
                  "label": "maternal–fetal transmission may occur"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "incubation period = 2–4 weeks"
            },
            {
              "label": "similar to stage 1 Lyme disease"
            },
            {
              "label": "initial (leptospiremic) phase",
              "children": [
                {
                  "label": "abrupt onset of fever, chills, headache, myalgias, vomiting, and diarrhea"
                },
                {
                  "label": "severe septicemic leptospirosis",
                  "children": [
                    {
                      "label": "Weil disease"
                    },
                    {
                      "label": "renal and hepatocellular dysfunction"
                    },
                    {
                      "label": "rare (occurs in 10%)"
                    },
                    {
                      "label": "fatal in 30%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "similar to stage 2 Lyme disease"
            },
            {
              "label": "second (immune) phase",
              "children": [
                {
                  "label": "meningitis",
                  "children": [
                    {
                      "label": "leptospires may be isolated from the blood and CSF",
                      "children": [
                        {
                          "label": "clear rapidly as the disease progresses to the second phase of the illness"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "leptospiruria"
                },
                {
                  "label": "cranial nerve palsies"
                },
                {
                  "label": "myelitis"
                },
                {
                  "label": "uveitis"
                },
                {
                  "label": "organism may persist for longer periods of time in immunologically privileged sites",
                  "children": [
                    {
                      "label": "brain"
                    },
                    {
                      "label": "eye"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "ocular involvement",
          "children": [
            {
              "label": "prolonged interval between systemic and ocular disease",
              "children": [
                {
                  "label": "occurs in both the leptospiremic and immune phases"
                }
              ]
            },
            {
              "label": "circumcorneal conjunctival hyperemia",
              "children": [
                {
                  "label": "pathognomonic",
                  "children": [
                    {
                      "label": "earliest and most common sign"
                    }
                  ]
                }
              ]
            },
            {
              "label": "intraocular inflammation",
              "children": [
                {
                  "label": "mild anterior uveitis to panuveitis with retinal vasculitis"
                },
                {
                  "label": "potentially vision-threatening"
                },
                {
                  "label": "differential diagnosis",
                  "children": [
                    {
                      "label": "HLA-B27–associated uveitis"
                    },
                    {
                      "label": "idiopathic pars planitis"
                    },
                    {
                      "label": "Behçet disease"
                    },
                    {
                      "label": "Eales disease"
                    },
                    {
                      "label": "sarcoidosis"
                    },
                    {
                      "label": "tuberculosis"
                    },
                    {
                      "label": "syphilis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "similar to stage 2 Lyme disease"
            }
          ]
        },
        {
          "label": "diagnostic tests",
          "children": [
            {
              "label": "definitive diagnosis",
              "children": [
                {
                  "label": "isolation of the organism from bodily fluids"
                }
              ]
            },
            {
              "label": "presumptive diagnosis",
              "children": [
                {
                  "label": "serologic assays",
                  "children": [
                    {
                      "label": "for detection of IgM antibodies against leptospiral antigens"
                    },
                    {
                      "label": "ELISA"
                    },
                    {
                      "label": "complement-fixation test"
                    },
                    {
                      "label": "highly sensitive and specific"
                    }
                  ]
                }
              ]
            },
            {
              "label": "PCR-based assays are under evaluation"
            },
            {
              "label": "causes false-positive result on RPR or FTA- ABS tests"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "systemic antibiotic treatment",
              "children": [
                {
                  "label": "intravenous penicillin G, 1.5 MU every 6 hours"
                },
                {
                  "label": "oral doxycycline, 100 mg twice daily"
                },
                {
                  "label": "not known if systemic antibiotic treatment is protective against long-term complications such as uveitis"
                },
                {
                  "label": "x 1 week",
                  "children": [
                    {
                      "label": "should be considered for ocular disease that occurs even months after onset of the acute systemic disease"
                    }
                  ]
                }
              ]
            },
            {
              "label": "topical, periocular, or systemic corticosteroids",
              "children": [
                {
                  "label": "to suppress intraocular inflammation"
                }
              ]
            },
            {
              "label": "visual prognosis of leptospiral uveitis is quite favorable"
            }
          ]
        }
      ]
    }
  ],
