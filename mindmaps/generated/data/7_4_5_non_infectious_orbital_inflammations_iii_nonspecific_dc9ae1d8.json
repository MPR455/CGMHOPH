              "children": [
                {
                  "label": "incomplete therapeutic response"
                },
                {
                  "label": "recurrent disease"
                },
                {
                  "label": "many advocate biopsy of almost all infiltrative lesions, except for 2 clinical scenarios",
                  "children": [
