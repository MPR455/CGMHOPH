                  "children": [
                    {
                      "label": "taper as soon as the clinical response is complete",
                      "children": [
                        {
                          "label": "more slowly below 40 mg/day"
                        },
                        {
                          "label": "very slowly below 20 mg/day"
                        },
                        {
                          "label": "Rapid reduction of systemic steroids may allow a recurrence of inflammatory symptoms"
