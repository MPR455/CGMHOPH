            {
              "label": "AREDS group recommendations",
              "children": [
                {
                  "label": "identify patients at high risk of AMD progression",
                  "children": [
                    {
                      "label": "extensive intermediate drusen"
                    },
                    {
                      "label": "≥1 large druse"
                    },
                    {
                      "label": "noncentral geographic atrophy"
                    },
                    {
                      "label": "advanced AMD in 1 eye"
                    }
                  ]
                },
                {
                  "label": "consider supplementation with combined antioxidant & mineral",
                  "children": [
                    {
                      "label": "avoid beta carotene in patients who smoke"
                    }
                  ]
                },
                {
                  "label": "early AMD",
                  "children": [
                    {
                      "label": "supplementation not shown to be beneficial"
                    }
                  ]
                },
                {
                  "label": "no AMD but at high risk of AMD",
                  "children": [
                    {
                      "label": "supplementation not tested"
                    },
                    {
                      "label": "maintain balanced diet"
                    },
                    {
                      "label": "avoid risk factors"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "AREDS 2",
          "children": [
            {
              "label": "methods",
              "children": [
                {
                  "label": "added omega-3 long-chain polyunsaturated fatty acids (LCPUFAs: docosahexaenoic acid [DHA] and eicosapentaenoic acid [EPA])"
                },
                {
                  "label": "replaced beta carotene with xanthophylls (lutein and zeaxanthin)"
                }
              ]
            },
            {
              "label": "results",
              "children": [
                {
                  "label": "overall risk reduction similar to the original AREDS study"
                },
                {
                  "label": "addition of LCPUFAs did not decrease the rate of progression to advanced AMD"
                },
                {
                  "label": "lutein and zeaxanthin had similar effects to beta carotene, but without its increased risk for lung cancer in current and former smokers"
                },
                {
                  "label": "confirmed 80 mg of zinc as an appropriate dose for AMD prophylaxis"
                }
              ]
            },
            {
              "label": "formula",
              "children": [
                {
                  "label": "vitamins C (500 mg)"
                },
                {
                  "label": "vitamin E (400 IU)"
                },
                {
                  "label": "lutein (10 mg)"
                },
                {
                  "label": "zeaxanthin (2 mg)"
                },
                {
                  "label": "zinc (80 mg)"
                },
                {
                  "label": "micronutrient zinc (80 mg)"
                }
              ]
            },
            {
              "label": "recommendation",
              "children": [
                {
                  "label": "patients with stage 3 or 4 AMD are advised to take the AREDS2 supplement."
                },
                {
                  "label": "intermediate (stage 3) AMD",
                  "children": [
                    {
                      "label": "≥ 1 large druse (≥125 μm), extensive intermediate drusen (63–124 μm diameter), or nonsubfoveal GA"
