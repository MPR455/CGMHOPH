{
  "label": "Nonneovascular AMD (III): Management",
  "root": true,
  "children": [
    {
      "label": "education & follow-up",
      "children": [
        {
          "label": "educate high risk patients about symptoms of advanced AMD"
        },
        {
          "label": "educate office staff to respond promptly to patients with new symptoms"
        },
        {
          "label": "periodic examinations"
        }
      ]
    },
    {
      "label": "Amsler grid",
      "children": [
        {
          "label": "each eye tested individually with reading glasses and at reading distance"
        },
        {
          "label": "online or smart-phone applications",
          "children": [
            {
              "label": "allow instant uploading"
            }
          ]
        }
      ]
    },
    {
      "label": "Hyperacuity testing",
      "children": [
        {
          "label": "Vernier acuity",
          "children": [
            {
              "label": "ability to detect deviations in alignment of visual objects"
            }
          ]
        },
        {
          "label": "Hyperacuity",
          "children": [
            {
              "label": "ability to discern minute deviations on a line"
            }
          ]
        },
        {
          "label": "preferential hyperacuity perimeter (PHP)",
          "children": [
            {
              "label": "can detect recent-onset CNV in intermediate AMD patients",
              "children": [
                {
                  "label": "high specificity (88%)"
                },
                {
                  "label": "high sensitivity (82%)"
                }
              ]
            }
          ]
        },
        {
          "label": "Shape-discrimination hyperacuity (SDH)",
          "children": [
            {
              "label": "tests for discrimination of shapes",
              "children": [
                {
                  "label": "perfect circle vs distorted circle"
                }
              ]
            },
            {
              "label": "handheld SDH test can be implemented as a smartphone application"
            }
          ]
        }
      ]
    },
    {
      "label": "micronutrients",
      "children": [
        {
          "label": "AREDS",
          "children": [
            {
              "label": "formula",
              "children": [
                {
                  "label": "vitamins C (500 mg)"
                },
                {
                  "label": "vitamin E (400 IU)"
                },
                {
                  "label": "beta carotene (15 mg)",
                  "children": [
                    {
                      "label": "increases rate of lung cancer in current smokers"
                    }
                  ]
                },
                {
                  "label": "micronutrient zinc (80 mg zinc oxide and 2 mg cupric oxide to prevent zinc-induced anemia)"
                }
              ]
            },
            {
              "label": "participants",
              "children": [
                {
                  "label": "patients with intermediate or advanced AMD",
                  "children": [
                    {
                      "label": "intermediate (stage 3) AMD",
                      "children": [
                        {
                          "label": "≥ 1 large druse (≥125 μm), extensive intermediate drusen (63–124 μm diameter), or nonsubfoveal GA"
                        }
                      ]
                    },
                    {
                      "label": "advanced (stage 4) AMD",
                      "children": [
                        {
                          "label": "vision loss due to neovascular AMD or subfoveal GA in only 1 eye"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "results",
              "children": [
                {
                  "label": "25% reduction for progression of intermediate or advanced AMD to more-advanced stages",
                  "children": [
                    {
                      "label": "at 5 years",
                      "children": [
                        {
                          "label": "at 10 years"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "19% reduction of moderate vision loss (≥3 lines of visual acuity)"
                },
                {
                  "label": "44% of placebo recipients compared with 34% of the supplement recipients had advanced AMD (a 23% risk reduction)"
                },
                {
                  "label": "no benefit in participants with no AMD or with only early-stage AMD (a few small drusen)"
                },
                {
                  "label": "no increased mortality among patients taking the formula"
                }
              ]
            },
            {
