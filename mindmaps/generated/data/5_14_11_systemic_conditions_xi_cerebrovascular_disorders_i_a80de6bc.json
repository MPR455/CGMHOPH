{
  "label": "5.14.11. Systemic Conditions (XI): Cerebrovascular Disorders (III)",
  "root": true,
  "children": [
    {
      "label": "supratentorial"
    },
    {
      "label": "50%"
    },
    {
      "label": "Arteriovenous Malformations",
      "children": [
        {
          "label": "demographics",
          "children": [
            {
              "label": "congenital"
            },
            {
              "label": "± familial"
            },
            {
              "label": "slight male preponderance",
              "children": [
                {
                  "label": "onset of symptoms < 30 years of age"
                },
                {
                  "label": "90%",
                  "children": [
                    {
                      "label": "cortical (70%)>deep (20%)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "location",
          "children": [
            {
              "label": "posterior fossa or dura mater",
              "children": [
                {
                  "label": "10%"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "initial manifestation",
              "children": [
                {
                  "label": "Intracranial hemorrhage ± subarachnoid hemorrhage",
                  "children": [
                    {
                      "label": "≤20% early mortality"
                    },
                    {
                      "label": "rebleeding rate is 2.5% each year"
                    },
                    {
                      "label": "headaches and focal neurologic deficits"
                    }
                  ]
                },
                {
                  "label": "seizures",
                  "children": [
                    {
                      "label": "30%"
                    }
                  ]
                },
                {
                  "label": "headaches or other focal neurologic deficits",
                  "children": [
                    {
                      "label": "20%"
                    },
                    {
                      "label": "neurologic symptoms may be progressive or transient"
                    }
                  ]
                },
                {
                  "label": "in contrast to patients with saccular aneurysms, patients with AVMs are much more likely to become symptomatic before a hemorrhage occurs"
                }
              ]
            },
            {
              "label": "neuro-ophthalmic manifestations of an AVM depend on its location",
              "children": [
                {
                  "label": "occipital lobe AVMs",
                  "children": [
                    {
                      "label": "visual symptoms and headaches that resemble migraine",
                      "children": [
                        {
                          "label": "visual phenomena are usually brief and unformed"
                        }
                      ]
                    },
                    {
                      "label": "hemispheric AVMs may produce homonymous visual field defects",
                      "children": [
                        {
                          "label": "typical migrainous scintillating scotomata are rare"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "brainstem AVMs",
                  "children": [
                    {
                      "label": "diplopia"
                    },
                    {
                      "label": "nystagmus"
                    },
                    {
                      "label": "dizziness"
                    },
                    {
                      "label": "ocular motor nerve palsy"
                    },
                    {
                      "label": "gaze palsy"
                    },
                    {
                      "label": "anisocoria"
                    },
                    {
                      "label": "pupillary light–near dissociation"
                    }
                  ]
                },
                {
                  "label": "transient monocular visual loss caused by a steal phenomenon from an intracranial AVM",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                }
              ]
            },
            {
              "label": "subjective intracranial bruit (tinnitus)",
              "children": [
                {
                  "label": "± audible bruit"
                }
              ]
            },
            {
              "label": "6% of patients also have an intracranial aneurysm"
            },
            {
              "label": "dural AVMs",
              "children": [
                {
                  "label": "abnormal arterial communication with one of the dural venous sinuses",
                  "children": [
                    {
                      "label": "account for 10%–15% of intracranial AVMs"
                    }
                  ]
                },
                {
                  "label": "elevated venous pressure",
                  "children": [
                    {
                      "label": "increased intracranial pressure",
                      "children": [
                        {
                          "label": "may be mistaken for typical idiopathic intracranial hypertension (IIH)",
                          "children": [
                            {
                              "label": "AVMs should be considered in patients who do not fit the usual IIH demographics and who have no other demonstrable cause of increased intracranial pressure"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "tinnitus",
                  "children": [
                    {
                      "label": "audible bruit"
                    }
                  ]
                },
                {
                  "label": "difficult to diagnose without catheter angiography"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "CT scan",
              "children": [
                {
                  "label": "unenhanced",
                  "children": [
                    {
                      "label": "will show intracranial hemorrhage"
                    }
                  ]
                },
                {
                  "label": "enhanced",
                  "children": [
                    {
                      "label": "unruptured AVMs"
                    }
                  ]
                }
              ]
            },
            {
              "label": "MRI",
              "children": [
                {
                  "label": "more sensitive for visualizing small AVMs"
                },
                {
                  "label": "heterogeneous signals representing the various elements of the lesion"
                }
              ]
            },
            {
              "label": "cerebral angiography",
              "children": [
                {
                  "label": "is required"
                }
              ]
            },
            {
              "label": "calcified AVMs are sometimes identifiable on plain radiograph or CT scan"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "surgical resection"
            },
            {
              "label": "ligation of feeding vessels"
            },
            {
              "label": "embolization"
            },
            {
              "label": "stereotactic radiosurgery"
            },
            {
              "label": "anticonvulsant therapy for seizure"
            }
          ]
        }
      ]
    },
    {
      "label": "Arterial Dissection",
      "children": [
        {
          "label": "Introduction",
          "children": [
            {
              "label": "involved vessels",
              "children": [
                {
                  "label": "internal carotid artery or its branches"
                },
                {
                  "label": "vertebral and basilar arteries"
                }
              ]
            },
            {
              "label": "extracranial or intracranial"
            },
            {
              "label": "traumatic or spontaneous",
              "children": [
                {
                  "label": "symptoms may be delayed for weeks or months after trauma"
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical presentation",
          "children": [
            {
              "label": "Internal carotid artery dissection",
              "children": [
                {
                  "label": "headache",
                  "children": [
                    {
                      "label": "ipsilateral forehead, around the orbit"
                    },
                    {
                      "label": "± neck pain"
                    }
                  ]
                },
                {
                  "label": "ipsilateral ophthalmic signs",
                  "children": [
                    {
                      "label": "amaurosis fugax"
                    },
                    {
                      "label": "monocular blindness",
                      "children": [
                        {
                          "label": "embolic occlusion"
                        },
                        {
                          "label": "direct ophthalmic artery occlusion by the dissection"
                        }
                      ]
                    },
                    {
                      "label": "Horner syndrome"
                    }
                  ]
                },
                {
                  "label": "± cranial neuropathies",
                  "children": [
                    {
                      "label": "diplopia",
                      "children": [
                        {
                          "label": "ocular ischemic syndrome"
                        },
                        {
                          "label": "altered taste"
                        }
                      ]
                    },
                    {
                      "label": "dysgeusia"
                    },
                    {
                      "label": "tongue paralysis"
                    },
                    {
                      "label": "facial numbness"
                    },
                    {
                      "label": "if the dissection extends intracranially"
                    }
                  ]
                },
                {
                  "label": "contralateral neurologic deficits",
                  "children": [
                    {
                      "label": "acute stroke",
                      "children": [
                        {
                          "label": "within the first 30 days of the dissection"
                        }
                      ]
                    },
                    {
                      "label": "transient or permanent"
                    }
                  ]
                },
                {
                  "label": "± bruit"
                }
              ]
            },
            {
              "label": "Vertebral and basilar artery dissection",
              "children": [
                {
                  "label": "40%"
                },
                {
                  "label": "headache/neck pain"
                },
                {
