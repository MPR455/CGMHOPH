{
  "label": "9.7.14. Infectious Ocular Inflammatory Diseases (XIV): Helminthic Uveitis (II): Cysticercosis",
  "root": true,
  "children": [
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "Cysticercus cellulosae",
          "children": [
            {
              "label": "larval stage of Taenia solium (pork tapeworm)"
            }
          ]
        },
        {
          "label": "ingestion of eggs in contaminated water/food",
          "children": [
            {
              "label": "eggs mature into larvae",
              "children": [
                {
                  "label": "penetrate the intestinal mucosa",
                  "children": [
                    {
                      "label": "spread hematogenously to the eye via the posterior ciliary arteries into the subretinal space",
                      "children": [
                        {
                          "label": "posterior pole"
                        },
                        {
                          "label": "may perforate the retina and gain access to the vitreous"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "eye is more commonly affected than any other organ"
        },
        {
          "label": "neural/cerebral cysticercosis",
          "children": [
            {
              "label": "epileptiform seizures"
            },
            {
              "label": "significant morbidity and a mortality of 40%"
            },
            {
              "label": "CT",
              "children": [
                {
                  "label": "intracerebral calcification or hydrocephalus"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "diagnostic tests",
      "children": [
        {
          "label": "characteristic appearance of a motile cysticercus is pathognomonic"
        },
        {
          "label": "serum ELISA for anticysticercus antibodies",
          "children": [
            {
              "label": "50% and 80% of patients with ocular and neural cysticercosis"
            }
          ]
        },
        {
          "label": "peripheral eosinophilia"
        },
        {
          "label": "anterior chamber paracentesis",
          "children": [
            {
              "label": "large number of eosinophils"
            }
          ]
        },
        {
          "label": "stool examination may find T solium eggs",
          "children": [
            {
              "label": "in a definitive host (adult tapeworm in the gastrointestinal tract)"
            }
          ]
        },
        {
          "label": "B-scan ultrasonography",
          "children": [
            {
              "label": "characteristic picture of a sonolucent zone with a well-defined anterior and posterior margin"
            },
            {
              "label": "central echo-dense, curvilinear, highly reflective structure within the cyst is suggestive of a scolex"
            }
          ]
        },
        {
          "label": "OCT"
        }
      ]
    },
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "most common ocular tapeworm infection"
        },
        {
          "label": "underdeveloped areas with poor hygiene",
          "children": [
            {
              "label": "endemic to Mexico, Africa, Southeast Asia, eastern Europe, Central and South America, and India",
              "children": [
                {
                  "label": "Similar to congenital toxoplasmosis"
                }
              ]
            }
          ]
        },
        {
          "label": "young age",
          "children": [
            {
              "label": "10-30 years"
            }
          ]
        }
      ]
    },
    {
      "label": "Similar to Toxocariasis",
      "children": [
        {
          "label": "M=F"
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "retinoblastoma"
        },
        {
          "label": "Coats disease"
        },
        {
          "label": "retinopathy of prematurity"
        },
        {
          "label": "persistent fetal vasculature"
        },
        {
          "label": "toxocariasis"
        },
        {
          "label": "retinal detachment"
        },
        {
          "label": "diffuse unilateral subacute neuroretinitis"
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "mostly unilateral"
        },
        {
          "label": "posterior segment is involved most often",
          "children": [
            {
              "label": "may involve any structure of the eye and its adnexae"
            },
            {
              "label": "subretinal space > vitreous"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "asymptomatic"
            },
            {
              "label": "floaters"
            },
            {
              "label": "moving sensations"
            },
            {
              "label": "ocular pain"
            },
            {
              "label": "photophobia"
            },
            {
              "label": "redness"
            },
            {
              "label": "poor visual acuity"
            }
          ]
        },
        {
          "label": "uveitis",
          "children": [
            {
              "label": "anterior chamber reaction",
              "children": [
                {
                  "label": "vitreous inflammation is more pronounced during the early stages"
                }
              ]
            },
            {
              "label": "vitreous reaction"
            },
            {
              "label": "larvae death produces a severe inflammatory reaction",
              "children": [
                {
                  "label": "zonal granulomatous inflammation"
                }
              ]
            }
          ]
        },
        {
          "label": "larvae in the vitreous/subretinal space",
          "children": [
            {
              "label": "46%"
            },
            {
              "label": "globular or spherical, translucent, white cyst with a head, or scolex"
            },
            {
              "label": "undulates in response to the examining light"
            },
            {
              "label": "1.5 to 6 disc diameters"
            }
          ]
        },
        {
          "label": "retinal detachment",
          "children": [
            {
              "label": "RPE atrophy may be observed surrounding the presumptive entry site into subretinal space"
            }
          ]
        },
        {
          "label": "clinical course",
          "children": [
            {
              "label": "can cause blindness, retinal atrophy, and phthisis",
              "children": [
                {
                  "label": "within 3–5 years"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "antihelminthic drugs",
          "children": [
            {
              "label": "praziquantel and albendazole"
            },
            {
              "label": "generally not effective for intraocular disease",
              "children": [
                {
                  "label": "larvae death causes worsening of ocular disease",
                  "children": [
                    {
                      "label": "albendazole or thiabendazole For Toxocariasis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "laser photocoagulation",
          "children": [
            {
              "label": "in combination with systemic corticosteroids"
            },
            {
              "label": "for small subretinal cysticerci"
            }
          ]
        },
        {
          "label": "early removal of the larvae by vitreoretinal surgical techniques",
          "children": [
            {
              "label": "poor results when the dead parasite is allowed to remain within the eye"
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    }
  ],
