    {
      "label": "Radiation Therapy (RT)",
      "children": [
        {
          "label": "traditional whole-brain RT",
          "children": [
            {
              "label": "to treat cerebral malignancies"
            },
            {
              "label": "delivered in fractions over ≈1 month"
            }
          ]
        },
