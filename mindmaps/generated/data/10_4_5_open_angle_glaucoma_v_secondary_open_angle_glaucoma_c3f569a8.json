    {
      "label": "Fuchs heterochromic iridocyclitis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "relatively rare"
            },
            {
              "label": "middle-aged men and women"
            },
            {
              "label": "rubella virus infection may be the underlying cause"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "chronic"
            },
            {
              "label": "unilateral"
            },
            {
              "label": "loss of iris pigment",
              "children": [
                {
                  "label": "iris hypochromia",
                  "children": [
                    {
                      "label": "glaucomatocyclitic crisis (Posner-Schlossman syndrome) may be caused by herpes simplex virus"
                    },
                    {
                      "label": "in patients with blue irides, the affected eye may appear hyperchromic"
                    }
                  ]
                }
              ]
            },
            {
              "label": "low-grade anterior chamber reaction"
            },
            {
              "label": "small, stellate, pancorneal KP"
            },
            {
              "label": "posterior subcapsular cataracts"
            },
            {
              "label": "gonioscopy",
              "children": [
                {
                  "label": "multiple fine vessels that cross the trabecular meshwork",
                  "children": [
                    {
                      "label": "not associated with fibrous membrane and do not lead to PAS and secondary angle closure"
                    },
                    {
                      "label": "fragile and may cause an anterior chamber hemorrhage",
                      "children": [
                        {
                          "label": "spontaneously or with trauma, including cataract or glaucoma surgery"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "secondary OAG",
              "children": [
                {
                  "label": "15%"
