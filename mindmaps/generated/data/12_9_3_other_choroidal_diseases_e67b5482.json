{
  "label": "12.9.3. Other Choroidal Diseases",
  "root": true,
  "children": [
    {
      "label": "BCSC 2020-2021",
      "children": [
        {
          "label": "Age-Related Choroidal Atrophy",
          "children": [
            {
              "label": "decreased choroidal thickness",
              "children": [
                {
                  "label": "myopia"
                },
                {
                  "label": "increasing age",
                  "children": [
                    {
                      "label": "choroid is thinner in eyes with pseudodrusen than in those with drusen"
                    }
                  ]
                }
              ]
            },
            {
              "label": "pseudodrusen",
              "children": [
                {
                  "label": "eyes of elderly patients with thin choroid"
                },
                {
                  "label": "collections of subretinal drusenoid deposits above the RPE"
                },
                {
                  "label": "increased risk for",
                  "children": [
                    {
                      "label": "CNV",
                      "children": [
                        {
                          "label": "particularly types 2 and 3"
                        }
                      ]
                    },
                    {
                      "label": "geographic atrophy",
                      "children": [
                        {
                          "label": ".>90% of eyes with geographic atrophy also have pseudodrusen"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Choroidal Hemangiomas",
          "children": [
            {
              "label": "circumscribed",
              "children": [
                {
                  "label": "isolated"
                },
                {
                  "label": "well-circumscribed"
                },
                {
                  "label": "reddish-orange"
                },
                {
                  "label": "varying thickness"
                },
                {
                  "label": "transilluminate"
                },
                {
                  "label": "ultrasound",
                  "children": [
                    {
                      "label": "highly echographic patterns"
                    }
                  ]
                },
                {
                  "label": "angiography",
                  "children": [
                    {
                      "label": "very early filling of large vessels"
                    }
                  ]
                }
              ]
            },
            {
              "label": "diffuse",
              "children": [
                {
                  "label": "Sturge-Weber syndrome",
                  "children": [
                    {
                      "label": "encephalofacial cavernous hemangiomatosis"
                    },
                    {
                      "label": "ipsilateral facial nevus flammeus (port-wine stain)"
                    }
                  ]
                },
                {
                  "label": "may present first as glaucoma or amblyopia in children"
                },
                {
                  "label": "tomato ketchup appearance"
                },
                {
                  "label": "underlying choroidal markings are not visible"
                },
                {
                  "label": "may blend imperceptibly into adjacent normal choroid"
                }
              ]
            },
            {
              "label": "other features",
              "children": [
                {
                  "label": "retinal edema"
                },
                {
                  "label": "neurosensory detachment"
                },
                {
                  "label": "calcification and ossification in the choroid"
                },
                {
                  "label": "hard exudate"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "laser photocoagulation"
                },
                {
                  "label": "cryopexy"
                },
                {
                  "label": "external-beam and plaque radiation"
                },
                {
                  "label": "PDT (with verteporfin)",
                  "children": [
                    {
                      "label": "lowest risk of treatment-related morbidity"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Choroidal Folds",
          "children": [
            {
              "label": "external pressure",
              "children": [
                {
                  "label": "indenting tumor"
                },
                {
                  "label": "thyroid eye disease"
                }
              ]
            },
            {
              "label": "posterior scleritis"
            },
            {
              "label": "middle-aged adults, some of whom acquire an increased amount of hyperopia",
              "children": [
                {
                  "label": "bilaterally symmetric horizontal or oblique choroidal folds"
                }
              ]
            },
            {
              "label": "Engorgement of the choroid",
              "children": [
                {
                  "label": "inflammation",
                  "children": [
                    {
                      "label": "inflammatory disease that causes scleral shortening and flattening of the posterior sclera"
                    }
                  ]
                },
                {
                  "label": "lymphoma"
                }
              ]
            },
            {
              "label": "Reduced intraocular pressure",
              "children": [
                {
                  "label": "hypotony maculopathy"
                },
                {
                  "label": "ciliochoroidal effusions"
                },
                {
                  "label": "curvilinear choroidal folds in the posterior pole"
                }
              ]
            },
            {
              "label": "Medications",
              "children": [
                {
                  "label": "topiramate",
                  "children": [
                    {
                      "label": "idiopathic swelling of the choroid with creation of chorioretinal folds and ciliochoroidal effusions without hypotony"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Increased intracranial pressure",
              "children": [
                {
                  "label": "fine folds that course circumferentially around the optic nerve head",
                  "children": [
                    {
                      "label": "Patton lines"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Localized choroidal folds",
              "children": [
                {
                  "label": "choroidal neoplasms"
                },
                {
                  "label": "CNV"
                }
              ]
            }
          ]
        },
        {
          "label": "Bilateral Diffuse Uveal Melanocytic Proliferation",
          "children": [
            {
              "label": "rare"
            },
            {
              "label": "paraneoplastic disorder",
              "children": [
                {
                  "label": "primary cancers",
                  "children": [
                    {
                      "label": "ovary"
                    },
                    {
                      "label": "uterus"
                    },
                    {
                      "label": "lung",
                      "children": [
                        {
                          "label": "most common"
                        }
                      ]
                    },
                    {
                      "label": "kidney"
                    },
                    {
                      "label": "colon"
                    },
                    {
                      "label": "pancreas"
                    },
                    {
                      "label": "gallbladder"
                    },
                    {
                      "label": "breast"
                    },
                    {
                      "label": "esophagus"
                    }
                  ]
                },
                {
                  "label": "associated with or often heralds systemic cancer"
                }
              ]
            },
            {
              "label": "clinical features",
              "children": [
                {
                  "label": "diffuse thickening of the choroid"
                },
                {
                  "label": "reddish or brownish choroidal discoloration"
                },
                {
                  "label": "serous retinal detachment"
                },
                {
                  "label": "cataract"
                },
                {
                  "label": "nummular loss of the RPE",
                  "children": [
                    {
                      "label": "hypoautofluorescent"
                    },
                    {
                      "label": "hyperfluorescent during fluorescein angiography"
                    }
                  ]
                },
                {
                  "label": "large nevus-like regions of increased pigmentation"
                }
              ]
            },
            {
              "label": "pathology",
              "children": [
                {
                  "label": "proliferation of benign melanocytes"
                }
              ]
            },
            {
              "label": "OCT",
              "children": [
                {
                  "label": "mounds of residual material, presumed to be persistent RPE cells between areas of loss"
                }
              ]
            }
          ]
        },
        {
          "label": "Uveal Effusion Syndrome",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "abnormal scleral composition or thickness",
                  "children": [
                    {
                      "label": "reduces transscleral aqueous outflow"
                    }
                  ]
                }
              ]
            },
            {
              "label": "clinical findings",
              "children": [
                {
                  "label": "choroidal and ciliary body thickening",
                  "children": [
                    {
                      "label": "can be imaged with ultrasonography",
                      "children": [
                        {
                          "label": "may be so thick that OCT imaging is not possible"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "exudative retinal detachment"
                },
                {
                  "label": "RPE alterations"
                },
                {
                  "label": "visual function may fluctuate"
                },
                {
                  "label": "fluorescein angiography",
                  "children": [
                    {
                      "label": "leopard-spot pattern of hypofluorescence without focal leakage"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "scleral window surgery"
                },
                {
                  "label": "intravitreal triamcinolone"
                },
                {
                  "label": "visual results may be less satisfactory because of chronic, irreversible changes"
                }
              ]
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "high index of suspicion for uveal effusion syndrome should be maintained for young patients with hyperopia diagnosed as",
                  "children": [
                    {
                      "label": "RD",
                      "children": [
                        {
                          "label": "central serous chorioretinopathy"
                        },
                        {
                          "label": "without visible retinal break"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
