{
  "label": "8.8.3. Neoplastic Disorders of the Conjunctiva and Cornea (III): Benign Pigmented Lesions",
  "root": true,
  "children": [
    {
      "label": "Benign (racial) melanosis",
      "children": [
        {
          "label": "bilateral"
        },
        {
          "label": "middle-aged individuals with dark skin"
        },
        {
          "label": "increasing pigmentation of the conjunctiva",
          "children": [
            {
              "label": "most apparent at the limbus",
              "children": [
                {
                  "label": "less prominent as one approaches the fornix"
                }
              ]
            }
          ]
        },
        {
          "label": "striate melanokeratosis",
          "children": [
            {
              "label": "streaks and whorls of peripheral corneal epithelial pigment"
            }
          ]
        }
      ]
    },
    {
      "label": "Introduction",
      "children": [
        {
          "label": "Pigment spot of the sclera",
          "children": [
            {
              "label": "collection of melanocytes associated with",
              "children": [
                {
                  "label": "intrascleral nerve loop"
                },
                {
                  "label": "perforating anterior ciliary vessel"
                }
              ]
            }
          ]
        },
        {
          "label": "Melanosis",
          "children": [
            {
              "label": "excessive pigmentation without an elevated mass",
              "children": [
                {
                  "label": "congenital (whether epithelial or subepithelial)"
                },
                {
                  "label": "acquired (whether primary or secondary)"
                }
              ]
            }
          ]
        },
        {
          "label": "Conjunctival pigmentation",
          "children": [
            {
              "label": "chronic exposure to",
              "children": [
                {
                  "label": "epinephrine"
                },
                {
                  "label": "silver"
                },
                {
                  "label": "mascara"
                }
              ]
            }
          ]
        },
        {
          "label": "See Tables 8-2 and 8-3"
        }
      ]
    },
    {
      "label": "Congenital epithelial melanosis (freckle/ ephelis)",
      "children": [
        {
          "label": "present at an early age"
        },
        {
          "label": "flat brown patch"
        },
        {
          "label": "bulbar conjunctiva near the limbus"
        },
        {
          "label": "more common in darkly pigmented individuals"
        }
      ]
    },
    {
      "label": "Nevus",
      "children": [
        {
          "label": "arise during childhood and adolescence"
        },
        {
          "label": "types",
          "children": [
            {
              "label": "junctional (pure intraepithelial)",
              "children": [
                {
                  "label": "rare except in children"
                },
                {
                  "label": "difficult to distinguish histopathologically from primary acquired melanosis"
                }
              ]
            },
            {
              "label": "compound",
              "children": [
                {
                  "label": "most common type"
                }
              ]
            },
            {
              "label": "subepithelial",
              "children": [
                {
                  "label": "equivalent of the intradermal nevus"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical findings",
          "children": [
            {
              "label": "flat or elevated"
            },
            {
              "label": "variable pigmentation"
            },
            {
              "label": "subepithelial nevus often has a cobblestone appearance",
              "children": [
                {
                  "label": "half of all conjunctival nevi"
                }
              ]
            },
            {
              "label": "small epithelial inclusion cysts",
              "children": [
                {
                  "label": "compound or subepithelial nevi"
                },
                {
                  "label": "secretion of mucin by goblet cells in the inclusion cysts can cause a nevus to enlarge",
                  "children": [
                    {
                      "label": "false impression of malignant change"
                    }
                  ]
                }
              ]
            },
            {
              "label": "secondary lymphocytic inflammation",
              "children": [
                {
                  "label": "when inflamed, an amelanotic, vascularized nevus may resemble",
                  "children": [
                    {
                      "label": "angioma"
                    },
                    {
                      "label": "chronic conjunctivitis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "rarely become malignant",
              "children": [
                {
                  "label": "rapid enlargement at puberty",
                  "children": [
                    {
                      "label": "clinical impression of conjunctival melanoma"
                    }
                  ]
                },
                {
                  "label": "follow every 6–12 months",
                  "children": [
                    {
                      "label": "serial photography"
                    }
                  ]
                }
              ]
            },
            {
              "label": "excisional biopsy should be performed on",
              "children": [
                {
                  "label": "lesions that change"
                },
                {
                  "label": "lesions on the tarsal conjunctiva, the caruncle, or the plica semilunaris or fornix",
                  "children": [
                    {
                      "label": "nevi are rare in these locations!"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Ocular melanocytosis",
      "children": [
        {
          "label": "1:2500 individuals"
        },
        {
          "label": "usually unilateral",
          "children": [
            {
              "label": "5% bilateral",
              "children": [
                {
                  "label": "more common in the black, hispanic, and asian populations"
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "focal proliferation of subepithelial melanocytes (blue nevi)"
            }
          ]
        },
        {
          "label": "clinical findings",
          "children": [
            {
              "label": "patches of episcleral pigmentation (congenital melanosis of the episclera)",
              "children": [
                {
                  "label": "slate gray"
                },
                {
                  "label": "immobile"
                }
              ]
            },
            {
              "label": "dermal melanocytosis (nevus of ota)",
              "children": [
                {
                  "label": "proliferation of dermal melanocytes in the periocular skin"
                },
                {
                  "label": "first and second dermatomes of cranial nerve V"
                },
                {
                  "label": "1/2"
                }
              ]
            },
            {
              "label": "oculodermal melanocytosis"
            },
            {
              "label": "increased pigmentation of the iris and choroid"
            },
            {
              "label": "secondary glaucoma",
              "children": [
                {
                  "label": "10%"
                }
              ]
            },
            {
              "label": "malignant transformation",
              "children": [
                {
                  "label": "rare",
                  "children": [
                    {
                      "label": "lifetime risk of uveal melanoma in a patient with ocular melanocytosis is about 1/400"
                    }
                  ]
                },
                {
                  "label": "seems to occur only in patients with fair complexions"
                },
                {
                  "label": "malignant melanoma",
                  "children": [
                    {
                      "label": "skin"
                    },
                    {
                      "label": "conjunctiva"
                    },
                    {
                      "label": "uvea"
                    },
                    {
                      "label": "orbit"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Neurogenic and Smooth-Muscle Tumors",
      "children": [
        {
          "label": "peripheral nerve sheath tumors",
          "children": [
            {
              "label": "types",
              "children": [
                {
                  "label": "neurofibroma",
                  "children": [
                    {
                      "label": "neurofibroma of the conjunctiva or eyelid is almost always a manifestation of neurofibromatosis"
                    }
                  ]
                },
                {
                  "label": "neurilemoma (schwannoma)",
                  "children": [
                    {
                      "label": "from Schwann cells of a peripheral nerve sheath"
                    }
                  ]
                },
                {
                  "label": "neuroma"
                }
              ]
            }
          ]
        },
        {
          "label": "leiomyosarcoma",
          "children": [
            {
              "label": "very rare limbal lesion",
              "children": [
                {
                  "label": "more common in multiple endocrine neoplasia (MEN)"
                }
              ]
            },
            {
              "label": "potential for orbital invasion"
            }
          ]
        }
      ]
    }
