    {
      "label": "Cellulitis",
      "children": [
        {
          "label": "most common cause of cellulitis is bacterial infection",
          "children": [
            {
              "label": "direct spread from adjacent sinusitis, dacryocystitis, or dacryoadenitis",
              "children": [
                {
                  "label": "most commonly caused by underlying sinusitis",
                  "children": [
                    {
                      "label": "particularly if no obvious source of inoculation is noted"
                    }
                  ]
                }
              ]
            },
            {
              "label": "direct inoculation following trauma or skin infection"
            },
            {
              "label": "hematologic spread from a distant focus (eg, otitis media, pneumonia)"
            }
          ]
        },
        {
          "label": "anatomic classification",
          "children": [
            {
              "label": "preseptal cellulitis",
              "children": [
                {
                  "label": "anterior to orbital septum"
                }
              ]
            },
            {
              "label": "orbital cellulitis",
              "children": [
                {
                  "label": "posterior to orbital septum"
                }
              ]
            },
            {
              "label": "often represent a continuum"
            }
          ]
        }
      ]
    },
    {
      "label": "Orbital cellulitis",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "extension from periorbital structures",
              "children": [
                {
                  "label": "sinusitis",
                  "children": [
                    {
                      "label": "usually a secondary extension of acute or chronic bacterial sinusitis"
                    }
                  ]
                },
                {
                  "label": "dacryocystitis"
                },
                {
                  "label": "dental infection"
                }
              ]
            },
            {
              "label": "exogenous",
              "children": [
                {
                  "label": "trauma"
                },
                {
                  "label": "surgery"
                }
              ]
            },
            {
              "label": "endogenous",
              "children": [
                {
                  "label": "bacteremia"
                }
              ]
            },
            {
              "label": "intraorbital",
              "children": [
                {
                  "label": "dacryoadenitis"
                },
                {
                  "label": "endophthalmitis"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "fever"
            },
            {
              "label": "leukocytosis",
              "children": [
                {
                  "label": "75%"
                }
              ]
            },
            {
              "label": "erythema"
            },
            {
              "label": "chemosis"
            },
            {
              "label": "ptosis"
            },
            {
              "label": "proptosis"
            },
            {
              "label": "restriction of and pain with ocular movement"
            },
            {
              "label": "optic neuropathy",
              "children": [
                {
                  "label": "decreased vision"
                },
                {
                  "label": "impaired color vision"
                },
                {
                  "label": "restricted visual fields"
                },
                {
                  "label": "pupillary abnormalities"
                },
                {
                  "label": "demands immediate investigation and aggressive management"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "imaging of the orbit and paranasal sinuses is essential"
            },
            {
              "label": "identification of sinusitis is an indication for otolaryngologic consultation"
            },
            {
              "label": "IV antibiotic therapy",
              "children": [
                {
                  "label": "broad-spectrum coverage"
                },
                {
                  "label": "adults",
                  "children": [
                    {
                      "label": "multiple organisms",
                      "children": [
                        {
                          "label": "gram-positive cocci"
                        },
                        {
                          "label": "H influenzae"
                        },
                        {
                          "label": "Moraxella catarrhalis"
                        },
                        {
                          "label": "anaerobes"
                        }
                      ]
                    },
                    {
                      "label": "early surgical intervention to drain the involved sinus is usually indicated",
                      "children": [
                        {
                          "label": "especially if orbital findings progress during treatment"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "children",
                  "children": [
                    {
                      "label": "single gram-positive organism"
                    },
                    {
                      "label": "less likely to require surgical drainage of the infected sinus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "nasal decongestants"
            },
            {
              "label": "steroids",
              "children": [
                {
                  "label": "when used in addition to antibiotic therapy, may hasten recovery"
                },
                {
                  "label": "low risk of worsening infection"
                }
              ]
            },
            {
              "label": "orbital cellulitis following blowout fractures",
              "children": [
                {
                  "label": "limited to patients with underlying sinus disease"
                },
                {
                  "label": "prophylactic antibiotics are recommended if CT scan suggests ongoing sinusitis"
                }
              ]
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "subperiosteal abscess",
              "children": [
                {
                  "label": "clinical presentation",
                  "children": [
                    {
                      "label": "progressive proptosis"
                    },
                    {
                      "label": "globe displacement"
                    },
                    {
                      "label": "failure to show clinical improvement despite appropriate antibiotic therapy"
                    },
                    {
                      "label": "usually localize in the subperiosteal space",
                      "children": [
                        {
                          "label": "adjacent to the infected sinus"
                        },
                        {
                          "label": "may extend through the periosteum into the orbital soft tissues"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "medical",
                      "children": [
                        {
                          "label": "isolated medial or inferior subperiosteal abscess in child <9 years",
                          "children": [
                            {
                              "label": "isolated ethmoid sinusitis, intact vision, and only moderate proptosis"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "surgical (+ medical)",
                      "children": [
                        {
                          "label": "patient aged ≥9 years",
                          "children": [
                            {
                              "label": "multiple pathogens that are drug resistant"
                            }
                          ]
                        },
                        {
                          "label": "presence of frontal sinusitis"
                        },
                        {
                          "label": "nonmedial location of subperiosteal abscess (SPA)"
                        },
                        {
                          "label": "large SPA"
                        },
                        {
                          "label": "suspicion of anaerobic infection (presence of gas in abscess on CT)"
                        },
                        {
                          "label": "recurrence of SPA after prior drainage"
                        },
                        {
                          "label": "evidence of chronic sinusitis (eg, nasal polyps)"
                        },
                        {
                          "label": "acute optic nerve or retinal compromise"
                        },
                        {
                          "label": "infection of dental origin (anaerobic infection more likely)"
                        }
                      ]
                    },
                    {
                      "label": "concomitant sinus surgery",
                      "children": [
                        {
                          "label": "if sinusitis is present"
                        },
                        {
                          "label": "particularly anaerobic organisms"
                        }
                      ]
                    },
                    {
                      "label": "most patients with orbital cellulitis + abscess respond to appropriate medical ± surgical treatment within 24–48 hours"
                    }
                  ]
                }
              ]
            },
            {
              "label": "cavernous sinus thrombosis",
              "children": [
                {
                  "label": "rapid progression of proptosis"
                },
                {
                  "label": "development of ipsilateral ophthalmoplegia"
                },
                {
                  "label": "onset of anesthesia in both the first and second divisions of the trigeminal nerve"
                },
                {
                  "label": "contralateral ophthalmoplegia",
                  "children": [
