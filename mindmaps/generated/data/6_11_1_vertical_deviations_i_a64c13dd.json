{
  "label": "6.11.1. Vertical Deviations (I)",
  "root": true,
  "children": [
    {
      "label": "terminology",
      "children": [
        {
          "label": "described according to resting position of deviating nonfixating eye"
        },
        {
          "label": "if ability to alternately fixate is present, deviation is usually named for the hyperdeviating eye"
        },
        {
          "label": "in case of a vertical heterophoria, the deviation is, by convention, termed according to the hyperdeviating eye"
        },
        {
          "label": "1"
        }
      ]
    },
    {
      "label": "Superior oblique muscle overaction",
      "children": [
        {
          "label": "most bilateral cases are primary"
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "hypotropia of the adducting eye",
              "children": [
                {
                  "label": "accentuated in the lower field"
                }
              ]
            },
            {
              "label": "hypotropia in primary position",
              "children": [
                {
                  "label": "lower eye contains the overacting superior oblique muscle in unilateral overaction and the more prominently overacting superior oblique muscle in bilateral overaction"
                }
              ]
            },
            {
              "label": "± horizontal deviation",
              "children": [
                {
                  "label": "most often exotropia"
                },
                {
                  "label": "may lead to an A pattern"
                }
              ]
            },
            {
              "label": "intorsion",
              "children": [
                {
                  "label": "common"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "indications for treatment",
              "children": [
                {
                  "label": "clinically significant hypertropia or hypotropia",
                  "children": [
                    {
                      "label": "SO tendon weakening",
                      "children": [
                        {
                          "label": "recession"
                        },
                        {
                          "label": "tenotomy"
                        },
                        {
                          "label": "tenectomy"
                        },
                        {
                          "label": "lengthening",
                          "children": [
                            {
                              "label": "insertion of a silicone spacer or nonabsorbable suture"
                            },
                            {
                              "label": "Z-lengthening"
                            }
                          ]
                        },
                        {
                          "label": "significant intorsion will also be reduced"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "A pattern",
                  "children": [
                    {
                      "label": "horizontal deviation can be corrected during the same operative session"
                    },
                    {
                      "label": "SO weakening may have convergent effect in primary position",
                      "children": [
                        {
                          "label": "adjust surgical amounts for horizontal rectus muscles when simultaneously weakening the superior oblique muscles"
                        },
                        {
                          "label": "some surgeons adjust amount of horizontal surgery because of potential effect of oblique muscle weakening on horizontal deviation",
                          "children": [
                            {
                              "label": "particularly for superior oblique muscle surgery",
                              "children": [
                                {
                                  "label": "bilateral superior oblique weakening causes a change of 10Δ–15Δ toward convergence in primary position"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "bilateral superior oblique tenotomy is a very powerful procedure",
                      "children": [
                        {
                          "label": "may correct up to 40Δ–50Δ of A pattern"
                        },
                        {
                          "label": "risk of induced torsional imbalance",
                          "children": [
                            {
                              "label": "may cause problems for patients with fusional ability"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "asymmetric, torsional and/or vertical effects may cause diplopia in some cases after surgery",
              "children": [
                {
                  "label": "many surgeons are reluctant to perform SO tendon weakening in patients with single binocular vision"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Clinical Approach",
      "children": [
        {
          "label": "analyze the relationship between elevators and depressors of 2 eyes",
          "children": [
            {
              "label": "right hyperdeviation",
              "children": [
                {
                  "label": "left eye is covered and right eye is forced to fixate",
                  "children": [
                    {
                      "label": "look at final position of nonfixating left eye once cover is removed"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "“true” vertical tropia",
          "children": [
            {
              "label": "innervation to depressors of right eye is matched in left eye",
              "children": [
                {
                  "label": "leading to a left hypotropia of a magnitude similar to that of the original right hypertropia"
                }
              ]
            },
            {
              "label": "incomitant in horizontal plane",
              "children": [
                {
                  "label": "oblique muscle disorder"
                }
              ]
            },
            {
              "label": "comitant in horizontal plane",
              "children": [
                {
                  "label": "vertical rectus disorder"
                }
              ]
            }
          ]
        },
        {
          "label": "unilateral DVD (right)",
          "children": [
            {
              "label": "left eye does not adopt a lower position but remains in the same position"
            }
          ]
        },
        {
          "label": "2"
        },
        {
          "label": "bilateral DVD",
          "children": [
            {
              "label": "left eye rises under cover, leading to a left hyperdeviation"
            },
            {
              "label": "double hyperphoria"
            }
          ]
        },
        {
          "label": "3"
        },
        {
          "label": "primary versus secondary deviation due to a restriction or palsy",
          "children": [
            {
              "label": "OR",
              "children": [
                {
                  "label": "combination of true vertical tropia + DVD"
                }
              ]
            },
            {
              "label": "left eye becomes hypotropic under cover but not to the same degree as the original right eye hypertropia"
            }
          ]
        },
        {
          "label": "4"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "innervational",
              "children": [
                {
                  "label": "overaction or underaction of muscles"
                },
                {
                  "label": "one of the most common causes of a true vertical tropia is fourth nerve (superior oblique) palsy",
                  "children": [
                    {
                      "label": "assume palsy is bilateral until proven otherwise"
                    }
                  ]
                }
              ]
            },
            {
              "label": "mechanical"
            }
          ]
        },
        {
          "label": "head-tilt test",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "deviation is incomitant in horizontal plane"
                },
                {
                  "label": "deviation is long-standing and comitant"
                }
              ]
            },
            {
              "label": "to determine whether an oblique muscle palsy may be the cause"
            },
            {
              "label": "3 steps",
              "children": [
                {
                  "label": "Step 1",
                  "children": [
                    {
                      "label": "determine which eye is hypertropic"
                    }
                  ]
                },
                {
                  "label": "Step 2",
                  "children": [
                    {
                      "label": "determine whether the vertical deviation is greater in right or left gaze"
                    }
                  ]
                },
                {
                  "label": "Step 3",
                  "children": [
                    {
                      "label": "determine whether the vertical deviation is greater in right or left head tilt"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Inferior oblique muscle overaction",
      "children": [
        {
          "label": "introduction",
          "children": [
            {
              "label": "between 1-6 years"
            },
            {
              "label": "in ≤2/3 of patients with infantile strabismus (ET or XT)",
              "children": [
                {
                  "label": "less frequent with acquired esotropia or exotropia"
                },
                {
                  "label": "occasionally, in patients with no other strabismus"
                }
              ]
            },
            {
              "label": "classification",
              "children": [
                {
                  "label": "primary",
                  "children": [
                    {
                      "label": "not associated with superior oblique muscle palsy"
                    }
                  ]
                },
                {
                  "label": "secondary",
                  "children": [
                    {
                      "label": "associated with superior oblique muscle or the contralateral superior rectus muscle palsy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "eye is elevated in adduction, both on horizontal movement and in upgaze",
              "children": [
                {
                  "label": "alternate cover testing",
                  "children": [
                    {
                      "label": "higher (adducting) eye refixates with a downward movement and lower (abducting) eye refixates with an upward movement",
                      "children": [
                        {
                          "label": "with DVD neither eye refixates with an upward movement!"
                        }
                      ]
                    },
                    {
                      "label": "when bilateral, higher and lower eyes reverse their direction of movement in the opposite lateral gaze",
                      "children": [
                        {
                          "label": "± asymmetric",
                          "children": [
                            {
                              "label": "greater overaction in an eye with poor vision"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "V-pattern horizontal deviation and extorsion are common"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "inferior oblique muscle weakening",
              "children": [
                {
                  "label": "technique",
                  "children": [
                    {
                      "label": "recession",
                      "children": [
                        {
                          "label": "modest recession actually functions as an anterior transposition",
                          "children": [
                            {
                              "label": "useful for correcting marked overaction of the inferior oblique muscle and DVD"
                            },
                            {
                              "label": "extorsion can also be improved"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "anterior transposition",
                      "children": [
                        {
                          "label": "spread-out reinsertion, especially if closer to the limbus than inferior rectus muscle",
                          "children": [
                            {
                              "label": "can restrict elevation, especially when the eye is abducted",
                              "children": [
                                {
                                  "label": "anti-elevation syndrome"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "disinsertion"
                    },
                    {
                      "label": "myectomy"
                    },
                    {
                      "label": "marginal myotomy"
                    }
                  ]
                },
                {
                  "label": "in general, weakening of inferior oblique muscles has an insignificant effect on horizontal alignment in primary position",
                  "children": [
                    {
                      "label": "for inferior oblique muscle weakening procedures, amount of horizontal rectus muscle surgery does not need to be altered"
                    }
                  ]
                },
                {
                  "label": "corrects ≤15Δ–20Δ of V pattern"
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        }
      ]
    },
    {
      "label": "Incomitant Vertical Tropias",
      "children": [
        {
          "label": "hypertropia that is significantly worse on gaze to one side"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "true overaction and underaction of the oblique muscles",
              "children": [
                {
                  "label": "most common"
                }
              ]
            },
            {
              "label": "oblique muscle pseudo-overactions",
              "children": [
                {
                  "label": "DVD"
                },
                {
                  "label": "large-angle exotropia"
                },
                {
                  "label": "thyroid eye disease"
                },
                {
                  "label": "rectus muscle pulley heterotopia",
                  "children": [
                    {
                      "label": "connective tissue pulleys where path of oblique muscles crosses that of rectus muscles"
                    },
                    {
                      "label": "craniofacial syndromes"
                    },
                    {
                      "label": "inferiorly displaced lateral rectus muscle",
                      "children": [
                        {
                          "label": "overelevation in adduction"
                        },
                        {
                          "label": "V-pattern deviation"
                        },
                        {
                          "label": "simulating an inferior oblique muscle overaction"
                        }
                      ]
                    },
                    {
                      "label": "superiorly displaced lateral rectus muscle",
                      "children": [
                        {
                          "label": "overdepression in adduction"
                        },
                        {
                          "label": "A-pattern deviation"
                        },
                        {
                          "label": "simulating a superior oblique overaction"
                        }
                      ]
                    },
                    {
                      "label": "lateral and medial malpositioning of vertical rectus muscles"
                    },
                    {
                      "label": "large A and V patterns associated with these anomalous pulley positions respond poorly to oblique muscle surgery",
                      "children": [
                        {
                          "label": "more effective to relocate rectus muscle positions"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Duane retraction syndrome"
                },
                {
                  "label": "restrictions of the superior or inferior rectus muscles",
                  "children": [
                    {
                      "label": "causing overinnervation of contralateral oblique muscles"
                    }
                  ]
                },
                {
                  "label": "skew deviation"
                },
                {
                  "label": "severe Brown syndrome"
                },
                {
                  "label": "limitation of elevation in abduction after inferior oblique muscle anterior transposition"
                },
                {
                  "label": "clinical examination indicates apparent overaction of both superior and inferior oblique muscles",
                  "children": [
                    {
                      "label": "pathogenesis",
                      "children": [
                        {
                          "label": "elevation or depression of vertical rectus muscle of opposite, abducting eye is restricted",
                          "children": [
                            {
                              "label": "Hering’s law",
                              "children": [
                                {
                                  "label": "extra innervation to yoke oblique muscles"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "slippage of a tight lateral rectus as eye adducts and rises above or below midline"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
