{
  "label": "6.12.3. Special Forms of Strabismus (III)",
  "root": true,
  "children": [
    {
      "label": "Brown Syndrome",
      "children": [
        {
          "label": "introduction",
          "children": [
            {
              "label": "restriction of elevation in adduction"
            },
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "abnormalities of the superior oblique tendon– trochlea complex"
                },
                {
                  "label": "structural problems remote from superior oblique tendon, including instability of lateral rectus pulley, can present an identical clinical picture",
                  "children": [
                    {
                      "label": "pseudo–Brown syndrome"
                    }
                  ]
                }
              ]
            },
            {
              "label": "types",
              "children": [
                {
                  "label": "congenital",
                  "children": [
                    {
                      "label": "most cases"
                    }
                  ]
                },
                {
                  "label": "acquired",
                  "children": [
                    {
                      "label": "trauma in region of trochlea"
                    },
                    {
                      "label": "iatrogenic causes",
                      "children": [
                        {
                          "label": "scleral buckles"
                        },
                        {
                          "label": "glaucoma drainage devices"
                        }
                      ]
                    },
                    {
                      "label": "orbital tumors"
                    },
                    {
                      "label": "systemic inflammatory conditions",
                      "children": [
                        {
                          "label": "often result in intermittent Brown syndrome",
                          "children": [
                            {
                              "label": "may resolve spontaneously"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "sinusitis",
                      "children": [
                        {
                          "label": "patients with acute-onset presentation of Brown syndrome of undetermined cause should undergo imaging of the orbits and paranasal sinuses"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "bilateral in ≈ 10%"
            },
            {
              "label": "spontaneous improvement in 75%",
              "children": [
                {
                  "label": "often over many years"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "deficient elevation in adduction",
              "children": [
                {
                  "label": "improves in abduction but often not completely"
                }
              ]
            },
            {
              "label": "positive forced-duction test demonstrating restricted passive elevation in adduction is essential for diagnosis",
              "children": [
                {
                  "label": "retropulsion of globe during this test stretches the superior oblique tendon and accentuates the restriction",
                  "children": [
                    {
                      "label": "in restrictions involving inferior rectus muscle the limitation of passive elevation is accentuated by forceps-induced proptosis of the eye rather than by retropulsion"
                    }
                  ]
                }
              ]
            },
            {
              "label": "attempts at elevation straight upward usually cause divergence (V pattern)",
              "children": [
                {
                  "label": "inferior oblique muscle paralysis usually exhibits an A pattern"
                }
              ]
            },
            {
              "label": "widening of palpebral fissure in adduction"
            },
            {
              "label": "hypotropia in primary position",
              "children": [
                {
                  "label": "in severe cases",
                  "children": [
                    {
                      "label": "unlike Duane retraction syndrome"
                    }
                  ]
                },
                {
                  "label": "chin-up head posture or head turn away from affected eye"
                }
              ]
            },
            {
              "label": "downshoot of involved eye on gaze to opposite side (overdepression in adduction)",
              "children": [
                {
                  "label": "in severe cases"
                },
                {
                  "label": "in true superior oblique muscle overaction downshoot occurs less abruptly as adduction is increased"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "mild congenital cases",
              "children": [
                {
                  "label": "observation"
                }
              ]
            },
            {
              "label": "cases secondary to rheumatoid arthritis or other systemic inflammatory diseases",
              "children": [
                {
                  "label": "systemic treatment of underlying disease"
                },
                {
                  "label": "corticosteroids injection near trochlea"
                }
              ]
            },
            {
              "label": "more severe congenital cases",
              "children": [
                {
                  "label": "ipsilateral superior oblique tenotomy nasal to the superior rectus muscle",
                  "children": [
                    {
                      "label": "complications",
                      "children": [
                        {
                          "label": "iatrogenic superior oblique muscle paresis",
                          "children": [
                            {
                              "label": "prevention",
                              "children": [
                                {
                                  "label": "careful handling of intermuscular septum"
                                },
                                {
                                  "label": "avoidance of complete tenotomy as a sole procedure",
                                  "children": [
                                    {
                                      "label": "insertion of an inert spacer or suture between the cut ends of the superior oblique tendon"
                                    },
                                    {
                                      "label": "Z-plasty of tendon on the medial side"
                                    },
                                    {
                                      "label": "partial (80%) tenectomy of the posterior portion of the tendon on the temporal side"
                                    }
                                  ]
                                },
                                {
                                  "label": "some surgeons perform simultaneous ipsilateral inferior oblique muscle weakening"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "downgaze restriction due to adhesions",
                          "children": [
                            {
                              "label": "repair the intermuscular septum to prevent contact of spacer or suture with nearby structures"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Thyroid Eye Disease",
      "children": [
        {
          "label": "introduction",
          "children": [
            {
              "label": "lymphocytic infiltration of the EOMs",
              "children": [
                {
                  "label": "Edema"
                },
                {
                  "label": "inflammation"
                },
                {
                  "label": "fibrosis"
                },
                {
                  "label": "restrict motility"
                }
              ]
            },
            {
              "label": "thyroid-stimulating immunoglobulins (TSIs) mediate thyroid eye disease"
            },
            {
              "label": "some patients also have myasthenia gravis"
            },
            {
              "label": "association between severity of thyroid eye disease and smoking",
              "children": [
                {
                  "label": "hazard ratio for strabismus surgery is ≈ double in patients with thyroid disease who smoke"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "inferior rectus>medial rectus>superior rectus>lateral rectus",
              "children": [
                {
                  "label": "hypotropia",
                  "children": [
                    {
                      "label": "common cause of acquired vertical deviation in adults",
                      "children": [
                        {
                          "label": "especially women"
                        },
                        {
                          "label": "rare in children"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "esotropia"
                }
              ]
            },
            {
              "label": "most often bilateral",
              "children": [
                {
                  "label": "often asymmetric"
                }
              ]
            },
            {
              "label": "positive forced-duction test"
            },
            {
              "label": "upper eyelid retraction"
            },
            {
              "label": "proptosis"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "botulinum toxin",
              "children": [
                {
                  "label": "may reduce the severity of fibrosis when injected into tight muscles in the acute phase"
                }
              ]
            },
            {
              "label": "prisms",
              "children": [
                {
                  "label": "may alleviate diplopia"
                }
              ]
            },
            {
              "label": "indications for strabismus surgery",
              "children": [
                {
                  "label": "diplopia"
                },
                {
                  "label": "abnormal head position"
                }
              ]
            },
            {
              "label": "surgery rarely restores normal motility"
            },
            {
              "label": "1/2 patients who had surgery before stability was achieved required further surgery"
            },
            {
              "label": "recession of the affected tight muscles in 1 or both eyes is the preferred surgical treatment",
              "children": [
                {
                  "label": "slight initial undercorrection is desirable",
                  "children": [
                    {
                      "label": "late progressive overcorrection is common, especially with large inferior rectus muscle recessions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "strengthening procedures usually worsen restriction",
              "children": [
                {
                  "label": "unlike XT repair"
                }
              ]
            },
            {
              "label": "adjustable sutures can be helpful in these difficult cases"
            },
            {
              "label": "limited depression of the eyes after inferior rectus muscle recessions can interfere with patients’ bifocal use"
            },
            {
              "label": "proptosis can become worse after EOM recessions"
            },
            {
              "label": "postpone strabismus surgery until decompression has been accomplished"
            },
            {
              "label": "perform surgery after strabismus measurements and thyroid function tests have been stable for ≥6-12 months"
            },
            {
              "label": "postpone eyelid surgery until the strabismus is treated",
              "children": [
                {
                  "label": "upper eyelid retraction may improve once the patient no longer strains to elevate the eye"
                }
              ]
            },
            {
              "label": "large recessions of very tight inferior rectus muscles can cause lower eyelid retraction",
              "children": [
                {
                  "label": "severe lower eyelid retractors as part of strabismus surgery"
                },
                {
                  "label": "place spacer of banked sclera or synthetic material to vertically lengthen lower eyelid tarsus"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Third Nerve Palsy",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "children",
              "children": [
                {
                  "label": "congenital",
                  "children": [
                    {
                      "label": "40%–50%"
                    }
                  ]
                },
                {
                  "label": "trauma"
                },
                {
                  "label": "inflammation"
                },
                {
                  "label": "viral infection"
                },
                {
                  "label": "ophthalmoplegic migraine"
                },
                {
                  "label": "after vaccination"
                },
                {
                  "label": "neoplastic lesion"
                }
              ]
            },
            {
              "label": "adults",
              "children": [
                {
                  "label": "intracranial aneurysm"
                },
                {
                  "label": "microvascular infarction"
                },
                {
                  "label": "inflammation"
                },
                {
                  "label": "trauma"
                },
                {
                  "label": "infection"
                },
                {
                  "label": "tumor"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "ischemic (microvascular) causes",
              "children": [
                {
                  "label": "± pupil-sparing"
                }
              ]
            },
            {
              "label": "compressive lesions",
              "children": [
                {
                  "label": "cause mydriasis"
                }
              ]
            },
            {
              "label": "complete paralysis",
              "children": [
                {
                  "label": "limited adduction, elevation, and depression of the eye",
                  "children": [
                    {
                      "label": "causing exotropia and often hypotropia"
                    },
                    {
                      "label": "adults report incapacitating diplopia",
                      "children": [
                        {
                          "label": "incidence of diplopia in patients <8 years is low"
                        }
                      ]
                    },
                    {
                      "label": "amblyopia is common in children"
                    }
                  ]
                },
                {
                  "label": "upper eyelid ptosis",
                  "children": [
                    {
                      "label": "often with pseudoptosis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "misdirection (aberrant regeneration) of the damaged nerve",
              "children": [
                {
                  "label": "anomalous eyelid elevation, pupil constriction, or vertical excursion of the globe"
                },
                {
                  "label": "on attempted rotation into field of action of EOMs supplied by injured nerve"
                }
              ]
            },
            {
              "label": "miotic pupil sometimes seen in congenital cases"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "wait ≥6 months (even up to 12 months) for spontaneous recovery",
              "children": [
                {
                  "label": "except in congenital cases"
                }
              ]
            },
            {
              "label": "patients with at least partial recovery have much better functional and cosmetic results"
            },
            {
              "label": "prism adaptation testing",
              "children": [
                {
                  "label": "adult patients who can achieve single binocular vision with prisms of any power before surgery are most likely to do well"
                }
              ]
            },
            {
              "label": "goal of surgery",
              "children": [
                {
                  "label": "adequate alignment for binocular function in primary position and in slight downgaze for reading"
                }
              ]
            },
            {
              "label": "incomplete paralysis",
              "children": [
                {
                  "label": "large recession-resection of the horizontal rectus muscles to correct the exodeviation"
                },
                {
                  "label": "supraplacement of both to correct the hypotropia"
                }
              ]
            },
            {
              "label": "complete paralysis",
              "children": [
                {
                  "label": "large lateral rectus muscle recession + fixation of the globe to nasal orbital periosteum"
                },
                {
                  "label": "disinsertion of lateral rectus muscle and reattachment to lateral orbital periosteum can maximize muscle inactivation"
                }
              ]
            },
            {
              "label": "hypotropia",
              "children": [
                {
                  "label": "concurrent superior oblique tenotomy"
                },
                {
                  "label": "transfer of superior oblique tendon to upper nasal quadrant of globe",
                  "children": [
                    {
                      "label": "anomalous eye movements can result from this procedure"
                    }
                  ]
                }
              ]
            },
            {
              "label": "reserve correction of ptosis for a subsequent procedure"
            }
          ]
        }
      ]
    },
    {
      "label": "Sixth Nerve Palsy",
      "children": [
        {
          "label": "less common in children than in adults"
        }
      ]
    }
