              "label": "optic nerve compression"
            },
            {
              "label": "retinal striae"
            },
            {
              "label": "hyperopia"
            },
            {
              "label": "increased intraocular pressure (IOP)"
            },
            {
              "label": "growth may accelerate during pregnancy"
            }
          ]
        },
        {
          "label": "orbital imaging",
          "children": [
            {
