{
  "label": "6.13.2. Childhood Nystagmus (II): Congenital nystagmus",
  "root": true,
  "children": [
    {
      "label": "periodic alternating nystagmus (PAN)",
      "children": [
        {
          "label": "types",
          "children": [
            {
              "label": "congenital",
              "children": [
                {
                  "label": "associated with oculocutaneous albinism"
                }
              ]
            },
            {
              "label": "acquired",
              "children": [
                {
                  "label": "Arnold-Chiari malformation"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "jerk nystagmus"
            },
            {
              "label": "strictly horizontal"
            },
            {
              "label": "nystagmus periodically changes direction",
              "children": [
                {
                  "label": "starts with a jerk nystagmus in 1 direction"
                },
                {
                  "label": "slowly begins to damp, leading to a period of no nystagmus x 10 - 20 seconds"
                },
                {
                  "label": "jerks in the opposite direction"
                },
                {
                  "label": "cycle repeats ≈ every 4 minutes"
                }
              ]
            },
            {
              "label": "some children adopt an alternating head turn"
            }
          ]
        },
        {
          "label": "Periodic alternating nystagmus (PAN)",
          "children": [
            {
              "label": "congenital or acquired",
              "children": [
                {
                  "label": "associated with oculocutaneous albinism"
                }
              ]
            },
            {
              "label": "strictly horizontal"
            },
            {
              "label": "oscillation cycle of 2–4 minutes",
              "children": [
                {
                  "label": "any purely horizontal nystagmus that occurs in primary position should be observed for at least 2 minutes"
                },
                {
                  "label": "crescendo–decrescendo nystagmus",
                  "children": [
                    {
                      "label": "change in amplitude and frequency"
                    }
                  ]
                },
                {
                  "label": "short period of downbeat or no nystagmus",
                  "children": [
                    {
                      "label": "10-20 seconds"
                    }
                  ]
                },
                {
                  "label": "crescendo–decrescendo nystagmus in the opposite direction"
                }
              ]
            },
            {
              "label": "periodic alternating head turn",
              "children": [
                {
                  "label": "to minimize the nystagmus, in accordance with Alexander’s law"
                }
              ]
            },
            {
              "label": "dysfunction of the cerebellar nodulus and uvula",
              "children": [
                {
                  "label": "multiple sclerosis"
                },
                {
                  "label": "cerebellar degeneration"
                },
                {
                  "label": "Arnold-Chiari type I malformation"
                },
                {
                  "label": "stroke"
                },
                {
                  "label": "use of anticonvulsant medication"
                },
                {
                  "label": "bilateral loss of vision",
                  "children": [
                    {
                      "label": "reversible"
                    }
                  ]
                }
              ]
            },
            {
              "label": "baclofen",
              "children": [
                {
                  "label": "can be effective for the acquired form"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "congenital motor nystagmus (CMN)",
      "children": [
        {
          "label": "not associated with central nervous system abnormalities"
        },
        {
          "label": "binocular conjugate nystagmus"
        },
        {
          "label": "nearly normal visual function"
        },
        {
          "label": "plane of nystagmus is most often horizontal",
          "children": [
            {
              "label": "remains so on upgaze and downgaze (uniplanar)"
            }
          ]
        },
        {
          "label": "exponential increase in velocity of the slow phase"
        },
        {
          "label": "± null point",
          "children": [
            {
              "label": "± abnormal head position",
              "children": [
                {
                  "label": "head position becomes more pronounced as child approaches school age"
                }
              ]
            }
          ]
        },
        {
          "label": "head bobbing or movement",
          "children": [
            {
              "label": "may be present initially but usually decreases with age"
            }
          ]
        },
        {
          "label": "oscillopsia is rare"
        },
        {
          "label": "damped by convergence",
          "children": [
            {
              "label": "can be associated with esotropia",
              "children": [
                {
                  "label": "nystagmus blockage syndrome",
                  "children": [
                    {
                      "label": "combination of nystagmus and esotropia"
                    },
                    {
                      "label": "characteristically present with an esotropia that “eats up prism” on attempted measurement"
                    },
                    {
                      "label": "exhibit an increased jerk nystagmus on attempted lateral gaze"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "paradoxical inversion of OKN response",
          "children": [
            {
              "label": "2/3 of patients"
            },
            {
              "label": "patient with right jerk nystagmus views an OKN drum rotating to the patient’s left",
              "children": [
                {
                  "label": "exhibits a damped right jerk nystagmus or possibly even a left jerk nystagmus"
                }
              ]
            },
            {
              "label": "occurs only in CMN"
            }
          ]
        },
        {
          "label": "Infantile Nystagmus Syndrome (INS)/ Congenital Nystagmus (CN)",
          "children": [
            {
              "label": "epidemiology",
              "children": [
                {
                  "label": "onset in first few months of life",
                  "children": [
                    {
                      "label": "may not become evident until several years of age"
                    }
                  ]
                },
                {
                  "label": "± family history"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "no oscillopsia"
                },
                {
                  "label": "conjugate"
                },
                {
                  "label": "horizontal",
                  "children": [
                    {
                      "label": "remains horizontal in upgaze and downgaze"
                    }
                  ]
                },
                {
                  "label": "continuous or intermittent"
                },
                {
                  "label": "jerk or pendular",
                  "children": [
                    {
                      "label": "depending on position of gaze"
                    }
                  ]
                },
                {
                  "label": "accentuation by visual attention & distant fixation",
                  "children": [
                    {
                      "label": "unlike peripheral vestibular nystagmus"
                    }
                  ]
                },
                {
                  "label": "abolished in sleep",
                  "children": [
                    {
                      "label": "diminishment by convergence"
                    }
                  ]
                },
                {
                  "label": "slow phase in the direction opposite that of a rotating optokinetic drum",
                  "children": [
                    {
                      "label": "reversal of normal pattern!",
                      "children": [
                        {
                          "label": "in contrast to constant velocity slow phase of latent nystagmus"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "exponential increasing velocity of slow phase with distance from fixation",
                  "children": [
                    {
                      "label": "requires eye movement recordings"
                    }
                  ]
                },
                {
                  "label": "there is frequently a null point",
                  "children": [
                    {
                      "label": "field of gaze in which nystagmus intensity is minimal"
                    },
                    {
                      "label": "head turn or posture",
                      "children": [
                        {
                          "label": "if the null point is not in primary position"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "strabismus",
                  "children": [
                    {
                      "label": "15%"
                    }
                  ]
                },
                {
                  "label": "not associated with afferent pathway disease",
                  "children": [
                    {
                      "label": "visual acuity is proportional to the foveation period"
                    }
                  ]
                }
              ]
            },
            {
              "label": "sensory nystagmus",
              "children": [
                {
                  "label": "central visual acuity is too poor to develop a stable fixational mechanism"
                },
                {
                  "label": "etiology",
                  "children": [
                    {
                      "label": "ocular albinism"
                    },
                    {
                      "label": "achromatopsia"
                    },
                    {
                      "label": "leber congenital amaurosis"
                    },
                    {
                      "label": "aniridia"
                    }
                  ]
                },
                {
                  "label": "in any patient with early-onset nystagmus look for evidence of damage to the visual pathways",
                  "children": [
                    {
                      "label": "impairment of visual tracking"
                    },
                    {
                      "label": "optic atrophy"
                    },
                    {
                      "label": "presence of such abnormalities should prompt neuroimaging"
                    },
                    {
                      "label": "electrophysiologic testing (ERG, VEP) is warranted"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "latent nystagmus",
      "children": [
        {
          "label": "occurs in children with decreased fusion",
          "children": [
            {
              "label": "early-onset strabismus",
              "children": [
                {
                  "label": "most commonly infantile esotropia"
                }
              ]
            },
            {
              "label": "decreased vision in 1 or both eyes"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "when 1 eye is occluded, a conjugate jerk nystagmus develops",
              "children": [
                {
                  "label": "fast phase directed toward the uncovered eye",
                  "children": [
                    {
                      "label": "left jerk nystagmus occurs when the right eye is covered"
                    },
                    {
                      "label": "the only form that reverses direction with a change in fixation"
                    }
                  ]
                },
                {
                  "label": "the nystagmus damps when the fixating eye is in adduction",
                  "children": [
                    {
                      "label": "head turn reverses with a change in fixation",
                      "children": [
                        {
                          "label": "occlusion of the right eye causes left jerk nystagmus with a left head turn"
                        }
                      ]
                    },
                    {
                      "label": "in CMN, nystagmus damps with convergence"
                    }
                  ]
                }
              ]
            },
            {
              "label": "asymmetries in amplitude, frequency, and velocity of the nystagmus can also be present"
            },
            {
              "label": "binocular visual acuity is better than monocular"
            },
            {
              "label": "manifest latent nystagmus",
              "children": [
                {
                  "label": "nystgmus becomes manifest when both eyes are open but only 1 eye is being used for vision",
                  "children": [
                    {
                      "label": "other eye is suppressed or amblyopic",
                      "children": [
                        {
                          "label": "in contrast to exponentialy increasing velocity of slow phase with CMN"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "nystagmus waveform",
              "children": [
                {
                  "label": "exponentially decreasing velocity of slow phase"
                }
              ]
            }
          ]
        },
        {
          "label": "Fusional Maldevelopment Nystagmus Syndrome (Latent Nystagmus)",
          "children": [
            {
              "label": "clinical characteristics",
              "children": [
                {
                  "label": "begins (or accentuates) when binocular viewing is disrupted",
                  "children": [
                    {
                      "label": "use of a standard occluder degrades visual acuity",
                      "children": [
                        {
                          "label": "partial optical blurring of 1 eye permits better visual acuity measurements",
                          "children": [
                            {
                              "label": "high-plus lens or filter"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "early-onset"
                },
                {
                  "label": "conjugate horizontal jerk nystagmus",
                  "children": [
                    {
                      "label": "constant-velocity slow phase",
                      "children": [
                        {
                          "label": "in contrast to the increasing exponential slow phase of INS/CN"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "direction changing with monocular occlusion",
                  "children": [
                    {
                      "label": "fast phase toward the viewing eye; slow phase toward the nose/occluded eye",
                      "children": [
                        {
                          "label": "both slow phase and eye are toward nose (occluded eye)"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "almost always associated with esotropia"
                },
                {
                  "label": "subnormal stereopsis"
                },
                {
                  "label": "may coexist with INS"
                },
                {
                  "label": "frequently, with dissociated vertical deviation"
                }
              ]
            },
            {
              "label": "manifest latent nystagmus (MLN)",
              "children": [
                {
                  "label": "nystagmus with characteristics of LN that is present when both eyes are open"
                },
                {
                  "label": "nystagmus spontaneously and intermittently develops whenever the esotropic eye is physiologically suppressed"
                }
              ]
            },
            {
              "label": "LN and MLN are benign entities"
            }
          ]
        }
      ]
    },
    {
      "label": "congenital sensory nystagmus",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "bilateral pregeniculate, afferent visual pathway abnormality"
            }
          ]
        },
        {
          "label": "if the visual pathway disorder is present at birth, the resulting nystagmus becomes apparent in the first 3 months of life"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "type of nystagmus",
              "children": [
                {
                  "label": "searching nystagmus",
                  "children": [
                    {
                      "label": "slow searching/wandering conjugate horizontal eye movements without fixation"
                    },
                    {
                      "label": "usually seen in children whose visual acuity is < 20/200"
                    }
                  ]
                },
                {
                  "label": "pendular nystagmus",
                  "children": [
                    {
                      "label": "patients with visual acuity of >20/200 in at least 1 eye"
                    }
                  ]
                },
                {
                  "label": "jerk nystagmus",
                  "children": [
                    {
                      "label": "patients with visual acuity of 20/60 - 20/100"
                    }
                  ]
                },
                {
                  "label": "severity is somewhat correlated with the degree of vision loss"
                },
                {
                  "label": "waveform cannot be distinguished from that of congenital motor nystagmus"
                }
              ]
            },
            {
              "label": "congenital sensory nystagmus as a result of a retinal dystrophy",
              "children": [
                {
                  "label": "mild vascular attenuation"
                },
                {
                  "label": "optic disc pallor"
                },
                {
                  "label": "± completely normal retinal appearance"
                },
                {
                  "label": "electroretinogram may be required"
                }
              ]
            }
          ]
        }
      ]
    }
