  "children": [
    {
      "label": "Thygeson Superficial Punctate Keratitis",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "unknown"
            },
            {
              "label": "+- immune-mediated"
            },
            {
              "label": "no inflammatory cells"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "children to older adults"
            },
            {
              "label": "bilateral",
              "children": [
                {
                  "label": "may develop initially in 1 eye"
                },
                {
                  "label": "may be markedly asymmetric"
                }
              ]
            },
            {
              "label": "recurrent episodes"
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "tearing"
                },
                {
                  "label": "foreign-body sensation"
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "reduced vision"
                },
                {
                  "label": "symptoms may far exceed the apparent signs"
                }
              ]
            },
            {
              "label": "slightly elevated corneal epithelial lesions",
              "children": [
                {
                  "label": "each opacity is a cluster of multiple smaller gray, granular pinpoint opacities"
                },
                {
                  "label": "multiple (2-40)"
                },
                {
                  "label": "greatest density in the central cornea"
                },
                {
                  "label": "\"negative staining\"",
                  "children": [
                    {
                      "label": "stain faintly with fluorescein and rose bengal"
                    }
                  ]
                },
                {
                  "label": "minimal conjunctival reaction"
                },
                {
                  "label": "waxing and waning appearance of individual epithelial opacities",
                  "children": [
                    {
                      "label": "change in location and number",
                      "children": [
                        {
                          "label": "in contrast to adenoviral keratoconjunctivitis"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "+- mild subepithelial opacity",
                  "children": [
                    {
                      "label": "in patients who have received topical antiviral therapy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "mild cases",
              "children": [
                {
                  "label": "artificial tears"
                }
              ]
            },
            {
              "label": "persistently symptomatic cases",
              "children": [
                {
                  "label": "low-dose topical corticosteroids",
                  "children": [
                    {
                      "label": "fluorometholone 0.1%"
                    },
                    {
                      "label": "very responsive to corticosteroids"
                    },
                    {
                      "label": "recur in the same or different locations after the topical corticosteroids are stopped"
                    },
                    {
                      "label": "the use of corticosteroids should be minimized"
                    }
                  ]
                },
                {
                  "label": "topical cyclosporine 0.05%"
                },
                {
                  "label": "bandage soft contact lenses",
                  "children": [
                    {
                      "label": "tacrolimus ophthalmic suspension 0.1%",
                      "children": [
                        {
                          "label": "preferred over corticosteroids"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
