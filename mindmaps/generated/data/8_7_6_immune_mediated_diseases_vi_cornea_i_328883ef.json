    {
      "label": "Corneal Transplant Rejection",
      "children": [
        {
          "label": "tolerance of a corneal graft is an active process based on several features",
          "children": [
            {
              "label": "absence of blood and lymphatic channels in the graft and its bed"
            },
            {
              "label": "absence of MHC class II+ APCs in the graft"
            },
            {
              "label": "reduced expression of MHC-encoded alloantigens on graft cells replaced with minor peptides (nonclassical MHC-Ib molecules) to avoid lysis by natural killer cells"
            },
            {
              "label": "expression of T-cell–deleting CD95 ligand (Fas ligand, or FasL) on endothelium, which can induce apoptosis in killer T cells"
            },
            {
              "label": "immunosuppressive microenvironment of the aqueous humor",
              "children": [
                {
                  "label": "transforming growth factor β2, α-melanocyte- stimulating hormone, vasoactive intestinal peptide, and calcitonin gene–related peptide"
                }
              ]
            }
          ]
        },
        {
          "label": "allograft rejection is associated with cellular immune mechanisms",
          "children": [
            {
              "label": "anterior chamber–associated immune deviation (ACAID) involving the development of suppressor T cells",
              "children": [
                {
                  "label": "ACAID is a downregulation of delayed-type cellular immunity"
                }
              ]
            },
            {
              "label": "T-lymphocyte–mediated response",
              "children": [
                {
                  "label": "delayed (type IV) hypersensitivity"
                }
              ]
            }
          ]
        },
        {
          "label": "for the endothelial cells to be rejected, they must express MHC class II antigens",
          "children": [
            {
              "label": "endothelial cells’ endogenous minor H antigens",
              "children": [
                {
                  "label": "recognized by the CD4+ T cells"
                }
              ]
            }
          ]
        }
      ]
    }
