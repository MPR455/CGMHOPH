                  "label": "vascular tumor of the orbit"
                },
                {
                  "label": "blood dyscrasias"
                }
              ]
            }
          ]
        },
        {
          "label": "surgical management",
          "children": [
            {
              "label": "urgent lateral canthotomy and cantholysis"
            },
            {
              "label": "orbital decompression"
            },
            {
              "label": "surgical drainage"
            },
            {
              "label": "seldom necessary unless visual function is compromised by",
              "children": [
                {
                  "label": "compression of the optic nerve"
                },
                {
                  "label": "increased orbital pressure that impedes arterial perfusion"
                }
              ]
            }
          ]
        },
        {
          "label": "hematic cyst",
          "children": [
            {
              "label": "following accidental trauma"
            },
            {
              "label": "usually beneath the periosteum"
            }
          ]
        }
