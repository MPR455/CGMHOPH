    {
      "label": "pathology",
      "children": [
        {
          "label": "fragmentation of the Bowman layer"
        },
        {
          "label": "folds or breaks in the Descemet membrane"
        },
        {
          "label": "thinning of the stroma and overlying epithelium"
        },
        {
          "label": "variable amounts of diffuse scarring"
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "glasses"
        },
        {
          "label": "rigid or gas-permeable contact lenses",
          "children": [
            {
              "label": "far more helpful in all but the mildest cases",
              "children": [
                {
                  "label": "able to neutralize irregular corneal astigmatism"
                }
              ]
            },
            {
              "label": "central subepithelial scar can, on occasion, be removed (nodulectomy) allowing continued wear of contact lenses"
            }
          ]
        },
        {
          "label": "intrastromal rings & collagen crosslinking",
          "children": [
            {
              "label": "flatten and centralize the cone",
              "children": [
                {
                  "label": "improve vision"
                },
                {
                  "label": "facilitate use of contact lenses"
                }
              ]
            },
            {
              "label": "stabilize progression"
            }
          ]
        },
        {
          "label": "corneal transplantation",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "contact lens intolerance even with good vision"
                },
                {
                  "label": "poor vision even with a comfortable contact lens fit (usually due to scarring)"
                },
                {
                  "label": "unstable contact lens fit (even with good vision and tolerance)"
                },
                {
                  "label": "progressive thinning to the periphery approaching the limbus, requiring a very large graft (with increased risk)"
                }
              ]
            },
            {
              "label": "PK",
              "children": [
                {
                  "label": "most widely performed surgical procedure"
                },
                {
                  "label": "prognosis is excellent"
                }
              ]
            },
            {
              "label": "DALK",
              "children": [
                {
                  "label": "wound integrity with DALK is superior",
                  "children": [
                    {
                      "label": "leaves host’s endothelium untouched, decreasing rejection episodes"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "hydrops",
