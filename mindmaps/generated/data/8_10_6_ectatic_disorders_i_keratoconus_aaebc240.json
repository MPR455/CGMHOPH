      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "bilateral",
          "children": [
            {
              "label": "± asymmetrical",
              "children": [
                {
                  "label": "less affected eye may show",
                  "children": [
                    {
                      "label": "high astigmatism"
                    },
                    {
                      "label": "enantiomorphism (a mirror image) on videokeratoscopy"
                    },
                    {
                      "label": "mild steepening"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "early signs of keratoconus",
          "children": [
            {
              "label": "scissoring of the red reflex on ophthalmoscopy or retinoscopy"
            },
            {
              "label": "Rizzutti sign",
              "children": [
                {
                  "label": "conical reflection on the nasal cornea when a penlight is shone from the temporal side"
                }
              ]
            }
          ]
        },
        {
          "label": "tends to progress during adolescence and mid-20s - 30s",
          "children": [
            {
              "label": "central or paracentral cornea undergoes progressive thinning and bulging",
              "children": [
                {
                  "label": "cornea takes on the shape of a cone"
                },
                {
                  "label": "extreme degrees of irregular astigmatism can develop",
                  "children": [
                    {
                      "label": "focal ruptures and flecklike scars in Bowman layer"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Munson sign",
          "children": [
            {
              "label": "protrusion of the lower eyelid upon downgaze"
            }
          ]
        },
        {
          "label": "Fleischer ring",
          "children": [
            {
              "label": "brown iron deposit ring within the epithelium around base of cone"
            },
            {
              "label": "best seen with cobalt blue filter"
            }
          ]
        },
        {
          "label": "Vogt lines",
          "children": [
            {
              "label": "fine, relucent, and roughly parallel striations of posterior stroma"
            }
          ]
        },
        {
          "label": "spontaneous perforation",
          "children": [
            {
              "label": "extremely rare"
            }
          ]
        },
        {
          "label": "acute hydrops",
          "children": [
            {
              "label": "tear in Descemet membrane",
              "children": [
                {
                  "label": "sudden development of corneal edema"
                },
                {
                  "label": "usually heals spontaneously in 6–12 weeks",
                  "children": [
                    {
                      "label": "corneal edema disappears",
                      "children": [
                        {
                          "label": "± stromal scarring"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
