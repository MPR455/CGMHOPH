{
  "label": "7.10.4. Eyelid Neoplasms (I): Benign eyelid lesions",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "Predisposing factors in development of skin cancer",
          "children": [
            {
              "label": "prior skin cancer"
            },
            {
              "label": "excessive sun exposure, especially blistering sunburn"
            },
            {
              "label": "previous radiation therapy"
            },
            {
              "label": "history of smoking"
            },
            {
              "label": "Celtic or Scandinavian ancestry, with fair skin, red hair, and blue eyes"
            },
            {
              "label": "immunosuppression"
            }
          ]
        },
        {
          "label": "examination",
          "children": [
            {
              "label": "Signs suggesting skin cancer",
              "children": [
                {
                  "label": "slow, painless growth of a lesion"
                },
                {
                  "label": "ulceration, drainage, bleeding, and crusting"
                },
                {
                  "label": "pigmentary changes"
                },
                {
                  "label": "destruction of normal eyelid margin architecture (especially meibomian orifices) and loss of cilia"
                },
                {
                  "label": "heaped-up, pearly, translucent margins with central ulceration"
                },
                {
                  "label": "fine telangiectasias"
                },
                {
                  "label": "loss of fine cutaneous wrinkles or vellus hair"
                }
              ]
            },
            {
              "label": "Palpable induration beyond visibly apparent margins suggests tumor infiltration into the dermis and subcutaneous tissue"
            },
            {
              "label": "Large lesions should be palpated for evidence of fixation to deeper tissues or bone"
            },
            {
              "label": "Lesions near the puncta should be evaluated for punctal/canalicular involvement",
              "children": [
                {
                  "label": "Probing and irrigation may be required"
                }
              ]
            },
            {
              "label": "regional lymph nodes should be palpated",
              "children": [
                {
                  "label": "rubbery swelling along the line of the jaw or in front of the ear",
                  "children": [
                    {
                      "label": "squamous cell carcinoma"
                    },
                    {
                      "label": "sebaceous carcinoma"
                    },
                    {
                      "label": "melanoma"
                    },
                    {
                      "label": "Merkel cell carcinoma"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Restriction of ocular motility and proptosis suggest orbital extension"
            },
            {
              "label": "examine cranial nerves V and VII",
              "children": [
                {
                  "label": "Perineural invasion",
                  "children": [
                    {
                      "label": "squamous cell carcinoma"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Systemic metastasis (liver, pulmonary, bone, or neurological)",
              "children": [
                {
                  "label": "sebaceous adenocarcinoma"
                },
                {
                  "label": "melanoma of the eyelid"
                }
              ]
            },
            {
              "label": "obtain photographs and measurements prior to treatment"
            }
          ]
        }
      ]
    },
    {
      "label": "Benign epithelial lesions",
      "children": [
        {
          "label": "Cysts of the epidermis",
          "children": [
            {
              "label": "second most common type of benign periocular cutaneous lesions",
              "children": [
                {
                  "label": "18% of excised benign lesions"
                }
              ]
            },
            {
              "label": "epidermal inclusion cyst",
              "children": [
                {
                  "label": "arise from infundibulum of hair follicle",
                  "children": [
                    {
                      "label": "spontaneous"
                    },
                    {
                      "label": "traumatic"
                    }
                  ]
                },
                {
                  "label": "clinical presentation",
                  "children": [
                    {
                      "label": "slow-growing"
                    },
                    {
                      "label": "elevated"
                    },
                    {
                      "label": "round and smooth"
                    },
                    {
                      "label": "central pore",
                      "children": [
                        {
                          "label": "indicates the remaining pilar duct"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "filled with keratin",
                  "children": [
                    {
                      "label": "\"sebaceous cysts\""
                    }
                  ]
                },
                {
                  "label": "complications",
                  "children": [
                    {
                      "label": "Rupture of the cyst wall may cause an inflammatory foreign-body reaction"
                    },
                    {
                      "label": "secondary infection"
                    }
                  ]
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "small cysts",
