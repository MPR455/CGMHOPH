                      ]
                    },
                    {
                      "label": "Larger or deeper cysts",
                      "children": [
                        {
                          "label": "complete excision",
                          "children": [
                            {
                              "label": "cyst wall should be removed intact to reduce the possibility of recurrence"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "milia",
              "children": [
                {
                  "label": "Multiple tiny epidermal inclusion cysts"
                },
                {
                  "label": "common in newborn infants"
                },
                {
                  "label": "generally resolve spontaneously"
                },
                {
                  "label": "may be marsupialized with a sharp blade or needle"
                },
                {
                  "label": "topical retinoic acid cream",
                  "children": [
                    {
                      "label": "for multiple confluent milia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "pilar cyst",
              "children": [
                {
