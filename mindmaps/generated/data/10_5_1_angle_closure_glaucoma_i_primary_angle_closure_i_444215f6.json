{
  "label": "10.5.1. Angle-Closure Glaucoma (I): Primary Angle Closure (I)",
  "root": true,
  "children": [
    {
      "label": "Introduction to ACG",
      "children": [
        {
          "label": "67 million patients with glaucoma worldwide",
          "children": [
            {
              "label": "one-half are of Asian descent"
            }
          ]
        },
        {
          "label": "prevalence of angle-closure glaucoma (ACG) is higher than that of other types of glaucoma among Asians"
        },
        {
          "label": "ratio of OAG to ACG in Chinese individuals ranges from 1:1 to 2.6:1",
          "children": [
            {
              "label": "PACG is responsible for 91% of the bilateral blindness in China"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "primary pathology is anatomical, proximal to the trabecular meshwork"
            },
            {
              "label": "peripheral iris impedes the access of aqueous to the trabecular meshwork"
            }
          ]
        },
        {
          "label": "onset",
          "children": [
            {
              "label": "acute ACG (20%–30%)"
            },
            {
              "label": "chronic ACG (70%–80%)"
            }
          ]
        },
        {
          "label": "2 main categories",
          "children": [
            {
              "label": "primary",
              "children": [
                {
                  "label": "no identifiable underlying pathology"
                },
                {
                  "label": "only an anatomical predisposition to pupillary block"
                },
                {
                  "label": "rare <40 years"
                }
              ]
            },
            {
              "label": "secondary",
              "children": [
                {
                  "label": "an identifiable pathologic cause initiates the angle closure"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Pathogenesis and Pathophysiology of Angle Closure",
      "children": [
        {
          "label": "apposition or adhesion of the peripheral iris to the trabecular meshwork",
          "children": [
            {
              "label": "appositional",
              "children": [
                {
                  "label": "transient and intermittent"
                }
              ]
            },
            {
              "label": "synechial",
              "children": [
                {
                  "label": "permanent"
                }
              ]
            }
          ]
        },
        {
          "label": "2 mechanisms",
          "children": [
            {
              "label": "mechanisms that push the iris forward from behind"
            },
            {
              "label": "mechanisms that pull the iris forward"
            },
            {
              "label": "See Table 5-1"
            },
            {
              "label": "dynamic changes in iris volume and water content",
              "children": [
                {
                  "label": "most eyes show a loss of iris volume with dilation of the pupil"
                },
                {
                  "label": "eyes at risk for angle closure may have less ability to rid the iris stroma of water upon dilation"
                }
              ]
            }
          ]
        },
        {
          "label": "pupillary block",
          "children": [
            {
              "label": "most frequent cause of angle closure"
            },
            {
              "label": "flow of aqueous from the posterior chamber through the pupil is impeded at the level of the lens–iris interface",
              "children": [
                {
                  "label": "pressure gradient between posterior and anterior chambers",
                  "children": [
                    {
                      "label": "peripheral iris bows forward against the trabecular meshwork"
                    }
                  ]
                }
              ]
            },
            {
              "label": "PACG results from anatomical factors at the lens–iris interface",
              "children": [
                {
                  "label": "iris contact with",
                  "children": [
                    {
                      "label": "lens"
                    },
                    {
                      "label": "intraocular lens"
                    },
                    {
                      "label": "capsular remnants"
                    },
                    {
                      "label": "anterior hyaloid"
                    },
                    {
                      "label": "vitreous space–occupying substance (air, silicone oil)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "maximal when the pupil is in mid-dilated position"
            },
            {
              "label": "secluded pupil",
              "children": [
                {
                  "label": "absolute pupillary block as a result of 360° of posterior synechiae"
                }
              ]
            },
            {
              "label": "may be broken by an unobstructed peripheral iridectomy"
            }
          ]
        },
        {
          "label": "angle closure without pupillary block",
          "children": [
            {
              "label": "iris and/or lens being pushed, rotated, or pulled forward"
            }
          ]
        },
        {
          "label": "lens-induced angle-closure glaucoma",
          "children": [
            {
              "label": "increased pupillary block caused by",
              "children": [
                {
                  "label": "intumescent lens (phacomorphic glaucoma)"
                },
                {
                  "label": "dislocated/subluxated lens"
                },
                {
                  "label": "lens block",
                  "children": [
                    {
                      "label": "zonular laxity",
                      "children": [
                        {
                          "label": "allows the lens to move forward"
                        },
                        {
                          "label": "prone position may aggravate the tendency of the lens to move forward"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "iris-induced angle closure",
          "children": [
            {
              "label": "peripheral iris, either directly or indirectly, is the cause of the iridotrabecular apposition"
            },
            {
              "label": "developmental anomalies",
              "children": [
                {
                  "label": "anterior cleavage abnormalities",
                  "children": [
                    {
                      "label": "iris insertion is more anterior into the scleral spur or meshwork"
                    }
                  ]
                }
              ]
            },
            {
              "label": "thick peripheral iris",
              "children": [
                {
                  "label": "on dilatation “rolls” into the trabecular meshwork"
                }
              ]
            },
            {
              "label": "anteriorly displaced ciliary processes",
              "children": [
                {
                  "label": "secondarily rotate the peripheral iris forward into the meshwork (plateau iris)"
                }
              ]
            },
            {
              "label": "aniridia",
              "children": [
                {
                  "label": "rudimentary iris leaflets rotate into the angle"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Acute Primary Angle Closure",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "ocular pain"
            },
            {
              "label": "headache"
            },
            {
              "label": "blurred vision"
            },
            {
              "label": "rainbow-colored halos around lights"
            },
            {
              "label": "nausea and vomiting"
            }
          ]
        },
        {
          "label": "signs",
          "children": [
            {
              "label": "high IOP"
            },
            {
              "label": "mid-dilated, sluggish, and irregularly shaped pupil"
            },
            {
              "label": "corneal epithelial edema"
            },
            {
              "label": "congested episcleral and conjunctival blood vessels"
            },
            {
              "label": "shallow anterior chamber"
            },
            {
              "label": "mild amount of aqueous flare and cells"
            }
          ]
        },
        {
          "label": "definitive diagnosis",
          "children": [
            {
              "label": "gonioscopy",
              "children": [
                {
                  "label": "dynamic gonioscopy",
                  "children": [
                    {
                      "label": "appositional closure vs. synechial closure"
                    },
                    {
                      "label": "may also be therapeutic in breaking the attack of acute angle closure"
                    }
                  ]
                },
                {
                  "label": "clearing of corneal edema with medical treatment of elevated IOP or topical glycerin may be necessary"
                },
                {
                  "label": "pupillary constriction stimulated by the slit- lamp beam may open the angle and the narrow recess may go unrecognized"
                },
                {
                  "label": "gonioscopy of the fellow eye reveals a narrow, occludable angle",
                  "children": [
                    {
                      "label": "presence of a deep angle in the fellow eye should alert the clinician to alternative causes of elevated IOP"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "glaucomatous optic nerve damage"
            },
            {
              "label": "ischemic nerve damage"
            },
            {
              "label": "retinal vascular occlusion"
            },
            {
              "label": "PAS can form rapidly"
            },
            {
              "label": "IOP-induced iris ischemia",
              "children": [
                {
                  "label": "sector atrophy of the iris"
                },
                {
                  "label": "pigment release from the iris",
                  "children": [
                    {
                      "label": "pigmentary dusting of the iris surface and corneal endothelium"
                    }
                  ]
                },
                {
                  "label": "iris sphincter muscle ischemia",
                  "children": [
                    {
                      "label": "permanently fixed and dilated pupil"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Glaukomflecken",
              "children": [
                {
                  "label": "small anterior subcapsular lens opacities"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "treatment modalities",
              "children": [
                {
                  "label": "laser iridotomy",
                  "children": [
                    {
                      "label": "treatment of choice"
                    }
                  ]
                },
                {
                  "label": "when laser iridotomy cannot be accomplished",
                  "children": [
                    {
                      "label": "surgical iridectomy",
                      "children": [
                        {
                          "label": "less commonly"
                        }
                      ]
                    },
                    {
                      "label": "lensectomy",
                      "children": [
                        {
                          "label": "with or without goniosynechialysis"
                        }
                      ]
                    },
                    {
                      "label": "laser iridoplasty",
                      "children": [
                        {
                          "label": "flattens the peripheral iris"
                        }
                      ]
                    },
                    {
                      "label": "laser pupilloplasty",
                      "children": [
                        {
                          "label": "relieves pupillary block"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "cholinergic agents (pilocarpine 1%–2%)",
                  "children": [
                    {
                      "label": "mild attacks"
                    },
                    {
                      "label": "pupillary sphincter may be ischemic and unresponsive to miotic agents if IOP >40–50 mm Hg"
                    },
                    {
                      "label": "stronger miotics should be avoided",
                      "children": [
                        {
                          "label": "increase the vascular congestion of the iris or rotate the lens–iris interface more anteriorly"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "other IOP lowering medications",
                  "children": [
                    {
                      "label": "avoid",
                      "children": [
                        {
                          "label": "nonselective adrenergic agonists",
                          "children": [
                            {
                              "label": "cause pupillary dilation and iris ischemia"
                            }
                          ]
                        },
                        {
                          "label": "medications with significant α1-adrenergic activity (apraclonidine)",
                          "children": [
                            {
                              "label": "cause pupillary dilation and iris ischemia"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "β-adrenergic antagonists"
                    },
                    {
                      "label": "α2-adrenergic agonists"
                    },
                    {
                      "label": "prostaglandin analogues"
                    },
                    {
                      "label": "oral, topical, or intravenous carbonic anhydrase inhibitors"
                    }
                  ]
                },
                {
                  "label": "hyperosmotic agent",
                  "children": [
                    {
                      "label": "orally or intravenously"
                    }
                  ]
                },
                {
                  "label": "paracentesis",
                  "children": [
                    {
                      "label": "30-gauge needle"
                    },
                    {
                      "label": "reduce the IOP to enable the miotic agent to constrict the pupil and break the block"
                    }
                  ]
                },
                {
                  "label": "globe compression"
                },
                {
                  "label": "dynamic gonioscopy"
                }
              ]
            },
            {
              "label": "improved IOP does not necessarily mean that the angle has opened",
              "children": [
                {
                  "label": "ciliary body ischemia causes reduced aqueous production",
                  "children": [
                    {
                      "label": "IOP may remain low for weeks following acute angle closure"
                    }
                  ]
                },
                {
                  "label": "reevaluate the angle by gonioscopy!",
                  "children": [
                    {
                      "label": "to assess the degree of residual synechial angle closure"
                    },
                    {
                      "label": "confirm the reopening of at least part of the angle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "the fellow eye is at high risk of developing acute angle closure",
              "children": [
                {
                  "label": "especially if the inciting mechanism included systemic sympathomimetic agent (e.g. nasal decongestant) or an anticholinergic agent"
                },
                {
                  "label": "pain and emotional upset from the involvement of the first eye may increase sympathetic flow to the fellow eye"
                },
                {
                  "label": "perform peripheral iridotomyin the other eye if a similar angle configuration is present"
                },
                {
                  "label": "if the contralateral eye has a significantly different angle configuration, secondary ACGs must be strongly considered",
                  "children": [
                    {
                      "label": "posterior segment mass"
                    },
                    {
                      "label": "zonular insufficiency"
                    },
                    {
                      "label": "iridocorneal endothelial (ICE) syndrome"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Risk Factors for Developing Primary Angle Closure",
      "children": [
        {
          "label": "race",
          "children": [
            {
              "label": "prevalence of PACG in patients >40 years",
              "children": [
                {
                  "label": "0.1%–0.6% in whites"
                },
                {
                  "label": "0.1%–0.2% in blacks"
                },
                {
                  "label": "2.1%–5.0% in the Inuit"
                },
                {
                  "label": "0.4%–1.4% in East Asians",
                  "children": [
                    {
                      "label": "cannot be explained by biometric parameters alone"
                    },
                    {
                      "label": "the burden of ACG is greater in asian countries"
                    }
                  ]
                },
                {
                  "label": "0.3% in the Japanese"
                },
                {
                  "label": "2.3% in a mixed ethnic group in South Africa"
                }
              ]
            },
            {
              "label": "most angle closure presents as an asymptomatic chronic disease without an acute attack"
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "ocular biometrics",
          "children": [
            {
              "label": "small, “crowded” anterior segments"
            },
            {
              "label": "shallow anterior chamber",
              "children": [
                {
                  "label": "anterior chamber depth (ACD) <2.5 mm",
                  "children": [
                    {
                      "label": "most patients with PACG have ACD <2.1 mm"
