            },
            {
              "label": "increased anterior curvature of the lens"
            },
            {
              "label": "short axial length (AL)"
            },
            {
              "label": "small corneal diameter and radius of curvature"
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "gender",
          "children": [
            {
              "label": "2-4 x more common in women",
