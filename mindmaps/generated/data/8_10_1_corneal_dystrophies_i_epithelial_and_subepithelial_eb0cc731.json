{
  "label": "8.10.1. Corneal Dystrophies (I): Epithelial and Subepithelial Dystrophies",
  "root": true,
  "children": [
    {
      "label": "Meesmann epithelial corneal dystrophy (MECD)",
      "children": [
        {
          "label": "inheritance",
          "children": [
            {
              "label": "autosomal dominant",
              "children": [
                {
                  "label": "12q13",
                  "children": [
                    {
                      "label": "keratin K3 (KRT3)"
                    }
                  ]
                },
                {
                  "label": "17q12",
                  "children": [
                    {
                      "label": "keratin K12 (KRT12)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "epithelial microcysts",
              "children": [
                {
                  "label": "degenerated epithelial cell debris",
                  "children": [
                    {
                      "label": "PAS-positive"
                    },
                    {
                      "label": "autofluorescent"
                    },
                    {
                      "label": "electron-dense accumulation of granular and filamentary material",
                      "children": [
                        {
                          "label": "“peculiar substance”"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "epithelial cells",
              "children": [
                {
                  "label": "frequent mitoses"
                },
                {
                  "label": "basal epithelial cells have increased glycogen"
                }
              ]
            },
            {
              "label": "thickened basement membrane with projections into the basal epithelium"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "mild irritation"
            },
            {
              "label": "slight decrease in vision"
            },
            {
              "label": "glare and light sensitivity",
              "children": [
                {
                  "label": "unlike EBMD"
                }
              ]
            },
            {
              "label": "painful recurrent erosions"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "appears very early in life"
            },
            {
              "label": "tiny bubble-like epithelial vesicles/blebs",
              "children": [
                {
                  "label": "most easily seen with retroillumination"
                },
                {
                  "label": "most numerous in the interpalpebral area",
                  "children": [
                    {
                      "label": "extend out to the limbus"
                    }
                  ]
                },
                {
                  "label": "epithelium surrounding the cysts is clear"
                }
              ]
            },
            {
              "label": "± whorled and wedge-shaped epithelial patterns"
            },
            {
              "label": "± slightly thinned cornea"
            },
            {
              "label": "± reduced corneal sensation"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "most patients require no treatment"
            },
            {
              "label": "soft contact lens wear in patients with frequent symptoms"
            }
          ]
        }
      ]
    },
    {
      "label": "Introduction",
      "children": [
        {
          "label": "bilateral"
        },
        {
          "label": "symmetric"
        },
        {
          "label": "inherited"
        },
        {
          "label": "little or no relationship to environmental or systemic factors"
        },
        {
          "label": "begin early in life",
          "children": [
            {
              "label": "may not become clinically apparent until later",
              "children": [
                {
                  "label": "slowly progressive",
                  "children": [
                    {
                      "label": "more pronounced with age"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "genetics",
          "children": [
            {
              "label": "dystrophies that appear the same phenotypically may map to different chromosomes"
            },
            {
              "label": "dystrophies that map to the same gene may have different phenotypes"
            },
            {
              "label": "International Committee for the Classification of Corneal Dystrophies (IC3D)",
              "children": [
                {
                  "label": "category 1",
                  "children": [
                    {
                      "label": "well-defined corneal dystrophy in which the gene has been mapped"
                    }
                  ]
                },
                {
                  "label": "category 2",
                  "children": [
                    {
                      "label": "well-defined corneal dystrophy that has been mapped to one or more specific chromosomal loci, but the gene(s) remains to be identified"
                    }
                  ]
                },
                {
                  "label": "category 3",
                  "children": [
                    {
                      "label": "well-defined corneal dystrophy in which the disorder has not yet been mapped to a chromosomal locus"
                    }
                  ]
                },
                {
                  "label": "category 4",
                  "children": [
                    {
                      "label": "suspected new, or previously documented, corneal dystrophy, although the evidence for its being a distinct entity is not yet convincing"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "See Tables 10-1, 10-2, and 10-3"
        }
      ]
    },
    {
      "label": "similar to macular dystrophy & CHED2"
    },
    {
      "label": "Gelatinous droplike corneal dystrophy (GDLD)",
      "children": [
        {
          "label": "inheritance",
          "children": [
            {
              "label": "autosomal recessive",
              "children": [
                {
                  "label": "locus 1p32",
                  "children": [
                    {
                      "label": "tumor-associated calcium signal transducer 2 (TACSTD2) gene"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pathology"
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "significant decrease in vision",
              "children": [
                {
                  "label": "subepithelial and stromal amyloid deposits"
                },
                {
                  "label": "similar to lattice dystrophy"
                }
              ]
            },
            {
              "label": "photophobia"
            },
            {
              "label": "irritation"
            },
            {
              "label": "tearing"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "onset in first to second decade of life"
            },
            {
              "label": "subepithelial lesions",
              "children": [
                {
                  "label": "similar to band keratopathy"
                },
                {
                  "label": "groups of multiple small nodules (mulberry configuration)"
                },
                {
                  "label": "larger nodular lesions (kumquat-like lesions) may develop"
                }
              ]
            },
            {
              "label": "lesions are visible on fluorescein staining"
            },
            {
              "label": "± superficial vascularization"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "superficial keratectomy"
            },
            {
              "label": "lamellar keratoplasty"
            },
            {
              "label": "penetrating keratoplasty"
            },
            {
              "label": "recurrence within a few years is seen in all patients"
            },
            {
              "label": "soft contact lenses",
              "children": [
                {
                  "label": "to decrease recurrences"
                }
              ]
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Epithelial basement membrane dystrophy (EBMD)",
      "children": [
        {
          "label": "\"Map-dot-fingerprint dystrophy\""
        },
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "6%–18% of the population"
            },
            {
              "label": "more common after age 50 years"
            },
            {
              "label": "F>M"
            },
            {
              "label": "inheritance",
              "children": [
                {
                  "label": "sporadic (no documented inheritance)"
                }
              ]
            }
          ]
        },
        {
          "label": "histologic findings",
          "children": [
            {
              "label": "a thickened basement membrane with extension into the epithelium",
              "children": [
                {
                  "label": "map/fingerprint lines"
                },
                {
                  "label": "abnormal epithelial cells with microcysts (often with absent or abnormal hemidesmosomes)"
                }
              ]
            },
            {
              "label": "fibrillar material between the basement membrane and Bowman layer"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "recurrent epithelial erosions",
              "children": [
                {
                  "label": "10% will have corneal erosions"
                },
                {
                  "label": "more common after age 30 years"
                },
                {
                  "label": "50% of patients with recurrent epithelial erosions have evidence of EBMD"
                },
                {
                  "label": "both eyes must be examined because evidence of dystrophy may be found in uninvolved eye"
                }
              ]
            },
            {
              "label": "transient blurred vision",
              "children": [
                {
                  "label": "basement membrane changes in visual axis can cause irregular astigmatism"
                }
              ]
            }
          ]
        },
        {
          "label": "4 kinds of corneal findings",
          "children": [
            {
              "label": "fingerprint lines 1",
              "children": [
                {
                  "label": "several thin, relucent, hairlike lines arranged in a concentric pattern"
                }
              ]
            },
            {
              "label": "map lines 2",
              "children": [
                {
                  "label": "thicker, more irregular, and surrounded by a faint haze"
                }
              ]
            },
            {
              "label": "3",
              "children": [
                {
                  "label": "dots or microcysts",
                  "children": [
                    {
                      "label": "intraepithelial spaces containing epithelial debris"
                    },
                    {
                      "label": "discrete edges"
                    }
                  ]
                }
              ]
            },
            {
              "label": "4",
              "children": [
                {
                  "label": "bleb or cobblestone-like pattern"
                }
              ]
            },
            {
              "label": "best seen with sclerotic scatter, retroillumination, or a broad tangential beam"
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "localized trauma",
              "children": [
                {
                  "label": "unilateral"
                }
              ]
            },
            {
              "label": "corneal intraepithelial dysplasia"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "asymptomatic patients",
              "children": [
                {
                  "label": "no treatment",
                  "children": [
                    {
                      "label": "removed material should be submitted for histology!"
                    }
                  ]
                }
              ]
            },
            {
              "label": "irregular astigmatism",
              "children": [
                {
                  "label": "corneal debridement"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Lisch epithelial corneal dystrophy (LECD)",
      "children": [
        {
          "label": "genetics",
          "children": [
            {
              "label": "X-linked dominant",
              "children": [
                {
                  "label": "Xp22.3"
                }
              ]
            }
          ]
        },
        {
          "label": "pathology"
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "pain-free",
              "children": [
                {
                  "label": "diffuse cytoplasmic vacuolization of affected cells",
                  "children": [
                    {
                      "label": "in Meesmann dystrophy, such band-shaped, feathery lesions do not exist"
                    }
                  ]
                }
              ]
            },
            {
              "label": "decrease in vision"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "discrete sectorial, gray, band-shaped, and feathery lesions in whorled patterns",
              "children": [
                {
                  "label": "in Meesmann dystrophy, corneal involvement is more diffuse"
                }
              ]
            },
            {
              "label": "retroillumination",
              "children": [
                {
                  "label": "intraepithelial, densely crowded clear microcysts"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "corneal debridement can be attempted",
              "children": [
                {
                  "label": "often results in recurrence"
                }
              ]
            },
            {
              "label": "contact lenses",
              "children": [
                {
                  "label": "may be helpful for more severe cases"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
