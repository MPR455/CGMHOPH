    {
      "label": "Treatment",
      "children": [
        {
          "label": "Medical",
          "children": [
            {
              "label": "topical",
              "children": [
                {
                  "label": "beta-blockers",
                  "children": [
                    {
                      "label": "timolol",
                      "children": [
                        {
                          "label": "caution with asthma/COPD, heart failure"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "alpha-2 agonists",
                  "children": [
                    {
                      "label": "brimonidine"
                    },
                    {
                      "label": "avoid",
                      "children": [
                        {
                          "label": "nonselective adrenergic agonists (epinephrine)",
                          "children": [
                            {
                              "label": "cause pupillary dilation and iris ischemia"
                            }
                          ]
                        },
                        {
                          "label": "medications with significant α1-adrenergic activity (apraclonidine)"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "PG analogs",
                  "children": [
                    {
                      "label": "latanoprost"
                    }
                  ]
                },
                {
                  "label": "CAI",
                  "children": [
                    {
                      "label": "dorzolamide"
                    }
                  ]
                },
                {
                  "label": "3 rounds q15 min",
                  "children": [
                    {
                      "label": "recheck in 1 hour",
                      "children": [
                        {
                          "label": "if IOP not controlled",
                          "children": [
                            {
                              "label": "admit"
                            },
                            {
                              "label": "do not use for aphakic/ pseudophakic AACG",
                              "children": [
                                {
                                  "label": "do not use for secondary ACG"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "pilocarpine 1-2%",
                  "children": [
                    {
                      "label": "has fallen out of favor"
                    },
                    {
                      "label": "for phakic primary AACG"
                    },
                    {
                      "label": "q 15 min x 2"
                    },
                    {
                      "label": "check renal function/ electrolytes",
                      "children": [
                        {
                          "label": "stronger miotics should be avoided"
                        },
                        {
                          "label": "increase the vascular congestion of the iris or rotate the lens–iris interface more anteriorly"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "don't use for topiramate/ sulfonamide-induced ACG"
            },
            {
              "label": "systemic (IV or oral) CAI"
            },
            {
              "label": "osmotic agent",
              "children": [
