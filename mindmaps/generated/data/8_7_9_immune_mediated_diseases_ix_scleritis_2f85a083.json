{
  "label": "8.7.9. Immune-Mediated Diseases (IX): Scleritis",
  "root": true,
  "children": [
    {
      "label": "Pathogenesis",
      "children": [
        {
          "label": "immune-mediated (immune-complex) vasculitis"
        },
        {
          "label": "underlying systemic immunologic disease",
          "children": [
            {
              "label": "indidence",
              "children": [
                {
                  "label": "diffuse or nodular scleritis",
                  "children": [
                    {
                      "label": "1/3"
                    }
                  ]
                },
                {
                  "label": "necrotizing scleritis",
                  "children": [
                    {
                      "label": "2/3"
                    }
                  ]
                }
              ]
            },
            {
              "label": "associated diseases",
              "children": [
                {
                  "label": "1/2",
                  "children": [
                    {
                      "label": "gout"
                    }
                  ]
                },
                {
                  "label": "infectious",
                  "children": [
                    {
                      "label": "syphilis"
                    },
                    {
                      "label": "tuberculosis"
                    },
                    {
                      "label": "herpes zoster"
                    },
                    {
                      "label": "lyme disease"
                    },
                    {
                      "label": "“cat-scratch” disease"
                    },
                    {
                      "label": "leprosy"
                    }
                  ]
                },
                {
                  "label": "autoimmune connective tissue diseases",
                  "children": [
                    {
                      "label": "rheumatoid arthritis"
                    },
                    {
                      "label": "systemic lupus erythematosus"
                    },
                    {
                      "label": "seronegative spondyloarthropathies (eg, ankylosing spondylitis)"
                    },
                    {
                      "label": "wegener granulomatosis"
                    },
                    {
                      "label": "polyarteritis nodosa"
                    },
                    {
                      "label": "giant cell arteritis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "4-6 decades of life",
          "children": [
            {
              "label": "exceedingly rare in children"
            }
          ]
        },
        {
          "label": "F>M"
        },
        {
          "label": "1/2 bilateral"
        }
      ]
    },
    {
      "label": "worsen at night"
    },
    {
      "label": "Complications Of Scleritis",
      "children": [
        {
          "label": "peripheral keratitis",
          "children": [
            {
              "label": "37%",
              "children": [
                {
                  "label": "localized to the area of inflammation"
                }
              ]
            }
          ]
        },
        {
          "label": "central stromal keratitis",
          "children": [
            {
              "label": "rare"
            },
            {
              "label": "heavy vascularization and opacification if untreated"
            }
          ]
        },
        {
          "label": "sclerokeratitis",
          "children": [
            {
              "label": "fibrosis and lipid deposition of peripheral cornea and neighboring scleritis"
            },
            {
              "label": "area of involvement may gradually move centrally"
            },
            {
              "label": "accompanies herpes zoster scleritis"
            }
          ]
        },
        {
          "label": "scleral thinning",
          "children": [
            {
              "label": "scleral translucency and/or thinning",
              "children": [
                {
                  "label": "may also occur in rheumatic diseases"
                },
                {
                  "label": "33%"
                }
              ]
            },
            {
              "label": "frank scleral defects",
              "children": [
                {
                  "label": "only in the most severe forms of necrotizing disease/scleromalacia perforans"
                }
              ]
            }
          ]
        },
        {
          "label": "uveitis",
          "children": [
            {
              "label": "30%"
            },
            {
              "label": "anterior uveitis",
              "children": [
                {
                  "label": "eyes with anterior scleritis"
                }
              ]
            },
            {
              "label": "posterior uveitis",
              "children": [
                {
                  "label": "eyes with posterior scleritis"
                }
              ]
            }
          ]
        },
        {
          "label": "glaucoma",
          "children": [
            {
              "label": "18%"
            }
          ]
        },
        {
          "label": "cataract",
          "children": [
            {
              "label": "7%"
            }
          ]
        }
      ]
    },
    {
      "label": "Laboratory Evaluation",
      "children": [
        {
          "label": "initial screening",
          "children": [
            {
              "label": "complete blood count (CBC) with differential"
            },
            {
              "label": "erythrocyte sedimentation rate (ESR) or C- reactive protein (CRP)"
            },
            {
              "label": "serum autoantibody screening (antinuclear antibodies, anti-DNA antibodies, rheumatoid factor, antineutrophil cytoplasmic antibodies)"
            },
            {
              "label": "urinalysis"
            },
            {
              "label": "serum uric acid test"
            },
            {
              "label": "syphilis serology"
            },
            {
              "label": "chest x-ray"
            },
            {
              "label": "sarcoidosis screening (serum angiotensin- converting enzyme and lysozyme)"
            }
          ]
        },
        {
          "label": "if systemic evaluation is initially negative, repeat the workup annually"
        },
        {
          "label": "in conjunction with a rheumatologist or other internist"
        }
      ]
    },
    {
      "label": "Clinical Presentation",
      "children": [
        {
          "label": "gradual onset",
          "children": [
            {
              "label": "over several days"
            }
          ]
        },
        {
          "label": "severe boring or piercing ocular pain",
          "children": [
            {
              "label": "referred to other regions of the head or face"
            },
            {
              "label": "violaceous hue",
              "children": [
                {
                  "label": "tender globe"
                },
                {
                  "label": "best seen in natural sunlight"
                }
              ]
            }
          ]
        },
        {
          "label": "inflamed sclera"
        },
        {
          "label": "inflamed vessels",
          "children": [
            {
              "label": "crisscross pattern"
            },
            {
              "label": "adhere to the sclera"
            }
          ]
        },
        {
          "label": "scleral edema",
          "children": [
            {
              "label": "overlying episcleral edema",
              "children": [
                {
                  "label": "cannot be moved with a cotton-tipped applicator"
                }
              ]
            }
          ]
        },
        {
          "label": "types",
          "children": [
            {
              "label": "Diffuse versus nodular anterior scleritis",
              "children": [
                {
                  "label": "Diffuse anterior scleritis",
                  "children": [
                    {
                      "label": "part of the anterior sclera (<1/2)",
                      "children": [
                        {
                          "label": "60%"
                        }
                      ]
                    },
                    {
                      "label": "entire anterior segment",
                      "children": [
                        {
                          "label": "40%"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Nodular anterior scleritis",
                  "children": [
                    {
                      "label": "scleral nodule",
                      "children": [
                        {
                          "label": "deep red-purple color"
                        },
                        {
                          "label": "immobile"
                        },
                        {
                          "label": "separated from the overlying episcleral tissue"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "Necrotizing scleritis",
              "children": [
                {
                  "label": "Necrotizing scleritis with inflammation",
                  "children": [
                    {
                      "label": "severe pain"
                    },
                    {
                      "label": "localized patch of inflammation",
                      "children": [
                        {
                          "label": "edges more inflamed than center"
                        }
                      ]
                    },
                    {
                      "label": "avascular edematous patch of sclera",
                      "children": [
                        {
                          "label": "25%"
                        },
                        {
                          "label": "sclera may develop a blue-gray appearance"
                        }
                      ]
                    },
                    {
                      "label": "altered deep episcleral vessels",
                      "children": [
                        {
                          "label": "large anastomotic vessels circumscribe the involved area"
                        }
                      ]
                    },
                    {
                      "label": "may spread posteriorly to the equator and circumferentially"
                    }
                  ]
                },
                {
                  "label": "Necrotizing scleritis without inflammation (scleromalacia perforans",
                  "children": [
                    {
                      "label": "long-standing rheumatoid arthritis"
                    },
                    {
                      "label": "painless",
                      "children": [
                        {
                          "label": "signs of inflammation are minimal"
                        }
                      ]
                    },
                    {
                      "label": "sclera thins and the underlying dark uvea becomes visible"
                    },
                    {
                      "label": "large abnormal blood vessels surround and cross the areas of scleral loss"
                    },
                    {
                      "label": "spontaneous perforation is rare"
                    },
                    {
                      "label": "bulging staphyloma",
                      "children": [
                        {
                          "label": "may rupture with minimal trauma"
                        },
                        {
                          "label": "if intraocular pressure is elevated"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "Posterior scleritis",
              "children": [
                {
                  "label": "no related systemic disease can be found in patients with posterior scleritis"
                },
                {
                  "label": "can occur",
                  "children": [
                    {
                      "label": "in isolation",
                      "children": [
                        {
                          "label": "diagnosis can be missed in the absence of associated anterior scleritis"
                        }
                      ]
                    },
                    {
                      "label": "concomitantly with anterior scleritis"
                    }
                  ]
                },
                {
                  "label": "pain",
                  "children": [
                    {
                      "label": "pain may be referred to other parts of the head"
                    }
                  ]
                },
                {
                  "label": "tenderness",
                  "children": [
                    {
                      "label": "vision loss"
                    }
                  ]
                },
                {
                  "label": "retraction of the lower eyelid"
                },
                {
                  "label": "proptosis"
                },
                {
                  "label": "restricted motility"
                },
                {
                  "label": "angle-closure glaucoma"
                },
                {
                  "label": "choroidal folds"
                },
                {
                  "label": "papilledema",
                  "children": [
                    {
                      "label": "exudative retinal detachment"
                    }
                  ]
                },
                {
                  "label": "thickened posterior sclera by echography, computed tomography, or magnetic resonance imaging"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Management",
      "children": [
        {
          "label": "in general the treatment of scleritis is systemic"
        },
        {
          "label": "topical corticosteroids",
          "children": [
            {
              "label": "nonnecrotizing disease, especially diffuse disease",
              "children": [
                {
                  "label": "mild diffuse anterior or nodular scleritis"
                }
              ]
            }
          ]
        },
        {
          "label": "oral NSAIDS",
          "children": [
            {
              "label": "600 mg of ibuprofen 3 times a day"
            }
          ]
        },
        {
          "label": "oral and/or high-dose (pulsed) intravenous corticosteroids",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "severe nodular scleritis"
                },
                {
                  "label": "necrotizing scleritis"
                },
                {
                  "label": "sclerokeratitis"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic immunosuppressive therapy",
          "children": [
            {
              "label": "methotrexate"
            },
            {
              "label": "cyclosporine"
            },
            {
              "label": "cyclophosphamide"
            },
            {
              "label": "rheumatoid arthritis–associated scleritis",
              "children": [
                {
                  "label": "if no therapeutic response is observed with corticosteroids"
                }
              ]
            }
          ]
        },
        {
          "label": "TNF inhibitors such as infliximab"
        },
        {
          "label": "subconjunctival corticosteroids",
          "children": [
            {
              "label": "in nonnecrotizing scleritis",
              "children": [
                {
                  "label": "when systemic administration is contraindicated or not feasible"
                }
              ]
            }
          ]
        },
        {
          "label": "antituberculosis and anti-pneumocystis coverage may be necessary for at-risk patients"
        },
        {
          "label": "treatment failure",
          "children": [
            {
              "label": "progression of disease to a more severe form (eg, nodular to necrotizing)"
            },
            {
              "label": "an alternate therapeutic strategy will need to be instituted",
              "children": [
                {
                  "label": "failure to achieve response to treatment after 2–3 weeks of therapy"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
