{
  "label": "7.11.6. Blepharoptosis (IV): Treatment",
  "root": true,
  "children": [
    {
      "label": "History",
      "children": [
        {
          "label": "symptoms of dry eye",
          "children": [
            {
              "label": "temper blepharoptosis repair in presence of significant dry eye problems"
            }
          ]
        },
        {
          "label": "thyroid eye disease"
        },
        {
          "label": "previous eye or eyelid surgery"
        },
        {
          "label": "prior periorbital trauma"
        }
      ]
    },
    {
      "label": "Indications for treatment",
      "children": [
        {
          "label": "functional",
          "children": [
            {
              "label": "significant superior visual field loss"
            },
            {
              "label": "difficulty with reading"
            }
          ]
        },
        {
          "label": "cosmetic",
          "children": [
            {
              "label": "tired or sleepy appearance"
            }
          ]
        }
      ]
    },
    {
      "label": "frontalis suspension surgery",
      "children": [
        {
          "label": "indication",
          "children": [
            {
              "label": "poor or absent levator function"
            }
          ]
        },
        {
          "label": "technique",
          "children": [
            {
              "label": "eyelid is suspended directly from frontalis muscle",
              "children": [
                {
                  "label": "movement of the brow is efficiently transmitted to the eyelid"
                }
              ]
            },
            {
              "label": "there is controversy about whether bilateral frontalis suspension should be performed in patients with unilateral congenital ptosis",
              "children": [
                {
                  "label": "may improve patient’s symmetry and stimulate the need to utilize frontalis muscle to lift eyelids"
                },
                {
                  "label": "subjects normal eyelid to surgical risks"
                }
              ]
            }
          ]
        },
        {
          "label": "autogenous fascia lata",
          "children": [
            {
              "label": "best long-term results"
            },
            {
              "label": "requires harvesting and additional surgery"
            },
            {
              "label": "patients ≥ 3 years old or ≥35 pounds in weight"
            }
          ]
        },
        {
          "label": "banked fascia lata",
          "children": [
            {
              "label": "may incite inflammation"
            },
            {
              "label": "has the theoretic potential to transmit infectious agents"
            },
            {
              "label": "poorer long-term outcomes"
            }
          ]
        },
        {
          "label": "synthetic materials",
          "children": [
            {
              "label": "silicone rods"
            },
            {
              "label": "allow easier adjustment or removal if necessary"
            }
          ]
        }
      ]
    },
    {
      "label": "3 categories of surgical procedures",
      "children": [
        {
          "label": "external (transcutaneous) levator advancement",
          "children": [
            {
              "label": "In patients with good levator function, surgical correction is generally directed toward the levator aponeurosis"
            }
          ]
        },
        {
          "label": "internal (transconjunctival) levator/tarsus/ Müller muscle resection approaches"
        },
        {
          "label": "frontalis muscle suspensions",
          "children": [
            {
              "label": "if levator function is poor or absent, frontalis muscle suspension techniques are the preferred repair procedures"
            }
          ]
        }
      ]
    },
    {
      "label": "External (transcutaneous) levator advancement surgery",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "levator function is normal"
            },
            {
              "label": "upper eyelid crease is high",
              "children": [
                {
                  "label": "levator aponeurosis (its tendinous attachment to the tarsal plate) is stretched or disinserted"
                }
              ]
            }
          ]
        },
        {
          "label": "ideally performed under local anesthesia",
          "children": [
            {
              "label": "patient cooperation is elicited to obtain optimal lid height and contour"
            }
          ]
        },
        {
          "label": "upper eyelid crease incision"
        },
        {
          "label": "levator aponeurosis is advanced to the superior tarsal border"
        }
      ]
    },
    {
      "label": "Complications",
      "children": [
        {
          "label": "undercorrection",
          "children": [
            {
              "label": "most common complication"
            },
            {
              "label": "differentiate true undercorrection from apparent undercorrection resulting from postoperative edema"
            },
            {
              "label": "creating symmetry between the two eyelids is the most difficult aspect of ptosis repair",
              "children": [
                {
                  "label": "adjustable suture techniques",
                  "children": [
                    {
                      "label": "early adjustment in the office during the first 2 postoperative weeks"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "overcorrection"
        },
        {
          "label": "unsatisfactory eyelid contour"
        },
        {
          "label": "scarring"
        },
        {
          "label": "wound dehiscence"
        },
        {
          "label": "eyelid crease asymmetry"
        },
        {
          "label": "conjunctival prolapse"
        },
        {
          "label": "tarsal eversion"
        },
        {
          "label": "lagophthalmos with exposure keratitis",
          "children": [
            {
              "label": "most common in patients with decreased levator function"
            },
            {
              "label": "usually temporary"
            },
            {
              "label": "lubricating drops or ointments"
            }
          ]
        }
      ]
    },
    {
      "label": "internal (transconjunctival) approach",
      "children": [
        {
          "label": "directed toward",
          "children": [
            {
              "label": "Müller muscle",
              "children": [
                {
                  "label": "Müller muscle–conjunctival resections (MMCRs)",
                  "children": [
                    {
                      "label": "indications",
                      "children": [
                        {
                          "label": "minimal ptosis (≤2 mm)"
                        },
                        {
                          "label": "adequate upper eyelid position following instillation of a drop of 2.5% phenylephrine hydrochloride"
                        },
                        {
                          "label": "useful for maintaining preoperative eyelid contour"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "tarsus",
              "children": [
                {
                  "label": "Fasanella-Servat procedure",
                  "children": [
                    {
                      "label": "for small amounts of ptosis"
                    },
                    {
                      "label": "removal of the superior tarsus with the conjunctiva and Müller muscle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "levator aponeurosis or muscle"
            }
          ]
        }
      ]
    }
