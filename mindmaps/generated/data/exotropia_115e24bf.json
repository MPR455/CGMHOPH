                {
                  "label": "\"squint\""
                }
              ]
            }
          ]
        },
        {
          "label": "Infantile XT",
          "children": [
            {
              "label": "onset <6 months"
            },
            {
              "label": "associated with craniofacial or CNS disorders"
            },
            {
              "label": "large angle"
            }
          ]
        },
        {
          "label": "sensory XT",
          "children": [
            {
              "label": "any condition that severely reduces vision or the visual field in 1 eye"
