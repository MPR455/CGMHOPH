    {
      "label": "Dacryocystitis",
      "children": [
        {
          "label": "inflammation of the lacrimal sac"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "common factor is complete NLDO",
              "children": [
                {
                  "label": "chronic tear retention and stasis",
                  "children": [
                    {
                      "label": "secondary infection"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "gram-positive bacteria",
              "children": [
                {
                  "label": "most common cause of acute dacryocystitis"
                }
              ]
            },
            {
              "label": "gram-negative bacteria",
              "children": [
                {
                  "label": "diabetes"
                },
                {
                  "label": "immunodeficiency"
                },
                {
                  "label": "exposure to atypical pathogens (eg, individuals residing in nursing homes)"
                }
              ]
            }
          ]
        },
        {
          "label": "acute dacryocystitis",
          "children": [
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "erythema with distension of the lacrimal sac"
                },
                {
                  "label": "edema"
                },
                {
                  "label": "discomfort ranging from none to severe pain"
                }
              ]
            },
            {
              "label": "complications",
              "children": [
                {
                  "label": "dacryocystocele formation"
                },
                {
                  "label": "chronic conjunctivitis"
                },
                {
                  "label": "spread to adjacent structures (orbital or facial cellulitis)"
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "irrigation or probing of the canalicular system should be avoided until the infection subsides",
                  "children": [
                    {
                      "label": "irrigation is not needed to establish the diagnosis",
                      "children": [
                        {
                          "label": "extremely painful for patients with active infection"
                        }
                      ]
                    },
                    {
                      "label": "diagnostic or therapeutic probing of the NLD is not indicated in adults with acute dacryocystitis"
                    }
                  ]
                },
                {
                  "label": "topical antibiotics",
                  "children": [
                    {
                      "label": "limited value"
                    }
                  ]
                },
                {
                  "label": "oral antibiotics",
                  "children": [
                    {
                      "label": "effective for most infections"
                    }
                  ]
                },
                {
                  "label": "parenteral antibiotics",
                  "children": [
                    {
                      "label": "for severe cases",
                      "children": [
                        {
                          "label": "especially if cellulitis or orbital extension is present"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "aspiration of the lacrimal sac",
                  "children": [
                    {
                      "label": "pyocele or mucocele is localized and approaching the skin"
                    },
                    {
                      "label": "smears and cultures of the aspirate"
                    }
                  ]
                },
                {
                  "label": "incision and drainage",
                  "children": [
                    {
                      "label": "indications",
                      "children": [
                        {
                          "label": "localized abscess involving the lacrimal sac and adjacent soft tissues",
                          "children": [
                            {
                              "label": "no response to more conservative measures"
                            },
                            {
                              "label": "severe discomfort"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "incised abscess is allowed to heal by second intention"
                    },
                    {
                      "label": "complications",
                      "children": [
                        {
                          "label": "chronically draining epithelialized fistula that communicates with the lacrimal sac",
                          "children": [
                            {
                              "label": "rare"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "DCR",
                  "children": [
                    {
                      "label": "inevitable persistent epiphora and recurrence"
                    },
                    {
                      "label": "deferred until acute inflammation is resolved",
                      "children": [
                        {
                          "label": "some patients continue to have subacute infection until definitive drainage surgery is performed"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "chronic dacryocystitis",
          "children": [
            {
              "label": "smoldering low-grade infection"
            },
            {
              "label": "distension of the lacrimal sac"
            },
            {
              "label": "massage may reflux mucoid material through the canalicular system"
            },
            {
              "label": "if a tumor is not suspected, no further diagnostic evaluation is indicated to confirm the diagnosis of total NLDO"
            },
            {
              "label": "should be treated before elective intraocular surgery"
            }
          ]
        }
