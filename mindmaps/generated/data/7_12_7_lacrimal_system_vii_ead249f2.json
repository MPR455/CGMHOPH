                },
                {
                  "label": "adenoid cystic carcinoma"
                },
                {
                  "label": "infantile [capillary] hemangioma"
                },
                {
                  "label": "inverted papilloma"
                },
                {
                  "label": "epidermoid carcinoma"
                },
                {
                  "label": "osteoma"
                },
                {
                  "label": "lymphoma"
                }
              ]
            }
          ]
        },
        {
          "label": "metastatic"
        }
