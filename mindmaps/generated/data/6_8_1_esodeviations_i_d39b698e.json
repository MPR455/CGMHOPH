{
  "label": "6.8.1. Esodeviations (I)",
  "root": true,
  "children": [
    {
      "label": "should resolve ≤3 months of age",
      "children": [
        {
          "label": "can sometimes persist, especially in premature infants"
        },
        {
          "label": "present after age 2 months"
        }
      ]
    },
    {
      "label": "Epidemiology",
      "children": [
        {
          "label": "latent or manifest convergent misalignment of the visual axes"
        },
        {
          "label": "most common type of strabismus",
          "children": [
            {
              "label": "50% of ocular deviations in the pediatric population"
            }
          ]
        },
        {
          "label": "M=F"
        },
        {
          "label": "Caucasian & African American >Asian"
        },
        {
          "label": "risk factors",
          "children": [
            {
              "label": "hyperopia"
            },
            {
              "label": "anisometropia"
            },
            {
              "label": "prematurity"
            },
            {
              "label": "low birth weight"
            },
            {
              "label": "family history of strabismus",
              "children": [
                {
                  "label": "± mendelian inheritance in some families"
                }
              ]
            },
            {
              "label": "maternal smoking during pregnancy"
            },
            {
              "label": "neurodevelopmental impairment"
            },
            {
              "label": "craniofacial or chromosomal anomalies"
            },
            {
              "label": "prevalence of esotropia increases with",
              "children": [
                {
                  "label": "age",
                  "children": [
                    {
                      "label": "48–72 months > 6–11 months"
                    }
                  ]
                },
                {
                  "label": "moderate anisometropia"
                },
                {
                  "label": "moderate hyperopia"
                }
              ]
            }
          ]
        },
        {
          "label": "amblyopia develops in ≈ 50%"
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Infantile (Congenital) Esotropia",
      "children": [
        {
          "label": "Introduction",
          "children": [
            {
              "label": "≤6 months of age"
            },
            {
              "label": "ocular instability of infancy",
              "children": [
                {
                  "label": "variable, transient, intermittent strabismus is commonly observed in the first 2–3 months of life"
                },
                {
                  "label": "common to see both intermittent esotropia and exotropia in the same infant"
                },
                {
                  "label": "will probably require surgical intervention",
                  "children": [
                    {
                      "label": "esotropia unlikely to resolve",
                      "children": [
                        {
                          "label": "constant"
                        },
                        {
                          "label": "≥30 prism diopters"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "risk factors",
              "children": [
                {
                  "label": "often have a family history of esotropia or strabismus",
                  "children": [
                    {
                      "label": "well-defined genetic patterns are unusual"
                    }
                  ]
                },
                {
                  "label": "up to 30% of children with neurologic and developmental problems",
                  "children": [
                    {
                      "label": "cerebral palsy"
                    },
                    {
                      "label": "hydrocephalus"
                    },
                    {
                      "label": "prematurity"
                    }
                  ]
                }
              ]
            },
            {
              "label": "associated with an increased risk of development of mental illness by early adulthood",
              "children": [
                {
                  "label": "2.6 x higher"
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "Pathogenesis",
          "children": [
            {
              "label": "unknown"
            },
            {
              "label": "Worth “sensory” concept",
              "children": [
                {
                  "label": "congenital deficit in a “fusion center” in the brain"
                },
                {
                  "label": "goal of restoring binocularity is futile"
                }
              ]
            },
            {
              "label": "Chavasse theory",
              "children": [
                {
                  "label": "primary problem is one of motor development"
                },
                {
                  "label": "potentially curable if ocular alignment is achieved",
                  "children": [
                    {
                      "label": "several authors have reported favorable sensory results in infants operated on between 6 months and 2 years of age",
                      "children": [
                        {
                          "label": "early surgery for infantile esotropia"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Evaluation",
          "children": [
            {
              "label": "visual acuity of 2 eyes can be equal",
              "children": [
                {
                  "label": "alternating fixation"
                },
                {
                  "label": "cross-fixation",
                  "children": [
                    {
                      "label": "large-angle esotropia is associated with use of adducted eye for fixation of objects in contralateral temporal field"
                    },
                    {
                      "label": "apparent abduction deficit"
                    }
                  ]
                }
              ]
            },
            {
              "label": "amblyopia is common",
              "children": [
                {
                  "label": "fixation preference",
                  "children": [
                    {
                      "label": "better-seeing eye will fixate in all fields of gaze",
                      "children": [
                        {
                          "label": "amblyopic eye appears to have an abduction deficit"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "versions and ductions are often normal initially",
              "children": [
                {
                  "label": "ability to abduct each eye can be demonstrated with",
                  "children": [
                    {
                      "label": "observation with either eye patched"
                    },
                    {
                      "label": "doll’s head maneuver"
                    },
                    {
                      "label": "clinician can also hold the infant and spin in a circle",
                      "children": [
                        {
                          "label": "stimulates the vestibulo-ocular reflex"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "persistent asymmetry of monocular horizontal smooth pursuit",
                  "children": [
                    {
                      "label": "asymmetry of monocular horizontal smooth pursuit is normal ≤6 months",
                      "children": [
                        {
                          "label": "nasal-to-temporal direction less well developed than the temporal-to-nasal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "deviation is comitant",
              "children": [
                {
                  "label": ".>30Δ"
                }
              ]
            },
            {
              "label": "overelevation in adduction"
            },
            {
              "label": "dissociated strabismus complex",
              "children": [
                {
                  "label": "develop in >50%",
                  "children": [
                    {
                      "label": "usually after 1–2 years of age"
                    }
                  ]
                }
              ]
            },
            {
              "label": "fusion maldevelopment nystagmus syndrome",
              "children": [
                {
                  "label": "\"latent and manifest latent nystagmus\""
                },
                {
                  "label": "common"
                }
              ]
            },
            {
              "label": "Ciancia syndrome",
              "children": [
                {
                  "label": "severe form of infantile esotropia",
                  "children": [
                    {
                      "label": "large-angle esotropia (>50Δ)"
                    }
                  ]
                },
                {
                  "label": "cycloplegic refraction characteristically reveals low hyperopia",
                  "children": [
                    {
                      "label": "1.00–2.00 diopters"
                    }
                  ]
                },
                {
                  "label": "mild abduction deficits",
                  "children": [
                    {
                      "label": "abducting nystagmus"
                    }
                  ]
                },
                {
                  "label": "uniformly use cross-fixation"
                }
              ]
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "significant hyperopia should be corrected",
              "children": [
                {
                  "label": "full cycloplegic refraction"
                },
                {
                  "label": "small-angle esotropia that is variable or intermittent may be more likely to respond to hyperopic correction than would a large-angle or a constant esotropia"
                },
                {
                  "label": "ocular alignment is rarely achieved without surgery"
                }
              ]
            },
            {
              "label": "successful alignment is as likely to occur in patients with mild to moderate amblyopia at time of surgery as it is in those whose amblyopia has been fully treated preoperatively"
            },
            {
              "label": "goal of surgical treatment",
              "children": [
                {
                  "label": "orthotropia or as close to it as possible",
                  "children": [
                    {
                      "label": "results in normal vision in each eye and the development of some degree of sensory fusion"
                    }
                  ]
                },
                {
                  "label": "alignment within 8Δ–10Δ of orthotropia",
                  "children": [
                    {
                      "label": "microtropia",
                      "children": [
                        {
                          "label": "monofixation syndrome",
                          "children": [
                            {
                              "label": "peripheral fusion"
                            },
                            {
                              "label": "central suppression"
                            },
                            {
                              "label": "favorable appearance"
                            },
                            {
                              "label": "represents a stable, functional surgical outcome even though bifoveal fusion is not achieved",
                              "children": [
                                {
                                  "label": "considered a successful surgical result"
                                },
                                {
                                  "label": "child’s psychological and motor development may improve"
                                },
                                {
                                  "label": "bonding between infant and parents may improve"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "timing of surgery",
              "children": [
                {
                  "label": "surgery should be undertaken early",
                  "children": [
                    {
                      "label": "eyes should be aligned by age 24 months",
                      "children": [
                        {
                          "label": "preferably earlier",
                          "children": [
                            {
                              "label": "surgery can be performed in healthy children as early as age 4 months"
                            },
                            {
                              "label": "when ocular alignment is achieved earlier, there may be the added benefits of better fusion, stereopsis, and long-term stability"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "Congenital Esotropia Observational Study",
                      "children": [
                        {
                          "label": "constant esotropia of at least 40Δ present after 10 weeks of age is unlikely to resolve spontaneously"
                        },
                        {
                          "label": "smaller angles can be monitored, as they may improve spontaneously"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "European multicenter prospective study (ELISS)",
              "children": [
                {
                  "label": "showed only slight improvement in gross binocularity in early-surgery group (lower amount of suppression), but a higher number of procedures were performed in early-surgery group to achieve outcomes similar to those of delayed-surgery group"
                }
              ]
            },
            {
              "label": "most common initial procedure"
            },
            {
              "label": "surgical approaches",
              "children": [
                {
                  "label": "recession of both medial rectus muscles"
                },
                {
                  "label": "recession of a medial rectus muscle combined with resection of the ipsilateral lateral rectus muscle",
                  "children": [
                    {
                      "label": "two-muscle surgery spares the other horizontal rectus muscles for subsequent surgery"
                    }
                  ]
                },
                {
                  "label": "for infants with large deviations (>50Δ–60Δ)",
                  "children": [
                    {
                      "label": "some surgeons operate on 3 or even 4 horizontal rectus muscles at time of initial surgery"
                    },
                    {
                      "label": "or they add botulinum toxin injection to the medial rectus muscle recession"
                    }
                  ]
                },
                {
                  "label": "significant inferior oblique muscle overaction can be treated at the time of the initial surgery"
                },
                {
                  "label": "botulinum toxin injection alone",
                  "children": [
                    {
                      "label": "into the medial rectus muscles"
                    },
                    {
                      "label": "usually, 2–3 injections into each medial rectus muscle"
                    },
                    {
                      "label": "average time to achieve alignment is longer (17 months) than with surgery (2 months)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        }
      ]
    },
    {
      "label": "Types",
      "children": [
        {
          "label": "comitant",
          "children": [
            {
              "label": "infantile (congenital)"
            },
            {
              "label": "accommodative"
            },
            {
              "label": "acquired non-accommodative"
            },
            {
              "label": "nystagmus and esotropia"
            }
          ]
        },
        {
          "label": "incomitant"
        }
      ]
    },
    {
      "label": "Pseudoesotropia",
      "children": [
        {
          "label": "false appearance of esotropia when the visual axes are actually aligned",
          "children": [
            {
              "label": "observer sees less sclera nasally than would be expected"
            },
            {
              "label": "especially noticeable when the child gazes to either side"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "flat, broad nasal bridge"
            },
            {
              "label": "prominent epicanthal folds"
            },
            {
              "label": "narrow interpupillary distance"
            },
            {
              "label": "negative angle kappa",
              "children": [
                {
                  "label": "angle kappa",
                  "children": [
                    {
                      "label": "angle between the visual axis and the anatomical pupillary axis"
                    },
                    {
                      "label": "positive angle kappa",
                      "children": [
                        {
                          "label": "fovea is slightly temporal to pupillary axis"
                        },
                        {
                          "label": "corneal light reflection will be slightly nasal to center of cornea"
                        },
                        {
                          "label": "large positive angle kappa can simulate exotropia"
                        }
                      ]
                    },
                    {
                      "label": "negative angle kappa",
                      "children": [
                        {
                          "label": "fovea is nasal to pupillary axis"
                        },
                        {
                          "label": "corneal light reflection will be temporal to center of cornea"
                        },
                        {
                          "label": "simulates esotropia"
                        }
                      ]
                    },
