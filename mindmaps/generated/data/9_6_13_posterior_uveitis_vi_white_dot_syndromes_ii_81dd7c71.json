            },
            {
              "label": "multiple large, flat, yellow-white placoid lesions at the level of the RPE",
              "children": [
                {
                  "label": "1-2 disc areas"
                },
                {
                  "label": "throughout the posterior pole to the equator"
                },
                {
                  "label": "resolve over a period of 2–6 weeks",
                  "children": [
                    {
                      "label": "permanent, well-defined RPE alterations (depigmentation and pigment clumping)"
