{
  "label": "9.6.13. Posterior Uveitis (VI): White Dot Syndromes (II)",
  "root": true,
  "children": [
    {
      "label": "Serpiginous choroiditis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "M=F"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "unknown",
              "children": [
                {
                  "label": "2nd-7th decades"
                },
                {
                  "label": "immune-mediated occlusive vasculitis",
                  "children": [
                    {
                      "label": "microorganisms may be a potential trigger"
                    }
                  ]
                }
              ]
            },
            {
              "label": "reported to occur in patients with",
              "children": [
                {
                  "label": "Crohn disease"
                },
                {
                  "label": "sarcoidosis"
                },
                {
                  "label": "PAN"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "painless"
                },
                {
                  "label": "paracentral scotomata"
                },
                {
                  "label": "decreased vision"
                }
              ]
            },
            {
              "label": "bilateral asymmetric"
            },
            {
              "label": "no AC reaction"
            },
            {
              "label": "minimal vitreous reaction"
            },
            {
              "label": "active areas",
              "children": [
                {
                  "label": "pseudopodial/geographic gray-white lesions at the level of the RPE projecting from the optic nerve",
                  "children": [
                    {
                      "label": "progressive centrifugal extension",
                      "children": [
                        {
                          "label": "disease activity is confined to the leading edge of the advancing lesion"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "macular or peripheral lesions may present without peripapillary involvement",
                  "children": [
                    {
                      "label": "less common"
                    }
                  ]
                },
                {
                  "label": "+- shallow subretinal fluid"
                },
                {
                  "label": "+- vascular sheathing"
                },
                {
                  "label": "+- RPE detachment"
                },
                {
                  "label": "+- neovascularization of the disc"
                }
              ]
            },
            {
              "label": "late findings",
              "children": [
                {
                  "label": "atrophy of the choriocapillaris, RPE, and retina"
                },
                {
                  "label": "extensive RPE hyperpigmentation and subretinal fibrosis"
                }
              ]
            }
          ]
        },
        {
          "label": "natural course",
          "children": [
            {
              "label": "chronic progressive",
              "children": [
                {
                  "label": "CNV",
                  "children": [
                    {
                      "label": "at the border of an old scar"
                    },
                    {
                      "label": "≤25%"
                    }
                  ]
                },
                {
                  "label": "new lesions & recurrent attacks are typical"
                }
              ]
            },
            {
              "label": "final visual acuity of 20/200 - counting fingers",
              "children": [
                {
                  "label": "≤38%"
                }
              ]
            }
          ]
        },
        {
          "label": "paraclinical evaluation",
          "children": [
            {
              "label": "FA",
              "children": [
                {
                  "label": "early phase",
                  "children": [
                    {
                      "label": "blockage of the choroidal flush"
                    }
                  ]
                },
                {
                  "label": "late phase",
                  "children": [
                    {
                      "label": "staining of the active edge of the lesion"
                    },
                    {
                      "label": "hypofluorescence throughout all phases of the study for both acute and old lesions",
                      "children": [
                        {
                          "label": "early hyperfluorescence with late leakage is indicative of CNV"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "ICG angiography",
              "children": [
                {
                  "label": "may reveal more extensive involvement than FA or clinical examination"
                },
                {
                  "label": "CNV",
                  "children": [
                    {
                      "label": "localized hyperfluorescence during the middle to late phases"
                    },
                    {
                      "label": "useful in distinguishing active lesions from CNV"
                    }
                  ]
                }
              ]
            },
            {
              "label": "FAF imaging",
              "children": [
                {
                  "label": "sensitive for detecting RPE damage and monitoring disease course"
                },
                {
                  "label": "hyperfluorescence highlights active disease"
                },
                {
                  "label": "hypoautofluorescence corresponds closely to regressed disease"
                }
              ]
            },
            {
              "label": "OCT imaging",
              "children": [
                {
                  "label": "active disease",
                  "children": [
                    {
                      "label": "outer retinal reflectivity and disruption"
                    }
                  ]
                },
                {
                  "label": "regressed disease",
                  "children": [
                    {
                      "label": "atrophic changes in the retina and RPE"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "serpiginous-like choroiditis",
          "children": [
            {
              "label": "Mycobacterium tuberculosis",
              "children": [
                {
                  "label": "patients exposed to active pulmonary TB",
                  "children": [
                    {
                      "label": "can cause inflammation that simulates typical serpiginous choroiditis"
                    },
                    {
                      "label": "countries where TB is endemic"
                    }
                  ]
                },
                {
                  "label": "tuberculin skin testing"
                },
                {
                  "label": "interferon-gamma release assay"
                },
                {
                  "label": "chest X-ray often appears normal"
                },
                {
                  "label": "lesions appear and progress in multiple areas",
                  "children": [
                    {
                      "label": "unilateral"
                    },
                    {
                      "label": "involve posterior pole, mid-periphery, and periphery",
                      "children": [
                        {
                          "label": "more prominent vitreous cellular reaction",
                          "children": [
                            {
                              "label": "usually sparing the juxtapapillary area until late in the disease"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "responds to anti-TB treatment",
                  "children": [
                    {
                      "label": "complete control may take months"
                    },
                    {
                      "label": "+- corticosteroids"
                    }
                  ]
                }
              ]
            },
            {
              "label": "herpetic choroiditis"
            },
            {
              "label": "syphilitic choroiditis"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "systemic, periocular, and intravitreal corticosteroids",
              "children": [
                {
                  "label": "for active lesions",
                  "children": [
                    {
                      "label": "particularly lesions threatening the fovea"
                    }
                  ]
                },
                {
                  "label": "corticosteroids alone are ineffective"
                },
                {
                  "label": "patients require prolonged anti-inflammatory therapy"
                }
              ]
            },
            {
              "label": "systemic IMT",
              "children": [
                {
                  "label": "cyclosporine monotherapy"
                },
                {
                  "label": "triple therapy with prednisone, cyclosporine, and azathioprine",
                  "children": [
                    {
                      "label": "may induce rapid remission of acute disease"
                    },
                    {
                      "label": "prolonged therapy is required"
                    },
                    {
                      "label": "disease recurrence is frequently observed as drugs are tapered"
                    }
                  ]
                },
                {
                  "label": "cytotoxic therapy",
                  "children": [
                    {
                      "label": "cyclophosphamide"
                    },
                    {
                      "label": "chlorambucil"
                    },
                    {
                      "label": "induce long, drug-free remissions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "intravitreal fluocinolone acetonide implant",
              "children": [
                {
                  "label": "patients intolerant of systemic therapy"
                }
              ]
            },
            {
              "label": "CNV treatment",
              "children": [
                {
                  "label": "intravitreal anti-VEGF drugs"
                },
                {
                  "label": "focal laser photocoagulation"
                },
                {
                  "label": "photodynamic therapy"
                }
              ]
            }
          ]
        },
