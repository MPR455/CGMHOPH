    {
      "label": "Acute posterior multifocal placoid pigment epitheliopathy (APMPPE)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "healthy young adults",
              "children": [
                {
                  "label": "2nd-3rd decade"
                }
              ]
            },
            {
              "label": "M = F"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "genetic predisposition",
              "children": [
                {
                  "label": "influenza-like prodrome (50%)",
                  "children": [
                    {
                      "label": "similar to serpiginous & ARPE",
                      "children": [
                        {
                          "label": "unlike other WDSs"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "HLA-B7"
                },
                {
                  "label": "HLA-DR2"
                }
              ]
            },
            {
              "label": "immune-mediated vascular alteration",
              "children": [
                {
                  "label": "choroidal/choriocapillaris perfusion abnormalities with secondary involvement of the RPE/photoreceptors"
                }
              ]
            },
            {
              "label": "noninfectious systemic associations",
              "children": [
                {
                  "label": "erythema nodosum"
                },
                {
                  "label": "cerebral vasculitis",
                  "children": [
                    {
                      "label": "potentially life-threatening"
                    }
                  ]
                },
                {
                  "label": "scleritis and episcleritis",
                  "children": [
                    {
                      "label": "should undergo urgent neurologic evaluation"
                    }
                  ]
                },
                {
                  "label": "GPA"
                },
                {
                  "label": "PAN"
                },
                {
                  "label": "sarcoidosis"
                },
                {
                  "label": "ulcerative colitis"
                }
              ]
            },
            {
              "label": "infectious systemic associations",
              "children": [
                {
                  "label": "group A streptococcal infection"
                },
                {
                  "label": "adenovirus type 5 infection"
                },
                {
                  "label": "tuberculosis"
                },
                {
                  "label": "Lyme disease"
                },
                {
                  "label": "mumps"
                },
                {
                  "label": "sudden onset",
                  "children": [
                    {
                      "label": "hepatitis B vaccination"
                    },
                    {
                      "label": "resolve over a period of 2–6 weeks"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "natural course",
              "children": [
                {
                  "label": "new peripheral lesions may appear in a linear/ radial array over the next 3 weeks"
                }
              ]
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "vision loss",
                  "children": [
                    {
                      "label": "fellow eye becomes involved within days to weeks",
