            }
          ]
        },
        {
          "label": "Opsoclonus",
          "children": [
            {
              "label": "etiology",
              "children": [
                {
                  "label": "acute postinfectious cerebellar ataxia"
                },
                {
                  "label": "viral encephalitis"
                },
                {
                  "label": "paraneoplastic manifestation of neuroblastoma"
                }
              ]
            },
            {
              "label": "involuntary saccades",
              "children": [
                {
                  "label": "rapid and multidirectional"
                },
                {
                  "label": "eye movements with very high frequency and large amplitude"
                },
                {
                  "label": "can occur intermittently"
                },
                {
                  "label": "not a true nystagmus!"
                }
              ]
