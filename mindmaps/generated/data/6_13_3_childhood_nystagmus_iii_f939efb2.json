                },
                {
                  "label": "defective convergence"
                },
                {
                  "label": "eyelid retraction"
                },
                {
                  "label": "pupillary light–near dissociation"
                }
              ]
            },
            {
              "label": "nystagmus is best elicited on attempted upgaze saccades",
              "children": [
                {
                  "label": "tracking a downward-rotating OKN drum"
                },
                {
                  "label": "co-contraction of all horizontal extraocular muscles occurs",
                  "children": [
                    {
                      "label": "retraction of the globe"
                    },
                    {
                      "label": "medial rectus muscles overpower the lateral rectus muscles",
