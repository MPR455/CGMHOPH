  "root": true,
  "children": [
    {
      "label": "Dermatochalasis",
      "children": [
        {
          "label": "familial predisposition"
        },
        {
          "label": "more common in elderly",
          "children": [
            {
              "label": "also occurs in middle-aged persons"
            }
          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "heavy feeling around the eyes"
            },
            {
              "label": "brow ache"
            },
            {
              "label": "eyelashes in the visual axis"
            },
            {
              "label": "reduction in the superior visual field"
            }
          ]
        },
        {
          "label": "redundancy of eyelid skin"
        },
        {
          "label": "± associated orbital fat prolapse"
        },
        {
          "label": "± associated brow ptosis"
        },
        {
          "label": "± true ptosis of upper eyelids"
        },
        {
          "label": "lower eyelid dermatochalasis is a cosmetic issue",
          "children": [
            {
              "label": "except when patient cannot be fitted with bifocals"
            }
          ]
        }
      ]
    },
    {
      "label": "Brow Ptosis",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "involutional changes of the forehead skin",
              "children": [
                {
                  "label": "loss of elastic tissues"
                },
                {
                  "label": "loss of facial volume"
                }
              ]
            },
            {
              "label": "facial nerve palsy"
            }
          ]
        },
        {
          "label": "drooping of the forehead and eyebrows",
          "children": [
            {
              "label": "eyebrow falls below the superior orbital rim",
              "children": [
                {
                  "label": "normal brow is located above the superior orbital rim",
                  "children": [
                    {
                      "label": "female brow is higher and more arched"
                    }
                  ]
                }
              ]
            },
            {
              "label": "frequently accompanies dermatochalasis"
            },
            {
              "label": "may become severe enough to affect the superior visual field"
            }
          ]
        },
        {
          "label": "patient uses frontalis muscle to elevate eyebrows",
          "children": [
            {
              "label": "brow ache"
            },
            {
              "label": "headache"
            },
            {
              "label": "prominent transverse forehead rhytids"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "must be treated prior to or concomitant with the surgical repair of coexisting dermatochalasis",
              "children": [
                {
                  "label": "upper blepharoplasty alone in a patient with concomitant brow ptosis leads to further depression of the brow"
                }
              ]
            },
            {
              "label": "browpexy",
              "children": [
                {
                  "label": "for mild brow ptosis",
                  "children": [
                    {
                      "label": "provides minimal improvement in brow position"
                    },
                    {
                      "label": "may prevent retro-orbicularis oculi fat (ROOF) from descending into eyelid"
                    }
                  ]
                },
                {
                  "label": "technique",
                  "children": [
                    {
                      "label": "upper eyelid blepharoplasty incision"
                    },
                    {
                      "label": "sub-brow tissues are resuspended with sutures to the frontal bone periosteum"
                    }
                  ]
                },
                {
                  "label": "references"
                }
              ]
            },
            {
              "label": "direct eyebrow elevation",
              "children": [
                {
                  "label": "incision at upper edge of eyebrow"
                },
                {
                  "label": "particularly useful for lateral brow ptosis",
                  "children": [
                    {
                      "label": "when used across the entire brow, it may result in an arch or scar"
                    }
                  ]
                },
                {
                  "label": "± cause paresthesia"
                }
              ]
            }
          ]
        }
      ]
    },
