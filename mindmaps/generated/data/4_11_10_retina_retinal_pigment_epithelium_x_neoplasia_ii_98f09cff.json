{
  "label": "4.11.10. Retina & Retinal pigment epithelium (X): Neoplasia (II)",
  "root": true,
  "children": [
    {
      "label": "Fuchs Adenoma",
      "children": [
        {
          "label": "acquired tumor of nonpigmented ciliary body epithelium"
        },
        {
          "label": "may cause sectoral cataract"
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "hyperplastic nonpigmented ciliary epithelium",
              "children": [
                {
                  "label": "arranged in sheets and tubules"
                }
              ]
            },
            {
              "label": "alternating areas of PAS-positive basement membrane material"
            }
          ]
        }
      ]
    },
    {
      "label": "Combined hamartoma of the retina and retinal pigment epithelium",
      "children": [
        {
          "label": "often diagnosed in childhood"
        },
        {
          "label": "slightly elevated variably pigmented mass"
        },
        {
          "label": "preretinal membrane",
          "children": [
            {
              "label": "distorts the tumor inner retinal surface"
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "thickening of optic nerve head and peripapillary retina"
            },
            {
              "label": "increased number of vessels"
            },
            {
              "label": "hyperplastic RPE",
              "children": [
                {
                  "label": "perivascular"
                }
              ]
            },
            {
              "label": "vitreous condensation and fibroglial proliferation",
              "children": [
                {
                  "label": "differentiates from RPE hyperplasia"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Medulloepithelioma (Diktyoma)",
      "children": [
        {
          "label": "congenital neuroepithelial tumor",
          "children": [
            {
              "label": "arises from primitive medullary epithelium"
            }
          ]
        },
        {
          "label": "sites",
          "children": [
            {
              "label": "ciliary body",
              "children": [
                {
                  "label": "most common"
                }
              ]
            },
            {
              "label": "retina"
            },
            {
              "label": "optic nerve"
            }
          ]
        },
        {
          "label": "clinical",
          "children": [
            {
              "label": "non- or lightly pigmented cystic mass"
            },
            {
              "label": "± iris/anterior chamber erosion"
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "undifferentiated round-oval cells with little cytoplasm"
            },
            {
              "label": "cell nuclei are stratified in 3-5 layers"
            },
            {
              "label": "ribbonlike structure with distinct cellular polarity"
            },
            {
              "label": "lined on one side by thin basement membrane"
            },
            {
              "label": "secretes mucinous substance rich in hyaluronic acid",
              "children": [
                {
                  "label": "resembles primitive vitreous"
                },
                {
                  "label": "mucinous cysts"
                }
              ]
            },
            {
              "label": "± rosettes",
              "children": [
                {
                  "label": "Homer-Wright"
                },
                {
                  "label": "Flexner-Wintersteiner"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Adenoma/Adenocarcinoma of RPE",
      "children": [
        {
          "label": "uncommon"
        },
        {
          "label": "no history of prior trauma or eye disease"
        },
        {
          "label": "adenoma",
          "children": [
            {
