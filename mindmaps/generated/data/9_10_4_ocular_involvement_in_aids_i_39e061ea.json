{
  "label": "9.10.4. Ocular Involvement in AIDS (I)",
  "root": true,
  "children": [
    {
      "label": "Ophthalmic manifestations",
      "children": [
        {
          "label": "human immunodeficiency virus (HIV)"
        },
        {
          "label": "reported in 70% of infected people",
          "children": [
            {
              "label": "infects and results in the depletion of CD4+ helper T lymphocytes"
            }
          ]
        },
        {
          "label": "visual morbidity occurs primarily with posterior segment involvement",
          "children": [
            {
              "label": "may be the first sign of disseminated systemic HIV infection"
            }
          ]
        },
        {
          "label": "accelerated aging may be a part of HIV- associated eye disease",
          "children": [
            {
              "label": "earlier onset of macular degeneration and cataracts"
            }
          ]
        },
        {
          "label": "HIV-related microangiopathy of the retina (retinopathy)",
          "children": [
            {
              "label": "HIV has been isolated from the human retina",
              "children": [
                {
                  "label": "the most common ocular finding in patients infected with HIV"
                }
              ]
            },
            {
              "label": "HIV antigen has been detected in retinal endothelial cells"
            },
            {
              "label": "retinal hemorrhages"
            },
            {
              "label": "microaneurysms"
            },
            {
              "label": "cotton-wool spots"
            }
          ]
        },
        {
          "label": "opportunistic viral, bacterial, and fungal infections",
          "children": [
            {
              "label": "cytomegalovirus (CMV)"
            },
            {
              "label": "herpes zoster virus"
            },
            {
              "label": "Toxoplasma gondii"
            },
            {
              "label": "Mycobacterium tuberculosis"
            },
            {
              "label": "Mycobacterium avium-intracellulare"
            },
            {
              "label": "Cryptococcus neoformans"
            },
            {
              "label": "Pneumocystis jirovecii"
            },
            {
              "label": "Histoplasma capsulatum"
            },
            {
              "label": "Candida"
            },
            {
              "label": "molluscum contagiosum virus"
            }
          ]
        },
        {
          "label": "Kaposi sarcoma of the eyelid and conjunctiva",
          "children": [
            {
              "label": "microsporidia"
            }
          ]
        },
        {
          "label": "lymphomas involving the retina (primary intraocular lymphoma), adnexal structures, and orbit"
        },
        {
          "label": "squamous cell carcinoma of the conjunctiva"
        },
        {
          "label": "HIV infection itself may cause anterior or intermediate uveitis",
          "children": [
            {
              "label": "not responsive to corticosteroids"
            },
            {
              "label": "improves with antiretroviral therapy"
            }
          ]
        }
      ]
    },
    {
      "label": "Toxoplasma Retinochoroiditis",
      "children": [
        {
          "label": "differs from toxoplasmosis in immunocompetent patients",
          "children": [
            {
              "label": "≤40% have bilateral disease"
            },
            {
              "label": "lesions are larger"
            },
            {
              "label": "vitreous reaction may be less"
            },
            {
              "label": "preexisting scars are rare",
              "children": [
                {
                  "label": "6%"
                }
              ]
            },
            {
              "label": "solitary, multifocal, and miliary patterns of retinitis"
            },
            {
              "label": "inevitably progresses if left untreated"
            },
            {
              "label": "may be associated with cerebral or disseminated toxoplasmosis"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "newly acquired T gondii infections",
              "children": [
                {
                  "label": "more common"
                }
              ]
            },
            {
              "label": "dissemination from nonocular sites",
              "children": [
                {
                  "label": "more common"
                }
              ]
            },
            {
              "label": "reactivation of quiescent toxoplasmosis also occurs"
            }
          ]
        },
        {
          "label": "may be difficult to distinguish from",
          "children": [
            {
              "label": "ARN"
            },
            {
              "label": "necrotizing herpetic retinitis"
            },
            {
              "label": "syphilitic retinitis"
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "aqueous and vitreous samples for culture and polymerase chain reaction techniques"
            }
          ]
        },
        {
          "label": "pathology",
          "children": [
            {
              "label": "inflammatory reaction in the choroid, retina, and vitreous is less prominent"
            },
            {
              "label": "trophozoites and cysts can be observed in greater numbers"
            },
            {
              "label": "T gondii organisms can occasionally be noted invading the choroid"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "consultation with specialists in infectious diseases",
              "children": [
                {
                  "label": "magnetic resonance imaging (MRI) of the brain"
                }
              ]
            },
            {
              "label": "antitoxoplasmic therapy",
              "children": [
                {
                  "label": "various combinations of pyrimethamine, sulfadiazine, azithromycin, atovaquone, or clindamycin"
                },
                {
                  "label": "consider the possibility of coexisting cerebral or disseminated toxoplasmosis"
                },
                {
                  "label": "continued maintenance therapy may be necessary for patients with poor immune status that is not improving"
                }
              ]
            },
            {
              "label": "corticosteroids should be used with caution and only in the presence of appropriate antimicrobial coverage"
            }
          ]
        }
      ]
    },
    {
      "label": "Necrotizing Herpetic Retinitis",
      "children": [
        {
          "label": "severity directly proportional to the level of immunologic compromise"
        },
        {
          "label": "progressive outer retinal necrosis (PORN)",
          "children": [
            {
              "label": "rare variant of necrotizing herpetic retinitis",
              "children": [
                {
                  "label": "varicella-zoster virus or herpes simplex virus"
                }
              ]
            },
            {
              "label": "in the absence of, at the same time as, or subsequent to cutaneous varicella-zoster infection"
            },
            {
              "label": "in early stages PORN may be difficult to differentiate from peripheral CMV retinitis"
            },
            {
              "label": "rapid progression"
            },
            {
              "label": "high incidence of retinal detachment",
              "children": [
                {
                  "label": "relative absence of vitreous inflammation"
                },
                {
                  "label": "bilateral involvement is common"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "intravitreous ganciclovir, foscarnet, or acyclovir"
                },
                {
                  "label": "combination antiretroviral therapy"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Cytomegalovirus Retinitis",
      "children": [
        {
          "label": "CD4+ counts ≤50 cells/μL"
        },
        {
          "label": "occasionally is the first AIDS-defining infection",
          "children": [
            {
              "label": "remains the most common opportunistic ocular infection in patients with AIDS"
            }
          ]
        },
        {
          "label": "references"
        },
        {
          "label": "Immune recovery uveitis (IRU)",
          "children": [
            {
              "label": "occurs only in eyes with previous CMV retinitis whose immune status improves with combination antiretroviral therapy",
              "children": [
                {
                  "label": "10%",
                  "children": [
                    {
                      "label": "increase in the CD4+ T-lymphocyte count of at least 50 cells/μL to at least 100 cells/μL"
                    }
                  ]
                }
              ]
            },
            {
              "label": "risk factors",
              "children": [
                {
                  "label": "risk proportional to the surface area of retina involved",
                  "children": [
                    {
                      "label": "CMV retinitis surface area ≥25%"
                    }
                  ]
                },
                {
                  "label": "greater risk (odds ratio, 10.6) in patients ever treated with cidofovir"
                },
                {
                  "label": "has not been linked to",
                  "children": [
                    {
                      "label": "active replication of CMV"
                    },
                    {
                      "label": "continuation or discontinuation of anti-CMV medication"
                    }
                  ]
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "anterior or intermediate uveitis"
                },
                {
                  "label": "more likely to have",
                  "children": [
                    {
                      "label": "macular edema",
                      "children": [
                        {
                          "label": "resistant to sub-Tenon corticosteroids",
                          "children": [
                            {
                              "label": "such injections do not cause reactivation of CMV infection"
                            },
                            {
                              "label": "intravitreal injections of corticosteroids must be avoided!"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "epiretinal membrane"
                    }
                  ]
                },
                {
                  "label": "associated with moderate vision loss"
                }
              ]
            }
          ]
        },
        {
          "label": "Retinal detachment",
          "children": [
            {
              "label": "50% of patients with CMV retinitis",
              "children": [
                {
                  "label": "during active disease or after successful treatment"
                }
              ]
            },
            {
              "label": "with potent antiretroviral regimens, the rate of retinal detachment has been reduced to 0.06 per patient-year"
            },
            {
              "label": "risk factors",
              "children": [
                {
                  "label": "involvement of all 3 retinal zones"
                },
                {
                  "label": "lower CD4+ T-lymphocyte count"
                },
                {
                  "label": "more extensive retinitis"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "difficult to repair because of",
                  "children": [
                    {
                      "label": "extensive retinal necrosis"
                    },
                    {
                      "label": "multiple, often posterior, hole formation"
                    }
                  ]
                },
                {
                  "label": "pars plana vitrectomy with long-term silicone oil tamponade",
                  "children": [
                    {
                      "label": "anatomical reattachment in 90%"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
