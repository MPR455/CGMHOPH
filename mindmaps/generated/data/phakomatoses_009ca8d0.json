                  "label": "cerebellar hemangioblastoma"
                },
                {
                  "label": "renal cell carcinoma"
                }
              ]
            }
          ]
        },
        {
          "label": "Testing",
          "children": [
            {
              "label": "wide-angle fluorescein angiography",
              "children": [
                {
                  "label": "allows detecting small, early lesions"
                }
              ]
            },
            {
              "label": "genetic testing"
            },
            {
              "label": "diagnosis of a retinal hemangioblastoma warrants systemic workup ± genetic testing"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "treatment of all identified retinal angiomas",
              "children": [
                {
                  "label": "lesions usually enlarge with time"
                }
              ]
            },
            {
              "label": "photocoagulation"
            },
            {
              "label": "photodynamic therapy"
            },
            {
              "label": "cryotherapy",
              "children": [
                {
                  "label": "larger lesions"
