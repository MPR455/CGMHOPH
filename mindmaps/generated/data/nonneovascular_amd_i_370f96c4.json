        {
          "label": "Genetics of AMD",
          "children": [
            {
              "label": "genetic mutations responsible for AMD affect various biochemical pathways",
              "children": [
                {
                  "label": "alternate complement pathway",
                  "children": [
                    {
                      "label": "CFH, CFI, C2/CFB, C3, and C7"
                    }
                  ]
                },
                {
                  "label": "lipid transport and metabolism",
                  "children": [
                    {
                      "label": "APOE"
                    }
                  ]
                },
                {
                  "label": "modulation of the extracellular collagen matrix",
                  "children": [
                    {
                      "label": "COL8A1, COL10A1, TIMP3"
                    }
                  ]
                },
                {
                  "label": "clearance of all-trans-retinaldehyde from photoreceptors",
                  "children": [
                    {
                      "label": "ABCA4"
                    }
                  ]
                },
                {
                  "label": "angiogenesis",
                  "children": [
                    {
                      "label": "MMP9, VEGFA"
                    }
                  ]
                }
              ]
            },
            {
              "label": "2 major susceptibility genes for AMD",
              "children": [
                {
                  "label": "CFH (1q31)",
                  "children": [
                    {
                      "label": "codes for complement factor H"
                    },
                    {
                      "label": "CFH Y402H mutation increases risk for AMD",
                      "children": [
                        {
                          "label": "4.6-fold when heterozygous"
                        },
                        {
                          "label": "7.4-fold when homozygous"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "ARMS2 (10q26)",
                  "children": [
                    {
                      "label": "gene product and function are poorly understood"
                    },
                    {
                      "label": "ARMS2 A69S mutation increases risk for AMD",
                      "children": [
                        {
                          "label": "2.7-fold when heterozygous"
                        },
                        {
                          "label": "8.2-fold when homozygous"
                        }
                      ]
                    },
                    {
                      "label": "ARMS2/HTRA1 and MMP20 are associated with CNV lesion size",
                      "children": [
                        {
                          "label": "AAO recommends deferring genetic testing until replicable studies have confirmed its value"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "Genetic testing",
              "children": [
                {
                  "label": "interpretation and usefulness is controversial"
                },
                {
                  "label": "unhealthy lifestyle increases AMD risk regardless of genotype"
                },
                {
                  "label": "risk models are poorly validated"
                },
                {
                  "label": "risk models add little to the risk estimated from clinical findings and non-genetic risk factors"
                }
              ]
            },
            {
              "label": "Pharmacogenomic testing",
              "children": [
                {
                  "label": "to predict the optimal pharmacologic or nutritional-supplement interventions for a given patient"
