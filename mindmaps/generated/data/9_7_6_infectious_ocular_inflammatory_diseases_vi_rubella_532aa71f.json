                        {
                          "label": "persistence of viral replication after birth",
                          "children": [
                            {
                              "label": "appearance of hearing and neurologic and/or ocular deficits long after birth"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "frequency of fetal infection is highest during the first 10 weeks and the final month of pregnancy"
            },
            {
              "label": "rate of congenital defects varies inversely with gestational age",
              "children": [
                {
                  "label": "obvious maternal infection during the first trimester of pregnancy may end in spontaneous abortion, stillbirth, or severe fetal malformations"
