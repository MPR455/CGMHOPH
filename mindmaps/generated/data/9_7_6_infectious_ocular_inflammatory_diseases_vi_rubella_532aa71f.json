        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "maternal viremia during primary infection",
              "children": [
                {
                  "label": "transplacental fetal infection",
                  "children": [
                    {
                      "label": "establishes a chronic, persistent infection during organogenesis",
                      "children": [
                        {
                          "label": "inhibits cellular multiplication"
