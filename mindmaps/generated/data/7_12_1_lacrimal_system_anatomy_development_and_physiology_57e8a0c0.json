{
  "label": "7.12.1. Lacrimal System: Anatomy, Development, and Physiology",
  "root": true,
  "children": [
    {
      "label": "Physiology",
      "children": [
        {
          "label": "tear evaporation",
          "children": [
            {
              "label": "10% of tear elimination in young"
            },
            {
              "label": "≥20% in elderly"
            }
          ]
        },
        {
          "label": "most of tear is actively pumped from tear lake by actions of the orbicularis oculi muscle",
          "children": [
            {
              "label": "blinking pushes the tears from lateral to nasal on the eyelid margin"
            },
            {
              "label": "action of the orbicularis muscle on the canaliculi and the lacrimal sac also promotes drainage"
            },
            {
              "label": "weakened blink interferes with normal pumping mechanism"
            }
          ]
        }
      ]
    },
    {
      "label": "Normal Anatomy",
      "children": [
        {
          "label": "Secretory System",
          "children": [
            {
              "label": "precorneal tear film has 3 layers",
              "children": [
                {
                  "label": "middle aqueous layer",
                  "children": [
                    {
                      "label": "sources",
                      "children": [
                        {
                          "label": "main lacrimal gland",
                          "children": [
                            {
                              "label": "exocrine gland"
                            },
                            {
                              "label": "superior lateral quadrant of the orbit"
                            },
                            {
                              "label": "lacrimal gland fossa"
                            },
                            {
                              "label": "lateral horn of levator aponeurosis divides lacrimal gland into 2 lobes",
                              "children": [
                                {
                                  "label": "orbital lobe"
                                },
                                {
                                  "label": "palpebral lobe"
                                }
                              ]
                            },
                            {
                              "label": "superior transverse ligament (Whitnall ligament)",
                              "children": [
                                {
                                  "label": "forms septa through the stroma of the gland"
                                },
                                {
                                  "label": "some fibers project onto the lateral orbital tubercle"
                                }
                              ]
                            },
                            {
                              "label": "major lacrimal ducts",
                              "children": [
                                {
                                  "label": "pass through the palpebral portion of the gland",
                                  "children": [
                                    {
                                      "label": "removal of the palpebral lobe may reduce secretion from the entire gland",
                                      "children": [
                                        {
                                          "label": "biopsy of the lacrimal gland is preferentially performed on the orbital lobe"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "label": "8–12"
                                },
                                {
                                  "label": "empty into the superior cul-de-sac",
                                  "children": [
                                    {
                                      "label": "≈ 5 mm above the lateral tarsal border"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "accessory lacrimal glands",
                          "children": [
                            {
                              "label": "exocrine glands"
                            },
                            {
                              "label": "types",
                              "children": [
                                {
                                  "label": "glands of Krause",
                                  "children": [
                                    {
                                      "label": "deep within the superior fornix"
                                    }
                                  ]
                                },
                                {
                                  "label": "glands of Wolfring",
                                  "children": [
                                    {
                                      "label": "just above the superior border of the tarsus"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "types",
                      "children": [
                        {
                          "label": "basal secretion"
                        },
                        {
                          "label": "reflex secretion",
                          "children": [
                            {
                              "label": "reflex tear arc",
                              "children": [
                                {
                                  "label": "sensory (afferent) pathway",
                                  "children": [
                                    {
                                      "label": "ophthalmic branch of the trigeminal nerve (CN V)"
                                    }
                                  ]
                                },
                                {
                                  "label": "efferent pathway",
                                  "children": [
                                    {
                                      "label": "superior salivatory nucleus of pons",
                                      "children": [
                                        {
                                          "label": "parasympathetic fibers",
                                          "children": [
                                            {
                                              "label": "exit brainstem with facial nerve (CN VII) (via nervus intermedius)"
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "label": "lacrimal fibers leave CN VII as the greater superficial petrosal nerve",
                                      "children": [
                                        {
                                          "label": "pass to sphenopalatine ganglion",
                                          "children": [
                                            {
                                              "label": "enter zygomaticotemporal nerve (branch of V2)",
                                              "children": [
                                                {
                                                  "label": "enter lacrimal nerve via an anastomosis (branch of V1)",
                                                  "children": [
                                                    {
                                                      "label": "enter lacrimal gland"
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "superficial oily layer",
                  "children": [
                    {
                      "label": "produced by meibomian glands"
                    }
                  ]
                },
                {
                  "label": "deep mucin layer",
                  "children": [
                    {
                      "label": "secreted by goblet cells within the conjunctiva"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Drainage System",
          "children": [
            {
              "label": "puncta",
              "children": [
                {
                  "label": "located medially on margin of both upper and lower eyelids"
                },
                {
                  "label": "lower puncta lie slightly farther lateral"
                },
                {
                  "label": "are slightly inverted and apposed to the globe within the tear lake",
                  "children": [
                    {
                      "label": "nasal mucosa is pseudostratified"
                    }
                  ]
                },
                {
                  "label": "ampulla"
                }
              ]
            },
            {
              "label": "lacrimal canaliculi",
              "children": [
                {
                  "label": "lined with nonkeratinized, non–mucin- producing stratified squamous epithelium"
                },
                {
                  "label": "run roughly 2 mm vertically from the punctum",
                  "children": [
                    {
                      "label": "turn 90°",
                      "children": [
                        {
                          "label": "continue 8–10 mm medially",
                          "children": [
                            {
                              "label": "join at the common canaliculus",
                              "children": [
                                {
                                  "label": "in some individuals there is a unique configuration in which 2 independent canaliculi lead to the lacrimal sac",
                                  "children": [
                                    {
                                      "label": "10%"
                                    }
                                  ]
                                },
                                {
                                  "label": "bends from posterior to anterior behind medial canthal tendon before entering lacrimal sac at an acute angle"
                                },
                                {
                                  "label": "valve of Rosenmüller",
                                  "children": [
                                    {
                                      "label": "1-way valve"
                                    },
                                    {
                                      "label": "prevent reflux of tears from the sac into the canaliculi"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "lacrimal sac",
              "children": [
                {
                  "label": "bony lacrimal sac fossa",
                  "children": [
                    {
                      "label": "anterior medial orbit"
                    },
                    {
                      "label": "anterior and posterior lacrimal crests"
                    },
                    {
                      "label": "medial wall of the fossa",
                      "children": [
                        {
                          "label": "composed of the lacrimal bone posteriorly and the frontal process of the maxilla anteriorly"
                        },
                        {
                          "label": "adjacent to middle meatus of the nose",
                          "children": [
                            {
                              "label": "sometimes with intervening ethmoid air cells"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "medial canthal tendon",
                  "children": [
                    {
                      "label": "anterior and posterior crura",
                      "children": [
                        {
                          "label": "superficial head attaches to anterior lacrimal crest"
                        },
                        {
                          "label": "deep head (with the Horner muscle), attaches to posterior lacrimal crest"
                        },
                        {
                          "label": "wrap around the anterior and posterior aspects of the lacrimal sac"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "dome of sac extends several millimeters above medial canthal tendon"
                }
              ]
            },
            {
              "label": "angular artery and vein",
              "children": [
                {
                  "label": "lie 7–8 mm medial to the medial canthal angle"
                },
                {
                  "label": "anastomose with vascular systems of face and orbit"
                },
                {
                  "label": "if cut during dacryocystorhinostomy, may cause troublesome bleeding"
                }
              ]
            },
            {
              "label": "nasolacrimal duct (NLD)",
              "children": [
                {
                  "label": "within the bony nasolacrimal canal"
                },
                {
                  "label": "12–18 mm in length",
                  "children": [
                    {
                      "label": "interosseous portion",
                      "children": [
                        {
                          "label": "12 mm"
                        }
                      ]
                    },
                    {
                      "label": "meatal portion",
                      "children": [
                        {
                          "label": "5–6 mm inferior to the bony ostium"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "curves in an inferior and slightly lateral and posterior direction from the lacrimal sac"
                },
                {
                  "label": "opens into the nose under the inferior turbinate",
                  "children": [
                    {
                      "label": "inferior meatus"
                    }
                  ]
                },
                {
                  "label": "mucosal ostium",
                  "children": [
                    {
                      "label": "partially covered by a mucosal fold (valve of Hasner)"
                    },
                    {
                      "label": "located 30–35 mm from external nares"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Development",
      "children": [
        {
          "label": "Secretory System",
          "children": [
            {
              "label": "lacrimal gland develops from multiple solid ectodermal buds (in anterior superolateral orbit)"
            },
            {
              "label": "buds branch, canalize, and form ducts and alveoli"
            },
            {
              "label": "lacrimal glands are small and do not function fully until approximately 6 weeks after birth",
              "children": [
                {
                  "label": "newborn infants do not produce tears when crying"
                }
              ]
            }
          ]
        },
        {
          "label": "Drainage System",
          "children": [
            {
              "label": "end of fifth week of gestation"
            },
            {
              "label": "nasolacrimal groove",
              "children": [
                {
                  "label": "forms as a furrow between nasal and maxillary prominence"
                },
                {
                  "label": "solid cord from ectoderm",
                  "children": [
                    {
                      "label": "cord canalizes, forming the NLD and the lacrimal sac",
                      "children": [
                        {
                          "label": "canalicular system is an outgrowth of the lacrimal sac"
                        },
                        {
                          "label": "failure of opening of distal aspect of duct is the most common cause of congenital NLD obstruction",
                          "children": [
                            {
                              "label": "symptomatic in approximately 5% of infants at birth",
                              "children": [
                                {
                                  "label": "excessive tearing may not occur until around age 6 weeks"
                                },
                                {
                                  "label": "patency usually occurs spontaneously within first few months of life"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "canalization of NLD is usually complete around time of birth"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "lacrimation does not function normally until around age 6 weeks"
            }
          ]
        }
      ]
    }
  ],
