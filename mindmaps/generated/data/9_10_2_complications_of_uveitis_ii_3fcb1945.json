{
  "label": "9.10.2. Complications of Uveitis (II)",
  "root": true,
  "children": [
    {
      "label": "especially children"
    },
    {
      "label": "Calcific Band Keratopathy",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "chronic uveitis"
            },
            {
              "label": "may arise within months of onset of the uveitis"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "interpalpebral zone"
            },
            {
              "label": "calcium deposition along the epithelial basement membrane and the Bowman layer"
            },
            {
              "label": "± visually significant (it extends into the visual axis)"
            },
            {
              "label": "± foreign body sensation"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "chelation with disodium ethylenediaminetetraacetic acid (EDTA)"
            },
            {
              "label": "photorefractive keratotomy"
            }
          ]
        }
      ]
    },
    {
      "label": "Vision Rehabilitation",
      "children": [
        {
          "label": "worldwide, inflammatory disease is a significant cause of blindness and low vision"
        },
        {
          "label": "in US, 10% of all blindness is attributed to inadequately treated uveitis"
        },
        {
          "label": "referral to vision rehabilitation is recommended for patients with",
          "children": [
            {
              "label": "visual acuity <20/40 in the better eye"
            },
            {
              "label": "reduced contrast sensitivity"
            },
            {
              "label": "disabling glare"
            },
            {
              "label": "central or peripheral visual field loss"
            }
          ]
        },
        {
          "label": "SmartSight patient handout",
          "children": [
            {
              "label": "http://one.aao.org/smart-sight-low-vision"
            }
          ]
        },
        {
          "label": "provide parents of children with uveitis information about rehabilitation",
          "children": [
            {
              "label": "www.uveitis.org/patients/education/patient- guides"
            }
          ]
        }
      ]
    },
    {
      "label": "Cataracts",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "chronic/recurrent uveitis"
            }
          ]
        },
        {
          "label": "indications for cataract surgery",
          "children": [
            {
              "label": "cataract causes functional impairment that interferes with activities of daily living",
              "children": [
                {
                  "label": "careful preoperative evaluation is necessary to ascertain whether the cataract is actually contributing to visual dysfunction"
                }
              ]
            },
            {
              "label": "cataract precludes adequate view of the fundus"
            }
          ]
        },
        {
          "label": "preoperative medical management",
          "children": [
            {
              "label": "achieve the best control of inflammation possible without flare-ups for ≥ 3 months"
            },
            {
              "label": "preoperative pulsing with oral corticosteroids (0.5–1.0 mg/kg/day, usually for 3 days)",
              "children": [
                {
                  "label": "tapered over weeks to months after surgery"
                },
                {
                  "label": "and/or intensive topical corticosteroid treatment"
                }
              ]
            },
            {
              "label": "utilize all appropriate means for control, including immunosuppression if needed"
            },
            {
              "label": "infectious uveitides (eg, uveitis caused by Toxoplasma gondii infection and herpetic uveitis)",
              "children": [
                {
                  "label": "perioperative prophylactic antimicrobial therapy"
                },
                {
                  "label": "preoperative oral corticosteroids are usually not given"
                }
              ]
            }
          ]
        },
        {
          "label": "surgical technique",
          "children": [
            {
              "label": "clear corneal approach",
              "children": [
                {
                  "label": "particularly desirable in cases of scleritis that may be prone to postoperative scleral necrosis"
                }
              ]
            },
            {
              "label": "posterior synechiae/pupillary miosis",
              "children": [
                {
                  "label": "mechanical or viscoelastic pupil stretching"
                },
                {
                  "label": "sphincterotomies"
                },
                {
                  "label": "use of flexible iris retractors"
                }
              ]
            },
            {
              "label": "continuous curvilinear capsulorrhexis",
              "children": [
                {
                  "label": "reduces posterior synechiae formation"
                },
                {
                  "label": "reduces the risk of posterior capsular tear"
                },
                {
                  "label": "facilitates placement of IOL haptics in the capsular bag"
                },
                {
                  "label": "fibrotic anterior capsule may be more difficult to open with a capsulorrhexis"
                }
              ]
            },
            {
              "label": "meticulous cortical cleanup"
            },
            {
              "label": "hydrophobic acrylic posterior chamber IOLs placed in the capsular bag"
            },
            {
              "label": "periocular or intravitreal corticosteroids at the end of the procedure"
            },
            {
              "label": "pars plana vitrectomy (in conjunction with phacoemulsification with IOL)",
              "children": [
                {
                  "label": "substantial vision-limiting vitreous debris"
                },
                {
                  "label": "macular pathology such as epiretinal membranes"
                }
              ]
            },
            {
              "label": "vitrectomy and aphakia",
              "children": [
                {
                  "label": "significant structural damage from inflammation"
                },
                {
                  "label": "surgical prognosis is guarded",
                  "children": [
                    {
                      "label": "JIA-associated uveitis"
                    }
                  ]
                },
                {
                  "label": "zonular insufficiency",
                  "children": [
                    {
                      "label": "± pars plana lensectomy and vitrectomy and avoid placing an IOL"
                    }
                  ]
                }
              ]
            },
            {
              "label": "relative contraindications for IOL implantation",
              "children": [
                {
                  "label": "prior development of rubeosis"
                },
                {
                  "label": "history of extensive membrane formation"
                },
                {
                  "label": "hypotony"
                }
              ]
            },
            {
              "label": "controversy regarding IOL placement in children with JIA-associated uveitis",
              "children": [
                {
                  "label": "choosing the proper IOL power, especially in children under the age of 10 years, is difficult"
                },
                {
                  "label": "if IOLs are used, in-the-bag implantation of acrylic IOLs and primary posterior capsulorrhexis are preferred in children",
                  "children": [
                    {
                      "label": "core anterior vitrectomy through the posterior capsulorrhexis prior to IOL placement"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "postoperative medical management",
          "children": [
            {
              "label": "postoperative use of nonsteroidal anti- inflammatory drugs (NSAIDs) has not been studied in eyes with uveitis",
              "children": [
                {
                  "label": "corneal toxicity from topical NSAIDs used concurrently with topical corticosteroids is a concern"
                }
              ]
            },
            {
              "label": "immunomodulation is continued"
            },
            {
              "label": "liberal use of topical corticosteroids (slowly tapered)"
            }
          ]
        },
        {
          "label": "phacoemulsification with posterior chamber (in-the-bag) IOL implantation effectively improves vision and is well tolerated",
          "children": [
            {
              "label": "75% of patients will obtain a visual acuity >20/40"
            },
            {
              "label": "other types of uveitis can be more problematic",
              "children": [
                {
                  "label": "excellent surgical and visual results have been reported for Fuchs heterochromic uveitis"
                },
                {
                  "label": "greater risk for postoperative complications than nonuveitic eyes"
                }
              ]
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "postoperative CME",
              "children": [
                {
                  "label": "incidence may be reduced through",
                  "children": [
                    {
                      "label": "use of perioperative corticosteroids"
                    },
                    {
                      "label": "delay of surgery until the uveitis has been controlled for at least 3 months"
                    }
                  ]
                }
              ]
            },
            {
              "label": "recurrence or exacerbation of uveitis"
            },
            {
              "label": "posterior capsule opacification",
              "children": [
                {
                  "label": "higher incidence in uveitic than nonuveitic eyes"
                },
                {
                  "label": "earlier use of Nd:YAG laser capsulotomy"
                }
              ]
            },
            {
              "label": "membrane formation on the surface of the IOL",
              "children": [
                {
                  "label": "strict control of inflammation remains paramount to reducing the chance of these deposits",
                  "children": [
                    {
                      "label": "long-term administration of topical corticosteroids may be necessary"
                    }
                  ]
                },
                {
                  "label": "IOL explantation in 5%–10% of patients",
                  "children": [
                    {
                      "label": "inflammatory cocooning of the IOL–lens capsule complex"
                    },
                    {
                      "label": "uncontrolled inflammation"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Hypotony",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "acute inflammation",
              "children": [
                {
                  "label": "aqueous hyposecretion"
                }
              ]
            },
            {
              "label": "chronic inflammation",
              "children": [
                {
                  "label": "ciliary body damage and atrophy of the ciliary processes",
                  "children": [
                    {
                      "label": "permanent hypotony"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "serous choroidal detachment accompanies hypotony"
        },
        {
          "label": "prolonged choroidal effusions may require surgical drainage"
        },
        {
          "label": "management",
          "children": [
            {
              "label": "if ciliary processes are preserved",
              "children": [
                {
                  "label": "surgical release of ciliary body traction from a cyclitic membrane"
                }
              ]
            },
            {
              "label": "If ciliary processes are atrophic",
              "children": [
                {
                  "label": "± visual improvement",
                  "children": [
                    {
                      "label": "vitrectomy with intraocular silicone oil or viscoelastic"
                    },
                    {
                      "label": "may be transient"
                    }
                  ]
                },
                {
                  "label": "hypotony recurs in nearly 1/2 of eyes",
                  "children": [
                    {
                      "label": "requiring reinjection of silicone oil 1-3 times/ year"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
