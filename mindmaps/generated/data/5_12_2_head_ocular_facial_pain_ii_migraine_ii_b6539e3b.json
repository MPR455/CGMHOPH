          "label": "indications for additional evaluation",
          "children": [
            {
              "label": "headache or aura always occurring on the same side",
              "children": [
                {
                  "label": "most patients with headaches that always occur on the same side of the head are also likely to have migraine"
                }
              ]
            },
            {
              "label": "headache preceding the aura"
            },
            {
              "label": "neurologic deficit, including visual field defect, persisting after aura resolves",
              "children": [
                {
