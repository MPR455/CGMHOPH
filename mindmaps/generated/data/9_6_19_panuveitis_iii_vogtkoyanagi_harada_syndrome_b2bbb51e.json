{
  "label": "9.6.19. Panuveitis (III): Vogt- Koyanagi-Harada Syndrome",
  "root": true,
  "children": [
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "affects certain ethnic groups",
          "children": [
            {
              "label": "Asian"
            },
            {
              "label": "Asian Indian"
            },
            {
              "label": "Hispanic"
            },
            {
              "label": "Native American"
            },
            {
              "label": "Middle Eastern"
            },
            {
              "label": "uncommon among whites"
            },
            {
              "label": "rare among sub-Saharan Africans"
            }
          ]
        },
        {
          "label": "incidence varies geographically",
          "children": [
            {
              "label": "up to 4% of all uveitis referrals in United States"
            },
            {
              "label": "up to 8% of all uveitis referrals in Japan"
            },
            {
              "label": "the most common cause of noninfectious uveitis in Brazil and Saudi Arabia"
            }
          ]
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "cell-mediated autoimmune process",
          "children": [
            {
              "label": "T lymphocytes directed against self-antigens associated with melanocytes of all organ systems"
            }
          ]
        },
        {
          "label": "genetic predisposition",
          "children": [
            {
              "label": "HLA-DR4 among Japanese patients",
              "children": [
                {
                  "label": "HLA-DRB*0405",
                  "children": [
                    {
                      "label": "in Japanese patients"
                    }
                  ]
                }
              ]
            },
            {
              "label": "HLA-DR1 or HLA-DR4 among Hispanic patients from southern California"
            }
          ]
        }
      ]
    },
    {
      "label": "pathology",
      "children": [
        {
          "label": "acute uveitic stage",
          "children": [
            {
              "label": "diffuse, nonnecrotizing, granulomatous inflammation",
              "children": [
                {
                  "label": "lymphocytes and macrophages admixed with epithelioid and multinucleate giant cells"
                },
                {
                  "label": "peripapillary choroid is the predominant site of the granulomatous inflammatory infiltration",
                  "children": [
                    {
                      "label": "ciliary body"
                    },
                    {
                      "label": "iris",
                      "children": [
                        {
                          "label": "identical to that seen in SO"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "proteinaceous fluid exudates in the subretinal space"
            }
          ]
        },
        {
          "label": "unlike acute uveitic and chronic recurrent stages"
        },
        {
          "label": "convalescent stage",
          "children": [
            {
              "label": "nongranulomatous inflammation",
              "children": [
                {
                  "label": "uveal infiltration of lymphocytes, few plasma cells, and the absence of epithelioid histiocytes"
                }
              ]
            },
            {
              "label": "number of choroidal melanocytes decreases with loss of melanin pigment",
              "children": [
                {
                  "label": "sunset-glow fundus"
                }
              ]
            },
            {
              "label": "focal loss of RPE cells with chorioretinal adhesions",
              "children": [
                {
                  "label": "nummular chorioretinal scars in the peripheral retina"
                }
              ]
            }
          ]
        },
        {
          "label": "chronic recurrent stage",
          "children": [
            {
              "label": "granulomatous choroiditis with damage to the choriocapillaris",
              "children": [
                {
                  "label": "preservation of the choriocapillaris"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "30%"
    },
    {
      "label": "essential diagnostic features of VKH syndrome",
      "children": [
        {
          "label": "bilateral involvement"
        },
        {
          "label": "no history of penetrating ocular trauma"
        },
        {
          "label": "no evidence of other ocular or systemic disease"
        },
        {
          "label": "exudative retinal detachment during the acute phase",
          "children": [
            {
              "label": "highly specific"
            }
          ]
        },
        {
          "label": "See Table 6-3",
          "children": [
            {
              "label": "sunset-glow fundus during the chronic phase",
              "children": [
                {
                  "label": "highly specific"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "SO, uveal effusion syndrome, posterior scleritis, primary intraocular lymphoma, uveal lymphoid infiltration, APMPPE, and sarcoidosis"
        }
      ]
    },
    {
      "label": "several weeks later"
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "bilateral",
          "children": [
            {
              "label": "Similar to APMPPE & MEWDS"
            }
          ]
        },
        {
          "label": "4 stages",
          "children": [
            {
              "label": "prodromal",
              "children": [
                {
                  "label": "flulike symptoms",
                  "children": [
                    {
                      "label": "headache, nausea, meningismus, dysacusia, tinnitus, fever, orbital pain, photophobia, and hypersensitivity of the skin and hair to touch"
                    },
                    {
                      "label": "several days preceding the ocular symptoms"
                    }
                  ]
                },
                {
                  "label": "focal neurologic signs",
                  "children": [
                    {
                      "label": "rare"
                    },
                    {
                      "label": "cranial neuropathies"
                    },
                    {
                      "label": "hemiparesis"
                    },
                    {
                      "label": "aphasia"
                    },
                    {
                      "label": "transverse myelitis"
                    },
                    {
                      "label": "ganglionitis"
                    },
                    {
                      "label": "cerebrospinal fluid analysis",
                      "children": [
                        {
                          "label": "lymphocytic pleocytosis",
                          "children": [
                            {
                              "label": "80%"
                            },
                            {
                              "label": "may persist for up to 8 weeks"
                            }
                          ]
                        },
                        {
                          "label": "normal levels of glucose"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "auditory problems",
                  "children": [
                    {
                      "label": "coincident with the onset of ocular disease",
                      "children": [
                        {
                          "label": "central dysacusia involving higher frequencies or tinnitus",
                          "children": [
                            {
                              "label": "early in the disease course"
                            },
                            {
                              "label": "improve within 2–3 months"
                            },
                            {
                              "label": "persistent deficits may remain"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "75%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "acute uveitic",
              "children": [
                {
                  "label": "sequential blurring of vision in both eyes",
                  "children": [
                    {
                      "label": "1–2 days after the onset of CNS signs"
                    }
                  ]
                },
                {
                  "label": "granulomatous anterior uveitis",
                  "children": [
                    {
                      "label": "bilateral"
                    },
                    {
                      "label": "IOP may be elevated",
                      "children": [
                        {
                          "label": "forward displacement of the lens–iris diaphragm",
                          "children": [
                            {
                              "label": "ciliary body edema"
                            },
                            {
                              "label": "annular choroidal detachment"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "IOP may be low",
                      "children": [
                        {
                          "label": "secondary to ciliary body shutdown"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "posterior segment findings",
                  "children": [
                    {
                      "label": "variable degree of vitritis"
                    },
                    {
                      "label": "hyperemia & edema of the optic nerve",
                      "children": [
                        {
                          "label": "thickening of the posterior choroid with elevation of the peripapillary retinal choroidal layer"
                        }
                      ]
                    },
                    {
                      "label": "multiple focal serous retinal detachments",
                      "children": [
                        {
                          "label": "shallow"
                        },
                        {
                          "label": "cloverleaf pattern around the posterior pole"
                        },
                        {
                          "label": "may coalesce into large, bullous, exudative detachments"
                        }
                      ]
                    },
                    {
                      "label": "profound vision loss may occur"
                    }
                  ]
                }
              ]
            },
            {
              "label": "convalescent",
              "children": [
                {
                  "label": "resolution of the exudative retinal detachment"
                },
                {
                  "label": "gradual depigmentation of the choroid",
                  "children": [
                    {
                      "label": "orange-red discoloration",
                      "children": [
                        {
                          "label": "sunset-glow fundus"
                        },
                        {
                          "label": "sunset-glow fundus may show focal areas of retinal hyperpigmentation or hypopigmentation"
                        }
                      ]
                    },
                    {
                      "label": "juxtapapillary depigmentation"
                    }
                  ]
                },
                {
                  "label": "small, round, discrete depigmented lesions",
                  "children": [
                    {
                      "label": "inferior peripheral fundus"
                    }
                  ]
                },
                {
                  "label": "perilimbal vitiligo (Sugiura sign)",
                  "children": [
                    {
                      "label": "85% of Japanese patients"
                    }
                  ]
                },
                {
                  "label": "integumentary changes",
                  "children": [
                    {
                      "label": "30%",
                      "children": [
                        {
                          "label": "occur weeks to months after the onset of ocular inflammation (during the convalescent stage)"
                        }
                      ]
                    },
                    {
                      "label": "correspond with the development of fundus depigmentation"
                    },
                    {
                      "label": "vitiligo"
                    },
                    {
                      "label": "alopecia"
                    },
                    {
                      "label": "poliosis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "chronic recurrent",
              "children": [
                {
                  "label": "repeated bouts of granulomatous anterior uveitis",
                  "children": [
                    {
                      "label": "KPs, posterior synechiae, iris nodules, iris depigmentation, and stromal atrophy"
                    },
                    {
                      "label": "may occur concomitantly with subclinical choroidal inflammation, requiring systemic therapy"
                    }
                  ]
                },
                {
                  "label": "posterior segment recurrences",
                  "children": [
                    {
                      "label": "vitritis, papillitis, multifocal choroiditis, and exudative retinal detachment"
                    },
                    {
                      "label": "uncommon"
                    }
                  ]
                },
                {
                  "label": "complications",
                  "children": [
                    {
                      "label": "cataract formation (50%)",
                      "children": [
                        {
                          "label": "posterior subcapsular cataract"
                        }
                      ]
                    },
                    {
                      "label": "glaucoma (33%)"
                    },
                    {
                      "label": "CNV (≤15%)"
                    },
                    {
                      "label": "subretinal fibrosis"
                    },
                    {
                      "label": "associated with",
                      "children": [
                        {
                          "label": "increased disease duration"
                        },
                        {
                          "label": "more frequent recurrences"
                        },
                        {
                          "label": "an older age at disease onset"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical course",
          "children": [
            {
              "label": "chronic"
            },
            {
              "label": "many patients experience recurrent episodes of inflammation"
            }
          ]
        }
      ]
    },
    {
      "label": "diagnostic tests",
      "children": [
        {
          "label": "FA",
          "children": [
            {
              "label": "acute uveitic stage",
              "children": [
                {
                  "label": "pooling of dye in the subretinal space in areas of neurosensory detachment",
                  "children": [
                    {
                      "label": "numerous punctate hyperfluorescent foci at the level of the RPE"
                    }
                  ]
                },
                {
                  "label": "disc leakage"
                },
                {
                  "label": "CME and retinal vascular leakage are uncommon"
                }
              ]
            },
            {
              "label": "convalescent and chronic recurrent stages",
              "children": [
                {
                  "label": "focal RPE loss and atrophy produce multiple hyperfluorescent window defects"
                }
              ]
            }
          ]
        },
        {
          "label": "ICG angiography",
          "children": [
            {
              "label": "delay in choriocapillaris and choroidal vessel perfusion"
            },
            {
              "label": "early choroidal stromal vessel hyperfluorescence and leakage"
            },
            {
              "label": "disc hyperfluorescence"
            },
            {
              "label": "multiple hypofluorescent spots throughout the fundus",
              "children": [
                {
                  "label": "may be present even when the funduscopic and FA findings are unremarkable"
                },
                {
                  "label": "sensitive markers for the detection and monitoring of subclinical choroidal inflammation"
                }
              ]
            },
            {
              "label": "hyperfluorescent pinpoint changes within areas of exudative retinal detachment"
            }
          ]
        },
        {
          "label": "ultrasonography",
          "children": [
            {
              "label": "exudative retinal detachment",
              "children": [
                {
                  "label": "diffuse, low to medium reflective thickening of the posterior choroid",
                  "children": [
                    {
                      "label": "most prominent in the peripapillary area, with extension to the equatorial region"
                    }
                  ]
                }
              ]
            },
            {
              "label": "vitreous opacification"
            },
            {
              "label": "posterior thickening of the sclera"
            }
          ]
        },
        {
          "label": "OCT",
          "children": [
            {
              "label": "serous macular detachments",
              "children": [
                {
                  "label": "fibrin bands extending from the retina to the RPE (acute phase)"
                }
              ]
            },
            {
              "label": "SD-OCT",
              "children": [
                {
                  "label": "choroidal thickening in the acute phase",
                  "children": [
                    {
                      "label": "decreases with treatment"
                    }
                  ]
                }
              ]
            },
            {
              "label": "CME"
            },
            {
              "label": "choroidal neovascular membrane"
            }
          ]
        },
        {
          "label": "FAF imaging",
          "children": [
            {
              "label": "granular hyperautofluorescence in areas of inflammation"
            }
          ]
        },
        {
          "label": "lumbar puncture",
          "children": [
            {
              "label": "in highly atypical cases",
              "children": [
                {
                  "label": "lymphocytic pleocytosis",
                  "children": [
                    {
                      "label": "prominent neurologic signs and a paucity of ocular findings"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "acute stage",
          "children": [
            {
              "label": "early and aggressive treatment with corticosteroids",
              "children": [
                {
                  "label": "1–1.5 mg/kg/day of oral prednisone"
                },
                {
                  "label": "intravitreal corticosteroids",
                  "children": [
                    {
                      "label": "≤1 g of intravenous methylprednisolone daily x3 days followed by high-dose oral corticosteroids"
                    },
                    {
                      "label": "patients intolerant of systemic therapy"
                    }
                  ]
                },
                {
                  "label": "systemic corticosteroids are tapered slowly according to the clinical response, on average over a 6–12 month period",
                  "children": [
                    {
                      "label": "tapering corticosteroids too soon can result in early recurrence"
                    }
                  ]
                },
                {
                  "label": "oral corticosteroids reduce",
                  "children": [
                    {
                      "label": "risk of CNV and subretinal fibrosis by 82%"
                    },
                    {
                      "label": "risk of visual acuity decline to 20/200 or worse in better-seeing eyes by 67%"
                    }
                  ]
                },
                {
                  "label": "oral versus intravenous routes of administration show no differences in outcome"
                }
              ]
            },
            {
              "label": "IMT",
              "children": [
                {
                  "label": "to achieve more prompt inflammatory control and to facilitate more rapid tapering of corticosteroids"
                },
                {
                  "label": "IMT was associated with",
                  "children": [
                    {
                      "label": "risk reductions of 67% for vision loss to 20/50 or worse"
                    },
                    {
                      "label": "risk reductions of 92% for vision loss to 20/200 or worse in better-seeing eyes"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "overall visual prognosis with treatment is fair",
          "children": [
            {
              "label": "up to 70% of patients retaining visual acuity of ≥20/40"
            }
          ]
        }
      ]
    }
