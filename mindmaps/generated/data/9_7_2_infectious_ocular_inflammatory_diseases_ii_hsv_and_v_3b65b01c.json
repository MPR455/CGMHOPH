{
  "label": "9.7.2. Infectious Ocular Inflammatory Diseases (II): HSV and VZV (II): Anterior Uveitis",
  "root": true,
  "children": [
    {
      "label": "general",
      "children": [
        {
          "label": "+- keratitis (keratouveitis)",
          "children": [
            {
              "label": "+- diffuse or localized decreased corneal sensation",
              "children": [
                {
                  "label": "neurotrophic keratitis"
                }
              ]
            }
          ]
        },
        {
          "label": "the inflammation may become chronic",
          "children": [
            {
              "label": "VZV infection should be considered in the differential diagnosis of chronic unilateral anterior uveitis, even if the",
              "children": [
                {
                  "label": "cutaneous component occurred in the past"
                },
                {
                  "label": "cutaneous component was minimal"
                },
                {
                  "label": "cutaneous component was absent (varicella- zoster sine herpete)"
                }
              ]
            }
          ]
        },
        {
          "label": "chickenpox (varicella)",
          "children": [
            {
              "label": "acute, mild, nongranulomatous, self-limiting, and bilateral anterior uveitis"
            },
            {
              "label": "≤40% of patients with primary VZV infection may develop anterior uveitis"
            }
          ]
        },
        {
          "label": "herpes zoster cutaneous vesicles at the tip of the nose (Hutchinson sign)",
          "children": [
            {
              "label": "indicate nasociliary nerve involvement and a greater likelihood that the eye will be affected"
            }
          ]
        },
        {
          "label": "vasculitis",
          "children": [
            {
              "label": "with herpes-zoster ophthalmicus"
            },
            {
              "label": "may lead to",
              "children": [
                {
                  "label": "anterior segment ischemia"
                },
                {
                  "label": "scleritis"
                },
                {
                  "label": "vasculitis in the orbit gives rise to cranial nerve palsies"
                },
                {
                  "label": "retinal artery occlusion"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "topical corticosteroids and cycloplegic agents",
          "children": [
            {
              "label": "may require prolonged corticosteroid therapy with very gradual tapering"
            },
            {
              "label": "some patients with VZV infection require very long-term, albeit extremely low, doses of topical corticosteroids (as infrequent as 1 drop per week)"
            }
          ]
        },
        {
          "label": "topical antiviral drugs",
          "children": [
            {
              "label": "usually ineffective for herpetic uveitis"
            }
          ]
        },
        {
          "label": "systemic antiviral drugs",
          "children": [
            {
              "label": "acyclovir (400–800 mg, 5 times/day)",
              "children": [
                {
                  "label": "may be indicated in patients with herpes simplex keratouveitis to prevent dendritic keratitis as a complication of topical corticosteroid therapy"
                }
              ]
            },
            {
              "label": "famciclovir (250–500 mg, 3 times/day)"
            },
            {
              "label": "valacyclovir (500 mg to 1 g, 3 times/day)"
            },
            {
              "label": "higher doses used for VZV uveitis",
              "children": [
                {
                  "label": "often beneficial in intraocular inflammation associated with HSV or VZV uveitis"
                },
                {
                  "label": "initiation of oral antiviral therapy at the onset of VZV uveitis is recommended"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic corticosteroids are sometimes necessary"
        },
        {
          "label": "long-term, suppressive, low-dose antiviral therapy",
          "children": [
            {
              "label": "may be indicated in patients with herpetic uveitis, but controlled studies are lacking"
            },
            {
              "label": "oral prophylactic dosages",
              "children": [
                {
                  "label": "HSV",
                  "children": [
                    {
                      "label": "acyclovir, 400 mg 2 times/day"
                    },
                    {
                      "label": "valacyclovir, 500 mg/day"
                    }
                  ]
                },
                {
                  "label": "VZV",
                  "children": [
                    {
                      "label": "acyclovir, 800 mg 2 times/day"
                    },
                    {
                      "label": "valacyclovir, 1 g/day"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
