              "label": "distinctly stellate pattern"
            },
            {
              "label": "diffuse distribution"
            },
            {
              "label": "fine and fibrillar"
            },
            {
              "label": "viral infections particularly herpes group viruses"
            },
            {
              "label": "also present in Fuchs heterochromic uveitis"
            },
            {
              "label": "not diagnostic of any particular condition!"
            }
          ]
        },
        {
          "label": "ocular hypertension",
          "children": [
            {
