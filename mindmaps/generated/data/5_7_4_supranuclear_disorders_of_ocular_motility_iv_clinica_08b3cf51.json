        {
          "label": "Gaze preference",
          "children": [
            {
              "label": "acute inability to produce gaze contralateral to the side of a cerebral (supranuclear) lesion",
              "children": [
                {
                  "label": "associated with tendency for tonic deviation of the eyes toward the side of the lesion"
                },
                {
                  "label": "stroke",
                  "children": [
                    {
                      "label": "doll’s head maneuver generates a full range of horizontal eye movements"
                    },
                    {
                      "label": "most common etiology"
                    }
                  ]
                },
                {
                  "label": "temporary",
                  "children": [
                    {
                      "label": "only days or weeks"
