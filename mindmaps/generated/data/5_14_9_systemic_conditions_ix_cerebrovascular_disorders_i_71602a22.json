      "label": "clinical presentation",
      "children": [
        {
          "label": "ocular motor and visual symptoms are prominent",
          "children": [
            {
              "label": "supplies",
              "children": [
                {
                  "label": "occipital cortex"
                },
                {
                  "label": "brainstem"
                }
              ]
            },
            {
              "label": "cerebellum"
            }
          ]
        },
        {
          "label": "visual symptoms",
          "children": [
            {
              "label": "almost as frequently as vertigo"
            },
            {
              "label": "alone or in combination with the other symptoms of vertebrobasilar insufficiency"
            },
            {
              "label": "seconds to minutes",
              "children": [
                {
                  "label": "sudden bilateral blurring/dimming/graying/ whiting out of vision"
                }
              ]
            },
            {
              "label": "repetitive"
            },
            {
              "label": "± flickering or flashing stars"
            },
            {
              "label": "± photopsia",
              "children": [
                {
                  "label": "closely mimicking the scintillating scotomata of migraine"
                }
              ]
            },
            {
              "label": "migraine can produce similar symptoms, with or without an associated headache"
            },
            {
              "label": "visual field changes",
              "children": [
                {
                  "label": "homonymous visual field changes without other neurologic symptoms suggest involvement of the posterior circulation"
                },
                {
                  "label": "highly congruous homonymous visual field defects without other symptoms are typical of occipital lobe infarcts"
                }
              ]
            },
            {
              "label": "cortical blindness",
