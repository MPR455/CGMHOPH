              "label": "nyctalopia"
            },
            {
              "label": "waxy disc pallor"
            },
            {
              "label": "attenuation of arterioles"
            },
            {
              "label": "bone-spicule pattern of pigmentary changes"
            },
            {
              "label": "ERG",
              "children": [
                {
                  "label": "severely depressed/extinguished in RP"
                }
              ]
            },
            {
              "label": "can be found in late posterior uveitis!"
            }
          ]
        }
      ]
    },
    {
      "label": "Infectious Uveitic Entities",
      "children": [
        {
          "label": "bacterial uveitis",
