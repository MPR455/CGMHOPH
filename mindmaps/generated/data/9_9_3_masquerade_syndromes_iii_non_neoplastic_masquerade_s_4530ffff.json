            }
          ]
        }
      ]
    },
    {
      "label": "cataract"
    },
    {
      "label": "Pigment Dispersion Syndrome",
      "children": [
        {
          "label": "pigment granules released from the iris, ciliary body, or both",
          "children": [
            {
              "label": "floating in the anterior chamber"
            },
            {
              "label": "may be confused with the cells of anterior uveitis"
            }
          ]
        }
      ]
    },
    {
      "label": "Ocular Ischemic Syndrome",
      "children": [
        {
          "label": "hypoperfusion of the entire eye",
          "children": [
            {
              "label": "secondary to carotid artery obstruction"
            }
          ]
        },
        {
          "label": "men >65 years"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "decreased vision",
                  "children": [
                    {
                      "label": "mild ocular pain"
                    }
                  ]
                },
                {
                  "label": "corneal edema"
                }
              ]
            },
            {
              "label": "anterior chamber cells"
            },
            {
              "label": "anterior chamber moderate flare",
              "children": [
                {
                  "label": "greater than and out of proportion to number of cells"
                }
              ]
            },
            {
              "label": "iris neovascularization"
            },
            {
              "label": "IOP may be",
              "children": [
                {
                  "label": "low from decreased aqueous production"
                },
                {
                  "label": "high due to neovascular glaucoma"
                }
              ]
            },
            {
              "label": "vitreous is usually clear"
            },
            {
              "label": "mild disc edema"
            },
            {
              "label": "dilated tortuous retinal venules, narrowed arterioles"
            },
            {
              "label": "NVD/NVE",
              "children": [
                {
                  "label": "medium-large intraretinal scattered blot hemorrhages",
                  "children": [
                    {
                      "label": "in the midperiphery and far periphery"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "FA",
              "children": [
                {
                  "label": "delayed arteriolar filling"
                },
                {
                  "label": "diffuse leakage from optic disc and posterior pole"
                },
                {
                  "label": "signs of capillary nonperfusion"
                },
                {
                  "label": "retinal vascular staining"
                }
              ]
            },
            {
              "label": "carotid Doppler ultrasonography",
              "children": [
                {
                  "label": "ipsilateral carotid stenosis > 90%",
                  "children": [
                    {
                      "label": "in the absence of vascular sheathing on examination"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "definitive treatment",
              "children": [
                {
                  "label": "carotid endarterectomy"
                }
              ]
            },
            {
              "label": "local treatment",
              "children": [
                {
                  "label": "topical corticosteroids and cycloplegics"
                },
                {
                  "label": "panretinal photocoagulation",
                  "children": [
                    {
                      "label": "especially if NVI or NVE/NVD is present"
                    }
                  ]
                },
                {
                  "label": "Intraocular injection of VEGF inhibitors"
                }
              ]
            }
          ]
        },
        {
          "label": "prognosis",
          "children": [
            {
              "label": "5-year mortality rate",
              "children": [
                {
                  "label": "40%",
                  "children": [
                    {
                      "label": "from cardiovascular disease and myocardial infarction"
                    }
                  ]
                }
              ]
            },
            {
              "label": "visual prognosis is guarded",
              "children": [
                {
                  "label": "many patients improve transiently with treatment but eventually worsen"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Intraocular Foreign Bodies",
