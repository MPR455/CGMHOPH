    {
      "label": "Treatment",
      "children": [
        {
          "label": "if visually not significant",
          "children": [
            {
              "label": "<3 mm",
              "children": [
                {
                  "label": "observation"
                },
                {
                  "label": "dilating drops",
                  "children": [
                    {
                      "label": "temporizing vs. definite rx for small cataracts"
                    }
                  ]
                },
                {
                  "label": "treat amblyopia"
                }
              ]
            }
          ]
        },
        {
          "label": "if visually significant",
          "children": [
            {
              "label": "small unilateral cataracts may still result in amblyopia"
            },
            {
              "label": ".>3 mm",
              "children": [
                {
                  "label": "cataract surgery",
                  "children": [
                    {
                      "label": "within days to weeks"
                    },
                    {
                      "label": "+primary posterior capsulotomy",
                      "children": [
                        {
                          "label": "+anterior vitrectomy"
                        }
                      ]
                    },
                    {
                      "label": "refractive rehabilitation",
                      "children": [
                        {
                          "label": "no IOL for children <6 mo of age",
                          "children": [
                            {
                              "label": "spectacles"
                            },
                            {
                              "label": "aphakic contact lens"
                            },
                            {
                              "label": "IOL later in life"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
