                  "label": "frontalis suspension procedures"
                },
                {
                  "label": "± necessary early in life"
                }
              ]
            },
            {
              "label": "epicanthus and telecanthus may improve with age",
              "children": [
                {
                  "label": "repair is often delayed"
                }
              ]
            }
          ]
        }
      ]
