{
  "label": "6.17.2. Eyelid Disorders (II): Congenital Eyelid Disorders (II)",
  "root": true,
  "children": [
    {
      "label": "Distichiasis",
      "children": [
        {
          "label": "partial or complete accessory row of eyelashes growing out of or slightly posterior to the meibomian gland orifices"
        },
        {
          "label": "abnormal lashes tend to be thinner, shorter, softer, and less pigmented"
        },
        {
          "label": "often well tolerated"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "if corneal irritation is present"
            }
          ]
        }
      ]
    },
    {
      "label": "Marcus Gunn Jaw-Winking Syndrome",
      "children": [
        {
          "label": "congenital synkinesis of jaw and levator muscles"
        },
        {
          "label": "ptotic eyelid elevates with",
          "children": [
            {
              "label": "opening of mouth"
            },
            {
              "label": "movement of jaw to contralateral side"
            }
          ]
        },
        {
          "label": "test an infant by having him/her suck on a bottle or pacifier"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "simple ptosis repair"
            },
            {
              "label": "combination of disinsertion of the levator muscle and frontalis suspension",
              "children": [
                {
                  "label": "frontalis suspension may also be performed on the normal eyelid to achieve a more symmetric appearance"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Euryblepharon",
      "children": [
        {
          "label": "± associated with BPES"
        },
        {
          "label": "± associated with Kabuki syndrome"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "vertical shortening + horizontal lengthening of the involved eyelids",
              "children": [
                {
                  "label": "lateral portion of the lower eyelid (eyelids) is typically more involved",
                  "children": [
                    {
                      "label": "downward displacement of the temporal half of the lower eyelid",
                      "children": [
                        {
                          "label": "gives the appearance of a very wide palpebral fissure or a droopy lower eyelid"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "inferiorly displaced lateral canthal tendon",
              "children": [
                {
                  "label": "palpebral fissure often has a downward slant"
                }
              ]
            },
            {
              "label": "impaired blinking"
            },
            {
              "label": "poor closure"
            },
            {
              "label": "lagophthalmos"
            },
            {
              "label": "exposure keratitis"
            }
          ]
        },
        {
          "label": "surgial reconstruction",
          "children": [
            {
              "label": "if symptomatic"
            },
            {
              "label": "lateral canthal repositioning"
            },
            {
              "label": "suspension of suborbicularis oculi fat to lateral orbital rim to support lower eyelid"
            },
            {
              "label": "lateral tarsal strip or eyelid margin resection",
              "children": [
                {
                  "label": "for excess horizontal length"
                }
              ]
            },
            {
              "label": "± skin grafts"
            }
          ]
        }
      ]
    },
    {
      "label": "Epicanthus",
      "children": [
        {
          "label": "crescent-shaped fold of skin running vertically between the eyelids and overlying the inner canthus"
        },
        {
          "label": "4 types",
          "children": [
            {
              "label": "epicanthus tarsalis: fold is most prominent in the upper eyelid"
            },
            {
              "label": "epicanthus palpebralis: fold is equally distributed between the upper and lower eyelids"
            },
            {
              "label": "epicanthus supraciliaris: fold arises from the eyebrow and terminates over the lacrimal sac"
            }
          ]
        },
        {
          "label": "associations",
          "children": [
            {
              "label": "isolated"
            },
            {
              "label": "blepharophimosis",
              "children": [
                {
                  "label": "epicanthus inversus: fold is most prominent in the lower eyelid"
                }
              ]
            },
            {
              "label": "ptosis"
            }
          ]
        },
        {
          "label": "surgical correction",
          "children": [
            {
              "label": "occasionally required"
            }
          ]
        }
      ]
    },
    {
      "label": "Congenital Ptosis",
      "children": [
        {
          "label": "classification of ptosis",
          "children": [
            {
              "label": "pseudoptosis"
            },
            {
              "label": "congenital ptosis"
            },
            {
              "label": "acquired ptosis",
              "children": [
                {
                  "label": "myogenic",
                  "children": [
                    {
                      "label": "myasthenia gravis"
                    },
                    {
                      "label": "progressive external ophthalmoplegia"
                    }
                  ]
                },
                {
                  "label": "neurogenic",
                  "children": [
                    {
                      "label": "Horner syndrome"
                    },
                    {
                      "label": "3rd nerve palsy"
                    }
                  ]
                },
                {
                  "label": "mechanical"
                }
              ]
            }
          ]
        },
        {
          "label": "associations",
          "children": [
            {
              "label": "anisometropic amblyopia"
            },
            {
              "label": "strabismus"
            }
          ]
        },
        {
          "label": "evaluation",
          "children": [
            {
              "label": "pseudoptosis",
              "children": [
                {
                  "label": "microphthalmia"
                },
                {
                  "label": "hypotropia"
                }
              ]
            },
            {
              "label": "upper eyelid crease",
              "children": [
                {
                  "label": "in severe congenital ptosis eyelid crease is usually absent"
                }
              ]
            },
            {
              "label": "amount of ptosis",
              "children": [
                {
                  "label": "palpebral fissure height"
                },
                {
                  "label": "margin–reflex distance (MRD)",
                  "children": [
                    {
                      "label": "distance from the margin of the upper eyelid to the corneal light reflex when the eye is in primary gaze"
                    }
                  ]
                }
              ]
            },
            {
              "label": "function of levator muscle",
              "children": [
                {
                  "label": "applying finger pressure on the brow to block the frontalis muscle"
                },
                {
                  "label": "measuring the distance that upper eyelid moves when patient shifts from downgaze to upgaze"
                }
              ]
            },
            {
              "label": "tear function"
            },
            {
              "label": "corneal sensitivity"
            },
            {
              "label": "Bell phenomenon",
              "children": [
                {
                  "label": "Ii the Bell phenomenon is poor, the cornea can decompensate after ptosis repair"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "mild or moderate ptosis",
              "children": [
                {
                  "label": "treatment usually delayed until patient is several years old"
                },
                {
                  "label": "compensatory chin-up head posture may justify earlier surgery"
                }
              ]
            },
            {
              "label": "marked ptosis",
              "children": [
                {
                  "label": "obstructs vision"
                },
                {
                  "label": "must be corrected early in infancy to prevent deprivation amblyopia"
                }
              ]
            },
            {
              "label": "surgical techniques",
              "children": [
                {
                  "label": "external levator muscle resection"
                },
                {
                  "label": "levator aponeurosis tuck"
                },
                {
                  "label": "frontalis suspension",
                  "children": [
                    {
                      "label": "when levator muscle function is <4 mm"
                    }
                  ]
                }
              ]
            },
            {
              "label": "materials for suspension",
              "children": [
                {
                  "label": "autologous fascia lata",
                  "children": [
                    {
                      "label": "cannot be obtained until the patient is 3 or 4 years old"
                    }
                  ]
                },
                {
                  "label": "human donor fascia lata"
                },
                {
                  "label": "synthetic material such as silicone rods"
                },
                {
                  "label": "use of synthetic material or donor fascia lata may lead to higher recurrence rates"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Palpebral Fissure Slants",
      "children": [
        {
          "label": "normally lateral canthus is ≈ 1 mm higher than medial canthus"
        },
        {
          "label": "certain craniofacial syndromes frequently cause palpebral fissures to have a characteristic upward or downward slant"
        },
        {
          "label": "Treacher Collins syndrome",
          "children": [
            {
              "label": "downward slant"
            }
          ]
        },
        {
          "label": "euryblepharon",
          "children": [
            {
              "label": "inferiorly displaced lateral canthal tendon",
              "children": [
                {
                  "label": "palpebral fissure often has a downward slant"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Blepharophimosis–Ptosis–Epicanthus Inversus Syndrome",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "blepharophimosis",
              "children": [
                {
                  "label": "palpebral fissures are shortened horizontally and vertically"
                },
                {
                  "label": "horizontal palpebral fissure length",
                  "children": [
                    {
                      "label": "18–22 mm",
                      "children": [
                        {
                          "label": "normally 25–30 mm"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "epicanthus inversus"
            },
            {
              "label": "telecanthus"
            },
            {
              "label": "ptosis",
              "children": [
                {
                  "label": "poor levator muscle function"
                },
                {
                  "label": "no eyelid fold"
                }
              ]
            }
          ]
        },
        {
          "label": "genetics",
          "children": [
            {
              "label": "sporadic"
            },
            {
              "label": "autosomal dominant",
              "children": [
                {
                  "label": "FOXL2 gene"
                }
              ]
            }
          ]
        },
        {
          "label": "2 types",
          "children": [
            {
              "label": "type I",
              "children": [
                {
                  "label": "eyelid findings and premature ovarian failure"
                }
              ]
            },
            {
              "label": "type II",
              "children": [
                {
                  "label": "eyelid findings only"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "repair of the ptosis",
              "children": [
