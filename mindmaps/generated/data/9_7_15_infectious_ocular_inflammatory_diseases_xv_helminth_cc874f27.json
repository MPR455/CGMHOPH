{
  "label": "9.7.15. Infectious Ocular Inflammatory Diseases (XV): Helminthic Uveitis (III): DUSN Onchocerciasis",
  "root": true,
  "children": [
    {
      "label": "Diffuse unilateral subacute neuroretinitis (DUSN)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "healthy, young patients",
              "children": [
                {
                  "label": "mean age, 14 years; range, 11–65 years"
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "solitary nematodes of 2 different sizes",
              "children": [
                {
                  "label": "smaller worm",
                  "children": [
                    {
                      "label": "Ancylostoma caninum (the dog hookworm)",
                      "children": [
                        {
                          "label": "(or T canis)"
                        }
                      ]
                    },
                    {
                      "label": "400–1000 μm"
                    }
                  ]
                },
                {
                  "label": "larger worm",
                  "children": [
                    {
                      "label": "1500–2000 μm",
                      "children": [
                        {
                          "label": "Baylisascaris procyonis (the raccoon roundworm)"
                        }
                      ]
                    },
                    {
                      "label": "northern midwestern United States and Canada"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "insidious onset",
              "children": [
                {
                  "label": "recurrent episodes"
                }
              ]
            },
            {
              "label": "unilateral",
              "children": [
                {
                  "label": "rarely bilateral",
                  "children": [
                    {
                      "label": "Similar to Toxocariasis and cystisercosis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "loss of vision"
            },
            {
              "label": "early stages",
              "children": [
                {
                  "label": "moderate to severe vitritis"
                },
                {
                  "label": "optic disc swelling"
                },
                {
                  "label": "multiple, focal, gray-white lesions in the postequatorial fundus",
                  "children": [
                    {
                      "label": "1200 μm to 1500 μm"
                    },
                    {
                      "label": "lesions are evanescent"
                    },
                    {
                      "label": "+- overlying serous retinal detachment"
                    }
                  ]
                },
                {
                  "label": "+- visible worms in the subretinal space"
                }
              ]
            },
            {
              "label": "late stages",
              "children": [
                {
                  "label": "retinal arteriolar narrowing"
                },
                {
                  "label": "optic atrophy"
                },
                {
                  "label": "diffuse pigment epithelial degeneration"
                },
                {
                  "label": "abnormal electroretinographic results"
                }
              ]
            },
            {
              "label": "+- neurologic disease (neural larvae migrans)"
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "early stages",
              "children": [
                {
                  "label": "sarcoidosis-associated uveitis",
                  "children": [
                    {
                      "label": "Similar to cystisercosis"
                    }
                  ]
                },
                {
                  "label": "MCP"
                },
                {
                  "label": "APMPPE"
                },
                {
                  "label": "MEWDS"
                },
                {
                  "label": "serpiginous choroidopathy"
                },
                {
                  "label": "Behçet disease"
                },
                {
                  "label": "OT"
                },
                {
                  "label": "OHS"
                },
                {
                  "label": "nonspecific optic neuritis"
                }
              ]
            },
            {
              "label": "late stages",
              "children": [
                {
                  "label": "posttraumatic chorioretinopathy"
                },
                {
                  "label": "occlusive vascular disease"
                },
                {
                  "label": "toxic retinopathy"
                },
                {
                  "label": "retinitis pigmentosa"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic tests",
          "children": [
            {
              "label": "typical clinical picture",
              "children": [
                {
                  "label": "observation of a worm in the subretinal space!"
                }
              ]
            },
            {
              "label": "ERG abnormalities",
              "children": [
                {
                  "label": "systemic and laboratory evaluations are typically negative"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "direct laser photocoagulation of the worm",
              "children": [
                {
                  "label": "highly effective in halting progression of the disease"
                }
              ]
            },
            {
              "label": "medical therapy with corticosteroids",
              "children": [
                {
                  "label": "transient control of the inflammation",
                  "children": [
                    {
                      "label": "has not been associated with significant exacerbation of inflammation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "antihelminthic therapy",
              "children": [
                {
                  "label": "oral thiabendazole (22 mg/kg twice daily for 2– 4 days with a maximum dose of 3 g)"
                },
                {
                  "label": "oral albendazole (200 mg twice daily for 30 days)",
                  "children": [
                    {
                      "label": "better-tolerated"
                    }
                  ]
                },
                {
                  "label": "indications",
                  "children": [
                    {
                      "label": "DUSN with no visible worm",
                      "children": [
                        {
                          "label": "to maximize the chance of identifying and treating the offending organism",
                          "children": [
                            {
                              "label": "immobilization of the subretinal nematode has been observed after antihelminthic therapy"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "if inflammation does not abate promptly after laser photocoagulation",
                      "children": [
                        {
                          "label": "second nematode (reinfection)?"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Onchocerciasis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "a leading cause of blindness in the world",
              "children": [
                {
                  "label": "worldwide >18 million people are infected"
                },
                {
                  "label": "300,000 are blind"
                }
              ]
            },
            {
              "label": "endemic in",
              "children": [
                {
                  "label": "sub-Saharan Africa"
                },
                {
                  "label": "isolated foci in Central and South America"
                },
                {
                  "label": "in hyperendemic areas everyone >15 years is infected",
                  "children": [
                    {
                      "label": "1/2 will become blind before they die"
                    }
                  ]
                }
              ]
            },
            {
              "label": "rare in the US"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "Onchocerca volvulus",
              "children": [
                {
                  "label": "filarial parasite"
                },
                {
                  "label": "humans are the only host"
                }
              ]
            },
            {
              "label": "female black flies of the Simulium genus",
              "children": [
                {
                  "label": "breed in fast-flowing streams",
                  "children": [
                    {
                      "label": "\"river blindness\""
                    }
                  ]
                },
                {
                  "label": "transmit larvae",
                  "children": [
                    {
                      "label": "develop into mature adult worms that form subcutaneous nodules",
                      "children": [
                        {
                          "label": "adult females release millions of microfilariae",
                          "children": [
                            {
                              "label": "migrate throughout the body particularly to the skin and the eye"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "reach the eye by various routes",
              "children": [
                {
                  "label": "direct invasion of the cornea from the conjunctiva"
                },
                {
                  "label": "penetration of the sclera, both directly and through the vascular bundles"
                },
                {
                  "label": "hematogenous spread (possibly)"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "live microfilariae are usually well tolerated"
            },
            {
              "label": "dead microfilariae initiate a focal inflammatory response"
            },
            {
              "label": "anterior segment signs are common",
              "children": [
                {
                  "label": "live microfilariae in the cornea",
                  "children": [
                    {
                      "label": "microfilariae swimming freely in the anterior chamber"
                    }
                  ]
                },
                {
                  "label": "dead microfilariae cause a small corneal stromal punctate inflammatory opacity",
                  "children": [
                    {
                      "label": "clears with time"
                    }
                  ]
                },
                {
                  "label": "mild uveitis and limbitis"
                },
                {
                  "label": "+- severe anterior uveitis",
                  "children": [
                    {
                      "label": "synechiae"
                    },
                    {
                      "label": "secondary glaucoma"
                    },
                    {
                      "label": "cataract"
                    }
                  ]
                }
              ]
            },
            {
              "label": "posterior segment findings",
              "children": [
                {
                  "label": "RPE disruption"
                },
                {
                  "label": "pigment dispersion and focal areas of atrophy"
                },
                {
                  "label": "severe chorioretinal atrophy",
                  "children": [
                    {
                      "label": "predominantly in the posterior pole"
                    }
                  ]
                },
                {
                  "label": "optic atrophy",
                  "children": [
                    {
                      "label": "common in advanced disease"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "diagnosis",
          "children": [
            {
              "label": "clinical appearance"
            },
            {
              "label": "history of pathogen exposure in an endemic area"
            },
            {
              "label": "finding microfilariae in small skin biopsies or in the eye"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "ivermectin",
              "children": [
                {
                  "label": "single oral dose of 150 μg/kg",
                  "children": [
                    {
                      "label": "treatment of choice for onchocerciasis"
                    },
                    {
                      "label": "repeated annually, probably for 10 years"
                    }
                  ]
                },
                {
                  "label": "kills microfilariae but does not have a permanent effect on adult worms",
                  "children": [
                    {
                      "label": "slows progression of visual field loss and optic atrophy",
                      "children": [
                        {
                          "label": "reduces the microfilarial load in the anterior chamber and the development of new anterior chamber lesions"
                        }
                      ]
                    },
                    {
                      "label": "does not reduce the macrofilarial load"
                    },
                    {
                      "label": "does not appear to prevent the development of new chorioretinal lesions or resolve existing lesions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "topical corticosteroids",
              "children": [
                {
                  "label": "to control any anterior uveitis"
                }
              ]
            },
            {
              "label": "surgical removal of skin nodules",
              "children": [
                {
                  "label": "many nodules are deeply buried and cannot be found"
                }
              ]
            },
            {
              "label": "doxycycline",
              "children": [
                {
                  "label": "targets Wolbachia",
                  "children": [
                    {
                      "label": "adult worm is infected with the parasitic bacterium Wolbachia",
                      "children": [
                        {
                          "label": "crucial to the sexual development of the worm"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "doxycycline + ivermectin",
                  "children": [
                    {
                      "label": "treatment of choice"
                    },
                    {
                      "label": "can cause long-term sterilization of adult worms and early worm death"
                    }
                  ]
                },
                {
                  "label": "x 6-week"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
