        {
          "label": "does not resolve spontaneously"
        },
        {
          "label": "surgery",
          "children": [
            {
              "label": "when corneal integrity is threatened"
            }
          ]
        }
      ]
    },
    {
      "label": "Congenital Ectropion",
      "children": [
        {
          "label": "eversion of the eyelid margin",
          "children": [
            {
              "label": "usually involves the lower eyelid"
            }
          ]
        },
        {
          "label": "secondary to a vertical deficiency of the skin"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "mild cases",
              "children": [
                {
                  "label": "lateral tarsorrhaphy"
