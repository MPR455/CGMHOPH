                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Cryptophthalmos",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "forms",
          "children": [
            {
              "label": "isolated"
            },
            {
              "label": "Fraser syndrome",
              "children": [
                {
                  "label": "autosomal recessive",
                  "children": [
                    {
                      "label": "mutations in the FRAS1 gene",
                      "children": [
                        {
                          "label": "4q21"
                        },
                        {
                          "label": "encodes a putative extracellular matrix protein"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "acrofacial malformations",
                  "children": [
                    {
                      "label": "partial syndactyly"
                    }
                  ]
                },
                {
                  "label": "genitourinary anomalies"
                }
              ]
            }
          ]
        },
        {
          "label": "skin passes uninterrupted from the forehead, over the eye, to the cheek",
          "children": [
            {
              "label": "blends in with the cornea, which is usually malformed"
            }
          ]
        }
      ]
    },
    {
      "label": "Telecanthus",
      "children": [
        {
          "label": "greater-than-normal distance between the inner canthi"
        },
        {
          "label": "types",
          "children": [
            {
              "label": "primary",
              "children": [
                {
                  "label": "interpupillary distance is normal"
                }
              ]
            },
            {
              "label": "secondary",
              "children": [
                {
                  "label": "interpupillary distance is greater than normal"
                }
              ]
            }
          ]
        },
        {
          "label": "common in many syndromes"
        }
      ]
    },
    {
      "label": "Congenital Tarsal Kink",
      "children": [
        {
          "label": "tarsal plate of upper eyelid is folded at birth",
          "children": [
            {
              "label": "entropion"
            },
            {
              "label": "cornea may be exposed",
              "children": [
                {
                  "label": "ulceration"
                }
              ]
            }
          ]
        },
        {
          "label": "managment",
          "children": [
            {
              "label": "minor defects",
              "children": [
                {
                  "label": "manually unfolding the tarsus"
                },
                {
                  "label": "taping the eyelid shut with a pressure dressing for 1–2 days"
                }
              ]
            },
            {
              "label": "more severe defects",
              "children": [
                {
                  "label": "surgical incision of the tarsal plate"
                },
                {
                  "label": "excision of a V-shaped wedge from the inner surface"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Dystopia Canthorum",
      "children": [
        {
          "label": "lateral displacement of both the inner canthi and the lacrimal puncta",
          "children": [
            {
              "label": "an imaginary vertical line connecting upper and lower puncta crosses the cornea"
            }
          ]
        },
        {
          "label": "Waardenburg syndrome type 1"
        }
      ]
    },
    {
      "label": "Epiblepharon",
      "children": [
        {
          "label": "horizontal fold of skin adjacent to either the upper or lower eyelid",
          "children": [
            {
              "label": "most commonly, the lower eyelid"
            }
          ]
        },
        {
          "label": "may turn the lashes inward"
        },
        {
          "label": "cornea often tolerates this condition surprisingly well"
        },
        {
          "label": "management",
          "children": [
            {
              "label": "often resolves spontaneously"
            },
            {
              "label": "ocular lubricants"
            },
            {
              "label": "surgical repair",
              "children": [
                {
                  "label": "cases that do not resolve or that cause chronic corneal irritation"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Ablepharon",
      "children": [
        {
          "label": "absence or severe hypoplasia of the eyelids"
        },
        {
          "label": "very rare"
        },
        {
          "label": "at high risk for exposure keratopathy"
        },
        {
          "label": "ablepharon macrostomia syndrome"
        }
      ]
    },
    {
      "label": "Congenital Entropion",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "eyelid inversion is present at birth"
