{
  "label": "9.9.2. Masquerade Syndromes (II): Neoplastic Masquerade Syndromes (II): Primary CNS Lymphoma",
  "root": true,
  "children": [
    {
      "label": "types",
      "children": [
        {
          "label": "non-Hodgkin B-lymphocyte lymphomas",
          "children": [
            {
              "label": "98%"
            }
          ]
        },
        {
          "label": "non-Hodgkin T-lymphocyte lymphomas",
          "children": [
            {
              "label": "2%"
            }
          ]
        }
      ]
    },
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "age of onset",
          "children": [
            {
              "label": "peak: 75-84 years",
              "children": [
                {
                  "label": "median: 6th-7th decade"
                }
              ]
            },
            {
              "label": "rarely in adolescents and children"
            }
          ]
        },
        {
          "label": "incidence of PCNSL appears to be increasing",
          "children": [
            {
              "label": "1/100,000 immunocompetent patients"
            }
          ]
        },
        {
          "label": "≤25% of patients with PCNSL have ocular involvement (vitreoretinal lymphoma)"
        },
        {
          "label": "more than 2/3 of patients with vitreoretinal lymphoma develop CNS disease",
          "children": [
            {
              "label": "usually within 29 months of diagnosis"
            }
          ]
        }
      ]
    },
    {
      "label": "lymphoma cells are sparse"
    },
    {
      "label": "diagnostic testing",
      "children": [
        {
          "label": "ultrasonography",
          "children": [
            {
              "label": "vitreous debris"
            },
            {
              "label": "elevated chorioretinal lesions"
            },
            {
              "label": "serous retinal detachment"
            }
          ]
        },
        {
          "label": "fluorescein angiography",
          "children": [
            {
              "label": "hyperfluorescent window defects due to RPE atrophy"
            },
            {
              "label": "hypofluorescent areas due to blockage from a sub-RPE tumor mass/RPE clumping"
            },
            {
              "label": "leopard-spot pattern of alternating hyperfluorescence and hypofluorescence"
            }
          ]
        },
        {
          "label": "ocular biopsy",
          "children": [
            {
              "label": "vitreous biopsy",
              "children": [
                {
                  "label": "≥1 mL of undiluted vitreous sample"
                },
                {
                  "label": "lymphoma cells are friable and undergo degeneration if transportation is delayed"
                },
                {
                  "label": "examination by an experienced pathologist"
                },
                {
                  "label": "≤1/3 false-negative result",
                  "children": [
                    {
                      "label": "± second vitreous biopsy"
                    },
                    {
                      "label": "abnormal lymphocytes may be isolated manually or by laser capture and PCR–based assays performed to improve the diagnostic yield"
                    }
                  ]
                }
              ]
            },
            {
              "label": "sub-RPE/retinal aspiration biopsy",
              "children": [
                {
                  "label": "if previous vitreous biopsy results were negative"
                }
              ]
            },
            {
              "label": "internal or external chorioretinal biopsy",
              "children": [
                {
                  "label": "if diagnosis by vitreous aspiration or subretinal/sub-RPE aspiration cannot be established"
                }
              ]
            },
            {
              "label": "cytologic examination",
              "children": [
                {
                  "label": "pleomorphic cells with scanty cytoplasm, hyperchromatic nuclei with multiple irregular nucleoli, and an elevated nuclear-to-cytoplasm ratio"
                }
              ]
            },
            {
              "label": "monoclonal B lymphocytes",
              "children": [
                {
                  "label": "immunophenotyping by immunohistochemistry or flow cytometry",
                  "children": [
                    {
                      "label": "abnormal immunoglobulin κ or λ light chain predominance"
                    },
                    {
                      "label": "specific B-lymphocyte markers (CD19, CD20, and CD22)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "gene/oncogene translocations or gene rearrangements"
            }
          ]
        },
        {
          "label": "CNS involvement",
          "children": [
            {
              "label": "brain CT",
              "children": [
                {
                  "label": "multiple diffuse periventricular lesions",
                  "children": [
                    {
                      "label": "(+) enhancement"
                    }
                  ]
                }
              ]
            },
            {
              "label": "brain MRI",
              "children": [
                {
                  "label": "isointense lesions on T1-weighted images"
                },
                {
                  "label": "isointense to hyperintense lesions on T2- weighted images"
                }
              ]
            },
            {
              "label": "CSF analysis",
              "children": [
                {
                  "label": "lymphoma cells in 1/3"
                }
              ]
            }
          ]
        },
        {
          "label": "cytokine analysis of vitreous sample",
          "children": [
            {
              "label": "IL-10 levels are elevated with VR lymphoma"
            },
            {
              "label": "high vitreous levels of IL-6 are found with inflammatory uveitis"
            },
            {
              "label": "elevated IL-10/IL-6 ratio"
            }
          ]
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "decreased vision"
            },
            {
              "label": "floaters"
            }
          ]
        },
        {
          "label": "creamy yellow sub-RPE/subretinal infiltrates",
          "children": [
            {
              "label": "1-2 mm in thickness"
            }
          ]
        },
        {
          "label": "variable degree of vitritis and anterior chamber cells"
        },
        {
          "label": "coexisting multifocal chorioretinal scars and retinal vasculitis"
        },
        {
          "label": "anti-inflammatory medication can improve the vitreous cellular infiltration",
          "children": [
            {
              "label": "not long-lasting"
            }
          ]
        },
        {
          "label": "CNS signs",
          "children": [
            {
              "label": "hemiparesis",
              "children": [
                {
                  "label": "behavioral changes",
                  "children": [
                    {
                      "label": "most frequent"
                    }
                  ]
                }
              ]
            },
            {
              "label": "cerebellar signs"
            },
            {
              "label": "epileptic seizures"
            },
            {
              "label": "cranial nerve palsies"
            },
            {
              "label": "CSF seeding of lymphoma cells",
              "children": [
                {
                  "label": "42%"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "acute retinal necrosis"
        },
        {
          "label": "toxoplasmosis"
        },
        {
          "label": "“frosted branch” angiitis"
        },
        {
          "label": "retinal arteriolar obstruction"
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "only 1 eye affected + no CNS involvement",
          "children": [
            {
              "label": "intravitreal methotrexate or rituximab"
            }
          ]
        },
        {
          "label": "both eyes affected",
          "children": [
            {
              "label": "intraocular treatment alone is controversial"
            }
          ]
        },
        {
          "label": "CNS involvement",
          "children": [
            {
              "label": "high-dose methotrexate",
              "children": [
                {
                  "label": "intravenously ± intrathecal administration"
                },
                {
                  "label": "± brain radiation therapy",
                  "children": [
                    {
                      "label": "radiation is neurotoxic",
                      "children": [
                        {
                          "label": "especially in elderly patients"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "± other chemotherapeutic drugs"
                }
              ]
            }
          ]
        },
        {
          "label": "≈1/2 of patients with ocular involvement eventually develop CNS involvement",
          "children": [
            {
              "label": "some specialists use prophylactic treatment of the CNS even in cases of seemingly isolated ocular disease"
            }
          ]
        }
      ]
    },
    {
      "label": "prognosis",
      "children": [
        {
          "label": "prognostic factors of PCNSL",
          "children": [
            {
              "label": "advanced age"
            },
            {
              "label": "worse neurologic functional classification level"
            },
            {
              "label": "multiple rather than single lesions"
            },
            {
              "label": "deep nuclei/periventricular lesions (rather than superficial lesions)"
            }
          ]
        },
        {
          "label": "long-term prognosis for PCNSL remains poor",
          "children": [
            {
              "label": "median survival",
              "children": [
                {
                  "label": "with supportive care alone is 2–3 months"
                },
                {
                  "label": "with surgery alone is 1–5 months"
                },
                {
                  "label": "with treatment longest median survival approaches 40 months"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
