{
  "label": "8.3.7. Structural and Exogenous Disorders Associated With Ocular Surface Disorders (III)",
  "root": true,
  "children": [
    {
      "label": "Dellen",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "ocular surface elevations",
              "children": [
                {
                  "label": "interfere with wetting effect of the tear film",
                  "children": [
                    {
                      "label": "desiccation of the epithelium and subepithelial tissues"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "normal blinking does not wet the involved area properly"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "at or near limbus adjacent to surface elevations",
              "children": [
                {
                  "label": "pterygia"
                },
                {
                  "label": "large filtration blebs"
                },
                {
                  "label": "dermoids"
                }
              ]
            },
            {
              "label": "saucerlike depressions in the corneal surface"
            },
            {
              "label": "epithelium exhibits punctate irregularities overlying a thinned area of dehydrated corneal stroma"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "ocular lubrication"
            },
            {
              "label": "pressure patching"
            }
          ]
        },
        {
          "label": "scleral dellen",
          "children": [
            {
              "label": "orbital and conjunctival tissues help in maintaining scleral hydration"
            },
            {
              "label": "removal of perilimbal conjunctiva and interference with the wetting effect of the tear film",
              "children": [
                {
                  "label": "cause the underlying sclera to become markedly thinned and translucent"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Neurotrophic Keratopathy and Persistent Corneal Epithelial Defects",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "damage to the trigeminal nerve"
            },
            {
              "label": "herpetic keratitis",
              "children": [
                {
                  "label": "most common cause"
                },
                {
                  "label": "can produce persistent corneal epithelial defects in absence of replicating virus or active inflammation"
                }
              ]
            },
            {
              "label": "topical medications",
              "children": [
                {
                  "label": "toxic ulcerative keratopathy",
                  "children": [
                    {
                      "label": "agents",
                      "children": [
                        {
                          "label": "topical anesthetics"
                        },
                        {
                          "label": "topical nonsteroidal anti-inflammatory drugs (NSAIDs)"
                        },
                        {
                          "label": "trifluridine"
                        },
                        {
                          "label": "β-blockers"
                        },
                        {
                          "label": "carbonic anhydrase inhibitors"
                        },
                        {
                          "label": "drops containing the preservative benzalkonium chloride (BAK)"
                        }
                      ]
                    },
                    {
                      "label": "clinical presentation",
                      "children": [
                        {
                          "label": "usually presents as a diffuse punctate keratopathy",
                          "children": [
                            {
                              "label": "often misinterpreted as a worsening of the underlying disease",
                              "children": [
                                {
                                  "label": "may lead to even larger doses of offending medication"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "label": "pericentral pseudodendritiform lesions and pseudogeographic defects"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "diabetes mellitus",
              "children": [
                {
                  "label": "diabetic neuropathy"
                },
                {
                  "label": "epithelial debridement during vitreoretinal procedures"
                }
              ]
            },
            {
              "label": "See Table 3-10"
            }
          ]
        },
        {
          "label": "persistent corneal epithelial defects",
          "children": [
            {
              "label": "central or paracentral areas of chronic nonhealing epithelium"
            },
            {
              "label": "elevated, round or oval, grayish edges associated with underlying stromal inflammation"
            },
            {
              "label": "inferior or inferonasal",
              "children": [
                {
                  "label": "protective effect of Bell phenomenon on the superior cornea"
                }
              ]
            },
            {
              "label": "can progress to",
              "children": [
                {
                  "label": "vascularization and corneal opacification or scarring"
                },
                {
                  "label": "necrosis and thinning of the stroma",
                  "children": [
                    {
                      "label": "perforation"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "careful history"
            },
            {
              "label": "frequent lubrication with nonpreserved ointments",
              "children": [
                {
                  "label": "potentially aggravating topical medications must be discontinued"
                }
              ]
            },
            {
              "label": "autologous serum drops (20%)",
              "children": [
                {
                  "label": "contain growth factors and fibronectin"
                }
              ]
            },
            {
              "label": "temporary or permanent punctal occlusion",
              "children": [
                {
                  "label": "in cases involving significant dry eye"
                }
              ]
            },
            {
              "label": "patching"
            },
            {
              "label": "low-water-content, highly oxygen-permeable therapeutic contact lenses"
            },
            {
              "label": "scleral-bearing contact lenses with a fluid-filled reservoir"
            },
            {
              "label": "lateral and/or medial tarsorrhaphy",
              "children": [
                {
                  "label": "decrease tear-film evaporation and tear-film osmolarity"
                }
              ]
            },
            {
              "label": "medications with specific activity against MMPs",
              "children": [
                {
                  "label": "systemic tetracyclines"
                },
                {
                  "label": "may help prevent stromal melting"
                }
              ]
            },
            {
              "label": "corneal collagen crosslinking",
              "children": [
                {
                  "label": "early in the course of a melt"
                }
              ]
            },
            {
              "label": "amniotic membrane grafting",
              "children": [
                {
                  "label": "to encourage healing of persistent epithelial ulcerations"
                }
              ]
            },
            {
              "label": "partial or total conjunctival flaps",
              "children": [
                {
                  "label": "prevent corneal melting"
                },
                {
                  "label": "should be used as a last resort"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "sharply delineated borders"
    },
    {
      "label": "Factitious Ocular Surface Disorders",
      "children": [
        {
          "label": "self-induced injuries with symptoms or physical findings that the patient intentionally produces in order to assume the sick role"
        },
        {
          "label": "factitious conjunctivitis",
          "children": [
            {
              "label": "shows evidence of mechanical injury to the inferior and nasal quadrants of cornea and conjunctiva"
            },
            {
              "label": "patients often have medical training or work in a medical setting"
            },
            {
              "label": "patients have an attitude of serene indifference"
            }
          ]
        },
        {
          "label": "mucus-fishing syndrome",
          "children": [
            {
              "label": "inciting event is typically KCS",
              "children": [
                {
                  "label": "conjunctival tissues usually show no evidence of inflammation on pathologic examination"
                },
                {
                  "label": "increased mucus production"
                }
              ]
            },
            {
              "label": "vigorous eye rubbing and compulsive removal of mucus strands from the fornix (mucus fishing)",
              "children": [
                {
                  "label": "epithelial injury heightens ocular surface irritation",
                  "children": [
                    {
                      "label": "stimulates additional mucus production"
                    }
                  ]
                }
              ]
            },
            {
              "label": "well-circumscribed pattern of rose bengal or lissamine green staining of nasal and inferior bulbar conjunctiva"
            }
          ]
        },
        {
          "label": "topical anesthetic abuse",
          "children": [
            {
              "label": "local anesthetics",
              "children": [
                {
                  "label": "inhibition of epithelial migration and division"
                },
                {
                  "label": "loss of microvilli"
                },
                {
                  "label": "reduction of desmosomes and other intercellular contacts"
                },
                {
                  "label": "swelling of mitochondria and lysosomes"
                }
              ]
            },
            {
              "label": "clinical features",
              "children": [
                {
                  "label": "punctate keratopathy"
                },
                {
                  "label": "eye injection"
                },
                {
                  "label": "epithelial defects",
                  "children": [
                    {
                      "label": "can take on a neurotrophic appearance"
                    }
                  ]
                },
                {
                  "label": "dense stromal infiltrates",
                  "children": [
                    {
                      "label": "large ring opacity"
                    }
                  ]
                },
                {
                  "label": "stromal vascularization"
                },
                {
                  "label": "diffuse stromal edema"
                },
                {
                  "label": "secondary infection",
                  "children": [
                    {
                      "label": "keratic precipitates and hypopyon"
                    }
                  ]
                }
              ]
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "infectious keratitis must be ruled out",
                  "children": [
                    {
                      "label": "bacterial, fungal, herpetic, and amebic keratitis"
                    },
                    {
                      "label": "features suggestive of anesthetic abuse",
                      "children": [
                        {
                          "label": "negative cultures"
                        }
                      ]
                    },
                    {
                      "label": "often, diagnosis is made only when the patient is discovered concealing the anesthetic drops",
                      "children": [
                        {
                          "label": "failure to respond to appropriate therapy"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "corneal healing usually occurs if all exposure to anesthetics is removed",
                  "children": [
                    {
                      "label": "permanent corneal scarring or perforation may occur"
                    }
                  ]
                },
                {
                  "label": "psychiatric counseling"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Trichiasis and Distichiasis",
      "children": [
        {
          "label": "Trichiasis",
          "children": [
            {
              "label": "acquired"
            },
            {
              "label": "eyelashes emerging from their normal anterior origin curve inward toward the cornea"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "idiopathic"
                },
                {
                  "label": "chronic inflammatory conditions of eyelids and conjunctiva",
                  "children": [
                    {
                      "label": "subtle cicatricial entropion of eyelid margin",
                      "children": [
                        {
                          "label": "most common"
                        }
                      ]
                    },
                    {
                      "label": "trachoma"
                    },
                    {
                      "label": "mucous membrane pemphigoid"
                    },
                    {
                      "label": "Stevens-Johnson syndrome"
                    },
                    {
                      "label": "chronic blepharitis"
                    },
                    {
                      "label": "chemical burns"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Distichiasis",
          "children": [
            {
              "label": "congenital"
            },
            {
              "label": "autosomal dominant"
            },
            {
              "label": "extra row of eyelashes emerges from the ducts of meibomian glands",
              "children": [
                {
                  "label": "can be fine and well tolerated"
