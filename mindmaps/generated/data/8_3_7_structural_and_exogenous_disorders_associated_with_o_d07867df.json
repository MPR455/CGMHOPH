                    }
                  ]
                }
              ]
            },
            {
              "label": "electrolysis",
              "children": [
                {
                  "label": "works well only for removing a few eyelashes"
                },
                {
                  "label": "may be preferable in younger patients for cosmetic reasons"
                }
              ]
            },
            {
              "label": "cryotherapy",
              "children": [
                {
                  "label": "complications",
                  "children": [
                    {
                      "label": "eyelid margin thinning"
                    },
                    {
                      "label": "loss of adjacent normal eyelashes"
                    },
                    {
                      "label": "persistent lanugo (hairs)"
                    }
                  ]
                },
                {
                  "label": "cryotherapy at –20°C should be limited to less than 30 seconds"
                }
              ]
            },
            {
              "label": "tarsotomy with eyelid margin rotation",
              "children": [
                {
                  "label": "preferred surgical technique"
