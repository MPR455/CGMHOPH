{
  "label": "8.12.2. Degenerative Changes in the Cornea (I): Epithelial and Subepithelial Degenerations",
  "root": true,
  "children": [
    {
      "label": "Iron deposition",
      "children": [
        {
          "label": "related to abnormalities of tear pooling due to surface irregularities",
          "children": [
            {
              "label": "See Table 12-3"
            }
          ]
        },
        {
          "label": "red-free or cobalt blue illumination before instilling fluorescein",
          "children": [
            {
              "label": "Fleischer ring",
              "children": [
                {
                  "label": "keratoconus"
                }
              ]
            },
            {
              "label": "Hudson-Stähli line",
              "children": [
                {
                  "label": "useful in the diagnosis of mild or early cases of keratoconus"
                },
                {
                  "label": "junction of the upper two-thirds and lower one- third of the cornea"
                }
              ]
            },
            {
              "label": "tear star",
              "children": [
                {
                  "label": "keratorefractive surgery",
                  "children": [
                    {
                      "label": "centrally in approximately 80% of patients"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Age-Related (Involutional) Changes",
      "children": [
        {
          "label": "cornea gradually becomes",
          "children": [
            {
              "label": "thinner",
              "children": [
                {
                  "label": "flatter in the vertical meridian"
                }
              ]
            },
            {
              "label": "slightly less transparent"
            }
          ]
        },
        {
          "label": "refractive index increases"
        },
        {
          "label": "Descemet membrane becomes thicker",
          "children": [
            {
              "label": "3 μm at birth to 10 μm in adults"
            }
          ]
        },
        {
          "label": "occasional peripheral endothelial guttae",
          "children": [
            {
              "label": "Hassall-Henle bodies"
            }
          ]
        },
        {
          "label": "attrition of corneal endothelial cells",
          "children": [
            {
              "label": "loss of about 100,000 cells during the first 50 years of life",
              "children": [
                {
                  "label": "4000 cells/mm2 at birth"
                },
                {
                  "label": "2500–3000 cells/mm2 in older adults"
                },
                {
                  "label": "0.6% decrease per year"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Coats white ring",
      "children": [
        {
          "label": "area of discrete gray-white dots",
          "children": [
            {
              "label": "small (1 mm or less in diameter)"
            },
            {
              "label": "circle or oval-shaped",
              "children": [
                {
                  "label": "superficial stroma"
                }
              ]
            }
          ]
        },
        {
          "label": "iron-containing fibrotic remnants of a metallic foreign body"
        },
        {
          "label": "once these lesions mature they do not change",
          "children": [
            {
              "label": "therapy with corticosteroids/anti-inflammatory agents is not indicated"
            }
          ]
        }
      ]
    },
    {
      "label": "Calcific band keratopathy",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "fine, dustlike, basophilic deposits in the Bowman layer"
            },
            {
              "label": "peripherally in the 3- and 9-o’clock positions",
              "children": [
                {
                  "label": "can progress to horizontal band of dense calcific plaques across the interpalpebral zone of the cornea"
                }
              ]
            },
            {
              "label": "fibrous pannus",
              "children": [
                {
                  "label": "lucid interval"
                },
                {
                  "label": "if silicone oil is responsible"
                }
              ]
            }
          ]
        },
        {
          "label": "types",
          "children": [
            {
              "label": "idiopathic"
            },
            {
              "label": "secondary",
              "children": [
                {
                  "label": "chronic ocular disease (inflammatory, phthisis bulbi)"
                },
                {
                  "label": "hypercalcemia (hyperparathyroidism, vitamin D toxicity, milk-alkali syndrome, sarcoidosis, or other systemic disorders)"
                },
                {
                  "label": "hereditary transmission (primary hereditary band keratopathy)"
                },
                {
                  "label": "elevated serum phosphorus level with normal serum calcium (renal failure)"
                },
                {
                  "label": "chronic exposure to mercurial vapors or to mercurial preservatives (phenylmercuric nitrate or acetate) in ophthalmic medications",
                  "children": [
                    {
                      "label": "mercury causes changes in corneal collagen that result in the deposition of calcium"
                    }
                  ]
                },
                {
                  "label": "silicone oil instillation in an aphakic eye"
                }
              ]
            }
          ]
        },
        {
          "label": "deposition of urates in the cornea",
          "children": [
            {
              "label": "brown, unlike the gray-white calcific deposits"
            },
            {
              "label": "gout or hyperuricemia"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "workup",
              "children": [
                {
                  "label": "serum electrolytes",
                  "children": [
                    {
                      "label": "high calcium or high phosphorus"
                    }
                  ]
                },
                {
                  "label": "urinalysis"
                }
              ]
            },
            {
              "label": "underlying conditions should be treated"
            },
            {
              "label": "chelation with neutral solution of disodium ethylenediaminetetraacetic acid (EDTA)",
              "children": [
                {
                  "label": "0.5%–1.5%"
                },
                {
                  "label": "remove overlying epithelium"
                },
                {
                  "label": "warm to speed up the chemical chelation"
                },
                {
                  "label": "cylindrical tube",
                  "children": [
                    {
                      "label": "acting as a reservoir to confine the chelating solution to the desired treatment area"
                    }
                  ]
                },
                {
                  "label": "gentle surface agitation"
                },
                {
                  "label": "scraping should be gentle so as to prevent damage to the Bowman layer"
                },
                {
                  "label": "can recur",
                  "children": [
                    {
                      "label": "neither EDTA nor scraping will remove fibrous pannus"
                    }
                  ]
                }
              ]
            },
            {
              "label": "PTK using an excimer laser is not advised",
              "children": [
                {
                  "label": "could produce a severely irregular surface"
                },
                {
                  "label": "for residual opacification after initial EDTA"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Spheroidal degeneration",
      "children": [
        {
          "label": "translucent, golden brown, spheroidlike deposits",
          "children": [
            {
              "label": "cornea +- conjunctiva"
            },
            {
              "label": "subepithelium, Bowman layer, or superficial stroma"
            }
          ]
        },
        {
          "label": "types",
          "children": [
            {
              "label": "primary spheroidal degeneration",
              "children": [
                {
                  "label": "unrelated to the coexistence of other ocular disease"
                },
                {
                  "label": "bilateral"
                },
                {
                  "label": "nasal and temporal cornea",
                  "children": [
                    {
                      "label": "with age, can extend onto the conjunctiva in the interpalpebral zone"
                    }
                  ]
                }
              ]
            },
            {
              "label": "secondary spheroidal degeneration",
              "children": [
                {
                  "label": "ocular injury or inflammation",
                  "children": [
                    {
                      "label": "rarely extends across the interpalpebral zone of the cornea",
                      "children": [
                        {
                          "label": "noncalcific band-shaped keratopathy"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "near corneal scarring or vascularization"
                }
              ]
            }
          ]
        },
        {
          "label": "extracellular, proteinaceous, hyaline deposits with characteristics of elastotic degeneration"
        },
        {
          "label": "management",
          "children": [
            {
              "label": "no medical therapy is of much value",
              "children": [
                {
                  "label": "composition is not lipid!"
                }
              ]
            },
            {
              "label": "lubrication"
            },
            {
              "label": "central involvement",
              "children": [
                {
                  "label": "superficial keratectomy"
                },
                {
                  "label": "phototherapeutic keratectomy",
                  "children": [
                    {
                      "label": "excimer laser"
                    }
                  ]
                }
              ]
            },
            {
              "label": "recurrence after conjunctival resection is common"
            }
          ]
        }
      ]
    }
  ],
