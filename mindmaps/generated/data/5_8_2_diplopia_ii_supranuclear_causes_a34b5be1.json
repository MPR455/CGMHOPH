{
  "label": "5.8.2. Diplopia (II): Supranuclear causes",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "supranuclear pathway for eye movement",
          "children": [
            {
              "label": "definition: any afferent input to the ocular motor nerves"
            },
            {
              "label": "corticobulbar pathway",
              "children": [
                {
                  "label": "drives volitional eye movement",
                  "children": [
                    {
                      "label": "\"look to the right\""
                    }
                  ]
                }
              ]
            },
            {
              "label": "vestibular pathway",
              "children": [
                {
                  "label": "analyzes the relative position of the eyes/head and the direction of the intended visual target"
                },
                {
                  "label": "allows accurate calculation of saccadic velocity and direction"
                },
                {
                  "label": "horizontal movement: particular population of neurons in the PPRF"
                }
              ]
            }
          ]
        },
        {
          "label": "most supranuclear disorders affect both eyes equally",
          "children": [
            {
              "label": "do not cause diplopia!",
              "children": [
                {
                  "label": "except",
                  "children": [
                    {
                      "label": "See Table 8-1"
                    },
                    {
                      "label": "Alternating Skew Deviation"
                    },
                    {
                      "label": "Convergence insufficiency or spasm"
                    },
                    {
                      "label": "Divergence insufficiency"
                    },
                    {
                      "label": "Ocular tilt reaction"
                    },
                    {
                      "label": "Skew deviation"
                    },
                    {
                      "label": "Thalamic esodeviation"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
