{
  "label": "5.14.2. Systemic Conditions (II): Immunologic Disorders (II): Multiple Sclerosis (I)",
  "root": true,
  "children": [
    {
      "label": "Epidemiology and genetics",
      "children": [
        {
          "label": "more common in latitudes >40 degrees from the equator"
        },
        {
          "label": "more common in whites",
          "children": [
            {
              "label": "rare among certain native ethnic groups",
              "children": [
                {
                  "label": "Inuit"
                },
                {
                  "label": "Maori"
                },
                {
                  "label": "despite the latitude"
                }
              ]
            }
          ]
        },
        {
          "label": "F : M = 2–3 : 1"
        },
        {
          "label": "highest among young adults (25–40 years)",
          "children": [
            {
              "label": "onset even after the age of 50 years is not rare"
            },
            {
              "label": "uncommon <10 years"
            }
          ]
        },
        {
          "label": "genetic factors",
          "children": [
            {
              "label": "significantly increased risk in first-degree relatives of patients with MS"
            },
            {
              "label": "10x greater concordance among identical twins than among fraternal twins"
            },
            {
              "label": "HLA-DRB1 antigen"
            },
            {
              "label": "an acquired agent, such as a virus, may trigger the disease",
              "children": [
                {
                  "label": "no specific infectious etiology has been identified"
                }
              ]
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Funduscopic abnormalities",
      "children": [
        {
          "label": "nerve fiber layer defects"
        },
        {
          "label": "perivenous sheathing and fluorescein leakage along peripheral veins",
          "children": [
            {
              "label": "10%"
            }
          ]
        },
        {
          "label": "autopsy studies",
          "children": [
            {
              "label": "retinitis and periphlebitis",
              "children": [
                {
                  "label": "5%–10%"
                }
              ]
            }
          ]
        },
        {
          "label": "anterior or posterior uveitis (including pars planitis)",
          "children": [
            {
              "label": "0.4%–26%"
            }
          ]
        }
      ]
    },
    {
      "label": "90%"
    },
    {
      "label": "photisms",
      "children": [
        {
          "label": "light induced by noise, smell, taste, or touch"
        }
      ]
    },
    {
      "label": "Course and prognosis",
      "children": [
        {
          "label": "relapsing-remitting clinical course",
          "children": [
            {
              "label": "episodes of neurologic dysfunction separated by intervals of months or years"
            },
            {
              "label": "pathologic burden in CNS accumulates even in the absence of clinical activity",
              "children": [
                {
                  "label": "secondary progressive form",
                  "children": [
                    {
                      "label": "within 10 years ≈ 50% of patients with relapsing-remitting course exhibit a slow continuous deterioration in neurologic status"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "primary progressive form",
          "children": [
            {
              "label": "disease progresses inexorably from onset with no recognizable attacks",
              "children": [
                {
                  "label": "10%–20%"
                }
              ]
            },
            {
              "label": "near total disability within 1–2 years of onset may result after a fulminant course"
            }
          ]
        },
        {
          "label": "relatively benign course without serious disability",
          "children": [
            {
              "label": "5–10%"
            }
          ]
        }
      ]
    },
    {
      "label": "Optic neuritis in multiple sclerosis",
      "children": [
        {
          "label": "symptoms",
          "children": [
            {
              "label": "transient deterioration of vision may be brought on by",
              "children": [
                {
                  "label": "exercise"
                },
                {
                  "label": "elevations in body temperature",
                  "children": [
                    {
                      "label": "Uhthoff symptom"
                    }
                  ]
                }
              ]
            },
            {
              "label": "phosphenes",
              "children": [
                {
                  "label": "bright flashes of light"
                },
                {
                  "label": "with movement of the affected eye"
                }
              ]
            }
          ]
        },
        {
          "label": "incidence",
          "children": [
            {
              "label": "optic neuritis as a presenting symptom of MS",
              "children": [
                {
                  "label": "25%"
                }
              ]
            },
            {
              "label": "optic neuritis occurring at some point in the course of disease",
              "children": [
                {
                  "label": "75%"
                }
              ]
            },
            {
              "label": "evidence of optic nerve involvement as demonstrated by an abnormal visual evoked response",
              "children": [
                {
                  "label": "90%"
                }
              ]
            },
            {
              "label": "anterior visual pathway demyelination on autopsy studies",
              "children": [
                {
                  "label": "in virtually all patients with clinically definite MS"
                }
              ]
            }
          ]
        },
        {
          "label": "risk of MS after an episode of optic neuritis",
          "children": [
            {
              "label": "Optic Neuritis Treatment Trial (ONTT)",
              "children": [
                {
                  "label": "clinically definite MS developed in 50% in 15 years"
                },
                {
                  "label": "no lesions on brain MRI",
                  "children": [
                    {
                      "label": "25%"
                    }
                  ]
                },
                {
                  "label": "≥1 lesions on brain MRI",
                  "children": [
                    {
                      "label": "72%"
                    }
                  ]
                },
                {
                  "label": "CSF analysis",
                  "children": [
                    {
                      "label": "presence of abnormalities on brain MRI during an episode of optic neuritis was the strongest predictive factor for developing MS"
                    },
                    {
                      "label": "oligoclonal banding",
                      "children": [
                        {
                          "label": "predictive value for development of MS only in patients with a normal MRI"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "patients with history of prior optic neuritis and nonspecific neurologic symptoms were at higher risk of MS"
                }
              ]
            }
          ]
        },
        {
          "label": "OCT",
          "children": [
            {
              "label": "to measure the nerve fiber layer in MS",
              "children": [
                {
                  "label": "a marker for neuronal damage"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Clinical presentation",
      "children": [
        {
          "label": "neurologic symptoms/signs occur over time and affect different areas of the CNS",
          "children": [
            {
              "label": "ocular symptomatology is commonly part of the clinical picture"
            },
            {
              "label": "nonocular signs and symptoms may precede, follow, or coincide with the ocular signs"
            }
          ]
        },
        {
          "label": "symptoms of early MS are often evanescent and unaccompanied by objective neurologic findings"
        },
        {
          "label": "significant episodes last for weeks or months"
        },
        {
          "label": "pregnancy",
          "children": [
            {
              "label": "MS is typically quiescent during the third trimester of pregnancy"
            },
            {
              "label": "may flare up after delivery"
            }
          ]
        },
