{
  "label": "7.10.12. Eyelid & Canthal Reconstruction",
  "root": true,
  "children": [
    {
      "label": "Priorities in eyelid reconstruction",
      "children": [
        {
          "label": "development of a stable eyelid margin"
        },
        {
          "label": "provision of adequate vertical eyelid height"
        },
        {
          "label": "adequate eyelid closure"
        },
        {
          "label": "smooth, epithelialized internal surface"
        },
        {
          "label": "maximum cosmesis and symmetry"
        }
      ]
    },
    {
      "label": "general principles",
      "children": [
        {
          "label": "one may reconstruct either the anterior or the posterior eyelid lamella, but not both, with a graft",
          "children": [
            {
              "label": "1 of the layers must provide the blood supply (pedicle flap)"
            }
          ]
        },
        {
          "label": "maximize horizontal tension and minimize vertical tension"
        },
        {
          "label": "maintain sufficient and anatomical canthal fixation"
        },
        {
          "label": "match like tissue to like tissue"
        },
        {
          "label": "narrow the defect as much as possible before sizing a graft"
        },
        {
          "label": "get help from a subspecialist if you need it"
        }
      ]
    },
    {
      "label": "eyelid defects not involving the eyelid margin",
      "children": [
        {
          "label": "techniques",
          "children": [
            {
              "label": "direct closure",
              "children": [
                {
                  "label": "if this procedure does not distort the eyelid margin"
                }
              ]
            },
            {
              "label": "skin flaps",
              "children": [
                {
                  "label": "types",
                  "children": [
                    {
                      "label": "rectangular advancement"
                    },
                    {
                      "label": "rotation"
                    },
                    {
                      "label": "transposition"
                    }
                  ]
                },
                {
                  "label": "usually provide the best tissue match and aesthetic result"
                }
              ]
            },
            {
              "label": "skin grafts",
              "children": [
                {
                  "label": "easier to perform"
                },
                {
                  "label": "avoid placement of hair-bearing skin grafts near the eyes"
                },
                {
                  "label": "use of split-thickness grafts should be avoided in eyelid reconstruction",
                  "children": [
                    {
                      "label": "recommended only in the treatment of severe burns of the face when adequate full-thickness skin is not available"
                    }
                  ]
                },
                {
                  "label": "anterior lamella upper eyelid defects",
                  "children": [
                    {
                      "label": "full-thickness skin grafts",
                      "children": [
                        {
                          "label": "contralateral upper eyelid",
                          "children": [
                            {
                              "label": "best choice"
                            }
                          ]
                        },
                        {
                          "label": "preauricular or postauricular skin grafts",
                          "children": [
                            {
                              "label": "greater thickness may limit upper eyelid mobility"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "anterior lamella lower eyelid defects",
                  "children": [
                    {
                      "label": "preauricular or postauricular skin grafts",
                      "children": [
                        {
                          "label": "best choice"
                        }
                      ]
                    },
                    {
                      "label": "supraclavicular fossa"
                    },
                    {
                      "label": "inner upper arm"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "tension of closure should be directed horizontally",
          "children": [
            {
              "label": "placement of vertically oriented incision lines"
            },
            {
              "label": "vertical tension may cause eyelid retraction or ectropion"
            }
          ]
        }
      ]
    },
    {
      "label": "medial canthal defects",
      "children": [
        {
          "label": "spontaneous granulation of anterior lamellar defects"
        },
        {
          "label": "full-thickness skin grafs",
          "children": [
            {
              "label": "thin enough to allow for early detection of tumor recurrence"
            },
            {
              "label": "make every effort at time of tumor resection to minimize risk of recurrent medial canthal tumors",
              "children": [
                {
                  "label": "frozen sections"
                },
                {
                  "label": "wide margins"
                },
                {
                  "label": "Mohs micrographic resection techniques",
                  "children": [
                    {
                      "label": "offers the highest cure rates for eradication of medial canthal epithelial malignancies"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "forehead or glabellar flaps",
          "children": [
            {
              "label": "disadvantage of being thick, thereby making early detection of recurrences difficult"
            },
            {
              "label": "often require second-stage thinning in order to achieve the best cosmetic result"
            }
          ]
        },
        {
          "label": "when full-thickness medial eyelid defects are present, the medial canthal attachments of the remaining eyelid margin must be fixed to firm periosteum or bone",
          "children": [
            {
              "label": "heavy permanent suture"
            },
            {
              "label": "wire"
            },
            {
              "label": "titanium miniplates"
            }
          ]
        },
        {
          "label": "defects involving the lacrimal drainage apparatus",
          "children": [
            {
              "label": "simultaneous microsurgical reconstruction"
            },
            {
              "label": "possible silicone intubation or marsupialization"
            },
            {
              "label": "if extensive sacrifice of the canaliculi has occurred in the resection of a tumor",
              "children": [
                {
                  "label": "patient may have to tolerate epiphora until recurrence of the tumor is no longer a risk",
                  "children": [
                    {
                      "label": "recurrence-free period of 5 years",
                      "children": [
                        {
                          "label": "conjunctivodacryocystorhinostomy with a Jones tube"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "lateral canthal defects",
      "children": [
        {
          "label": "laterally based transposition flaps of upper eyelid tarsus and conjunctiva",
          "children": [
            {
              "label": "for large lower eyelid defects extending to the lateral canthus"
            },
            {
              "label": "can be covered with free skin grafts"
            }
          ]
        },
        {
          "label": "semicircular advancement flaps of skin"
        },
        {
          "label": "strips of periosteum and/or deep temporal fascia",
          "children": [
            {
              "label": "left attached at the lateral orbital rim"
            },
            {
              "label": "swung over and attached to the remaining lateral eyelid margins"
            },
            {
              "label": "y-shaped pedicle flap of periosteum is optimal for reconstruction of the entire lateral canthal posterior lamella"
            }
          ]
        }
      ]
    },
    {
      "label": "eyelid defects involving the eyelid margin",
      "children": [
        {
          "label": "upper eyelid",
          "children": [
            {
              "label": "small upper eyelid defects",
              "children": [
                {
                  "label": "≤1/3 involvement"
                },
                {
                  "label": "primary closure",
                  "children": [
                    {
                      "label": "surgeon can cut the superior limb of the lateral canthal tendon to allow 3–5 mm of medial mobilization",
                      "children": [
                        {
                          "label": "avoid the lacrimal ductules in the lateral third of the upper eyelid!"
                        }
                      ]
                    },
                    {
                      "label": "postoperatively, the eyelid appears tight and ptotic because of traction, but it relaxes over several weeks"
                    }
                  ]
                }
              ]
            },
            {
              "label": "moderate upper eyelid defects",
              "children": [
                {
                  "label": "33%–50% involvement"
                },
                {
                  "label": "advancement of the lateral segment of the eyelid",
                  "children": [
                    {
                      "label": "lateral canthal tendon is incised"
                    },
                    {
                      "label": "a semicircular skin flap is made below the lateral portion of the eyebrow and canthus"
                    }
                  ]
                },
                {
                  "label": "tarsal-sharing procedures involving the lower eyelid"
                }
              ]
            },
            {
              "label": "large upper eyelid defects",
              "children": [
                {
                  "label": "50% involvement"
                },
                {
                  "label": "Cutler-Beard procedure",
                  "children": [
                    {
                      "label": "incision below the lower eyelid tarsus"
                    },
                    {
                      "label": "full-thickness lower eyelid flap is moved into the defect of the upper eyelid by advancement of the flap behind the remaining lower eyelid margin (cutler-beard procedure)"
                    }
                  ]
                },
                {
                  "label": "free tarsoconjunctival graft from the contralateral upper eyelid",
                  "children": [
                    {
                      "label": "covered with a skin–muscle flap if adequate redundant upper eyelid skin is present"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "lower eyelid",
          "children": [
            {
              "label": "small lower eyelid defects",
              "children": [
                {
                  "label": "≤1/3 involvement"
                },
                {
                  "label": "primary closure",
                  "children": [
                    {
                      "label": "inferior crus of the lateral canthal tendon can be internally or externally released",
                      "children": [
                        {
                          "label": "additional 3–5 mm of medial mobilization"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "moderate lower eyelid defects",
              "children": [
                {
                  "label": "modification of the tenzel semicircular rotation flap"
                },
                {
                  "label": "tarsoconjunctival autografts harvested from the underside of the upper eyelid",
                  "children": [
                    {
                      "label": "marginal 4–5 mm height of the tarsus is preserved to prevent distortion of the donor eyelid margin"
                    },
                    {
                      "label": "covered with",
                      "children": [
                        {
                          "label": "skin flaps",
                          "children": [
