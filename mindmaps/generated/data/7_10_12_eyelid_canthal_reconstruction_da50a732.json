              "label": "large lower eyelid defects",
              "children": [
                {
                  "label": "50% involvement"
                },
                {
                  "label": "modified Hughes procedure",
                  "children": [
                    {
                      "label": "advancement of a tarsoconjunctival flap from the upper eyelid into the posterior lamellar defect of the lower eyelid"
                    },
                    {
                      "label": "anterior lamella",
                      "children": [
                        {
                          "label": "advancement skin flap"
                        },
                        {
                          "label": "free skin graft",
                          "children": [
                            {
