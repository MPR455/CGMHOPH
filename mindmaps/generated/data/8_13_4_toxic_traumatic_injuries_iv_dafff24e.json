        },
        {
          "label": "caterpillar and tarantula hairs",
          "children": [
            {
              "label": "become embedded in the cornea and conjunctiva"
            },
            {
              "label": "very fine",
              "children": [
                {
                  "label": "extreme foreign-body sensation",
                  "children": [
                    {
                      "label": "until the hairs migrate below the corneal surface"
                    }
                  ]
                },
                {
                  "label": "usually cannot be removed manually"
                }
              ]
            },
            {
              "label": "tend to migrate more deeply into ocular tissues",
              "children": [
                {
                  "label": "localized granulomatous inflammatory response (ophthalmia nodosum)"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "topical corticosteroids"
                }
              ]
            }
          ]
        }
