{
  "label": "9.10.6. Ocular Involvement in AIDS (III)",
  "root": true,
  "children": [
    {
      "label": "Molluscum Contagiosum",
      "children": [
        {
          "label": "small elevation with central umbilication",
          "children": [
            {
              "label": "a DNA virus of the poxvirus family"
            }
          ]
        },
        {
          "label": "immunocompetent individuals",
          "children": [
            {
              "label": "few, unilateral"
            },
            {
              "label": "involve the eyelids"
            }
          ]
        },
        {
          "label": "patients with AIDS",
          "children": [
            {
              "label": "numerous, bilateral"
            }
          ]
        },
        {
          "label": "indications for surgical excision",
          "children": [
            {
              "label": "symptomatic lesions"
            },
            {
              "label": "lesions causing conjunctivitis"
            }
          ]
        }
      ]
    },
    {
      "label": "Herpes Zoster",
      "children": [
        {
          "label": "corneal involvement can cause persistent, chronic epithelial keratitis",
          "children": [
            {
              "label": "patients <50 years with herpes zoster lesions of the face or eyelids should be considered for HIV testing"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "intravenous and topical acyclovir"
            }
          ]
        },
        {
          "label": "periodic monitoring for posterior segment involvement"
        }
      ]
    },
    {
      "label": "Precautions in the Health Care Setting",
      "children": [
        {
          "label": "there are no published reports of HIV transmission in ophthalmic health care settings"
        },
        {
          "label": "hands should be washed or a hand sterilizer solution used between tests on an individual and between patients"
        },
        {
          "label": "tonometers, diagnostic contact lenses, and contact lens trial sets should be appropriately disinfected"
        }
      ]
    },
    {
      "label": "HIV Infection in Resource-Limited Regions of the World",
      "children": [
        {
          "label": "effective antiretroviral therapy and education have greatly improved outcomes and decreased the rate of ocular complications in resource-rich nations"
        },
        {
          "label": "2013",
          "children": [
            {
              "label": "35 million people are living with HIV/AIDS",
              "children": [
                {
                  "label": "2.1 million adolescents (ages 10–19 years)"
                },
                {
                  "label": "3.34 million children"
                }
              ]
            }
          ]
        },
        {
          "label": "≤95% of new HIV infections occur in low- and middle-income countries"
        }
      ]
    },
    {
      "label": "Other Infections",
      "children": [
        {
          "label": "AIDS does not predispose to bacterial keratitis",
          "children": [
            {
              "label": "but bacterial keratitis is",
              "children": [
                {
                  "label": "more severe"
                },
                {
                  "label": "more likely to cause perforation"
                }
              ]
            }
          ]
        },
        {
          "label": "herpes simplex keratitis does not have a higher incidence in patients with AIDS",
          "children": [
            {
              "label": "but",
              "children": [
                {
                  "label": "has prolonged course/multiple recurrences"
                },
                {
                  "label": "involves the limbus"
                }
              ]
            }
          ]
        },
        {
          "label": "microsporidia",
          "children": [
            {
              "label": "coarse, punctate epithelial keratitis with minimal conjunctival reaction"
            },
            {
              "label": "electron microscopy of epithelial scrapings",
              "children": [
                {
                  "label": "obligate, intracellular, protozoal parasite"
                }
              ]
            }
          ]
        },
        {
          "label": "solitary granulomatous conjunctivitis",
          "children": [
            {
              "label": "cryptococcal or mycotic infections"
            },
            {
              "label": "tuberculosis"
            },
            {
              "label": "possibility of dissemination must be aggressively investigated"
            }
          ]
        },
        {
          "label": "orbital and intraocular lymphomas"
