    {
      "label": "Chikungunya Fever",
      "children": [
        {
          "label": "arthropod-borne Alphavirus in the family Togaviridae"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "potentially fatal",
              "children": [
                {
                  "label": "fever, headache, fatigue, nausea, vomiting, myalgia, arthralgia, and skin rash"
                }
              ]
            }
          ]
        },
        {
          "label": "ocular manifestations",
          "children": [
            {
              "label": "bilateral"
            },
            {
              "label": "anterior uveitis",
              "children": [
                {
                  "label": "granulomatous or nongranulomatous"
                },
                {
                  "label": "diffuse pigmented KPs, iris pigment release, elevated IOP, and, infrequently, posterior synechiae",
                  "children": [
                    {
                      "label": "both appear several weeks after the primary illness"
                    }
                  ]
                }
              ]
            },
            {
              "label": "retinitis",
              "children": [
                {
                  "label": "resembles herpetic retinitis in an immunocompetent host"
                },
                {
                  "label": "retinal hemorrhage",
                  "children": [
                    {
                      "label": "focal, multifocal, or confluent retinochoroiditis in the posterior pole"
                    }
                  ]
                },
                {
                  "label": "retinal edema",
                  "children": [
                    {
                      "label": "minimal vitritis"
                    }
                  ]
                },
                {
                  "label": "differences with herpetic retinitis",
                  "children": [
                    {
                      "label": "peripheral retinal involvement"
                    },
                    {
                      "label": "more intense vitreous reaction"
                    }
                  ]
                }
              ]
            },
            {
              "label": "nodular episcleritis"
            }
          ]
        },
        {
          "label": "diagnostic tests",
          "children": [
            {
              "label": "serology",
              "children": [
                {
                  "label": "benign course"
                },
                {
                  "label": "Chikungunya-specific IgM antibodies",
                  "children": [
                    {
                      "label": "no evidence that such therapy improves visual outcome"
                    }
                  ]
                }
              ]
            },
            {
              "label": "virus isolation"
            },
            {
              "label": "reverse transcription PCR"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "confluent retinitis"
            },
            {
              "label": "anterior uveitis",
              "children": [
                {
                  "label": "topical steroids",
                  "children": [
                    {
                      "label": "systemic acyclovir and prednisone"
                    }
                  ]
                }
              ]
            }
          ]
        }
