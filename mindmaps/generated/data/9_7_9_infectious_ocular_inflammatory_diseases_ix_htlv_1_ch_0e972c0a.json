{
  "label": "9.7.9. Infectious Ocular Inflammatory Diseases (IX): HTLV-1 Chikungunya Dengue fever",
  "root": true,
  "children": [
    {
      "label": "Human T-lymphotropic virus type 1 (HTLV-1)",
      "children": [
        {
          "label": "endemic in Japan, the Caribbean islands, and parts of Central and South America",
          "children": [
            {
              "label": "retrovirus of the Oncovirinae subfamily"
            }
          ]
        },
        {
          "label": "major target cell of HTLV-1 is the CD4+ T cell"
        },
        {
          "label": "transmission",
          "children": [
            {
              "label": "transplacental"
            },
            {
              "label": "sexual contact"
            },
            {
              "label": "blood transfusion"
            },
            {
              "label": "breast feeding",
              "children": [
                {
                  "label": "adult T-cell leukemia/lymphoma (ATL)"
                }
              ]
            }
          ]
        },
        {
          "label": "diseases",
          "children": [
            {
              "label": "HTLV-1–associated myelopathy/tropical spastic paralysis (HAM/TSP)"
            },
            {
              "label": "HTLV-1 uveitis (HU)"
            }
          ]
        },
        {
          "label": "diagnostic tests",
          "children": [
            {
              "label": "serologic testing"
            },
            {
