    },
    {
      "label": "Acute Nongranulomatous Anterior Uveitis",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "sudden onset of",
              "children": [
                {
                  "label": "pain"
                },
                {
                  "label": "redness"
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "decreased vision"
                }
              ]
            },
            {
              "label": "fine keratic precipitates (KPs)"
            },
            {
              "label": "intense cellular response and variable flare in AC"
            },
            {
              "label": "severe cases",
              "children": [
                {
                  "label": "hypopyon"
                },
                {
                  "label": "protein coagulum in the aqueous"
                }
              ]
            },
            {
              "label": "+- elevated intraocular pressure (IOP)"
            },
            {
              "label": "+- cellular response in the anterior vitreous"
            },
            {
              "label": "+- fibrin net across the pupillary margin",
              "children": [
                {
                  "label": "seclusion membrane and iris bombé"
                }
              ]
            },
            {
              "label": "+- dilated iris vessels",
              "children": [
                {
                  "label": "spontaneous hyphema",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                }
              ]
            },
            {
              "label": "+- cystoid macular edema (CME)"
            },
            {
              "label": "+- disc edema"
            },
            {
              "label": "lasts several days - weeks",
              "children": [
                {
                  "label": "≤3 months"
                }
              ]
            }
          ]
        },
        {
          "label": "2 patterns",
          "children": [
            {
              "label": "first pattern",
              "children": [
                {
                  "label": "attack is acute and unilateral",
                  "children": [
                    {
                      "label": "history of episodes alternating between the 2 eyes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "second pattern",
              "children": [
                {
                  "label": "attack is acute and bilateral",
                  "children": [
                    {
                      "label": "typical for HLA-B27–associated anterior uveitis"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "topical corticosteroids are the first line of treatment",
              "children": [
                {
                  "label": "every 1–2 hours"
                }
              ]
            },
            {
              "label": "periocular or oral corticosteroids may be used for severe episodes"
            },
            {
              "label": "recurrent course",
              "children": [
                {
                  "label": "maintenance therapy with low-dose topical corticosteroids"
                }
              ]
            },
            {
              "label": "can transform from acute to chronic",
              "children": [
                {
                  "label": "risk of chronicity can be reduced by timely diagnosis and aggressive initial therapy"
                }
              ]
            },
            {
              "label": "corticosteroid-sparing drugs",
              "children": [
                {
                  "label": "for long-term therapy in chronic or frequently recurrent anterior uveitis"
                },
                {
                  "label": "anti-TNF therapy",
                  "children": [
                    {
                      "label": "particularly in HLA-B27–positive patients"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Cycloplegic agents",
              "children": [
                {
                  "label": "to relieve pain and to break and prevent formation of synechiae"
                },
                {
                  "label": "topical"
                },
                {
                  "label": "conjunctival cotton pledgets soaked in tropicamide, cyclopentolate, or phenylephrine hydrochloride"
                }
              ]
            }
          ]
        },
        {
          "label": "HLA-B27",
          "children": [
            {
              "label": "major histocompatibility complex (MHC) class I antigen"
            },
            {
              "label": "6.1% of US general population"
            },
            {
              "label": "1.1% of African Americans"
            },
            {
              "label": "1/2 of patients with acute anterior uveitis are HLA-B27 positive",
              "children": [
                {
                  "label": "patients with recurrent anterior nongranulomatous uveitis should be tested for HLA-B27"
                }
              ]
            },
            {
              "label": "25% of HLA-B27–positive patients develop spondyloarthritis or eye disease"
            },
            {
              "label": "seronegative spondyloarthropathies",
              "children": [
                {
                  "label": "strongly associated with both acute anterior uveitis and HLA-B27"
                },
                {
                  "label": "do not test positive for rheumatoid factor"
                },
                {
                  "label": "diseases",
                  "children": [
                    {
                      "label": "ankylosing spondylitis"
                    },
                    {
                      "label": "reactive arthritis syndrome"
                    },
                    {
                      "label": "inflammatory bowel disease"
                    },
                    {
                      "label": "psoriatic arthritis"
                    }
                  ]
                }
              ]
            }
          ]
        }
