    },
    {
      "label": "Noninfectious Scleritis",
      "children": [
        {
          "label": "classification",
          "children": [
            {
              "label": "anterior or posterior"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "infection"
                },
                {
                  "label": "trauma"
                },
                {
                  "label": "drug induced"
                },
                {
                  "label": "autoimmunity",
                  "children": [
                    {
                      "label": "systemic disease",
                      "children": [
                        {
                          "label": "especially rheumatoid arthritis"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "nonsteroidal anti-inflammatory drugs",
              "children": [
                {
                  "label": "useful primarily in milder cases",
                  "children": [
                    {
                      "label": "relieve pain"
                    },
                    {
                      "label": "reduce inflammation"
                    }
                  ]
                },
                {
                  "label": "indomethacin, flurbiprofen, and naproxen"
                },
                {
                  "label": "if the initial NSAID fails, a second can be tried before switching to corticosteroids"
                }
              ]
            },
            {
              "label": "corticosteroids",
              "children": [
                {
                  "label": "topical",
                  "children": [
                    {
                      "label": "potentially useful in mild cases",
                      "children": [
                        {
                          "label": "difluprednate"
                        },
                        {
                          "label": "prednisolone acetate"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "subconjunctival",
                  "children": [
                    {
                      "label": "effective in anterior nonnecrotizing scleritis"
                    }
                  ]
                },
                {
                  "label": "systemic corticosteroids",
                  "children": [
                    {
                      "label": "theoretical complication of localized necrotizing disease"
                    },
                    {
                      "label": "orally or as a high-dose intravenous pulse when rapid control is required"
                    }
                  ]
                }
              ]
            },
            {
              "label": "immunomodulatory therapy",
              "children": [
                {
                  "label": "indications",
                  "children": [
                    {
                      "label": "nonresponsive to corticosteroids"
                    },
                    {
                      "label": "requires doses of corticosteroids too high for long-term use"
                    }
                  ]
                },
                {
                  "label": "antimetabolites",
                  "children": [
                    {
                      "label": "methotrexate"
                    },
                    {
                      "label": "azathioprine"
                    },
                    {
                      "label": "mycophenolate mofetil"
                    }
                  ]
                },
                {
                  "label": "calcineurin inhibitors (inhibitors of T-cell signaling)"
                },
                {
                  "label": "biologic agents",
                  "children": [
                    {
                      "label": "TNF inhibitors"
                    },
                    {
                      "label": "rituximab"
                    }
                  ]
                }
              ]
            },
            {
              "label": "require more aggressive therapy (cyclophosphamide)",
              "children": [
                {
                  "label": "granulomatosis with polyangiitis (Wegener granulomatosis)"
                },
                {
                  "label": "polyarteritis nodosa"
                }
              ]
            },
            {
              "label": "pain management",
              "children": [
                {
                  "label": "oral NSAIDs"
                },
                {
                  "label": "oral narcotics",
                  "children": [
                    {
                      "label": "for brief periods",
                      "children": [
                        {
                          "label": "their use in combination with oral corticosteroids or other systemic therapies should be avoided"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "topical cycloplegia"
                }
              ]
            },
            {
              "label": "surgery",
              "children": [
                {
                  "label": "scleral reinforcement surgery for scleral thinning",
                  "children": [
                    {
                      "label": "to prevent globe rupture"
                    }
                  ]
                },
                {
                  "label": "materials",
                  "children": [
                    {
                      "label": "cadaveric donor sclera",
                      "children": [
                        {
                          "label": "scleral graft may melt"
                        }
                      ]
                    },
                    {
                      "label": "autogenous periosteum"
                    }
                  ]
                }
              ]
            }
