    },
    {
      "label": "Primary Congenital Glaucoma (PCG)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "PCG accounts for majority of primary pediatric glaucomas"
            },
            {
              "label": "70% bilateral"
            },
            {
              "label": "75% diagnosed within the first year of life"
            },
            {
              "label": "ethnicity",
              "children": [
                {
                  "label": "65% M"
                },
                {
                  "label": "Slovakian Roms",
                  "children": [
                    {
                      "label": "1 in 1250"
                    }
                  ]
                },
                {
                  "label": "Great Britain",
                  "children": [
                    {
                      "label": "1 in 18,500"
                    }
                  ]
                }
              ]
            },
            {
              "label": "consanguinity greatly increases the risk"
            },
            {
              "label": "without a family history of PCG, an affected parent has a 2% chance of having a child with PCG"
            },
            {
              "label": "newborn PCG",
              "children": [
                {
                  "label": "25%"
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "increased outflow resistance through the trabecular meshwork"
            },
            {
              "label": "developmental anomaly of the neural crest– derived tissue of the anterior chamber angle",
              "children": [
                {
                  "label": "dysgenesis and compression of the trabecular meshwork"
                },
                {
                  "label": "anterior insertion of the iris root"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "classic triad",
              "children": [
                {
                  "label": "epiphora"
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "blepharospasm"
                }
              ]
            },
            {
              "label": "increased corneal diameter and enlargement of the globe (buphthalmos)",
              "children": [
                {
                  "label": "until age 3, elevated IOP causes the cornea to stretch"
                }
              ]
            },
            {
              "label": "Haab striae",
              "children": [
                {
                  "label": "breaks in Descemet membrane"
                },
                {
                  "label": "corneal edema"
                },
                {
                  "label": "corneal opacification"
                }
              ]
            },
            {
              "label": ".>age 3 years",
              "children": [
                {
                  "label": "cornea does not continue to enlarge"
                },
                {
                  "label": "scleral stretching causes progressive myopia"
                }
              ]
            }
          ]
        },
        {
          "label": "worse prognosis",
          "children": [
            {
              "label": "newborn PCG",
              "children": [
                {
                  "label": "1/2 patients with newborn PCG progress to legal blindness"
                }
              ]
            },
            {
              "label": "glaucoma diagnosed >1 year of age"
            },
            {
              "label": "corneal diameter >14 mm"
            },
            {
              "label": "prognosis best for patients whose glaucoma is diagnosed between 3 and 12 months",
              "children": [
                {
                  "label": "vast majority respond to angle surgery"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis",
          "children": [
            {
              "label": "PCG should be considered in the differential diagnosis of any child who presents with tearing",
              "children": [
                {
                  "label": "See Table 6-3"
                },
                {
                  "label": "milder cases have fewer signs and symptoms and may be misdiagnosed as nasolacrimal duct obstruction"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "surgical intervention"
            },
            {
              "label": "medical therapy",
              "children": [
                {
                  "label": "limited long-term value"
                },
                {
                  "label": "may be used to temporize or reduce corneal edema to improve visualization during surgery"
                }
              ]
            }
          ]
        }
      ]
    },
