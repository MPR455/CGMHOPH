                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "intensive topical corticosteroid administration for the acute phase (first 10–14 days)",
                  "children": [
                    {
                      "label": "dosage should be markedly reduced after 10– 14 days"
                    }
                  ]
                }
              ]
            },
            {
              "label": "oral tetracyclines/topical 10% sodium citrate",
              "children": [
                {
                  "label": "chelators of extracellular calcium",
                  "children": [
                    {
