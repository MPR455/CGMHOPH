      "label": "Management of Chemical Injuries",
      "children": [
        {
          "label": "immediate and copious irrigation of the ocular surface",
          "children": [
            {
              "label": "water or balanced saline solution",
              "children": [
                {
                  "label": "any other generally nontoxic and unpolluted solutions"
                }
              ]
            },
            {
              "label": "initiated at the site of the chemical injury and continued until an ophthalmologist evaluates the patient"
            },
            {
              "label": "eyelid should be immobilized with a retractor or eyelid speculum"
            },
            {
              "label": "topical anesthetic"
            },
            {
              "label": "continue until the pH of the conjunctival sac normalizes",
              "children": [
                {
                  "label": "urinary pH strip"
                }
              ]
            },
            {
              "label": "particulate chemicals should be removed",
              "children": [
                {
                  "label": "eversion of the upper eyelid",
                  "children": [
                    {
                      "label": "“overtreat” for prolonged periods of irrigation than to “guess” that the pH has normalized"
                    }
                  ]
                },
                {
                  "label": "fornices should be swept with an applicator"
                }
              ]
            }
          ]
        },
        {
          "label": "decreasing inflammation",
          "children": [
            {
              "label": "corticosteroids",
              "children": [
                {
                  "label": "inhibit PMN function",
                  "children": [
                    {
                      "label": "intense PMN leukocyte infiltration of the corneal stroma",
                      "children": [
                        {
                          "label": "release of proteolytic enzymes",
                          "children": [
