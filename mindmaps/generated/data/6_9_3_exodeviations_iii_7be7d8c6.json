{
  "label": "6.9.3. Exodeviations (III)",
  "root": true,
  "children": [
    {
      "label": "Convergence Weakness Exotropia",
      "children": [
        {
          "label": "near exodeviation > distance exodeviation"
        },
        {
          "label": "2 main types",
          "children": [
            {
              "label": "convergence insufficiency (CI)",
              "children": [
                {
                  "label": "minimal or no exodeviation at distance"
                },
                {
                  "label": "usually older",
                  "children": [
                    {
                      "label": "teenagers or adults"
                    },
                    {
                      "label": "more commonly in patients with Parkinson disease"
                    }
                  ]
                },
                {
                  "label": "symptoms",
                  "children": [
                    {
                      "label": "asthenopia"
                    },
                    {
                      "label": "blurred near vision"
                    },
                    {
                      "label": "diplopia"
                    },
                    {
                      "label": "accommodative spasms may occur"
                    },
                    {
                      "label": "most noticeable during reading"
                    }
                  ]
                },
                {
                  "label": "examination",
                  "children": [
                    {
                      "label": "poor near fusional convergence amplitudes",
                      "children": [
                        {
                          "label": "remote near point of convergence",
                          "children": [
                            {
                              "label": ".>10 cm"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "treatment",
                  "children": [
                    {
                      "label": "orthoptic near-point exercises",
                      "children": [
                        {
                          "label": "base-out prisms",
                          "children": [
                            {
                              "label": "to stimulate fusional convergence during reading"
                            }
                          ]
                        },
                        {
                          "label": "stereograms"
                        },
                        {
                          "label": "pencil push-ups"
                        },
                        {
                          "label": "computer-based convergence training programs"
                        }
                      ]
                    },
                    {
                      "label": "base-in prism reading glasses",
                      "children": [
                        {
                          "label": "if near-point exercises fail to relieve symptoms"
                        }
                      ]
                    },
                    {
                      "label": "surgical treatment",
                      "children": [
                        {
                          "label": "medial rectus muscle resections",
                          "children": [
                            {
                              "label": "in patients whose problems persist despite medical therapy"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "convergence weakness associated with both near exodeviation & distance exodeviation",
              "children": [
                {
                  "label": "near exodeviation > distance exodeviation"
                },
                {
                  "label": "etiology",
                  "children": [
                    {
                      "label": "previous medial rectus muscle recessions",
                      "children": [
                        {
                          "label": "show underaction of these muscles"
                        },
                        {
                          "label": "treatment",
                          "children": [
                            {
                              "label": "advancement of the previously recessed medial rectus muscles",
                              "children": [
                                {
                                  "label": "±",
                                  "children": [
                                    {
                                      "label": "recession of the lateral rectus muscles"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "no previous medial rectus muscle surgery",
                      "children": [
                        {
                          "label": "treatment",
                          "children": [
                            {
                              "label": "standard amount of lateral rectus muscle recession and medial rectus resection are reversed"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Other Forms of Exotropia",
      "children": [
        {
          "label": "Exotropic Duane Retraction Syndrome",
          "children": [
            {
              "label": "DRS can present with exotropia"
            },
            {
              "label": "deficient adduction"
            },
            {
              "label": "head turn away from the affected eye"
            }
          ]
        },
        {
          "label": "Neuromuscular Abnormalities",
          "children": [
            {
              "label": "third nerve palsy"
            },
            {
              "label": "internuclear ophthalmoplegia"
            },
            {
              "label": "myasthenia gravis"
            }
          ]
        },
        {
          "label": "dissociated horizontal deviation (DHD)",
          "children": [
            {
              "label": "dissociated strabismus complex",
              "children": [
                {
                  "label": "may include vertical, horizontal, and torsional components"
                }
              ]
            },
            {
              "label": "dissociated abduction movement",
              "children": [
                {
                  "label": "not a true exotropia"
                },
                {
                  "label": "can be confused with a constant or intermittent exotropia"
                }
              ]
            },
            {
              "label": "dissociated vertical deviation and latent nystagmus often coexist with DHD"
            },
            {
              "label": "DHD must be differentiated from anisohyperopia associated with intermittent exotropia",
              "children": [
                {
                  "label": "exotropic deviation is present when the patient fixates with the normal eye"
                },
                {
                  "label": "exotropic deviation is absent during fixation with the hyperopic eye because of accommodation"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "unilateral or bilateral lateral rectus recession"
                },
                {
                  "label": "± oblique or vertical muscle surgery"
                }
              ]
            }
          ]
        },
        {
          "label": "Convergence Paralysis",
          "children": [
            {
              "label": "etiology",
              "children": [
                {
                  "label": "intracranial lesion",
                  "children": [
                    {
                      "label": "most commonly associated with dorsal midbrain syndrome"
                    }
                  ]
                }
              ]
            },
            {
              "label": "normal adduction and accommodation"
            },
            {
              "label": "exotropia and diplopia present at attempted near fixation only"
            },
            {
              "label": "differential diagnosis",
              "children": [
                {
                  "label": "malingering or lack of effort",
                  "children": [
                    {
                      "label": "distinguished by absence of pupillary reaction when instructed to focus at near"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "base-in prisms at near",
                  "children": [
                    {
                      "label": "to alleviate diplopia"
                    }
                  ]
                },
                {
                  "label": "plus lenses may be required if accommodation is limited"
                },
                {
                  "label": "monocular occlusion is indicated if diplopia cannot be otherwise treated"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Constant Exotropia",
      "children": [
        {
          "label": "Introduction",
          "children": [
            {
              "label": "etiology",
              "children": [
                {
                  "label": "older patients with sensory exotropia"
                },
                {
                  "label": "decompensated long-standing intermittent exotropia"
                }
              ]
            },
            {
              "label": "surgical treatment",
              "children": [
                {
                  "label": "bilateral lateral rectus muscle recessions"
                },
                {
                  "label": "unilateral lateral rectus muscle recession + medial rectus muscle resection"
                },
                {
                  "label": ".>50Δ exodeviations",
                  "children": [
                    {
                      "label": "surgery on 3 or 4 muscles is sometimes performed"
                    }
                  ]
                }
              ]
            },
            {
              "label": "enlarged field of peripheral vision",
              "children": [
                {
                  "label": "may notice field constriction when eyes are straightened!"
                }
              ]
            }
          ]
        },
        {
          "label": "Infantile Exotropia",
          "children": [
            {
              "label": "much less common than infantile esotropia"
            },
            {
              "label": "< age 6 months"
            },
            {
              "label": "large-angle constant exodeviation"
            },
            {
              "label": "history of developmental delay",
              "children": [
                {
                  "label": "refer for neurologic assessment if there are indications of delay"
                }
              ]
            },
            {
              "label": "increased risk of",
              "children": [
                {
                  "label": "associated neurologic impairment"
                },
                {
                  "label": "craniofacial disorders"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "early surgery",
                  "children": [
                    {
                      "label": "can lead to monofixation with gross binocular vision",
                      "children": [
                        {
                          "label": "restoration of normal binocular function is rare"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "outcomes similar to those for infantile esotropia"
                }
              ]
            },
            {
              "label": "may develop",
              "children": [
                {
                  "label": "dissociated vertical deviations"
                },
                {
                  "label": "overelevation in adduction"
                }
              ]
            }
          ]
        },
        {
          "label": "Sensory Exotropia",
          "children": [
            {
              "label": "any condition that severely reduces vision in 1 eye",
              "children": [
                {
                  "label": "anisometropia"
                },
                {
                  "label": "corneal or lens opacities"
                },
                {
                  "label": "optic atrophy or hypoplasia"
                },
                {
                  "label": "retinal lesions"
                },
                {
                  "label": "amblyopia"
                }
              ]
            },
            {
              "label": "some persons become esotropic and others exotropic after unilateral vision loss",
              "children": [
                {
                  "label": "both sensory esotropia and sensory exotropia occur in infants and young children"
                },
                {
                  "label": "exotropia predominates in older children and adults"
                }
              ]
            },
            {
              "label": "if vision in exotropic eye can be improved, peripheral fusion may sometimes be reestablished after surgical realignment",
              "children": [
                {
                  "label": "provided sensory exotropia has not been present for an extended period"
                }
              ]
            },
            {
              "label": "central fusion disruption",
              "children": [
                {
                  "label": "develops when adult-onset sensory exotropia has been present for several years"
                },
                {
                  "label": "can lead to constant and permanent diplopia even with well-aligned eyes"
                }
              ]
            }
          ]
        },
        {
          "label": "Consecutive Exotropia",
          "children": [
            {
              "label": "occurs after a period of esotropia",
              "children": [
                {
                  "label": "spontaneous",
                  "children": [
                    {
                      "label": "rare"
                    }
                  ]
                },
                {
                  "label": "after previous surgery for esotropia",
                  "children": [
                    {
                      "label": "more common"
                    }
                  ]
                }
              ]
            },
            {
              "label": "develops within a few months or years after initial surgery",
              "children": [
                {
                  "label": "in some patients with infantile esotropia, exotropia may not develop until adulthood"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
