{
  "label": "8.7.2. Immune-mediated diseases (II): Conjunctiva (I)",
  "root": true,
  "children": [
    {
      "label": "male children"
    },
    {
      "label": "primarily a type IV reaction",
      "children": [
        {
          "label": "mast-cell therapy may not be effective!"
        }
      ]
    },
    {
      "label": "hotter climates"
    },
    {
      "label": "atopic keratoconjunctivitis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "1/3 of patients with atopic dermatitis"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "type I immediate hypersensitivity responses"
            },
            {
              "label": "depressed systemic cell-mediated immunity",
              "children": [
                {
                  "label": "susceptible to",
                  "children": [
                    {
                      "label": "herpes simplex virus keratitis"
                    },
                    {
                      "label": "colonization of the eyelids with staphylococcus aureus"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "similar to VKC with the following differences",
              "children": [
                {
                  "label": "have disease year-round (minimal seasonal exacerbation)"
                },
                {
                  "label": "patients are older"
                },
                {
                  "label": "papillae are small or medium-sized (than giant)"
                },
                {
                  "label": "papillae occur in the upper and lower palpebral conjunctiva"
                },
                {
                  "label": "milky conjunctival edema + variable subepithelial fibrosis"
                },
                {
                  "label": "extensive corneal vascularization and opacification (limbal stem cell dysfunction)"
                },
                {
                  "label": "eosinophils in conjunctival cytology specimens are less numerous and are less often degranulated"
                },
                {
                  "label": "conjunctival scarring; occasional symblepharon formation"
                },
                {
                  "label": "characteristic posterior subcapsular and/or anterior subcapsular lens opacities"
                },
                {
                  "label": "corneal findings",
                  "children": [
                    {
                      "label": "punctate erosions"
                    },
                    {
                      "label": "persistent epithelial defects"
                    },
                    {
                      "label": "increased incidence of ectatic corneal diseases such as keratoconus and pellucid marginal degeneration"
                    },
                    {
                      "label": "increased incidence of staphylococcal and herpes simplex infections"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "allergen avoidance"
            },
            {
              "label": "cold compress"
            },
            {
              "label": "monitor for complications of infectious diseases"
            },
            {
              "label": "pharmacotherapeutic agents similar to those used in the treatment of VKC"
            },
            {
              "label": "systemic immune suppression",
              "children": [
                {
                  "label": "severe cases",
                  "children": [
                    {
                      "label": "chronic ocular surface inflammation unresponsive to topical treatment"
                    },
                    {
                      "label": "discomfort"
                    },
                    {
                      "label": "progressive cicatrization"
                    },
                    {
                      "label": "peripheral ulcerative keratopathy"
                    }
                  ]
                },
                {
                  "label": "oral cyclosporine"
                },
                {
                  "label": "in coordination with an internist or rheumatologist"
                }
              ]
            },
            {
              "label": "topical tacrolimus",
              "children": [
                {
                  "label": "dermatitis"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "vernal keratoconjunctivitis (VKC)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "seasonally recurring"
            },
            {
              "label": "year-round in tropical climates"
            },
            {
              "label": "personal or family history of atopy"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "conjunctival inflammatory infiltrate",
              "children": [
                {
                  "label": "types I and IV hypersensitivity reactions"
                },
                {
                  "label": "eosinophils, lymphocytes, plasma cells, and monocytes"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "bilateral"
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "itching"
                },
                {
                  "label": "blepharospasm"
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "blurred vision"
                },
                {
                  "label": "copious mucoid discharge"
                }
              ]
            },
            {
              "label": "2 forms",
              "children": [
                {
                  "label": "palpebral VKC",
                  "children": [
                    {
                      "label": "diffuse papillary hypertrophy",
                      "children": [
                        {
                          "label": "more prominently on the upper region"
                        }
                      ]
                    },
                    {
                      "label": "bulbar conjunctival hyperemia and chemosis",
                      "children": [
                        {
                          "label": "giant papillae resembling cobblestones",
                          "children": [
                            {
                              "label": "upper tarsus"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "limbal VKC",
                  "children": [
                    {
                      "label": "african or asian descent"
                    },
                    {
                      "label": "alone or in association with palpebral vkc"
                    },
                    {
                      "label": "thick gelatinous limbus"
                    },
                    {
                      "label": "vascular injection",
                      "children": [
                        {
                          "label": "scattered opalescent mounds"
                        }
                      ]
                    },
                    {
                      "label": "Horner-Trantas dots",
                      "children": [
                        {
                          "label": "whitish macroaggregates of degenerated eosinophils and epithelial cells"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "corneal changes",
              "children": [
                {
                  "label": "punctate epithelial erosions",
                  "children": [
                    {
                      "label": "superior and central cornea"
                    }
                  ]
                },
                {
                  "label": "pannus",
                  "children": [
                    {
                      "label": "occasionally 360°",
                      "children": [
                        {
                          "label": "superior cornea"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "noninfectious epithelial ulcers",
                  "children": [
                    {
                      "label": "superior or central cornea"
                    },
                    {
                      "label": "underlying stromal opacification"
                    }
                  ]
                },
                {
                  "label": "keratoconus"
                },
                {
                  "label": "stem cell deficiency"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "mild cases",
              "children": [
                {
                  "label": "topical antihistamines"
                },
                {
                  "label": "climatotherapy",
                  "children": [
                    {
                      "label": "home air-conditioning"
                    },
                    {
                      "label": "relocation to a cooler environment"
                    }
                  ]
                }
              ]
            },
            {
              "label": "mild to moderate disease",
              "children": [
                {
                  "label": "topical mast-cell stabilizers",
                  "children": [
                    {
                      "label": "start at least 2 weeks before symptoms usually begin"
                    }
                  ]
                }
              ]
            },
            {
              "label": "severe cases",
              "children": [
                {
                  "label": "topical corticosteroids",
                  "children": [
                    {
                      "label": "for exacerbations with moderate to severe discomfort and/or decreased vision"
                    },
                    {
                      "label": "intermittent (pulse) therapy",
                      "children": [
                        {
                          "label": "every 2 hours for 5–7 days and then rapidly tapered"
                        },
                        {
                          "label": "soluble corticosteroids",
                          "children": [
                            {
                              "label": "difluprednate ophthalmic emulsion (durezol)"
                            },
                            {
                              "label": "dexamethasone phosphate"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "supratarsal injection of corticosteroid",
                  "children": [
                    {
                      "label": "evert the upper eyelid"
                    },
                    {
                      "label": "dexamethasone phosphate (4 mg/ml)"
                    },
                    {
                      "label": "triamcinolone acetonide (40 mg/ml)"
                    },
                    {
                      "label": "0.5–1.0 ml"
                    }
                  ]
                },
                {
                  "label": "topical immunomodulatory agents",
                  "children": [
                    {
                      "label": "cyclosporine",
                      "children": [
                        {
                          "label": "2–4 times daily"
                        },
                        {
                          "label": "punctate epithelial keratopathy"
                        },
                        {
                          "label": "ocular surface irritation"
                        },
                        {
                          "label": "minimal systemic absorption"
                        }
                      ]
                    },
                    {
                      "label": "tacrolimus",
                      "children": [
                        {
                          "label": "twice daily"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "very severe cases",
              "children": [
                {
                  "label": "systemic anti-inflammatory therapy"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "oval or shieldlike"
    },
    {
