              "label": "death can occur in 3%–15%"
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Treatment",
      "children": [
        {
          "label": "admit in stroke unit"
        },
        {
          "label": "anticoagulants"
        },
        {
          "label": "fibrinolytic drugs"
        },
        {
          "label": "treatments to lower intracranial pressure"
        },
        {
          "label": "antiepileptic drugs"
        },
        {
          "label": "steroids are not used unless required for management of underlying inflammatory disease"
        }
      ]
    },
    {
      "label": "Laboratory evaluation",
      "children": [
        {
          "label": "see predisposing conditions"
        }
      ]
    },
    {
      "label": "Diagnosis",
      "children": [
        {
          "label": "CT or MRI"
        },
        {
          "label": "targeted venographic study",
          "children": [
            {
              "label": "magnetic resonance venography (MRV)"
            },
            {
              "label": "computed tomography venography (CTV)"
            },
            {
              "label": "cerebral venography",
              "children": [
                {
                  "label": "cases in which clinical suspicion is high despite normal CTV or MRV"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Superior sagittal sinus (SSS) thrombosis",
      "children": [
        {
          "label": "most commonly involved cerebral venous sinus"
        },
        {
          "label": "thrombosis of anterior third of SSS",
          "children": [
            {
              "label": "symptoms are mild or absent"
            }
          ]
        },
        {
          "label": "posterior SSS thrombosis",
          "children": [
            {
              "label": "clinical picture similar to that of IIH",
              "children": [
                {
                  "label": "headaches"
                },
                {
                  "label": "papilledema"
                },
                {
                  "label": "± seizures"
                },
                {
                  "label": "± motor deficits",
                  "children": [
                    {
                      "label": "also consider (dural) AVM and lateral sinus thrombosis"
                    }
                  ]
                },
                {
                  "label": "consider SSS thrombosis in atypical IIH patients, such as slim women and men"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Lateral (transverse) sinus thrombosis",
      "children": [
        {
          "label": "2 forms",
          "children": [
            {
              "label": "septic",
              "children": [
                {
                  "label": "rare",
                  "children": [
                    {
                      "label": "may result from otitis media"
                    }
                  ]
                }
              ]
            },
            {
              "label": "spontaneous",
              "children": [
                {
                  "label": "more common"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "features of systemic infection"
            },
            {
              "label": "neck pain",
              "children": [
                {
                  "label": "tenderness of the ipsilateral jugular vein"
                }
              ]
            },
            {
              "label": "± facial weakness",
              "children": [
                {
                  "label": "retroauricular edema"
                }
              ]
            },
            {
              "label": "± severe facial pain",
              "children": [
                {
                  "label": "Gradenigo syndrome",
                  "children": [
                    {
                      "label": "facial pain + sixth nerve palsy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "IIH-like syndrome",
              "children": [
                {
                  "label": "\"otitic hydrocephalus\""
                },
                {
                  "label": "much more likely to produce an IIH-like syndrome with increased intracranial pressure"
                }
              ]
            },
            {
              "label": "most common ophthalmic signs are papilledema and sixth nerve palsy"
            }
          ]
        }
      ]
    },
