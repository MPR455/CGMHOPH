                  "label": "oral contraceptives"
                },
                {
                  "label": "cancer"
                },
                {
                  "label": "facial infections"
                },
                {
                  "label": "inflammatory diseases"
                }
              ]
            }
          ]
        },
        {
          "label": "pregnancy",
          "children": [
            {
              "label": "headaches",
              "children": [
                {
                  "label": "lateral and superior sagittal sinuses are more commonly affected",
                  "children": [
                    {
                      "label": "hematologic diseases"
                    }
                  ]
                }
              ]
            },
            {
              "label": "papilledema",
              "children": [
                {
                  "label": "simulate IIH"
                }
              ]
            }
          ]
        },
        {
          "label": "thrombosis of the deep veins",
