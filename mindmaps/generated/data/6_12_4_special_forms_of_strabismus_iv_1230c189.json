    {
      "label": "Chronic Progressive External Ophthalmoplegia (CPEO)",
      "children": [
        {
          "label": "clinical features",
          "children": [
            {
              "label": "rare",
              "children": [
                {
                  "label": "mitochondrial cytopathy"
                }
              ]
            },
            {
              "label": "heredity",
              "children": [
                {
                  "label": "sporadic"
                },
                {
                  "label": "familial"
                }
              ]
            },
            {
              "label": "begins in childhood"
            },
            {
              "label": "ptosis"
            },
            {
              "label": "constricted visual fields",
              "children": [
                {
                  "label": "slowly progresses to total paralysis of the eyelids and EOMs"
                }
              ]
            },
            {
              "label": "electrodiagnostic abnormalities"
            },
            {
              "label": "diagnosis",
              "children": [
                {
                  "label": "specific alterations of mitochondrial DNA",
                  "children": [
                    {
                      "label": "muscle biopsy show ragged red fibers"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Kearns-Sayre syndrome",
              "children": [
                {
                  "label": "retinal pigmentary changes"
                },
                {
                  "label": "CPEO"
                },
                {
                  "label": "cardiomyopathy (especially heart block)",
                  "children": [
                    {
                      "label": "life-threatening arrhythmias can occur"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "cardiac status evaluation",
              "children": [
                {
                  "label": "true pigmentary retinal dystrophy is usually absent"
                }
              ]
            },
            {
              "label": "treatment options for the ocular motility disorder are limited",
              "children": [
                {
                  "label": "high rate of long-term undercorrections"
                }
              ]
            },
            {
              "label": "cautious surgical elevation (suspension) of the upper eyelids can lessen a severe chin-up head posture"
            }
          ]
        }
      ]
    },
    {
      "label": "strabismus associated with other ocular surgery",
      "children": [
        {
          "label": "refractive surgery",
          "children": [
            {
              "label": "to create monovision",
              "children": [
                {
                  "label": "can result in dissimilar sensory input to the 2 eyes",
                  "children": [
                    {
                      "label": "can be sufficient to cause disruption of fusion in predisposed patients"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "surgery for retinal detachment",
          "children": [
            {
              "label": "scarring from dissection of the EOMs and the application of devices (scleral buckle)"
            },
            {
              "label": "corrective surgery can be extremely difficult, especially if these elements must be removed"
            }
          ]
        },
        {
          "label": "macular translocation surgery can cause torsional diplopia"
        },
        {
          "label": "glaucoma drainage devices",
          "children": [
            {
              "label": "may require removal or relocation or substitution of the device"
            }
          ]
        },
        {
          "label": "retrobulbar injections",
          "children": [
            {
              "label": "direct injury to the muscle"
            },
            {
              "label": "toxic effect of the injected material"
            },
            {
              "label": "vertical rectus muscles are most vulnerable"
            }
          ]
        },
        {
          "label": "injection of botulinum toxin into eyelids",
          "children": [
            {
              "label": "transient paralyzing effect"
            }
          ]
        },
        {
          "label": "pterygium removal or endoscopic sinus surgery",
          "children": [
            {
              "label": "laceration or inadvertent excision of an entire section of the medial rectus muscle"
            }
          ]
        }
      ]
    },
    {
      "label": "superior oblique myokymia",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "aberrant regeneration of fourth cranial nerve fibers"
            },
            {
              "label": "vascular compression of the nerve"
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "otherwise neurologically normal",
              "children": [
                {
                  "label": "abnormal torsional movements of the eye that cause diplopia and monocular oscillopsia"
                }
              ]
            },
            {
              "label": "recurrences may persist indefinitely"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "treatment is not necessary if the patient is not disturbed by the visual symptoms"
            },
            {
              "label": "first-line treatment",
              "children": [
                {
                  "label": "systemic medications",
                  "children": [
                    {
                      "label": "carbamazepine"
                    },
                    {
                      "label": "phenytoin"
                    },
                    {
                      "label": "propranolol"
                    },
                    {
                      "label": "baclofen"
                    },
                    {
                      "label": "gabapentin"
                    },
                    {
                      "label": "topical timolol"
                    },
                    {
                      "label": "some patients will benefit, at least in the short term"
                    }
                  ]
                }
              ]
            },
            {
              "label": "surgical treatment",
              "children": [
                {
                  "label": "disconnection of superior oblique muscle from globe by generous tenectomy",
                  "children": [
                    {
                      "label": "results in a superior oblique palsy",
                      "children": [
                        {
                          "label": "some surgeons perform simultaneous inferior oblique muscle weakening"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "myasthenia gravis",
      "children": [
        {
          "label": "introduction",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "antibodies directed against acetylcholine receptors"
                }
              ]
            },
            {
              "label": "transient neonatal form",
              "children": [
                {
                  "label": "usually subsides rapidly",
                  "children": [
                    {
                      "label": "caused by the placental transfer of acetylcholine receptor antibodies of mothers with myasthenia gravis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "onset in childhood is uncommon"
            },
            {
              "label": "± purely ocular"
            },
            {
              "label": "± part of a systemic disorder",
              "children": [
                {
                  "label": "less common in childhood-onset than in the adult-onset form"
                }
              ]
            },
            {
              "label": "myasthenia gravis foundation of america, inc"
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "weakening of EOMs, including levator muscle",
              "children": [
                {
                  "label": "most cases (90%) exhibit both ptosis and limited ocular rotations"
                }
              ]
            },
            {
              "label": "ocular signs can resemble any unilateral or bilateral ophthalmoplegia"
            },
            {
              "label": "affected muscles fatigue rapidly",
              "children": [
                {
                  "label": "ptosis typically worsens when the patient looks upward x 30 seconds"
                },
                {
                  "label": "sleep test",
                  "children": [
                    {
                      "label": "patient rests in a dark room with the eyelids closed x 20–30 minutes",
                      "children": [
                        {
                          "label": "ptosis often subsequently resolves"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "external application of ice over the involved eyelids x 2–5 minutes",
                  "children": [
                    {
                      "label": "improves function of levator palpebrae superioris and other affected EOMs"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Cogan lid-twitch sign",
              "children": [
                {
                  "label": "highly suggestive",
                  "children": [
                    {
                      "label": "overshoot of the eyelid when the patient looks straight ahead after looking down for several minutes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "pharmacologic tests",
              "children": [
                {
                  "label": "edrophonium test"
                },
                {
                  "label": "neostigmine test",
                  "children": [
                    {
                      "label": "effect of this agent begins later than that of edrophonium and is prolonged"
                    },
                    {
                      "label": "allows more time to measure changes in alignment"
                    }
                  ]
                }
              ]
            },
            {
              "label": "electromyography",
              "children": [
                {
                  "label": "decreased electrical activity of involved muscles after prolonged voluntary innervations"
                },
                {
                  "label": "single-fiber electromyography",
                  "children": [
                    {
                      "label": "increased activity (including faster saccadic velocity) after administration of edrophonium or neostigmine"
                    }
                  ]
                }
              ]
            },
            {
              "label": "antibodies",
              "children": [
                {
                  "label": "circulating anti–acetylcholine receptor antibody"
                },
                {
                  "label": "anti–muscle-specific kinase antibody"
                },
                {
                  "label": "negative test result does not rule out MG"
                }
              ]
            }
          ]
        },
        {
          "label": "differential diagnosis of ptosis and extraocular muscle involvement",
          "children": [
            {
              "label": "thyroid eye disease"
            },
            {
              "label": "chronic progressive external ophthalmoplegia"
            },
            {
              "label": "myasthenia gravis"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "adults",
              "children": [
                {
                  "label": "ocular manifestations are frequently resistant to usual systemic myasthenia treatment"
                }
              ]
            },
            {
              "label": "children",
              "children": [
                {
                  "label": "often successfully managed with pyridostigmine alone"
                }
              ]
            },
            {
              "label": "ptosis occasionally requires upper eyelid surgery",
              "children": [
                {
                  "label": "in adults and children in whom the ocular deviation has stabilized, standard eye muscle surgery can help restore binocular function in at least some gaze positions"
                }
              ]
            }
          ]
        }
      ]
