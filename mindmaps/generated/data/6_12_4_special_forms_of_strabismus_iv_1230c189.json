            },
            {
              "label": "both eyes adduct normally on convergence"
            },
            {
              "label": "abducting eye exhibits a characteristic horizontal jerk nystagmus"
            },
            {
              "label": "exotropia"
            },
            {
              "label": "± skew deviation"
            },
            {
              "label": "management",
