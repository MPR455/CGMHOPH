    {
      "label": "esotropia and hypotropia associated with high myopia",
      "children": [
        {
          "label": "highly myopic patients"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "inferior slippage of the lateral rectus pulley",
              "children": [
                {
                  "label": "elongated globe herniates between the superior and lateral rectus muscles",
                  "children": [
                    {
                      "label": "stretching and dehiscence of intermuscular septum between these 2 muscles"
