                  "children": [
                    {
                      "label": "with frozen sections"
                    },
                    {
                      "label": "Moh's technique"
                    }
                  ]
                },
                {
                  "label": "lid reconstruction",
                  "children": [
                    {
                      "label": "only if margins clear"
                    }
                  ]
                },
                {
                  "label": "lacrimal drainage system excision",
                  "children": [
                    {
                      "label": "for basal cell carcinomas that involve the medial canthal area",
                      "children": [
