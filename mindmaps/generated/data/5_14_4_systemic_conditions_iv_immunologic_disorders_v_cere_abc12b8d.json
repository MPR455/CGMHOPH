{
  "label": "5.14.4. Systemic Conditions (IV): Immunologic Disorders (IV): Myasthenia Gravis (MG)",
  "root": true,
  "children": [
    {
      "label": "General",
      "children": [
        {
          "label": "usually a systemic disorder",
          "children": [
            {
              "label": "1/2 of affected patients have ocular symptoms/ signs at onset"
            },
            {
              "label": "systemic MG will develop over the next 2 years in ≤85% of patients who present with ocular MG"
            },
            {
              "label": "purely ocular MG does exist",
              "children": [
                {
                  "label": "late conversion to generalized MG is possible",
                  "children": [
                    {
                      "label": "if ocular signs remain truly isolated for >2 years, the disease is likely to remain clinically ocular"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "antibodies against acetylcholine receptors"
            }
          ]
        },
        {
          "label": "precipitating factors",
          "children": [
            {
              "label": "antiarrhythmics"
            },
            {
              "label": "antibiotics"
            },
            {
              "label": "chemotherapeutic drugs"
            },
            {
              "label": "antiepileptics"
            },
            {
              "label": "quinolones"
            },
            {
              "label": "penicillamine"
            },
            {
              "label": "corticosteroids"
            },
            {
              "label": "β-blockers"
            },
            {
              "label": "calcium channel blockers"
            }
          ]
        },
        {
          "label": "references"
        },
        {
          "label": "Lambert-Eaton",
          "children": [
            {
              "label": "decreased presynaptic release of acetylcholine"
            },
            {
              "label": "symptoms worse in the morning"
            },
            {
              "label": "50-80% associated with small cell lung cancer"
            }
          ]
        },
        {
          "label": "botulism",
          "children": [
            {
              "label": "toxin interferes with presynaptic release of acetylcholine"
            },
            {
              "label": "ocular findings",
              "children": [
                {
                  "label": "ptosis",
                  "children": [
                    {
                      "label": "in contrast to MG"
                    }
                  ]
                },
                {
                  "label": "ophthalmoplegia"
                },
                {
                  "label": "dilated non-reactive pupil"
                }
              ]
            }
          ]
        },
        {
          "label": "oculopharyngeal dystrophy",
          "children": [
            {
              "label": "ptosis"
            },
            {
              "label": "dysphagia"
            }
          ]
        },
        {
          "label": "myotonic dystrophy",
          "children": [
            {
              "label": "ophthalmoplegia"
            },
            {
              "label": "ptosis"
            },
            {
              "label": "pigmentary retinopathy"
            },
            {
              "label": "masseter and temporalis wasting"
            },
            {
              "label": "Christmas tree cataract"
            }
          ]
        }
      ]
    },
    {
      "label": "Diagnosis",
      "children": [
        {
          "label": "acetylcholinesterase inhibitor tests",
          "children": [
            {
              "label": "edrophonium chloride test",
              "children": [
                {
                  "label": "short-acting"
                },
                {
                  "label": "rare but serious adverse effects",
                  "children": [
                    {
                      "label": "bradycardia"
                    },
                    {
                      "label": "respiratory arrest"
                    },
                    {
                      "label": "bronchospasm"
                    },
                    {
                      "label": "syncopal episodes"
                    },
                    {
                      "label": "cholinergic crisis",
                      "children": [
                        {
                          "label": "other adverse effects",
                          "children": [
                            {
                              "label": "sweating"
                            },
                            {
                              "label": "lacrimation"
                            },
                            {
                              "label": "salivation"
                            },
                            {
                              "label": "nausea"
                            },
                            {
                              "label": "vomiting"
                            },
                            {
                              "label": "fasciculations"
                            },
                            {
                              "label": "abdominal cramping"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "not commonly performed in eye clinics"
                    },
                    {
                      "label": "atropine sulfate (0.4–0.6 mg) should be available",
                      "children": [
                        {
                          "label": "some physicians pretreat with atropine (0.4 mg subcutaneously)"
                        }
                      ]
                    },
                    {
                      "label": "consult the primary physician for patients with a history of cardiac or pulmonary disease"
                    }
                  ]
                },
                {
                  "label": "technique",
                  "children": [
                    {
                      "label": "initial test dose of 2 mg (0.2 mL) intravenously",
                      "children": [
                        {
                          "label": "if no response, inject additional doses of 4 mg",
                          "children": [
                            {
                              "label": "up to a total of 10 mg"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "patient is observed for 60 seconds after injection"
                    }
                  ]
                },
                {
                  "label": "positive test result",
                  "children": [
                    {
                      "label": "symptoms disappear or decrease",
                      "children": [
                        {
                          "label": "eyelid elevates or motility improves",
                          "children": [
                            {
                              "label": "when the ocular symptom is marked, the endpoint is often dramatic"
                            },
                            {
                              "label": "when the ocular symptom is subtle",
                              "children": [
                                {
                                  "label": "Maddox rod tests with prisms"
                                },
                                {
                                  "label": "diplopia fields"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "false-positive responses are rare"
                },
                {
                  "label": "a negative test result does not exclude the diagnosis of MG",
                  "children": [
                    {
                      "label": "repeat testing at a later date"
                    }
                  ]
                }
              ]
            },
            {
              "label": "neostigmine methylsulfate test",
              "children": [
                {
                  "label": "for children and for adults without ptosis who may require a longer observation period for ocular alignment measurements"
                },
                {
                  "label": "adverse reactions",
                  "children": [
                    {
                      "label": "similar to those for edrophonium"
                    },
                    {
                      "label": "salivation"
                    },
                    {
                      "label": "fasciculations"
                    },
                    {
                      "label": "gastrointestinal discomfort"
                    }
                  ]
                },
                {
                  "label": "intramuscular neostigmine and atropine are injected concurrently"
                },
                {
                  "label": "positive test result produces improvement of signs within 30–45 minutes"
                }
              ]
            }
          ]
        },
        {
          "label": "sleep test",
          "children": [
            {
              "label": "patient rests quietly with eyes closed for 30 minutes"
            },
            {
              "label": "measurements are repeated immediately after the patient “wakes up”"
            }
          ]
        },
        {
          "label": "ice-pack test",
          "children": [
            {
              "label": "only if the patient has ptosis"
            },
            {
              "label": "ice pack is placed over lightly closed eyes x 2 minutes",
              "children": [
                {
                  "label": "improvement of ptosis occurs in most patients"
                },
                {
                  "label": "cooling effect may be insufficient to overcome complete myasthenic ptosis"
                }
              ]
            }
          ]
        },
        {
          "label": "serum assays",
          "children": [
            {
              "label": "acetylcholine receptor antibody tests",
              "children": [
                {
                  "label": "3 types",
                  "children": [
                    {
                      "label": "binding antibodies",
                      "children": [
                        {
                          "label": "90% of patients with generalized MG"
                        },
                        {
                          "label": "50% of patients with ocular MG"
                        }
                      ]
                    },
                    {
                      "label": "blocking antibodies",
                      "children": [
                        {
                          "label": "rarely present (1%) without binding antibodies"
                        }
                      ]
                    },
                    {
                      "label": "modulating antibodies",
                      "children": [
                        {
                          "label": "present as frequently as binding antibodies"
                        }
                      ]
                    },
                    {
                      "label": "may detect MG in some patients who do not have anti–acetylcholine receptor antibodies",
                      "children": [
                        {
                          "label": "blocking and modulating antibody testing is for patients who test negative for the binding antibody and for whom evidence of autoimmune MG is necessary"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "anti–muscle-specific kinase (MuSK) antibodies"
            },
            {
              "label": "antibodies against low-density lipoprotein receptor–related protein (LRP4)",
              "children": [
                {
                  "label": "a novel diagnostic marker"
                },
                {
                  "label": "additional studies will need to be performed to fully characterize this antibody"
                }
              ]
            }
          ]
        },
        {
          "label": "electromyographic repetitive nerve stimulation",
          "children": [
            {
              "label": "characteristic decremental response in many patients with systemic MG"
            },
            {
              "label": "single-fiber EMG",
              "children": [
                {
                  "label": "most sensitive for MG"
                }
              ]
            }
          ]
        },
        {
          "label": "all patients with MG must be investigated radiologically for thymomas",
          "children": [
            {
              "label": "10% on CT"
            },
            {
              "label": "malignant thymomas",
              "children": [
                {
                  "label": "in a small percentage"
                }
              ]
            }
          ]
        },
        {
          "label": "serologic testing for thyroid dysfunction and pernicious anemia",
          "children": [
            {
              "label": "high coexistence of MG with other autoimmune disorder"
            }
          ]
        }
      ]
    },
    {
      "label": "Clinical presentation",
      "children": [
        {
          "label": "weakness",
          "children": [
            {
              "label": "variable & fatigable"
            }
          ]
        },
        {
          "label": "ocular signs and symptoms",
          "children": [
            {
              "label": "ptosis",
              "children": [
                {
                  "label": "unilateral or bilateral",
                  "children": [
                    {
                      "label": "most common sign"
                    }
                  ]
                },
                {
                  "label": "worsens",
                  "children": [
                    {
                      "label": "in the evening"
                    },
                    {
                      "label": "with use of the eyes"
                    },
                    {
                      "label": "after prolonged upward gaze"
                    },
                    {
                      "label": "after exertion"
                    }
                  ]
                },
                {
                  "label": "may improve with rest",
                  "children": [
                    {
                      "label": "Cogan eyelid twitch",
                      "children": [
                        {
                          "label": "brief overelevation of the upper eyelid after refixation from downgaze to upgaze"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "enhancement of ptosis",
                  "children": [
                    {
                      "label": "the less ptotic eyelid falls when the more ptotic eyelid is elevated manually",
                      "children": [
                        {
                          "label": "Figure 11-3"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "fatigue of ptosis",
                  "children": [
                    {
                      "label": "assessed by asking the patient to sustain upgaze for ≥1 minute"
                    }
                  ]
                }
              ]
            },
            {
              "label": "diplopia",
              "children": [
                {
                  "label": "variable, both during the day and from one day to another"
                },
                {
                  "label": "ocular motility pattern may simulate",
                  "children": [
                    {
                      "label": "ocular motor cranial nerve paresis",
                      "children": [
                        {
                          "label": "usually sixth nerve or partial, pupil-sparing, third nerve palsy"
                        }
                      ]
                    },
                    {
                      "label": "internuclear ophthalmoplegia"
                    },
                    {
                      "label": "supranuclear motility disturbances",
                      "children": [
                        {
                          "label": "e.g. gaze palsies"
                        }
                      ]
                    },
                    {
                      "label": "isolated muscle “palsy\"",
                      "children": [
                        {
                          "label": "eg, isolated inferior rectus"
                        }
                      ]
                    },
                    {
                      "label": "total ophthalmoplegia"
                    },
                    {
                      "label": "any changing pattern of diplopia, with or without ptosis, should suggest MG"
                    }
                  ]
                },
                {
                  "label": "motility fatigue can also be assessed by having the patient sustain gaze in the direction of paresis"
                },
                {
                  "label": "orbicularis oculi weakness",
                  "children": [
                    {
                      "label": "diagnostically crucial in differentiating MG from other causes of external ophthalmoplegia"
                    }
                  ]
                },
                {
                  "label": "pupillary abnormalities and sensory disturbances are not associated with MG"
                }
              ]
            }
          ]
        },
        {
          "label": "systemic symptoms and signs",
          "children": [
            {
              "label": "weakness of muscles of mastication"
            },
            {
              "label": "weakness of extensors of the neck, trunk, and limbs"
            },
            {
              "label": "dysphagia"
            },
            {
              "label": "dyspnea"
            },
            {
              "label": "hoarseness"
            },
            {
              "label": "dysarthria"
            },
            {
              "label": "thyroid eye disease",
              "children": [
                {
                  "label": "5%",
                  "children": [
                    {
                      "label": "should be suspected if a patient with MG exhibits exotropia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "dysphagia and dyspnea can be life threatening and require prompt treatment"
            }
          ]
        }
      ]
    },
    {
      "label": "Treatment",
      "children": [
        {
          "label": "nonpharmacologic treatment",
          "children": [
            {
              "label": "patch"
            },
            {
              "label": "ptosis crutch"
            },
            {
              "label": "prisms",
              "children": [
                {
                  "label": "when the variability is small"
                },
                {
                  "label": "not always helpful"
                }
              ]
            }
          ]
        },
        {
          "label": "pharmacologic treatment",
          "children": [
            {
              "label": "acetylcholinesterase inhibitors",
              "children": [
                {
                  "label": "neostigmine"
                },
                {
                  "label": "pyridostigmine"
                }
              ]
            },
            {
              "label": "corticosteroids"
            },
            {
              "label": "immunosuppressant drugs"
            }
          ]
        },
        {
          "label": "thymectomy",
          "children": [
            {
              "label": "for patients with a thymoma"
            },
            {
              "label": "for patients with generalized MG who have thymic enlargement"
            }
          ]
        },
        {
          "label": "short-term therapies",
          "children": [
            {
              "label": "intravenous immunoglobulin"
            },
            {
              "label": "plasmapheresis"
            },
            {
              "label": "occasionally necessary"
            }
          ]
        },
        {
          "label": "manage patients in cooperation with a neurologist"
        }
      ]
    }
  ],
