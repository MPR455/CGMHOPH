    {
      "label": "Hemolytic and ghost cell glaucoma",
      "children": [
        {
          "label": "develop after a vitreous hemorrhage"
        },
        {
          "label": "hemolytic glaucoma",
          "children": [
            {
              "label": "hemoglobin-laden macrophages block the trabecular meshwork",
              "children": [
                {
                  "label": "reddish brown discoloration of the trabecular meshwork"
                }
              ]
            },
            {
              "label": "red-tinged cells float in the anterior chamber"
            }
          ]
        },
        {
          "label": "ghost cell glaucoma",
          "children": [
            {
              "label": "ghost cells block the trabecular meshwork"
            },
            {
              "label": "ghost cells",
              "children": [
                {
                  "label": "RBCs that have lost their intracellular hemoglobin and appear as small, khaki- colored cells"
                },
                {
                  "label": "develop within 1–3 months of a vitreous hemorrhage"
                },
                {
                  "label": "enter anterior chamber through disrupted hyaloid face",
                  "children": [
                    {
                      "label": "previous surgery (pars plana vitrectomy, cataract extraction, or capsulotomy)"
                    },
                    {
                      "label": "trauma"
                    },
                    {
                      "label": "spontaneously"
                    }
                  ]
                },
                {
                  "label": "less pliable than normal RBCs"
                }
              ]
            },
            {
              "label": "clinical presentation",
              "children": [
                {
                  "label": "long-standing vitreous hemorrhage",
                  "children": [
                    {
                      "label": "characteristic khaki coloration"
                    }
                  ]
                },
                {
                  "label": "IOP may be markedly elevated, causing corneal edema"
                },
                {
                  "label": "anterior chamber is filled with small, circulating, tan-colored cells"
                },
                {
                  "label": "cellular reaction appears out of proportion to the aqueous flare"
                },
                {
                  "label": "conjunctiva tends not to be inflamed (unless the IOP is markedly elevated)"
                },
                {
                  "label": "angle appears normal except for the layering of ghost cells over the trabecular meshwork inferiorly"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "both hemolytic and ghost cell glaucoma generally resolve once the hemorrhage has cleared"
            },
            {
              "label": "aqueous suppressants",
              "children": [
                {
                  "label": "preferred initial approach"
                }
              ]
            },
            {
              "label": "irrigation of the anterior chamber"
            },
            {
              "label": "pars plana vitrectomy"
            },
            {
              "label": "incisional glaucoma surgery"
            }
          ]
        }
      ]
    },
    {
      "label": "Hyphema",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "obstruction of the trabecular meshwork with",
              "children": [
                {
                  "label": "red blood cells (RBCs)"
                },
                {
                  "label": "inflammatory cells"
                },
                {
                  "label": "debris"
                },
                {
                  "label": "fibrin"
                }
              ]
            },
            {
              "label": "direct injury to the trabecular meshwork from the blunt trauma"
            }
          ]
        },
        {
          "label": "increased IOP is more common following recurrent hemorrhage/rebleeding",
          "children": [
            {
              "label": "frequency of rebleeding following hyphema",
              "children": [
                {
                  "label": "5%–10%"
                }
              ]
            },
            {
              "label": "usually within 3–7 days"
            },
            {
              "label": "normal clot retraction and lysis"
            }
          ]
        },
        {
          "label": "sickle cell hemoglobinopathies",
          "children": [
            {
              "label": "increased incidence of elevated IOP following hyphema",
              "children": [
                {
                  "label": "RBCs tend to sickle in the anterior chamber, because of the low pH of aqueous humor",
                  "children": [
                    {
                      "label": "more rigid cells become trapped in the trabecular meshwork"
                    }
                  ]
                }
              ]
            },
            {
              "label": "increased susceptibility to development of optic neuropathy",
              "children": [
                {
                  "label": "optic nerves of patients with sickle cell disease are much more sensitive to elevated IOP",
                  "children": [
                    {
                      "label": "anterior ischemic optic neuropathy"
                    },
                    {
                      "label": "central retinal artery occlusion"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "uncomplicated hyphema",
              "children": [
                {
                  "label": "eye shield"
                },
                {
                  "label": "limited activity"
                },
                {
                  "label": "head elevation"
                }
              ]
            },
            {
              "label": "systemic aminocaproic acid",
              "children": [
                {
                  "label": "reduces rebleeding in some studies",
                  "children": [
                    {
                      "label": "not confirmed in all studies"
                    }
                  ]
                },
                {
                  "label": "systemic adverse effects",
                  "children": [
                    {
                      "label": "hypotension"
                    },
                    {
                      "label": "syncope"
                    },
                    {
                      "label": "abdominal pain"
                    },
                    {
                      "label": "nausea"
                    },
                    {
                      "label": "discontinuation of aminocaproic acid may be associated with clot lysis and with additional IOP elevation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "topical and systemic corticosteroids",
              "children": [
                {
                  "label": "reduce associated inflammation"
                },
                {
                  "label": "effect on rebleeding is debatable"
                }
              ]
            },
            {
              "label": "cycloplegic agents",
              "children": [
                {
                  "label": "If significant ciliary spasm or photophobia"
                },
                {
                  "label": "no proven benefit for prevention of rebleeding"
                }
              ]
            },
            {
              "label": "patching and bed rest are advocated by some authors",
              "children": [
                {
                  "label": "unproven value"
                }
              ]
            },
            {
              "label": "elevated IOP",
              "children": [
                {
                  "label": "aqueous suppressants"
                },
                {
                  "label": "hyperosmotic agents"
                },
                {
                  "label": "patients with sickle cell hemoglobinopathies should avoid carbonic anhydrase inhibitors",
                  "children": [
                    {
                      "label": "increase the sickling tendency in the anterior chamber by further lowering the pH"
                    }
                  ]
                }
              ]
            }
