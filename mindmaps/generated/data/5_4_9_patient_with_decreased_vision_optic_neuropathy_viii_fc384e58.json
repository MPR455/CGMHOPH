            {
              "label": "≥2 of the following",
              "children": [
                {
                  "label": "a contiguous spinal cord lesion on MRI involving 3 or more vertebral segments"
                },
                {
                  "label": "a brain MRI scan nondiagnostic for MS"
                },
                {
                  "label": "a positive NMO-IgG serologic test result (autoantibody)",
                  "children": [
                    {
                      "label": "76% sensitivity",
                      "children": [
                        {
                          "label": "94% specificity"
                        }
                      ]
                    },
                    {
                      "label": "binds to aquaporin-4",
                      "children": [
                        {
                          "label": "principal water channel protein expressed in astroglial foot processes",
                          "children": [
                            {
                              "label": "involved in fluid homeostasis in the CNS"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "indications for NMO-IgG testing in patients with optic neuritis",
                      "children": [
                        {
                          "label": "progressive vision loss for more than 2 weeks"
                        },
                        {
                          "label": "lack of vision improvement by 1 month"
                        },
                        {
                          "label": "recurrent optic neuritis"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "99% sensitivity"
            },
            {
              "label": "90% specificity"
            }
          ]
        },
