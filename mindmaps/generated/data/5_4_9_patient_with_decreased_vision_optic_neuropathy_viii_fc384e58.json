          "children": [
            {
              "label": "recurrent episodes of vision loss"
            },
            {
              "label": "vision and neurologic prognoses in NMO are poorer than in MS",
              "children": [
                {
                  "label": "severe visual impairment (<20/200) common in at least 1 eye"
                }
              ]
