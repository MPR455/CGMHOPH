{
  "label": "5.8.7. Diplopia (VII): Infranuclear Causes of Diplopia (IV)",
  "root": true,
  "children": [
    {
      "label": "Neuromyotonia",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "prior skull-base radiation therapy",
          "children": [
            {
              "label": "months-years postradiation"
            }
          ]
        },
        {
          "label": "may affect any of the ocular motor nerves or their divisions"
        },
        {
          "label": "episodic diplopia",
          "children": [
            {
              "label": "often triggered by activation of the affected nerve"
            },
            {
              "label": "overaction of the nerve produces ocular misalignment"
            },
            {
              "label": "carbamazepine and its derivatives",
              "children": [
                {
                  "label": "first-line treatment"
                }
              ]
            }
          ]
        },
        {
          "label": "medical therapy"
        }
      ]
    },
    {
      "label": "30–60 seconds"
    },
    {
      "label": "Carotid cavernous sinus fistula",
      "children": [
        {
          "label": "abnormal connections between the carotid artery or its branches and the cavernous sinus",
          "children": [
            {
              "label": "direct, high-flow connections",
              "children": [
                {
                  "label": "between the internal carotid artery and the cavernous sinus"
                },
                {
                  "label": "after severe head trauma"
                }
              ]
            },
            {
              "label": "indirect, “dural” low-flow connections",
              "children": [
                {
                  "label": "between small arterial feeders off the internal or external carotids and the cavernous sinus"
                },
                {
                  "label": "occur spontaneously",
                  "children": [
                    {
                      "label": "older women"
                    }
                  ]
                }
              ]
            },
            {
              "label": "high- and low-flow fistulas cannot be distinguished reliably through physical examination",
              "children": [
                {
                  "label": "except cranial bruit that indicates high flow"
                }
              ]
            },
            {
              "label": "cerebral angiography is necessary to make the correct diagnosis"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "pain",
              "children": [
                {
                  "label": "may partly result from ocular surface drying if proptosis is significant"
                }
              ]
            },
            {
              "label": "ocular motor neuropathy with diplopia",
              "children": [
                {
                  "label": "compression of CN VI by an enlarged inferior petrosal sinus",
                  "children": [
                    {
                      "label": "drains the fistula",
                      "children": [
                        {
                          "label": "isolated sixth nerve palsy even in the context of a quiet eye"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "may reverse blood flow within the superior ophthalmic vein",
              "children": [
                {
                  "label": "venous congestion within the orbit",
                  "children": [
                    {
                      "label": "proptosis"
                    }
                  ]
                },
                {
                  "label": "arterialization of conjunctival vessels"
                }
              ]
            },
            {
              "label": "elevated intraocular pressure"
            },
            {
              "label": "arterial or venous compromise to the retina and eye"
            },
            {
              "label": "ischemic optic neuropathy"
            },
            {
              "label": "choroidal effusions",
              "children": [
                {
                  "label": "can push the iris forward and produce angle- closure glaucoma"
                }
              ]
            },
            {
              "label": "cerebral venous infarction (rare)"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "angiographic studies are required"
            },
            {
              "label": "some indirect fistulas remain stable or close spontaneously"
            },
            {
              "label": "interventional radiologic techniques",
              "children": [
                {
                  "label": "variety of thrombogenic materials",
                  "children": [
                    {
                      "label": "coils, beads, or balloons"
                    }
                  ]
                }
              ]
            },
            {
              "label": "radiosurgery"
            }
          ]
        }
      ]
    },
    {
      "label": "Paresis of More Than One Cranial Nerve",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "benign microvascular disease rarely causes simultaneous involvement of >1 ocular motor nerve"
            },
            {
              "label": "simultaneous involvement of contiguous nerves (CNs III, IV, V, VI, and sympathetic nerves)",
              "children": [
                {
                  "label": "cavernous sinus lesion"
                }
              ]
            },
            {
              "label": "bilateral cranial nerve involvement",
              "children": [
                {
                  "label": "diffuse infiltrative process",
                  "children": [
                    {
                      "label": "carcinoma, leukemia, or lymphoma"
                    }
                  ]
                },
                {
                  "label": "midline mass lesion that extends bilaterally",
                  "children": [
                    {
                      "label": "chordoma, chondrosarcoma, or nasopharyngeal carcinoma"
                    }
                  ]
                },
                {
                  "label": "meningeal-based process"
                },
                {
                  "label": "inflammatory polyneuropathy",
                  "children": [
                    {
                      "label": "Guillain-Barré syndrome"
                    },
                    {
                      "label": "sarcoidosis"
                    }
                  ]
                },
                {
                  "label": "myasthenia gravis"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "neurologic evaluation should be undertaken"
            },
            {
              "label": "if neuroimaging results are normal",
              "children": [
                {
                  "label": "lumbar puncture with cytopathologic examination"
                },
                {
                  "label": "special testing for cancer-associated protein markers"
                },
                {
                  "label": "repeat studies may be needed"
                }
              ]
            }
          ]
        },
        {
          "label": "Idiopathic multiple cranial neuropathy syndrome",
          "children": [
            {
              "label": "diagnosis of exclusion"
            }
          ]
        }
      ]
    },
    {
      "label": "CT-PET scan",
      "children": [
        {
          "label": "in suspected neoplastic meningeal involvement (meningeal carcinomatosis)",
          "children": [
            {
              "label": "study of choice"
            }
          ]
        }
      ]
    },
    {
      "label": "Cavernous Sinus and Superior Orbital Fissure Involvement",
      "children": [
        {
          "label": "combination of third, fourth, and sixth cranial nerve palsies",
          "children": [
            {
              "label": "If only 1 ocular motor nerve is involved, it is usually the sixth nerve",
              "children": [
                {
                  "label": "the only ocular motor nerve not protected within the dural wall of the cavernous sinus"
                }
              ]
            }
          ]
        },
        {
          "label": "fifth cranial nerve involvement",
          "children": [
            {
              "label": "facial hypoesthesia"
            }
          ]
        },
        {
          "label": "sympathetic involvement",
          "children": [
            {
              "label": "third-order (postganglionic) Horner syndrome"
            }
          ]
        },
        {
          "label": "aggressive lesions of the cavernous sinus",
          "children": [
            {
              "label": "especially infectious or inflammatory"
            },
            {
              "label": "may compromise venous outflow",
              "children": [
                {
                  "label": "engorgement of ocular surface vessels"
                },
                {
                  "label": "orbital venous congestion"
                },
                {
                  "label": "increased intraocular pressure"
                },
                {
                  "label": "increased ocular pulse pressure"
                }
              ]
            }
          ]
        },
        {
          "label": "clinically impossible to distinguish cavernous sinus lesions from superior orbital fissure lesions"
        },
        {
          "label": "offending lesion may extend toward the optic foramen or into the orbital apex",
          "children": [
            {
              "label": "optic nerve dysfunction",
              "children": [
                {
                  "label": "sphenocavernous syndrome/parasellar syndrome"
                },
                {
                  "label": "orbital apex syndrome"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Tolosa-Hunt syndrome",
      "children": [
        {
          "label": "idiopathic, sterile inflammation that primarily affects the cavernous sinus"
        },
        {
          "label": "severe, “boring” pain",
          "children": [
            {
              "label": "almost always present"
            },
            {
              "label": "typically responds rapidly and dramatically to corticosteroid therapy",
              "children": [
                {
                  "label": "a positive response may also occur with neoplastic mass lesions, especially lymphoma",
                  "children": [
                    {
                      "label": "diagnosis of this syndrome is one of exclusion"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "neuroimaging",
          "children": [
            {
              "label": "enhancing mass within the cavernous sinus"
            }
          ]
        },
