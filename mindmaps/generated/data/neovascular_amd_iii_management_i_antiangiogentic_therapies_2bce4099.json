    {
      "label": "Antiangiogenic Agents",
      "children": [
        {
          "label": "Pegaptanib",
          "children": [
            {
              "label": "RNA oligonucleotide ligand (or aptamer)"
            },
            {
              "label": "binds human VEGF165"
            }
          ]
        },
        {
          "label": "Ranibizumab",
          "children": [
            {
              "label": "recombinant humanized antibody fragment (Fab)"
            },
            {
              "label": "binds to and inhibits all active isoforms of VEGF-A as well as their active degradation products"
            },
            {
              "label": "HARBOR",
              "children": [
                {
                  "label": "compared higher-dose (2.0 mg) with standard-dose (0.5 mg)"
                },
                {
                  "label": "found no difference in visual acuity or anatomical outcomes between higher-dose and standard-dose"
                }
              ]
            }
          ]
        },
        {
          "label": "Bevacizumab",
          "children": [
            {
              "label": "full-length monoclonal antibody against VEGF"
            },
            {
              "label": "used “off-label” for the treatment of AMD"
            },
            {
              "label": "clusters of severe vision loss due to endophthalmitis",
              "children": [
                {
                  "label": "secondary to substandard and erroneous compounding practices"
                }
              ]
            },
            {
              "label": "comparison",
              "children": [
                {
                  "label": "bevacizumab",
                  "children": [
                    {
                      "label": "larger"
                    },
                    {
                      "label": "2 antigen-binding domains"
                    },
                    {
                      "label": "longer systemic half-life after intravitreal injections",
                      "children": [
                        {
                          "label": "~21 days"
                        }
                      ]
                    },
                    {
                      "label": "costs substantially less",
                      "children": [
                        {
                          "label": "40x lower"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "ranibizumab",
                  "children": [
                    {
                      "label": "smaller"
                    },
                    {
                      "label": "single doma"
                    },
                    {
                      "label": "shorter systemic half-life after intravitreal injections",
                      "children": [
                        {
                          "label": "2.2 hours"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "CATT",
              "children": [
                {
                  "label": "bevacizumab was noninferior to ranibizumab therapy in monthly or as-needed delivery schedules over 2 years"
                },
                {
                  "label": "systemic adverse events were significantly greater in bevacizumab (39.9%) than in ranibizumab (31.7%) group"
                },
                {
                  "label": "death and arteriothrombotic events were not statistically different"
                },
                {
                  "label": "geographic atrophy development or increase appeared to be stimulated by anti-VEGF therapy"
                }
              ]
            }
          ]
        },
        {
          "label": "Aflibercept",
          "children": [
            {
              "label": "ligand-binding elements of extracellular domains of VEGFR1 and VEGFR2 fused to constant region (Fc) of IgG"
            },
            {
              "label": "binds both VEGF and placental-like growth factor"
            },
            {
              "label": "fully penetrates all retinal layers"
            },
            {
              "label": "VIEW 1 and VIEW 2 studies",
              "children": [
                {
                  "label": "all aflibercept regimens demonstrated noninferiority to ranibizumab monthly regimen"
                },
                {
                  "label": "after 3 monthly doses, aflibercept administered every 2 months showed similar efficacy to ranibizumab administered monthly"
                },
                {
                  "label": "safety profiles were similar for both aflibercept and ranibizumab",
                  "children": [
                    {
                      "label": "patients receiving monthly aflibercept (2 mg) gained 10.9 letters of visual acuity, whereas those receiving monthly ranibizumab (0.5 mg) gained 8.1 letters (P< .01)"
