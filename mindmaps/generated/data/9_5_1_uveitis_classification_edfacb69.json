      "label": "Retinal Vasculitis",
      "children": [
        {
          "label": "retinal vasculitis",
          "children": [
            {
              "label": "retinal vascular changes in association with ocular inflammation",
              "children": [
                {
                  "label": "perivascular sheathing"
                },
                {
                  "label": "vascular leakage or occlusion"
                }
              ]
            }
          ]
        },
        {
          "label": "vasculopathy",
          "children": [
            {
              "label": "vessel changes but no visible evidence of inflammation"
            }
          ]
        }
      ]
    },
    {
      "label": "Anterior Uveitis",
      "children": [
        {
          "label": "anterior uveitis",
          "children": [
            {
              "label": "inflammation of the iris & ciliary body"
            },
            {
              "label": "anterior chamber is the primary site of inflammation"
            }
          ]
        },
        {
          "label": "iritis",
          "children": [
            {
              "label": "inflammation confined to the anterior chamber"
            }
          ]
        },
        {
          "label": "iridocyclitis",
          "children": [
            {
              "label": "cells in the retrolental (anterior vitreous) space"
            }
          ]
        },
        {
          "label": "keratouveitis"
        },
        {
          "label": "corneal inflammation with secondary involvement of the anterior chamber"
        },
        {
          "label": "sclerouveitis",
          "children": [
            {
              "label": "scleral inflammation and uveal tract"
            }
          ]
        },
        {
          "label": "the primary site of inflammation is named first"
        }
      ]
    },
    {
      "label": "Panuveitis",
      "children": [
        {
          "label": "inflammation is diffuse without a predominant site",
          "children": [
            {
              "label": "anterior chamber, vitreous, and retina and/or choroid"
            }
          ]
        }
      ]
    },
    {
      "label": "Posterior Uveitis",
      "children": [
        {
          "label": "inflammation of retina and/or choroid",
          "children": [
            {
              "label": "focal, multifocal, or diffuse areas of retinitis or choroiditis"
            }
          ]
        },
        {
          "label": "varying degrees of vitreous cellular activity",
          "children": [
            {
              "label": "diffuse"
            },
            {
              "label": "overlying foci of active inflammation"
            },
            {
              "label": "posterior vitreous face"
            }
          ]
        },
        {
          "label": "complications",
