  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "uveitis",
          "children": [
            {
              "label": "inflammation (ie, -itis) of the uvea"
            },
            {
              "label": "• involvement of retina, sclera, cornea, vitreous, and optic nerve"
            }
          ]
        },
        {
          "label": "frequently associated with systemic disease",
          "children": [
            {
              "label": "careful, thorough history and review of systems"
            },
            {
              "label": "comprehensive physical examination of eye/ pertinent organ systems"
            }
          ]
        },
        {
          "label": "laboratory studies",
          "children": [
            {
              "label": "can help determine the etiology"
            },
            {
              "label": "are never a substitute for a thorough history and physical examination"
            }
          ]
        }
      ]
    },
    {
      "label": "Categorization by Clinical Course",
      "children": [
        {
          "label": "acute uveitis",
          "children": [
            {
              "label": "sudden onset and limited duration <3 months"
            }
          ]
        },
        {
          "label": "chronic uveitis",
          "children": [
            {
              "label": "persistent, with relapse occurring in <3 months after discontinuing treatment"
            }
          ]
        },
        {
          "label": "recurrent uveitis",
          "children": [
            {
              "label": "repeated episodes separated by periods of inactivity without treatment that last ≥3 months"
            }
          ]
        },
        {
          "label": "distribution of ocular involvement",
          "children": [
            {
              "label": "focal"
            },
            {
              "label": "multifocal"
            },
            {
              "label": "diffuse"
            }
          ]
        },
        {
          "label": "severity",
          "children": [
            {
              "label": "low grade"
            },
            {
              "label": "severe"
            }
          ]
        },
        {
          "label": "granulomatous vs. nongranulomatous inflammation",
          "children": [
            {
              "label": "nongranulomatous",
              "children": [
                {
                  "label": "lymphocytic and plasma cell infiltrate"
                }
              ]
            },
            {
              "label": "granulomatous",
              "children": [
                {
                  "label": "epithelioid and giant cells"
                }
              ]
            }
          ]
        },
        {
          "label": "discrete granuloma",
          "children": [
            {
              "label": "sarcoidosis",
              "children": [
                {
                  "label": "clinical appearance of uveitis as granulomatous or nongranulomatous may not correlate with the histologic description"
                }
              ]
            }
          ]
        },
        {
          "label": "diffuse granulomatous inflammation",
          "children": [
            {
              "label": "Vogt-Koyanagi-Harada (VKH) syndrome"
            },
            {
              "label": "sympathetic ophthalmia"
            }
          ]
        },
        {
          "label": "zonal granulomatous disease",
          "children": [
            {
              "label": "lens-induced uveitis"
            }
          ]
        }
      ]
    },
    {
      "label": "Classification of Uveitis",
      "children": [
        {
          "label": "Standardization of Uveitis Nomenclature (SUN) Working Group",
          "children": [
            {
              "label": "anterior uveitis",
              "children": [
                {
                  "label": "anterior chamber"
                }
              ]
            },
            {
              "label": "intermediate uveitis",
              "children": [
                {
                  "label": "vitreous"
                }
              ]
            },
            {
              "label": "posterior uveitis",
              "children": [
                {
                  "label": "retina or choroid"
                }
              ]
            },
            {
              "label": "panuveitis"
            },
            {
              "label": "“anterior and intermediate uveitis”",
              "children": [
                {
                  "label": "vitritis is more than expected in an isolated anterior uveitis"
                }
