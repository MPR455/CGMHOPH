    {
      "label": "Treatment",
      "children": [
        {
          "label": "indications for systemic antibiotic therapy in patients with uveitis",
          "children": [
            {
              "label": "abnormal-appearing chest radiograph"
            },
            {
              "label": "TB skin test has recently converted to positive"
            },
            {
              "label": "nonadherent patients receiving single-drug therapy",
              "children": [
                {
                  "label": "positive bacterial culture or PCR results"
                }
              ]
            }
          ]
        },
        {
          "label": "patients at risk for multidrug-resistant tuberculosis (MDRTB)",
          "children": [
            {
              "label": "migrant or indigent populations"
            },
            {
              "label": "recent immigrants from countries where INH and rifampin are available over the counter"
            }
          ]
        },
        {
          "label": "multidrug therapy",
          "children": [
            {
              "label": "induction phase",
              "children": [
                {
                  "label": "INH, rifampin, and pyrazinamide",
                  "children": [
                    {
                      "label": "immunocompromised patients, including those with HIV infection"
                    },
                    {
                      "label": "x 2 month"
                    }
                  ]
                }
              ]
            },
            {
              "label": "continuation phase",
              "children": [
                {
                  "label": "x 4–7 months"
                }
              ]
            },
            {
              "label": "in the event of drug resistance",
              "children": [
                {
                  "label": "95% of immunocompetent patients may be successfully treated with a full course of therapy"
                },
                {
                  "label": "another drug (ethambutol or streptomycin) is added to the initial triple-drug regimen",
                  "children": [
                    {
                      "label": "followed by",
                      "children": [
                        {
                          "label": "INH and rifampin x 4-month"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "directly observed therapy (DOT)"
