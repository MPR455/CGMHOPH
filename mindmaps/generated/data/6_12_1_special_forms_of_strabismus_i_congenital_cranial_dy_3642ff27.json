{
  "label": "6.12.1. Special Forms of Strabismus (I): Congenital Cranial Dysinnervation Disorders",
  "root": true,
  "children": [
    {
      "label": "Definition",
      "children": [
        {
          "label": "a group of strabismus entities that have in common a developmental defect of one or more cranial nerve nuclei and, as a result, hypoplasia or absence of the nerves themselves"
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "Congenital Fibrosis of Extraocular Muscles (CFEOM)",
      "children": [
        {
          "label": "\"congenital fibrosis syndrome\""
        },
        {
          "label": "rare"
        },
        {
          "label": "± inherited",
          "children": [
            {
              "label": "autosomal dominant"
            },
            {
              "label": "occasionally autosomal recessive"
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "developmental defects of cranial nerve nuclei and of the nerves themselves",
              "children": [
                {
                  "label": "fibrous tissue replaces these muscles",
                  "children": [
                    {
                      "label": "extraocular muscle restriction"
                    },
                    {
                      "label": "fibrosis of adjacent tissues may be present as well"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "limited voluntary motion with restriction",
              "children": [
                {
                  "label": "congenital onset",
                  "children": [
                    {
                      "label": "important in distinguishing CFEOM from thyroid eye disease"
                    }
                  ]
                },
                {
                  "label": "usually severe"
                },
                {
                  "label": "positive forced-duction testing"
                }
              ]
            },
            {
              "label": "variants",
              "children": [
                {
                  "label": "generalized fibrosis",
                  "children": [
                    {
                      "label": "most severe form"
                    },
                    {
                      "label": "affects all EOMs of both eyes",
                      "children": [
                        {
                          "label": "including levator palpebrae superioris"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "congenital unilateral fibrosis",
                  "children": [
                    {
                      "label": "nonfamilial"
                    }
                  ]
                },
                {
                  "label": "inferior rectus muscle fibrosis",
                  "children": [
                    {
                      "label": "unilateral or bilateral"
                    },
                    {
                      "label": "sporadic or familial",
                      "children": [
                        {
                          "label": "commonly autosomal dominant"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "strabismus fixus",
                  "children": [
                    {
                      "label": "involves the horizontal rectus muscles",
                      "children": [
                        {
                          "label": "usually the medial rectus muscles"
                        }
                      ]
                    },
                    {
                      "label": "usually sporadic"
                    },
                    {
                      "label": "severe esotropia"
                    }
                  ]
                },
                {
                  "label": "vertical retraction syndrome",
                  "children": [
                    {
                      "label": "affects the superior rectus muscle"
                    },
                    {
                      "label": "inability to depress the eye"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "release of the restricted muscles (ie, weakening procedures)"
            },
            {
              "label": "goal of surgery is to align the eyes in primary position"
            },
            {
              "label": "full ocular rotations cannot be restored"
            },
            {
              "label": "outcome is unpredictable"
            }
          ]
        }
      ]
    },
    {
      "label": "Möbius Syndrome",
      "children": [
        {
          "label": "rare"
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "combined sixth and seventh nerve palsies"
            },
            {
              "label": "± gaze palsies",
              "children": [
                {
                  "label": "attributed to abnormalities in the paramedian pontine reticular formation or sixth cranial nerve nucleus"
                }
              ]
            },
            {
              "label": "masklike facies"
            },
            {
              "label": "limb, chest, and tongue defects",
              "children": [
                {
                  "label": "Poland syndrome",
                  "children": [
                    {
                      "label": "absent pectoralis muscle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "3 patterns of motility involvement",
              "children": [
                {
                  "label": "orthotropia in primary position with marked deficits in abduction and adduction",
                  "children": [
                    {
                      "label": "40%"
                    }
                  ]
                },
                {
                  "label": "esotropia with cross-fixation",
                  "children": [
                    {
                      "label": "50%"
                    },
                    {
                      "label": "sparing of convergence and adduction"
                    }
                  ]
                },
                {
                  "label": "large exotropia",
                  "children": [
                    {
                      "label": "10%"
                    },
                    {
                      "label": "absence of convergence"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "medial rectus muscle recession",
              "children": [
                {
                  "label": "for large-angle esotropia"
                }
              ]
            },
            {
              "label": "vertical rectus muscle transposition procedures",
              "children": [
                {
                  "label": "to improve abduction"
                },
                {
                  "label": "after medial rectus muscle restriction has been relieved"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
