{
  "label": "5.4.13. Patient With Decreased Vision: Classification & Management (XIII): Retrochiasmal Lesions",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "retrochiasmal visual pathway",
          "children": [
            {
              "label": "crossed nasal fibers from the contralateral eye and uncrossed temporal fibers from the ipsilateral eye are located together"
            }
          ]
        },
        {
          "label": "perimetry",
          "children": [
            {
              "label": "homonymous visual field defects that respect the vertical midline"
            }
          ]
        },
        {
          "label": "rule of congruity",
          "children": [
            {
              "label": "anterior lesions",
              "children": [
                {
                  "label": "dissimilar (incongruous) defects"
                }
              ]
            },
            {
              "label": "posterior lesions",
              "children": [
                {
                  "label": "progressively more similar (congruous) defects"
                }
              ]
            },
            {
              "label": "“rule” of congruity has been called into question",
              "children": [
                {
                  "label": "50% of optic tract lesions caused congruous homonymous hemianopia"
                },
                {
                  "label": "lesions severe enough to produce complete hemianopic defects may occur at any anteroposterior retrochiasmal location"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Parietal Lobe",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "stroke",
              "children": [
                {
                  "label": "most common"
                }
              ]
            }
          ]
        },
        {
          "label": "visual field defects",
          "children": [
            {
              "label": "homonymous hemianopia",
              "children": [
                {
                  "label": "hemifields contralateral to the lesion"
                }
              ]
            },
            {
              "label": "inferior",
              "children": [
                {
                  "label": "parietal lobe lesions involve superior fibers first",
                  "children": [
                    {
                      "label": "more extensive lesions also involve superior visual fields but remain denser inferiorly"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "parietal lobe syndromes",
          "children": [
            {
              "label": "perceptual problems (agnosia)"
            },
            {
              "label": "apraxia"
            },
            {
              "label": "dominant parietal lobe",
              "children": [
                {
                  "label": "Gerstmann syndrome",
                  "children": [
                    {
                      "label": "acalculia"
                    },
                    {
                      "label": "agraphia"
                    },
                    {
                      "label": "finger agnosia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "nondominant parietal lobe",
              "children": [
                {
                  "label": "contralateral neglect",
                  "children": [
                    {
                      "label": "left-right confusion"
                    }
                  ]
                }
              ]
            },
            {
              "label": "reduced optokinetic nystagmus (OKN)",
              "children": [
                {
                  "label": "pursuit pathways converge in the posterior parietal lobes (near the visual radiations)",
                  "children": [
                    {
                      "label": "asymmetry in the pursuit system likely indicates involvement of area V5 or MT"
                    }
                  ]
                },
                {
                  "label": "elicit the impaired OKN response by moving targets toward the affected side"
                },
                {
                  "label": "homonymous hemianopia should prompt OKN testing",
                  "children": [
                    {
                      "label": "lesions of optic tract or occipital lobe do not affect the OKN response"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Optic Tract",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "mass lesions (aneurysms)",
              "children": [
                {
                  "label": "most common"
                }
              ]
            },
            {
              "label": "inflammatory and demyelinating lesions",
              "children": [
                {
                  "label": "occasionally"
                }
              ]
            },
            {
              "label": "ischemic lesions",
              "children": [
                {
                  "label": "uncommon"
                },
                {
                  "label": "surgical disruption of the anterior choroidal artery"
                }
              ]
            }
          ]
        },
        {
          "label": "visual field defect",
          "children": [
            {
              "label": "incongruous"
            },
            {
              "label": "homonymous"
            },
            {
              "label": "hemianopia",
              "children": [
                {
                  "label": "hemifields contralateral to the lesion"
                }
              ]
            }
          ]
        },
        {
          "label": "other findings of optic tract syndrome",
          "children": [
            {
              "label": "“bow-tie” optic atrophy",
              "children": [
                {
                  "label": "optic tract consists of",
                  "children": [
                    {
                      "label": "crossed nasal fibers from the contralateral eye",
                      "children": [
                        {
                          "label": "papillomacular fibers"
                        },
                        {
                          "label": "nasal radiating fibers"
                        },
                        {
                          "label": "causing atrophy in the corresponding nasal and temporal horizontal portions of the disc"
                        }
                      ]
                    },
                    {
                      "label": "uncrossed arcuate temporal fibers from the ipsilateral eye",
                      "children": [
                        {
                          "label": "enter the disc at the superior and inferior poles"
                        },
                        {
                          "label": "causing atrophy in the corresponding superior and inferior portions of the disc"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "mild RAPD in the contralateral eye",
              "children": [
                {
                  "label": "more crossed than uncrossed pupillary fibers in the optic tract"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Occipital Lobe",
      "children": [
        {
          "label": "visual fibers approaching occipital lobe become more congruous",
          "children": [
            {
              "label": "central fibers course to the occipital tip"
            },
            {
              "label": "peripheral fibers course to the anteromedial cortex",
              "children": [
                {
                  "label": "some peripheral nasal fibers are not matched with corresponding uncrossed fibers",
                  "children": [
                    {
                      "label": "60°–90°",
                      "children": [
                        {
                          "label": "monocular “temporal crescent”"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "visual fibers localize within the occipital cortex superior and inferior to the calcarine fissure"
            }
          ]
        },
        {
          "label": "visual field defects",
          "children": [
            {
              "label": "congruous homonymous hemianopia",
              "children": [
                {
                  "label": "± sparing the fixational region (macula- sparing)",
                  "children": [
                    {
                      "label": "stroke involving the posterior cerebral artery"
                    },
                    {
                      "label": "tip of the occipital lobe receives a dual blood supply",
                      "children": [
                        {
                          "label": "posterior cerebral artery"
                        },
                        {
                          "label": "middle cerebral artery"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "homonymous paracentral hemianopic scotomata",
                  "children": [
                    {
                      "label": "systemic hypoperfusion",
                      "children": [
                        {
                          "label": "damages the occipital tip",
                          "children": [
                            {
                              "label": "watershed area"
                            },
                            {
                              "label": "may be the only injured area"
                            }
                          ]
                        },
                        {
                          "label": "most commonly after surgery or other episodes involving blood loss with severe hypotension"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "monocular defect of the contralateral temporal crescent",
              "children": [
                {
                  "label": "lesion involving only the most anterior portion of the occipital lobe"
                }
              ]
            },
            {
              "label": "homonymous hemianopia sparing the temporal crescent in the eye contralateral to the lesion",
              "children": [
                {
                  "label": "Goldmann perimetry is required"
                }
              ]
            },
            {
              "label": "homonymous hemianopia that respects both the vertical and horizontal meridians"
            }
          ]
        },
        {
          "label": "associated neurologic findings",
          "children": [
            {
              "label": "most occipital lobe lesions encountered by ophthalmologists result from stroke",
              "children": [
                {
                  "label": "cause no other neurologic deficits"
                }
              ]
            },
            {
              "label": "cortical blindness from bilateral occipital lobe destruction",
              "children": [
                {
                  "label": "normal pupillary responses"
                },
                {
                  "label": "normal optic nerve appearance",
                  "children": [
                    {
                      "label": "distinguish cortical blindness from total blindness caused by bilateral prechiasmal or chiasmal lesions"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Anton syndrome",
              "children": [
                {
                  "label": "denial of blindness",
                  "children": [
                    {
                      "label": "bilateral occipital lobe lesions occasionally permit some residual visual function"
                    }
                  ]
                },
                {
                  "label": "can be due to a lesion at any level of the visual system severe enough to cause blindness"
                }
              ]
            },
            {
              "label": "Riddoch phenomenon",
              "children": [
                {
                  "label": "perceive moving targets but not static ones"
                },
                {
                  "label": "may also occur with lesions in other parts of the visual pathway"
                }
              ]
            },
            {
              "label": "unformed visual hallucinations",
              "children": [
                {
                  "label": "disturbances of the primary visual cortex",
                  "children": [
                    {
                      "label": "tumors"
                    },
                    {
                      "label": "migraine"
                    },
                    {
                      "label": "drugs"
                    }
                  ]
                }
              ]
            },
            {
              "label": "formed visual hallucinations",
              "children": [
                {
                  "label": "lesions of the extrastriate cortex or temporal lobe"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Lateral Geniculate Body (LGB)",
      "children": [
        {
          "label": "highly organized and layered retinotopic structure"
        },
        {
          "label": "highly localizing visual field defects",
          "children": [
            {
              "label": "disruption of anterior choroidal artery",
              "children": [
                {
                  "label": "branch of the middle cerebral artery"
                },
                {
                  "label": "loss of the upper and lower homonymous quadrants",
                  "children": [
                    {
                      "label": "with preservation of a horizontal wedge"
                    },
                    {
                      "label": "“quadruple sectoranopia”"
                    }
                  ]
                }
              ]
            },
            {
              "label": "disruption of posterior lateral choroidal artery",
              "children": [
                {
                  "label": "branch of the posterior cerebral artery"
                },
                {
                  "label": "very congruous horizontal sectoranopia"
                }
              ]
            }
          ]
        },
        {
          "label": "visual field defects respect the vertical meridian",
          "children": [
            {
              "label": "unlike the uncommon wedge defect observed in glaucoma"
            }
          ]
        },
        {
          "label": "very incongruous homonymous hemianopias can also occur"
        },
        {
          "label": "sectoral optic atrophy"
        }
      ]
    },
    {
      "label": "Temporal Lobe",
      "children": [
        {
          "label": "optic radiation",
          "children": [
            {
              "label": "inferior fibers course from the LGB anteriorly in the Meyer loop of the temporal lobe",
              "children": [
                {
                  "label": "2.5 cm from the anterior tip of the temporal lobe",
                  "children": [
                    {
                      "label": "damage to temporal lobe anterior to the Meyer loop does not cause visual field loss"
                    }
                  ]
                }
              ]
            },
            {
              "label": "superior fibers course more directly posteriorly in the parietal lobe",
              "children": [
                {
                  "label": "homonymous hemianopic defects extending inferiorly"
                }
              ]
            }
          ]
        },
        {
          "label": "visual field defects from lesions of Meyer loop",
          "children": [
            {
              "label": "homonymous hemianopia",
              "children": [
                {
                  "label": "hemifields contralateral to the lesion"
                }
              ]
            },
            {
              "label": "superior",
              "children": [
                {
                  "label": "pie in the sky"
                }
              ]
            },
            {
              "label": "incongruous",
              "children": [
                {
                  "label": "spare fixation"
                }
              ]
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "temporal lobe tumors",
              "children": [
                {
                  "label": "common cause of visual field loss"
                },
                {
                  "label": "neurologic findings of temporal lobe lesions",
                  "children": [
                    {
                      "label": "seizure",
                      "children": [
                        {
                          "label": "formed visual hallucinations"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "surgical excision of seizure foci"
            }
          ]
        }
      ]
    },
    {
      "label": "Visual Rehabilitation",
      "children": [
        {
          "label": "patients with homonymous hemianopia or quadrantanopia may benefit by referral to a vision rehabilitation specialist"
        },
        {
          "label": "visual scanning techniques",
          "children": [
            {
              "label": "encourage frequent exploratory saccades toward the blind hemifield"
            }
          ]
        },
        {
          "label": "orientation and mobility training",
          "children": [
            {
              "label": "help the patient manage daily tasks"
            }
          ]
        },
        {
          "label": "prisms",
          "children": [
            {
              "label": "compensate for visual field loss"
            }
          ]
        }
      ]
    },
    {
      "label": "olfactory"
    }
