      "label": "Fourth Nerve Palsy",
      "children": [
        {
          "label": "fourth nerve palsy",
          "children": [
            {
              "label": "grossly normal motility in most cases",
              "children": [
                {
                  "label": "± limited downgaze in the adducted position"
                }
              ]
            },
            {
              "label": "cover-uncover or Maddox rod testing"
            },
            {
              "label": "Parks-Bielschowsky 3-step test",
              "children": [
                {
                  "label": "ipsilateral hyperdeviation",
                  "children": [
                    {
                      "label": "worse on downgaze",
                      "children": [
                        {
                          "label": "compensatory chin down position"
                        },
                        {
                          "label": "worse on contralateral gaze",
                          "children": [
                            {
                              "label": "diplopia (tendency to close 1 eye) while reading!"
                            },
                            {
                              "label": "compensatory head turn to the opposite side"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "worse on ipsilateral head tilt",
                      "children": [
                        {
                          "label": "compensatory head tilt to the opposite side",
                          "children": [
                            {
                              "label": "facial asymmetry"
                            },
                            {
                              "label": "confirmed by reviewing old photographs"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "“spread of comitance”",
                      "children": [
                        {
                          "label": "reliability of the 3-step test in identifying patterns of vertical strabismus lessens somewhat over time"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "relative excyclotropia of the involved eye",
              "children": [
                {
                  "label": "most helpful in determining whether a vertical strabismus conforms to the pattern of a fourth nerve palsy"
                }
              ]
            },
            {
              "label": "large vertical fusional range (>3 prism diopters)",
              "children": [
                {
                  "label": "± asymptomatic until the adult years"
                }
