            {
              "label": "microvascular ischemic disease",
              "children": [
                {
                  "label": ".>50 years"
                },
                {
                  "label": "full medical evaluation is appropriate",
                  "children": [
                    {
                      "label": "function always improves and typically resolves within 3 months"
                    }
                  ]
                },
                {
                  "label": "older patients should be followed to ensure recovery",
                  "children": [
                    {
