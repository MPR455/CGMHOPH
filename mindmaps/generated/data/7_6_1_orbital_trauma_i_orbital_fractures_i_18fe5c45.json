{
  "label": "7.6.1. Orbital Trauma (I): Orbital Fractures (I)",
  "root": true,
  "children": [
    {
      "label": "Orbital Apex Fractures",
      "children": [
        {
          "label": "usually in association with other fractures of face, orbit, or skull"
        },
        {
          "label": "may involve optic canal, superior orbital fissure, and structures that pass through them"
        },
        {
          "label": "associated complications",
          "children": [
            {
              "label": "damage to optic nerve"
            },
            {
              "label": "cerebrospinal fluid leak"
            },
            {
              "label": "carotid-cavernous sinus fistula"
            }
          ]
        },
        {
          "label": "Indirect traumatic optic neuropathy",
          "children": [
            {
              "label": "stretching, tearing, twisting, or bruising of the fixed canalicular portion of the nerve"
            }
          ]
        },
        {
          "label": "thin-section computed tomography (CT)"
        }
      ]
    },
    {
      "label": "Midfacial (Le Fort) Fractures",
      "children": [
        {
          "label": "involve the maxilla",
          "children": [
            {
              "label": "often complex and asymmetric"
            },
            {
              "label": "extend posteriorly through the pterygoid plates"
            }
          ]
        },
        {
          "label": "Le Fort I",
          "children": [
            {
              "label": "low transverse maxillary fracture above the teeth with no orbital involvement"
            }
          ]
        },
        {
          "label": "Le Fort II",
          "children": [
            {
              "label": "pyramidal configuration and involve the nasal, lacrimal, and maxillary bones as well as the medial orbital floor"
            }
          ]
        },
        {
          "label": "Le Fort III",
          "children": [
            {
              "label": "cause craniofacial disjunction",
              "children": [
                {
                  "label": "entire facial skeleton is completely detached from the base of the skull"
                }
              ]
            },
            {
              "label": "orbital floor and medial and lateral orbital walls are involved"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "dental stabilization with arch bars"
            },
            {
              "label": "open reduction of the fracture with rigid fixation using titanium plating systems"
            }
          ]
        }
      ]
    },
    {
      "label": "Zygomatic Fractures",
      "children": [
        {
          "label": "Zygomaticomaxillary complex (ZMC) fractures",
          "children": [
            {
              "label": "\"tripod\" fractures",
              "children": [
                {
                  "label": "zygoma is usually fractured at 4 of its articulations with the adjacent bones !",
                  "children": [
                    {
                      "label": "frontozygomatic suture"
                    },
                    {
                      "label": "inferior orbital rim"
                    },
                    {
                      "label": "zygomatic arch"
                    },
                    {
                      "label": "lateral wall of the maxillary sinus"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "globe displacement"
            },
            {
              "label": "cosmetic deformity"
            },
            {
              "label": "diplopia"
            },
            {
              "label": "trismus (limitation of mandibular opening)"
            }
          ]
        },
        {
          "label": "involve the orbital floor to varying degrees"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "observation",
              "children": [
                {
                  "label": "if the zygoma is not significantly displaced"
                }
              ]
            },
            {
              "label": "open reduction and rigid plate fixation",
              "children": [
                {
                  "label": "best results"
                },
                {
                  "label": "exact realignment and stabilization of the lateral maxillary buttress and the lateral orbital wall are essential"
                },
                {
                  "label": "approach",
                  "children": [
                    {
                      "label": "sublabial or buccal sulcus incision"
                    },
                    {
                      "label": "eyelid incision",
                      "children": [
                        {
                          "label": "if the lateral maxillary buttress is only mildly displaced"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Medial Orbital Fractures",
      "children": [
        {
          "label": "naso-orbital-ethmoidal (NOE) fractures",
          "children": [
            {
              "label": "frontal process of the maxilla"
            },
            {
              "label": "lacrimal bone"
            },
            {
              "label": "ethmoid bones"
            }
          ]
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "face striking solid surfaces"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "depressed bridge of the nose"
            },
            {
              "label": "traumatic telecanthus"
            }
          ]
        },
        {
          "label": "classification",
          "children": [
            {
              "label": "type I",
              "children": [
                {
                  "label": "central fragment of bone attached to canthal tendon"
                }
              ]
            },
            {
              "label": "type II",
              "children": [
                {
                  "label": "comminuted fracture of the central fragment"
                }
              ]
            },
            {
              "label": "type III",
              "children": [
                {
                  "label": "comminuted tendon attachment or avulsed tendon"
                }
              ]
            }
          ]
        },
        {
          "label": "complications",
          "children": [
            {
              "label": "cerebral damage"
            },
            {
              "label": "ocular damage"
            },
            {
              "label": "severe epistaxis",
              "children": [
                {
                  "label": "avulsion of the anterior ethmoidal artery"
                }
              ]
            },
            {
              "label": "orbital hematoma"
            },
            {
              "label": "cerebrospinal fluid rhinorrhea"
            },
            {
              "label": "damage to the lacrimal drainage system"
            },
            {
              "label": "lateral displacement of the medial canthus"
            },
            {
              "label": "associated fractures of the medial orbital wall and floor"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "repair of the nasal fracture"
            },
            {
              "label": "plate stabilization"
            },
            {
              "label": "transnasal wiring of the medial canthus",
              "children": [
                {
                  "label": "used less frequently"
                },
                {
                  "label": "miniplate fixation often allows precise bony reduction!"
                }
              ]
            }
          ]
        },
        {
          "label": "indirect (blowout) fractures",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "extension of blowout fractures of the orbital floor",
                  "children": [
                    {
                      "label": "more common"
                    }
                  ]
                },
                {
                  "label": "Isolated blowout fracture of the medial orbital wall"
                }
              ]
            },
            {
              "label": "indications for surgical intervention",
              "children": [
                {
                  "label": "muscle and associated tissue entrapment"
                },
                {
                  "label": "enophthalmos",
                  "children": [
                    {
                      "label": "large, isolated medial wall fractures"
                    },
                    {
                      "label": "higher risk when both the floor and the medial wall are fractured"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "medial orbital wall approach",
                  "children": [
                    {
                      "label": "continuing the exploration of the floor up along the medial wall",
                      "children": [
                        {
                          "label": "via the eyelid or transconjunctival approach"
                        }
                      ]
                    },
                    {
                      "label": "medial orbitotomy through a Lynch (frontoethmoidal) incision in the skin"
                    },
                    {
                      "label": "transcaruncular approach"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
