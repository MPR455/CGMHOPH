{
  "label": "5.4.1. Patient With Decreased Vision: Classification & Management (I): Retinopathy (I)",
  "root": true,
  "children": [
    {
      "label": "Ocular Media Abnormality",
      "children": [
        {
          "label": "irregularities/opacities of the ocular media",
          "children": [
            {
              "label": "reduce visual acuity"
            },
            {
              "label": "± cause generalized reduction of sensitivity on automated perimetry testing"
            },
            {
              "label": "do not affect pupils, color vision, or the appearance of the posterior pole"
            }
          ]
        }
      ]
    },
    {
      "label": "Vitamin A Deficiency",
      "children": [
        {
          "label": "predisposing conditions",
          "children": [
            {
              "label": "malnutrition"
            },
            {
              "label": "malabsorption"
            },
            {
              "label": "liver disease"
            },
            {
              "label": "zinc deficiency",
              "children": [
                {
                  "label": "cofactor in the conversion of retinol to 11-cis- retinal"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "nyctalopia"
            },
            {
              "label": "peripheral visual field loss"
            },
            {
              "label": "± central vision loss"
            },
            {
              "label": "xerosis"
            },
            {
              "label": "conjunctival Bitôt spots"
            },
            {
              "label": "keratomalacia"
            }
          ]
        },
        {
          "label": "dramatic recovery with treatment",
          "children": [
            {
              "label": "vitamin A supplementation"
            },
            {
              "label": "treatment of any underlying systemic disorder"
            }
          ]
        }
      ]
    },
    {
      "label": "Retinopathy",
      "children": [
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "decreased visual acuity"
            },
            {
              "label": "central visual field loss",
              "children": [
                {
                  "label": "focal and central",
                  "children": [
                    {
                      "label": "optic nerve disease: visual field defects are larger, often cecocentral, and part of a generalized field depression"
                    }
                  ]
                }
              ]
            },
            {
              "label": "variable color vision loss",
              "children": [
                {
                  "label": "color vision loss = visual acuity loss",
                  "children": [
                    {
                      "label": "optic nerve disease: color vision loss > visual acuity loss"
                    }
                  ]
                }
              ]
            },
            {
              "label": "metamorphopsia",
              "children": [
                {
                  "label": "almost never in optic neuropathy"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic workup",
          "children": [
            {
              "label": "OCT",
              "children": [
                {
                  "label": "absent relative afferent pupillary defect (RAPD)"
                }
              ]
            },
            {
              "label": "fluorescein angiography"
            },
            {
              "label": "multifocal electroretinography (mfERG)"
            }
          ]
        },
        {
          "label": "maculopathies/retinopathies mistaken for optic nerve disease",
          "children": [
            {
              "label": "acute idiopathic blind-spot enlargement",
              "children": [
                {
                  "label": "overlaps with multiple evanescent white dot syndrome"
                }
              ]
            },
            {
              "label": "cone dystrophy"
            },
            {
              "label": "cancer-associated retinopathy (CAR) and melanoma-associated retinopathy (MAR)"
            },
            {
              "label": "central serous retinopathy"
            },
            {
              "label": "cystoid macular edema"
            },
            {
              "label": "acute zonal occult outer retinopathy (AZOOR)"
            }
          ]
        },
        {
          "label": "See Table 4-1"
        }
      ]
    },
    {
      "label": "AIBSE"
    },
    {
      "label": "Paraneoplastic Syndromes",
      "children": [
        {
          "label": "Cancer-associated retinopathy (CAR)",
          "children": [
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "photopsia"
                },
                {
                  "label": "impaired dark adaptation",
                  "children": [
                    {
                      "label": "nyctalopia"
                    }
                  ]
                },
                {
                  "label": "dimming"
                },
                {
                  "label": "peripheral and/or central visual field loss",
                  "children": [
                    {
                      "label": "ring scotoma"
                    }
                  ]
                },
                {
                  "label": "often (50%) before the underlying malignancy is identified"
                },
                {
                  "label": "progressively worsen over weeks to months"
                }
              ]
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "small cell lung carcinoma"
                },
                {
                  "label": "other lung tumors"
                },
                {
                  "label": "breast cancer"
                },
                {
                  "label": "uterine cancer"
                },
                {
                  "label": "cervical cancer"
                }
              ]
            },
            {
              "label": "funduscopy",
              "children": [
                {
                  "label": "initially normal",
                  "children": [
                    {
                      "label": "attenuated retinal arterioles"
                    }
                  ]
                },
                {
                  "label": "late",
                  "children": [
                    {
                      "label": "thinned and mottled RPE"
                    },
                    {
                      "label": "optic disc atrophy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "ERG",
              "children": [
                {
                  "label": "markedly reduced amplitudes",
                  "children": [
                    {
                      "label": "both a- and b-waves"
                    },
                    {
                      "label": "both rods and cones affected"
                    }
                  ]
                }
              ]
            },
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "tumor expresses an antigen homologous to 23-kDa retinal photoreceptor protein",
                  "children": [
                    {
                      "label": "recoverin",
                      "children": [
                        {
                          "label": "calcium-binding protein"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "circulating autoantibodies against the tumor- associated antigen",
                  "children": [
                    {
                      "label": "cross-react with retinal recoverin",
                      "children": [
                        {
                          "label": "immune-mediated degeneration of rods and cones"
                        },
                        {
                          "label": "• CaR = Cone + Rod ; ReCoverin • maR = Rod"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "corticosteroids",
                  "children": [
                    {
                      "label": "treatment of inciting tumor has an unclear effect on retinal function"
                    }
                  ]
                },
                {
                  "label": "plasmapheresis"
                },
                {
                  "label": "intravenous immunoglobulin",
                  "children": [
                    {
                      "label": "prognosis for vision is poor",
                      "children": [
                        {
                          "label": "vision loss is typically severe"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Melanoma-associated retinopathy (MAR)",
          "children": [
            {
              "label": "extremely rare"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "previously diagnosed melanoma",
                  "children": [
                    {
                      "label": "investigation often reveals recurrence or metastasis"
                    }
                  ]
                },
                {
                  "label": "involves rod bipolar cells"
                }
              ]
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "photopsia",
                  "children": [
                    {
                      "label": "• CaR = Cone + Rod ; ReCoverin • maR = Rod"
                    }
                  ]
                },
                {
                  "label": "nyctalopia"
                },
                {
                  "label": "prominent peripheral visual field loss",
                  "children": [
                    {
                      "label": "CAR affects rods and cones",
                      "children": [
                        {
                          "label": "CAR with auto-antibodies against alpha-enolase affects cones"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "develop rapidly over weeks to months",
                  "children": [
                    {
                      "label": "visual acuity, color vision, and the central visual field are often initially normal"
                    },
                    {
                      "label": "may have a sudden onset"
                    }
                  ]
                },
                {
                  "label": "bilateral"
                }
              ]
            },
            {
              "label": "fundus",
              "children": [
                {
                  "label": "may appear normal"
                },
                {
                  "label": "may show",
                  "children": [
                    {
                      "label": "RPE irregularity"
                    },
                    {
                      "label": "retinal arteriolar attenuation",
                      "children": [
                        {
                          "label": "MAR"
                        }
                      ]
                    },
                    {
                      "label": "optic disc pallor"
                    }
                  ]
                }
              ]
            },
            {
              "label": "diagnostic workup",
              "children": [
                {
                  "label": "full-field ERG",
                  "children": [
                    {
                      "label": "rod dysfunction",
                      "children": [
                        {
                          "label": "MAR affects rod function !"
                        }
                      ]
                    },
                    {
                      "label": "negative ERG waveform",
                      "children": [
                        {
                          "label": "similar to CSNB",
                          "children": [
                            {
                              "label": "similar to Duchenne muscular dystrophy"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "mfERG",
                  "children": [
                    {
                      "label": "relatively preserved",
                      "children": [
                        {
                          "label": "mfERG measures photopic (cone) responses"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "prognosis",
              "children": [
                {
                  "label": "visual function may remain stable and nonprogressive",
                  "children": [
                    {
                      "label": "unlike CAR!"
                    }
                  ]
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "no treatment has proven effective"
                },
                {
                  "label": "intravenous immunoglobulin"
                }
              ]
            }
          ]
        }
      ]
    },
