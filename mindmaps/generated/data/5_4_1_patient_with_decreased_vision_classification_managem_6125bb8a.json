    {
      "label": "Hydroxychloroquine and Chloroquine Retinopathy",
      "children": [
        {
          "label": "risk factors",
          "children": [
            {
              "label": "duration of use > 5 years"
            },
            {
              "label": "cumulative dose",
              "children": [
                {
                  "label": "1000 g (hydroxychloroquine)"
                },
                {
                  "label": "460 g (chloroquine)"
                },
                {
                  "label": "400 mg (hydroxychloroquine) or",
                  "children": [
                    {
                      "label": "<6.5 mg/kg/day",
                      "children": [
                        {
                          "label": "<5 mg/kg/day is safer"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "daily dose",
              "children": [
                {
                  "label": "250 mg (chloroquine)",
                  "children": [
                    {
                      "label": "<3 mg/kg/day"
                    }
                  ]
                }
              ]
            },
            {
              "label": "older age (>60 years)"
            },
            {
              "label": "kidney or liver dysfunction"
            },
            {
              "label": "preexisting macular disease"
            }
          ]
        },
        {
          "label": "revised screening recommendations (2011)",
          "children": [
            {
              "label": "baseline evaluation within 1 year of beginning treatment"
            },
            {
              "label": "annual examinations after 5 years of treatment",
              "children": [
                {
                  "label": "dilated fundus examination"
                },
                {
                  "label": "automated, white 10-2 threshold perimetry"
                },
                {
                  "label": "1 or more of the following 3 objective tests",
                  "children": [
                    {
                      "label": "spectral domain OCT (to detect parafoveal outer retinal attenuation)"
                    },
                    {
                      "label": "multifocal ERG (to detect parafoveal depressed amplitudes)"
                    },
                    {
                      "label": "fundus autofluorescence (to detect parafoveal increased autofluorescence)"
                    },
                    {
                      "label": "detect toxicity before fundus abnormalities become visible"
                    }
                  ]
                }
              ]
            },
            {
              "label": "fundus photography, Amsler grid testing, and color vision testing no longer recommended"
            }
          ]
        }
      ]
    },
    {
