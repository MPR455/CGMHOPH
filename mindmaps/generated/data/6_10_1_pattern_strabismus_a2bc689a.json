{
  "label": "6.10.1. Pattern Strabismus",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "definition",
          "children": [
            {
              "label": "horizontal deviation changes in magnitude between upgaze and downgaze"
            }
          ]
        },
        {
          "label": "V pattern",
          "children": [
            {
              "label": "most common"
            },
            {
              "label": "horizontal deviation is more divergent (less convergent) in upgaze than in downgaze",
              "children": [
                {
                  "label": "≥15 Δ",
                  "children": [
                    {
                      "label": "normally there is some physiologic convergence in downgaze"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "A pattern",
          "children": [
            {
              "label": "horizontal deviation is more divergent (less convergent) in downgaze compared with upgaze",
              "children": [
                {
                  "label": "≥10 Δ"
                }
              ]
            }
          ]
        },
        {
          "label": "15%–25% of horizontal strabismus cases"
        }
      ]
    },
    {
      "label": "Etiology",
      "children": [
        {
          "label": "Dysfunction of oblique muscles",
          "children": [
            {
              "label": "apparent inferior oblique muscle overaction with V patterns",
              "children": [
                {
                  "label": "overelevation in adduction (OEAd)"
                }
              ]
            },
            {
              "label": "apparent superior oblique muscle overaction with A patterns",
              "children": [
                {
                  "label": "overdepression in adduction (ODAd)"
                }
              ]
            }
          ]
        },
        {
          "label": "Abnormalities of the orbital pulley system",
          "children": [
            {
              "label": "patients with upward-or downward-slanting palpebral fissures may show A and V patterns"
            },
            {
              "label": "craniofacial anomalies",
              "children": [
                {
                  "label": "V-pattern strabismus"
                },
                {
                  "label": "marked elevation of the adducting eye"
                }
              ]
            }
          ]
        },
        {
          "label": "Dysfunction of horizontal rectus muscles",
          "children": [
            {
              "label": "effectiveness of lateral rectus muscles in the upper half of the vertical gaze field"
            },
            {
              "label": "effectiveness of medial rectus muscles in the lower half of this field"
            },
            {
              "label": "increases in lateral rectus or medial rectus muscle action produce a V pattern"
            },
            {
              "label": "decreases in lateral rectus or medial rectus muscle action produce a an A pattern"
            }
          ]
        },
        {
          "label": "Selective innervation of horizontal rectus muscles"
        },
        {
          "label": "Dysfunction of vertical rectus muscles",
          "children": [
            {
              "label": "increases or decreases in the tertiary adducting action of these muscles"
            }
          ]
        }
      ]
    },
    {
      "label": "Management",
      "children": [
        {
          "label": "General Principles",
          "children": [
            {
              "label": "apparent overaction of oblique muscles (OEAd, ODAd)",
              "children": [
                {
                  "label": "weakening of oblique muscles"
                }
              ]
            },
            {
              "label": "no apparent overaction of oblique muscles",
              "children": [
                {
                  "label": "vertical transposition of horizontal muscles",
                  "children": [
                    {
                      "label": "from one-half width to full width of insertion"
                    },
                    {
                      "label": "MALE",
                      "children": [
                        {
                          "label": "medial rectus muscles are always moved toward “apex” of pattern"
                        },
                        {
                          "label": "lateral rectus muscles are moved toward open end or “empty space”"
                        },
                        {
                          "label": "these rules apply whether horizontal rectus muscles are weakened or tightened"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "when horizontal rectus muscle recession- resection surgery is the preferred choice",
              "children": [
                {
                  "label": "displace rectus muscle insertions in mutually opposite directions",
                  "children": [
                    {
                      "label": "this displacement has little, if any, vertical effect in primary position"
                    }
                  ]
                },
                {
                  "label": "some surgeons adjust amount of horizontal surgery because of potential effect of oblique muscle weakening on horizontal deviation",
                  "children": [
                    {
                      "label": "particularly for superior oblique muscle surgery",
                      "children": [
                        {
                          "label": "bilateral superior oblique weakening causes a change of 10Δ–15Δ toward convergence in primary position"
                        }
                      ]
                    },
                    {
                      "label": "for inferior oblique muscle weakening procedures, amount of horizontal rectus muscle surgery does not need to be altered"
                    },
                    {
                      "label": "controversial"
                    }
                  ]
                }
              ]
            },
            {
              "label": "surgery on vertical rectus muscles is rarely employed",
              "children": [
                {
                  "label": "temporal displacement of superior rectus muscles for A-pattern esotropia"
                },
                {
                  "label": "temporal displacement of inferior rectus muscles for V-pattern esotropia"
                }
              ]
            }
          ]
        },
        {
          "label": "Treatment of Specific Patterns",
          "children": [
            {
              "label": "V pattern",
              "children": [
                {
                  "label": "V-pattern XT or ET + OEAd",
                  "children": [
                    {
                      "label": "inferior oblique muscle weakening",
                      "children": [
                        {
                          "label": "myectomy"
                        },
                        {
                          "label": "recession"
                        },
                        {
                          "label": "corrects ≤15Δ–20Δ of V pattern"
                        }
                      ]
                    },
                    {
                      "label": "patients who also have DVD",
                      "children": [
                        {
                          "label": "anterior transposition of inferior oblique muscle",
                          "children": [
                            {
                              "label": "may improve both V pattern and DVD"
                            }
                          ]
                        },
                        {
                          "label": "patients with V-pattern infantile ET <2 years are at risk of developing DVD",
                          "children": [
                            {
                              "label": "anterior transposition of inferior oblique may be considered in this group to preemptively address DVD"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "V-pattern XT or ET without OEAd",
                  "children": [
                    {
                      "label": "vertical transposition of horizontal rectus muscles"
                    }
                  ]
                }
              ]
            },
            {
              "label": "A pattern",
              "children": [
                {
                  "label": "A-pattern XT or ET + OEAd",
                  "children": [
                    {
                      "label": "superior oblique muscle weakening",
                      "children": [
                        {
                          "label": "tenectomy of posterior 7/8 of the insertions",
                          "children": [
                            {
                              "label": "corrects ≈ 20Δ of A pattern"
                            },
                            {
                              "label": "no significant effect on torsion"
                            }
                          ]
                        },
                        {
                          "label": "recession"
                        },
                        {
                          "label": "lengthening of the tendon",
                          "children": [
                            {
                              "label": "spacer"
                            },
                            {
                              "label": "Z-lengthening procedure"
                            }
                          ]
                        },
                        {
                          "label": "bilateral superior oblique tenotomy is a very powerful procedure",
                          "children": [
                            {
                              "label": "may correct up to 40Δ–50Δ of A pattern"
                            },
                            {
                              "label": "risk of induced torsional imbalance",
                              "children": [
                                {
                                  "label": "may cause problems for patients with fusional ability"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "A-pattern XT or ET without OEAd",
                  "children": [
                    {
                      "label": "vertical transposition of horizontal rectus muscles"
                    }
                  ]
                },
                {
                  "label": "trisomy 21",
                  "children": [
                    {
                      "label": "early-onset esotropia with A-pattern strabismus + ODAd",
                      "children": [
                        {
                          "label": "caused by orbital abnormalities"
                        },
                        {
                          "label": "vertical transposition of horizontal rectus muscles is employed"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "Y pattern",
              "children": [
                {
                  "label": "not due to overaction of inferior oblique muscles"
                },
                {
                  "label": "superior transposition of lateral rectus muscles"
                }
              ]
            },
            {
              "label": "X pattern",
              "children": [
                {
                  "label": "recession of lateral rectus muscles alone"
                }
              ]
            },
            {
              "label": "λ pattern",
              "children": [
                {
                  "label": "typically associated with ODAd"
                },
                {
                  "label": "superior oblique weakening procedures"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Clinical Features and Identification",
      "children": [
        {
          "label": "measuring alignment",
          "children": [
            {
              "label": "patient fixates on an accommodative target at distance, with fusion prevented",
              "children": [
                {
                  "label": "primary position"
                },
                {
                  "label": "straight upgaze",
                  "children": [
                    {
                      "label": "25° from the primary position"
                    }
                  ]
                },
                {
                  "label": "straight downgaze",
                  "children": [
                    {
                      "label": "25° from the primary position"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "proper refractive correction is necessary",
          "children": [
            {
              "label": "uncompensated accommodative component can introduce exaggerated convergence in downgaze"
            }
          ]
        },
        {
          "label": "V Pattern",
          "children": [
            {
              "label": "most common type"
            },
            {
              "label": "associations",
              "children": [
                {
                  "label": "infantile esotropia",
                  "children": [
                    {
                      "label": "most frequent"
                    },
                    {
                      "label": "not present when esotropia first develops",
                      "children": [
                        {
                          "label": "becomes apparent during the first year of life or later"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "superior oblique palsies",
                  "children": [
                    {
                      "label": "particularly if bilateral"
                    }
                  ]
                },
                {
                  "label": "craniofacial malformations"
                }
              ]
            }
          ]
        },
        {
          "label": "A Pattern",
          "children": [
            {
              "label": "second most common type"
            },
            {
              "label": "associations",
              "children": [
                {
                  "label": "exotropia",
                  "children": [
                    {
                      "label": "most frequent"
                    }
                  ]
                },
                {
                  "label": "A patterns are more common than V patterns in infantile strabismus associated with",
                  "children": [
                    {
                      "label": "craniofacial malformations"
                    },
                    {
                      "label": "trisomy 21"
                    },
                    {
                      "label": "myelomeningocele"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Y Pattern",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "aberrant innervation of the lateral rectus muscles in upgaze"
                }
              ]
            },
            {
              "label": "normal ocular alignment in primary position and downgaze"
            },
            {
              "label": "diverge in upgaze"
            },
            {
              "label": "appear to have overacting inferior oblique muscles",
              "children": [
                {
                  "label": "pseudo-overaction of the inferior oblique",
                  "children": [
                    {
                      "label": "overelevation is not seen when the eyes are moved directly horizontally",
                      "children": [
                        {
                          "label": "becomes manifest when the eyes are moved medially and slightly elevated"
                        }
                      ]
                    },
                    {
                      "label": "no fundus torsion"
                    },
                    {
                      "label": "no superior oblique muscle underaction"
                    }
                  ]
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "X Pattern",
          "children": [
            {
              "label": "pathogenesis",
              "children": [
                {
                  "label": "contracture of lateral rectus muscle",
                  "children": [
                    {
                      "label": "slippage of globe as eye adducts"
                    }
                  ]
                }
              ]
            },
            {
              "label": "most commonly seen in patients with large- angle exotropia"
            },
            {
              "label": "deviation in primary position increases in both upgaze and downgaze"
            },
            {
              "label": "overelevation and overdepression in adduction when the eye moves slightly above or below direct side gaze"
            }
          ]
        },
        {
          "label": "λ Pattern",
          "children": [
            {
              "label": "rare"
            },
            {
              "label": "deviation is the same in primary position and upgaze and increases in downgaze"
            },
            {
              "label": "usually associated with ODAd"
            }
          ]
        }
      ]
    }
  ],
