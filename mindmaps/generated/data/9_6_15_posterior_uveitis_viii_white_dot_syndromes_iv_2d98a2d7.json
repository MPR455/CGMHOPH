{
  "label": "9.6.15. Posterior Uveitis (VIII): White Dot Syndromes (IV)",
  "root": true,
  "children": [
    {
      "label": "perifoveal location"
    },
    {
      "label": "CME"
    },
    {
      "label": "Multiple evanescent white dot syndrome (MEWDS)",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "2nd-4th decades",
              "children": [
                {
                  "label": "healthy, young, moderately myopic females",
                  "children": [
                    {
                      "label": "similar to MCP, PIC, SFU, AZOOR"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "antecedent viral prodrome",
              "children": [
                {
                  "label": "1/3",
                  "children": [
                    {
                      "label": "similar to APMPPE"
                    }
                  ]
                }
              ]
            },
            {
              "label": "RPE–photoreceptor complex rather than the choroid"
            }
          ]
        },
        {
          "label": "natural course",
          "children": [
            {
              "label": "acute",
              "children": [
                {
                  "label": "self-limited"
                }
              ]
            },
            {
              "label": "recurrences are uncommon (10%–15%)",
              "children": [
                {
                  "label": "In contrast to most other WDSs"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "unilateral (80%)"
            },
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "decreased vision",
                  "children": [
                    {
                      "label": "photopsias"
                    }
                  ]
                },
                {
                  "label": "central or paracentral scotomata",
                  "children": [
                    {
                      "label": "enlarged physiologic blind spot"
                    }
                  ]
                }
              ]
            },
            {
              "label": "multiple, discrete, white-to-orange spots (100– 200 μm)",
              "children": [
                {
                  "label": "level of the RPE or deep retina"
                },
                {
                  "label": "transitory and frequently missed"
                },
                {
                  "label": "leave a granular macular pigmentary change",
                  "children": [
                    {
                      "label": "very useful in making the diagnosis after the white dots have faded"
                    }
                  ]
                }
              ]
            },
            {
              "label": "variable vitreous inflammation"
            },
            {
              "label": "mild blurring of the optic disc"
            },
            {
              "label": "small minority with chronic MEWDS develop choroidal scarring"
            },
            {
              "label": "isolated vascular sheathing",
              "children": [
                {
                  "label": "rare"
                }
              ]
            }
          ]
        },
        {
          "label": "paraclinical evaluation",
          "children": [
            {
              "label": "FA",
              "children": [
                {
                  "label": "late-staining, characteristic punctate hyperfluorescent lesions"
                },
                {
                  "label": "wreathlike configuration surrounding the fovea",
                  "children": [
                    {
                      "label": "each white dot comprises multiple punctate hyperfluorescent spots in a wreathlike cluster"
                    }
                  ]
                }
              ]
            },
            {
              "label": "ICG angiography",
              "children": [
                {
                  "label": "multiple hypofluorescent lesions that are more numerous than on clinical examination or FA",
                  "children": [
                    {
                      "label": "fade with resolution of the disease"
                    }
                  ]
                },
                {
                  "label": "hypofluorescence around optic disc"
                }
              ]
            },
            {
              "label": "FAF imaging",
              "children": [
                {
                  "label": "hyperfluorescent spots corresponding to those found on clinical examination"
                },
                {
                  "label": "small, punctate hypoautofluorescent areas localized around the optic disc and posterior pole"
                }
              ]
            },
            {
              "label": "visual field abnormalities",
              "children": [
                {
                  "label": "generalized depression"
                },
                {
                  "label": "paracentral or peripheral scotomata"
                },
                {
                  "label": "enlargement of the blind spot"
                }
              ]
            },
            {
              "label": "ERG",
              "children": [
                {
                  "label": "diminished a-wave"
                },
                {
                  "label": "reversible",
                  "children": [
                    {
                      "label": "diminished early receptor potential (ERP) amplitudes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "SD-OCT",
              "children": [
                {
                  "label": "abnormal photoreceptor inner/outer segment line (ellipsoid zone) reflectivity",
                  "children": [
                    {
                      "label": "reversible"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "prognosis",
          "children": [
            {
              "label": "excellent",
              "children": [
                {
                  "label": "recovery of vision within 2–10 weeks without treatment"
                }
              ]
            },
            {
              "label": "residual symptoms",
              "children": [
                {
                  "label": "photopsias"
                },
                {
                  "label": "enlargement of the blind spot"
                },
                {
                  "label": "may persist for months"
                }
              ]
            }
          ]
        },
        {
          "label": "associated ocular conditions",
          "children": [
            {
              "label": "MCP"
            },
            {
              "label": "acute zonal occult outer retinopathy"
            },
            {
              "label": "acute macular neuroretinopathy",
              "children": [
                {
                  "label": "rare",
                  "children": [
                    {
                      "label": "healthy young women"
                    }
                  ]
                },
                {
                  "label": "acute onset of visual impairment and multifocal scotomata"
                },
                {
                  "label": "minimal decrease in visual acuity",
                  "children": [
                    {
                      "label": "reddish, flat, wedge-shaped lesions in the macula"
                    },
                    {
                      "label": "symptoms frequently persist despite resolution of the fundus lesions"
                    }
                  ]
                },
                {
                  "label": "no treatment required"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Subretinal fibrosis and uveitis syndrome",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "extremely uncommon panuveitis"
            },
            {
              "label": "young women with myopia",
              "children": [
                {
                  "label": "14-34 years",
                  "children": [
                    {
                      "label": "95% F"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "unknown",
              "children": [
                {
                  "label": "similar to MCP & PIC"
                }
              ]
            },
            {
              "label": "immune mechanisms",
              "children": [
                {
                  "label": "local antibodies directed against the RPE"
                },
                {
                  "label": "enhanced expression of the Fas-Fas ligand in the retina"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "bilateral"
            },
            {
              "label": "panuveitis",
              "children": [
                {
                  "label": "mild to moderate vitritis",
                  "children": [
                    {
                      "label": "unlike most other WDSs"
                    }
                  ]
                },
                {
                  "label": "significant anterior segment inflammation"
                }
              ]
            },
            {
              "label": "white-yellow lesions (50–500 μm)",
              "children": [
                {
                  "label": "posterior pole to midperiphery"
                },
                {
                  "label": "level of the RPE"
                },
                {
                  "label": "lesions may",
                  "children": [
                    {
                      "label": "fade without RPE alterations"
                    },
                    {
                      "label": "become atrophic",
                      "children": [
                        {
                          "label": "choroidal scars"
                        }
                      ]
                    },
                    {
                      "label": "enlarge and coalesce into large, white, stellate zones of subretinal fibrosis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "serous neurosensory retinal detachment",
              "children": [
                {
                  "label": "similar to MCP"
                }
              ]
            },
            {
              "label": "natural course",
              "children": [
                {
                  "label": "CNV"
                },
                {
                  "label": "insidious onset"
                },
                {
                  "label": "chronic recurrent",
                  "children": [
                    {
                      "label": "similar to MCP"
                    }
                  ]
                }
              ]
            },
            {
              "label": "guarded visual prognosis"
            }
          ]
        },
        {
          "label": "paraclinical evaluation",
          "children": [
            {
              "label": "FA",
