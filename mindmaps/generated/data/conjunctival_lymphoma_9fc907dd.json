    {
      "label": "Assessment",
      "children": [
        {
          "label": "conjunctival lymphoma"
        }
      ]
    },
    {
      "label": "Differential Diagnosis",
      "children": [
        {
          "label": "conjunctival lymphoma",
          "children": [
            {
              "label": "age > 50 yr",
              "children": [
                {
                  "label": "relatively well-defined salmon-pink subconjunctival mass involving the bulbar conjunctiva of the left eye"
                }
              ]
            },
            {
              "label": "usually unilateral",
              "children": [
                {
                  "label": "20% are bilateral"
                }
              ]
            },
            {
              "label": "soft & mobile"
            },
            {
              "label": "± orbital component"
            },
            {
              "label": "most are extranodal marginal zone B-cell lymphoma (MALT type)"
            }
          ]
        },
        {
          "label": "conjunctival lymphoid hyperplasia",
          "children": [
            {
              "label": "clinically similar to lymphoma"
            }
          ]
        },
        {
          "label": "extrascleral extension of uveal lymphoma",
          "children": [
            {
              "label": "subconjunctival salmon- colored mass fixed to the underlying sclera"
            }
          ]
        },
        {
          "label": "conjunctival amyloidosis",
          "children": [
            {
              "label": "salmon-colored nodular elevation that may be associated with hemorrhage"
            }
          ]
        },
        {
          "label": "episcleritis/scleritis"
        }
      ]
    },
    {
      "label": "Treatment",
      "children": [
        {
          "label": "biopsy",
          "children": [
            {
              "label": "excisional if small"
            },
            {
              "label": "incisional if large"
            },
            {
              "label": "± supplemental cryotherapy"
            }
          ]
        },
        {
          "label": "EBRT",
          "children": [
            {
              "label": "if complete excision not possible"
            }
          ]
        },
        {
          "label": "intralesional interferon-α2b"
        },
        {
          "label": "systemic rituximab"
        },
        {
          "label": "chemotherapy",
          "children": [
            {
              "label": "if systemic disease",
              "children": [
                {
                  "label": "underlying systemic lymphoma may be present or develop in ≤ 31%"
                }
              ]
            }
          ]
        },
        {
          "label": "refer to oncologist for systemic evaluation"
        }
      ]
    },
    {
      "label": "Patient Education",
      "children": [
        {
          "label": "General",
          "children": [
            {
              "label": "explain importance of long- term medical evaluation for lymphoma"
            }
          ]
        },
        {
          "label": "Prognosis",
          "children": [
            {
              "label": "good prognosis if localized"
            },
            {
              "label": "more guarded prognosis if systemic",
              "children": [
                {
                  "label": "higher risk if bilateral"
