{
  "label": "7.10.6. Eyelid Neoplasms (III): Benign Melanocytic Lesions",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "Melanocytic lesions of the skin arise from 3 sources",
          "children": [
            {
              "label": "nevus cells",
              "children": [
                {
                  "label": "are arranged in clusters"
                },
                {
                  "label": "nevus cells are similar to melanocytes",
                  "children": [
                    {
                      "label": "have ultrastructural differences with melanocytes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "dermal melanocytes"
            },
            {
              "label": "epidermal melanocytes"
            }
          ]
        },
        {
          "label": "any benign or malignant lesion may be pigmented",
          "children": [
            {
              "label": "seborrheic keratoses are frequently pigmented"
            },
            {
              "label": "basal cell carcinomas are occasionally pigmented",
              "children": [
                {
                  "label": "especially in patients with darker skin"
                }
              ]
            }
          ]
        },
        {
          "label": "lesions of melanocytic origin do not necessarily have visible pigmentation",
          "children": [
            {
              "label": "dermal nevi typically have no pigmentation in white individuals"
            }
          ]
        }
      ]
    },
    {
      "label": "Diffuse eyelid skin hyperpigmentation",
      "children": [
        {
          "label": "melasma",
          "children": [
            {
              "label": "chloasma"
            }
          ]
        },
        {
          "label": "predisposing conditions",
          "children": [
            {
              "label": "pregnancy"
            },
            {
              "label": "oral contraceptive use"
            },
            {
              "label": "autosomal dominant trait"
            },
            {
              "label": "chronic atopic eczema"
            },
            {
              "label": "rosacea"
            },
            {
              "label": "other inflammatory dermatoses"
            }
          ]
        }
      ]
    },
    {
      "label": "Dermal melanocytosis",
      "children": [
        {
          "label": "\"nevus of Ota\""
        },
        {
          "label": "congenital"
        },
        {
          "label": "most often affects persons of African, Hispanic, or Asian descent"
        },
        {
          "label": "female>male"
        },
        {
          "label": "5% bilateral"
        },
        {
          "label": "proliferation of dermal melanocytes"
        },
        {
          "label": "diffuse, blue nevus of the periocular skin",
          "children": [
            {
              "label": "eyelid skin is diffusely brown, gray, or blue"
            },
            {
              "label": "pigmentation may extend to the adjacent forehead"
            },
            {
              "label": "first and second dermatomes of cranial nerve V"
            }
          ]
        },
        {
          "label": "malignant transformation may occur, especially in white patients"
        },
        {
          "label": "no prophylactic treatment is recommended"
        },
        {
          "label": "oculodermal melanocytosis",
          "children": [
            {
              "label": "2/3 of affected patients"
            },
            {
              "label": "patchy slate-gray pigmentation affects eyelid, episclera, and uvea"
            },
            {
              "label": "10% develop glaucoma and pigmentation of the trabecular meshwork"
            },
            {
              "label": "0.25% develop a uveal melanoma"
            }
          ]
        }
      ]
    },
    {
      "label": "Nevi",
      "children": [
        {
          "label": "third most common benign lesions in the periocular region",
          "children": [
            {
              "label": "after papillomas and epidermal inclusion cysts"
            }
          ]
        },
        {
          "label": "arise from nevus cells",
          "children": [
            {
              "label": "incompletely differentiated melanocytes in the epidermis, dermis, and in junction zone between these 2 layers"
            }
          ]
        },
        {
          "label": "natural course",
          "children": [
            {
              "label": "not apparent clinically at birth"
            },
            {
              "label": "appear during childhood"
            },
            {
              "label": "increased pigmentation during puberty"
            }
          ]
        },
        {
          "label": "all nevi undergo through 3 stages",
          "children": [
            {
              "label": "junctional",
              "children": [
                {
                  "label": "basal layer of the epidermis at the dermal– epidermal junction"
                },
                {
                  "label": "in children, nevi arise initially as junctional nevi"
                },
                {
                  "label": "flat, pigmented macules"
                }
              ]
            },
            {
              "label": "compound",
              "children": [
                {
                  "label": "extending from the junctional zone up into the epidermis and down into the dermis"
                },
                {
                  "label": "after second decade"
                },
                {
                  "label": "elevated, pigmented papules"
                },
                {
                  "label": "later in life, pigmentation is lost",
                  "children": [
                    {
                      "label": "become minimally pigmented or amelanotic"
                    }
                  ]
                }
              ]
            },
            {
              "label": "dermal",
              "children": [
                {
                  "label": "involution of the epidermal component and persistence of the dermal component"
                },
                {
                  "label": "by age 70 years, virtually all nevi have become dermal nevi and have lost pigmentation"
                }
              ]
            }
          ]
        },
        {
          "label": "nevi are frequently found on the eyelid margin",
          "children": [
            {
              "label": "molded to the ocular surface"
            }
          ]
        },
        {
          "label": "symptomatic nevi",
          "children": [
            {
              "label": "rub on the ocular surface"
            },
            {
              "label": "enlarge and obstruct vision"
            }
          ]
        },
        {
          "label": "malignant transformation of a junctional or compound nevus can occur",
          "children": [
            {
              "label": "rare"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "observation",
              "children": [
                {
                  "label": "asymptomatic nevi"
                }
              ]
            },
            {
              "label": "shave excision"
            },
            {
              "label": "wedge resection"
            }
          ]
        }
      ]
    },
    {
      "label": "Blue nevi",
      "children": [
        {
          "label": "± congenital"
        },
        {
          "label": "± develop during childhood"
        },
        {
          "label": "arise from a localized proliferation of dermal melanocytes"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "beneath the epidermis"
            },
            {
              "label": "slightly elevated"
            },
            {
              "label": "dark blue-gray to blue-black"
            },
            {
              "label": "10 mm or less in diameter"
            }
          ]
        },
        {
          "label": "malignant potential is extremely low"
        },
        {
          "label": "generally excised"
        }
      ]
    },
    {
      "label": "Freckle",
      "children": [
        {
          "label": "\"ephelis\""
        },
        {
          "label": "small, flat, brown spot on the skin"
        },
        {
          "label": "common in fair-skinned persons"
        },
        {
          "label": "darken with sunlight exposure"
        },
        {
          "label": "hyperpigmentation of the basal layer of the epidermis"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "sun protection"
            }
          ]
        }
      ]
    },
    {
      "label": "similar to lentigo simplex",
      "children": [
        {
          "label": "Solar lentigo",
          "children": [
            {
              "label": "older persons",
              "children": [
                {
                  "label": "senile lentigo"
                }
              ]
            },
            {
              "label": "chronic sun exposure"
            },
            {
              "label": "pigmented macules",
              "children": [
                {
                  "label": "multiple"
                },
                {
                  "label": "uniformly hyperpigmented"
                },
                {
                  "label": "somewhat larger than simple lentigines"
                }
              ]
            },
            {
              "label": "dorsum of the hands and the forehead",
              "children": [
                {
                  "label": "increased number of melanocytes"
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "no treatment is necessary"
                },
                {
                  "label": "sun protection is recommended"
                },
                {
                  "label": "methods to fade the pigmentation",
                  "children": [
                    {
                      "label": "melanin-bleaching preparations"
                    },
                    {
                      "label": "intense pulsed light treatment"
                    },
                    {
                      "label": "cryotherapy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "unlike ephelis"
        }
      ]
    },
    {
      "label": "Lentigo simplex",
      "children": [
        {
          "label": "occurs throughout life"
        },
        {
          "label": "not related to sun exposure"
        },
        {
          "label": "may be associated with Peutz-Jeghers syndrome",
          "children": [
            {
              "label": "autosomal dominant"
            },
            {
              "label": "polyposis of the intestinal tract"
            }
          ]
        },
        {
          "label": "flat, pigmented spot",
          "children": [
            {
              "label": "larger in diameter than ephelides",
              "children": [
                {
                  "label": "few millimeters in diameter"
                }
              ]
            },
            {
              "label": "evenly pigmented"
            }
          ]
        },
        {
          "label": "histology",
          "children": [
            {
              "label": "number of epidermal melanocytes is increased",
              "children": [
                {
                  "label": "number of epidermal melanocytes is not increased!",
                  "children": [
                    {
                      "label": "they extrude more than the usual amount of pigment into the epidermal basal cell layer"
                    }
                  ]
                }
              ]
            },
            {
              "label": "melanin is found in adjacent basal keratinocytes"
            }
          ]
        },
        {
          "label": "no treatment is necessary"
        }
      ]
    }
