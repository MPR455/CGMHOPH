{
  "label": "7.2.3. Evaluation of Orbital Disorders (III)",
  "root": true,
  "children": [
    {
      "label": "Arteriography",
      "children": [
        {
          "label": "gold standard for diagnosis of an arterial lesion",
          "children": [
            {
              "label": "aneurysm"
            },
            {
              "label": "arteriovenous malformation"
            }
          ]
        },
        {
          "label": "technique",
          "children": [
            {
              "label": "retrograde catheterization of the cerebral vessels through the femoral artery"
            }
          ]
        },
        {
          "label": "small risk of serious neurologic and vascular complications (1%–2%)",
          "children": [
            {
              "label": "reserved for patients with a high probability of having a lesion"
            }
          ]
        },
        {
          "label": "ability to simultaneously treat and image a lesion"
        },
        {
          "label": "visualization can be maximized by",
          "children": [
            {
              "label": "selective injection of internal and external carotid arteries"
            },
            {
              "label": "magnification to allow viewing of the smaller caliber vessels"
            },
            {
              "label": "subtraction techniques to radiographically eliminate bone"
            }
          ]
        }
      ]
    },
    {
      "label": "CT and MR Angiography",
      "children": [
        {
          "label": "indications",
          "children": [
            {
              "label": "arteriovenous malformations"
            },
            {
              "label": "aneurysms"
            },
            {
              "label": "arteriovenous fistulas",
              "children": [
                {
                  "label": "MR angiography is less sensitive than direct angiography for identifying carotid-cavernous sinus fistulas !",
                  "children": [
                    {
                      "label": "consult with a radiologist to discuss the suspected lesion and to ensure selection of the best imaging modality"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Pathology",
      "children": [
        {
          "label": "fixatives",
          "children": [
            {
              "label": "formalin",
              "children": [
                {
                  "label": "for most tissue samples"
                }
              ]
            },
            {
              "label": "fresh tissue",
              "children": [
                {
                  "label": "when a lymphoproliferative lesion is suspected",
                  "children": [
                    {
                      "label": "for flow cytometry"
                    }
                  ]
                }
              ]
            },
            {
              "label": "glutaraldehyde",
              "children": [
                {
                  "label": "for possible electron microscopy"
                }
              ]
            }
          ]
        },
        {
          "label": "frozen section",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "to confirm that appropriate tissue has been obtained for permanent section",
                  "children": [
                    {
                      "label": "when area of proposed biopsy is not obvious"
                    }
                  ]
                },
                {
                  "label": "to determine tumor margins and ensure complete tumor removal intraoperatively"
                },
                {
                  "label": "for cell-surface marker studies",
                  "children": [
                    {
                      "label": "required for all orbital lymphoid lesions",
                      "children": [
                        {
                          "label": "may permit differentiation of reactive lymphoid hyperplasia from lymphoma"
                        }
                      ]
                    },
                    {
                      "label": "for estrogen receptors in cases of metastatic prostate or breast carcinoma"
                    },
                    {
                      "label": "diagnosis of poorly differentiated tumors when light microscopy cannot yield a definitive diagnosis",
                      "children": [
                        {
                          "label": "cell-marker studies have largely replaced electron microscopy in the diagnosis of undifferentiated tumors"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "generally not used for definitive diagnosis of an orbital tumor"
            },
            {
              "label": "tissue for frozen section should be placed in a dampened saline gauze and promptly sent to laboratory"
            }
          ]
        },
        {
          "label": "touch prep",
          "children": [
            {
              "label": "noncohesive tumors (hematologic or lymphoid)"
            }
          ]
        },
        {
          "label": "fine-needle aspiration biopsy",
          "children": [
            {
              "label": "under either ultrasonographic or CT control"
            },
            {
              "label": "specimen is usually limited to cytologic study",
              "children": [
                {
                  "label": "occasionally yields a sufficient cell block !"
                }
              ]
            },
            {
              "label": "a cytologist or trained technician must be available to handle the aspirate"
            },
            {
              "label": "may not permit as firm a diagnosis as is possible with larger biopsy specimens"
            }
          ]
        },
        {
          "label": "preoperative consultation with a pathologist familiar with orbital disease may be helpful"
        },
        {
          "label": "appropriate handling of the tissue specimen is necessary",
          "children": [
            {
              "label": "all biopsy specimens must be treated delicately"
            },
            {
              "label": "permanent section tissue biopsy specimens should be placed in fixative promptly"
            }
          ]
        }
      ]
    },
    {
      "label": "Laboratory Studies",
      "children": [
        {
          "label": "thyroid eye disease",
          "children": [
            {
              "label": "screening for abnormal thyroid function",
              "children": [
                {
                  "label": "T4"
                },
                {
                  "label": "thyroid-stimulating hormone (TSH)"
                },
                {
                  "label": "abnormal in 90%"
                }
              ]
            },
            {
              "label": "if TED is strongly suspected and screening tests are normal",
              "children": [
                {
                  "label": "thyroid-stimulating immunoglobulins"
                },
                {
                  "label": "TSH-receptor antibodies"
                }
              ]
            }
          ]
        },
        {
          "label": "granulomatosis with polyangiitis (Wegener granulomatosis",
          "children": [
            {
              "label": "sclerokeratitis or sinus disease + orbital mass"
            },
            {
              "label": "antineutrophil cytoplasmic antibody (ANCA) serum assay",
              "children": [
                {
                  "label": "c-ANCA"
                },
                {
                  "label": "may be negative initially in localized disease"
                }
              ]
            },
            {
              "label": "biopsy of affected tissues classically shows",
              "children": [
                {
                  "label": "granulomatous inflammation"
                },
                {
                  "label": "tissue necrosis"
                },
                {
                  "label": "vasculitis",
                  "children": [
                    {
                      "label": "necrotizing vasculitis is not always present in orbital biopsies"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "sarcoidosis",
          "children": [
            {
              "label": "may present with",
              "children": [
                {
                  "label": "conjunctival granulomas"
                },
                {
                  "label": "extraocular muscle infiltration"
                },
                {
                  "label": "optic nerve infiltration"
                },
                {
                  "label": "lacrimal gland enlargement"
                },
                {
                  "label": "solitary orbital granulomas"
                }
              ]
            },
            {
              "label": "serum angiotensin-converting enzyme (ACE)"
            },
            {
              "label": "lysozyme"
            }
          ]
        }
      ]
    },
    {
      "label": "Venography",
      "children": [
        {
          "label": "before the era of CT and MRI"
        },
        {
          "label": "indications",
          "children": [
            {
              "label": "orbital varices"
            },
            {
              "label": "study of the cavernous sinus"
            }
          ]
        },
        {
          "label": "technique",
          "children": [
            {
              "label": "contrast material is injected into the frontal or the angular vein",
              "children": [
                {
                  "label": "some orbitocranial vascular malformations or fistulas are best accessed via the superior ophthalmic vein"
                }
              ]
            },
            {
              "label": "subtraction and magnification techniques"
            }
          ]
        },
        {
          "label": "larger venous abnormalitie/structures can be visualized well on MR venography",
          "children": [
            {
              "label": "moving blood generates a signal void during MR imaging!"
            }
          ]
        }
      ]
    }
