{
  "label": "7.5.6. Orbital Neoplasms and Malformations (VI): Lymphoproliferative Disorders",
  "root": true,
  "children": [
    {
      "label": "Xanthogranuloma",
      "children": [
        {
          "label": "adult xanthogranuloma of the adnexa and orbit is often associated with systemic manifestations"
        },
        {
          "label": "4 syndromes",
          "children": [
            {
              "label": "necrobiotic xanthogranuloma (NBX)",
              "children": [
                {
                  "label": "subcutaneous lesions",
                  "children": [
                    {
                      "label": "eyelids and anterior orbit"
                    },
                    {
                      "label": "may occur throughout the body"
                    },
                    {
                      "label": "have a propensity to ulcerate and fibrose"
                    }
                  ]
                },
                {
                  "label": "systemic findings",
                  "children": [
                    {
                      "label": "paraproteinemia"
                    },
                    {
                      "label": "multiple myeloma"
                    }
                  ]
                }
              ]
            },
            {
              "label": "adult-onset asthma with periocular xanthogranuloma (AAPOX)",
              "children": [
                {
                  "label": "periocular xanthogranuloma"
                },
                {
                  "label": "asthma"
                },
                {
                  "label": "lymphadenopathy"
                },
                {
                  "label": "increased immunoglobulin G levels"
                }
              ]
            },
            {
              "label": "Erdheim-Chester disease (ECD)",
              "children": [
                {
                  "label": "most devastating of the adult xanthogranulomas",
                  "children": [
                    {
                      "label": "death frequent",
                      "children": [
                        {
                          "label": "despite aggressive therapy!"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "dense, progressive, recalcitrant fibrosclerosis of",
                  "children": [
                    {
                      "label": "orbit",
                      "children": [
                        {
                          "label": "diffuse xanthogranuloma of the orbit and adnexa",
                          "children": [
                            {
                              "label": "xanthogranuloma of the orbit and adnexa tends to be anterior in NBX, AAPOX, and AOX"
                            },
                            {
                              "label": "leads to vision loss"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "internal organs"
                    },
                    {
                      "label": "mediastinum"
                    },
                    {
                      "label": "pericardium"
                    },
                    {
                      "label": "pleural space"
                    },
                    {
                      "label": "perinephric space"
                    },
                    {
                      "label": "retroperitoneal space"
                    },
                    {
                      "label": "bone involvement is common"
                    }
                  ]
                }
              ]
            },
            {
              "label": "adult-onset xanthogranuloma (AOX)",
              "children": [
                {
                  "label": "isolated xanthogranulomatous lesion without systemic involvement"
                },
                {
                  "label": "juvenile xanthogranuloma",
                  "children": [
                    {
                      "label": "focal subcutaneous disease of childhood"
                    },
                    {
                      "label": "self-limited"
                    },
                    {
                      "label": "corticosteroid-sensitive"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Lymphoid Hyperplasia and Lymphoma",
      "children": [
        {
          "label": "Introduction",
          "children": [
            {
              "label": "20% of all orbital tumors"
            },
            {
              "label": "% of orbital lymphoproliferative lesions designated as malignant lymphoma",
              "children": [
                {
                  "label": "70%–80% on the basis of monoclonal cell- surface markers"
                },
                {
                  "label": "90% based on molecular genetic studies"
                }
              ]
            },
            {
              "label": "over time, some conjunctival lymphoid lesions fluctuate between being monoclonal and polyclonal"
            },
            {
              "label": "incidence of non-Hodgkin lymphoma (NHL) of all anatomical sites has been increasing",
              "children": [
                {
                  "label": "3–4% /year"
                },
                {
                  "label": "50% over the last 20 years"
                },
                {
                  "label": "NHL is the 4th most common malignancy among men and women"
                },
                {
                  "label": "incidence of orbital lymphomas has been increasing at an even greater rate"
                }
              ]
            },
            {
              "label": "risk factors for NHL",
              "children": [
                {
                  "label": "older adults"
                },
                {
                  "label": "patients with chronic autoimmune diseases"
                },
                {
                  "label": "long-term exposure to bioactive solvents and reagents"
                }
              ]
            }
          ]
        },
        {
          "label": "Classification of NHL",
          "children": [
            {
              "label": "largely based on nodal architecture"
            },
            {
              "label": "Revised European-American Lymphoma (REAL) classification",
              "children": [
                {
                  "label": "includes extranodal sites, including orbit"
                }
              ]
            },
            {
              "label": "orbital extranodal NHL appears to represent a biological continuum and to behave unpredictably",
              "children": [
                {
                  "label": "extraorbital lymphoma can develop in patients with orbital lymphoid infiltrates that appear benign histologically"
                },
                {
                  "label": "patients with malignant lymphoma of ocular adnexa may respond satisfactorily to local therapy without subsequent systemic involvement"
                }
              ]
            },
            {
              "label": "cell of origin",
              "children": [
                {
                  "label": "most orbital lymphomas are derived from B cells",
                  "children": [
                    {
                      "label": "Hodgkin lymphoma",
                      "children": [
                        {
                          "label": "rarely metastasize to the orbit"
                        }
                      ]
                    },
                    {
                      "label": "non-Hodgkin lymphoma",
                      "children": [
                        {
                          "label": "malignant B-cell NHL accounts for >90% of orbital lymphoproliferative disease"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "T-cell lymphoma is rare",
                  "children": [
                    {
                      "label": "more lethal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "4 most common types of orbital lymphomas",
          "children": [
            {
              "label": "mucosa-associated lymphoid tissue (MALT) lymphomas",
              "children": [
                {
                  "label": "40%–60%"
                },
                {
                  "label": "originally described as occurring in the gastrointestinal tract"
                },
                {
                  "label": "proliferation of early MALT tumors may be antigen driven",
                  "children": [
                    {
                      "label": "therapy directed at the antigen (eg, against Helicobacter pylori in gastric lymphomas) may result in regression of early lesions"
                    },
                    {
                      "label": "some conjunctival MALT lymphomas are associated with chronic chlamydial infection"
                    }
                  ]
                },
                {
                  "label": "in contrast to MALT lymphomas occurring in other areas of the body, those in the ocular adnexa do not appear to be preferentially associated with mucosal tissue (ie, conjunctiva, lacrimal gland)"
                },
                {
                  "label": "low grade of malignancy"
                },
                {
                  "label": "systemic disease at 10 years",
                  "children": [
                    {
                      "label": "≥ 50%"
                    }
                  ]
                },
                {
                  "label": "spontaneous remission",
                  "children": [
                    {
                      "label": "5%–15%"
                    }
                  ]
                },
                {
                  "label": "transformation to a higher-grade lesion (usually of a large cell type)",
                  "children": [
                    {
                      "label": "15%–20%"
                    },
                    {
                      "label": "occurs after several years and is not related to therapy"
                    }
                  ]
                }
              ]
            },
            {
              "label": "chronic lymphocytic lymphoma (CLL)",
              "children": [
                {
                  "label": "low-grade lesion of small, mature-appearing lymphocytes"
                }
              ]
            },
            {
              "label": "follicular center lymphoma",
              "children": [
                {
                  "label": "low-grade"
                },
                {
                  "label": "follicular centers"
                }
              ]
            },
            {
              "label": "high-grade lymphomas",
              "children": [
                {
                  "label": "large cell lymphoma"
                },
                {
                  "label": "lymphoblastic lymphoma"
                },
                {
                  "label": "Burkitt lymphoma"
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical presentation",
          "children": [
            {
              "label": "gradually progressive, painless mass",
              "children": [
                {
                  "label": "low-grade lymphomas & reactive lymphoid hyperplasias show slow expansion over a period of months to years"
                }
              ]
            },
            {
              "label": "≈ 17% bilateral",
              "children": [
                {
                  "label": "does not necessarily indicate presence of extraorbital disease"
                }
              ]
            },
            {
              "label": "location",
              "children": [
                {
                  "label": "anterior orbit"
                },
                {
                  "label": "beneath the conjunctiva",
                  "children": [
                    {
                      "label": "salmon-patch appearance"
                    }
                  ]
                }
              ]
            },
            {
              "label": "mold to surrounding orbital structures rather than invade them",
              "children": [
                {
                  "label": "disturbances of extraocular motility or visual function are unusual"
                }
              ]
            },
            {
              "label": "≤50% of orbital lymphoproliferative lesions arise in the lacrimal fossa"
            },
            {
              "label": "orbital imaging",
              "children": [
                {
                  "label": "characteristic puttylike molding of the tumor to normal structures"
                },
                {
                  "label": "bone erosion or infiltration is usually not seen",
                  "children": [
                    {
                      "label": "except with high-grade malignant lymphomas"
                    }
                  ]
                }
              ]
            },
            {
              "label": "lymphomas in the retrobulbar fat may appear more infiltrative"
            },
            {
              "label": "systemic lymphoma",
              "children": [
                {
                  "label": "1/2 of periocular lymphomas",
                  "children": [
                    {
                      "label": "20%–30% have a history of previous or concomitant systemic disease"
                    },
                    {
                      "label": "30% develop it over 5 years"
                    }
                  ]
                },
                {
                  "label": "anatomical site of origin is predictive of systemic lymphoma",
                  "children": [
                    {
                      "label": "eyelid>orbit>conjunctiva",
                      "children": [
                        {
                          "label": "lymphoid lesions in the lacrimal fossa may carry a greater risk of systemic disease"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "bilateral periocular involvement markedly increases the risk of systemic disease",
                  "children": [
                    {
                      "label": "not a definitive evidence of systemic disease"
                    }
                  ]
                },
                {
                  "label": "the risk of systemic disease is increased for decades after the original lesion is diagnosed, regardless of the initial lesion’s location in the orbit or its clonality"
                }
              ]
            }
          ]
        },
        {
          "label": "Diagnosis",
          "children": [
            {
              "label": "technique",
              "children": [
                {
                  "label": "open biopsy is preferred",
                  "children": [
                    {
                      "label": "light microscopy (fixation)",
                      "children": [
                        {
                          "label": "may reveal a continuum from reactive hyperplasia to low-grade lymphoma to higher- grade malignancy"
                        },
                        {
                          "label": "hypercellular proliferations with sparse or absent stromal components",
                          "children": [
                            {
                              "label": "both reactive hyperplasia and malignant lymphoma"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "majority of the specimen should be sent fresh to a molecular diagnostics laboratory",
                      "children": [
                        {
                          "label": "for possible flow cytometry and polymerase chain reaction analysis"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "fine-needle aspiration biopsy",
                  "children": [
                    {
                      "label": "can provide adequate sample volume to establish all but the morphologic characteristics of the lesion"
                    }
                  ]
                }
              ]
            },
            {
              "label": "immunologic identification of cell-surface markers on lymphocytes",
              "children": [
                {
                  "label": "B cells"
                },
                {
                  "label": "T cells"
                },
                {
                  "label": "monoclonal"
                },
                {
                  "label": "polyclonal"
                },
                {
                  "label": "specific monoclonal antibodies directed against surface light-chain (κ or λ) immunoglobulins"
                }
              ]
            },
            {
              "label": "DNA hybridization",
              "children": [
                {
                  "label": "extracting, amplifying, and hybridizing tumor DNA with radioactively labeled nucleotide probes"
                },
                {
                  "label": "more sensitive than cell-surface marker typing",
                  "children": [
                    {
                      "label": "allow more precise identification of tumor clonality",
                      "children": [
                        {
                          "label": "90% of orbital lymphoproliferative disease is monoclonal"
                        },
                        {
                          "label": "10% is polyclonal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "more time-consuming"
                },
                {
                  "label": "expensive"
                },
                {
                  "label": "DNA genetic studies have shown that most lymphoproliferative lesions that appear to be immunologically polyclonal actually harbor small monoclonal proliferations of B lymphocytes",
                  "children": [
                    {
                      "label": "does not predict which tumors will ultimately result in systemic disease"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "all patients with hypercellular lymphoid lesions should be examined by an oncologist",
              "children": [
                {
                  "label": "general physical examination"
                },
                {
                  "label": "complete blood count"
                },
                {
                  "label": "bone marrow biopsy"
                },
                {
                  "label": "liver and spleen scan"
                },
                {
                  "label": "chest radiograph"
                },
                {
                  "label": "serum immunoprotein electrophoresis"
                },
                {
                  "label": "CT of the thorax and abdomen",
                  "children": [
                    {
                      "label": "to check for mediastinal and retroperitoneal lymph node involvement"
                    }
                  ]
                },
                {
                  "label": "patient should be reexamined periodically"
                },
                {
                  "label": "whether monoclonal or polyclonal!"
                }
              ]
            },
            {
              "label": "systemic corticosteroids",
              "children": [
                {
                  "label": "are not recommended in the treatment of lymphoproliferative lesions"
                }
              ]
            },
            {
              "label": "radiotherapy",
              "children": [
                {
                  "label": "treatment of choice",
                  "children": [
                    {
                      "label": "achieves local control in virtually all cases"
                    }
                  ]
                },
                {
                  "label": "2000–3000 cGy"
                }
              ]
            },
            {
              "label": "surgical excision",
              "children": [
                {
                  "label": "usually cannot be achieved because of the infiltrative nature of lymphoid tumors"
                }
              ]
            },
            {
              "label": "indolent lymphomas",
              "children": [
                {
                  "label": "treatment of low-grade lymphoid lesions that have already undergone systemic dissemination is somewhat controversial"
                },
                {
                  "label": "generally refractory to chemotherapy"
                },
                {
                  "label": "are associated with long-term survival, even if untreated"
                },
                {
                  "label": "many oncologists take a watchful waiting approach",
                  "children": [
                    {
                      "label": "treat only symptomatic disease"
                    }
                  ]
                }
              ]
            },
            {
              "label": "agressive lymphomas require treatment",
              "children": [
                {
                  "label": "radiotherapy"
                },
                {
                  "label": "aggressive chemotherapy"
                },
                {
                  "label": "≤1/3 can be cured"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Histiocytic Disorders",
      "children": [
        {
          "label": "Langerhans cell histiocytosis"
        },
        {
          "label": "rare disorders of mononuclear phagocytic system"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "abnormal immune regulation",
              "children": [
                {
                  "label": "accumulation of proliferating dendritic histiocytes"
                }
              ]
            }
          ]
        },
        {
          "label": "most commonly in children",
          "children": [
            {
              "label": "peak incidence between 5 - 10 years"
            }
          ]
        },
        {
          "label": "varies in severity from benign lesions with spontaneous resolution to chronic dissemination resulting in death"
        },
        {
          "label": "classification",
          "children": [
            {
              "label": "unifocal eosinophilic granuloma of bone"
            },
            {
              "label": "multifocal eosinophilic granuloma of bone"
            },
            {
              "label": "diffuse soft tissue histiocytosis"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "most frequent presentation in the orbit is a lytic defect",
              "children": [
                {
                  "label": "superotemporal orbit"
                },
                {
                  "label": "sphenoid wing"
                },
                {
                  "label": "may cause proptosis"
                }
              ]
            },
            {
              "label": "relapsing episodes of orbital inflammation",
              "children": [
                {
                  "label": "often initially misinterpreted as infectious orbital cellulitis"
                }
              ]
            },
            {
              "label": "younger children",
              "children": [
                {
                  "label": "more often present with significant overlying soft-tissue inflammation"
                }
              ]
            }
          ]
        },
        {
          "label": "prognosis",
          "children": [
            {
              "label": "survival rate",
              "children": [
                {
                  "label": "<2 years",
                  "children": [
                    {
                      "label": "only 50%",
                      "children": [
                        {
                          "label": "more likely to have evidence of multifocal or systemic involvement",
                          "children": [
                            {
                              "label": "younger patients require regular observation for detection of subsequent multiorgan involvement"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": ".>2 years",
                  "children": [
                    {
                      "label": "87%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "spontaneous remission has been reported"
            },
            {
              "label": "involved bone usually reossifies completely"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "localized orbital disease",
              "children": [
                {
                  "label": "confirmatory biopsy with debulking"
                },
                {
                  "label": "intralesional steroid injection"
                },
                {
                  "label": "low-dose radiation"
                }
              ]
            },
            {
              "label": "systemic disease",
              "children": [
                {
                  "label": "aggressive chemotherapy"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Plasma Cell Tumors",
      "children": [
        {
          "label": "much less common"
        },
        {
          "label": "composed predominantly of mature plasma cells",
          "children": [
            {
              "label": "plasmacytomas"
            },
            {
              "label": "localized plasma cell–rich pseudotumors"
            }
          ]
        },
        {
          "label": "some lesions are composed of lymphocytes and lymphoplasmacytoid cells"
        },
        {
          "label": "multiple myeloma should be ruled out",
          "children": [
            {
              "label": "particularly if there is",
              "children": [
                {
                  "label": "bone destruction"
                },
                {
                  "label": "immaturity or mitotic activity among the plasmacytic elements"
                }
              ]
            }
          ]
        },
        {
          "label": "display the same spectrum of clinical involvement as do lymphoproliferative lesions"
        }
      ]
    }
  ],
