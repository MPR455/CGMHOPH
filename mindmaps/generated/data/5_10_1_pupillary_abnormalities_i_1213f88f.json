              "label": "rostral midbrain disease",
              "children": [
                {
                  "label": "incomplete damage of the pupillary fibers"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Pupillary Examination",
      "children": [
        {
          "label": "inspection of previous photographs"
        },
        {
          "label": "pupil size",
          "children": [
            {
              "label": "shine a handheld light obliquely from below the nose"
            },
            {
              "label": "patient should fixate on a distant target",
              "children": [
                {
                  "label": "do not block the patient’s fixation!"
                }
              ]
            },
            {
              "label": "poor vision in 1 eye is never a cause of anisocoria"
            }
          ]
        },
        {
          "label": "pupillary light reflex",
          "children": [
            {
              "label": "briefly shine a bright focal light onto 1 pupil and note the speed and amplitude of its constriction"
            }
          ]
        },
        {
          "label": "pupillary near response",
          "children": [
            {
              "label": "accommodative target with fine detail"
            },
            {
              "label": "moderate room light",
              "children": [
                {
                  "label": "patient’s pupils are midsize and the near object is clearly visible"
                }
              ]
            },
            {
              "label": "requires sufficient patient effort",
              "children": [
                {
                  "label": "“practice runs” may be needed"
                },
                {
                  "label": "a better response is obtained if auditory input is added to the visual stimulus"
                },
                {
                  "label": "a lack of near response usually indicates that the patient is not trying hard enough"
                }
              ]
            }
          ]
        },
        {
          "label": "slit-lamp examination",
          "children": [
            {
              "label": "an essential part of the pupillary examination"
            },
            {
              "label": "acute corneal injury",
              "children": [
                {
                  "label": "small pupil in the presence of ciliary spasm"
                }
              ]
            },
            {
              "label": "anterior chamber inflammation",
              "children": [
                {
                  "label": "small pupil in the presence of ciliary spasm"
                }
              ]
            },
            {
              "label": "transillumination iris defects",
              "children": [
                {
                  "label": "iris damage from previous trauma, infection, or inflammation"
                }
              ]
            },
            {
              "label": "angle-closure glaucoma",
              "children": [
                {
                  "label": "dilated pupil"
                }
              ]
            },
            {
              "label": "sectoral paralysis of the iris sphincter",
              "children": [
                {
                  "label": "tonic pupil"
                },
                {
                  "label": "aberrant regeneration of the oculomotor nerve"
                },
                {
                  "label": "placing a wide beam at an angle to the iris and turning the light off and on while observing one sector of the sphincter at a time under high magnification"
