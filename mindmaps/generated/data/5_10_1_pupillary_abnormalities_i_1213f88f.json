          ]
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "photophobia"
            },
            {
              "label": "difficulty focusing when going from dark to light or light to dark"
            },
            {
              "label": "blurring of vision"
            }
          ]
        },
        {
          "label": "clinician should inquire about",
          "children": [
            {
              "label": "new medications"
            },
            {
              "label": "ocular infections"
            },
            {
              "label": "face or neck trauma"
            },
            {
              "label": "headache or facial pain"
            },
            {
              "label": "change in eyelid position"
            }
          ]
        }
