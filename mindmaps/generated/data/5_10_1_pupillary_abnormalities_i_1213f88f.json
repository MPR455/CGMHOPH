            {
              "label": "coloboma"
            },
            {
              "label": "aniridia"
            }
          ]
        },
        {
          "label": "blunt trauma",
          "children": [
            {
              "label": "focal tears in the sphincter muscle."
            },
            {
              "label": "iridodialysis"
            }
          ]
        },
        {
          "label": "intraocular inflammation",
          "children": [
            {
              "label": "synechiae"
            }
          ]
        },
        {
          "label": "iris neovascularization"
        },
        {
          "label": "surgical procedures",
          "children": [
            {
              "label": "cataract surgery",
              "children": [
                {
                  "label": "leading cause of a misshapen pupil in an adult"
                }
              ]
            }
          ]
        },
        {
          "label": "tadpole pupil",
          "children": [
            {
              "label": "focal spasm of the iris dilator muscle",
              "children": [
                {
                  "label": "peaking of the pupil"
                }
              ]
            },
            {
              "label": "lasts a few minutes"
            },
            {
              "label": "may occur numerous times over several days or a week"
            },
            {
              "label": "spontaneous resolution"
            },
            {
              "label": "small percentage harbor underlying sympathetic lesion",
              "children": [
                {
                  "label": "pharmacologic testing for Horner syndrome is recommended !"
                }
              ]
            }
          ]
        },
        {
          "label": "midbrain corectopia",
