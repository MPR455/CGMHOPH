              ]
            },
            {
              "label": "tafluprost",
              "children": [
                {
                  "label": "similar to latanoprost"
                }
              ]
            }
          ]
        },
        {
          "label": "some patients may respond better to one agent than to another",
          "children": [
            {
              "label": "switching drugs after a trial of 4–6 weeks"
            }
          ]
        },
        {
          "label": "bimatoprost, latanoprost, and travoprost reach peak effect 10–14 hours after administration",
          "children": [
            {
              "label": "bedtime application is recommended",
              "children": [
                {
                  "label": "peak IOP is in the morning",
                  "children": [
                    {
                      "label": "aqueous formation decreases during sleep"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "ocular side effect",
          "children": [
            {
              "label": "iris hyperpigmentation",
              "children": [
                {
                  "label": "increased number of melanosomes within the melanocytes"
                },
                {
                  "label": "≤33% after 5 years",
                  "children": [
                    {
                      "label": "≤79% with green-brown irides"
                    },
                    {
                      "label": "≤85% with hazel (yellow-brown) irides"
                    },
                    {
                      "label": "8% with blue irides"
                    }
                  ]
                }
              ]
            },
            {
              "label": "conjunctival hyperemia",
              "children": [
                {
                  "label": "more common with bimatoprost and travoprost"
                },
                {
                  "label": "reversible with drug discontinuation",
                  "children": [
                    {
                      "label": "reversible with drug discontinuation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "hypertrichosis",
              "children": [
                {
                  "label": "reversible with drug discontinuation"
                }
              ]
            },
            {
              "label": "trichiasis"
            },
            {
