          "children": [
            {
              "label": "latanoprost"
            },
            {
              "label": "travoprost",
              "children": [
                {
                  "label": "prodrugs that penetrate the cornea",
                  "children": [
                    {
                      "label": "hydrolyzed by corneal esterase",
                      "children": [
                        {
                          "label": "biologically active"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "bimatoprost"
            }
          ]
        },
        {
          "label": "mechanism",
          "children": [
            {
              "label": "not known",
              "children": [
                {
                  "label": "tafluprost"
                }
              ]
            },
            {
              "label": "latanoprost",
              "children": [
                {
                  "label": "increased spaces between ciliary body muscle fascicles",
                  "children": [
                    {
                      "label": "increasing uveoscleral outflow"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "IOP lowering effect",
          "children": [
            {
              "label": "latanoprost",
              "children": [
                {
                  "label": "25%–32%"
