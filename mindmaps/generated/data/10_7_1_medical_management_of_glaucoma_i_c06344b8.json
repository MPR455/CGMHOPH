{
  "label": "10.7.1. Medical Management of Glaucoma (I)",
  "root": true,
  "children": [
    {
      "label": "General",
      "children": [
        {
          "label": "criteria for treatment",
          "children": [
            {
              "label": "3 principal criteria",
              "children": [
                {
                  "label": "life expectancy of the patient"
                },
                {
                  "label": "stage of disease"
                },
                {
                  "label": "degree of IOP elevation",
                  "children": [
                    {
                      "label": "rate of disease progression"
                    }
                  ]
                }
              ]
            },
            {
              "label": "other criteria",
              "children": [
                {
                  "label": "presence or absence of optic disc hemorrhages"
                },
                {
                  "label": "family history"
                }
              ]
            }
          ]
        },
        {
          "label": "goal of treatment",
          "children": [
            {
              "label": "preserving visual function by lowering IOP",
              "children": [
                {
                  "label": "lowest risk"
                },
                {
                  "label": "fewest adverse effects"
                },
                {
                  "label": "least amount of disruption to patient’s life"
                },
                {
                  "label": "cost of treatment"
                }
              ]
            }
          ]
        },
        {
          "label": "target pressure",
          "children": [
            {
              "label": "low target pressure",
              "children": [
                {
                  "label": "more advanced optic neuropathy"
                },
                {
                  "label": "optic nerve damage in presence of normal IOP"
                }
              ]
            },
            {
              "label": "do not set a rigid target pressure",
              "children": [
                {
                  "label": "should be individualized"
                },
                {
                  "label": "target pressure level should be a broad range"
                },
                {
                  "label": "may require revision"
                }
              ]
            },
            {
              "label": "initial IOP reduction of ≥20% from baseline is a suggested minimum"
            }
          ]
        },
        {
          "label": "treatment of ACG with pupillary block and of primary congenital glaucoma is primarily surgical"
        },
        {
          "label": "initial treatment of POAG has commonly been medical"
        },
        {
          "label": "treatment of secondary glaucoma is similar to that of primary glaucoma"
        },
        {
          "label": "Glaucoma Laser Trial (GLT)",
          "children": [
            {
              "label": "as initial therapy, argon laser trabeculoplasty was at least as effective as medications"
            }
          ]
        },
        {
          "label": "Collaborative Initial Glaucoma Treatment Study (CIGTS)",
          "children": [
            {
              "label": "medical therapy was essentially equally as effective as surgical therapy in preventing POAG progression"
            }
          ]
        },
        {
          "label": "therapeutic trial",
          "children": [
            {
              "label": "starting medication in 1 eye to assess efficacy"
            }
          ]
        },
        {
          "label": "reverse therapeutic trial",
          "children": [
            {
              "label": "stopping a medication in 1 eye"
            }
          ]
        },
        {
          "label": "references"
        }
      ]
    },
    {
      "label": "permanent"
    },
    {
      "label": "Prostaglandin Analogues",
