{
  "label": "7.1.1. Orbital Anatomy (I)",
  "root": true,
  "children": [
    {
      "label": "Dimensions",
      "children": [
        {
          "label": "medial orbital walls are ≈ parallel",
          "children": [
            {
              "label": "separated by 25 mm"
            }
          ]
        },
        {
          "label": "widest dimension of orbit is ≈ 1 cm behind anterior orbital rim"
        },
        {
          "label": "redundancy of optic nerve allows the eye to rotate and move forward without damaging the nerve"
        }
      ]
    },
    {
      "label": "Apertures",
      "children": [
        {
          "label": "Ethmoidal Foramina",
          "children": [
            {
              "label": "medial orbital wall",
              "children": [
                {
                  "label": "along the frontoethmoidal suture"
                }
              ]
            },
            {
              "label": "contents",
              "children": [
                {
                  "label": "anterior and posterior ethmoidal arteries"
                }
              ]
            },
            {
              "label": "surgical landmark for the superior extent of medial wall surgery",
              "children": [
                {
                  "label": "disruption of medial wall above the level of the foramina may disrupt a plane superior to the cribriform plate",
                  "children": [
                    {
                      "label": "inadvertent entry into the cranial vault!"
                    }
                  ]
                }
              ]
            },
            {
              "label": "potential route of entry into orbit for infections and neoplasms from sinuses"
            }
          ]
        },
        {
          "label": "Superior Orbital Fissure",
          "children": [
            {
              "label": "separates the greater and lesser wings of the sphenoid bone"
            },
            {
              "label": "divided by annulus of Zinn into 2 parts",
              "children": [
                {
                  "label": "above the annulus",
                  "children": [
                    {
                      "label": "lacrimal nerve of CN V1"
                    },
                    {
                      "label": "frontal nerve of CN V1"
                    },
                    {
                      "label": "CN IV (trochlear nerve)"
                    },
                    {
                      "label": "superior ophthalmic vein",
                      "children": [
                        {
                          "label": "drains into the cavernous sinus"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "LFTs"
                },
                {
                  "label": "within the annulus",
                  "children": [
                    {
                      "label": "superior and inferior divisions of CN III (the oculomotor nerve)"
                    },
                    {
                      "label": "nasociliary branch of CN V1"
                    },
                    {
                      "label": "sympathetic roots of the ciliary ganglion"
                    },
                    {
                      "label": "CN VI (the abducens nerve)",
                      "children": [
                        {
                          "label": "Standing Room Only"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Inferior Orbital Fissure",
          "children": [
            {
              "label": "bounded by",
              "children": [
                {
                  "label": "sphenoid",
                  "children": [
                    {
                      "label": "3N3 iS 6"
                    }
                  ]
                },
                {
                  "label": "maxillary"
                },
                {
                  "label": "palatine bones"
                }
              ]
            },
            {
              "label": "transmits",
              "children": [
                {
                  "label": "second (maxillary) division of CN V",
                  "children": [
                    {
                      "label": "maxillary nerve (V2) exits the skull through the foramen rotundum",
                      "children": [
                        {
                          "label": "travels through the pterygopalatine fossa to enter the orbit at the infraorbital groove"
                        },
                        {
                          "label": "after giving off the zygomatic branch, it becomes the infraorbital nerve",
                          "children": [
                            {
                              "label": "travels anteriorly in the infraorbital canal",
                              "children": [
                                {
                                  "label": "emerges 1 cm below the inferior orbital rim",
                                  "children": [
                                    {
                                      "label": "sensation from the lower eyelid, cheek, upper lip, upper teeth, and gingiva"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "zygomatic nerve"
                    }
                  ]
                },
                {
                  "label": "branches of the inferior ophthalmic vein",
                  "children": [
                    {
                      "label": "leading to the pterygoid plexus"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Zygomaticofacial and Zygomaticotemporal Canals",
          "children": [
            {
              "label": "transmit vessels and branches of the zygomatic nerve through the lateral orbital wall",
              "children": [
                {
                  "label": "to the cheek"
                },
                {
                  "label": "to the temporal fossa"
                }
              ]
            }
          ]
        },
        {
          "label": "Nasolacrimal Canal",
          "children": [
            {
              "label": "from the lacrimal sac fossa to the inferior meatus"
            },
            {
              "label": "transmits the nasolacrimal duct"
            }
          ]
        },
        {
          "label": "Optic Canal",
          "children": [
            {
              "label": "8–10 mm long"
            },
            {
              "label": "in the lesser wing of the sphenoid bone"
            },
            {
              "label": "separated from the superior orbital fissure by the bony optic strut"
            },
            {
              "label": "transmits",
              "children": [
                {
                  "label": "optic nerve"
                },
                {
                  "label": "ophthalmic artery"
                },
                {
                  "label": "sympathetic nerves"
                }
              ]
            },
            {
              "label": "optic foramen",
              "children": [
                {
                  "label": "orbital end of the canal"
                },
                {
                  "label": "<6.5 mm in diameter"
                }
              ]
            },
            {
              "label": "optic canal enlargement",
              "children": [
                {
                  "label": "optic nerve glioma"
                }
              ]
            },
            {
              "label": "narrowing of the canal",
              "children": [
                {
                  "label": "fibrous dysplasia"
                }
              ]
            },
            {
              "label": "blunt trauma",
              "children": [
                {
                  "label": "optic canal fracture"
                },
                {
                  "label": "shearing of the nerve at the foramen"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Topographic Relationships",
      "children": [
        {
          "label": "orbital septum",
          "children": [
            {
              "label": "arises from the orbital rims anteriorly"
            }
          ]
        },
        {
          "label": "paranasal sinuses",
          "children": [
            {
              "label": "rudimentary or very small at birth",
              "children": [
                {
                  "label": "increase in size through adolescence"
                }
              ]
            }
          ]
        },
        {
          "label": "orbital walls are composed of 7 bones",
          "children": [
            {
              "label": "ethmoid"
            },
            {
              "label": "frontal"
            },
            {
              "label": "lacrimal"
            },
            {
              "label": "maxilla (maxillary)"
            },
            {
              "label": "palatine"
            },
            {
              "label": "sphenoid"
            },
            {
              "label": "zygomatic"
            }
          ]
        },
        {
          "label": "Roof of the Orbit",
          "children": [
            {
              "label": "composed of",
              "children": [
                {
                  "label": "orbital plate of the frontal bone"
                },
                {
                  "label": "lesser wing of the sphenoid bone"
                }
              ]
            },
            {
              "label": "landmarks",
              "children": [
                {
                  "label": "lacrimal gland fossa"
                },
                {
                  "label": "fossa for the trochlea of the superior oblique tendon",
                  "children": [
                    {
                      "label": "5 mm behind the superior nasal orbital rim"
                    }
                  ]
                },
                {
                  "label": "supraorbital notch",
                  "children": [
                    {
                      "label": "transmits the supraorbital vessels and the supraorbital branch of the frontal nerve"
                    }
                  ]
                }
              ]
            },
            {
              "label": "located adjacent to",
              "children": [
                {
                  "label": "anterior cranial fossa"
                },
                {
                  "label": "frontal sinus"
                }
              ]
            }
          ]
        },
        {
          "label": "Lateral Wall of the Orbit",
          "children": [
            {
              "label": "composed of",
              "children": [
                {
                  "label": "zygomatic bone"
                },
                {
                  "label": "greater wing of the sphenoid bone",
                  "children": [
                    {
                      "label": "separated from the lesser wing by the superior orbital fissure"
                    }
                  ]
                }
              ]
            },
            {
              "label": "landmarks",
              "children": [
                {
                  "label": "lateral orbital tubercle of Whitnall",
                  "children": [
                    {
                      "label": "lateral canthal tendon"
                    },
                    {
                      "label": "lateral horn of the levator aponeurosis"
                    },
                    {
                      "label": "check ligament of the lateral rectus"
                    },
                    {
                      "label": "Lockwood ligament (the suspensory ligament of the globe)"
                    },
                    {
                      "label": "Whitnall ligament"
                    }
                  ]
                },
                {
                  "label": "frontozygomatic suture",
                  "children": [
                    {
                      "label": "1 cm above the tubercle"
                    }
                  ]
                }
              ]
            },
            {
              "label": "located adjacent to",
              "children": [
                {
                  "label": "middle cranial fossa"
                },
                {
                  "label": "temporal fossa"
                }
              ]
            },
            {
              "label": "extends anteriorly to the equator of the globe"
            },
            {
              "label": "thickest and strongest of the orbital walls"
            }
          ]
        },
        {
          "label": "Floor of the Orbit",
          "children": [
            {
              "label": "composed of",
              "children": [
                {
                  "label": "maxillary bone"
                },
                {
                  "label": "palatine bone"
                },
                {
                  "label": "orbital plate of the zygomatic bone"
                }
              ]
            },
            {
              "label": "forms roof of the maxillary sinus"
            },
            {
              "label": "does not extend to the orbital apex",
              "children": [
                {
                  "label": "ends at the pterygopalatine fossa!",
                  "children": [
                    {
                      "label": "shortest of the orbital walls"
                    }
                  ]
                }
              ]
            },
            {
              "label": "landmarks",
              "children": [
                {
                  "label": "infraorbital groove"
                },
                {
                  "label": "infraorbital canal"
                },
                {
                  "label": "transmit infraorbital artery and maxillary division of trigeminal nerve"
                }
              ]
            }
          ]
        },
        {
          "label": "Medial Wall of the Orbit",
          "children": [
            {
              "label": "composed of",
              "children": [
                {
                  "label": "orbital plate of the ethmoid bone"
                },
                {
                  "label": "lacrimal bone",
                  "children": [
                    {
                      "label": "only the lacrimal bone exists wholly within the orbital confines"
                    }
                  ]
                },
                {
                  "label": "frontal process of the maxillary bone"
                },
                {
                  "label": "lesser wing of the sphenoid bone"
                }
              ]
            },
            {
              "label": "landmark",
              "children": [
                {
                  "label": "frontoethmoidal suture",
                  "children": [
                    {
                      "label": "approximate level of the cribriform plate",
                      "children": [
                        {
                          "label": "also part of orbital roof"
                        }
                      ]
                    },
                    {
                      "label": "roof of the ethmoids"
                    },
                    {
                      "label": "floor of the anterior cranial fossa"
                    },
                    {
                      "label": "entry of the anterior and posterior ethmoidal arteries into the orbit"
                    }
                  ]
                }
              ]
            },
            {
              "label": "located adjacent to",
              "children": [
                {
                  "label": "sphenoid sinus"
                },
                {
                  "label": "ethmoid sinuses"
                },
                {
                  "label": "nasal cavity"
                }
              ]
            },
            {
              "label": "medial wall of the optic canal",
              "children": [
                {
                  "label": "lateral wall of the sphenoid sinus",
                  "children": [
                    {
                      "label": "lesser wing of the sphenoid bone"
                    }
                  ]
                }
              ]
            },
            {
              "label": "thinnest walls of the orbit",
              "children": [
                {
                  "label": "lamina papyracea",
                  "children": [
                    {
                      "label": "between the orbit and the ethmoid sinuses"
                    },
                    {
                      "label": "infections of the ethmoid sinuses may extend through the lamina papyracea to cause orbital cellulitis"
                    }
                  ]
                },
                {
                  "label": "maxillary bone",
                  "children": [
                    {
                      "label": "particularly posteromedial portion"
                    }
                  ]
                },
                {
                  "label": "bones most frequently fractured as a result of indirect (blowout) fractures"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
