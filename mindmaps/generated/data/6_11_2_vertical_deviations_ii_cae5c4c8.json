    {
      "label": "Superior Oblique Muscle Palsy",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "most common paralysis of a single cyclovertical muscle is fourth nerve palsy"
            },
            {
              "label": "congenital",
              "children": [
                {
                  "label": "etiology",
                  "children": [
                    {
                      "label": "absent ipsilateral trochlear nerve + varying degrees of SO muscle hypoplasia",
                      "children": [
                        {
                          "label": "most patients"
                        }
                      ]
                    },
                    {
                      "label": "congenitally lax, attenuated, or absent superior oblique tendon"
                    },
                    {
                      "label": "unusual course of the muscle"
                    },
                    {
                      "label": "malpositioned orbital pulleys"
                    },
                    {
                      "label": "craniofacial abnormalities"
                    }
                  ]
                },
                {
                  "label": "differentiating features",
                  "children": [
                    {
                      "label": "examine childhood photographs",
                      "children": [
                        {
                          "label": "compensatory head tilt"
                        },
                        {
                          "label": "facial asymmetry"
                        }
                      ]
                    },
                    {
                      "label": "large vertical fusional amplitudes"
                    }
                  ]
                }
              ]
            },
            {
              "label": "acquired",
              "children": [
                {
                  "label": "closed head trauma",
                  "children": [
                    {
                      "label": "most common"
                    }
                  ]
                },
                {
                  "label": "direct trauma to tendon or trochlear area"
                },
                {
                  "label": "diabetes mellitus"
                },
                {
                  "label": "vascular problems of the central nervous system"
                },
                {
                  "label": "brain tumor",
                  "children": [
                    {
                      "label": "recently diagnosed palsy that cannot be attributed to known trauma suggests the possibility of a serious intracranial lesion and need for neurologic investigation"
                    }
                  ]
                },
                {
                  "label": "isolated nontraumatic fourth nerve palsy",
                  "children": [
                    {
                      "label": "usually ischemic or idiopathic"
                    },
                    {
                      "label": "lack of signs of recovery by 3 months after onset should prompt neuroimaging"
                    }
                  ]
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "clinical features",
          "children": [
            {
              "label": "can fixate with normal or affected eye"
            },
            {
              "label": "examination",
              "children": [
                {
                  "label": "hyperdeviation",
                  "children": [
                    {
                      "label": "unilateral palsy"
                    },
                    {
                      "label": "typically incomitant",
                      "children": [
                        {
                          "label": "especially in the acute stages"
                        },
                        {
                          "label": "“spread of comitance\"",
                          "children": [
                            {
                              "label": "contracture of the ipsilateral superior rectus or contralateral inferior rectus muscle"
                            },
                            {
                              "label": "minimal difference in magnitude of hypertropia when patient looks from one side to other"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "versions",
                  "children": [
                    {
                      "label": "underaction of superior oblique muscle",
                      "children": [
                        {
                          "label": "action of superior oblique muscle can appear normal"
                        }
                      ]
                    },
                    {
                      "label": "overaction of inferior oblique muscle"
                    }
                  ]
                },
                {
                  "label": "torsion",
                  "children": [
                    {
                      "label": "if depression cannot be evaluated because of eye’s inability to adduct",
                      "children": [
                        {
                          "label": "eg, 3rd nerve palsy"
                        }
                      ]
                    },
                    {
                      "label": "ask patient to look downward and inward from primary position",
                      "children": [
                        {
                          "label": "superior oblique muscle palsy leads to extorsion",
                          "children": [
                            {
                              "label": "observe surface or fundus landmarks"
                            },
                            {
                              "label": "subjective incyclodiplopia"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "double Maddox rod test",
                      "children": [
                        {
                          "label": "to measure torsional imbalance"
                        },
                        {
                          "label": "intorsion of the higher eye—instead of the expected extorsion—signifies skew deviation",
                          "children": [
                            {
                              "label": "especially when there are associated neurologic findings"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "3-step test",
                  "children": [
                    {
                      "label": "for diagnosis of unilateral superior oblique muscle palsy"
                    },
                    {
                      "label": "can be confounded by",
                      "children": [
                        {
                          "label": "DVD"
                        },
                        {
                          "label": "entities involving restriction"
                        },
                        {
                          "label": "skew deviation",
                          "children": [
                            {
                              "label": "vertical tropia typically decreases significantly in supine position",
                              "children": [
                                {
                                  "label": "typically does not change in superior oblique palsy"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "document serial changes in the deviation",
                  "children": [
                    {
                      "label": "Hess screen"
                    },
                    {
                      "label": "Lancaster red-green test"
                    },
                    {
                      "label": "plotting the field of single binocular vision"
                    }
                  ]
                }
              ]
            },
            {
              "label": "differentiate bilateral from unilateral superior oblique muscle palsy",
              "children": [
                {
                  "label": "unilateral",
                  "children": [
                    {
                      "label": "little if any V pattern"
                    },
                    {
                      "label": "<10° extorsion in downgaze"
                    },
                    {
                      "label": "subjective incyclodiplopia is uncommon",
                      "children": [
                        {
                          "label": "unless palsy is severe"
                        }
                      ]
                    },
                    {
                      "label": "3-step test yields positive results for the involved side only"
                    },
                    {
                      "label": "abnormal head positions are common",
                      "children": [
                        {
                          "label": "head tilt toward the opposite shoulder"
                        }
                      ]
                    },
                    {
                      "label": "oblique muscle dysfunction is confined to the involved eye"
                    }
                  ]
                },
                {
                  "label": "IO overaction --> V-pattern",
                  "children": [
                    {
                      "label": "SO overaction --> A-pattern"
                    }
                  ]
                },
                {
                  "label": "bilateral",
                  "children": [
                    {
                      "label": "usually show a V pattern",
                      "children": [
                        {
                          "label": "± chin-down head posture"
                        }
                      ]
                    },
                    {
                      "label": ".>10° extorsion in downgaze",
                      "children": [
                        {
                          "label": ".>20° of extorsion is highly suggestive of bilateral involvement"
                        }
                      ]
                    },
                    {
                      "label": "subjective incyclodiplopia is common"
                    },
                    {
                      "label": "Bielschowsky head-tilt test yields positive results on tilt to each side",
                      "children": [
                        {
                          "label": "right head tilt reveals a right hypertropia and left head tilt a left hypertropia"
                        }
                      ]
                    },
                    {
                      "label": "bilateral oblique muscle dysfunction"
                    },
                    {
                      "label": "masked bilateral palsies",
                      "children": [
                        {
                          "label": "markedly asymmetric bilateral palsies that initially appear to be unilateral",
                          "children": [
                            {
                              "label": "even the mildest degree of oblique muscle dysfunction on the presumedly uninvolved side"
                            }
                          ]
                        },
                        {
                          "label": "more common in patients with closed head trauma"
                        },
                        {
                          "label": "bilateral objective fundus extorsion"
                        },
                        {
                          "label": "esotropia in downgaze",
                          "children": [
                            {
                              "label": "V-pattern ET"
                            }
                          ]
                        },
                        {
                          "label": "must be distinguished from situations in which the initial palsy is overcorrected, leading to a postoperative oblique muscle abnormality in the fellow eye"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "unilateral superior oblique muscle palsy",
              "children": [
                {
                  "label": "prisms",
                  "children": [
                    {
                      "label": "small, symptomatic deviations that lack a prominent torsional component",
                      "children": [
                        {
                          "label": "especially those that have become comitant"
                        },
                        {
                          "label": "compensate for hyperdeviation in primary position"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "indications for surgery",
                  "children": [
                    {
                      "label": "significant vertical deviation"
                    },
                    {
                      "label": "diplopia"
                    },
                    {
                      "label": "asthenopia"
                    }
                  ]
                },
                {
                  "label": "deviation is incomitant",
                  "children": [
                    {
                      "label": "hyperdeviation is worse in contralateral upgaze",
                      "children": [
                        {
                          "label": "weaken the antagonist inferior oblique muscle"
                        }
                      ]
                    },
                    {
                      "label": "hyperdeviation is worse in contralateral downgaze",
                      "children": [
                        {
                          "label": "strengthen the weak superior oblique muscle"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "lax superior oblique muscle",
                  "children": [
                    {
                      "label": "strengthen the weak superior oblique muscle",
                      "children": [
                        {
                          "label": "tendon tucking"
                        }
                      ]
                    },
                    {
                      "label": "can be confirmed at surgery",
                      "children": [
                        {
                          "label": "globe is pushed (translated) posteriorly into the orbit while it is simultaneously extorted"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "cyclodiplopia or significant extorsion",
                  "children": [
                    {
                      "label": "superior oblique tendon strengthening procedure",
                      "children": [
                        {
                          "label": "tendon tucking"
                        },
                        {
                          "label": "Harada-Ito procedure"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "deviation ≤15Δ in primary position",
                  "children": [
                    {
                      "label": "one of these options alone may be effective"
                    },
                    {
                      "label": "amount of deviation in primary position corrected by inferior oblique weakening is proportional to degree of preoperative overaction of muscle",
                      "children": [
                        {
                          "label": "not performed in skew deviation because inferior oblique muscle weakening would aggravate the intorsion of the higher eye"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "hyperdeviation is incomitant and >15Δ in primary position",
                  "children": [
                    {
                      "label": "usually is also large in ipsilateral (secondary) gaze field"
                    },
                    {
                      "label": "recession of ipsilateral superior rectus muscle or contralateral (yoke) inferior rectus muscle should be added to oblique muscle surgery",
                      "children": [
                        {
                          "label": "choice depends on whether hyperdeviation is worse in downgaze or upgaze, as well as tightness of these muscles on forced-duction testing"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "hyperdeviation has become comitant",
                  "children": [
                    {
                      "label": "vertical rectus muscle surgery is generally preferred",
                      "children": [
                        {
                          "label": "<15Δ–20Δ",
                          "children": [
                            {
                              "label": "recession of 1 vertical rectus muscle"
                            }
                          ]
                        },
                        {
                          "label": ".>15Δ–20Δ",
                          "children": [
                            {
                              "label": "recession of both vertical rectus muscles"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "hyperdeviation >35Δ in primary position",
                  "children": [
                    {
                      "label": "3-muscle surgery",
                      "children": [
                        {
                          "label": "recession of overacting antagonist inferior oblique muscle"
                        },
                        {
                          "label": "recession of either ipsilateral superior rectus or contralateral inferior rectus muscle or both",
                          "children": [
                            {
                              "label": "based on forced-duction test results"
                            }
                          ]
                        },
                        {
                          "label": "ipsilateral superior oblique tendon tucking may have to be included if the tendon is lax"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Hering’s law may cause the superior oblique muscle to overact in the normal eye",
                  "children": [
                    {
                      "label": "avoid superior oblique tenotomy on normal eye",
                      "children": [
                        {
                          "label": "converts a unilateral superior oblique palsy to a bilateral one",
                          "children": [
                            {
                              "label": "disabling torsional diplopia"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "avoid overcorrection of a long-standing unilateral superior oblique muscle palsy in adult patients",
                  "children": [
                    {
                      "label": "overcorrection can worsen with time and can cause disabling diplopia"
                    }
                  ]
                }
              ]
            },
            {
              "label": "bilateral superior oblique muscle palsy",
              "children": [
                {
                  "label": "surgery on both eyes is required and any asymmetry of the paralysis must be taken into account"
                },
                {
                  "label": "palsies are symmetric & both inferior oblique muscles are significantly overacting",
                  "children": [
                    {
                      "label": "weakening of both inferior oblique muscles"
                    },
                    {
                      "label": "if superior oblique muscles are lax or weak and cyclodiplopia or sizable extorsion is present",
                      "children": [
                        {
                          "label": "these muscles should be strengthened",
                          "children": [
                            {
                              "label": "tendon tucking"
                            },
                            {
                              "label": "Harada-Ito procedure"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "paralysis is asymmetric",
                  "children": [
                    {
                      "label": "a hyperdeviation is usually present in primary position and hyperdeviations on right and left gaze differ"
                    },
                    {
                      "label": "techniques",
                      "children": [
                        {
                          "label": "symmetric oblique muscle surgery + unilateral vertical rectus recession"
                        },
                        {
                          "label": "asymmetric oblique muscle surgery"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "any of these approaches should collapse a large V pattern",
                  "children": [
                    {
                      "label": "additional surgery may be necessary"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
