  "root": true,
  "children": [
    {
      "label": "Case Description",
      "children": [
        {
          "label": "6-month-old infant with chronic tearing and discharge of both eyes that started one month after birth"
        },
        {
          "label": "Image Description"
        }
      ]
    },
    {
      "label": "Additional Testing",
      "children": [
        {
          "label": "dye disappearance test",
          "children": [
            {
              "label": "check in (5)10 minutes"
            }
          ]
        },
        {
          "label": "Jones I test",
          "children": [
            {
              "label": "instill fluorescein into conjunctival fornices"
            },
            {
              "label": "recover it in inferior nasal meatus by passing a cotton- tipped applicator into nose",
              "children": [
                {
                  "label": "at 2 and 5 minutes"
                }
              ]
            }
          ]
        },
        {
          "label": "Jones II test",
          "children": [
            {
              "label": "following an unsuccessful Jones I test",
              "children": [
                {
                  "label": "flush residual fluorescein from conjunctival sac with clear saline"
                },
                {
                  "label": "irrigate lacrimal system with clear saline using a cannula inserted into the canalicular system",
                  "children": [
                    {
                      "label": "clear solution suggests that tears never entered lacrimal outflow system"
                    },
                    {
                      "label": "fluorescein-stained irrigant indicates partial obstruction"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
