    {
      "label": "Contact Lens–Related Infectious Keratitis",
      "children": [
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "risk of corneal infection is increased nearly 10x in contact lens wearers"
            },
            {
              "label": "developed countries",
              "children": [
                {
                  "label": "contact lens wear represents the most common risk factor for corneal infection"
                },
                {
                  "label": "one-third of emergency department visits for corneal infection"
                }
              ]
            }
          ]
        },
        {
          "label": "Pathogenesis",
          "children": [
            {
              "label": "introduction of a contaminated foreign body to the corneal surface"
            },
            {
              "label": "interruption of the normal tear flow"
            },
            {
              "label": "corneal epithelial microtrauma"
            },
            {
              "label": "alteration of ocular surface immunity"
            },
            {
              "label": "corneal hypoxia"
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "patching of any corneal epithelial defect or corneal infiltrate in a contact lens wearer is absolutely contraindicated",
              "children": [
                {
                  "label": "provide antibiotic coverage for the most common bacterial pathogen in contact lens– related keratitis, P aeruginosa"
                }
              ]
            },
            {
              "label": "pathogens",
              "children": [
                {
                  "label": "Acanthamoeba",
                  "children": [
                    {
                      "label": "P aeruginosa"
                    },
                    {
                      "label": "less common"
                    },
                    {
                      "label": "seen predominantly in contact lens wearers"
                    }
                  ]
                },
                {
                  "label": "Fungi"
                },
                {
                  "label": "acanthamoeba and fungal pathogens should be suspected if the clinical presentation or clinical course is atypical"
                }
              ]
            }
          ]
        }
