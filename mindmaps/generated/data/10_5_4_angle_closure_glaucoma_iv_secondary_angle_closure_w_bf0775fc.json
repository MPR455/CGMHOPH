{
  "label": "10.5.4. Angle-Closure Glaucoma (IV): Secondary Angle Closure Without Pupillary Block (I)",
  "root": true,
  "children": [
    {
      "label": "2 mechanisms",
      "children": [
        {
          "label": "contraction of an inflammatory, hemorrhagic, or vascular membrane, band, or exudate in the angle, leading to PAS"
        },
        {
          "label": "forward displacement of the lens–iris interface, often accompanied by swelling and anterior rotation of the ciliary body"
        }
      ]
    },
    {
      "label": "F>M"
    },
    {
      "label": "unilateral"
    },
    {
      "label": "Neovascular Glaucoma",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "See Table 5-3"
            },
            {
              "label": "most common causes",
              "children": [
                {
                  "label": "diabetic retinopathy"
                },
                {
                  "label": "central retinal vein occlusion"
                },
                {
                  "label": "ocular ischemic syndrome"
                }
              ]
            },
            {
              "label": "may occur without demonstrable retinal ischemia",
              "children": [
                {
                  "label": "Fuchs heterochromic iridocyclitis"
                },
                {
                  "label": "other types of uveitis"
                },
                {
                  "label": "exfoliation syndrome"
                }
              ]
            },
            {
              "label": "when an ocular cause cannot be found",
              "children": [
                {
                  "label": "carotid artery occlusive disease",
                  "children": [
                    {
                      "label": "isolated iris melanomas"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "fine arborizing blood vessels on the surface of the iris, pupil margin, and trabecular meshwork",
              "children": [
                {
                  "label": "distinguish dilated iris vessels associated with inflammation from newly formed abnormal blood vessels"
                }
              ]
            },
            {
              "label": "presents in a classic pattern",
              "children": [
                {
                  "label": "starts with fine vascular tufts at the pupillary margin"
                },
                {
                  "label": "extend radially over the iris"
                },
                {
                  "label": "fine single vessels branch as they reach and involve the trabecular meshwork",
                  "children": [
                    {
                      "label": "angle neovascularization can occur without iris neovascularization",
                      "children": [
                        {
                          "label": "10% of CRVO patients develop angle neovascularization alone"
                        }
                      ]
                    },
                    {
                      "label": "trabecular meshwork takes on a reddish coloration"
                    }
                  ]
                },
                {
                  "label": "accompanying fibrous membrane typically does not grow over healthy corneal endothelium",
                  "children": [
                    {
                      "label": "PAS end at the Schwalbe line"
                    }
                  ]
                }
              ]
            },
            {
              "label": "high IOP",
              "children": [
                {
                  "label": "acute or subacute glaucoma"
                }
              ]
            },
            {
              "label": "reduced vision"
            },
            {
              "label": "pain"
            },
            {
              "label": "conjunctival hyperemia"
            },
            {
              "label": "microcystic corneal edema"
            },
            {
              "label": "gonioscopy",
              "children": [
                {
                  "label": "use a bright slit-lamp beam of light and high magnification"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "panretinal photocoagulation",
              "children": [
                {
                  "label": "treatment of choice when the ocular media are clear"
                },
                {
                  "label": "decrease in neovascularization after panretinal photocoagulation may reduce or normalize the IOP",
                  "children": [
                    {
                      "label": "depending on the degree of synechial closure"
                    }
                  ]
                },
                {
                  "label": "even in the presence of total synechial angle closure PRP may",
                  "children": [
                    {
                      "label": "improve the success rate of subsequent glaucoma surgery"
                    },
                    {
                      "label": "may decrease the risk of hemorrhage at the time of surgery"
                    }
                  ]
                }
              ]
            },
            {
              "label": "panretinal cryotherapy",
              "children": [
                {
                  "label": "when cloudy media prevent laser"
                }
              ]
            },
            {
              "label": "vitrectomy",
              "children": [
                {
                  "label": "with endophotocoagulation or subsequent panretinal photocoagulation"
                }
              ]
            },
            {
              "label": "medical management",
              "children": [
                {
                  "label": "temporizing measure until more definitive surgical or laser treatment is undertaken"
                },
                {
                  "label": "Topical β-adrenergic antagonists"
                },
                {
                  "label": "α2-adrenergic agonists"
                },
                {
                  "label": "carbonic anhydrase inhibitors"
                },
                {
                  "label": "cycloplegics"
                },
                {
                  "label": "corticosteroids"
                }
              ]
            },
            {
              "label": "filtering surgery",
              "children": [
                {
                  "label": "better chance of success once the neovascularization has regressed after panretinal photocoagulation"
                },
                {
                  "label": "anti-VEGF agents promote regression of neovascular tissue prior to filtering surgery"
                },
                {
                  "label": "use of antifibrotics",
                  "children": [
                    {
                      "label": "5-fluorouracil"
                    },
                    {
                      "label": "mitomycin C"
                    },
                    {
                      "label": "increase the success rate of and decrease the final IOP"
                    }
                  ]
                }
              ]
            },
            {
              "label": "glaucoma drainage devices",
              "children": [
                {
                  "label": "surgical procedure of choice"
                }
              ]
            },
            {
              "label": "cyclocryotherapy",
              "children": [
                {
                  "label": "endoscopic or transscleral cyclophotocoagulation"
                }
              ]
            },
            {
              "label": "prognosis for neovascular glaucoma is poor"
            }
          ]
        }
      ]
    },
    {
      "label": "Iridocorneal Endothelial (ICE) Syndrome",
      "children": [
        {
          "label": "group of disorders characterized by abnormal corneal endothelium",
          "children": [
            {
              "label": "causes variable degrees of",
              "children": [
                {
                  "label": "iris atrophy"
                },
                {
                  "label": "secondary ACG"
                },
                {
                  "label": "corneal edema"
                }
              ]
            }
          ]
        },
        {
          "label": "epidemiology",
          "children": [
            {
              "label": "viral cause has been postulated"
            },
            {
              "label": "20-50 years of age"
            },
            {
              "label": "familial cases are very rare"
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "decreased vision (due to corneal edema)"
            },
            {
              "label": "abnormal corneal endothelium",
              "children": [
                {
                  "label": "“beaten bronze” appearance",
                  "children": [
                    {
                      "label": "similar to corneal guttae seen in Fuchs corneal endothelial dystrophy"
                    }
                  ]
                },
                {
                  "label": "unaffected eye may have subclinical endothelial irregularities"
                }
              ]
            },
            {
              "label": "microcystic corneal edema",
              "children": [
                {
                  "label": "may be present without elevated IOP"
                }
              ]
            },
            {
              "label": "abnormal iris appearance"
            },
            {
              "label": "secondary chronic ACG",
              "children": [
                {
                  "label": "≈ 50% of patients with ICE syndrome"
                },
                {
                  "label": "more severe in essential iris atrophy and Cogan-Reese syndrome"
                },
                {
                  "label": "corneal endothelium migrates posterior to the Schwalbe line onto the trabecular meshwork"
                },
                {
                  "label": "high PAS are characteristic of ICE syndrome",
                  "children": [
                    {
                      "label": "extend anterior to the Schwalbe line"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "clinical variants",
          "children": [
            {
              "label": "Chandler syndrome",
              "children": [
                {
                  "label": "the most common form",
                  "children": [
                    {
                      "label": "degree of angle closure does not always correlate to the elevation in IOP",
                      "children": [
                        {
                          "label": "some angles may be functionally closed by the endothelial membrane without overt synechial formation"
                        }
                      ]
                    },
                    {
                      "label": "50%"
                    }
                  ]
                },
                {
                  "label": "minimal iris atrophy and corectopia",
                  "children": [
                    {
                      "label": "corneal and angle findings predominate"
                    }
                  ]
                }
              ]
            },
            {
              "label": "essential (progressive) iris atrophy",
              "children": [
                {
                  "label": "severe progressive iris stromal & pigment epithelial atrophy"
                },
                {
                  "label": "heterochromia"
                },
                {
                  "label": "corectopia"
                },
                {
                  "label": "ectropion uveae"
                },
                {
                  "label": "hole formation"
                }
              ]
            },
            {
              "label": "Cogan-Reese (iris nevus) syndrome",
              "children": [
                {
                  "label": "less severe iris atrophy"
                },
                {
                  "label": "tan pedunculated nodules or diffuse pigmented lesions on the anterior iris surface"
                }
              ]
            }
          ]
        },
        {
          "label": "diagnostic tests",
          "children": [
            {
              "label": "diagnosis of ICE syndrome must always be considered in young to middle-aged patients who present with unilateral, secondary ACG"
            },
            {
              "label": "electron microscopy",
              "children": [
                {
                  "label": "endothelial layer varies in thickness"
                },
                {
                  "label": "surrounding collagenous and fibrillar tissue",
                  "children": [
                    {
                      "label": "areas of single and multiple endothelial layers"
                    }
                  ]
                },
                {
                  "label": "filopodial processes and cytoplasmic actin filaments are present",
                  "children": [
                    {
                      "label": "cell migration"
                    },
                    {
                      "label": "PAS form when this migratory endothelium and its surrounding collagenous, fibrillar tissue contract"
                    }
                  ]
                }
              ]
            },
            {
              "label": "specular microscopy",
              "children": [
                {
                  "label": "asymmetric loss of endothelial cells"
                },
                {
                  "label": "atypical endothelial cell morphology"
                }
              ]
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "hypertonic saline solutions"
            },
            {
              "label": "medications to reduce the IOP",
              "children": [
                {
                  "label": "aqueous suppressants"
                },
                {
                  "label": "prostaglandin analogues"
                },
                {
                  "label": "miotics are often ineffective"
                }
              ]
            },
            {
              "label": "filtering surgery",
              "children": [
                {
                  "label": "trabeculectomy",
                  "children": [
                    {
                      "label": "endothelialization of the fistula can cause late failures",
                      "children": [
                        {
                          "label": "fistula can be reopened in some cases with the Nd:YAG laser"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "glaucoma drainage device"
                }
              ]
            },
            {
              "label": "laser trabeculoplasty",
              "children": [
                {
                  "label": "has no useful role"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
