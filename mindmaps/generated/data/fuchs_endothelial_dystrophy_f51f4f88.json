    {
      "label": "Treatment",
      "children": [
        {
          "label": "Medical",
          "children": [
            {
              "label": "warm air from a hair dryer at arm’s length every morning"
            },
            {
              "label": "sodium-chloride 5%"
            },
            {
              "label": "glaucoma drops",
              "children": [
                {
                  "label": "if high IOP",
                  "children": [
                    {
                      "label": "100-200 micron thickness"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Surgical",
          "children": [
            {
              "label": "endothelial transplant",
              "children": [
                {
                  "label": "DSAEK",
                  "children": [
                    {
                      "label": "Descemet Membrane Endothelial Keratoplasty (DMEK) is very similar to DSAEK, except that the donor tissue implanted does not include any stromal tissue",
                      "children": [
                        {
                          "label": "10-15 micron thickness"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "DMEK"
                }
              ]
            },
            {
              "label": "descemetorhexis",
              "children": [
                {
                  "label": "removal of a relatively small area of abnormal Descemet"
                },
                {
                  "label": "results in mitosis of normal endothelial cells from the periphery causing resolution of corneal edema"
                },
                {
                  "label": "± topical and/or intracameral Rho kinase (ROCK) inhibitor"
                }
              ]
            },
            {
              "label": "PK",
              "children": [
                {
                  "label": "if anterior corneal scarring"
                }
              ]
            },
            {
              "label": "evaluate corneal health before cataract surgery",
              "children": [
                {
                  "label": "if stromal edema",
                  "children": [
                    {
                      "label": "triple procedure",
                      "children": [
                        {
                          "label": "high pachymetry readings or low endothelial cell count are not indications for triple procedure"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "worsening corneal edema after cataract surgery"
                }
              ]
            }
          ]
