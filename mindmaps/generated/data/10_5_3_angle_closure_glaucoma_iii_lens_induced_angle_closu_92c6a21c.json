{
  "label": "10.5.3. Angle-Closure Glaucoma (III): Lens-Induced Angle Closure",
  "root": true,
  "children": [
    {
      "label": "Phacomorphic glaucoma",
      "children": [
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "mass effect of the cataractous lens"
            },
            {
              "label": "pupillary block"
            }
          ]
        },
        {
          "label": "onset",
          "children": [
            {
              "label": "narrowing of the angle generally occurs slowly"
            },
            {
              "label": "in some cases, the onset may be acute and rapid",
              "children": [
                {
                  "label": "precipitated by marked lens swelling (intumescence)"
                }
              ]
            }
          ]
        },
        {
          "label": "distinguishing between primary angle closure and phacomorphic angle closure is not always straightforward",
          "children": [
            {
              "label": "disparities between the 2 eyes in ACD, gonioscopy, and degree of cataract should suggest a phacomorphic process"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "laser iridotomy followed by cataract extraction in a quiet eye",
              "children": [
                {
                  "label": "in many cases, the iridotomy is unnecessary"
                }
              ]
            },
            {
              "label": "cholinergic agents",
              "children": [
                {
                  "label": "may further narrow the angle"
                },
                {
                  "label": "miotic pupil will make subsequent cataract surgery more difficult"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Ectopia lentis",
      "children": [
        {
          "label": "displacement of the lens from its normal anatomical position"
        },
        {
          "label": "forward displacement",
          "children": [
            {
              "label": "pupillary block",
              "children": [
                {
                  "label": "shallowing of the anterior chamber angle"
                }
              ]
            }
          ]
        },
        {
          "label": "acute",
          "children": [
            {
              "label": "pain, conjunctival hyperemia, and vision loss"
            }
          ]
        },
        {
          "label": "chronic",
          "children": [
            {
              "label": "PAS formation secondary to repeated attacks"
            }
          ]
        },
        {
          "label": "See Table 5-2"
        },
        {
          "label": "Microspherophakia",
          "children": [
            {
              "label": "lens has a spherical or globular shape",
              "children": [
                {
                  "label": "faulty development of secondary lens fibers"
                }
              ]
            },
            {
              "label": "may cause ectopia lentis and subsequent pupillary block",
              "children": [
                {
                  "label": "secondary angle-closure glaucoma",
                  "children": [
                    {
                      "label": "miotics aggravate this condition"
                    },
                    {
                      "label": "laser iridotomy",
                      "children": [
                        {
                          "label": "cycloplegics are the medical treatment of choice"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "high myopia"
            },
            {
              "label": "often familial"
            },
            {
              "label": "associated conditions",
              "children": [
                {
                  "label": "isolated"
                },
                {
                  "label": "Weill-Marchesani syndrome",
                  "children": [
                    {
                      "label": "most common associated syndrome"
                    },
                    {
                      "label": "autosomal recessive"
                    },
                    {
                      "label": "small stature"
                    },
                    {
                      "label": "short and stubby fingers"
                    },
                    {
                      "label": "broad hands with reduced joint mobility"
                    }
                  ]
                },
                {
                  "label": "Lowe syndrome",
                  "children": [
                    {
                      "label": "oculocerebrorenal syndrome of Lowe",
                      "children": [
                        {
                          "label": "x-linked"
                        },
                        {
                          "label": "systemic acidosis"
                        },
                        {
                          "label": "renal rickets"
                        },
                        {
                          "label": "hypotonia"
                        },
                        {
                          "label": "congenital cataract",
                          "children": [
                            {
                              "label": "focal, internally directed excrescences of lens capsule"
                            }
                          ]
                        },
                        {
                          "label": "microspherophakia"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "Marfan syndrome"
                },
                {
                  "label": "Peters anomaly"
                },
                {
                  "label": "Alport syndrome"
                },
                {
                  "label": "congenital rubella"
                }
              ]
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "2 laser iridotomies 180° apart"
                },
                {
                  "label": "definitive lensectomy, if indicated from a visual function standpoint"
                },
                {
                  "label": "cycloplegia",
                  "children": [
                    {
                      "label": "tightens the zonules, flattens the lens, and pulls it posteriorly"
                    },
                    {
                      "label": "miotics may make the condition worse"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "exfoliation syndrome",
          "children": [
            {
              "label": "crystalline lens subluxation",
              "children": [
                {
                  "label": "most common form of acquired zonular insufficiency"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Aphakic or pseudophakic angle-closure glaucoma",
      "children": [
        {
          "label": "intact vitreous face blocks the pupil and/or an iridectomy",
          "children": [
            {
              "label": "aphakic or pseudophakic eyes"
            },
            {
              "label": "phakic eye with a dislocated lens"
            }
          ]
        },
        {
          "label": "iris shows considerable bombé configuration"
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "mydriatic and cycloplegic agents",
              "children": [
                {
                  "label": "restore the aqueous flow through the pupil"
                },
                {
                  "label": "make laser iridotomy difficult initially"
                }
              ]
            },
            {
              "label": "topical β-adrenergic antagonists"
            },
            {
              "label": "α2-adrenergic agonists"
            },
            {
              "label": "carbonic anhydrase inhibitors"
            },
            {
              "label": "hyperosmotic agents"
            },
            {
              "label": "≥1 laser iridotomies"
            }
          ]
        },
        {
          "label": "anterior chamber intraocular lenses",
          "children": [
            {
              "label": "lens haptic or vitreous obstruct the iridectomy or the pupil"
            },
            {
              "label": "peripheral iris bows forward around the anterior chamber IOL"
            },
            {
              "label": "treatment",
              "children": [
                {
                  "label": "central chamber remains deep"
                },
                {
                  "label": "laser iridotomies, often multiple"
                }
              ]
            }
          ]
        },
        {
          "label": "following posterior capsulotomy",
          "children": [
            {
              "label": "vitreous obstructs the pupil"
            }
          ]
        },
        {
          "label": "capsular block",
          "children": [
            {
              "label": "retained viscoelastic or fluid in the capsular bag pushes a posterior chamber IOL anteriorly"
            }
          ]
        }
      ]
    }
  ],
