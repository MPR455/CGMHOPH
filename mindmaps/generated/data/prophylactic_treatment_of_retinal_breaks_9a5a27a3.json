{
  "label": "Prophylactic Treatment of Retinal Breaks",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "vast majority of retinal breaks do not cause RD"
        },
        {
          "label": "Goal of prophylactic treatment",
          "children": [
            {
              "label": "creation of a chorioretinal adhesion around each break to prevent fluid from entering the subretinal space"
            },
            {
              "label": "treatment does not eliminate risk of new tears or RD"
            }
          ]
        },
        {
          "label": "If subretinal fluid is present, treatment should surround the area of subretinal fluid"
        },
        {
          "label": "if insufficient treatment is applied, vitreous traction can lead to anterior extension of horseshoe tears and RD"
        },
        {
          "label": "when treating lattice degeneration, the entire lesion needs to be surrounded"
        },
        {
          "label": "Factors to consider",
          "children": [
            {
              "label": "symptoms"
            },
            {
              "label": "family history"
            },
            {
              "label": "residual traction"
            },
            {
              "label": "size and location of the break"
            },
            {
              "label": "phakic status"
            },
            {
              "label": "refractive error"
            },
            {
              "label": "status of the fellow eye"
            },
            {
              "label": "presence of subretinal fluid"
            },
            {
              "label": "availability of the patient for follow-up evaluation"
            }
          ]
        },
        {
          "label": "Prophylaxis is sometimes contraindicated in",
          "children": [
            {
              "label": ".> 6.00 diopters (D) of myopia"
            },
            {
              "label": ".> 6 clock-hours of lattice degeneration"
            }
          ]
        }
      ]
    },
    {
      "label": "Lattice Degeneration",
      "children": [
        {
          "label": "11-year follow-up study of patients with untreated lattice degeneration",
          "children": [
            {
              "label": "RD occurred in ≈ 1%"
            }
          ]
        },
        {
          "label": "presence of lattice, with or without atrophic holes, generally does not require prophylaxis in the absence of other risk factors or symptoms"
        },
        {
          "label": "consider treatment if",
          "children": [
            {
              "label": "retinal detachment in the fellow eye"
            },
            {
              "label": "flap tears"
            },
            {
              "label": "pseudophakia"
            },
            {
              "label": "aphakia"
            }
          ]
        }
      ]
    },
    {
      "label": "Aphakia and Pseudophakia",
      "children": [
        {
          "label": "higher risks of RD (1%–3%)",
          "children": [
            {
              "label": "should be warned of potential symptoms and carefully examined if symptoms occur"
            }
          ]
        },
        {
          "label": "population-based 25-year follow-up study",
          "children": [
            {
              "label": "probability ratio of RD following cataract surgery",
              "children": [
                {
                  "label": "11x in the first year"
                },
                {
                  "label": "4x in years 5-20"
                }
              ]
            },
            {
              "label": "cumulative risk of RD after cataract surgery",
              "children": [
                {
                  "label": "1.79% at 20 years"
                }
              ]
            }
          ]
        },
        {
          "label": "risk factors for RD following cataract surgery",
          "children": [
            {
              "label": "male sex"
            },
            {
              "label": "younger age"
            },
            {
              "label": "myopia"
            },
            {
              "label": "increased axial length"
            },
            {
              "label": "posterior capsular tear"
            },
            {
              "label": "absence of PVD"
            }
          ]
        }
      ]
    },
    {
      "label": "Fellow Eye in Patients With Retinal Detachment",
      "children": [
        {
          "label": "fellow-eye risk of RD",
          "children": [
            {
              "label": "≈10% for phakic RD"
            },
            {
              "label": "20%–36% for aphakic or pseudophakic RD"
            }
          ]
        },
        {
          "label": "prophylactic treatment of flap tears and lattice degeneration is often recommended"
        }
      ]
    },
    {
      "label": "Symptomatic Retinal Breaks",
      "children": [
        {
          "label": "7–18% of eyes with symptomatic PVD have ≥ 1 tractional tear"
        },
        {
          "label": "acute symptomatic breaks are at greater risk of progressing to RD",
          "children": [
            {
              "label": "especially if there is associated vitreous hemorrhage"
            }
          ]
        },
        {
          "label": "acute symptomatic flap tears",
          "children": [
            {
              "label": "commonly treated prophylactically"
            }
          ]
        },
        {
          "label": "acute operculated holes",
          "children": [
            {
              "label": "less likely to cause detachment"
            },
            {
              "label": "usually not treated"
            },
            {
              "label": "indications for treatment",
              "children": [
                {
                  "label": "there is vitreous hemorrhage"
                },
                {
                  "label": "hole is large"
                },
                {
                  "label": "hole is located superiorly"
                },
                {
                  "label": "slit-lamp biomicroscopy reveals persistent vitreous traction at margin of operculated hole"
                }
              ]
            }
          ]
        },
        {
          "label": "Atrophic holes",
          "children": [
            {
              "label": "generally treatment is not recommended"
            }
          ]
        }
      ]
    },
    {
      "label": "Subclinical Retinal Detachment",
      "children": [
        {
          "label": "definition",
          "children": [
            {
              "label": "asymptomatic retinal detachment"
            },
            {
              "label": "subretinal fluid extends > 1 disc diameter from the break but not more than 2 disc diameters posterior to the equator"
            }
          ]
        },
        {
          "label": "≈ 30% of subclinical RDs progress",
          "children": [
            {
              "label": "treatment is often recommended",
              "children": [
                {
                  "label": "especially if",
                  "children": [
                    {
                      "label": "symptomatic"
                    },
                    {
                      "label": "traction on the break"
                    }
                  ]
                }
              ]
            },
            {
              "label": "demarcation line suggests lower risk",
              "children": [
                {
                  "label": "progression may occur through the demarcation line"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Asymptomatic Retinal Breaks",
      "children": [
        {
          "label": "asymptomatic flap tears",
          "children": [
            {
              "label": "≈ 5% progress to RD"
            },
            {
              "label": "treatment is not universally recommended in emmetropic, phakic eyes"
            },
            {
              "label": "consider treatment if",
              "children": [
                {
                  "label": "lattice degeneration"
                },
                {
                  "label": "myopia"
                },
                {
                  "label": "subclinical detachment"
                },
                {
                  "label": "aphakia"
                },
                {
                  "label": "pseudophakia"
                },
                {
                  "label": "history of retinal detachment in the fellow eye"
                }
              ]
            }
          ]
        },
        {
          "label": "asymptomatic operculated holes and atrophic holes",
          "children": [
            {
              "label": "treatment is not generally recommended"
            }
          ]
        }
      ]
    }
  ],
