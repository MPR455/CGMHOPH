{
  "label": "7.1.2. Orbital Anatomy (II)",
  "root": true,
  "children": [
    {
      "label": "Intraorbital Optic Nerve",
      "children": [
        {
          "label": "4 mm in diameter"
        },
        {
          "label": "30 mm long",
          "children": [
            {
              "label": "longer than the orbit, allowing eye movement without traction on the nerve"
            }
          ]
        },
        {
          "label": "surrounded by pia mater, arachnoid, and dura mater",
          "children": [
            {
              "label": "continuous with the same layers covering the brain"
            },
            {
              "label": "at the orbital apex, dura mater",
              "children": [
                {
                  "label": "fuses with annulus of Zinn"
                },
                {
                  "label": "is continuous with periosteum of optic canal"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Periorbita",
      "children": [
        {
          "label": "periosteal covering of the orbital bones"
        },
        {
          "label": "at orbital apex, it fuses with dura mater of optic nerve"
        },
        {
          "label": "anteriorly, is continuous with orbital septum and the periosteum of the facial bones",
          "children": [
            {
              "label": "line of fusion of these layers at the orbital rim",
              "children": [
                {
                  "label": "arcus marginalis"
                }
              ]
            }
          ]
        },
        {
          "label": "adheres loosely to the bone except at",
          "children": [
            {
              "label": "orbital margin"
            },
            {
              "label": "sutures"
            },
            {
              "label": "fissures"
            },
            {
              "label": "foramina"
            },
            {
              "label": "tubercles"
            },
            {
              "label": "canals"
            },
            {
              "label": "subperiosteal fluid (pus or blood) is usually loculated within these boundaries"
            }
          ]
        },
        {
          "label": "richly innervated by sensory nerves"
        }
      ]
    },
    {
      "label": "Vasculature of the Orbit",
      "children": [
        {
          "label": "arterial supply",
          "children": [
            {
              "label": "ophthalmic artery",
              "children": [
                {
                  "label": "origin",
                  "children": [
                    {
                      "label": "internal carotid artery",
                      "children": [
                        {
                          "label": "travels underneath the intracranial optic nerve through the dura mater"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "branches",
                  "children": [
                    {
                      "label": "branches to the extraocular muscles"
                    },
                    {
                      "label": "central retinal artery",
                      "children": [
                        {
                          "label": "to the optic nerve and retina"
                        }
                      ]
                    },
                    {
                      "label": "posterior ciliary arteries",
                      "children": [
                        {
                          "label": "long to the anterior segment"
                        },
                        {
                          "label": "short to the choroid"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "terminal branches of the ophthalmic artery form rich anastomoses with branches of the external carotid in the face and periorbital region"
                }
              ]
            },
            {
              "label": "smaller contributions from the external carotid artery",
              "children": [
                {
                  "label": "internal maxillary artery"
                },
                {
                  "label": "facial artery"
                }
              ]
            }
          ]
        },
        {
          "label": "venous drainage",
          "children": [
            {
              "label": "superior ophthalmic vein",
              "children": [
                {
                  "label": "main venous drainage of the orbit"
                },
                {
                  "label": "originates in superonasal quadrant of the orbit and extends posteriorly through the superior orbital fissure into the cavernous sinus"
                },
                {
                  "label": "anastomoses anteriorly with veins of face and posteriorly with pterygoid plexus"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Extraocular Muscles and Orbital Fat",
      "children": [
        {
          "label": "all EOMs, except the inferior oblique, originate at the orbital apex",
          "children": [
            {
              "label": "4 rectus muscles originate in the annulus of Zinn"
            },
            {
              "label": "levator palpebrae superioris arises above the annulus on the lesser wing of sphenoid bone"
            },
            {
              "label": "superior oblique muscle originates slightly medial to levator origin",
              "children": [
                {
                  "label": "trochlea on the superomedial orbital rim",
                  "children": [
                    {
                      "label": "turns posterolaterally"
                    }
                  ]
                }
              ]
            },
            {
              "label": "inferior oblique muscle originates in the anterior orbital floor lateral to the lacrimal sac",
              "children": [
                {
                  "label": "travels posterolaterally within the lower eyelid retractors"
                }
              ]
            }
          ]
        },
        {
          "label": "intermuscular septum",
          "children": [
            {
              "label": "the membrane connecting the rectus muscles In the anterior portion of the orbit"
            },
            {
              "label": "divides the orbital fat into",
              "children": [
                {
                  "label": "intraconal fat"
                },
                {
                  "label": "extraconal fat"
                }
              ]
            }
          ]
        },
        {
          "label": "orbit is further divided by many fine fibrous septa",
          "children": [
            {
              "label": "unite and support the globe, optic nerve, and extraocular muscles",
              "children": [
                {
                  "label": "accidental/surgical trauma can disrupt this supporting system"
                },
                {
                  "label": "entrapment of orbital connective tissue after fracture can cause restriction of eye movement"
                }
              ]
            }
          ]
        },
        {
          "label": "motor innervation",
          "children": [
            {
              "label": "superior division of CN III",
              "children": [
                {
                  "label": "superior rectus"
                },
                {
                  "label": "levator muscles"
                }
              ]
            },
            {
              "label": "inferior division of CN III",
              "children": [
                {
                  "label": "inferior rectus"
                },
                {
                  "label": "medial rectus"
                },
                {
                  "label": "inferior oblique"
                }
              ]
            },
            {
              "label": "CN IV",
              "children": [
                {
                  "label": "superior oblique"
                }
              ]
            },
            {
              "label": "CN VI",
              "children": [
                {
                  "label": "lateral rectus"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Annulus of Zinn",
      "children": [
        {
          "label": "fibrous ring formed by the common origin of the 4 rectus muscles"
        },
        {
          "label": "encircles the optic foramen and the central portion of the superior orbital fissure"
        },
        {
          "label": "separates the superior orbital fissure into 2 compartments",
          "children": [
            {
              "label": "within the annulus (oculomotor foramen)",
              "children": [
                {
                  "label": "CN III (upper and lower divisions)"
                },
                {
                  "label": "CN VI"
                },
                {
                  "label": "nasociliary branch of the ophthalmic division of CN V (trigeminal)"
                }
              ]
            },
            {
              "label": "outside the annulus",
              "children": [
                {
                  "label": "CN IV",
                  "children": [
                    {
                      "label": "only nerve that innervates an extraocular muscle and does not pass directly into the muscle cone"
                    }
                  ]
                },
                {
                  "label": "frontal and lacrimal branches of the ophthalmic division of CN V"
                },
                {
                  "label": "superior ophthalmic vein"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
