{
  "label": "7.11.3. Blepharoptosis (I)",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "drooping or inferior displacement of the upper eyelid"
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "peripheral vision loss",
              "children": [
                {
                  "label": "superior visual field is most often involved"
                }
              ]
            },
            {
              "label": "central vision loss/reduced visual acuity",
              "children": [
                {
                  "label": "decreased light reaching the macula"
                }
              ]
            },
            {
              "label": "difficulty with reading",
              "children": [
                {
                  "label": "ptosis worsens in downgaze"
                }
              ]
            }
          ]
        },
        {
          "label": "classification",
          "children": [
            {
              "label": "by onset",
              "children": [
                {
                  "label": "congenital",
                  "children": [
                    {
                      "label": "most common type of congenital ptosis is myogenic"
                    }
                  ]
                },
                {
                  "label": "acquired",
                  "children": [
                    {
                      "label": "most common type of acquired ptosis is aponeurotic"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "by cause",
          "children": [
            {
              "label": "myogenic"
            },
            {
              "label": "neurogenic"
            },
            {
              "label": "aponeurotic"
            },
            {
              "label": "mechanical"
            },
            {
              "label": "traumatic"
            }
          ]
        }
      ]
    },
    {
      "label": "history",
      "children": [
        {
          "label": "onset"
        },
        {
          "label": "suggest ocular myasthenia gravis (MG)",
          "children": [
            {
              "label": "marked variability in the degree of ptosis during the day"
            },
            {
              "label": "diplopia"
            }
          ]
        },
        {
          "label": "suggest sysetemic myasthenia gravis",
          "children": [
            {
              "label": "dysphonia"
            },
            {
              "label": "dyspnea"
            },
            {
              "label": "dysphagia"
            },
            {
              "label": "proximal muscle weakness"
            }
          ]
        }
      ]
    },
    {
      "label": "Additional considerations",
      "children": [
        {
          "label": "head position"
        },
        {
          "label": "chin elevation"
        },
        {
          "label": "brow position",
          "children": [
            {
              "label": "brow action in attempted upgaze"
            }
          ]
        },
        {
          "label": "tear film"
        },
        {
          "label": "presence or absence of Bell phenomenon"
        },
        {
          "label": "corneal sensation"
        },
        {
          "label": "synkinesis",
          "children": [
            {
              "label": "variation in the amount of ptosis with extraocular muscle or jaw muscle movements"
            },
            {
              "label": "attempt to elicit synkinesis as part of evaluation of patients with congenital blepharoptosis or those with possible aberrant regeneration"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "Marcus Gunn jaw-winking ptosis"
                },
                {
                  "label": "aberrant regeneration of the oculomotor nerve or the facial nerve"
                },
                {
                  "label": "some types of Duane retraction syndrome"
                }
              ]
            }
          ]
        },
        {
          "label": "position of the ptotic eyelid in downgaze",
          "children": [
            {
              "label": "congenitally ptotic eyelid is typically higher in downgaze than the contralateral normal eyelid",
              "children": [
                {
                  "label": "congenitally ptotic eyelid may manifest lagophthalmos"
                }
              ]
            },
            {
              "label": "in acquired involutional ptosis the affected eyelid remains ptotic in all positions of gaze",
              "children": [
                {
                  "label": "may even worsen in downgaze with relaxation of the frontalis muscle!"
                }
              ]
            }
          ]
        },
        {
          "label": "visual function and refractive error",
          "children": [
            {
              "label": "exclude amblyopia in all cases of congenital or childhood ptosis",
              "children": [
                {
                  "label": "pathogenesis",
                  "children": [
                    {
                      "label": "anisometropia"
                    },
                    {
                      "label": "high astigmatism"
                    },
                    {
                      "label": "strabismus"
                    },
                    {
                      "label": "occlusion of the pupil"
                    }
                  ]
                },
                {
                  "label": "20% of patients with congenital ptosis"
                }
              ]
            }
          ]
        },
        {
          "label": "extraocular muscle function",
          "children": [
            {
              "label": "congenital conditions",
              "children": [
                {
                  "label": "combined superior rectus/levator muscle maldevelopment"
                },
                {
                  "label": "congenital oculomotor palsy"
                }
              ]
            },
            {
              "label": "acquired conditions",
              "children": [
                {
                  "label": "ocular or systemic MG"
                },
                {
                  "label": "chronic progressive external ophthalmoplegia"
                },
                {
                  "label": "oculopharyngeal dystrophy"
                },
                {
                  "label": "oculomotor palsy with or without aberrant regeneration"
                }
              ]
            }
          ]
        },
        {
          "label": "pupillary examination",
          "children": [
            {
              "label": "Horner syndrome",
              "children": [
                {
                  "label": "miosis that is most apparent in dim illumination"
                },
                {
                  "label": "first or second order neuron dysfunction may be associated with",
                  "children": [
                    {
                      "label": "malignant neoplasms",
                      "children": [
                        {
                          "label": "apical lung (Pancoast) tumor"
                        }
                      ]
                    },
                    {
                      "label": "aneurysm"
                    },
                    {
                      "label": "dissection of the carotid artery"
                    }
                  ]
                },
                {
                  "label": "third-order neuron dysfunction is typically benign"
                }
              ]
            },
            {
              "label": "cranial nerve III palsy",
              "children": [
                {
                  "label": "± mydriasis"
                }
              ]
            }
          ]
        },
        {
          "label": "external examination",
          "children": [
            {
              "label": "severe bilateral congenital ptosis may be associated with",
              "children": [
                {
                  "label": "telecanthus"
                },
                {
                  "label": "epicanthus inversus"
                },
                {
                  "label": "hypoplasia of the superior orbital rims"
                },
                {
                  "label": "horizontal shortening of the eyelids"
                },
                {
                  "label": "ear deformities"
                },
                {
                  "label": "hypertelorism"
                },
                {
                  "label": "hypoplasia of the nasal bridge"
                },
                {
                  "label": "blepharophimosis–ptosis–epicanthus inversus syndrome (BPES)"
                }
              ]
            },
            {
              "label": "fluctuating ptosis that seems to worsen with fatigue or prolonged upgaze",
              "children": [
                {
                  "label": "myasthenia gravis",
                  "children": [
                    {
                      "label": "especially when accompanied by diplopia or other clinical signs of systemic MG"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "pharmacologic testing",
          "children": [
            {
              "label": "Horner syndrome"
            }
          ]
        },
        {
          "label": "visual field testing",
          "children": [
            {
              "label": "with the eyelids untaped (in the natural, ptotic state)"
            },
            {
              "label": "with the eyelids taped (artificially elevated)"
            },
            {
              "label": "estimate of the superior visual field improvement following surgery"
            }
          ]
        }
      ]
    },
    {
      "label": "Physical Examination",
      "children": [
        {
          "label": "5 clinical measurements",
          "children": [
            {
              "label": "margin–reflex distance (MRD)"
            },
            {
              "label": "vertical palpebral fissure height"
            },
            {
              "label": "upper eyelid crease position"
            },
            {
              "label": "levator function (upper eyelid excursion)"
            },
            {
              "label": "presence of lagophthalmos"
            }
          ]
        },
        {
          "label": "margin–reflex distance (MRD)",
          "children": [
            {
              "label": "MRD 1",
              "children": [
                {
                  "label": "distance from upper eyelid margin to corneal light reflex",
                  "children": [
                    {
                      "label": "in primary position",
                      "children": [
                        {
                          "label": "single most important measurement"
                        },
                        {
                          "label": "may have a zero or negative value!"
                        }
                      ]
                    },
                    {
                      "label": "in reading position",
                      "children": [
                        {
                          "label": "if the patient reports visual obstruction while reading"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "MRD2",
              "children": [
                {
                  "label": "distance from corneal light reflex to lower eyelid margin",
                  "children": [
                    {
                      "label": "lower eyelid retraction (or scleral show)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "vertical palpebral fissure",
          "children": [
            {
              "label": "widest point between the lower and upper eyelid",
              "children": [
                {
                  "label": "= MRD1 + MRD2"
                }
              ]
            },
            {
              "label": "patient fixating on a distant object in primary gaze"
            }
          ]
        },
        {
          "label": "upper eyelid crease position",
          "children": [
            {
              "label": "distance from the upper eyelid crease to the eyelid margin",
              "children": [
                {
                  "label": "8–9 mm in males"
                },
                {
                  "label": "9–11 mm in females"
                },
                {
                  "label": "lower or obscured in Asian eyelid"
                }
              ]
            },
            {
              "label": "high, duplicated, or asymmetric creases may indicate an abnormal position of the levator aponeurosis"
            },
            {
              "label": "usually elevated in patients with involutional ptosis"
            },
            {
              "label": "shallow or absent in patients with congenital ptosis"
            }
          ]
        },
        {
          "label": "levator function",
          "children": [
            {
              "label": "upper eyelid excursion",
              "children": [
                {
                  "label": "from downgaze to upgaze with frontalis muscle function negated and with head positioned in frontal or Frankfort plane",
                  "children": [
                    {
                      "label": "frontal plane: plane determined when line intersecting highest point on the upper margin of each external auditory canal and the lowest point on the lower margin of the left orbit is parallel to the ground"
                    },
                    {
                      "label": "failure to negate the influence of the frontalis muscle results in overestimation of levator function"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "lagophthalmos",
          "children": [
            {
              "label": "a space remains between the upper and lower eyelid margins in extreme downgaze",
              "children": [
                {
                  "label": "in millimeters"
                }
              ]
            },
            {
              "label": "lagophthalmos & poor tear film quantity/quality predispose the patient to complications of ptosis repair"
            }
          ]
        }
      ]
    }
  ],
