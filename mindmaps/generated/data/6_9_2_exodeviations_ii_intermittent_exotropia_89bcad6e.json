{
  "label": "6.9.2. Exodeviations (II): Intermittent Exotropia",
  "root": true,
  "children": [
    {
      "label": "Clinical Characteristics",
      "children": [
        {
          "label": "most common type of exodeviation"
        },
        {
          "label": "onset",
          "children": [
            {
              "label": "< 5 years"
            },
            {
              "label": "may develop during the first year of life",
              "children": [
                {
                  "label": "must be differentiated from",
                  "children": [
                    {
                      "label": "intermittent strabismus that is common in the first 1–2 months of life",
                      "children": [
                        {
                          "label": "spontaneously resolves"
                        }
                      ]
                    },
                    {
                      "label": "constant infantile exotropia"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "precipitating factors",
          "children": [
            {
              "label": "visual inattention",
              "children": [
                {
                  "label": "drowsiness on awakening"
                },
                {
                  "label": "daydreaming"
                }
              ]
            },
            {
              "label": "fatigue",
              "children": [
                {
                  "label": "late in the day"
                }
              ]
            },
            {
              "label": "stress",
              "children": [
                {
                  "label": "during illness"
                }
              ]
            }
          ]
        },
        {
          "label": "exposure to bright light often causes a reflex closure of 1 eye",
          "children": [
            {
              "label": "\"squint\""
            }
          ]
        },
        {
          "label": "larger for distance",
          "children": [
            {
              "label": "may be difficult to elicit at near",
              "children": [
                {
                  "label": "most parental interactions with young children occur at near"
                }
              ]
            }
          ]
        },
        {
          "label": "can be associated with small hypertropias, A and V patterns, and overelevation and underelevation in adduction"
        },
        {
          "label": "untreated intermittent exotropia may progress toward constant exotropia",
          "children": [
            {
              "label": "tropic episodes occur at lower levels of fatigue and last for longer periods"
            }
          ]
        },
        {
          "label": "children <10 years usually do not experience diplopia when they are tropic"
        },
        {
          "label": "normal retinal correspondence and good binocular function remain when the eyes are straight"
        },
        {
          "label": "amblyopia is uncommon unless",
          "children": [
            {
              "label": "intermittent exotropia progresses to constant or nearly constant exotropia at an early age"
            },
            {
              "label": "another amblyogenic factor, such as anisometropia, is present"
            }
          ]
        }
      ]
    },
    {
      "label": "Treatment",
      "children": [
        {
          "label": "Nonsurgical management",
          "children": [
            {
              "label": "Correction of refractive errors",
              "children": [
                {
                  "label": "myopia",
                  "children": [
                    {
                      "label": "correction of even mild myopia may improve control of exodeviation"
                    }
                  ]
                },
                {
                  "label": "astigmatism"
                },
                {
                  "label": "hyperopia",
                  "children": [
                    {
                      "label": "mild to moderate degrees of hyperopia are not routinely corrected"
                    },
                    {
                      "label": "marked hyperopia (>+4.00 D or >+1.50 D hyperopic anisometropia)",
                      "children": [
                        {
                          "label": "cannot sustain accommodation, resulting in blurred retinal image and manifest exotropia"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "additional minus lenses",
                  "children": [
                    {
                      "label": "2.00–4.00 D beyond the actual refractive error",
                      "children": [
                        {
                          "label": "to stimulate accommodative convergence"
                        }
                      ]
                    },
                    {
                      "label": "may cause asthenopia in school-aged children"
                    },
                    {
                      "label": "effective as a temporizing measure to promote fusion and delay surgery",
                      "children": [
                        {
                          "label": "if initial overcorrection results in control, prescription can be gradually tapered and surgery may be avoided"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "Occlusion therapy",
              "children": [
                {
                  "label": "amblyopia",
                  "children": [
                    {
                      "label": "patching may improve control of exotropic deviations"
                    }
                  ]
                },
                {
                  "label": "no amblyopia",
                  "children": [
                    {
                      "label": "part-time patching of dominant (nondeviating) eye"
                    },
                    {
                      "label": "alternating daily patching in absence of a strong ocular preference"
                    },
                    {
                      "label": "can be an effective treatment for small-to moderate-sized deviations",
                      "children": [
                        {
                          "label": "particularly in young children"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "improvement is often temporary",
                  "children": [
                    {
                      "label": "many patients eventually require surgery"
                    }
                  ]
                }
              ]
            },
            {
              "label": "Active orthoptic treatments",
              "children": [
                {
                  "label": "deviations of ≤20 Δ"
                },
                {
                  "label": "techniques",
                  "children": [
                    {
                      "label": "antisuppression therapy/diplopia awareness",
                      "children": [
                        {
                          "label": "loss of ability to suppress diplopia may be quite bothersome!"
                        }
                      ]
                    },
                    {
                      "label": "fusional convergence training"
                    }
                  ]
                },
                {
                  "label": "± with patching, minus lenses, and surgery"
                },
                {
                  "label": "reported by some authors to have a long-term success rate comparable to surgery"
                }
              ]
            },
            {
              "label": "Prisms",
              "children": [
                {
                  "label": "base-in prisms",
                  "children": [
                    {
                      "label": "promote fusion"
                    }
                  ]
                },
                {
                  "label": "can cause a reduction in fusional vergence amplitudes",
                  "children": [
                    {
                      "label": "seldom used for long-term management"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Surgical treatment",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "documented progression toward constant exotropia",
                  "children": [
                    {
                      "label": "more frequent manifest deviation",
                      "children": [
                        {
                          "label": ".>50% of the time"
                        }
                      ]
                    },
                    {
                      "label": "decreased control"
                    },
                    {
                      "label": "decreased distance stereoacuity"
                    },
                    {
                      "label": "no consensus exists regarding specific indications"
                    }
                  ]
                }
              ]
            },
            {
              "label": "best sensory outcomes are probably achieved with",
              "children": [
                {
                  "label": "motor alignment <age 7"
                },
                {
                  "label": "strabismus duration <5 years"
                },
                {
                  "label": "while deviation is still intermittent"
                }
              ]
            },
            {
              "label": "types",
              "children": [
                {
                  "label": "pseudodivergence excess exotropia",
                  "children": [
                    {
                      "label": "symmetric recession of both lateral rectus muscles"
                    }
                  ]
                },
                {
                  "label": "basic intermittent exotropia",
                  "children": [
                    {
                      "label": "may do better with",
                      "children": [
                        {
                          "label": "combined lateral rectus muscle recession and medial rectus muscle resection"
                        },
                        {
                          "label": "larger lateral rectus muscle recessions than those used for patients with pseudodivergence excess"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "true divergence excess exotropia",
                  "children": [
                    {
                      "label": "increased risk of developing near esodeviations after lateral rectus muscle recessions",
                      "children": [
                        {
                          "label": "may require bifocal glasses if near esodeviation is associated with a high AC/A ratio"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "smaller exodeviations",
              "children": [
                {
                  "label": "unilateral lateral rectus muscle recessions"
                }
              ]
            },
            {
              "label": "some believe that usual quantity of surgery may result in overcorrection if exotropia in each side gaze is less than that in primary position by ≥10Δ",
              "children": [
                {
                  "label": "might reduce amount of lateral rectus muscle recession on each side by 1 mm"
                }
              ]
            },
            {
              "label": "botulinum toxin",
              "children": [
                {
                  "label": "multiple injections are commonly needed"
                }
              ]
            },
            {
              "label": "references"
            }
          ]
        },
        {
          "label": "Postoperative alignment",
          "children": [
            {
              "label": "esotropia",
              "children": [
                {
                  "label": "small-angle esotropia in immediate postoperative period is desirable",
                  "children": [
                    {
                      "label": "less likely to develop recurrent exotropia"
                    },
                    {
                      "label": "may experience diplopia during the time they are esotropic"
                    },
                    {
                      "label": "conversion to monofixation, with subnormal stereopsis, may occur",
                      "children": [
                        {
                          "label": "some ophthalmologists prefer to delay surgery in young children in whom good preoperative visual acuity and stereopsis might be exchanged for a small-angle esotropia and decreased stereopsis postoperatively",
                          "children": [
                            {
                              "label": "delaying surgery too long could allow permanent suppression to develop and decrease long-term stability following surgical correction"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "indications for treatment",
                  "children": [
                    {
                      "label": "esotropia persists beyond 3–4 weeks"
                    },
                    {
                      "label": "esotropia develops after 1–2 months"
                    }
                  ]
                },
                {
                  "label": "treatment methods",
                  "children": [
                    {
                      "label": "base-out prisms"
                    },
                    {
                      "label": "patching"
                    },
                    {
                      "label": "corrective lenses",
                      "children": [
                        {
                          "label": "if significant hyperopia is present"
                        }
                      ]
                    },
                    {
                      "label": "bifocals",
                      "children": [
                        {
                          "label": "for a high AC/A ratio"
                        }
                      ]
                    },
                    {
                      "label": "surgery",
                      "children": [
                        {
                          "label": "delay of a few months is recommended before reoperation",
                          "children": [
                            {
                              "label": "unless deficient ductions suggest a slipped or lost muscle"
                            },
                            {
                              "label": "spontaneous improvement is common"
                            }
                          ]
                        },
                        {
                          "label": "unilateral or bilateral recession of the medial rectus muscle"
                        },
                        {
                          "label": "advancement of the recessed lateral rectus muscles"
                        }
                      ]
                    },
                    {
                      "label": "injection of botulinum toxin"
                    }
                  ]
                }
              ]
            },
            {
