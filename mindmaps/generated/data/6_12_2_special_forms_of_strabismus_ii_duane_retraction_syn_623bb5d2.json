{
  "label": "6.12.2. Special Forms of Strabismus (II): Duane Retraction Syndrome",
  "root": true,
  "children": [
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "absent or hypoplastic sixth cranial nerve nucleus",
          "children": [
            {
              "label": "defect in development between fourth and sixth weeks of gestation"
            },
            {
              "label": "aberrant branch of third cranial nerve innervates lateral rectus muscle",
              "children": [
                {
                  "label": "anomalous co-contraction of medial and lateral rectus muscles on actual or attempted adduction",
                  "children": [
                    {
                      "label": "globe retraction"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "tight and broadly inserted medial rectus muscles"
        },
        {
          "label": "fibrotic lateral rectus muscles"
        },
        {
          "label": "corresponding forced-duction abnormalities"
        }
      ]
    },
    {
      "label": "genetics",
      "children": [
        {
          "label": "sporadic",
          "children": [
            {
              "label": "most cases"
            }
          ]
        },
        {
          "label": "autosomal dominant",
          "children": [
            {
              "label": "5%–10%"
            },
            {
              "label": "discordance in monozygotic twins",
              "children": [
                {
                  "label": "role of intrauterine environment"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "management",
      "children": [
        {
          "label": "indications for surgery",
          "children": [
            {
              "label": "primary position deviation"
            },
            {
              "label": "head turn"
            },
            {
              "label": "marked globe retraction"
            },
            {
              "label": "large upshoots or downshoots"
            },
            {
              "label": "no surgical approach will normalize rotations"
            }
          ]
        },
        {
          "label": "goals of surgery",
          "children": [
            {
              "label": "to centralize and expand the field of single binocular vision",
              "children": [
                {
                  "label": "in many patients eyes are properly aligned in at least 1 position of gaze, allowing development of binocular vision"
                }
              ]
            }
          ]
        },
        {
          "label": "type 1",
          "children": [
            {
              "label": "recession of medial rectus muscle",
              "children": [
                {
                  "label": "esotropia >20Δ in primary position",
                  "children": [
                    {
                      "label": "bilateral medial rectus muscle recession"
                    }
                  ]
                },
                {
                  "label": "overcorrection due to excessive medial rectus recession",
                  "children": [
                    {
                      "label": "treat with recession of the lateral rectus muscle of the uninvolved eye"
                    }
                  ]
                },
                {
                  "label": "does not usually improve abduction significantly"
                }
              ]
            },
            {
              "label": "most surgeons do not favor resection of the lateral rectus muscle",
              "children": [
                {
                  "label": "globe retraction will worsen!"
                }
              ]
            },
            {
              "label": "to improve abduction",
              "children": [
                {
                  "label": "partial or full lateral transposition of both of the vertical rectus muscles or the superior rectus alone",
                  "children": [
                    {
                      "label": "± posterior scleral fixation (myopexy)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "type 2",
          "children": [
            {
              "label": "recession of lateral rectus muscle on the involved side",
              "children": [
                {
                  "label": "some surgeons recess both lateral rectus muscles if a large-angle exotropia is present"
                }
              ]
            },
            {
              "label": "resection of the medial rectus muscle is avoided"
            }
          ]
        },
        {
          "label": "type 3",
          "children": [
            {
              "label": "severe globe retraction may be lessened by recession of both the medial and the lateral rectus muscles",
              "children": [
                {
                  "label": "lateral recession must be very large to improve the retraction"
                },
                {
                  "label": "may benefit the induced anomalous vertical movements"
                },
                {
                  "label": "also an option for treating retraction in type 1 and type 2"
                }
              ]
            }
          ]
        },
        {
          "label": "procedures for upshoot or downshoot",
          "children": [
            {
              "label": "large lateral rectus recession"
            },
            {
              "label": "splitting of the lateral rectus muscle in a Y configuration"
            },
            {
              "label": "retroequatorial fixation of the lateral rectus muscle"
            },
            {
              "label": "disinsertion of the lateral rectus muscle and reattachment to the lateral periosteum of the orbit"
            }
          ]
        }
      ]
    },
    {
      "label": "clinical features",
      "children": [
        {
          "label": "F>M"
        },
        {
          "label": "bilateral",
          "children": [
            {
              "label": "left eye>right eye"
            },
            {
              "label": "15%"
            }
          ]
        },
        {
          "label": "globe retraction on adduction",
          "children": [
            {
              "label": "obviates the need for neurologic investigation for sixth nerve palsy"
            },
            {
              "label": "can be difficult to appreciate in an infant"
            },
            {
              "label": "vertical slit-lamp beam cast from cornea onto lower eyelid is disrupted by globe retraction when the eye adducts"
            }
          ]
        },
        {
          "label": "horizontal eye movement (abduction and adduction) can be limited to various degrees"
        },
        {
          "label": "upshoot or downshoot of globe on adduction",
          "children": [
            {
              "label": "caused by vertical slippage of a tight lateral rectus muscle by 1–2 mm"
            }
          ]
        },
        {
          "label": "classification",
          "children": [
            {
              "label": "type 1",
              "children": [
                {
                  "label": "most common form",
                  "children": [
                    {
                      "label": "50%–80%"
                    }
                  ]
                },
                {
                  "label": "poor abduction"
                },
                {
                  "label": "primary position esotropia"
                }
              ]
            },
            {
              "label": "type 2",
              "children": [
                {
                  "label": "poor adduction"
                },
                {
                  "label": "exotropia"
                }
              ]
            },
            {
              "label": "type 3",
              "children": [
                {
                  "label": "poor abduction and adduction"
                },
                {
                  "label": "esotropia, exotropia, or no primary position deviation",
                  "children": [
                    {
                      "label": "often have straight eyes in or near the primary position and little, if any, head turn"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "associated systemic defects",
          "children": [
            {
              "label": "Goldenhar syndrome"
            },
            {
              "label": "Wildervanck syndrome"
            }
          ]
        },
        {
          "label": "differentiation from 6th nerve palsy",
          "children": [
            {
              "label": "globe retraction on adduction"
            },
            {
              "label": "lack of correspondence between absent or typically modest primary position esotropia (usually <30Δ) and the usually profound abduction deficit"
            },
            {
              "label": "even in esotropic Duane retraction syndrome, a small-angle exotropia is frequently present on gaze to opposite eye"
            }
          ]
        }
      ]
