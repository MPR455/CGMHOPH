{
  "label": "9.6.7. Intermediate Uveitis (II): Pars Planitis",
  "root": true,
  "children": [
    {
      "label": "intermediate uveitis in the absence of an associated infection or systemic disease",
      "children": [
        {
          "label": "the most common form of intermediate uveitis",
          "children": [
            {
              "label": "85–90%"
            }
          ]
        }
      ]
    },
    {
      "label": "epidemiology",
      "children": [
        {
          "label": "bimodal age distribution",
          "children": [
            {
              "label": "younger (5–15 years)"
            },
            {
              "label": "older (20–40 years)"
            }
          ]
        },
        {
          "label": "no overall sex predilection"
        }
      ]
    },
    {
      "label": "pathogenesis",
      "children": [
        {
          "label": "autoimmune reactions against the vitreous, peripheral retina, and ciliary body"
        }
      ]
    },
    {
      "label": "clinical presentation",
      "children": [
        {
          "label": "bilateral",
          "children": [
            {
              "label": "80%"
            },
            {
              "label": "+- asymmetric"
            }
          ]
        },
        {
          "label": "children",
          "children": [
            {
              "label": "redness, photophobia, and discomfort",
              "children": [
                {
                  "label": "significant anterior chamber inflammation"
                }
              ]
            }
          ]
        },
        {
          "label": "teenagers and young adults",
          "children": [
            {
              "label": "more insidious onset"
            },
            {
              "label": "floaters"
            }
          ]
        },
        {
          "label": "anterior segment",
          "children": [
            {
              "label": "variable AC inflammatory cells"
            },
            {
              "label": "band keratopathy"
            },
            {
              "label": "posterior synechiae"
            },
            {
              "label": "signs of chronicity"
            }
          ]
        },
        {
          "label": "posterior segment",
          "children": [
            {
              "label": "vitreous cells",
              "children": [
                {
                  "label": "snowballs"
                }
              ]
            },
            {
              "label": "pars plana exudates"
            },
            {
              "label": "inferior peripheral retinal phlebitis",
              "children": [
                {
                  "label": "retinal venous sheathing"
                }
              ]
            },
            {
              "label": "neovascularization & vitreous hemorrhage"
            },
            {
              "label": "CME"
            },
            {
              "label": "vitreous opacification"
            },
            {
              "label": "epiretinal membrane"
            },
            {
              "label": "tractional or rhegmatogenous retinal detachment"
            },
            {
              "label": "secondary peripheral retinal vasoproliferative tumors",
              "children": [
                {
                  "label": "rare",
                  "children": [
                    {
                      "label": "Lyme and syphilitic uveitis may simulate any anatomical subtype of uveitis"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "treatment",
      "children": [
        {
          "label": "treat the underlying cause"
        },
        {
          "label": "corticosteroids",
          "children": [
            {
              "label": "first line of therapy"
            },
            {
              "label": "periocular corticosteroid",
              "children": [
                {
                  "label": "particularly appealing in unilateral cases"
                },
                {
                  "label": "as frequently as every 3–4 weeks"
                },
                {
                  "label": "some cases prove recalcitrant"
                },
                {
                  "label": "complications of periocular corticosteroids",
                  "children": [
                    {
                      "label": "corticosteroid-induced IOP elevation"
                    },
                    {
                      "label": "aponeurotic ptosis"
                    },
                    {
                      "label": "fat prolapse"
                    },
                    {
                      "label": "enophthalmos"
                    },
                    {
                      "label": "globe perforation"
                    },
                    {
                      "label": "cataract formation"
                    }
                  ]
                }
              ]
            },
            {
              "label": "intravitreal corticosteroid",
              "children": [
                {
                  "label": "for refractory cases"
                },
                {
                  "label": "risks of sustained IOP elevation/glaucoma"
                },
                {
                  "label": "very small risks of retinal detachment, vitreous hemorrhage, and endophthalmitis",
                  "children": [
                    {
                      "label": "inject away from areas of snowbanking and areas with peripheral retinal pathology"
                    }
                  ]
                }
              ]
            },
            {
              "label": "systemic corticosteroid therapy",
              "children": [
                {
                  "label": "for severe or bilateral cases"
                },
                {
                  "label": "initial dosage of 1–1.5 mg/kg/day",
                  "children": [
                    {
                      "label": "gradual tapering every 1–2 weeks to dosages of less than 10 mg/day"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "immunomodulatory treatment",
          "children": [
            {
              "label": "indications",
              "children": [
                {
                  "label": "if corticosteroid therapy fails"
                },
                {
                  "label": "if long-term use of high doses of corticosteroids are needed"
                }
              ]
            },
            {
              "label": "antimetabolites (eg, methotrexate, azathioprine, mycophenolate mofetil)"
            },
            {
              "label": "T-cell inhibitors (eg, cyclosporine, tacrolimus)"
            },
            {
              "label": "biologic agents (eg, TNF inhibitors, interferon)",
              "children": [
                {
                  "label": "anti-TNF therapy can exacerbate MS",
                  "children": [
                    {
                      "label": "should be avoided in patients with MS- associated intermediate uveitis"
                    }
                  ]
                }
              ]
            },
            {
              "label": "alkylating drugs (eg, cyclophosphamide, chlorambucil)"
            },
            {
              "label": "Immunosuppressive Therapy for Eye Diseases (SITE) cohort study",
              "children": [
                {
                  "label": "cyclosporine, azathioprine, and mycophenolate mofetil were effective in achieving sustained control of inflammation in 70%–80% of intermediate uveitis"
                }
              ]
            }
          ]
        },
        {
          "label": "cryotherapy",
          "children": [
            {
              "label": "peripheral ablation of the pars plana snowbank"
            },
            {
              "label": "rarely used at present",
              "children": [
                {
                  "label": "may induce further inflammation"
                }
              ]
            }
          ]
        },
        {
          "label": "indirect laser photocoagulation to the peripheral retina",
          "children": [
            {
              "label": "for retinal ischemia and neovascularization",
              "children": [
                {
                  "label": "to prevent vitreous hemorrhage"
                }
              ]
            }
          ]
        },
        {
          "label": "intravitreal anti-VEGF treatment",
          "children": [
            {
              "label": "for retinal or choroidal neovascularization",
              "children": [
                {
                  "label": "does not seem to increase the risk of rhegmatogenous retinal detachment"
                }
              ]
            }
          ]
        },
        {
          "label": "pars plana vitrectomy",
          "children": [
            {
              "label": "+- laser photocoagulation"
            },
            {
              "label": "perioperative increase in systemic immunosuppression and/or corticosteroids should be considered"
            },
            {
              "label": "indications",
              "children": [
                {
                  "label": "for cases recalcitrant to IMT"
                },
                {
                  "label": "for treating complications of pars planitis",
                  "children": [
                    {
                      "label": "severe vision loss caused by vitreous hemorrhage or traction"
                    },
                    {
                      "label": "retinal detachment"
                    },
                    {
                      "label": "epiretinal membrane"
                    },
                    {
                      "label": "significant vitreous opacities despite adequate IMT"
                    },
                    {
                      "label": "in cases involving epiretinal membrane or vitreomacular traction, separation of the posterior hyaloid membrane may reduce CME"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "differential diagnosis",
      "children": [
        {
          "label": "tuberculosis"
        },
        {
          "label": "syphilis"
        },
        {
          "label": "Lyme uveitis",
          "children": [
            {
              "label": "Lyme antibody titers"
            }
          ]
        },
        {
          "label": "sarcoidosis",
          "children": [
            {
              "label": "intermediate uveitis in 7%"
            }
          ]
        },
        {
          "label": "MS",
          "children": [
            {
              "label": "anterior and intermediate uveitis in up to 20%"
            }
          ]
        },
        {
          "label": "toxocariasis",
          "children": [
            {
              "label": "serologic testing"
            }
          ]
        },
        {
          "label": "primary central nervous system (CNS) lymphoma",
          "children": [
            {
              "label": "vitritis without other ocular findings"
            },
            {
              "label": "sixth decade or older"
            }
          ]
        },
        {
          "label": "Fuchs heterochromic uveitis"
        }
      ]
    },
    {
      "label": "ancillary tests and histologic findings",
      "children": [
        {
          "label": "laboratory workup to exclude other causes of intermediate uveitis can be considered"
        },
        {
          "label": "fluorescein angiography (FA)",
          "children": [
            {
              "label": "diffuse peripheral venous leakage"
            },
            {
              "label": "disc leakage"
            },
            {
              "label": "CME"
            }
          ]
        },
        {
          "label": "ultrasound biomicroscopy",
          "children": [
            {
              "label": "to demonstrate peripheral exudates or membranes over the pars plana in presence of small pupil or dense cataract"
            }
          ]
        },
        {
          "label": "histologic examination",
          "children": [
            {
              "label": "vitreous condensation"
            },
            {
              "label": "cellular infiltration in the vitreous base"
            },
            {
              "label": "peripheral lymphocytic cuffing of venules",
              "children": [
                {
                  "label": "inflammatory cells consist mostly of macrophages, lymphocytes, and a few plasma cells"
                }
              ]
            },
            {
              "label": "loose fibrovascular membrane over the pars plana"
            }
          ]
        }
      ]
    },
    {
      "label": "complications",
      "children": [
        {
          "label": "cataract",
          "children": [
            {
              "label": "≤60%"
            },
            {
              "label": "cataract surgery with IOL implantation may be complicated by",
              "children": [
                {
                  "label": "smoldering low-grade inflammation"
                },
                {
                  "label": "recurring opacification of the posterior capsule despite capsulotomy"
                },
                {
                  "label": "recurrent retrolental membranes"
                },
                {
                  "label": "chronic CME"
                },
                {
                  "label": "even in cases with no active cellular inflammation"
                }
              ]
            },
            {
              "label": "combining pars plana vitrectomy with cataract extraction and IOL implantation may reduce the risk of these complications"
            }
          ]
        },
        {
          "label": "glaucoma",
          "children": [
            {
              "label": "both angle-closure and open-angle"
            },
            {
              "label": "10%"
            }
          ]
        },
        {
          "label": "CME",
          "children": [
            {
              "label": "50%",
              "children": [
                {
                  "label": "10% become chronic and refractory"
                }
              ]
            },
            {
              "label": "major cause of vision loss"
            }
          ]
        },
        {
          "label": "neovascularization of the retina, disc, snowbank",
          "children": [
            {
              "label": "10%"
            },
            {
              "label": "along the inferior snowbank"
            },
            {
              "label": "more common in children"
            },
            {
              "label": "may lead to vitreous hemorrhage"
            }
          ]
        },
        {
          "label": "tractional or rhegmatogenous retinal detachment",
          "children": [
            {
              "label": "15%"
            },
            {
              "label": "require scleral buckling +- vitrectomy"
            },
            {
              "label": "risk factors for rhegmatogenous retinal detachment",
              "children": [
                {
                  "label": "severe inflammation"
                },
                {
                  "label": "use of cryotherapy at the time of a vitrectomy"
                },
                {
                  "label": "neovascularization of the pars plana snowbank"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "prognosis",
      "children": [
        {
          "label": "3 types",
          "children": [
            {
              "label": "self-limiting, benign course",
              "children": [
                {
                  "label": "10%"
                }
              ]
            },
            {
              "label": "smoldering course with remissions and exacerbations",
              "children": [
                {
                  "label": "30%"
                }
              ]
            },
            {
              "label": "may remain active for many years",
              "children": [
                {
                  "label": "prolonged course without exacerbations",
                  "children": [
                    {
                      "label": "60%"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "if CME is treated until resolution, the long-term visual prognosis can be good"
        },
        {
          "label": "visual acuity of ≥20/40 after 10 years in 75%"
        }
      ]
    }
  ],
