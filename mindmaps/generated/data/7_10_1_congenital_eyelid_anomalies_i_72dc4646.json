{
  "label": "7.10.1. Congenital Eyelid Anomalies (I)",
  "root": true,
  "children": [
    {
      "label": "introduction",
      "children": [
        {
          "label": "types",
          "children": [
            {
              "label": "isolated"
            },
            {
              "label": "associated with other eyelid, facial, or systemic anomalies"
            }
          ]
        },
        {
          "label": "most congenital eyelid anomalies occur during the second month of gestation"
        }
      ]
    },
    {
      "label": "Epiblepharon",
      "children": [
        {
          "label": "lower eyelid pretarsal muscle and skin ride above the lid margin",
          "children": [
            {
              "label": "form a horizontal fold of tissue that causes the cilia to assume a vertical position",
              "children": [
                {
                  "label": "cilia often do not touch the cornea except in downgaze",
                  "children": [
                    {
                      "label": "rarely causes corneal staining"
                    }
                  ]
                }
              ]
            },
            {
              "label": "eyelid margin is in normal position"
            }
          ]
        },
        {
          "label": "most common in Asian children"
        },
        {
          "label": "surgical treatment",
          "children": [
            {
              "label": "may not require treatment",
              "children": [
                {
                  "label": "tends to diminish with maturation of facial bones"
                }
              ]
            },
            {
              "label": "indication for surgical treatment",
              "children": [
                {
                  "label": "chronic corneal epithelial irritation"
                }
              ]
            },
            {
              "label": "excess skin and muscle fold are excised just inferior to the eyelid margin"
            }
          ]
        }
      ]
    },
    {
      "label": "Blepharophimosis–Ptosis–Epicanthus Inversus Syndrome (BPES)",
      "children": [
        {
          "label": "blepharophimosis syndrome"
        },
        {
          "label": "autosomal dominant",
          "children": [
            {
              "label": "chromosome 3",
              "children": [
                {
                  "label": "FOXL2 gene"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "blepharophimosis"
            },
            {
              "label": "severe ptosis"
            },
            {
              "label": "epicanthus inversus (fold of skin extending from the lower to upper eyelid)"
            },
            {
              "label": "lateral lower eyelid ectropion"
            },
            {
              "label": "hypoplasia of the superior orbital rims"
            },
            {
              "label": "telecanthus"
            },
            {
              "label": "hypertelorism"
            },
            {
              "label": "poorly developed nasal bridge"
            },
            {
              "label": "ear deformities"
            }
          ]
        },
        {
          "label": "2 types",
          "children": [
            {
              "label": "type I",
              "children": [
                {
                  "label": "early loss of ovarian function"
                }
              ]
            },
            {
              "label": "type II"
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "multiple surgeries required"
            },
            {
              "label": "indications for surgical correction",
              "children": [
                {
                  "label": "visually disruptive ptosis",
                  "children": [
                    {
                      "label": "usually requires frontalis suspension"
                    }
                  ]
                },
                {
                  "label": "telecanthus",
                  "children": [
                    {
                      "label": "medial canthal repositioning places traction on the upper eyelid and may exacerbate the ptosis"
                    },
                    {
                      "label": "multiple Z-plasties or Y–V-plasties + transnasal wiring of the medial canthal tendons"
                    }
                  ]
                },
                {
                  "label": "ectropion"
                },
                {
                  "label": "orbital rim hypoplasia"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Epicanthus",
      "children": [
        {
          "label": "usually bilateral"
        },
        {
          "label": "medial canthal fold"
        },
        {
          "label": "pathogenesis",
          "children": [
            {
              "label": "immature midfacial bones"
            },
            {
              "label": "fold of skin and subcutaneous tissue"
            }
          ]
        },
        {
          "label": "child may appear esotropic",
          "children": [
            {
              "label": "pseudostrabismus"
            }
          ]
        },
        {
          "label": "4 types",
          "children": [
            {
              "label": "epicanthus tarsalis",
              "children": [
                {
                  "label": "most prominent in the upper eyelid"
                },
                {
                  "label": "can be a normal variation of the Asian eyelid"
                }
              ]
            },
            {
              "label": "epicanthus inversus",
              "children": [
                {
                  "label": "most prominent in the lower eyelid"
                },
                {
                  "label": "frequently associated with BPES"
                }
              ]
            },
            {
              "label": "epicanthus palpebralis",
              "children": [
                {
                  "label": "involves the upper and lower eyelids equally"
                }
              ]
            },
            {
              "label": "epicanthus supraciliaris",
              "children": [
                {
                  "label": "arises from the eyebrow region and runs to the lacrimal sac"
                }
              ]
            }
          ]
        },
        {
          "label": "management",
          "children": [
            {
              "label": "most forms become less apparent with normal growth of facial bones",
              "children": [
                {
                  "label": "observation is recommended until the face achieves maturity"
                },
                {
                  "label": "epicanthus inversus rarely resolves with facial growth"
                }
              ]
            },
            {
              "label": "isolated epicanthus",
              "children": [
                {
                  "label": "linear revisions (Z-plasty or Y–V-plasty)"
                }
              ]
            },
            {
              "label": "epicanthus tarsalis in the Asian patient",
              "children": [
                {
                  "label": "Y–V-plasty"
                },
                {
                  "label": "± construction of an upper eyelid crease"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Ankyloblepharon",
      "children": [
        {
          "label": "partial or complete fusion of eyelids by webs of skin"
        },
        {
          "label": "can usually be opened with scissors after being clamped for a few seconds with a hemostat"
        }
      ]
    },
    {
      "label": "Congenital Ectropion",
      "children": [
        {
          "label": "etiology",
          "children": [
            {
              "label": "isolated finding",
              "children": [
                {
                  "label": "rare"
                }
              ]
            },
            {
              "label": "often associated with",
              "children": [
                {
                  "label": "BPES"
                },
                {
                  "label": "Down syndrome"
                },
                {
                  "label": "ichthyosis"
                }
              ]
            }
          ]
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "vertical insufficiency of the anterior lamella of eyelid"
            },
            {
              "label": "chronic epiphora"
            },
            {
              "label": "exposure keratitis"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "mild cases",
              "children": [
                {
                  "label": "observation"
                }
              ]
            },
            {
              "label": "severe/symptomatic cases",
              "children": [
                {
                  "label": "treated like a cicatricial ectropion",
                  "children": [
                    {
                      "label": "horizontal tightening of the lateral canthal tendon"
                    },
                    {
                      "label": "vertical lengthening of anterior lamella with full-thickness skin grafting"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "complete eversion of upper eyelids",
          "children": [
            {
              "label": "occasionally occurs in newborns"
            },
            {
              "label": "etiology",
              "children": [
                {
                  "label": "inclusion conjunctivitis"
                },
                {
                  "label": "anterior lamellar inflammation or shortage"
                },
                {
                  "label": "Down syndrome"
                }
              ]
            },
            {
              "label": "management",
              "children": [
                {
                  "label": "topical lubrication"
                },
                {
                  "label": "short-term patching of both eyes"
                },
                {
                  "label": "full-thickness sutures"
                },
                {
                  "label": "temporary tarsorrhaphy"
                },
                {
                  "label": "definitive repair"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Euryblepharon",
      "children": [
        {
          "label": "± associated with BPES"
        },
        {
          "label": "clinical presentation",
          "children": [
            {
              "label": "vertical shortening + horizontal lengthening of the involved eyelids",
              "children": [
                {
                  "label": "lateral portion of the eyelids is typically more involved"
                }
              ]
            },
            {
              "label": "inferiorly displaced lateral canthal tendon",
              "children": [
                {
                  "label": "palpebral fissure often has a downward slant"
                }
              ]
            },
            {
              "label": "impaired blinking"
            },
            {
              "label": "poor closure"
            },
            {
              "label": "lagophthalmos"
            },
            {
              "label": "exposure keratitis"
            }
          ]
        },
        {
          "label": "surgial reconstruction",
          "children": [
            {
              "label": "if symptomatic"
            },
            {
              "label": "lateral canthal repositioning"
            },
            {
              "label": "suspension of suborbicularis oculi fat to lateral orbital rim to support lower eyelid"
            },
            {
              "label": "lateral tarsal strip or eyelid margin resection",
              "children": [
                {
                  "label": "for excess horizontal length"
                }
              ]
            },
            {
              "label": "± skin grafts"
            }
          ]
        }
      ]
    }
  ],
