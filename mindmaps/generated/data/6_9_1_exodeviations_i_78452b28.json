{
  "label": "6.9.1. Exodeviations (I)",
  "root": true,
  "children": [
    {
      "label": "Introduction",
      "children": [
        {
          "label": "manifest or latent divergent strabismus"
        },
        {
          "label": "frequency",
          "children": [
            {
              "label": "varies among different ethnic groups",
              "children": [
                {
                  "label": "Europeans and North and South Americans",
                  "children": [
                    {
                      "label": "exodeviations:esodeviations = 1:3"
                    }
                  ]
                },
                {
                  "label": "Asians",
                  "children": [
                    {
                      "label": "exodeviations = esodeviations"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "risk factors",
          "children": [
            {
              "label": "maternal smoking during pregnancy"
            },
            {
              "label": "premature birth"
            },
            {
              "label": "family history of strabismus"
            },
            {
              "label": "uncorrected refractive errors",
              "children": [
                {
                  "label": "similar to esodeviation"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Exophoria",
      "children": [
        {
          "label": "exodeviation controlled by fusion under normal viewing conditions",
          "children": [
            {
              "label": "detected when binocular vision is interrupted",
              "children": [
                {
                  "label": "alternate cover test"
                }
              ]
            }
          ]
        },
        {
          "label": "fairly common"
        },
        {
          "label": "symptoms",
          "children": [
            {
              "label": "often asymptomatic if",
              "children": [
                {
                  "label": "angle of strabismus is small"
                },
                {
                  "label": "fusional convergence amplitudes are adequate"
                }
              ]
            },
            {
              "label": "prolonged, detailed visual work may bring about asthenopia"
            }
          ]
        },
        {
          "label": "breakdown of an exophoria to an exotropia may occur transiently",
          "children": [
            {
              "label": "during a serious illness"
            },
            {
              "label": "after ingestion of sedatives or alcohol"
            }
          ]
        },
        {
          "label": "treatment",
          "children": [
            {
              "label": "usually not necessary unless",
              "children": [
                {
                  "label": "exophoria progresses to intermittent exotropia"
                },
                {
                  "label": "causes asthenopic symptoms"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Pseudoexotropia",
      "children": [
        {
          "label": "appearance of exodeviation when in fact the eyes are properly aligned"
        },
        {
          "label": "less common than pseudoesotropia"
        },
        {
          "label": "etiology",
          "children": [
            {
              "label": "wide interpupillary distance"
            },
            {
              "label": "positive angle kappa without other ocular abnormalities"
            },
            {
              "label": "positive angle kappa together with ocular abnormalities such as temporal dragging of the macula in retinopathy of prematurity"
            }
          ]
        }
      ]
    }
  ],
