{
  "label": "8.7.7. Immune-mediated diseases (VII): Cornea (II)",
  "root": true,
  "children": [
    {
      "label": "Mooren Ulcer",
      "children": [
        {
          "label": "Pathogenesis",
          "children": [
            {
              "label": "unknown",
              "children": [
                {
                  "label": "+- autoimmune",
                  "children": [
                    {
                      "label": "autoreactivity to a cornea-specific antigen",
                      "children": [
                        {
                          "label": "humoral and cell-mediated immune mechanisms",
                          "children": [
                            {
                              "label": "abnormal T-suppressor cell function"
                            },
                            {
                              "label": "increased level of IgA"
                            },
                            {
                              "label": "increased concentration of plasma cells and lymphocytes in the conjunctiva adjacent to the ulcerated areas"
                            },
                            {
                              "label": "increased CD4+/CD8+ and B7-2+/APC ratios as well as increased vascular cell adhesion molecule 1, very late antigen 4, and intercellular adhesion molecule 1 in the vascular endothelium of conjunctival vessels"
                            },
                            {
                              "label": "tissue-fixed immunoglobulins and complement in the conjunctival epithelium and peripheral cornea"
                            },
                            {
                              "label": "resident cells in Mooren ulcer specimens express MHC class II antigens"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "idiopathic",
                  "children": [
                    {
                      "label": "cases of PUK due to known local (rosacea) or systemic (rheumatoid arthritis) diseases should not be called Mooren ulcer"
                    },
                    {
                      "label": "precipitating factors",
                      "children": [
                        {
                          "label": "trauma"
                        },
                        {
                          "label": "surgery"
                        },
                        {
                          "label": "exposure to parasitic infection",
                          "children": [
                            {
                              "label": "incidence of Mooren ulcer is particularly high in areas where parasitic infections are endemic"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical Presentation",
          "children": [
            {
              "label": "symptoms",
              "children": [
                {
                  "label": "pain",
                  "children": [
                    {
                      "label": "can be intense"
                    }
                  ]
                },
                {
                  "label": "photophobia"
                },
                {
                  "label": "tearing"
                }
              ]
            },
            {
              "label": "ulceration of corneal stroma and epithelium",
              "children": [
                {
                  "label": "chronic progressive"
                },
                {
                  "label": "periphery of the cornea",
                  "children": [
                    {
                      "label": "spreads circumferentially"
                    },
                    {
                      "label": "then centripetally"
                    },
                    {
                      "label": "slower ulceration proceeds toward sclera"
                    }
                  ]
                },
                {
                  "label": "leading undermined edge of de-epithelialized tissue"
                },
                {
                  "label": "eye is inflamed"
                },
                {
                  "label": "extensive vascularization and fibrosis"
                }
              ]
            },
            {
              "label": "perforation",
              "children": [
                {
                  "label": "minor trauma"
                },
                {
                  "label": "secondary infection"
                }
              ]
            },
            {
              "label": "two clinical types",
              "children": [
                {
                  "label": "unilateral",
                  "children": [
                    {
                      "label": "older patient"
                    },
                    {
                      "label": "slowly progressive",
                      "children": [
                        {
                          "label": "M=F"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "bilateral",
                  "children": [
                    {
                      "label": "Africa"
                    },
                    {
                      "label": "M>F"
                    },
                    {
                      "label": "rapidly progressive",
                      "children": [
                        {
                          "label": "coexisting parasitemia"
                        }
                      ]
                    },
                    {
                      "label": "poorly responsive to medical or surgical intervention"
                    },
                    {
                      "label": "corneal ulceration/perforation"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Differential diagnosis",
          "children": [
            {
              "label": "idiopathic PUK",
              "children": [
                {
                  "label": "in PUK sclera is often involved",
                  "children": [
                    {
                      "label": "Mooren ulcer is purely corneal"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "topical corticosteroids"
            },
            {
              "label": "contact lenses"
            },
            {
              "label": "acetylcysteine and L-cysteine"
            },
            {
              "label": "topical interferon-α2a (IFN-α2a)"
            },
            {
              "label": "topical cyclosporine 2%",
              "children": [
                {
                  "label": "similar to PUK"
                }
              ]
            },
            {
              "label": "infliximab"
            },
            {
              "label": "limbal conjunctival excision"
            },
            {
              "label": "lamellar keratoplasty"
            },
            {
              "label": "systemic immunosuppressive agents",
              "children": [
                {
                  "label": "oral corticosteroids"
                },
                {
                  "label": "cyclophosphamide"
                },
                {
                  "label": "methotrexate"
                },
                {
                  "label": "cyclosporine"
                }
              ]
            },
            {
              "label": "hepatitis C–associated cases of Mooren ulcer–type PUK",
              "children": [
                {
                  "label": "interferon therapy"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Peripheral Ulcerative Keratitis Associated With Systemic Immune-Mediated Diseases",
      "children": [
        {
          "label": "Pathogenesis",
          "children": [
            {
              "label": "systemic immune-mediated/rheumatic diseases",
              "children": [
                {
                  "label": "rheumatoid arthritis"
                },
                {
                  "label": "Wegener granulomatosis"
                },
                {
                  "label": "systemic lupus erythematosus"
                },
                {
                  "label": "polyarteritis nodosa"
                },
                {
                  "label": "ulcerative colitis"
                },
                {
                  "label": "relapsing polychondritis"
                },
                {
                  "label": "rosacea"
                }
              ]
            },
            {
              "label": "adjacent conjunctiva",
              "children": [
                {
                  "label": "immune-mediated vaso-occlusive disease"
                }
              ]
            }
          ]
        },
        {
          "label": "Clinical Presentation",
          "children": [
            {
              "label": "history of connective tissue disease",
              "children": [
                {
                  "label": "PUK generally correlates with exacerbations of systemic disease activity"
                },
                {
                  "label": "PUK may be the first sign of the underlying systemic disease!"
                }
              ]
            },
            {
              "label": "1 sector of cornea",
              "children": [
                {
                  "label": "usually unilateral"
                }
              ]
            },
            {
              "label": "within 2 mm of limbus"
            },
            {
              "label": "epithelium is absent in affected area",
              "children": [
                {
                  "label": "vaso-occlusion of adjacent limbal vessels",
                  "children": [
                    {
                      "label": "adjacent conjunctiva can be minimally or severely inflamed"
                    }
                  ]
                }
              ]
            },
            {
              "label": "underlying stroma thinned",
              "children": [
                {
                  "label": "keratolysis"
                }
              ]
            },
            {
              "label": "+- significant cellular infiltrate in the corneal stroma"
            }
          ]
        },
        {
          "label": "Management",
          "children": [
            {
              "label": "promote epithelialization",
              "children": [
                {
                  "label": "melting will stop or slow if the epithelium can be made to heal"
                },
                {
                  "label": "lubrication",
                  "children": [
                    {
                      "label": "many rheumatoid patients have KCS"
                    },
                    {
                      "label": "lubricants dilute inflammatory cytokines"
                    }
                  ]
                },
                {
                  "label": "patching"
                },
                {
                  "label": "bandage contact lens",
                  "children": [
                    {
                      "label": "sodium citrate 10%"
                    }
                  ]
                }
              ]
            },
            {
              "label": "collagenase inhibitors",
              "children": [
                {
                  "label": "topical",
                  "children": [
                    {
                      "label": "acetylcysteine solution 20%"
                    },
                    {
                      "label": "medroxyprogesterone 1%"
                    }
                  ]
                },
                {
                  "label": "systemic collagenase inhibitors",
                  "children": [
                    {
                      "label": "tetracyclines (doxycycline)"
                    }
                  ]
                }
              ]
            },
            {
              "label": "topical cyclosporine"
            },
            {
              "label": "topical corticosteroids",
              "children": [
                {
                  "label": "inhibit collagenase function"
                },
                {
                  "label": "use with caution if the cornea has thinned significantly"
                }
              ]
            },
            {
              "label": "excision or recession of adjacent limbal conjunctiva"
            },
            {
              "label": "threatened perforation",
              "children": [
                {
                  "label": "cyanoacrylate glue"
                },
                {
                  "label": "bandage contact lens"
                },
                {
                  "label": "tectonic grafts",
                  "children": [
                    {
                      "label": "grafts are also susceptible to melting"
                    }
                  ]
                },
                {
                  "label": "conjunctival flaps",
                  "children": [
                    {
                      "label": "best avoided in immune-mediated disease",
                      "children": [
                        {
                          "label": "could accelerate melting"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "suppress the systemic immune-mediated inflammation",
              "children": [
                {
                  "label": "definitive management cannot be achieved by local measures alone!"
                },
                {
                  "label": "immunosuppressive therapy",
                  "children": [
                    {
                      "label": "oral prednisone"
                    },
                    {
                      "label": "cytotoxic agents",
                      "children": [
                        {
                          "label": "intravenous high-dose cyclophosphamide for severe rapid melting"
                        }
                      ]
                    },
                    {
                      "label": "methotrexate"
                    },
                    {
                      "label": "cyclosporine"
                    }
                  ]
                },
                {
                  "label": "biologic agents",
                  "children": [
                    {
                      "label": "infliximab"
                    }
                  ]
                }
              ]
            },
            {
              "label": "reconstructive keratoplasty"
            },
            {
              "label": "treated inadequately, a high proportion may suffer severe disease-related morbidity"
            }
          ]
        }
      ]
    }
