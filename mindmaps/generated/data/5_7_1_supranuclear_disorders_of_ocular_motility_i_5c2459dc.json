                          "label": "produce diplopia"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "label": "Fundamental Principles of Ocular Motor Control",
      "children": [
        {
          "label": "attention to peripherally placed objects is driven by the perception of a changing stimulus",
          "children": [
            {
              "label": "movement is an especially strong stimulus!",
              "children": [
                {
                  "label": "See Table 7-1"
                }
              ]
            }
          ]
        },
        {
          "label": "pursuit system",
          "children": [
            {
              "label": "for tracking relatively slow-moving (<30° per second) targets",
              "children": [
                {
                  "label": "1/3 the distance from the primary position to the far extent of the temporal visual field in 1 second"
                }
              ]
            },
            {
              "label": "driven by visual attention to a target",
              "children": [
                {
                  "label": "foveation",
                  "children": [
                    {
                      "label": "moving target"
                    },
                    {
                      "label": "moving person"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "vestibular ocular reflex (VOR) system",
          "children": [
            {
              "label": "holds images stable on the retina during brief, high-frequency rotations of the head",
              "children": [
                {
                  "label": "walking"
                }
              ]
            },
            {
              "label": "produces eye movements in a direction opposite to those of head acceleration"
            },
            {
              "label": "attenuates quickly (within seconds) during prolonged period of stable head velocity"
            }
          ]
        },
        {
          "label": "optokinetic nystagmus (OKN) system",
          "children": [
            {
              "label": "holds images stable on the retina during sustained rotation of the head (or environment)"
            },
            {
              "label": "supplements the VOR",
              "children": [
                {
                  "label": "during prolonged visual movement (running continuously), the OKN system maintains visual fixation even after vestibular influence has waned"
                }
              ]
            },
            {
              "label": "the pursuit system is more influential in maintaining proper alignment during sustained rotations than the OKN system"
            },
            {
              "label": "2 components",
              "children": [
                {
                  "label": "initial smooth pursuit to track a moving object"
                },
                {
                  "label": "saccade in the opposite direction",
                  "children": [
                    {
                      "label": "the maximum amplitude of the pursuit movement is reached"
                    },
                    {
                      "label": "speed of the moving object exceeds the maximum velocity of the pursuit system"
                    },
                    {
                      "label": "involuntary saccade is mediated by the same vestibular neurons that respond to vestibular stimulation",
                      "children": [
                        {
                          "label": "integrity of the vestibular neurons can be studied without using vestibular stimuli!"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "label": "both OKN and VOR can be suppressed by visual fixation on a target"
            }
          ]
        },
        {
          "label": "saccadic system",
          "children": [
            {
              "label": "rapidly shifts the fovea to targets of interest",
              "children": [
                {
                  "label": "for tracking faster-moving targets"
                },
                {
                  "label": "relatively fast, back-to-back eye movements",
                  "children": [
                    {
                      "label": "duration is generally <100 milliseconds"
                    }
                  ]
                }
              ]
            },
            {
              "label": "“ballistic” movements",
              "children": [
                {
                  "label": "cannot be altered once initiated!"
                }
              ]
            },
            {
              "label": "larger-amplitude saccades are faster than smaller-amplitude saccades",
              "children": [
                {
                  "label": "\"main sequence\""
                },
                {
                  "label": "may exceed 500° per second",
                  "children": [
                    {
                      "label": "from primary position to the farthest extent of the temporal visual field in only 0.2 second"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "vergence systems",
          "children": [
            {
              "label": "for tracking objects moving toward or away from the eyes",
              "children": [
                {
                  "label": "convergence"
                },
                {
                  "label": "divergence"
                }
              ]
            },
            {
              "label": "driven primarily by a disparity in the relative location of images on the retinas"
            }
          ]
        },
        {
          "label": "microsaccadic refixation movements",
          "children": [
            {
              "label": "persistent foveal fixation on a stationary target causes attenuation of retinal neuronal responses"
            },
            {
              "label": "to-and-fro movements maintain the image within the field of the fovea",
              "children": [
                {
                  "label": "continuous",
                  "children": [
                    {
                      "label": "very small amplitude (0.1°–0.2°)"
                    }
                  ]
                },
                {
                  "label": "slight pause (180–200 ms) between movements (intersaccadic interval)"
                },
                {
                  "label": "\"square waves\""
                }
              ]
            }
          ]
        },
        {
          "label": "abnormalities in any of these systems may result in",
          "children": [
            {
              "label": "degradation of visual acuity"
            },
            {
              "label": "blurring of vision"
            },
            {
              "label": "oscillopsia"
            },
            {
              "label": "motion sickness"
            }
          ]
        },
        {
          "label": "pursuit, OKN, and saccadic systems are controlled by different anatomical pathways that converge at the level of the brainstem",
          "children": [
            {
              "label": "share the same supranuclear neurons",
              "children": [
                {
                  "label": "paramedian pontine reticular formation (PPRF)",
                  "children": [
                    {
                      "label": "for horizontal movements"
                    }
                  ]
                },
                {
                  "label": "rostral interstitial nucleus of the medial longitudinal fasciculus",
                  "children": [
                    {
                      "label": "for vertical movements"
                    }
                  ]
                },
                {
                  "label": "innervate the ocular motor cranial nerve nuclei"
                }
              ]
            }
          ]
        }
      ]
